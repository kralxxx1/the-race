local function oldHan(parent, poi, rng)
	local cf, w, d = Commerce.siteFrame(poi, 4)
	local m = B.model("OldHan", parent)
	local stone = Color3.fromRGB(200, 180, 150)
	local hw, hd, hh = w - 16, d - 16, 18
	-- four wings around a courtyard
	for side = -1, 1, 2 do
		B.box(m, cf * CFrame.new(side * (hw / 2 - 5), hh / 2, hd / 2), Vector3.new(10, hh, hd), stone, M.Sandstone)
	end
	B.box(m, cf * CFrame.new(0, hh / 2, hd - 5), Vector3.new(hw, hh, 10), stone, M.Sandstone)
	B.box(m, cf * CFrame.new(-hw / 4 - 4, hh / 2, 5), Vector3.new(hw / 2 - 8, hh, 10), stone, M.Sandstone)
	B.box(m, cf * CFrame.new(hw / 4 + 4, hh / 2, 5), Vector3.new(hw / 2 - 8, hh, 10), stone, M.Sandstone)
	B.box(m, cf * CFrame.new(0, hh - 3, 5), Vector3.new(16, 6, 10), stone, M.Sandstone)
	B.cyl(m, cf * CFrame.new(0, hh - 6, 5) * CFrame.Angles(0, math.pi / 2, 0), 10.2, 16, stone, M.Sandstone)
	-- courtyard: fountain and trees
	B.cylY(m, cf * CFrame.new(0, 1, hd / 2), 2, 10, Color3.fromRGB(220, 210, 190), M.Marble)
	B.cylY(m, cf * CFrame.new(0, 1.8, hd / 2), 0.4, 9, Color3.fromRGB(80, 150, 180), M.Glass, nc({ Transparency = 0.3 }))
	B.cylY(m, cf * CFrame.new(0, 3.5, hd / 2), 3.5, 1.2, Color3.fromRGB(220, 210, 190), M.Marble)
	for k = -1, 1, 2 do
		Props.tree(m, cf * CFrame.new(k * 14, 0, hd / 2), "cypress", rng)
	end
	for _ = 1, 4 do
		Props.parasolTable(m, cf * CFrame.new(Rand.range(rng, -hw / 4, hw / 4), 0, Rand.range(rng, hd / 2 - 12, hd / 2 + 12)), { 160, 40, 40 }, rng)
	end
	local plaque = B.box(m, cf * CFrame.new(0, hh + 1.8, -0.2), Vector3.new(18, 3, 0.4), Color3.fromRGB(120, 40, 30), M.Wood)
	B.sign(plaque, Enum.NormalId.Front, "TARİHİ HAN • 1625", { color = Color3.fromRGB(250, 220, 150), font = B.Fonts.Serif })
	return m
end

local function teahouse(parent, poi, rng)
	local cf, w = Commerce.siteFrame(poi, 2)
	local m = Buildings.building(parent, cf * CFrame.new(-w / 4, 0, 4), { w = w / 2 - 8, d = 30, floors = 2, floorH = 12, style = "historic", ground = "shop", name = "KAHVEHANE", rng = rng, accent = { 120, 40, 30 }, roof = "gable", blankSides = true })
	for i = 0, 5 do
		local c = cf * CFrame.new(w / 8 + (i % 3) * 10, 0, 6 + math.floor(i / 3) * 9)
		B.box(m, c * CFrame.new(0, 2.4, 0), Vector3.new(4, 0.25, 4), Color3.fromRGB(110, 70, 40), M.Wood)
		B.box(m, c * CFrame.new(0, 1.2, 0), Vector3.new(0.4, 2.4, 0.4), Color3.fromRGB(60, 40, 30), M.Wood)
		local board = B.box(m, c * CFrame.new(0, 2.6, 0), Vector3.new(2.6, 0.15, 1.6), Color3.fromRGB(150, 100, 60), M.Wood, nc())
		board.Name = "Backgammon"
		for k = 0, 1 do
			Props.chair(m, c * CFrame.Angles(0, k * math.pi, 0) * CFrame.new(0, 0, 3), { 120, 80, 50 })
		end
	end
	Props.samovar(m, cf * CFrame.new(w / 3, 0.2, 2))
	Props.tree(m, cf * CFrame.new(w / 4, 0, 26), "oak", rng)
	return m
end

local function marketHall(parent, poi, rng)
	local cf, w = Commerce.siteFrame(poi, 4)
	local m = B.model("MarketHall", parent)
	local stalls = math.floor((w - 12) / 12)
	local produce = { Color3.fromRGB(220, 40, 30), Color3.fromRGB(250, 160, 30), Color3.fromRGB(90, 160, 50), Color3.fromRGB(250, 220, 60), Color3.fromRGB(120, 50, 120) }
	for i = 0, stalls - 1 do
		local c = cf * CFrame.new(-w / 2 + 10 + i * 12, 0, 10)
		B.box(m, c * CFrame.new(0, 1.8, 0), Vector3.new(9, 0.4, 5), Color3.fromRGB(140, 100, 60), M.WoodPlanks)
		B.box(m, c * CFrame.new(0, 0.9, 0), Vector3.new(8.6, 1.8, 4.6), Color3.fromRGB(110, 80, 50), M.WoodPlanks)
		for _ = 1, 10 do
			B.ball(m, c * CFrame.new(Rand.range(rng, -3.8, 3.8), 2.4, Rand.range(rng, -2, 2)), 0.9, Rand.pick(rng, produce), M.SmoothPlastic, nc())
		end
		B.wedge(m, c * CFrame.new(0, 6.8, 0), Vector3.new(10, 1.2, 6), Rand.pick(rng, { Color3.fromRGB(240, 240, 236), Color3.fromRGB(200, 50, 40), Color3.fromRGB(40, 120, 70) }), M.Fabric, nc())
		for x = -1, 1, 2 do
			B.box(m, c * CFrame.new(x * 4.4, 3.4, -2.6), Vector3.new(0.3, 6.8, 0.3), Color3.fromRGB(90, 90, 96), M.Metal)
		end
	end
	local sign = B.box(m, cf * CFrame.new(0, 10, 3), Vector3.new(24, 3, 0.3), Color3.fromRGB(40, 120, 70), M.SmoothPlastic, nc())
	B.sign(sign, Enum.NormalId.Front, "SEMT PAZARI • TAZE ÜRÜN", { color = Color3.new(1, 1, 1) })
	return m
end

----------------------------------------------------------------------------------------------------
-- Scrapyard
----------------------------------------------------------------------------------------------------
local function scrapyard(parent, poi, rng)
	local s = poi.site
	local m = B.model("Scrapyard", parent)
	local cx, cz = (s.x0 + s.x1) / 2, (s.z0 + s.z1) / 2
	local _w, _d = s.x1 - s.x0, s.z1 - s.z0
	-- chain-link fence with a gate on the north side
	Props.fence(m, Vector3.new(s.x0 + 2, WALK_Y, s.z0 + 2), Vector3.new(cx - 10, WALK_Y, s.z0 + 2), "chain", 8)
	Props.fence(m, Vector3.new(cx + 10, WALK_Y, s.z0 + 2), Vector3.new(s.x1 - 2, WALK_Y, s.z0 + 2), "chain", 8)
	Props.fence(m, Vector3.new(s.x0 + 2, WALK_Y, s.z1 - 2), Vector3.new(s.x1 - 2, WALK_Y, s.z1 - 2), "chain", 8)
	Props.fence(m, Vector3.new(s.x0 + 2, WALK_Y, s.z0 + 2), Vector3.new(s.x0 + 2, WALK_Y, s.z1 - 2), "chain", 8)
	Props.fence(m, Vector3.new(s.x1 - 2, WALK_Y, s.z0 + 2), Vector3.new(s.x1 - 2, WALK_Y, s.z1 - 2), "chain", 8)
	-- piles of junk PCs and monitors
	local junkCols = { Color3.fromRGB(226, 216, 190), Color3.fromRGB(40, 40, 44), Color3.fromRGB(150, 150, 156), Color3.fromRGB(120, 100, 80) }
	for _ = 1, 7 do
		local px, pz = Rand.range(rng, s.x0 + 18, s.x1 - 18), Rand.range(rng, cz - 10, s.z1 - 18)
		for k = 1, 16 do
			local size = Vector3.new(Rand.range(rng, 1.6, 3), Rand.range(rng, 2.4, 4.4), Rand.range(rng, 2.4, 4.4))
			local y = WALK_Y + size.Y / 2 + math.max(0, 6 - (k % 6)) * 0.8
			B.box(m, CFrame.new(px + Rand.range(rng, -6, 6), y, pz + Rand.range(rng, -6, 6)) * CFrame.Angles(Rand.range(rng, -0.6, 0.6), Rand.range(rng, 0, 6), Rand.range(rng, -0.6, 0.6)), size, Rand.pick(rng, junkCols), M.CorrodedMetal)
		end
	end
	-- crane magnet and a crushed car stack
	B.box(m, CFrame.new(s.x0 + 20, WALK_Y + 14, s.z1 - 20), Vector3.new(2, 28, 2), Color3.fromRGB(230, 170, 30), M.Metal)
	B.box(m, CFrame.new(s.x0 + 32, WALK_Y + 27, s.z1 - 20), Vector3.new(26, 2, 2), Color3.fromRGB(230, 170, 30), M.Metal)
	B.cylY(m, CFrame.new(s.x0 + 42, WALK_Y + 18, s.z1 - 20), 1.4, 7, Color3.fromRGB(60, 60, 64), M.Metal)
	for k = 0, 4 do
		B.box(m, CFrame.new(s.x1 - 22, WALK_Y + 1.6 + k * 3.2, s.z1 - 24), Vector3.new(14, 3, 7), Rand.pick(rng, { Color3.fromRGB(150, 40, 30), Color3.fromRGB(40, 70, 120), Color3.fromRGB(200, 200, 196) }), M.CorrodedMetal)
	end
	-- office cabin with the counter
	local cabin = CFrame.lookAt(Vector3.new(cx, WALK_Y, s.z0 + 26), Vector3.new(cx, WALK_Y, s.z0))
	local hall = Buildings.hall(m, cabin, 26, 18, 11, { name = "HURDACI REMZİ", accent = { 120, 80, 40 }, wall = { 150, 140, 120 }, wallMat = M.CorrodedMetal, floor = { 110, 100, 90 }, floorMat = M.Concrete, modelName = "ScrapOffice" })
	Commerce.servicePoint(hall, cabin * CFrame.new(0, 0.2, 12), "scrap", poi.id, "Hurda Kasa Al", "Hurdalık", 8)
	return m
end

----------------------------------------------------------------------------------------------------
-- Vehicle dealers and fuel stations
----------------------------------------------------------------------------------------------------
local function dealer(parent, poi, _rng, service: string, title: string, accent)
	local cf, w, d = Commerce.siteFrame(poi, 4)
	local hw, hd = w - 16, math.min(d - 30, 70)
	local m, _pts = Buildings.hall(parent, cf * CFrame.new(0, 0, 10), hw, hd, 18, { name = title, accent = accent, wall = { 240, 240, 242 }, floor = { 230, 230, 232 }, floorMat = M.Marble, door = 14, modelName = "Dealer_" .. service })
	-- display turntables (the vehicles themselves are placed by VehicleService)
	local n = math.max(2, math.floor((hw - 20) / 22))
	for i = 0, n - 1 do
		local x = -hw / 2 + 16 + i * (hw - 32) / math.max(1, n - 1)
		local spot = cf * CFrame.new(x, 0.3, 10 + hd / 2) * CFrame.Angles(0, math.rad(25 + i * 20), 0)
		B.cylY(m, spot * CFrame.new(0, 0.2, 0), 0.4, 18, Color3.fromRGB(40, 40, 46), M.Metal)
		B.cylY(m, spot * CFrame.new(0, 0.25, 0), 0.42, 18.4, Color3.fromRGB(255, 255, 255), M.Neon, nc())
		local marker = B.marker(m, "DisplaySpot", spot * CFrame.new(0, 0.5, 0))
		marker:SetAttribute("Dealer", service)
		B.tag(marker, "DealerDisplay")
	end
	Commerce.servicePoint(m, cf * CFrame.new(hw / 3, 0.2, 10 + hd - 10), service, poi.id, "Araçlara Bak", title)
	-- pennant banners along the forecourt
	for k = -2, 2 do
		local base = cf * CFrame.new(k * 10, 0, -2)
		B.cylY(parent, base * CFrame.new(0, 7, 0), 14, 0.35, Color3.fromRGB(220, 220, 225), M.Metal)
		local cloth = B.box(parent, base * CFrame.new(0, 10.5, -1.6), Vector3.new(0.1, 6, 3), B.color(accent), M.Fabric, nc())
		B.sign(cloth, Enum.NormalId.Left, if k % 2 == 0 then "SATIŞ" else "%0 FAİZ", { color = Color3.new(1, 1, 1) })
	end
	return m
end

local function fuelStation(parent, poi, rng)
	local cf, w, d = Commerce.siteFrame(poi, 2)
	local m = B.model("FuelStation", parent)
	local canopy = cf * CFrame.new(0, 0, 22)
	B.box(m, canopy * CFrame.new(0, 14, 0), Vector3.new(40, 1.6, 22), Color3.fromRGB(240, 240, 240), M.SmoothPlastic)
	local band = B.box(m, canopy * CFrame.new(0, 14, -11), Vector3.new(40, 1.6, 0.4), Color3.fromRGB(20, 120, 60), M.SmoothPlastic)
	B.sign(band, Enum.NormalId.Front, "YEŞİL PETROL", { color = Color3.new(1, 1, 1) })
	for k = -1, 1, 2 do
		B.box(m, canopy * CFrame.new(k * 14, 7, 0), Vector3.new(1.2, 14, 1.2), Color3.fromRGB(200, 200, 200), M.Metal)
		for p = -1, 1, 2 do
			local pump = canopy * CFrame.new(k * 14 + p * 4, 0, 0)
			B.box(m, pump * CFrame.new(0, 0.3, 0), Vector3.new(4, 0.6, 7), Color3.fromRGB(180, 180, 180), M.Concrete)
			B.box(m, pump * CFrame.new(0, 3, 0), Vector3.new(2, 5, 1.4), Color3.fromRGB(20, 120, 60), M.SmoothPlastic)
			local screen = B.box(m, pump * CFrame.new(0, 4.2, -0.72), Vector3.new(1.4, 0.8, 0.05), Color3.fromRGB(10, 10, 10), M.Glass, nc())
			B.sign(screen, Enum.NormalId.Front, "42.90", { glow = true, color = Color3.fromRGB(255, 80, 60), font = B.Fonts.Mono })
		end
	end
	for _, l in { Vector3.new(-12, 13, 0), Vector3.new(12, 13, 0) } do
		local p = B.box(m, canopy * CFrame.new(l), Vector3.new(8, 0.2, 4), Color3.fromRGB(255, 255, 255), M.Neon, nc())
		B.spotLight(p, Enum.NormalId.Bottom, 30, 120, 1.5, Color3.fromRGB(255, 255, 250), false)
	end
	Buildings.building(parent, cf * CFrame.new(0, 0, 44), { w = 30, d = math.min(24, d - 50), floors = 1, floorH = 12, style = "modern", ground = "shop", name = "MARKET 7/24", rng = rng, blankSides = true })
	-- price totem
	local totem = B.box(m, cf * CFrame.new(w / 2 - 6, 9, 2), Vector3.new(5, 18, 1.2), Color3.fromRGB(20, 120, 60), M.SmoothPlastic)
	B.sign(totem, Enum.NormalId.Front, "BENZİN 42.90\nMOTORİN 44.15\nLPG 21.30", { color = Color3.new(1, 1, 1), glow = true, font = B.Fonts.Mono })
	return m
end

----------------------------------------------------------------------------------------------------
-- Business / civic interiors with a service desk
----------------------------------------------------------------------------------------------------
local function officeDesk(parent, poi, rng, service, title, action, accent, opts)
	local cf, w, d = Commerce.siteFrame(poi, 4)
	local hw = math.min(w - 20, (opts and opts.width) or 60)
	local hd = d - 14
	local m = Buildings.hall(parent, cf, hw, hd, 14, { name = title, accent = accent, wall = (opts and opts.wall) or { 236, 236, 240 }, floor = (opts and opts.floor) or { 180, 170, 160 }, floorMat = (opts and opts.floorMat) or M.WoodPlanks, modelName = "Office_" .. poi.id })
	deskRow(m, cf * CFrame.new(0, 0.2, hd * 0.45), math.max(1, math.floor(hw / 16)), rng)
	for i = 1, 3 do
		Props.plant(m, cf * CFrame.new(-hw / 2 + 3 + i * 0.1, 0.2, 4 + i * 8), rng)
	end
	if service then
		Commerce.servicePoint(m, cf * CFrame.new(0, 0.2, hd - 8), service, poi.id, action, title)
	end
	-- building mass above the hall
	B.box(parent, cf * CFrame.new(0, 14 + 14, hd / 2), Vector3.new(hw, 28, hd), Rand.pick(rng, { Color3.fromRGB(210, 206, 198), Color3.fromRGB(180, 186, 196) }), M.Concrete)
	return m
end

local function internetCafe(parent, poi, _rng)
	local cf, w, d = Commerce.siteFrame(poi, 4)
	local hw, hd = math.min(w - 20, 60), d - 14
	local m = Buildings.hall(parent, cf, hw, hd, 13, { name = "PIXEL İNTERNET KAFE 🎮", accent = { 120, 40, 200 }, wall = { 30, 30, 40 }, wallMat = M.SmoothPlastic, floor = { 40, 40, 50 }, floorMat = M.Carpet, modelName = "InternetCafe" })
	for row = 0, 2 do
		for i = 0, 5 do
			local c = cf * CFrame.new(-hw / 2 + 6 + i * 8, 0.2, 10 + row * 9)
			B.box(m, c * CFrame.new(0, 2.4, 0), Vector3.new(7, 0.3, 3), Color3.fromRGB(20, 20, 24), M.SmoothPlastic)
			B.box(m, c * CFrame.new(0, 2.36, -1.2), Vector3.new(7, 0.08, 0.3), Color3.fromHSV((i + row) / 7 % 1, 0.8, 1), M.Neon, nc())
			Props.monitor(m, c * CFrame.new(0, 2.55, 0.6), "", Color3.fromHSV((i * 0.13 + row * 0.3) % 1, 0.7, 0.5))
			Props.chair(m, c * CFrame.new(0, 0, -2.2), { 160, 30, 40 })
		end
	end
	Commerce.servicePoint(m, cf * CFrame.new(0, 0.2, hd - 8), "contracts", poi.id, "Toplu İş Al", "Pixel İnternet Kafe")
	B.box(parent, cf * CFrame.new(0, 13 + 13, hd / 2), Vector3.new(hw, 26, hd), Color3.fromRGB(190, 190, 196), M.Concrete)
	return m
end

local function datacenter(parent, poi, _rng)
	local s = poi.site
	local m = B.model("DataCenter", parent)
	local cx = (s.x0 + s.x1) / 2
	local cf = CFrame.lookAt(Vector3.new(cx, WALK_Y, s.z0 + 20), Vector3.new(cx, WALK_Y, s.z0))
	local hw, hd = s.x1 - s.x0 - 30, s.z1 - s.z0 - 50
	local hall = Buildings.hall(m, cf, hw, hd, 20, { name = "BULUT VERİ MERKEZİ", accent = { 30, 60, 110 }, wall = { 190, 196, 204 }, wallMat = M.Metal, floor = { 210, 214, 220 }, floorMat = M.DiamondPlate, modelName = "DataHall" })
	for row = 0, 3 do
		for i = 0, 6 do
			local rack = cf * CFrame.new(-hw / 2 + 10 + i * (hw - 20) / 6, 0.2, 18 + row * 14)
			B.box(hall, rack * CFrame.new(0, 4.5, 0), Vector3.new(3, 9, 5), Color3.fromRGB(20, 22, 26), M.Metal)
			for k = 0, 7 do
				local led = B.box(hall, rack * CFrame.new(-1.2, 1.4 + k, -2.52), Vector3.new(0.3, 0.15, 0.05), if (i + k + row) % 3 == 0 then Color3.fromRGB(40, 255, 120) else Color3.fromRGB(60, 160, 255), M.Neon, nc({ CastShadow = false }))
				led:AddTag("RackLed")
			end
		end
	end
	Commerce.servicePoint(hall, cf * CFrame.new(0, 0.2, 8), "contracts", poi.id, "Kurumsal İş Al", "Bulut Veri Merkezi")
	-- cooling units on the roof and a generator yard
	for i = 0, 3 do
		B.box(m, cf * CFrame.new(-hw / 3 + i * hw / 4.5, 22.5, hd / 2), Vector3.new(8, 3, 8), Color3.fromRGB(200, 200, 204), M.Metal)
		B.cylY(m, cf * CFrame.new(-hw / 3 + i * hw / 4.5, 24.2, hd / 2), 0.3, 6, Color3.fromRGB(40, 40, 44), M.Metal, nc())
	end
	Props.fence(m, Vector3.new(s.x0 + 3, WALK_Y, s.z0 + 3), Vector3.new(cx - 12, WALK_Y, s.z0 + 3), "metal", 6)
	Props.fence(m, Vector3.new(cx + 12, WALK_Y, s.z0 + 3), Vector3.new(s.x1 - 3, WALK_Y, s.z0 + 3), "metal", 6)
	return m
end

local function restaurant(parent, poi, rng, title, accent, tables)
	local cf, w = Commerce.siteFrame(poi, 2)
	local m = Buildings.building(parent, cf * CFrame.new(0, 0, 10), { w = math.min(w - 14, 50), d = 30, floors = rng:NextInteger(2, 3), floorH = 12, style = Rand.pick(rng, { "apartment", "historic" }), ground = "shop", shops = 1, name = title, accent = accent, rng = rng, blankSides = true })
	for i = 1, tables or 4 do
		Props.parasolTable(parent, cf * CFrame.new(-w / 3 + (i - 1) * (w / 1.5) / math.max(1, (tables or 4) - 1), 0, 4), accent, rng)
	end
	return m
end

local function simpleBuilding(parent, poi, rng, title, style, floors, accent, ground)
	local cf, w, d = Commerce.siteFrame(poi, 4)
	return Buildings.building(parent, cf, { w = w - 14, d = math.min(d - 10, 50), floors = floors, floorH = 13, style = style, ground = ground or "lobby", name = title, accent = accent, rng = rng })
end

local function cinema(parent, poi, _rng)
	local cf, w, d = Commerce.siteFrame(poi, 4)
	local m = B.model("Cinema", parent)
	B.box(m, cf * CFrame.new(0, 14, d / 2), Vector3.new(w - 16, 28, d - 16), Color3.fromRGB(60, 30, 50), M.Concrete)
	local marquee = B.box(m, cf * CFrame.new(0, 12, -2), Vector3.new(w - 20, 6, 4), Color3.fromRGB(20, 20, 24), M.SmoothPlastic)
	B.sign(marquee, Enum.NormalId.Front, "YILDIZ SİNEMASI  •  VİZYONDA: 'SON TAMİRCİ'", { color = Color3.fromRGB(255, 220, 90), glow = true, brightness = 2 })
	for i = -3, 3 do
		local bulb = B.ball(m, cf * CFrame.new(i * (w - 24) / 6, 15.4, -4.1), 0.6, Color3.fromRGB(255, 230, 150), M.Neon, nc())
		bulb.Name = "MarqueeBulb"
	end
	B.box(m, cf * CFrame.new(0, 4.5, 0.2), Vector3.new(w - 24, 9, 0.4), Color3.fromRGB(160, 180, 196), M.Glass, { Transparency = 0.5 })
	for k = -1, 1, 2 do
		local poster = B.box(m, cf * CFrame.new(k * (w / 2 - 14), 5, -0.4), Vector3.new(6, 9, 0.3), Color3.fromRGB(30, 30, 30), M.SmoothPlastic, nc())
		B.sign(poster, Enum.NormalId.Front, if k < 0 then "RAM\nSAVAŞLARI" else "MAVİ\nEKRAN 2", { color = Color3.fromRGB(255, 255, 255), background = if k < 0 then Color3.fromRGB(120, 20, 30) else Color3.fromRGB(20, 40, 120), glow = true })
	end
	return m
end

local function arena(parent, poi, _rng)
	local cf, w, d = Commerce.siteFrame(poi, 4)
	local m = Buildings.hall(parent, cf, math.min(w - 20, 70), d - 14, 18, { name = "E-SPOR ARENASI", accent = { 200, 30, 90 }, wall = { 26, 26, 34 }, wallMat = M.SmoothPlastic, floor = { 30, 30, 40 }, floorMat = M.Carpet, modelName = "Arena" })
	local stage = cf * CFrame.new(0, 0.2, d - 26)
	B.box(m, stage * CFrame.new(0, 1.5, 0), Vector3.new(36, 3, 12), Color3.fromRGB(20, 20, 24), M.SmoothPlastic)
	local screen = B.box(m, stage * CFrame.new(0, 11, 6), Vector3.new(30, 12, 0.4), Color3.fromRGB(10, 10, 12), M.SmoothPlastic)
	B.sign(screen, Enum.NormalId.Front, "FİNAL • TAMİRCİLER vs ÇİPLER", { glow = true, brightness = 1.6, color = Color3.new(1, 1, 1), background = Color3.fromRGB(80, 10, 50) })
	for i = -2, 2 do
		B.box(m, stage * CFrame.new(i * 6, 3.4, -2), Vector3.new(4, 0.3, 2), Color3.fromRGB(20, 20, 24), M.SmoothPlastic)
		Props.monitor(m, stage * CFrame.new(i * 6, 3.55, -1.6), "", Color3.fromRGB(80, 10, 50))
	end
	return m
end

-- Builds every commerce POI found in the layout.
function Commerce.build(parent: Instance, L, yieldFn: (() -> ())?)
	local rng = Random.new(4242)
	local folder = B.folder("Commerce", parent)
	local builders = {
		megastore = megastore,
		mall = mall,
		covered_bazaar = coveredBazaar,
		bazaar_parts = bazaarParts,
		used_market = usedMarket,
		flea_market = fleaMarket,
		toolshop = toolShop,
		old_han = oldHan,
		teahouse = teahouse,
		market_hall = marketHall,
		scrapyard = scrapyard,
		car_dealer = function(p, poi, r)
			return dealer(p, poi, r, "cars", "OTO GALERİ 🚗", { 200, 30, 40 })
		end,
		bike_dealer = function(p, poi, r)
			return dealer(p, poi, r, "bikes", "MOTOR BAYİ 🏍", { 240, 120, 20 })
		end,
		bicycle_shop = function(p, poi, r)
			return dealer(p, poi, r, "bicycles", "BİSİKLET & SCOOTER 🚲", { 40, 160, 90 })
		end,
		gas_north = fuelStation,
		gas_west = fuelStation,
		staff_agency = function(p, poi, r)
			return officeDesk(p, poi, r, "staff", "PERSONEL AJANSI", "Personel Bul", { 120, 70, 200 })
		end,
		realty = function(p, poi, r)
			return officeDesk(p, poi, r, "realty", "EMLAK OFİSİ 🔑", "Dükkân Bul", { 30, 120, 90 })
		end,
		police = function(p, poi, r)
			return officeDesk(p, poi, r, "police", "POLİS MERKEZİ", "Ödül Al", { 30, 50, 120 }, { wall = { 220, 226, 236 }, floor = { 200, 200, 204 }, floorMat = M.CeramicTiles })
		end,
		post = function(p, poi, r)
			return officeDesk(p, poi, r, nil, "PTT POSTANE", "", { 250, 200, 20 })
		end,
		internet_cafe = internetCafe,
		datacenter = datacenter,
		cargo = function(p, poi, r)
			local cf, w, d = Commerce.siteFrame(poi, 6)
			return Buildings.warehouse(p, cf, w - 16, math.min(d - 16, 60), r, { sign = "HIZLI KARGO DEPOSU", color = { 230, 150, 30 } })
		end,
		industrial = function(p, poi, r)
			local s = poi.site
			local m = B.model("Industrial", p)
			for k = 0, 1 do
				local z = if k == 0 then s.z0 else s.z1
				local look = if k == 0 then Vector3.new(0, 0, -1) else Vector3.new(0, 0, 1)
				local pos = Vector3.new((s.x0 + s.x1) / 2, WALK_Y, z - look.Z * 8)
				Buildings.warehouse(m, CFrame.lookAt(pos, pos + look), s.x1 - s.x0 - 20, (s.z1 - s.z0) / 2 - 20, r, { sign = Rand.pick(r, { "SANAYİ SİTESİ OTO TAMİR", "ÇELİK KONSTRÜKSİYON", "MOBİLYA ATÖLYESİ" }), chimney = k == 0 })
			end
			return m
		end,
		cinema = cinema,
		arena = arena,
		kebab = function(p, poi, r)
			return restaurant(p, poi, r, "DÖNERCİ USTA", { 200, 40, 30 }, 4)
		end,
		bakery = function(p, poi, r)
			return restaurant(p, poi, r, "TAŞ FIRIN", { 170, 110, 50 }, 2)
		end,
		pizzeria = function(p, poi, r)
			return restaurant(p, poi, r, "NAPOLİ PİZZA", { 30, 130, 60 }, 5)
		end,
		fish = function(p, poi, r)
			return restaurant(p, poi, r, "BALIKÇI BARINAĞI", { 30, 90, 150 }, 6)
		end,
		icecream = function(p, poi, r)
			return restaurant(p, poi, r, "MARAŞ DONDURMACISI", { 240, 120, 160 }, 4)
		end,
		gym = function(p, poi, r)
			return simpleBuilding(p, poi, r, "DEMİR SPOR SALONU", "modern", 3, { 30, 30, 34 }, "shop")
		end,
		hotel = function(p, poi, r)
			return simpleBuilding(p, poi, r, "GRAND SAHİL OTELİ", "modern", 12, { 160, 120, 40 })
		end,
	}
	for _, poi in L.pois do
		local fn = builders[poi.id]
		if fn and poi.site then
			local ok, err = pcall(fn, folder, poi, rng)
			if not ok then
				warn("[World] failed to build " .. poi.id .. ": " .. tostring(err))
				Commerce.lastError = err
			end
			if yieldFn then
				yieldFn()
			end
		end
	end
	return folder
end

return Commerce
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1333">
          <Properties>
            <string name="Name">LandmarksNature</string>
            <string name="Source"><![CDATA[-- Nature and leisure: Lake Park, the funfair, the container port, the marina, the old pier,
-- the lighthouse, the beach, the northern hills (viewpoint, wind farm, campsite, radio tower),
-- the farm and the forests around the city. Moving parts are tagged for client-side animation.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local B = require(Shared.Util.Builder)
local Rand = require(Shared.Util.Rand)
local Props = require(Shared.Models.Props)
local Buildings = require(Shared.Models.Buildings)
local CityLayout = require(Shared.World.CityLayout)
local Terrain = require(script.Parent.TerrainBuilder)

local Nature = {}
local M = Enum.Material
local WALK_Y = CityLayout.WALK_Y

local function nc(extra)
	local t = { CanCollide = false, CanTouch = false }
	if extra then
		for k, v in extra do
			t[k] = v
		end
	end
	return t
end

local function ground(x: number, z: number): number
	return Terrain.groundHeight(x, z)
end

----------------------------------------------------------------------------------------------------
-- Lake Park
----------------------------------------------------------------------------------------------------
local function park(parent, poi, rng)
	local s = poi.site
	local m = B.model("LakePark", parent)
	local PARK_Y = 0 -- the park has no paving slab: it sits on terrain grass around the lake
	local lake = Terrain.Lake
	-- the block ground is grass; cut the lake out visually by leaving it to the terrain water
	local path = Color3.fromRGB(206, 190, 160)
	-- winding loop path around the lake (segments)
	local n = 28
	for i = 0, n - 1 do
		local a0, a1 = i / n * math.pi * 2, (i + 1) / n * math.pi * 2
		local r = lake.radius + 26
		local p0 = Vector3.new(lake.x + math.cos(a0) * r, PARK_Y + 0.06, lake.z + math.sin(a0) * r * 0.9)
		local p1 = Vector3.new(lake.x + math.cos(a1) * r, PARK_Y + 0.06, lake.z + math.sin(a1) * r * 0.9)
		local len = (p1 - p0).Magnitude
		B.box(m, CFrame.lookAt((p0 + p1) / 2, p1), Vector3.new(8, 0.12, len + 1), path, M.Pavement, nc({ CanCollide = true }))
		if i % 3 == 0 then
			local out = ((p0 - Vector3.new(lake.x, p0.Y, lake.z)).Unit)
			Props.bench(m, CFrame.lookAt(p0 + out * 6, Vector3.new(lake.x, p0.Y, lake.z)))
		elseif i % 3 == 1 then
			local out = ((p0 - Vector3.new(lake.x, p0.Y, lake.z)).Unit)
			Props.streetLamp(m, CFrame.lookAt(p0 + out * 6, Vector3.new(lake.x, p0.Y, lake.z)), "classic")
		end
	end
	-- straight paths from the park gates to the loop
	for _, g in { Vector3.new(lake.x, 0, s.z0 + 4), Vector3.new(lake.x, 0, s.z1 - 4), Vector3.new(s.x0 + 4, 0, lake.z), Vector3.new(s.x1 - 4, 0, lake.z) } do
		local target = Vector3.new(lake.x, 0, lake.z)
		local dir = (target - g).Unit
		local len = (target - g).Magnitude - lake.radius - 26
		if len > 4 then
			local mid = g + dir * len / 2
			B.box(m, CFrame.lookAt(Vector3.new(mid.X, PARK_Y + 0.06, mid.Z), Vector3.new(target.X, PARK_Y + 0.06, target.Z)), Vector3.new(8, 0.12, len), path, M.Pavement, nc({ CanCollide = true }))
		end
	end
	-- arched wooden bridge across the narrow part of the lake
	local bridge = CFrame.lookAt(Vector3.new(lake.x + 30, 0, lake.z + 40), Vector3.new(lake.x + 70, 0, lake.z + 20))
	local wood = Color3.fromRGB(150, 100, 60)
	for k = -4, 4 do
		local y = 3.2 - (k * k) * 0.16
		B.box(m, bridge * CFrame.new(0, y, k * 4), Vector3.new(8, 0.6, 4.2), wood, M.WoodPlanks)
		for side = -1, 1, 2 do
			B.box(m, bridge * CFrame.new(side * 3.8, y + 1.6, k * 4), Vector3.new(0.3, 3, 0.3), wood, M.Wood)
		end
	end
	for side = -1, 1, 2 do
		B.box(m, bridge * CFrame.new(side * 3.8, 5.6, 0), Vector3.new(0.3, 0.3, 34), Color3.fromRGB(200, 60, 40), M.Wood)
	end
	-- gazebo on a little island point
	local gz = CFrame.new(lake.x - lake.radius - 10, PARK_Y, lake.z - 20)
	B.cylY(m, gz * CFrame.new(0, 0.5, 0), 1, 18, Color3.fromRGB(220, 214, 200), M.Marble)
	for i = 0, 5 do
		local a = i * math.pi / 3
		B.cylY(m, gz * CFrame.new(math.cos(a) * 7.5, 5.5, math.sin(a) * 7.5), 10, 0.8, Color3.fromRGB(245, 245, 240), M.Wood)
	end
	B.spire(m, gz * CFrame.new(0, 13, 0), 20, 5, Color3.fromRGB(120, 60, 50), M.ClayRoofTiles)
	-- playground
	local pg = CFrame.new(s.x1 - 60, PARK_Y, s.z0 + 60)
	B.box(m, pg * CFrame.new(0, 0.05, 0), Vector3.new(40, 0.1, 30), Color3.fromRGB(226, 200, 150), M.Sand, nc({ CanCollide = true }))
	B.box(m, pg * CFrame.new(-10, 5, 0), Vector3.new(6, 0.5, 6), Color3.fromRGB(240, 70, 60), M.SmoothPlastic)
	for x = -1, 1, 2 do
		for z = -1, 1, 2 do
			B.box(m, pg * CFrame.new(-10 + x * 2.8, 2.5, z * 2.8), Vector3.new(0.5, 5, 0.5), Color3.fromRGB(40, 120, 220), M.Metal)
		end
	end
	B.wedge(m, pg * CFrame.new(-10, 2.6, -7.6), Vector3.new(3, 5, 9), Color3.fromRGB(250, 200, 40), M.SmoothPlastic)
	-- swings
	B.box(m, pg * CFrame.new(10, 8, 0), Vector3.new(14, 0.5, 0.5), Color3.fromRGB(40, 120, 220), M.Metal)
	for x = -1, 1, 2 do
		B.box(m, pg * CFrame.new(10 + x * 6.8, 4, 0) * CFrame.Angles(0, 0, x * 0.18), Vector3.new(0.5, 8.4, 0.5), Color3.fromRGB(40, 120, 220), M.Metal)
	end
	for k = -1, 1, 2 do
		local seat = B.box(m, pg * CFrame.new(10 + k * 2.5, 2.4, 0), Vector3.new(2, 0.3, 1), Color3.fromRGB(240, 70, 60), M.SmoothPlastic, nc())
		seat:AddTag("Swing")
	end
	-- lots of trees, flower beds, picnic tables
	for _ = 1, 90 do
		local x, z = Rand.range(rng, s.x0 + 8, s.x1 - 8), Rand.range(rng, s.z0 + 8, s.z1 - 8)
		local dl = math.sqrt((x - lake.x) ^ 2 + ((z - lake.z) / 0.9) ^ 2)
		local inPlay = math.abs(x - (s.x1 - 60)) < 26 and math.abs(z - (s.z0 + 60)) < 22
		if dl > lake.radius + 36 and not inPlay then
			Props.tree(m, CFrame.new(x, PARK_Y, z), Rand.pick(rng, { "oak", "oak", "oak", "birch", "pine", "cypress", "bush" }), rng)
		end
	end
	for _ = 1, 8 do
		local a = rng:NextNumber() * math.pi * 2
		local r = lake.radius + Rand.range(rng, 40, 70)
		Props.flowerBed(m, CFrame.new(lake.x + math.cos(a) * r, PARK_Y, lake.z + math.sin(a) * r), 10, 4, rng)
	end
	for _ = 1, 6 do
		local p = CFrame.new(Rand.range(rng, s.x0 + 30, s.x0 + 120), PARK_Y, Rand.range(rng, s.z1 - 100, s.z1 - 20))
		B.box(m, p * CFrame.new(0, 2.4, 0), Vector3.new(8, 0.4, 3), Color3.fromRGB(150, 110, 70), M.WoodPlanks)
		for side = -1, 1, 2 do
			B.box(m, p * CFrame.new(0, 1.4, side * 2.6), Vector3.new(8, 0.3, 1.2), Color3.fromRGB(150, 110, 70), M.WoodPlanks)
		end
	end
	-- duck marker points on the lake for the client
	for i = 1, 6 do
		local a = i * math.pi / 3
		local duck = B.marker(m, "DuckSpot", CFrame.new(lake.x + math.cos(a) * lake.radius * 0.5, 0.2, lake.z + math.sin(a) * lake.radius * 0.5))
		duck:AddTag("DuckSpot")
	end
	-- park entrance arches
	local gate = CFrame.lookAt(Vector3.new(lake.x, PARK_Y, s.z1 - 2), Vector3.new(lake.x, PARK_Y, s.z1 + 10))
	for side = -1, 1, 2 do
		B.box(m, gate * CFrame.new(side * 7, 6, 0), Vector3.new(2, 12, 2), Color3.fromRGB(110, 80, 60), M.Brick)
	end
	local arch = B.box(m, gate * CFrame.new(0, 12.6, 0), Vector3.new(16, 2, 2), Color3.fromRGB(110, 80, 60), M.Brick)
	B.sign(arch, Enum.NormalId.Front, "GÖL PARK", { color = Color3.fromRGB(250, 230, 180), font = B.Fonts.Serif })
	return m
end

----------------------------------------------------------------------------------------------------
-- Funfair
----------------------------------------------------------------------------------------------------
local function lunapark(parent, poi, rng)
	local s = poi.site
	local m = B.model("Lunapark", parent)
	local cx, cz = (s.x0 + s.x1) / 2, (s.z0 + s.z1) / 2
	-- ferris wheel (the "Wheel" model is rotated by clients)
	local hub = CFrame.new(cx - 80, WALK_Y + 46, cz - 60)
	-- A-frame legs on both sides of the wheel plane (the axle runs along X)
	for side = -1, 1, 2 do
		for fb = -1, 1, 2 do
			B.box(m, CFrame.new(cx - 80 + side * 7, WALK_Y + 23, cz - 60 + fb * 9) * CFrame.Angles(-fb * 0.373, 0, 0), Vector3.new(2, 49.5, 2), Color3.fromRGB(240, 240, 240), M.Metal)
		end
	end
	local wheel = B.model("Wheel", m)
	local axle = B.cyl(wheel, hub, 14, 3, Color3.fromRGB(80, 80, 86), M.Metal)
	axle.Name = "Axle"
	wheel.PrimaryPart = axle
	local spokes = 16
	local R = 38
	for i = 0, spokes - 1 do
		local a = i / spokes * math.pi * 2
		local p = Vector3.new(0, math.sin(a) * R, math.cos(a) * R)
		for side = -1, 1, 2 do
			B.box(wheel, hub * CFrame.new(side * 5, 0, 0) * CFrame.Angles(-a, 0, 0) * CFrame.new(0, 0, R / 2), Vector3.new(0.5, 0.5, R), Color3.fromRGB(240, 240, 240), M.Metal, nc())
		end
		local nxt = Vector3.new(0, math.sin(a + math.pi * 2 / spokes) * R, math.cos(a + math.pi * 2 / spokes) * R)
		for side = -1, 1, 2 do
			local p0 = (hub * CFrame.new(side * 5, p.Y, p.Z)).Position
			local p1 = (hub * CFrame.new(side * 5, nxt.Y, nxt.Z)).Position
			local rim = B.box(wheel, CFrame.lookAt((p0 + p1) / 2, p1), Vector3.new(0.7, 0.7, (p1 - p0).Magnitude + 0.4), Color3.fromHSV(i / spokes, 0.6, 1), M.Neon, nc())
			rim.Name = "Rim"
		end
		local cabin = B.box(wheel, hub * CFrame.new(0, p.Y - 3, p.Z), Vector3.new(6, 4, 4), Color3.fromHSV(i / spokes, 0.7, 0.9), M.SmoothPlastic, nc())
		cabin.Name = "Cabin"
	end
	wheel:AddTag("FerrisWheel")
	-- carousel (rotated by clients)
	local car = CFrame.new(cx + 40, WALK_Y, cz - 70)
	B.cylY(m, car * CFrame.new(0, 0.6, 0), 1.2, 30, Color3.fromRGB(240, 230, 210), M.Wood)
	local top = B.model("Carousel", m)
	local roof = B.cylY(top, car * CFrame.new(0, 12, 0), 2, 32, Color3.fromRGB(220, 60, 80), M.Fabric)
	top.PrimaryPart = roof
	B.spire(top, car * CFrame.new(0, 15.5, 0), 30, 5, Color3.fromRGB(250, 240, 230), M.Fabric)
	for i = 0, 7 do
		local a = i * math.pi / 4
		B.cylY(top, car * CFrame.new(math.cos(a) * 11, 6.5, math.sin(a) * 11), 11, 0.4, Color3.fromRGB(230, 190, 80), M.Metal, nc())
		local horse = B.box(top, car * CFrame.new(math.cos(a) * 11, 4.5, math.sin(a) * 11) * CFrame.Angles(0, -a, 0), Vector3.new(1.2, 2.4, 4), Color3.fromRGB(250, 250, 250), M.SmoothPlastic, nc())
		horse.Name = "Horse"
	end
	top:AddTag("Carousel")
	-- roller coaster frame (static) with a looping track along the back
	local track = Color3.fromRGB(240, 70, 50)
	local pts = {}
	for i = 0, 40 do
		local t = i / 40
		local x = s.x0 + 30 + t * (s.x1 - s.x0 - 60)
		local y = WALK_Y + 10 + math.abs(math.sin(t * math.pi * 3)) * 26
		table.insert(pts, Vector3.new(x, y, s.z1 - 40 + math.sin(t * math.pi * 2) * 14))
	end
	for i = 1, #pts - 1 do
		local a, b2 = pts[i], pts[i + 1]
		B.box(m, CFrame.lookAt((a + b2) / 2, b2), Vector3.new(4, 0.6, (b2 - a).Magnitude + 0.3), track, M.Metal, nc())
		if i % 2 == 0 then
			B.box(m, CFrame.new(a.X, (a.Y + WALK_Y) / 2, a.Z), Vector3.new(0.8, a.Y - WALK_Y, 0.8), Color3.fromRGB(240, 240, 240), M.Metal)
		end
	end
	-- food and game stalls
	for i = 0, 7 do
		local c = CFrame.lookAt(Vector3.new(s.x0 + 30 + i * 22, WALK_Y, cz + 30), Vector3.new(s.x0 + 30 + i * 22, WALK_Y, cz))
		local col = Color3.fromHSV(i / 8, 0.6, 0.95)
		B.box(m, c * CFrame.new(0, 2, 2), Vector3.new(10, 4, 6), Color3.fromRGB(250, 248, 240), M.Wood)
		B.wedge(m, c * CFrame.new(0, 7.4, 1.4), Vector3.new(11, 2, 7), col, M.Fabric)
		for x = -1, 1, 2 do
			B.box(m, c * CFrame.new(x * 5, 4, -0.8), Vector3.new(0.4, 6, 0.4), col, M.Wood)
		end
		local sign = B.box(m, c * CFrame.new(0, 9, -0.4), Vector3.new(8, 1.6, 0.3), col, M.SmoothPlastic, nc())
		B.sign(sign, Enum.NormalId.Front, ({ "PAMUK ŞEKER", "MISIR", "BALON PATLAT", "ÇİĞ KÖFTE", "KUMPİR", "HALKA AT", "DONDURMA", "LUNAPARK BİLET" })[i + 1], { color = Color3.new(1, 1, 1) })
		local bulb = B.box(m, c * CFrame.new(0, 8, -0.8), Vector3.new(9, 0.3, 0.3), Color3.fromRGB(255, 230, 160), M.Neon, nc())
		bulb.Name = "StallLights"
	end
	local gate = CFrame.lookAt(Vector3.new(cx, WALK_Y, s.z0 + 2), Vector3.new(cx, WALK_Y, s.z0 - 10))
	local arch = B.box(m, gate * CFrame.new(0, 16, 0), Vector3.new(30, 4, 2), Color3.fromRGB(240, 60, 120), M.SmoothPlastic)
	B.sign(arch, Enum.NormalId.Front, "🎡 LUNAPARK 🎡", { color = Color3.new(1, 1, 1), glow = true, brightness = 1.5 })
	for side = -1, 1, 2 do
		B.box(m, gate * CFrame.new(side * 14, 8, 0), Vector3.new(2, 16, 2), Color3.fromRGB(250, 220, 60), M.SmoothPlastic)
	end
	for _ = 1, 20 do
		Props.tree(m, CFrame.new(Rand.range(rng, s.x0 + 10, s.x1 - 10), WALK_Y, Rand.range(rng, cz - 10, cz + 10)), "palm", rng)
	end
	return m
end

----------------------------------------------------------------------------------------------------
-- Container port
----------------------------------------------------------------------------------------------------
local function harbor(parent, poi, rng)
	local s = poi.site
	local m = B.model("ContainerPort", parent)
	-- quay wall and bollards
	local quayZ = s.z1
	B.box(m, CFrame.new((s.x0 + s.x1) / 2, -4, quayZ - 1.5), Vector3.new(s.x1 - s.x0, 10, 3), Color3.fromRGB(150, 150, 150), M.Concrete)
	for x = s.x0 + 10, s.x1 - 10, 22 do
		B.cylY(m, CFrame.new(x, WALK_Y + 1, quayZ - 3), 2, 1.6, Color3.fromRGB(40, 40, 44), M.Metal)
	end
	-- container stacks
	for row = 0, 3 do
		for col = 0, 5 do
			local x = s.x0 + 40 + col * 60
			local z = s.z0 + 60 + row * 70
			if x < s.x1 - 30 and z < quayZ - 70 then
				local h = rng:NextInteger(1, 4)
				for k = 0, h - 1 do
					Props.container(m, CFrame.new(x + (k % 2) * 0.2, WALK_Y + k * 8.6, z), rng)
					Props.container(m, CFrame.new(x + 9, WALK_Y + k * 8.6, z), rng)
				end
			end
		end
	end
	-- gantry cranes on the quay
	for k = 0, 2 do
		local x = s.x0 + 70 + k * 130
		local c = CFrame.new(x, WALK_Y, quayZ - 20)
		local yellow = Color3.fromRGB(240, 180, 30)
		for sx = -1, 1, 2 do
			for sz = -1, 1, 2 do
				B.box(m, c * CFrame.new(sx * 12, 26, sz * 12), Vector3.new(2.4, 52, 2.4), yellow, M.Metal)
			end
		end
		B.box(m, c * CFrame.new(0, 53, 20), Vector3.new(4, 4, 100), yellow, M.Metal)
		B.box(m, c * CFrame.new(0, 48, 0), Vector3.new(28, 3, 28), yellow, M.Metal)
		B.box(m, c * CFrame.new(0, 56, -10), Vector3.new(10, 8, 12), Color3.fromRGB(240, 240, 240), M.Metal)
		local cab = B.box(m, c * CFrame.new(0, 47, 30), Vector3.new(6, 4, 6), Color3.fromRGB(60, 60, 64), M.Metal)
		cab.Name = "Trolley"
	end
	-- container ship moored in the basin
	local ship = CFrame.new((s.x0 + s.x1) / 2, Terrain.SEA_LEVEL, quayZ + 40)
	B.box(m, ship * CFrame.new(0, 2, 0), Vector3.new(300, 16, 46), Color3.fromRGB(30, 60, 110), M.Metal)
	B.box(m, ship * CFrame.new(0, -4.5, 0), Vector3.new(298, 3, 45), Color3.fromRGB(150, 40, 40), M.Metal)
	B.box(m, ship * CFrame.new(130, 20, 0), Vector3.new(24, 22, 40), Color3.fromRGB(240, 240, 240), M.Metal)
	B.box(m, ship * CFrame.new(130, 32, 0), Vector3.new(18, 2, 44), Color3.fromRGB(240, 240, 240), M.Metal)
	B.box(m, ship * CFrame.new(140, 36, 0), Vector3.new(6, 10, 6), Color3.fromRGB(30, 30, 30), M.Metal)
	for k = 0, 9 do
		for j = 0, 1 do
			Props.container(m, CFrame.new(ship.X - 120 + k * 24, ship.Y + 10 + j * 8.6, ship.Z) * CFrame.Angles(0, math.pi / 2, 0), rng)
		end
	end
	local name = B.box(m, ship * CFrame.new(0, 6, 23.1), Vector3.new(60, 6, 0.2), Color3.fromRGB(30, 60, 110), M.SmoothPlastic, nc())
	B.sign(name, Enum.NormalId.Back, "MV ANADOLU", { color = Color3.new(1, 1, 1) })
	return m
end

----------------------------------------------------------------------------------------------------
-- Coast: marina docks, the pier, lighthouse, beach
----------------------------------------------------------------------------------------------------
local function marina(parent, poi, rng)
	local s = poi.site
	local m = B.model("Marina", parent)
	local cx = (s.x0 + s.x1) / 2
	local clubCf = CFrame.lookAt(Vector3.new(cx, WALK_Y, s.z1 - 6), Vector3.new(cx, WALK_Y, s.z1 + 10))
	Buildings.building(m, clubCf * CFrame.new(0, 0, 30), { w = 80, d = 40, floors = 2, floorH = 14, style = "modern", ground = "lobby", name = "YAT KULÜBÜ ⛵", rng = rng, glassColor = { 80, 140, 170 }, wallColor = { 240, 240, 240 } })
	-- boats on trailers in the yard
	for i = 0, 4 do
		Props.boat(m, CFrame.new(s.x0 + 30 + i * 40, WALK_Y + 2, s.z0 + 40) * CFrame.Angles(0, math.pi / 2, 0), nil, rng)
	end
	-- floating docks with yachts out on the sea in front of the marina block
	local seaZ = CityLayout.SEA_Z
	for k = 0, 3 do
		local x = s.x0 + 40 + k * ((s.x1 - s.x0 - 80) / 3)
		local dock = CFrame.new(x, Terrain.SEA_LEVEL + 1, seaZ + 50)
		B.box(m, dock, Vector3.new(6, 1, 110), Color3.fromRGB(170, 140, 100), M.WoodPlanks)
		for j = 0, 3 do
			for side = -1, 1, 2 do
				local y = CFrame.new(x + side * 12, Terrain.SEA_LEVEL - 0.5, seaZ + 10 + j * 26)
				local yacht = Props.boat(m, y, nil, rng)
				yacht:AddTag("Boat")
				for _, d in yacht:GetDescendants() do
					if d:IsA("BasePart") then
						d.CanCollide = false
					end
				end
			end
		end
	end
	return m
end

local function pier(parent, poi, _rng)
	local p = poi.pos
	local m = B.model("OldPier", parent)
	local wood = Color3.fromRGB(150, 116, 80)
	local start = CityLayout.BEACH_Z + 4
	local length = 150
	B.box(m, CFrame.new(p.X, WALK_Y + 0.2, start + length / 2), Vector3.new(16, 1, length), wood, M.WoodPlanks)
	for z = start, start + length, 12 do
		for side = -1, 1, 2 do
			B.cylY(m, CFrame.new(p.X + side * 7.5, -6, z), 14, 1.2, Color3.fromRGB(90, 70, 50), M.Wood)
			B.box(m, CFrame.new(p.X + side * 7.8, WALK_Y + 2.2, z), Vector3.new(0.3, 3, 0.3), wood, M.Wood)
		end
	end
	for side = -1, 1, 2 do
		B.box(m, CFrame.new(p.X + side * 7.8, WALK_Y + 3.6, start + length / 2), Vector3.new(0.3, 0.3, length), wood, M.Wood)
	end
	-- ferry terminal at the end
	local term = CFrame.lookAt(Vector3.new(p.X, WALK_Y, start + length - 6), Vector3.new(p.X, WALK_Y, start))
	B.box(m, CFrame.new(p.X, WALK_Y + 0.2, start + length + 12), Vector3.new(40, 1, 30), wood, M.WoodPlanks)
	B.box(m, term * CFrame.new(0, 7, -10), Vector3.new(26, 14, 16), Color3.fromRGB(240, 236, 226), M.Wood)
	B.box(m, term * CFrame.new(0, 14.8, -10), Vector3.new(30, 1.6, 20), Color3.fromRGB(150, 40, 40), M.ClayRoofTiles)
	local sign = B.box(m, term * CFrame.new(0, 11, -1.8), Vector3.new(16, 2, 0.3), Color3.fromRGB(20, 50, 100), M.SmoothPlastic, nc())
	B.sign(sign, Enum.NormalId.Front, "VAPUR İSKELESİ", { color = Color3.new(1, 1, 1) })
	-- anglers' buckets and lamps
	for k = 0, 5 do
		Props.streetLamp(m, CFrame.lookAt(Vector3.new(p.X + 7, WALK_Y + 0.7, start + 10 + k * 24), Vector3.new(p.X, WALK_Y + 0.7, start + 10 + k * 24)), "classic")
	end
	return m
end

local function lighthouse(parent, poi, rng)
	local p = poi.pos
	local m = B.model("Lighthouse", parent)
	-- rocky jetty
	for i = 0, 10 do
		B.ball(m, CFrame.new(p.X - 60 + i * 6, Terrain.SEA_LEVEL - 1, p.Z - 40 + i * 4), Rand.range(rng, 6, 9), Color3.fromRGB(120, 116, 110), M.Rock)
	end
	B.cylY(m, CFrame.new(p.X, Terrain.SEA_LEVEL + 1, p.Z), 6, 22, Color3.fromRGB(130, 126, 120), M.Rock)
	local base = CFrame.new(p.X, Terrain.SEA_LEVEL + 4, p.Z)
	local white, red = Color3.fromRGB(245, 245, 240), Color3.fromRGB(200, 40, 40)
	for i = 0, 7 do
		B.cylY(m, base * CFrame.new(0, 2.5 + i * 5, 0), 5, 10 - i * 0.5, if i % 2 == 0 then white else red, M.SmoothPlastic)
	end
	B.cylY(m, base * CFrame.new(0, 42.5, 0), 1, 9, Color3.fromRGB(40, 40, 44), M.Metal)
	B.cylY(m, base * CFrame.new(0, 46, 0), 6, 6, Color3.fromRGB(200, 220, 230), M.Glass, nc({ Transparency = 0.4 }))
	B.ball(m, base * CFrame.new(0, 50, 0), 6, red, M.Metal)
	local lamp = B.box(m, base * CFrame.new(0, 46, 0), Vector3.new(2, 2, 2), Color3.fromRGB(255, 250, 220), M.Neon, nc({ Name = "Lamp" }))
	local beam = B.model("Beam", m)
	local pivot = B.box(beam, base * CFrame.new(0, 46, 0), Vector3.new(1, 1, 1), Color3.new(1, 1, 1), M.SmoothPlastic, nc({ Transparency = 1, Name = "Pivot" }))
	beam.PrimaryPart = pivot
	local light = B.spotLight(pivot, Enum.NormalId.Front, 60, 25, 4, Color3.fromRGB(255, 250, 220), false)
	light.Enabled = false
	local cone = B.box(beam, base * CFrame.new(0, 46, -40), Vector3.new(3, 3, 80), Color3.fromRGB(255, 250, 220), M.Neon, nc({ Transparency = 0.85, CastShadow = false, Name = "Cone" }))
	cone:AddTag("NightOnly")
	beam:AddTag("LighthouseBeam")
	lamp:AddTag("NightLight")
	return m
end

local function beach(parent, _poi, rng)
	local m = B.model("Beach", parent)
	local z0 = CityLayout.BEACH_Z + 10
	local x0, x1 = CityLayout.XS[3], CityLayout.XS[#CityLayout.XS]
	local cols = { Color3.fromRGB(230, 60, 60), Color3.fromRGB(40, 120, 200), Color3.fromRGB(250, 200, 40), Color3.fromRGB(240, 240, 236), Color3.fromRGB(40, 170, 120) }
	local x = x0 + 20
	while x < x1 - 20 do
		if math.abs(x - (-120)) > 20 then
			for row = 0, 1 do
				local p = Vector3.new(x + Rand.range(rng, -4, 4), 0.2, z0 + 12 + row * 18 + Rand.range(rng, -3, 3))
				local col = Rand.pick(rng, cols)
				B.cylY(m, CFrame.new(p) * CFrame.new(0, 4, 0), 8, 0.3, Color3.fromRGB(240, 240, 240), M.Metal, nc())
				B.spire(m, CFrame.new(p) * CFrame.new(0, 8.6, 0) * CFrame.Angles(0, rng:NextNumber() * 3, 0), 9, 1.8, col, M.Fabric, nc())
				for side = -1, 1, 2 do
					local l = CFrame.new(p) * CFrame.new(side * 3, 0.6, 2) * CFrame.Angles(0, 0, 0)
					B.box(m, l, Vector3.new(2.2, 0.3, 6), Color3.fromRGB(250, 250, 250), M.SmoothPlastic)
					B.box(m, l * CFrame.new(0, 0.9, 2.4) * CFrame.Angles(math.rad(50), 0, 0), Vector3.new(2.2, 0.3, 2.4), Color3.fromRGB(250, 250, 250), M.SmoothPlastic, nc())
					local towel = B.box(m, l * CFrame.new(0, 0.2, 0), Vector3.new(2, 0.05, 5), col:Lerp(Color3.new(1, 1, 1), 0.3), M.Fabric, nc())
					towel.Name = "Towel"
				end
			end
		end
		x += 26
	end
	-- volleyball net
	local net = CFrame.new(300, 0.2, z0 + 34)
	for side = -1, 1, 2 do
		B.cylY(m, net * CFrame.new(side * 14, 4, 0), 8, 0.4, Color3.fromRGB(240, 240, 240), M.Metal)
	end
	B.box(m, net * CFrame.new(0, 6.2, 0), Vector3.new(28, 3, 0.1), Color3.fromRGB(240, 240, 240), M.ForceField, nc({ Transparency = 0.3 }))
	-- lifeguard towers
	for _, lx in { -400, 150, 700 } do
		local t = CFrame.new(lx, 0.2, z0 + 26)
		for sx = -1, 1, 2 do
			for sz = -1, 1, 2 do
				B.box(m, t * CFrame.new(sx * 2.4, 5, sz * 2.4), Vector3.new(0.5, 10, 0.5), Color3.fromRGB(240, 240, 240), M.Wood)
			end
		end
		B.box(m, t * CFrame.new(0, 10.2, 0), Vector3.new(6, 0.4, 6), Color3.fromRGB(200, 40, 40), M.Wood)
		B.box(m, t * CFrame.new(0, 12, 2.8), Vector3.new(6, 3.4, 0.3), Color3.fromRGB(200, 40, 40), M.Wood)
		B.spire(m, t * CFrame.new(0, 15, 0), 8, 2, Color3.fromRGB(240, 240, 240), M.Fabric, nc())
		local flag = B.box(m, t * CFrame.new(3.4, 17, 0), Vector3.new(0.1, 1.6, 2.4), Color3.fromRGB(240, 200, 30), M.Fabric, nc())
		flag.Name = "SafetyFlag"
	end
	return m
end

----------------------------------------------------------------------------------------------------
-- Northern hills, countryside, farm
----------------------------------------------------------------------------------------------------
local function viewpoint(parent, poi, _rng)
	local p = poi.pos
	local y = ground(p.X, p.Z)
	local m = B.model("Viewpoint", parent)
	local base = CFrame.new(p.X, y + 0.4, p.Z + 20)
	B.box(m, base * CFrame.new(0, -0.2, 0), Vector3.new(50, 1, 30), Color3.fromRGB(196, 186, 170), M.Pavement)
	-- railing facing the city (south)
	for x = -24, 24, 4 do
		B.box(m, base * CFrame.new(x, 1.8, 15), Vector3.new(0.4, 3.6, 0.4), Color3.fromRGB(60, 60, 64), M.Metal)
	end
	B.box(m, base * CFrame.new(0, 3.6, 15), Vector3.new(50, 0.4, 0.4), Color3.fromRGB(60, 60, 64), M.Metal)
	for k = -1, 1, 2 do
		local tel = base * CFrame.new(k * 10, 0, 12)
		B.cylY(m, tel * CFrame.new(0, 1.8, 0), 3.6, 0.5, Color3.fromRGB(80, 80, 86), M.Metal)
		B.cyl(m, tel * CFrame.new(0, 3.8, 0.4) * CFrame.Angles(0, math.pi / 2, math.rad(-10)), 2.4, 1, Color3.fromRGB(40, 80, 140), M.Metal)
		Props.bench(m, CFrame.lookAt((base * CFrame.new(k * 18, 0, 6)).Position, (base * CFrame.new(k * 18, 0, 30)).Position))
	end
	local kiosk = CFrame.lookAt((base * CFrame.new(0, 0, -10)).Position, (base * CFrame.new(0, 0, 10)).Position)
	B.box(m, kiosk * CFrame.new(0, 4, 2), Vector3.new(12, 8, 6), Color3.fromRGB(150, 110, 70), M.WoodPlanks)
	local sign = B.box(m, kiosk * CFrame.new(0, 9, -1), Vector3.new(12, 2, 0.4), Color3.fromRGB(40, 90, 60), M.Wood)
	B.sign(sign, Enum.NormalId.Front, "SEYİR TEPESİ ÇAY BAHÇESİ", { color = Color3.fromRGB(250, 240, 200) })
	Props.flag(m, base * CFrame.new(20, 0, -10), 26)
	return m
end

local function windfarm(parent, poi, rng)
	local p = poi.pos
	local m = B.model("WindFarm", parent)
	for k = 0, 5 do
		local x = p.X - 280 + k * 110 + Rand.range(rng, -20, 20)
		local z = p.Z + Rand.range(rng, -60, 60)
		local y = ground(x, z)
		local base = CFrame.new(x, y, z)
		B.cylY(m, base * CFrame.new(0, 40, 0), 80, 4, Color3.fromRGB(240, 240, 240), M.SmoothPlastic)
		B.box(m, base * CFrame.new(0, 81, -2), Vector3.new(5, 5, 12), Color3.fromRGB(235, 235, 235), M.SmoothPlastic)
		local rotor = B.model("Rotor", m)
		local hub = B.ball(rotor, base * CFrame.new(0, 81, -8.5), 3.4, Color3.fromRGB(240, 240, 240), M.SmoothPlastic)
		hub.Name = "Hub"
		rotor.PrimaryPart = hub
		for b2 = 0, 2 do
			local a = b2 * math.pi * 2 / 3
			B.box(rotor, base * CFrame.new(0, 81, -8.8) * CFrame.Angles(0, 0, a) * CFrame.new(0, 17, 0), Vector3.new(2.2, 34, 0.5), Color3.fromRGB(245, 245, 245), M.SmoothPlastic, nc())
		end
		rotor:SetAttribute("Speed", Rand.range(rng, 0.5, 0.9))
		rotor:AddTag("WindTurbine")
	end
	return m
end

local function camp(parent, poi, rng)
	local p = poi.pos
	local m = B.model("Campsite", parent)
	local y = ground(p.X, p.Z)
	local fire = CFrame.new(p.X, y + 0.3, p.Z)
	for i = 0, 7 do
		local a = i * math.pi / 4
		B.ball(m, fire * CFrame.new(math.cos(a) * 2.6, 0.2, math.sin(a) * 2.6), 1.4, Color3.fromRGB(120, 116, 110), M.Rock)
	end
	for i = 0, 2 do
		B.cyl(m, fire * CFrame.new(0, 0.6, 0) * CFrame.Angles(0, i * math.pi / 3, 0), 4, 0.5, Color3.fromRGB(90, 60, 40), M.Wood, nc())
	end
	local flame = B.box(m, fire * CFrame.new(0, 1.2, 0), Vector3.new(1, 1, 1), Color3.fromRGB(255, 140, 40), M.Neon, nc({ Transparency = 1, Name = "Campfire" }))
	local f = Instance.new("Fire")
	f.Size = 5
	f.Heat = 9
	f.Parent = flame
	B.pointLight(flame, 28, 2, Color3.fromRGB(255, 150, 60), true)
	for i = 0, 3 do
		local a = i * math.pi / 2 + 0.4
		local tp = Vector3.new(p.X + math.cos(a) * 18, 0, p.Z + math.sin(a) * 18)
		local tc = CFrame.lookAt(Vector3.new(tp.X, ground(tp.X, tp.Z) + 0.2, tp.Z), Vector3.new(p.X, ground(tp.X, tp.Z) + 0.2, p.Z))
		local col = Rand.pick(rng, { Color3.fromRGB(240, 120, 30), Color3.fromRGB(40, 130, 80), Color3.fromRGB(40, 90, 170) })
		for side = -1, 1, 2 do
			B.wedge(m, tc * CFrame.new(side * 2.2, 2.4, 0) * CFrame.Angles(0, side * math.pi / 2, 0), Vector3.new(8, 4.8, 4.4), col, M.Fabric)
		end
		Props.chair(m, tc * CFrame.new(3, 0, -5), { 30, 90, 60 })
	end
	for _ = 1, 30 do
		local x, z = p.X + Rand.range(rng, -90, 90), p.Z + Rand.range(rng, -70, 70)
		if (Vector2.new(x, z) - Vector2.new(p.X, p.Z)).Magnitude > 30 then
			Props.tree(m, CFrame.new(x, ground(x, z), z), "pine", rng)
		end
	end
	return m
end

local function radioTower(parent, poi, _rng)
	local p = poi.pos
	local m = B.model("RadioTower", parent)
	local y = ground(p.X, p.Z)
	local base = CFrame.new(p.X, y, p.Z)
	local h = 120
	for i = 0, 11 do
		local w = 12 - i * 0.8
		local yy = i * h / 12
		for sx = -1, 1, 2 do
			for sz = -1, 1, 2 do
				B.box(m, base * CFrame.new(sx * w / 2, yy + h / 24, sz * w / 2), Vector3.new(0.6, h / 12 + 0.2, 0.6), if i % 2 == 0 then Color3.fromRGB(220, 40, 40) else Color3.fromRGB(240, 240, 240), M.Metal)
			end
		end
		B.box(m, base * CFrame.new(0, yy, w / 2), Vector3.new(w, 0.4, 0.4), Color3.fromRGB(240, 240, 240), M.Metal, nc())
		B.box(m, base * CFrame.new(0, yy, -w / 2), Vector3.new(w, 0.4, 0.4), Color3.fromRGB(240, 240, 240), M.Metal, nc())
		if i % 4 == 3 then
			local red = B.ball(m, base * CFrame.new(w / 2, yy + 1, 0), 1, Color3.fromRGB(255, 30, 30), M.Neon, nc())
			red:AddTag("Beacon")
		end
	end
	local top = B.ball(m, base * CFrame.new(0, h + 1, 0), 1.6, Color3.fromRGB(255, 30, 30), M.Neon, nc())
	top:AddTag("Beacon")
	B.box(m, base * CFrame.new(16, 4, 0), Vector3.new(12, 8, 10), Color3.fromRGB(200, 200, 196), M.Concrete)
	return m
end

local function farm(parent, poi, _rng)
	local p = poi.pos
	local m = B.model("Farm", parent)
	local base = CFrame.lookAt(Vector3.new(p.X, 0, p.Z), Vector3.new(p.X - 10, 0, p.Z))
	-- barn
	local red = Color3.fromRGB(160, 40, 36)
	B.box(m, base * CFrame.new(0, 9, 20), Vector3.new(30, 18, 40), red, M.WoodPlanks)
	B.wedge(m, base * CFrame.new(0, 22, 10), Vector3.new(32, 8, 20.5), Color3.fromRGB(90, 70, 60), M.RoofShingles)
	B.wedge(m, base * CFrame.new(0, 22, 30) * CFrame.Angles(0, math.pi, 0), Vector3.new(32, 8, 20.5), Color3.fromRGB(90, 70, 60), M.RoofShingles)
	B.box(m, base * CFrame.new(0, 7, -0.2), Vector3.new(12, 14, 0.4), Color3.fromRGB(240, 240, 236), M.Wood)
	-- silo
	B.cylY(m, base * CFrame.new(24, 18, 30), 36, 12, Color3.fromRGB(200, 200, 204), M.Metal)
	B.ball(m, base * CFrame.new(24, 36, 30), 12, Color3.fromRGB(200, 200, 204), M.Metal)
	-- crop fields
	local crops = { Color3.fromRGB(220, 190, 80), Color3.fromRGB(90, 150, 60), Color3.fromRGB(120, 100, 60) }
	for f = 0, 3 do
		local field = base * CFrame.new(-60 - (f % 2) * 90, 0.2, -80 + math.floor(f / 2) * 120)
		local col = crops[(f % 3) + 1]
		for r = 0, 11 do
			B.box(m, field * CFrame.new(0, 0.6, -50 + r * 9), Vector3.new(80, 1.2, 4), col, if col == crops[3] then M.Ground else M.LeafyGrass, nc({ CanCollide = true }))
		end
	end
	-- tractor
	local t = base * CFrame.new(-20, 0, -20)
	B.box(m, t * CFrame.new(0, 3.5, 0), Vector3.new(5, 3, 8), Color3.fromRGB(40, 140, 60), M.Metal)
	B.box(m, t * CFrame.new(0, 6.5, 1.5), Vector3.new(4.6, 3.4, 4), Color3.fromRGB(180, 210, 220), M.Glass, { Transparency = 0.4 })
	for x = -1, 1, 2 do
		B.cyl(m, t * CFrame.new(x * 3, 3, 2.5), 1.4, 5.6, Color3.fromRGB(26, 26, 26), M.Rubber)
		B.cyl(m, t * CFrame.new(x * 2.8, 1.6, -3), 1.2, 3, Color3.fromRGB(26, 26, 26), M.Rubber)
	end
	Props.fence(m, (base * CFrame.new(-10, 0, -140)).Position, (base * CFrame.new(-10, 0, 140)).Position, "wood", 3.4)
	return m
end

-- Forest on the hills and tree belts in the countryside around the city.
local function forests(parent, rng)
	local m = B.model("Forests", parent)
	local placed = 0
	for _ = 1, 520 do
		local x = Rand.range(rng, -1520, 1520)
		local z = Rand.range(rng, -1540, -1120)
		local nearViewpoint = (Vector2.new(x, z) - Vector2.new(0, -1340)).Magnitude < 70
		local nearCamp = (Vector2.new(x, z) - Vector2.new(760, -1280)).Magnitude < 40
		local nearPath = false
		for _, pp in Terrain.hillPath or {} do
			if (Vector2.new(x, z) - Vector2.new(pp.X, pp.Z)).Magnitude < 22 then
				nearPath = true
			end
		end
		if not nearViewpoint and not nearCamp and not nearPath then
			Props.tree(m, CFrame.new(x, ground(x, z) - 0.3, z), Rand.pick(rng, { "pine", "pine", "pine", "oak", "birch" }), rng)
			placed += 1
		end
	end
	-- east and west countryside tree belts
	for i = 1, 160 do
		local side = if i % 2 == 0 then 1 else -1
		local x = side * Rand.range(rng, 1240, 1520)
		local z = Rand.range(rng, -1080, 820)
		if not (side == 1 and math.abs(z - (-350)) < 180) then
			Props.tree(m, CFrame.new(x, 0, z), Rand.pick(rng, { "oak", "oak", "cypress", "pine", "bush" }), rng)
			placed += 1
		end
	end
	m:SetAttribute("Trees", placed)
	return m
end

function Nature.build(parent: Instance, L, yieldFn: (() -> ())?)
	local rng = Random.new(1453)
	local folder = B.folder("Nature", parent)
	local builders = {
		park = park,
		lunapark = lunapark,
		harbor = harbor,
		marina = marina,
		pier = pier,
		lighthouse = lighthouse,
		beach = beach,
		viewpoint = viewpoint,
		windfarm = windfarm,
		camp = camp,
		radio_tower = radioTower,
		farm = farm,
	}
	for id, fn in builders do
		local poi = L.poiById[id]
		if poi then
			local ok, err = pcall(fn, folder, poi, rng)
			if not ok then
				warn("[World] failed to build " .. id .. ": " .. tostring(err))
				Nature.lastError = err
			end
			if yieldFn then
				yieldFn()
			end
		end
	end
	forests(folder, rng)
	return folder
end

return Nature
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1334">
          <Properties>
            <string name="Name">Roads</string>
            <string name="Source"><![CDATA[-- Roads: asphalt, sidewalks, curbs, lane markings, crosswalks, intersections, traffic lights,
-- street lamps, street trees, benches, name signs, bus stops and the seaside promenade.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local B = require(Shared.Util.Builder)
local Rand = require(Shared.Util.Rand)
local Props = require(Shared.Models.Props)
local CityLayout = require(Shared.World.CityLayout)

local Roads = {}
local M = Enum.Material
local P = B.Palette
local ROAD_Y = CityLayout.ROAD_Y
local WALK_Y = CityLayout.WALK_Y

local URBAN = { DWN = true, TEC = true, TEP = true, OLD = true, PLZ = true, SEA = true, CST = true }

local function sidewalkWidth(kind: string): number
	if kind == "main" then
		return 10
	elseif kind == "ring" then
		return 6
	end
	return 9
end
Roads.sidewalkWidth = sidewalkWidth

local function flat(parent, center: Vector3, dir: Vector3, size: Vector3, color, material, props)
	local cf = CFrame.lookAt(center, center + dir)
	return B.box(parent, cf, size, color, material, props)
end

local function sidewalkMaterial(district: string)
	if district == "OLD" then
		return M.Cobblestone, Color3.fromRGB(170, 160, 146)
	elseif district == "SEA" or district == "CST" then
		return M.Pavement, Color3.fromRGB(214, 206, 190)
	elseif district == "IND" or district == "HAR" or district == "SCR" or district == "DAT" then
		return M.Concrete, Color3.fromRGB(160, 160, 158)
	end
	return M.Pavement, P.sidewalk
end

-- Draws one road segment between intersections.
local function segment(folder: Instance, L, road, rng: Random)
	local a = Vector3.new(road.a.X, 0, road.a.Y)
	local b = Vector3.new(road.b.X, 0, road.b.Y)
	local dir = (b - a).Unit
	local right = Vector3.new(-dir.Z, 0, dir.X)
	local nodeA, nodeB = L.nodes[road.from], L.nodes[road.to]
	local insetA = if road.vertical then CityLayout.roadWidthH(nodeA.j) / 2 else CityLayout.roadWidthV(nodeA.i) / 2
	local insetB = if road.vertical then CityLayout.roadWidthH(nodeB.j) / 2 else CityLayout.roadWidthV(nodeB.i) / 2
	local p0 = a + dir * insetA
	local p1 = b - dir * insetB
	local len = (p1 - p0).Magnitude
	if len < 1 then
		return
	end
	local mid = (p0 + p1) / 2
	local sw = sidewalkWidth(road.kind)
	local cw = road.width - sw * 2
	local m = B.model("Road_" .. road.id, folder)

	-- carriageway
	flat(m, mid + Vector3.new(0, ROAD_Y - 0.25, 0), dir, Vector3.new(cw, 0.5, len), P.asphalt, M.Asphalt)
	-- sidewalks and curbs (district aware on each side)
	for side = -1, 1, 2 do
		local off = right * side * (cw / 2 + sw / 2)
		local probe = mid + right * side * (road.width / 2 + 20)
		local mat, col = sidewalkMaterial(CityLayout.districtAt(probe))
		flat(m, mid + off + Vector3.new(0, WALK_Y / 2, 0), dir, Vector3.new(sw, WALK_Y, len), col, mat)
		flat(m, mid + right * side * (cw / 2 + 0.25) + Vector3.new(0, WALK_Y / 2 + 0.03, 0), dir, Vector3.new(0.5, WALK_Y + 0.06, len), P.curb, M.Concrete)
	end

	-- markings
	local markY = ROAD_Y + 0.02
	local function line(offset: number, width: number, color, dashed: boolean)
		if not dashed then
			flat(m, mid + right * offset + Vector3.new(0, markY, 0), dir, Vector3.new(width, 0.04, len - 6), color, M.SmoothPlastic, { CanCollide = false, CanTouch = false, CastShadow = false })
			return
		end
		local dash, gap = 6, 9
		local n = math.floor((len - 10) / (dash + gap))
		for k = 0, n - 1 do
			local t = -len / 2 + 5 + dash / 2 + k * (dash + gap)
			flat(m, mid + dir * t + right * offset + Vector3.new(0, markY, 0), dir, Vector3.new(width, 0.04, dash), color, M.SmoothPlastic, { CanCollide = false, CanTouch = false, CastShadow = false })
		end
	end
	if road.kind == "street" then
		line(0, 0.45, P.lineWhite, true)
	else
		line(-0.45, 0.35, P.lineYellow, false)
		line(0.45, 0.35, P.lineYellow, false)
		line(-cw / 4, 0.35, P.lineWhite, true)
		line(cw / 4, 0.35, P.lineWhite, true)
	end

	-- urban furniture
	local districtL = CityLayout.districtAt(mid - right * (road.width / 2 + 20))
	local districtR = CityLayout.districtAt(mid + right * (road.width / 2 + 20))
	local urban = URBAN[districtL] or URBAN[districtR]
	local spacing = if urban then 62 else 84
	local count = math.floor(len / spacing)
	local classic = districtL == "OLD" or districtR == "OLD" or districtL == "PLZ" or districtR == "PLZ"
	for k = 0, count - 1 do
		local t = -len / 2 + spacing * (k + 0.5)
		local side = if k % 2 == 0 then 1 else -1
		if road.kind == "ring" then
			side = 1
		end
		local base = mid + dir * t + right * side * (cw / 2 + 1.6)
		local face = -right * side
		Props.streetLamp(m, CFrame.lookAt(base + Vector3.new(0, WALK_Y, 0), base + Vector3.new(0, WALK_Y, 0) + face), if classic then "classic" else "modern")
		if urban and road.kind ~= "ring" then
			-- trees in pits between lamps, on both sides
			for s = -1, 1, 2 do
				local tp = mid + dir * (t + spacing / 2) + right * s * (cw / 2 + sw / 2)
				if math.abs(t + spacing / 2) < len / 2 - 8 then
					B.box(m, CFrame.new(tp + Vector3.new(0, WALK_Y + 0.02, 0)), Vector3.new(4, 0.08, 4), P.soil, M.Ground, { CanCollide = false })
					Props.tree(m, CFrame.new(tp + Vector3.new(0, WALK_Y, 0)), Rand.pick(rng, if districtL == "SEA" or districtL == "CST" then { "palm", "palm", "oak" } else { "oak", "oak", "birch", "cypress" }), rng)
				end
			end
			if rng:NextNumber() < 0.3 then
				local bp = mid + dir * (t + 12) + right * side * (cw / 2 + sw - 2)
				Props.bench(m, CFrame.lookAt(bp + Vector3.new(0, WALK_Y, 0), bp + Vector3.new(0, WALK_Y, 0) - right * side))
				Props.bin(m, CFrame.new(bp + dir * 4.5 + Vector3.new(0, WALK_Y, 0)))
			end
		elseif rng:NextNumber() < 0.25 and road.kind ~= "ring" then
			Props.tree(m, CFrame.new(mid + dir * (t + spacing / 2) + right * side * (cw / 2 + sw / 2) + Vector3.new(0, WALK_Y, 0)), "oak", rng)
		end
	end
	if urban and rng:NextNumber() < 0.25 then
		local hp = mid + dir * (len * 0.3) + right * (cw / 2 + 1.2)
		Props.hydrant(m, CFrame.new(hp + Vector3.new(0, WALK_Y, 0)))
	end
	-- bus stops on the main roads
	if road.kind == "main" and road.id % 2 == 0 then
		local side = if road.id % 4 == 0 then 1 else -1
		local bp = mid + right * side * (cw / 2 + sw / 2 + 1)
		Props.busStop(m, CFrame.lookAt(bp + Vector3.new(0, WALK_Y, 0), bp + Vector3.new(0, WALK_Y, 0) - right * side), road.name)
	end
	return m
end

-- Intersection: asphalt bands, sidewalk corners, crosswalks, traffic lights and a name sign.
local function intersection(folder: Instance, L, node, rng: Random)
	local X, Z = node.x, node.z
	local Wv = CityLayout.roadWidthV(node.i)
	local Wh = CityLayout.roadWidthH(node.j)
	local kindV = if Wv == 52 then "ring" elseif Wv == 60 then "main" else "street"
	local kindH = if Wh == 52 then "ring" elseif Wh == 60 then "main" else "street"
	local cwV = Wv - 2 * sidewalkWidth(kindV)
	local cwH = Wh - 2 * sidewalkWidth(kindH)
	local has = { N = false, S = false, E = false, W = false }
	for _, link in node.links do
		local o = L.nodes[link.node]
		if o.x == X then
			if o.z < Z then
				has.N = true
			else
				has.S = true
			end
		else
			if o.x < X then
				has.W = true
			else
				has.E = true
			end
		end
	end
	local m = B.model("Junction_" .. node.key, folder)
	local function pad(cx, cz, sx, sz, col, mat, y, h)
		B.box(m, CFrame.new(cx, y, cz), Vector3.new(sx, h, sz), col, mat)
	end
	local mat, col = sidewalkMaterial(CityLayout.districtAt(Vector3.new(X + Wv, 0, Z + Wh)))
	if has.N or has.S then
		pad(X, Z, cwV, Wh, P.asphalt, M.Asphalt, ROAD_Y - 0.25, 0.5)
	end
	if has.E or has.W then
		pad(X, Z, Wv, cwH, P.asphalt, M.Asphalt, ROAD_Y - 0.25, 0.5)
	end
	-- corners
	local cx = (Wv - cwV) / 2
	local cz = (Wh - cwH) / 2
	for sx = -1, 1, 2 do
		for sz = -1, 1, 2 do
			pad(X + sx * (cwV / 2 + cx / 2), Z + sz * (cwH / 2 + cz / 2), cx, cz, col, mat, WALK_Y / 2, WALK_Y)
		end
	end
	-- missing directions become sidewalk
	if not has.N then
		pad(X, Z - (cwH / 2 + cz / 2), cwV, cz, col, mat, WALK_Y / 2, WALK_Y)
	end
	if not has.S then
		pad(X, Z + (cwH / 2 + cz / 2), cwV, cz, col, mat, WALK_Y / 2, WALK_Y)
	end
	if not has.W then
		pad(X - (cwV / 2 + cx / 2), Z, cx, cwH, col, mat, WALK_Y / 2, WALK_Y)
	end
	if not has.E then
		pad(X + (cwV / 2 + cx / 2), Z, cx, cwH, col, mat, WALK_Y / 2, WALK_Y)
	end

	local four = has.N and has.S and has.E and has.W
	local district = CityLayout.districtAt(Vector3.new(X + Wv, 0, Z + Wh))
	local busy = URBAN[district] or kindV == "main" or kindH == "main"
	-- crosswalks on busy four-way junctions
	if four and busy then
		local stripe = Color3.fromRGB(236, 236, 230)
		local function zebra(center: Vector3, along: Vector3, across: number)
			local n = math.floor(across / 2.6)
			local perp = Vector3.new(-along.Z, 0, along.X)
			for k = 0, n - 1 do
				local off = -across / 2 + 1.3 + k * 2.6
				B.box(m, CFrame.lookAt(center + perp * off, center + perp * off + along), Vector3.new(1.3, 0.04, 5), stripe, M.SmoothPlastic, { CanCollide = false, CanTouch = false, CastShadow = false })
			end
		end
		local y = ROAD_Y + 0.02
		zebra(Vector3.new(X, y, Z - cwH / 2 - 3.5), Vector3.new(0, 0, 1), cwV)
		zebra(Vector3.new(X, y, Z + cwH / 2 + 3.5), Vector3.new(0, 0, 1), cwV)
		zebra(Vector3.new(X - cwV / 2 - 3.5, y, Z), Vector3.new(1, 0, 0), cwH)
		zebra(Vector3.new(X + cwV / 2 + 3.5, y, Z), Vector3.new(1, 0, 0), cwH)
	end
	-- traffic lights: right-hand traffic, signal on the near-right corner of each approach
	if four and kindV ~= "ring" and kindH ~= "ring" then
		local ox, oz = cwV / 2 + 1.5, cwH / 2 + 1.5
		local function signal(px, pz, faceX, faceZ, axis)
			local p = Vector3.new(px, WALK_Y, pz)
			Props.trafficLight(m, CFrame.lookAt(p, p + Vector3.new(faceX, 0, faceZ)), axis, node.key)
		end
		signal(X + ox, Z + oz, 0, 1, "NS") -- northbound traffic arrives from the south
		signal(X - ox, Z - oz, 0, -1, "NS") -- southbound from the north
		signal(X - ox, Z + oz, -1, 0, "EW") -- eastbound arrives from the west
		signal(X + ox, Z - oz, 1, 0, "EW") -- westbound from the east
	end
	-- street name sign on one corner
	if node.links[1] and rng:NextNumber() < 0.7 then
		local vName, hName = "", ""
		for _, link in node.links do
			local r = L.roads[link.road]
			if r.vertical then
				vName = r.name
			else
				hName = r.name
			end
		end
		local text = if vName ~= "" and hName ~= "" then vName .. "  ✕  " .. hName else vName .. hName
		local p = Vector3.new(X - cwV / 2 - cx * 0.6, WALK_Y, Z - cwH / 2 - cz * 0.6)
		Props.streetSign(m, CFrame.lookAt(p, p + Vector3.new(1, 0, 1)), text)
	end
	return m
end

-- Promenade on the sea side of the coastal boulevard.
local function promenade(folder: Instance, rng: Random)
	local m = B.model("Promenade", folder)
	local zRoad = CityLayout.ZS[#CityLayout.ZS] + CityLayout.roadWidthH(#CityLayout.ZS) / 2
	local z1 = CityLayout.BEACH_Z + 6
	local x0, x1 = CityLayout.XS[3] - 20, CityLayout.XS[#CityLayout.XS] + 30
	local depth = z1 - zRoad
	B.box(m, CFrame.new((x0 + x1) / 2, WALK_Y / 2, zRoad + depth / 2), Vector3.new(x1 - x0, WALK_Y, depth), Color3.fromRGB(222, 212, 192), M.Pavement)
	-- railing along the beach edge with gaps for stairs
	local railCol = Color3.fromRGB(236, 236, 232)
	local x = x0
	while x < x1 - 30 do
		local segLen = 46
		B.box(m, CFrame.new(x + segLen / 2, WALK_Y + 3, z1 - 0.3), Vector3.new(segLen, 0.3, 0.3), railCol, M.Metal)
		B.box(m, CFrame.new(x + segLen / 2, WALK_Y + 1.6, z1 - 0.3), Vector3.new(segLen, 0.2, 0.2), railCol, M.Metal)
		for k = 0, 6 do
			B.box(m, CFrame.new(x + k * segLen / 6, WALK_Y + 1.5, z1 - 0.3), Vector3.new(0.3, 3, 0.3), railCol, M.Metal)
		end
		-- stairs down to the sand
		for s = 0, 3 do
			B.box(m, CFrame.new(x + segLen + 6, WALK_Y - s * 0.25, z1 + 1 + s * 1.6), Vector3.new(10, 0.5, 1.6), Color3.fromRGB(210, 200, 180), M.Pavement)
		end
		x += segLen + 12
	end
	-- palms, classic lamps, benches facing the sea
	local k = 0
	x = x0 + 20
	while x < x1 - 10 do
		k += 1
		local p = Vector3.new(x, WALK_Y, zRoad + depth * 0.45)
		if k % 2 == 0 then
			Props.tree(m, CFrame.new(p), "palm", rng)
		else
			Props.streetLamp(m, CFrame.lookAt(p, p + Vector3.new(0, 0, 1)), "classic")
		end
		if k % 3 == 0 then
			local bp = Vector3.new(x + 10, WALK_Y, z1 - 4)
			Props.bench(m, CFrame.lookAt(bp, bp + Vector3.new(0, 0, -1)), Color3.fromRGB(70, 120, 160))
		end
		if k % 9 == 0 then
			Props.simitCart(m, CFrame.lookAt(Vector3.new(x + 4, WALK_Y, zRoad + depth * 0.7), Vector3.new(x + 4, WALK_Y, zRoad)))
		end
		x += 36
	end
	return m
end

function Roads.build(parent: Instance, yieldEvery: (() -> ())?)
	local L = CityLayout.get()
	local rng = Random.new(20261028)
	local folder = B.folder("Roads", parent)
	for i, road in L.roads do
		segment(folder, L, road, rng)
		if yieldEvery and i % 12 == 0 then
			yieldEvery()
		end
	end
	local keys = {}
	for k in L.nodes do
		table.insert(keys, k)
	end
	table.sort(keys)
	for i, k in keys do
		intersection(folder, L, L.nodes[k], rng)
		if yieldEvery and i % 16 == 0 then
			yieldEvery()
		end
	end
	promenade(folder, rng)
	return folder
end

return Roads
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1335">
          <Properties>
            <string name="Name">TerrainBuilder</string>
            <string name="Source"><![CDATA[-- Terrain: grass ground, the beach and the sea, the northern hills and the park lake.
-- Also exposes groundHeight(x, z) so trees and props on the hills sit on the surface.

local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local CityLayout = require(Shared.World.CityLayout)

local Terrain = {}

-- Rolling hills north of the ring road: { x, z, radius, centreY }
local HILLS = {
	{ 0, -1360, 230, -175 }, -- viewpoint hill (top ~ y 55)
	{ -420, -1420, 260, -205 },
	{ 420, -1430, 250, -200 },
	{ -860, -1380, 220, -180 },
	{ 860, -1400, 230, -185 },
	{ -1260, -1300, 200, -170 },
	{ 1260, -1320, 210, -175 },
}
Terrain.Hills = HILLS

local LAKE = { x = -120, z = -820, radius = 70 }
Terrain.SEA_LEVEL = -1.5
Terrain.Lake = LAKE

-- The paved city: every block and road plus a margin. Grass terrain grows blades about a stud
-- tall that poke through roads, pavements and floors, so the city stands on bare ground and only
-- the lawns (park blocks) and the countryside around it are grass.
local urban = nil
function Terrain.urbanRect()
	if urban then
		return urban
	end
	local L = CityLayout.get()
	local x0, x1, z0, z1 = math.huge, -math.huge, math.huge, -math.huge
	for _, b in L.blocks do
		x0, x1 = math.min(x0, b.x0), math.max(x1, b.x1)
		z0, z1 = math.min(z0, b.z0), math.max(z1, b.z1)
	end
	for _, r in L.roads do
		local w = r.width / 2
		x0, x1 = math.min(x0, r.a.X - w, r.b.X - w), math.max(x1, r.a.X + w, r.b.X + w)
		z0, z1 = math.min(z0, r.a.Y - w, r.b.Y - w), math.max(z1, r.a.Y + w, r.b.Y + w)
	end
	urban = { x0 = x0 - 2, x1 = x1 + 2, z0 = z0 - 2, z1 = math.min(z1 + 2, CityLayout.BEACH_Z) }
	return urban
end

-- Lawns inside the city (park blocks keep their terrain grass).
function Terrain.lawns()
	local out = {}
	for _, b in CityLayout.get().blocks do
		if b.district == "PRK" then
			table.insert(out, { x0 = b.x0, x1 = b.x1, z0 = b.z0, z1 = b.z1 })
		end
	end
	return out
end

local function inRect(r, x: number, z: number): boolean
	return x >= r.x0 and x <= r.x1 and z >= r.z0 and z <= r.z1
end

-- True where the terrain surface is grass (countryside, hills, park lawns).
function Terrain.isGrass(x: number, z: number): boolean
	if z >= CityLayout.BEACH_Z then
		return false
	end
	if not inRect(Terrain.urbanRect(), x, z) then
		return true
	end
	for _, lawn in Terrain.lawns() do
		if inRect(lawn, x, z) then
			return true
		end
	end
	return false
end

-- Height of the terrain surface (approximate) at x, z.
function Terrain.groundHeight(x: number, z: number): number
	local h = 0
	for _, hill in HILLS do
		local dx, dz = x - hill[1], z - hill[2]
		local r = hill[3]
		local d2 = dx * dx + dz * dz
		if d2 < r * r then
			local top = hill[4] + math.sqrt(r * r - d2)
			if top > h then
				h = top
			end
		end
	end
	return h
end

function Terrain.build()
	local terrain = Workspace:FindFirstChildOfClass("Terrain")
	if not terrain then
		return
	end
	local M = Enum.Material
	pcall(function()
		terrain:SetMaterialColor(M.Grass, Color3.fromRGB(96, 140, 70))
		terrain:SetMaterialColor(M.LeafyGrass, Color3.fromRGB(86, 128, 62))
		terrain:SetMaterialColor(M.Sand, Color3.fromRGB(230, 212, 168))
		terrain:SetMaterialColor(M.Ground, Color3.fromRGB(120, 100, 76))
		terrain:SetMaterialColor(M.Rock, Color3.fromRGB(130, 126, 120))
		terrain:SetMaterialColor(M.Mud, Color3.fromRGB(96, 80, 62))
	end)
	pcall(function()
		terrain.WaterColor = Color3.fromRGB(30, 104, 128)
		terrain.WaterReflectance = 0.45
		terrain.WaterTransparency = 0.35
		terrain.WaterWaveSize = 0.18
		terrain.WaterWaveSpeed = 7
	end)
	pcall(function()
		(terrain :: any).Decoration = true
	end)

	local b = CityLayout.get().bounds
	local seaZ = CityLayout.SEA_Z
	-- land: grass around the city, bare ground under it, lawns in the park
	local landDepth = seaZ - b.minZ
	terrain:FillBlock(CFrame.new(0, -6, b.minZ + landDepth / 2), Vector3.new(b.maxX - b.minX, 12, landDepth), M.Grass)
	local u = Terrain.urbanRect()
	terrain:FillBlock(CFrame.new((u.x0 + u.x1) / 2, -6, (u.z0 + u.z1) / 2), Vector3.new(u.x1 - u.x0, 12, u.z1 - u.z0), M.Ground)
	for _, lawn in Terrain.lawns() do
		terrain:FillBlock(CFrame.new((lawn.x0 + lawn.x1) / 2, -6, (lawn.z0 + lawn.z1) / 2), Vector3.new(lawn.x1 - lawn.x0, 12, lawn.z1 - lawn.z0), M.Grass)
	end
	-- beach sand, sloping under the water in 16-stud bands
	local W = b.maxX - b.minX + 800
	local SEA_LEVEL = Terrain.SEA_LEVEL
	terrain:FillBlock(CFrame.new(0, -6, (CityLayout.BEACH_Z + seaZ) / 2), Vector3.new(W, 12, seaZ - CityLayout.BEACH_Z + 4), M.Sand)
	for i = 0, 8 do
		local z = seaZ + i * 16 + 8
		local sandTop = -0.5 - i * 2.4
		terrain:FillBlock(CFrame.new(0, (sandTop - 44) / 2, z), Vector3.new(W, sandTop + 44, 16), M.Sand)
		if sandTop < SEA_LEVEL then
			terrain:FillBlock(CFrame.new(0, (SEA_LEVEL + sandTop) / 2, z), Vector3.new(W, SEA_LEVEL - sandTop, 16), M.Water)
		end
	end
	-- open sea
	local z0 = seaZ + 9 * 16
	local seaLen = b.maxZ + 600 - z0
	terrain:FillBlock(CFrame.new(0, -32, z0 + seaLen / 2), Vector3.new(W, 24, seaLen), M.Sand)
	terrain:FillBlock(CFrame.new(0, (SEA_LEVEL - 20) / 2, z0 + seaLen / 2), Vector3.new(W, SEA_LEVEL + 20, seaLen), M.Water)
	-- deep harbour basin in front of the container quay
	terrain:FillBlock(CFrame.new(-955, (SEA_LEVEL - 20) / 2, 990), Vector3.new(470, SEA_LEVEL + 20, 220), M.Water)
	terrain:FillBlock(CFrame.new(-955, -6, 868), Vector3.new(470, 12, 24), M.Ground)
	-- northern hills
	for _, hill in HILLS do
		terrain:FillBall(Vector3.new(hill[1], hill[4], hill[2]), hill[3], M.Grass)
	end
	-- rocky crown and a flat lookout on the viewpoint hill
	terrain:FillCylinder(CFrame.new(0, 52, -1360), 6, 46, M.Ground)
	terrain:FillBall(Vector3.new(-40, 40, -1400), 22, M.Rock)
	-- dirt road from the north ring road up to the viewpoint
	local path = {
		Vector3.new(0, 0, -1110),
		Vector3.new(-90, 0, -1170),
		Vector3.new(-40, 0, -1250),
		Vector3.new(70, 0, -1290),
		Vector3.new(30, 0, -1340),
	}
	for i = 1, #path - 1 do
		local a, c = path[i], path[i + 1]
		local steps = 8
		for s = 0, steps - 1 do
			local t0, t1 = s / steps, (s + 1) / steps
			local p0 = a:Lerp(c, t0)
			local p1 = a:Lerp(c, t1)
			p0 = Vector3.new(p0.X, Terrain.groundHeight(p0.X, p0.Z), p0.Z)
			p1 = Vector3.new(p1.X, Terrain.groundHeight(p1.X, p1.Z), p1.Z)
			local mid = (p0 + p1) / 2
			local len = (p1 - p0).Magnitude
			if len > 0.5 then
				terrain:FillBlock(CFrame.lookAt(mid, p1) * CFrame.new(0, -0.5, 0), Vector3.new(20, 3, len + 4), M.Ground)
			end
		end
	end
	Terrain.hillPath = path
	-- lake in the park
	terrain:FillCylinder(CFrame.new(LAKE.x, -3.5, LAKE.z), 7, LAKE.radius, M.Water)
	terrain:FillCylinder(CFrame.new(LAKE.x, -8, LAKE.z), 3, LAKE.radius, M.Mud)
	terrain:FillCylinder(CFrame.new(LAKE.x + 40, -3.5, LAKE.z + 30), 7, 38, M.Water)
end

-- Bare ground under everything thin that lies on grass terrain (park paths, flower beds, bench
-- legs, the lookout...), so no grass blade pokes through it. Returns how many patches it made.
function Terrain.clearUnder(root: Instance): number
	local terrain = Workspace:FindFirstChildOfClass("Terrain")
	if not terrain then
		return 0
	end
	local n = 0
	for _, d in root:GetDescendants() do
		if d:IsA("BasePart") and d.Transparency < 1 then
			local cf, size = d.CFrame, d.Size
			local p = cf.Position
			-- on grass if the middle or any corner of the footprint is (parts can straddle a lawn's edge)
			local onGrass = Terrain.isGrass(p.X, p.Z)
			if not onGrass then
				for _, c in { { -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 } } do
					local q = cf * Vector3.new(c[1] * size.X / 2, 0, c[2] * size.Z / 2)
					if Terrain.isGrass(q.X, q.Z) then
						onGrass = true
						break
					end
				end
			end
			if onGrass then
				local r, u, l = cf.RightVector, cf.UpVector, cf.LookVector
				local halfY = (math.abs(r.Y) * size.X + math.abs(u.Y) * size.Y + math.abs(l.Y) * size.Z) / 2
				local gy = Terrain.groundHeight(p.X, p.Z)
				if p.Y - halfY - gy < 1.5 and halfY < 2 then
					local ex = math.abs(r.X) * size.X + math.abs(u.X) * size.Y + math.abs(l.X) * size.Z
					local ez = math.abs(r.Z) * size.X + math.abs(u.Z) * size.Y + math.abs(l.Z) * size.Z
					local lo, hi = gy, gy
					for _, c in { { -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 } } do
						local h = Terrain.groundHeight(p.X + c[1] * ex / 2, p.Z + c[2] * ez / 2)
						lo, hi = math.min(lo, h), math.max(hi, h)
					end
					if hi - lo > 0.5 then
						-- on a slope: turn the grass in the footprint's box to ground, keeping the shape
						local region = Region3.new(Vector3.new(p.X - ex / 2 - 1, lo - 4, p.Z - ez / 2 - 1), Vector3.new(p.X + ex / 2 + 1, hi + 2, p.Z + ez / 2 + 1))
						terrain:ReplaceMaterial(region:ExpandToGrid(4), 4, Enum.Material.Grass, Enum.Material.Ground)
					elseif math.abs(u.Y) > 0.95 then
						-- lying flat: the same footprint, turned with the part
						local _, yaw = cf:ToOrientation()
						terrain:FillBlock(CFrame.new(p.X, gy - 2, p.Z) * CFrame.Angles(0, yaw, 0), Vector3.new(size.X + 1, 4, size.Z + 1), Enum.Material.Ground)
					else
						terrain:FillBlock(CFrame.new(p.X, gy - 2, p.Z), Vector3.new(ex + 1, 4, ez + 1), Enum.Material.Ground)
					end
					n += 1
				end
			end
		end
	end
	return n
end

return Terrain
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1336">
          <Properties>
            <string name="Name">WorldBuilder</string>
            <string name="Source"><![CDATA[-- WorldBuilder: builds the whole city once when the server starts.
-- If a pre-built "City" folder already exists in Workspace (baked in Studio), it is reused.
--
-- To bake the city into the place so you can see/edit it in Studio, run in the command bar:
--   require(game.ServerScriptService.Server.World.WorldBuilder).build({ bake = true })
-- then save the place. The server will keep the baked copy on the next start.

local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local B = require(Shared.Util.Builder)
local CityLayout = require(Shared.World.CityLayout)

local Terrain = require(script.Parent.TerrainBuilder)
local Roads = require(script.Parent.Roads)
local Blocks = require(script.Parent.Blocks)
local Landmarks = require(script.Parent.Landmarks)

local WorldBuilder = {}

function WorldBuilder.build(opts: { [string]: any }?)
	local o = opts or {}
	local existing = Workspace:FindFirstChild("City")
	if existing and not o.rebuild then
		existing:SetAttribute("Reused", true)
		return existing
	end
	if existing then
		existing:Destroy()
	end
	local t0 = os.clock()
	local world = B.folder("City", nil)
	local ops = 0
	local function yield()
		ops += 1
		if not o.bake and ops % 4 == 0 then
			task.wait()
		end
	end

	Terrain.build()
	Roads.build(world, yield)
	Blocks.build(world, yield)
	Landmarks.build(world, yield)
	world:SetAttribute("GroundPatches", Terrain.clearUnder(world))

	-- spawn point on the main square
	local L = CityLayout.get()
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "CitySpawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(12, 0.4, 12)
	spawn.CFrame = L.spawn * CFrame.new(0, -2.6, 0)
	spawn.Transparency = 1
	spawn.CanCollide = false
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Parent = world

	world:SetAttribute("BuildSeconds", os.clock() - t0)
	world.Parent = Workspace
	return world
end

return WorldBuilder
]]></string>
