local function storage(id, name, kind, size, speed, price, extra)
	local p = { id = "st_" .. id, cat = "storage", name = name, kind = kind, size = size, speed = speed, price = price }
	if extra then
		for k, v in extra do
			p[k] = v
		end
	end
	return add(p)
end

