	{ id = "flea_market", cat = "market", icon = "🧺", service = "used", name = N("Bit Pazarı", "Flea Market"), desc = N("Tezgâhlarda ucuz, şansa kalmış parçalar.", "Cheap, luck-of-the-draw parts on stalls.") },
