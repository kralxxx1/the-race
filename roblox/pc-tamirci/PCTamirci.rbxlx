local function lookup(key: string): string
	local e = T[key]
	if not e then
		return key
	end
	return if lang == "en" then e[2] else e[1]
end

function S.t(key: string, vars: { [string]: any }?): string
	local s = lookup(key)
	if vars then
		s = string.gsub(s, "{(%w+)}", function(k)
			local v = vars[k]
			return if v ~= nil then tostring(v) else ""
		end)
	end
	return s
end

function S.has(key: string): boolean
	return T[key] ~= nil
end

-- Localised picks from data tables shaped { tr = ..., en = ... }
function S.pick(t: any): string
	if type(t) ~= "table" then
		return tostring(t or "")
	end
	return (if lang == "en" then t.en else t.tr) or t.tr or t.en or ""
end

function S.lang(): string
	return lang
end

function S.setLang(l: string)
	lang = if l == "en" then "en" else "tr"
end

function S.detect()
	local ok, id = pcall(function()
		return Players.LocalPlayer.LocaleId
	end)
	if ok and type(id) == "string" and string.sub(id, 1, 2) ~= "tr" then
		lang = "en"
	end
end

function S.money(n: number?): string
	local v = math.floor((n or 0) + 0.5)
	local s = tostring(math.abs(v))
	local out = s:reverse():gsub("(%d%d%d)", "%1."):reverse()
	if string.sub(out, 1, 1) == "." then
		out = string.sub(out, 2)
	end
	return (if v < 0 then "-" else "") .. Config.CurrencySymbol .. out
end

function S.err(e: string?, vars: { [string]: any }?): string
	if e and T["e_" .. e] then
		return S.t("e_" .. e, vars)
	end
	return S.t("e_generic", { err = e or "?" })
end

function S.stars(n: number): string
	return string.rep("★", math.clamp(n, 0, 5)) .. string.rep("☆", 5 - math.clamp(n, 0, 5))
end

return S
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="2074">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="2075">
            <Properties>
              <string name="Name">App</string>
              <string name="Source"><![CDATA[-- App: things every window shares (the main ScreenGui) and the usual "did it work?" toast.

local SoundService = game:GetService("SoundService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local S = require(script.Parent.Parent.Strings)
local Hud = require(script.Parent.Hud)

local App = {}
App.screen = nil :: ScreenGui?
App.sfxVolume = 0.8

local sounds: { [string]: Sound } = {}

-- Plays a sound id once, for this player only.
function App.play(id: string?, volume: number?)
	if type(id) ~= "string" or id == "" then
		return
	end
	local s = sounds[id]
	if not s then
		s = Instance.new("Sound")
		s.Name = "Sfx"
		s.SoundId = id
		s.Parent = SoundService
		sounds[id] = s
	end
	s.Volume = (volume or 0.5) * App.sfxVolume
	SoundService:PlayLocalSound(s)
end

-- Plays one of Config.Sounds (Click, Cash, ...) for this player only.
function App.sound(name: string, volume: number?)
	App.play(Config.Sounds and Config.Sounds[name], volume)
end

-- Keeps a sound id playing until the returned function is called.
function App.loop(id: string?, volume: number?): () -> ()
	if type(id) ~= "string" or id == "" then
		return function() end
	end
	local s = Instance.new("Sound")
	s.Name = "SfxLoop"
	s.SoundId = id
	s.Looped = true
	s.Volume = (volume or 0.5) * App.sfxVolume
	s.Parent = SoundService
	s:Play()
	return function()
		s:Stop()
		s:Destroy()
	end
end

-- Shows the server's error (or `okText` on success). Returns r.ok.
function App.report(r: { [string]: any }, okText: string?): boolean
	if r.ok then
		if okText then
			Hud.toast(okText, "good")
		end
		return true
	end
	Hud.toast(S.err(r.err, r), "bad")
	return false
end

return App
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="2076">
            <Properties>
              <string name="Name">ContractsPanel</string>
              <string name="Source"><![CDATA[-- ContractsPanel: bulk work offered by the internet café and the data centre.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)

local UI = script.Parent
local Kit = require(UI.Kit)
local Theme = require(UI.Theme)
local Hud = require(UI.Hud)
local App = require(UI.App)
local S = require(UI.Parent.Strings)

local ContractsPanel = {}

local KIND_ICON = { maintenance = "🧹", repair = "🔧", upgrade_ssd = "💽", upgrade_ram = "📏" }

function ContractsPanel.open(o)
	local win = Kit.window(App.screen :: ScreenGui, "🏢 " .. S.pick(o.name) .. " — " .. S.t("contracts_title"), Vector2.new(760, 500), function()
		task.spawn(Net.request, "market.close")
	end)
	local c = win.content
	local head = if o.active then S.t("contract_active", { title = S.pick(o.active.title), done = o.active.done, total = o.active.total }) else S.t("contract_hint")
	Kit.label(c, head, { Size = UDim2.new(1, 0, 0, 40), TextColor3 = if o.active then Theme.warn else Theme.dim, TextSize = 14, TextYAlignment = Enum.TextYAlignment.Top })
	if o.locked then
		local why = if o.why == "level" then S.t("needs_level", { n = o.level }) else S.err(o.why)
		Kit.label(c, "🔒 " .. why, { Size = UDim2.new(1, 0, 0, 24), Position = UDim2.fromOffset(0, 40), TextColor3 = Theme.bad, FontFace = Theme.bold })
	end
	local list = Kit.list(c, { Size = UDim2.new(1, 0, 1, -72), Position = UDim2.fromOffset(0, 70) }, 8)
	for i, offer in o.offers or {} do
		local sub = S.t("contract_count", { n = offer.count }) .. "  •  " .. S.t("contract_pay", { pay = S.money(offer.pay), bonus = S.money(offer.bonus) })
		local _, right = Kit.row(list, KIND_ICON[offer.kind] or "🏢", S.pick(offer.title), sub, { LayoutOrder = i })
		Kit.label(right, S.money(offer.pay * offer.count + offer.bonus), { Size = UDim2.fromOffset(80, 36), TextColor3 = Theme.money, FontFace = Theme.bold, TextXAlignment = Enum.TextXAlignment.Right })
		local b = Kit.button(right, S.t("contract_accept"), function()
			local r = Net.request("contracts.accept", { poi = o.poi, key = offer.key })
			if r.ok then
				win.close()
				Hud.toast(S.t("contract_taken", { n = r.count or offer.count }), "good", 6)
			else
				App.report(r)
			end
		end, { Size = UDim2.fromOffset(130, 36), TextSize = 15 }, "good")
		Kit.setEnabled(b, not o.locked and o.active == nil)
	end
end

function ContractsPanel.init()
	Net.on("contracts.open", ContractsPanel.open)
end

return ContractsPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="2077">
            <Properties>
              <string name="Name">CustomerDialog</string>
              <string name="Source"><![CDATA[-- CustomerDialog: talking to a customer at the counter. Shows what they say, the device and the
-- tools it will take, their offer, and lets you accept, haggle (ask for more) or decline.
-- The shady seller offers a "deal" instead.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Tools = require(Shared.Data.Tools)
local Parts = require(Shared.Data.Parts)

local UI = script.Parent
local Kit = require(UI.Kit)
local Theme = require(UI.Theme)
local Hud = require(UI.Hud)
local App = require(UI.App)
local S = require(UI.Parent.Strings)
local State = require(UI.Parent.State)

local CustomerDialog = {}

local win = nil

local function reply(id: string, action: string, price: number?)
	return Net.request("customer.reply", { id = id, action = action, price = price })
end

local function render(o)
	if win then
		win.close(true)
	end
	local archName = S.pick(o.archName)
	win = Kit.window(App.screen :: ScreenGui, "👤 " .. S.t("talk_title", { name = o.name, arch = archName }), Vector2.new(600, 470))
	local body = Kit.frame(win.content, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, -56) })
	Kit.listLayout(body, 8)

	-- what they say
	local bubble = Kit.panel(body, { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = Theme.card, LayoutOrder = 1 })
	Kit.padding(bubble, 12)
	Kit.label(bubble, S.t("talk_quote", { text = o.text or "..." }), { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextSize = 18, FontFace = Theme.font })

	if o.kind == "sell" and o.sale then
		local p = Parts.get(o.sale.part)
		local icon = p and Theme.catIcon[p.cat] or "📦"
		Kit.label(body, icon .. " <b>" .. o.sale.name .. "</b>", { TextSize = 18, LayoutOrder = 2, Size = UDim2.new(1, 0, 0, 26) })
		if p then
			Kit.label(body, Parts.spec(p, S.lang()), { TextColor3 = Theme.dim, TextSize = 14, LayoutOrder = 3 })
		end
		Kit.label(body, S.t("talk_retail", { price = S.money(o.sale.retail) }) .. "   •   " .. S.t("talk_offer", { price = "<b>" .. S.money(o.sale.price) .. "</b>" }), { LayoutOrder = 4, TextColor3 = Theme.money, Size = UDim2.new(1, 0, 0, 24) })
		Kit.label(body, "⚠️ " .. S.t("talk_sell_warn"), { LayoutOrder = 5, TextColor3 = Theme.warn, TextSize = 15, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y })
		Kit.button(win.content, S.t("talk_buy", { price = S.money(o.sale.price) }), function()
			local r = reply(o.id, "buy")
			if App.report(r, S.t("talk_bought", { name = o.sale.name })) then
				win.close()
			end
		end, { Size = UDim2.new(0.48, 0, 0, 46), Position = UDim2.new(0, 0, 1, -48) }, "warn")
		Kit.button(win.content, S.t("talk_reject"), function()
			reply(o.id, "reject")
			win.close()
		end, { Size = UDim2.new(0.48, 0, 0, 46), Position = UDim2.new(0.52, 0, 1, -48) }, "ghost")
		return
	end

	-- the device and what it will take
	if o.device then
		local icon = if o.deviceKind == "laptop" then "💻" else "🖥️"
		Kit.label(body, icon .. " " .. S.t("talk_device", { device = "<b>" .. o.device .. "</b>" }), { TextSize = 17, LayoutOrder = 2, Size = UDim2.new(1, 0, 0, 24) })
	end
	if o.requestId then
		Kit.pill(body, "📝 " .. S.t("request_label"), Theme.accent, { LayoutOrder = 3 })
	end
	local missing, have = {}, {}
	for _, tid in o.tools or {} do
		local t = Tools.get(tid)
		if t then
			table.insert(if State.owns(tid) then have else missing, t.icon .. " " .. S.pick(t.name))
		end
	end
	if #missing > 0 then
		Kit.label(body, S.t("missing_tool", { list = table.concat(missing, ", ") }), { TextColor3 = Theme.bad, TextSize = 15, LayoutOrder = 4, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y })
	elseif #have > 0 then
		Kit.label(body, "✔ " .. S.t("talk_tools_ok"), { TextColor3 = Theme.good, TextSize = 15, LayoutOrder = 4 })
	end

	-- offer and haggling
	Kit.label(body, S.t("talk_offer", { price = S.money(o.offer) }), { TextSize = 24, FontFace = Theme.heavy, TextColor3 = Theme.money, LayoutOrder = 5, Size = UDim2.new(1, 0, 0, 32) })
	if (o.rounds or 0) > 0 then
		local row = Kit.frame(body, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 40), LayoutOrder = 6 })
		Kit.listLayout(row, 8, true)
		Kit.label(row, S.t("talk_more"), { Size = UDim2.fromOffset(120, 36), TextColor3 = Theme.dim, LayoutOrder = 0 })
		for i, f in { 1.1, 1.25, 1.5 } do
			local ask = math.max(o.offer + 1, math.floor(o.offer * f + 0.5))
			Kit.button(row, S.t("talk_ask", { price = S.money(ask) }), function()
				local r = reply(o.id, "haggle", ask)
				if not r.ok then
					App.report(r)
					if r.err == "gone" then
						win.close()
					end
					return
				end
				if r.done then
					win.close()
					if r.walked then
						Hud.toast(S.t("talk_walked"), "bad")
					else
						Hud.toast(S.t("talk_deal", { price = S.money(r.price or ask) }), "good")
					end
				elseif r.offer then
					render(r.offer)
				end
			end, { Size = UDim2.fromOffset(140, 36), LayoutOrder = i, TextSize = 15 }, "warn")
		end
		Kit.label(body, S.t("talk_rounds", { n = o.rounds }), { TextColor3 = Theme.dim, TextSize = 13, LayoutOrder = 7 })
	end

	Kit.button(win.content, S.t("talk_accept", { price = S.money(o.offer) }), function()
		local r = reply(o.id, "accept")
		if r.ok and r.done then
			win.close()
			Hud.toast(S.t("talk_taken", { device = o.device or "", price = S.money(o.offer) }), "good")
		else
			App.report(r)
			if r.err == "gone" then
				win.close()
			end
		end
	end, { Size = UDim2.new(0.48, 0, 0, 46), Position = UDim2.new(0, 0, 1, -48) }, "good")
	Kit.button(win.content, S.t("talk_reject"), function()
		reply(o.id, "reject")
		win.close()
	end, { Size = UDim2.new(0.48, 0, 0, 46), Position = UDim2.new(0.52, 0, 1, -48) }, "ghost")
end

function CustomerDialog.open(offer)
	render(offer)
end

function CustomerDialog.init()
	Net.on("customer.talk", CustomerDialog.open)
end

return CustomerDialog
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="2078">
            <Properties>
              <string name="Name">Garage</string>
              <string name="Source"><![CDATA[-- Garage: the dealerships (a turning 3D preview, stats, colours, buying) and your own vehicles
-- (call one to the nearest road, park it).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Vehicles = require(Shared.Data.Vehicles)
local VehicleModels = require(Shared.Models.VehicleModels)

local UI = script.Parent
local Kit = require(UI.Kit)
local Theme = require(UI.Theme)
local Hud = require(UI.Hud)
local App = require(UI.App)
local S = require(UI.Parent.Strings)
local State = require(UI.Parent.State)

local Garage = {}

local KIND_ICON = { bicycle = "🚲", scooter = "🛴", bike = "🏍️", car = "🚗" }

local function iconOf(def): string
	if def.body == "van" or def.body == "minibus" then
		return "🚐"
	elseif def.body == "pickup" or def.body == "suv" then
		return "🚙"
	elseif def.body == "super" or def.body == "coupe" then
		return "🏎️"
	end
	return KIND_ICON[def.kind] or "🚗"
end

local function call(id: string)
	local r = Net.request("vehicle.spawn", { id = id })
	if App.report(r, S.t("vehicle_called")) then
		Kit.closeWindow()
		Hud.toast(S.t("drive_hint"), "info", 6)
	end
end

-- A 3D turntable of `def` in `color` inside `parent`. Returns a function that swaps the shown
-- vehicle/colour and a stop function.
local function turntable(parent: Instance)
	local vp = Instance.new("ViewportFrame")
	vp.Size = UDim2.fromScale(1, 1)
	vp.BackgroundColor3 = Color3.fromRGB(30, 34, 44)
	vp.Ambient = Color3.fromRGB(150, 152, 160)
	vp.LightColor = Color3.fromRGB(255, 248, 236)
	vp.LightDirection = Vector3.new(-0.6, -1, -0.4)
	vp.Parent = parent
	Kit.corner(vp)
	local world = Instance.new("WorldModel")
	world.Parent = vp
	local cam = Instance.new("Camera")
	cam.FieldOfView = 40
	cam.Parent = vp
	vp.CurrentCamera = cam
	-- showroom floor
	local floor = Instance.new("Part")
	floor.Anchored = true
	floor.Size = Vector3.new(40, 0.2, 40)
	floor.CFrame = CFrame.new(0, -0.1, 0)
	floor.Color = Color3.fromRGB(60, 64, 76)
	floor.Material = Enum.Material.SmoothPlastic
	floor.Parent = world
	local model: Model? = nil
	local size = Vector3.new(6, 4, 12)
	local angle = 0.8
	local function show(def, color: number)
		if model then
			model:Destroy()
		end
		local ok, m = pcall(VehicleModels.build, world, def, CFrame.new(), { color = color, plate = "34 PC 001", static = true })
		if ok then
			model = m
			local _, s = m:GetBoundingBox()
			size = s
		else
			warn("[Garage] " .. tostring(m))
		end
	end
	local conn = RunService.RenderStepped:Connect(function(dt)
		angle += dt * 0.45
		local radius = math.max(size.X, size.Z) * 1.35 + 3
		local focus = Vector3.new(0, size.Y * 0.4, 0)
		cam.CFrame = CFrame.lookAt(focus + Vector3.new(math.sin(angle) * radius, size.Y * 0.55 + 2, math.cos(angle) * radius), focus)
	end)
	return show, function()
		conn:Disconnect()
	end
end

local function statBar(parent: Instance, label: string, value: number, max: number, order: number)
	local row = Kit.frame(parent, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 20), LayoutOrder = order })
	Kit.label(row, label, { Size = UDim2.new(0, 120, 1, 0), TextSize = 14, TextColor3 = Theme.dim })
	local bar = Kit.progress(row, { Size = UDim2.new(1, -130, 0, 10), Position = UDim2.new(0, 130, 0.5, -5) }, Theme.accent)
	bar:set(value / max)
end

-- Dealership window.
function Garage.dealer(payload)
	local dealer = payload.dealer
	local list = {}
	for _, v in Vehicles.list do
		if v.dealer == dealer then
			table.insert(list, v)
		end
	end
	table.sort(list, function(a, b)
		return a.price < b.price
	end)
	local stop
	local conn
	local win = Kit.window(App.screen :: ScreenGui, "🚘 " .. S.pick(Vehicles.dealers[dealer]), Vector2.new(980, 600), function()
		if stop then
			stop()
		end
		if conn then
			conn:Disconnect()
		end
		task.spawn(Net.request, "market.close")
	end)
	local c = win.content
	local left = Kit.list(c, { Size = UDim2.new(0, 360, 1, 0) })
	local right = Kit.frame(c, { BackgroundTransparency = 1, Size = UDim2.new(1, -376, 1, 0), Position = UDim2.fromOffset(376, 0) })
	local view = Kit.frame(right, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0.52, 0) })
	local show
	show, stop = turntable(view)
	local info = Kit.frame(right, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0.48, -8), Position = UDim2.new(0, 0, 0.52, 8) })
	Kit.listLayout(info, 6)

	local selected = list[1]
	local color = 1
	local rows = {}
	local function render()
		Kit.clear(info)
		local def = selected
		if not def then
			return
		end
		local d = State.data
		local owned = d and d.vehicles[def.id]
		Kit.label(info, iconOf(def) .. " <b>" .. S.pick(def.name) .. "</b>", { TextSize = 22, LayoutOrder = 1, Size = UDim2.new(1, 0, 0, 28) })
		Kit.label(info, S.t("vehicle_speed", { n = def.speed }) .. " " .. S.t("kmh") .. "   •   " .. S.t("vehicle_seats", { n = def.seats }) .. "   •   " .. S.t("level") .. " " .. (def.level or 1), { TextSize = 14, TextColor3 = Theme.dim, LayoutOrder = 2 })
		statBar(info, "⚡ " .. S.t("vehicle_speed", { n = "" }), def.speed, 140, 3)
		statBar(info, "🚀 0-100", def.accel, 80, 4)
		statBar(info, "🎯 " .. (if S.lang() == "en" then "Handling" else "Yol tutuş"), def.turn, 3.6, 5)
		-- colours
		local swatches = Kit.frame(info, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 34), LayoutOrder = 6 })
		Kit.listLayout(swatches, 6, true)
		for i, rgb in def.colors do
			local b = Kit.button(swatches, "", function()
				color = i
				show(def, i)
				render()
			end, { Size = UDim2.fromOffset(30, 30), LayoutOrder = i })
			Kit.setColor(b, Color3.fromRGB(rgb[1], rgb[2], rgb[3]))
			Kit.corner(b, UDim.new(1, 0))
			if i == color then
				Kit.outline(b, Color3.new(1, 1, 1), 3, 0)
			end
		end
		local buttons = Kit.frame(info, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 46), LayoutOrder = 7 })
		Kit.listLayout(buttons, 8, true)
		if owned then
			Kit.pill(buttons, "✔ " .. S.t("owned"), Theme.good, { LayoutOrder = 1 })
			Kit.button(buttons, "📍 " .. S.t("vehicle_call"), function()
				call(def.id)
			end, { Size = UDim2.fromOffset(180, 42), LayoutOrder = 2 }, "primary")
		else
			local locked = (d and d.level or 1) < (def.level or 1)
			local b = Kit.button(buttons, if locked then S.t("needs_level", { n = def.level }) else S.t("dealer_buy", { price = S.money(def.price) }), function()
				local r = Net.request("vehicle.buy", { id = def.id, color = color })
				if App.report(r, S.t("bought", { name = S.pick(def.name) })) then
					Hud.banner(iconOf(def) .. " " .. S.pick(def.name))
				end
			end, { Size = UDim2.fromOffset(260, 42), LayoutOrder = 1 }, "good")
			Kit.setEnabled(b, not locked and d ~= nil and d.money >= def.price)
		end
	end
	local function choose(def)
		selected = def
		color = 1
		local d = State.data
		local mine = d and d.vehicles[def.id]
		if mine and mine.color then
			color = mine.color
		end
		for id, row in rows do
			Kit.outline(row, if id == def.id then Theme.accent else Theme.line, if id == def.id then 2 else 1, if id == def.id then 0 else 0.6)
		end
		show(def, color)
		render()
	end
	for i, def in list do
		local row, r = Kit.row(left, iconOf(def), S.pick(def.name), S.money(def.price) .. "  •  " .. S.t("level") .. " " .. (def.level or 1), { LayoutOrder = i }, 34)
		local d = State.data
		if d and d.vehicles[def.id] then
			Kit.pill(r, "✔", Theme.good)
		end
		local hit = Instance.new("TextButton")
		hit.BackgroundTransparency = 1
		hit.Text = ""
		hit.Size = UDim2.fromScale(1, 1)
		hit.ZIndex = 3
		hit.Parent = row
		hit.Activated:Connect(function()
			choose(def)
		end)
		rows[def.id] = row
	end
	if selected then
		choose(selected)
	end
	conn = State.changed:Connect(render)
end

-- Your vehicles (from the phone).
function Garage.open()
	local win = Kit.window(App.screen :: ScreenGui, "🚗 " .. S.t("garage_title"), Vector2.new(620, 520))
	local c = win.content
	Kit.button(c, "🅿️ " .. S.t("vehicle_park"), function()
		Net.request("vehicle.despawn")
		win.close()
	end, { Size = UDim2.fromOffset(160, 34), Position = UDim2.new(1, -160, 0, 0) }, "ghost")
	local list = Kit.list(c, { Size = UDim2.new(1, 0, 1, -44), Position = UDim2.fromOffset(0, 42) })
	local n = 0
	local owned = State.data and State.data.vehicles or {}
	for _, def in Vehicles.list do
		if owned[def.id] then
			n += 1
			local _, right = Kit.row(list, iconOf(def), S.pick(def.name), S.t("vehicle_speed", { n = def.speed }) .. " " .. S.t("kmh") .. " • " .. S.t("vehicle_seats", { n = def.seats }), { LayoutOrder = n })
			Kit.button(right, "📍 " .. S.t("vehicle_call"), function()
				call(def.id)
			end, { Size = UDim2.fromOffset(130, 36) }, "primary")
		end
	end
	if n == 0 then
		Kit.label(list, S.t("vehicle_none"), { TextColor3 = Theme.dim, Size = UDim2.new(1, 0, 0, 40) })
	end
end

function Garage.init()
	Net.on("dealer.open", Garage.dealer)
end

return Garage
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="2079">
            <Properties>
              <string name="Name">Hud</string>
              <string name="Source"><![CDATA[-- Hud: money, level and XP, reputation, the clock, the quick buttons and toasts.

local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")
local UserInputService = game:GetService("UserInputService")

local Kit = require(script.Parent.Kit)
local Theme = require(script.Parent.Theme)
local S = require(script.Parent.Parent.Strings)
local State = require(script.Parent.Parent.State)

local Hud = {}
Hud.buttons = {} :: { [string]: TextButton }

-- Elements that hide together with the HUD (while working at a bench): the HUD's own panels
-- plus anything other modules register (minimap, GPS, tutorial...).
local hideable: { GuiObject } = {}

function Hud.register(obj: GuiObject)
	table.insert(hideable, obj)
end

local gui: ScreenGui
local toastHolder: Frame
local moneyLabel: TextLabel
local levelLabel: TextLabel
local xpBar
local repLabel: TextLabel
local clockLabel: TextLabel
local shown = 0

local function fmtClock(t: number): string
	local h = math.floor(t)
	local m = math.floor((t - h) * 60)
	return string.format("%02d:%02d", h, m)
end

-- Short message in the top centre.
function Hud.toast(text: string, kind: string?, seconds: number?)
	if not toastHolder then
		return
	end
	local color = if kind == "good" then Theme.good elseif kind == "bad" then Theme.bad elseif kind == "warn" then Theme.accent2 else Theme.accent
	shown += 1
	local f = Kit.panel(toastHolder, { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = Theme.panel, BackgroundTransparency = 0.05, LayoutOrder = -shown })
	Kit.outline(f, color, 2, 0.1)
	Kit.padding(f, 7)
	Kit.label(f, text, { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextSize = 15, FontFace = Theme.bold, TextXAlignment = Enum.TextXAlignment.Center })
	f.BackgroundTransparency = 1
	Kit.tween(f, { BackgroundTransparency = 0.05 }, 0.2)
	task.delay(seconds or 4.5, function()
		if f.Parent then
			for _, d in f:GetDescendants() do
				if d:IsA("TextLabel") then
					Kit.tween(d, { TextTransparency = 1 }, 0.4)
				elseif d:IsA("UIStroke") then
					Kit.tween(d, { Transparency = 1 }, 0.4)
				end
			end
			Kit.tween(f, { BackgroundTransparency = 1 }, 0.4)
			task.wait(0.45)
			f:Destroy()
		end
	end)
	-- keep at most three
	local items = {}
	for _, c in toastHolder:GetChildren() do
		if c:IsA("Frame") then
			table.insert(items, c)
		end
	end
	if #items > 3 then
		table.sort(items, function(a, b)
			return a.LayoutOrder > b.LayoutOrder
		end)
		items[1]:Destroy()
	end
end

-- "+$120" floating up from the money counter.
local function moneyPop(delta: number)
	if not moneyLabel or delta == 0 then
		return
	end
	local pop = Kit.label(moneyLabel.Parent, (if delta > 0 then "+" else "") .. S.money(delta), {
		Size = UDim2.fromOffset(160, 24),
		Position = UDim2.new(0, 40, 0, 40),
		TextColor3 = if delta > 0 then Theme.money else Theme.bad,
		FontFace = Theme.heavy,
		TextSize = 20,
		TextStrokeTransparency = 0.4,
		ZIndex = 5,
	})
	Kit.tween(pop, { Position = UDim2.new(0, 40, 0, 74), TextTransparency = 1, TextStrokeTransparency = 1 }, 1.4)
	task.delay(1.5, function()
		pop:Destroy()
	end)
end

local function refresh(d, prev)
	if not d then
		return
	end
	moneyLabel.Text = "💰 " .. S.money(d.money)
	levelLabel.Text = "⭐ " .. S.t("level") .. " " .. d.level
	xpBar:set(d.xp / math.max(1, d.xpNext or 100), prev ~= nil)
	local stars = math.floor(d.rep / 20 + 0.5)
	repLabel.Text = S.stars(stars) .. "  " .. math.floor(d.rep)
	if prev then
		moneyPop(d.money - prev.money)
	end
end

function Hud.init(screen: ScreenGui, actions: { [string]: () -> () })
	gui = screen
	-- top centre, in the free middle of Roblox's top bar: money | level and XP | reputation
	-- (the corners belong to Roblox's menu, chat and player list, and on phones to the
	-- thumbstick and jump button)
	local card = Kit.panel(gui, { Name = "Stats", Size = UDim2.fromOffset(470, 50), Position = UDim2.new(0.5, 0, 0, 5), AnchorPoint = Vector2.new(0.5, 0), BackgroundTransparency = 0.12 })
	Hud.register(card)
	moneyLabel = Kit.label(card, S.money(0), { Name = "Money", Size = UDim2.fromOffset(185, 50), Position = UDim2.fromOffset(14, 0), TextSize = 24, FontFace = Theme.heavy, TextColor3 = Theme.money, TextWrapped = false })
	levelLabel = Kit.label(card, "", { Size = UDim2.fromOffset(150, 20), Position = UDim2.fromOffset(204, 6), TextSize = 15, FontFace = Theme.bold, TextWrapped = false })
	xpBar = Kit.progress(card, { Position = UDim2.fromOffset(204, 31), Size = UDim2.fromOffset(150, 9) }, Theme.accent)
	repLabel = Kit.label(card, "", { Size = UDim2.fromOffset(104, 50), Position = UDim2.fromOffset(358, 0), TextSize = 14, TextColor3 = Theme.warn, TextXAlignment = Enum.TextXAlignment.Center, TextWrapped = false })

	-- top-right, in the top bar: clock and weather
	local clock = Kit.panel(gui, { Name = "Clock", Size = UDim2.fromOffset(176, 40), Position = UDim2.new(1, -192, 0, 9), BackgroundTransparency = 0.12 })
	Hud.register(clock)
	clockLabel = Kit.label(clock, "", { Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 18, FontFace = Theme.bold })
	task.spawn(function()
		while gui.Parent do
			local t = Lighting.ClockTime
			local icon = if Workspace:GetAttribute("Raining") then "🌧️" elseif t >= 19.5 or t < 6 then "🌙" else "☀️"
			clockLabel.Text = string.format("%s %s • %s", icon, fmtClock(t), S.t("day", { d = Workspace:GetAttribute("Day") or 1 }))
			task.wait(0.5)
		end
	end)

	-- left edge, above the minimap: quick buttons (also the only way in on touch screens)
	local bar = Kit.frame(gui, { Name = "Quick", BackgroundTransparency = 1, Size = UDim2.fromOffset(64, 5 * 68), Position = UDim2.fromOffset(14, 140) })
	Hud.register(bar)
	Kit.listLayout(bar, 8)
	local touch = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	local defs = {
		{ id = "home", icon = "🏠", key = "H" },
		{ id = "jobs", icon = "📋", key = "J" },
		{ id = "inventory", icon = "🎒", key = "B" },
		{ id = "phone", icon = "📱", key = "P" },
		{ id = "map", icon = "🗺️", key = "M" },
	}
	for i, d in defs do
		local b = Kit.button(bar, d.icon, actions[d.id], { Size = UDim2.fromOffset(60, 60), TextSize = 28, LayoutOrder = i, BackgroundTransparency = 0.1 })
		b.Name = d.id
		if not touch then
			Kit.label(b, d.key, { Size = UDim2.fromOffset(18, 16), Position = UDim2.new(1, -20, 1, -18), TextSize = 12, TextColor3 = Theme.dim, FontFace = Theme.bold })
		end
		Hud.buttons[d.id] = b
	end

	-- toasts: top centre, under the stats bar
	-- (above windows and the map, so purchases and alarms are always seen)
	toastHolder = Kit.frame(gui, { Name = "Toasts", BackgroundTransparency = 1, Size = UDim2.fromOffset(500, 300), Position = UDim2.new(0.5, 0, 0, 62), AnchorPoint = Vector2.new(0.5, 0), ZIndex = 50 })
	Kit.listLayout(toastHolder, 6, false, Enum.HorizontalAlignment.Center)

	State.changed:Connect(refresh)
	if State.data then
		refresh(State.data, nil)
	end
	State.levelUp:Connect(function(level)
		Hud.toast(S.t("level_up", { n = level }), "good", 5)
		Hud.banner("⭐ " .. S.t("level") .. " " .. level .. " ⭐")
	end)
end

-- Big centred banner (level ups, big payouts).
function Hud.banner(text: string)
	local l = Kit.label(gui, text, { Size = UDim2.fromOffset(700, 70), Position = UDim2.new(0.5, 0, 0.32, 0), AnchorPoint = Vector2.new(0.5, 0.5), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 46, FontFace = Theme.heavy, TextColor3 = Theme.warn, TextStrokeTransparency = 0.3, ZIndex = 50 })
	local sc = Instance.new("UIScale")
	sc.Scale = 0.4
	sc.Parent = l
	Kit.tween(sc, { Scale = 1 }, 0.35, Enum.EasingStyle.Back)
	task.delay(2.4, function()
		Kit.tween(l, { TextTransparency = 1, TextStrokeTransparency = 1 }, 0.5)
		task.wait(0.6)
		l:Destroy()
	end)
end

local shown: { [GuiObject]: boolean } = {}

function Hud.setVisible(on: boolean)
	for _, obj in hideable do
		if obj.Parent then
			if on then
				-- restore what was showing (the GPS panel may have been hidden on purpose)
				if shown[obj] ~= nil then
					obj.Visible = shown[obj]
				end
			else
				shown[obj] = obj.Visible
				obj.Visible = false
			end
		end
	end
	if on then
		table.clear(shown)
	end
end

return Hud
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="2080">
            <Properties>
              <string name="Name">Inventory</string>
              <string name="Source"><![CDATA[-- Inventory (B): parts on your shelves, consumables and the tools you own.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Parts = require(Shared.Data.Parts)
local Tools = require(Shared.Data.Tools)

local UI = script.Parent
local Kit = require(UI.Kit)
local Theme = require(UI.Theme)
local App = require(UI.App)
local S = require(UI.Parent.Strings)
local State = require(UI.Parent.State)

local Inventory = {}

local win = nil

local function partsPage(list: ScrollingFrame)
	local items = State.data and State.data.inv or {}
	local sorted = table.clone(items)
	local order = {}
	for i, c in Parts.Categories do
		order[c] = i
	end
	table.sort(sorted, function(a, b)
		local pa, pb = Parts.get(a.part), Parts.get(b.part)
		local ca, cb = pa and order[pa.cat] or 99, pb and order[pb.cat] or 99
		if ca ~= cb then
			return ca < cb
		end
		return (pa and pa.price or 0) > (pb and pb.price or 0)
	end)
	for i, item in sorted do
		local p = Parts.get(item.part)
		if p then
			local cond = if item.cond and item.cond < 0.999 then S.t("cond", { n = math.floor(item.cond * 100) }) else S.t("cond_new")
			local _, right = Kit.row(list, Theme.catIcon[p.cat] or "📦", p.name, cond .. " • " .. Parts.spec(p, S.lang()), { LayoutOrder = i })
			if item.broken then
				Kit.pill(right, S.t("broken_known"), Theme.bad)
			end
			local origin = item.origin and S.has("origin_" .. item.origin) and S.t("origin_" .. item.origin)
			if origin then
				Kit.pill(right, origin, Theme.cat[p.cat] or Theme.accent)
			end
		end
	end
	if #sorted == 0 then
		Kit.label(list, S.t("empty"), { TextColor3 = Theme.dim, Size = UDim2.new(1, 0, 0, 40) })
	end
end

local function stockPage(list: ScrollingFrame)
	local n = 0
	for id, uses in State.data and State.data.stock or {} do
		local p = Parts.get(id)
		if p and uses > 0 then
			n += 1
			local _, right = Kit.row(list, Theme.catIcon.misc, p.name, S.t("consumable"), { LayoutOrder = n })
			Kit.pill(right, S.t("stock_uses", { n = uses }), Theme.accent)
		end
	end
	if n == 0 then
		Kit.label(list, S.t("empty"), { TextColor3 = Theme.dim, Size = UDim2.new(1, 0, 0, 40) })
	end
end

local function toolsPage(list: ScrollingFrame)
	local n = 0
	for _, t in Tools.list do
		if State.owns(t.id) then
			n += 1
			Kit.row(list, t.icon, S.pick(t.name), S.pick(t.desc), { LayoutOrder = t.order or n })
		end
	end
end

function Inventory.open(tab: string?)
	local conn
	win = Kit.window(App.screen :: ScreenGui, "🎒 " .. S.t("inventory"), Vector2.new(820, 560), function()
		if conn then
			conn:Disconnect()
		end
	end)
	local c = win.content
	local info = Kit.label(c, "", { Size = UDim2.new(1, 0, 0, 22), TextColor3 = Theme.dim, TextSize = 14 })
	local list = Kit.list(c, { Size = UDim2.new(1, 0, 1, -72), Position = UDim2.fromOffset(0, 70) })
	local current = tab or "parts"
	local function fill()
		local d = State.data
		info.Text = if d then "📦 " .. S.t("storage", { n = #d.inv, m = d.capacity or 0 }) else ""
		Kit.clear(list)
		if current == "parts" then
			partsPage(list)
		elseif current == "stock" then
			stockPage(list)
		else
			toolsPage(list)
		end
	end
	local tabs = Kit.tabs(c, {
		{ id = "parts", text = "📦 " .. S.t("inv_parts") },
		{ id = "stock", text = "🧴 " .. S.t("inv_stock") },
		{ id = "tools", text = "🧰 " .. S.t("inv_tools") },
	}, function(id)
		current = id
		fill()
	end, { Position = UDim2.fromOffset(0, 28) })
	tabs.select(current)
	conn = State.changed:Connect(fill)
end

function Inventory.toggle()
	if win and win.isOpen() then
		win.close()
	else
		Inventory.open()
	end
end

return Inventory
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="2081">
            <Properties>
              <string name="Name">JobsPanel</string>
              <string name="Source"><![CDATA[-- JobsPanel (J): every job in your shop — queued, on a bench, waiting for pickup — with what the
-- customer said, the price, why a technician got stuck, and selling finished own projects.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Tools = require(Shared.Data.Tools)

local UI = script.Parent
local Kit = require(UI.Kit)
local Theme = require(UI.Theme)
local Hud = require(UI.Hud)
local App = require(UI.App)
local S = require(UI.Parent.Strings)
local State = require(UI.Parent.State)

local JobsPanel = {}

local win = nil

local STATUS_ORDER = { bench = 1, waiting = 2, ready = 3, showcase = 4 }
local STATUS_COLOR = { bench = Theme.accent, waiting = Theme.accent2, ready = Theme.good, showcase = Color3.fromRGB(170, 110, 240) }

local function blockedText(b): string
	local detail = b.detail or ""
	if b.reason == "need_part" and S.has("cat_" .. detail) then
		detail = S.t("cat_" .. detail)
	elseif b.reason == "need_tool" then
		local t = Tools.get(detail)
		detail = if t then t.icon .. " " .. S.pick(t.name) else detail
	end
	return "⚠️ " .. S.t("job_blocked", { by = b.by or "?", reason = S.t("reason_" .. tostring(b.reason)) .. " " .. detail })
end

local function card(list: ScrollingFrame, job, order: number)
	local f = Kit.panel(list, { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = Theme.card, LayoutOrder = order })
	Kit.padding(f, 10)
	local inner = Kit.frame(f, { BackgroundTransparency = 1, Size = UDim2.new(1, -170, 0, 0), AutomaticSize = Enum.AutomaticSize.Y })
	Kit.listLayout(inner, 3)
	local icon = if job.device == "laptop" then "💻" else "🖥️"
	Kit.label(inner, icon .. " <b>" .. (job.name or job.id) .. "</b>", { TextSize = 17, LayoutOrder = 1, Size = UDim2.new(1, 0, 0, 22) })
	local who = if job.customer then "👤 " .. job.customer.name elseif job.client then "🏢 " .. S.pick(job.client) elseif job.own then "🛠️ " .. S.t("job_own") else ""
	local money = if job.price and job.price > 0 then "   💵 " .. S.money(job.price) else ""
	Kit.label(inner, who .. money, { TextColor3 = Theme.dim, TextSize = 14, LayoutOrder = 2 })
	if job.complaint and #job.complaint > 0 then
		Kit.label(inner, "“" .. job.complaint .. "”", { TextSize = 14, LayoutOrder = 3, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y })
	end
	local missing = {}
	for _, tid in job.tools or {} do
		if not State.owns(tid) then
			local t = Tools.get(tid)
			table.insert(missing, if t then t.icon .. " " .. S.pick(t.name) else tid)
		end
	end
	if #missing > 0 then
		Kit.label(inner, S.t("missing_tool", { list = table.concat(missing, ", ") }), { TextColor3 = Theme.bad, TextSize = 13, LayoutOrder = 4, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y })
	end
	if job.blocked and job.status == "waiting" then
		Kit.label(inner, blockedText(job.blocked), { TextColor3 = Theme.warn, TextSize = 13, LayoutOrder = 5, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y })
	end
	if job.own and job.resale then
		Kit.label(inner, S.t("job_resale", { price = S.money(job.resale) }), { TextColor3 = Theme.money, TextSize = 13, LayoutOrder = 6 })
	end

	local right = Kit.frame(f, { BackgroundTransparency = 1, Size = UDim2.fromOffset(160, 80), Position = UDim2.new(1, -160, 0, 0) })
	Kit.listLayout(right, 6, false, Enum.HorizontalAlignment.Right)
	local status = job.status or "waiting"
	local text = S.t("job_status_" .. status)
	if status == "bench" and job.bench then
		text ..= " " .. job.bench
	end
	Kit.pill(right, text, STATUS_COLOR[status] or Theme.dim, { LayoutOrder = 1 })
	if job.own and status ~= "bench" and status ~= "showcase" and job.resale then
		Kit.button(right, S.t("job_sell", { price = S.money(job.resale) }), function()
			local r = Net.request("jobs.sell", { job = job.id })
			if r.ok then
				Hud.toast(S.t("job_sold", { price = S.money(r.price or 0) }), "good")
			else
				App.report(r)
			end
		end, { Size = UDim2.fromOffset(150, 34), LayoutOrder = 2, TextSize = 14 }, "warn")
	end
end

function JobsPanel.open()
	local conn
	win = Kit.window(App.screen :: ScreenGui, "📋 " .. S.t("jobs"), Vector2.new(760, 560), function()
		if conn then
			conn:Disconnect()
		end
	end)
	local c = win.content
	local info = Kit.label(c, "", { Size = UDim2.new(1, 0, 0, 22), TextColor3 = Theme.dim, TextSize = 14 })
	local list = Kit.list(c, { Size = UDim2.new(1, 0, 1, -28), Position = UDim2.fromOffset(0, 26) }, 8)
	local function fill()
		Kit.clear(list)
		local jobs = table.clone(State.jobs or {})
		table.sort(jobs, function(a, b)
			local sa, sb = STATUS_ORDER[a.status] or 9, STATUS_ORDER[b.status] or 9
			if sa ~= sb then
				return sa < sb
			end
			return tostring(a.id) < tostring(b.id)
		end)
		info.Text = S.t("job_count", { n = #jobs })
		for i, job in jobs do
			card(list, job, i)
		end
		if #jobs == 0 then
			Kit.label(list, S.t("job_none"), { TextColor3 = Theme.dim, Size = UDim2.new(1, 0, 0, 60) })
		end
	end
	fill()
	conn = State.jobsChanged:Connect(fill)
end

function JobsPanel.toggle()
	if win and win.isOpen() then
		win.close()
	else
		JobsPanel.open()
	end
end

return JobsPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="2082">
            <Properties>
              <string name="Name">Kit</string>
              <string name="Source"><![CDATA[-- Kit: small UI building blocks with the game's look (rounded dark panels, accent buttons,
-- scrolling lists, tabs, windows). Everything is created from code.

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Theme = require(script.Parent.Theme)

local Kit = {}
Kit.clickSound = nil :: (() -> ())? -- set by the client entry point

local player = Players.LocalPlayer

function Kit.tween(obj: Instance, props: { [string]: any }, time: number?, style: Enum.EasingStyle?)
	local t = TweenService:Create(obj, TweenInfo.new(time or 0.18, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
	t:Play()
	return t
end

local function apply(inst: Instance, props: { [string]: any }?)
	if props then
		for k, v in props do
			(inst :: any)[k] = v
		end
	end
	return inst
end

function Kit.corner(parent: Instance, r: UDim?)
	local c = Instance.new("UICorner")
	c.CornerRadius = r or Theme.radius
	c.Parent = parent
	return c
end

function Kit.stroke(parent: Instance, color: Color3?, thickness: number?, transparency: number?)
	local s = Instance.new("UIStroke")
	s.Color = color or Theme.line
	s.Thickness = thickness or 1
	s.Transparency = transparency or 0.3
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = parent
	return s
end

-- Sets the (single) outline of a GUI object, creating it when missing.
function Kit.outline(obj: Instance, color: Color3, thickness: number?, transparency: number?)
	local s = obj:FindFirstChildOfClass("UIStroke")
	if not s then
		return Kit.stroke(obj, color, thickness, transparency)
	end
	s.Color = color
	s.Thickness = thickness or 1
	s.Transparency = transparency or 0.3
	return s
end

function Kit.padding(parent: Instance, px: number?)
	local p = Instance.new("UIPadding")
	local v = UDim.new(0, px or Theme.pad)
	p.PaddingLeft, p.PaddingRight, p.PaddingTop, p.PaddingBottom = v, v, v, v
	p.Parent = parent
	return p
end

function Kit.listLayout(parent: Instance, padding: number?, horizontal: boolean?, align: Enum.HorizontalAlignment?)
	local l = Instance.new("UIListLayout")
	l.Padding = UDim.new(0, padding or 6)
	l.SortOrder = Enum.SortOrder.LayoutOrder
	l.FillDirection = if horizontal then Enum.FillDirection.Horizontal else Enum.FillDirection.Vertical
	if align then
		l.HorizontalAlignment = align
	end
	if horizontal then
		l.VerticalAlignment = Enum.VerticalAlignment.Center
	end
	l.Parent = parent
	return l
end

function Kit.screen(name: string, order: number?): ScreenGui
	local g = Instance.new("ScreenGui")
	g.Name = name
	g.ResetOnSpawn = false
	g.IgnoreGuiInset = true
	g.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	g.DisplayOrder = order or 0
	g.Parent = player:WaitForChild("PlayerGui")
	-- shrink the UI on small screens
	local scale = Instance.new("UIScale")
	scale.Parent = g
	local function fit()
		local cam = Workspace.CurrentCamera
		local vp = if cam then cam.ViewportSize else Vector2.new(1280, 720)
		scale.Scale = math.clamp(math.min(vp.X / 1280, vp.Y / 720), 0.55, 1.15)
	end
	fit()
	local cam = Workspace.CurrentCamera
	if cam then
		cam:GetPropertyChangedSignal("ViewportSize"):Connect(fit)
	end
	return g
end

function Kit.frame(parent: Instance?, props: { [string]: any }?): Frame
	local f = Instance.new("Frame")
	f.BackgroundColor3 = Theme.panel
	f.BorderSizePixel = 0
	apply(f, props)
	f.Parent = parent
	return f
end

function Kit.panel(parent: Instance?, props: { [string]: any }?): Frame
	local f = Kit.frame(parent, props)
	Kit.corner(f)
	Kit.stroke(f)
	return f
end

-- Rich text needs a lone "&" escaped ("Parts & Tools").
function Kit.esc(text: string): string
	return (string.gsub(text, "&(%s)", "&amp;%1"))
end

function Kit.label(parent: Instance?, text: string, props: { [string]: any }?): TextLabel
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Text = Kit.esc(text)
	l.TextColor3 = Theme.text
	l.FontFace = Theme.font
	l.TextSize = 16
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.TextWrapped = true
	l.RichText = true
	l.Size = UDim2.new(1, 0, 0, 20)
	apply(l, props)
	l.Parent = parent
	return l
end

-- Button variants: "primary" (accent), "good", "bad", "ghost" (outline), default (card)
function Kit.button(parent: Instance?, text: string, onClick: (() -> ())?, props: { [string]: any }?, variant: string?): TextButton
	local b = Instance.new("TextButton")
	b.AutoButtonColor = false
	b.Text = text
	b.TextColor3 = Theme.text
	b.FontFace = Theme.bold
	b.TextSize = 16
	b.Size = UDim2.new(0, 140, 0, 36)
	b.BorderSizePixel = 0
	local base = Theme.card
	if variant == "primary" then
		base = Theme.accent
	elseif variant == "good" then
		base = Theme.good
	elseif variant == "bad" then
		base = Theme.bad
	elseif variant == "warn" then
		base = Theme.accent2
	end
	b.BackgroundColor3 = base
	if variant == "ghost" then
		b.BackgroundTransparency = 1
		Kit.stroke(b, Theme.line, 1, 0.1)
	end
	Kit.corner(b, Theme.radiusSmall)
	apply(b, props)
	-- hover effects follow the current base colour (tabs and tool bars recolour their buttons)
	b:SetAttribute("BaseColor", b.BackgroundColor3)
	local function baseOf(): Color3
		local c = b:GetAttribute("BaseColor")
		return if typeof(c) == "Color3" then c else base
	end
	b.MouseEnter:Connect(function()
		if b.Active then
			Kit.tween(b, { BackgroundColor3 = baseOf():Lerp(Color3.new(1, 1, 1), 0.12) }, 0.1)
		end
	end)
	b.MouseLeave:Connect(function()
		Kit.tween(b, { BackgroundColor3 = baseOf() }, 0.12)
	end)
	b.MouseButton1Down:Connect(function()
		Kit.tween(b, { BackgroundColor3 = baseOf():Lerp(Color3.new(0, 0, 0), 0.15) }, 0.06)
	end)
	if onClick then
		b.Activated:Connect(function()
			if b.Active then
				if Kit.clickSound then
					Kit.clickSound()
				end
				onClick()
			end
		end)
	end
	b.Parent = parent
	return b
end

-- Recolours a Kit button (keeps its hover effect in step).
function Kit.setColor(b: GuiButton, color: Color3)
	b:SetAttribute("BaseColor", color)
	b.BackgroundColor3 = color
end

function Kit.setEnabled(b: GuiButton, on: boolean)
	b.Active = on
	b.AutoButtonColor = false
	b.BackgroundTransparency = if on then 0 else 0.55
	if b:IsA("TextButton") then
		b.TextTransparency = if on then 0 else 0.45
	end
end

function Kit.pill(parent: Instance?, text: string, color: Color3?, props: { [string]: any }?): TextLabel
	local l = Kit.label(parent, text, { AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.new(0, 0, 0, 20), TextSize = 13, FontFace = Theme.bold, BackgroundTransparency = 0.15, BackgroundColor3 = color or Theme.accent, TextXAlignment = Enum.TextXAlignment.Center })
	Kit.corner(l, UDim.new(1, 0))
	local p = Instance.new("UIPadding")
	p.PaddingLeft, p.PaddingRight = UDim.new(0, 8), UDim.new(0, 8)
	p.Parent = l
	apply(l, props)
	return l
end

-- Vertical scrolling list that grows its canvas with the content.
function Kit.list(parent: Instance?, props: { [string]: any }?, padding: number?): ScrollingFrame
	local s = Instance.new("ScrollingFrame")
	s.BackgroundTransparency = 1
	s.BorderSizePixel = 0
	s.ScrollBarThickness = 6
	s.ScrollBarImageColor3 = Theme.line
	s.CanvasSize = UDim2.new()
	s.AutomaticCanvasSize = Enum.AutomaticSize.Y
	s.ScrollingDirection = Enum.ScrollingDirection.Y
	s.Size = UDim2.fromScale(1, 1)
	apply(s, props)
	Kit.listLayout(s, padding or 6)
	local p = Instance.new("UIPadding")
	p.PaddingRight = UDim.new(0, 8)
	p.PaddingTop = UDim.new(0, 2)
	p.PaddingBottom = UDim.new(0, 2)
	p.Parent = s
	s.Parent = parent
	return s
end

function Kit.grid(parent: Instance?, cell: UDim2, props: { [string]: any }?): ScrollingFrame
	local s = Instance.new("ScrollingFrame")
	s.BackgroundTransparency = 1
	s.BorderSizePixel = 0
	s.ScrollBarThickness = 6
	s.ScrollBarImageColor3 = Theme.line
	s.CanvasSize = UDim2.new()
	s.AutomaticCanvasSize = Enum.AutomaticSize.Y
	s.ScrollingDirection = Enum.ScrollingDirection.Y
	s.Size = UDim2.fromScale(1, 1)
	apply(s, props)
	local g = Instance.new("UIGridLayout")
	g.CellSize = cell
	g.CellPadding = UDim2.fromOffset(8, 8)
	g.SortOrder = Enum.SortOrder.LayoutOrder
	g.Parent = s
	local p = Instance.new("UIPadding")
	p.PaddingRight = UDim.new(0, 8)
	p.PaddingTop = UDim.new(0, 2)
	p.Parent = s
	s.Parent = parent
	return s
end

function Kit.clear(container: Instance)
	for _, c in container:GetChildren() do
		if c:IsA("GuiObject") then
			c:Destroy()
		end
	end
end

function Kit.progress(parent: Instance?, props: { [string]: any }?, color: Color3?)
	local back = Kit.frame(parent, { Size = UDim2.new(1, 0, 0, 8), BackgroundColor3 = Theme.bg })
	Kit.corner(back, UDim.new(1, 0))
	apply(back, props)
	local fill = Kit.frame(back, { Size = UDim2.fromScale(0, 1), BackgroundColor3 = color or Theme.accent })
	Kit.corner(fill, UDim.new(1, 0))
	return {
		frame = back,
		fill = fill,
		set = function(_, f: number, animate: boolean?)
			local size = UDim2.fromScale(math.clamp(f, 0, 1), 1)
			if animate then
				Kit.tween(fill, { Size = size }, 0.25)
			else
				fill.Size = size
			end
		end,
	}
end

function Kit.input(parent: Instance?, placeholder: string, props: { [string]: any }?): TextBox
	local t = Instance.new("TextBox")
	t.BackgroundColor3 = Theme.bg
	t.TextColor3 = Theme.text
	t.PlaceholderText = placeholder
	t.PlaceholderColor3 = Theme.dim
	t.FontFace = Theme.font
	t.TextSize = 16
	t.Text = ""
	t.ClearTextOnFocus = false
	t.Size = UDim2.new(1, 0, 0, 34)
	t.TextXAlignment = Enum.TextXAlignment.Left
	Kit.corner(t, Theme.radiusSmall)
	local p = Instance.new("UIPadding")
	p.PaddingLeft = UDim.new(0, 10)
	p.Parent = t
	apply(t, props)
	t.Parent = parent
	return t
end

-- Tabs: a row of buttons; onSelect(id) when changed. Returns { bar, select(id) }.
function Kit.tabs(parent: Instance, tabs: { { id: string, text: string } }, onSelect: (string) -> (), props: { [string]: any }?)
	local bar = Kit.frame(parent, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 34) })
	apply(bar, props)
	Kit.listLayout(bar, 6, true)
	local buttons = {}
	local api = {}
	function api.select(id: string)
		for tid, b in buttons do
			local on = tid == id
			Kit.setColor(b, if on then Theme.accent else Theme.card)
			b.TextColor3 = if on then Color3.new(1, 1, 1) else Theme.dim
		end
		onSelect(id)
	end
	for i, t in tabs do
		local b = Kit.button(bar, t.text, function()
			api.select(t.id)
		end, { Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X, LayoutOrder = i, TextSize = 15 })
		local pad = Instance.new("UIPadding")
		pad.PaddingLeft, pad.PaddingRight = UDim.new(0, 12), UDim.new(0, 12)
		pad.Parent = b
		buttons[t.id] = b
	end
	api.bar = bar
	api.buttons = buttons
	return api
end

-- Vertical tab list (store categories). Returns { frame, select(id), buttons }.
function Kit.sidebar(parent: Instance, tabs: { { id: string, text: string } }, onSelect: (string) -> (), props: { [string]: any }?)
	local bar = Kit.list(parent, { Size = UDim2.new(0, 190, 1, 0) }, 4)
	apply(bar, props)
	local buttons = {}
	local api = { frame = bar, buttons = buttons }
	function api.select(id: string)
		for tid, b in buttons do
			local on = tid == id
			Kit.setColor(b, if on then Theme.accent else Theme.card)
			b.TextColor3 = if on then Color3.new(1, 1, 1) else Theme.text
		end
		onSelect(id)
	end
	for i, t in tabs do
		local b = Kit.button(bar, t.text, function()
			api.select(t.id)
		end, { Size = UDim2.new(1, 0, 0, 36), LayoutOrder = i, TextSize = 15, TextXAlignment = Enum.TextXAlignment.Left })
		local pad = Instance.new("UIPadding")
		pad.PaddingLeft = UDim.new(0, 10)
		pad.Parent = b
		buttons[t.id] = b
	end
	return api
end

----------------------------------------------------------------------------------------------------
-- Windows: one centred modal window at a time
----------------------------------------------------------------------------------------------------
local current = nil
Kit.windowChanged = Instance.new("BindableEvent")

function Kit.window(gui: ScreenGui, title: string, size: Vector2?, onClose: (() -> ())?)
	if current then
		current.close(true)
	end
	local w = size or Vector2.new(760, 520)
	local root = Kit.panel(gui, {
		Name = "Window",
		Size = UDim2.fromOffset(w.X, w.Y),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = Theme.panel,
		BackgroundTransparency = 0,
	})
	local header = Kit.frame(root, { Name = "Header", Size = UDim2.new(1, 0, 0, 48), BackgroundTransparency = 1 })
	local titleLabel = Kit.label(header, title, { Name = "Title", Size = UDim2.new(1, -70, 1, 0), Position = UDim2.fromOffset(16, 0), FontFace = Theme.heavy, TextSize = 22, TextWrapped = false, TextTruncate = Enum.TextTruncate.AtEnd })
	local api = { root = root, header = header }
	local closeBtn = Kit.button(header, "✕", function()
		api.close()
	end, { Size = UDim2.fromOffset(36, 36), Position = UDim2.new(1, -44, 0, 6), TextSize = 18 })
	closeBtn.Name = "Close"
	local content = Kit.frame(root, { Name = "Content", BackgroundTransparency = 1, Size = UDim2.new(1, -24, 1, -60), Position = UDim2.fromOffset(12, 50) })
	api.content = content
	local closed = false
	function api.close(silent: boolean?)
		if closed then
			return
		end
		closed = true
		if current == api then
			current = nil
		end
		root:Destroy()
		if onClose then
			onClose()
		end
		if not silent then
			Kit.windowChanged:Fire(nil)
		end
	end
	function api.setTitle(t: string)
		titleLabel.Text = t
	end
	function api.isOpen(): boolean
		return not closed
	end
	current = api
	-- pop-in
	local scale = Instance.new("UIScale")
	scale.Scale = 0.92
	scale.Parent = root
	Kit.tween(scale, { Scale = 1 }, 0.16, Enum.EasingStyle.Back)
	Kit.windowChanged:Fire(api)
	return api
end

function Kit.closeWindow()
	if current then
		current.close()
	end
end

function Kit.currentWindow()
	return current
end

-- A card row: icon, title, subtitle, right side area (rightWidth px, default 220). Returns the
-- frame and its right container.
function Kit.row(parent: Instance, icon: string, title: string, sub: string?, props: { [string]: any }?, rightWidth: number?)
	local rw = rightWidth or 220
	local f = Kit.panel(parent, { Size = UDim2.new(1, 0, 0, 58), BackgroundColor3 = Theme.card })
	Kit.outline(f, Theme.line, 1, 0.6)
	apply(f, props)
	Kit.label(f, icon, { Size = UDim2.fromOffset(40, 40), Position = UDim2.fromOffset(10, 9), TextSize = 26, TextXAlignment = Enum.TextXAlignment.Center })
	Kit.label(f, title, { Name = "Title", Size = UDim2.new(1, -(rw + 20 + 58), 0, 22), Position = UDim2.fromOffset(58, 8), FontFace = Theme.bold, TextSize = 16, TextWrapped = false, TextTruncate = Enum.TextTruncate.AtEnd })
	if sub then
		Kit.label(f, sub, { Name = "Sub", Size = UDim2.new(1, -(rw + 20 + 58), 0, 20), Position = UDim2.fromOffset(58, 30), TextColor3 = Theme.dim, TextSize = 14, TextWrapped = false, TextTruncate = Enum.TextTruncate.AtEnd })
	end
	local right = Kit.frame(f, { Name = "Right", BackgroundTransparency = 1, Size = UDim2.new(0, rw, 1, -16), Position = UDim2.new(1, -(rw + 8), 0, 8) })
	Kit.listLayout(right, 6, true, Enum.HorizontalAlignment.Right)
	return f, right
end

return Kit
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="2083">
            <Properties>
              <string name="Name">Phone</string>
              <string name="Source"><![CDATA[-- Phone (P): apps for everything you can do from anywhere — your shop, team, garage, jobs,
-- inventory, the map, the daily reward, stats, reviews, settings and help.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)

local UI = script.Parent
local Kit = require(UI.Kit)
local Theme = require(UI.Theme)
local Hud = require(UI.Hud)
local App = require(UI.App)
local ShopPanel = require(UI.ShopPanel)
local StaffPanel = require(UI.StaffPanel)
local Garage = require(UI.Garage)
local JobsPanel = require(UI.JobsPanel)
local Inventory = require(UI.Inventory)
local QuestsPanel = require(UI.QuestsPanel)
local S = require(UI.Parent.Strings)
local State = require(UI.Parent.State)

local Phone = {}

local win = nil
local actions: { [string]: () -> () } = {}

local function page(title: string, build: (Frame) -> ())
	local w = Kit.window(App.screen :: ScreenGui, "📱 " .. title, Vector2.new(460, 620))
	Kit.button(w.header, "←", function()
		Phone.open()
	end, { Size = UDim2.fromOffset(36, 36), Position = UDim2.new(1, -86, 0, 6), TextSize = 18 })
	local body = Kit.frame(w.content, { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1) })
	build(body)
	win = w
end

local function statsPage(body: Frame)
	local d = State.data
	if not d then
		return
	end
	local list = Kit.list(body)
	local st = d.stats
	local lines = {
		"⭐ " .. S.t("level") .. " " .. d.level .. "   •   ★ " .. math.floor(d.rep),
		"🔧 " .. S.t("stat_repairs", { n = st.repairs }),
		"💎 " .. S.t("stat_perfect", { n = st.perfect }),
		"❌ " .. S.t("stat_failed", { n = st.failed }),
		"👥 " .. S.t("stat_customers", { n = st.customers }),
		"💰 " .. S.t("stat_earned", { n = S.money(st.earned) }),
		"🚨 " .. S.t("stat_caught", { n = st.caught }),
	}
	for i, l in lines do
		local f = Kit.panel(list, { Size = UDim2.new(1, 0, 0, 44), BackgroundColor3 = Theme.card, LayoutOrder = i })
		Kit.label(f, l, { Size = UDim2.new(1, -20, 1, 0), Position = UDim2.fromOffset(12, 0), TextSize = 17 })
	end
end

local function reviewsPage(body: Frame)
	local list = Kit.list(body, nil, 8)
	local reviews = State.data and State.data.reviews or {}
	for i, r in reviews do
		local f = Kit.panel(list, { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = Theme.card, LayoutOrder = i })
		Kit.padding(f, 10)
		Kit.listLayout(f, 2)
		Kit.label(f, "<b>" .. (r.w or "?") .. "</b>  " .. S.stars(r.s or 0), { TextColor3 = Theme.warn, LayoutOrder = 1 })
		Kit.label(f, r.t or "", { TextSize = 14, LayoutOrder = 2, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y })
	end
	if #reviews == 0 then
		Kit.label(list, S.t("reviews_none"), { TextColor3 = Theme.dim, Size = UDim2.new(1, 0, 0, 40) })
	end
end

local function slider(parent: Instance, label: string, value: number, order: number, onSet: (number) -> ())
	local row = Kit.frame(parent, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 56), LayoutOrder = order })
	Kit.label(row, label, { Size = UDim2.new(1, 0, 0, 20) })
	local steps = Kit.frame(row, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 30), Position = UDim2.fromOffset(0, 24) })
	Kit.listLayout(steps, 4, true)
	local buttons = {}
	local function paint(v: number)
		for i, b in buttons do
			Kit.setColor(b, if (i - 1) / 10 <= v + 1e-3 then Theme.accent else Theme.card)
		end
	end
	for i = 0, 10 do
		local b = Kit.button(steps, "", function()
			paint(i / 10)
			onSet(i / 10)
		end, { Size = UDim2.fromOffset(32, 28), LayoutOrder = i })
		buttons[i + 1] = b
	end
	paint(value)
end

local function settingsPage(body: Frame)
	Kit.listLayout(body, 12)
	Kit.label(body, S.t("settings_lang"), { FontFace = Theme.bold, LayoutOrder = 1 })
	local langs = Kit.frame(body, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 40), LayoutOrder = 2 })
	Kit.listLayout(langs, 8, true)
	for i, l in { { "tr", "🇹🇷 Türkçe" }, { "en", "🇬🇧 English" } } do
		Kit.button(langs, l[2], function()
			S.setLang(l[1])
			Net.request("settings.set", { lang = l[1] })
			if actions.relabel then
				actions.relabel()
			end
			Phone.open()
		end, { Size = UDim2.fromOffset(170, 38), LayoutOrder = i }, if S.lang() == l[1] then "primary" else nil)
	end
	local settings = State.data and State.data.settings or { music = 0.5, sfx = 0.8 }
	slider(body, "🎵 " .. S.t("settings_music"), settings.music or 0.5, 3, function(v)
		Net.request("settings.set", { music = v })
	end)
	slider(body, "🔊 " .. S.t("settings_sfx"), settings.sfx or 0.8, 4, function(v)
		Net.request("settings.set", { sfx = v })
	end)
end

local function helpPage(body: Frame)
	local list = Kit.list(body)
	Kit.label(list, S.t("help_text"), { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextSize = 16 })
end

local function claimDaily()
	local r = Net.request("daily.claim")
	if r.ok then
		Hud.toast(S.t("daily_claimed", { amount = S.money(r.reward), streak = r.streak }), "good", 6)
		Hud.banner("🎁 " .. S.money(r.reward))
	else
		App.report(r)
	end
end

function Phone.open()
	local w = Kit.window(App.screen :: ScreenGui, "📱 " .. S.t("phone"), Vector2.new(460, 620))
	win = w
	local c = w.content
	local t = Lighting.ClockTime
	Kit.label(c, string.format("🕒 %02d:%02d", math.floor(t), math.floor((t % 1) * 60)), { Size = UDim2.new(1, 0, 0, 24), TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = Theme.dim })
	local grid = Kit.grid(c, UDim2.fromOffset(128, 112), { Size = UDim2.new(1, 0, 1, -30), Position = UDim2.fromOffset(0, 30) })
	local apps = {
		{ "🏪", S.t("phone_shop"), function()
			ShopPanel.open()
		end },
		{ "🧑‍🔧", S.t("phone_staff"), StaffPanel.team },
		{ "🚗", S.t("phone_garage"), Garage.open },
		{ "📋", S.t("jobs"), JobsPanel.open },
		{ "🎒", S.t("inventory"), function()
			Inventory.open()
		end },
		{ "🗺️", S.t("map"), function()
			w.close()
			if actions.map then
				actions.map()
			end
		end },
		{ "🎁", S.t("phone_daily"), claimDaily },
		{ "📜", S.t("phone_quests"), QuestsPanel.open },
		{ "📊", S.t("phone_stats"), function()
			page(S.t("phone_stats"), statsPage)
		end },
		{ "⭐", S.t("phone_reviews"), function()
			page(S.t("phone_reviews"), reviewsPage)
		end },
		{ "⚙️", S.t("phone_settings"), function()
			page(S.t("phone_settings"), settingsPage)
		end },
		{ "❓", S.t("phone_help"), function()
			page(S.t("phone_help"), helpPage)
		end },
		{ "🏠", S.t("home"), function()
			w.close()
			if actions.home then
				actions.home()
			end
		end },
	}
	for i, a in apps do
		local b = Kit.button(grid, "", a[3], { LayoutOrder = i, BackgroundColor3 = Theme.card })
		Kit.label(b, a[1], { Size = UDim2.new(1, 0, 0, 52), Position = UDim2.fromOffset(0, 10), TextSize = 40, TextXAlignment = Enum.TextXAlignment.Center })
		Kit.label(b, a[2], { Size = UDim2.new(1, -8, 0, 36), Position = UDim2.fromOffset(4, 66), TextSize = 14, FontFace = Theme.bold, TextXAlignment = Enum.TextXAlignment.Center })
	end
end

function Phone.toggle()
	if win and win.isOpen() then
		win.close()
	else
		Phone.open()
	end
end

-- actions: map, home, relabel (rebuild text after a language change)
function Phone.init(a: { [string]: () -> () })
	actions = a
end

return Phone
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="2084">
            <Properties>
              <string name="Name">QuestsPanel</string>
              <string name="Source"><![CDATA[-- QuestsPanel: today's three tasks with progress and rewards (city hall board and phone).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Quests = require(Shared.Data.Quests)

local UI = script.Parent
local Kit = require(UI.Kit)
local Theme = require(UI.Theme)
local Hud = require(UI.Hud)
local App = require(UI.App)
local S = require(UI.Parent.Strings)
local State = require(UI.Parent.State)

local QuestsPanel = {}

-- Fills `parent` with the task list; returns a function that refreshes it.
function QuestsPanel.render(parent: Instance)
	local list = Kit.list(parent, { Size = UDim2.new(1, 0, 1, -24) }, 8)
	Kit.label(parent, S.t("quest_new"), { Size = UDim2.new(1, 0, 0, 20), Position = UDim2.new(0, 0, 1, -20), TextColor3 = Theme.dim, TextSize = 13 })
	local function fill()
		Kit.clear(list)
		local qs = State.data and State.data.quests
		for i, q in qs and qs.list or {} do
			local def = Quests.get(q.id)
			if def then
				local goalText = if def.money then S.money(q.goal) else tostring(q.goal)
				local progress = if def.money then S.money(q.n) .. " / " .. S.money(q.goal) else q.n .. " / " .. q.goal
				local title = string.gsub(S.pick(def.name), "{n}", goalText)
				local f, right = Kit.row(list, def.icon, title, progress .. "   •   " .. S.t("quest_reward", { reward = S.money(q.reward), xp = q.xp }), { LayoutOrder = i, Size = UDim2.new(1, 0, 0, 66) }, 150)
				local bar = Kit.progress(f, { Size = UDim2.new(1, -236, 0, 5), Position = UDim2.fromOffset(58, 54) }, if q.n >= q.goal then Theme.good else Theme.accent)
				bar:set(q.n / math.max(1, q.goal))
				if q.claimed then
					Kit.pill(right, "✔ " .. S.t("quest_claimed"), Theme.good)
				elseif q.n >= q.goal then
					Kit.button(right, "🎁 " .. S.t("quest_claim"), function()
						local r = Net.request("quests.claim", { i = i })
						if r.ok then
							Hud.toast("🎁 +" .. S.money(r.reward or q.reward), "good")
						else
							App.report(r)
						end
					end, { Size = UDim2.fromOffset(140, 38) }, "good")
				else
					Kit.pill(right, math.floor(q.n / math.max(1, q.goal) * 100) .. "%", Theme.card)
				end
			end
		end
		if not qs or #qs.list == 0 then
			Kit.label(list, S.t("empty"), { TextColor3 = Theme.dim, Size = UDim2.new(1, 0, 0, 40) })
		end
	end
	fill()
	return fill
end

function QuestsPanel.open()
	local conn
	local win = Kit.window(App.screen :: ScreenGui, "📜 " .. S.t("quests_title"), Vector2.new(720, 420), function()
		if conn then
			conn:Disconnect()
		end
	end)
	local refresh = QuestsPanel.render(win.content)
	conn = State.changed:Connect(refresh)
end

return QuestsPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="2085">
            <Properties>
              <string name="Name">ShopPanel</string>
              <string name="Source"><![CDATA[-- ShopPanel: your shop. Expand to the next level, buy furniture and equipment, change the look
-- (walls, floor, accent colour) and the name on the sign. Opened from the phone or the estate agent.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Upgrades = require(Shared.Data.Upgrades)

local UI = script.Parent
local Kit = require(UI.Kit)
local Theme = require(UI.Theme)
local Hud = require(UI.Hud)
local App = require(UI.App)
local S = require(UI.Parent.Strings)
local State = require(UI.Parent.State)

local ShopPanel = {}

local function rgb(t): Color3
	return Color3.fromRGB(t[1], t[2], t[3])
end

local function levelLine(l): string
	return S.t("shop_benches", { n = l.benches, q = l.queue, s = l.seats, st = l.staff }) .. " • 📦 " .. l.storage
end

local function upgradePage(page: Frame)
	local list = Kit.list(page)
	local function fill()
		Kit.clear(list)
		local d = State.data
		if not d then
			return
		end
		local cur = d.shop.level
		for i, l in Upgrades.levels do
			local f, right = Kit.row(list, if i < cur then "✅" elseif i == cur then "🏪" else "🔒", S.pick(l.name) .. " (" .. S.t("level") .. " " .. i .. ")", levelLine(l), { LayoutOrder = i })
			if i == cur then
				Kit.outline(f, Theme.accent, 2, 0)
				Kit.pill(right, S.t("owned"), Theme.accent)
			elseif i == cur + 1 then
				local locked = d.level < l.req
				local b = Kit.button(right, if locked then S.t("needs_level", { n = l.req }) else S.money(l.cost), function()
					local r = Net.request("shop.upgrade")
					if r.ok then
						Hud.banner("🏗️ " .. S.pick(l.name))
					else
						App.report(r)
					end
				end, { Size = UDim2.fromOffset(150, 36), TextSize = if locked then 13 else 16 }, "good")
				Kit.setEnabled(b, not locked and d.money >= l.cost)
			elseif i > cur then
				Kit.label(right, S.money(l.cost), { Size = UDim2.fromOffset(110, 36), TextColor3 = Theme.dim, TextXAlignment = Enum.TextXAlignment.Right })
			end
		end
	end
	fill()
	return fill
end

local function itemsPage(page: Frame)
	local area = Kit.frame(page, { BackgroundTransparency = 1, Size = UDim2.new(1, -200, 1, 0), Position = UDim2.fromOffset(200, 0) })
	local list = Kit.list(area)
	local selected = Upgrades.categories[1].id
	local function fill()
		Kit.clear(list)
		local d = State.data
		if not d then
			return
		end
		local n = 0
		for _, it in Upgrades.items do
			if it.cat == selected then
				n += 1
				local perks = {}
				if it.comfort then
					table.insert(perks, "😊 +" .. it.comfort)
				end
				if it.attract then
					table.insert(perks, "👥 +" .. it.attract .. "%")
				end
				if it.security then
					table.insert(perks, "🛡️ +" .. it.security)
				end
				if it.speed then
					table.insert(perks, "⚡ +" .. math.floor(it.speed * 100) .. "%")
				end
				if it.storage then
					table.insert(perks, "📦 +" .. it.storage)
				end
				local sub = table.concat(perks, "  ") .. (if it.desc then "  " .. S.pick(it.desc) else "")
				local _, right = Kit.row(list, it.icon or "🛒", S.pick(it.name), sub, { LayoutOrder = n })
				if d.shop.items[it.id] then
					Kit.pill(right, "✔ " .. S.t("owned"), Theme.good)
				else
					local locked = d.level < (it.level or 1)
					local b = Kit.button(right, if locked then S.t("needs_level", { n = it.level }) else S.money(it.cost), function()
						local r = Net.request("shop.buyItem", { id = it.id })
						App.report(r, S.t("bought", { name = S.pick(it.name) }))
					end, { Size = UDim2.fromOffset(140, 36), TextSize = if locked then 13 else 16 }, "primary")
					Kit.setEnabled(b, not locked and d.money >= it.cost)
				end
			end
		end
	end
	local tabs = {}
	for _, c in Upgrades.categories do
		table.insert(tabs, { id = c.id, text = S.pick(c.name) })
	end
	local side = Kit.sidebar(page, tabs, function(id)
		selected = id
		fill()
	end)
	side.select(selected)
	return fill
end

local function looksPage(page: Frame)
	local list = Kit.list(page, nil, 10)
	local function swatches(title: string, order: number, entries, isCurrent: (any) -> boolean, onPick: (any, number) -> ())
		Kit.label(list, title, { FontFace = Theme.bold, LayoutOrder = order, Size = UDim2.new(1, 0, 0, 22) })
		local row = Kit.frame(list, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = order + 1 })
		local grid = Instance.new("UIGridLayout")
		grid.CellSize = UDim2.fromOffset(120, 64)
		grid.CellPadding = UDim2.fromOffset(8, 8)
		grid.SortOrder = Enum.SortOrder.LayoutOrder
		grid.Parent = row
		for i, e in entries do
			local color = if e.color then rgb(e.color) else rgb(e)
			local b = Kit.button(row, if e.name then S.pick(e.name) else "", function()
				onPick(e, i)
			end, { LayoutOrder = i, TextSize = 13, TextYAlignment = Enum.TextYAlignment.Bottom, TextStrokeTransparency = 0.4 })
			Kit.setColor(b, color)
			if isCurrent(e) or isCurrent(i) then
				Kit.outline(b, Theme.accent, 3, 0)
			end
		end
	end
	local function fill()
		Kit.clear(list)
		local shop = State.data and State.data.shop
		if not shop then
			return
		end
		swatches("🧱 " .. S.t("wall"), 1, Upgrades.wallStyles, function(e)
			return type(e) == "table" and e.id == shop.wall
		end, function(e)
			App.report(Net.request("shop.style", { wall = e.id }))
		end)
		swatches("🟫 " .. S.t("floor"), 3, Upgrades.floorStyles, function(e)
			return type(e) == "table" and e.id == shop.floor
		end, function(e)
			App.report(Net.request("shop.style", { floor = e.id }))
		end)
		swatches("🎨 " .. S.t("accent"), 5, Upgrades.accentColors, function(e)
			return e == shop.accent
		end, function(_, i)
			App.report(Net.request("shop.style", { accent = i }))
		end)
	end
	fill()
	return fill
end

local function namePage(page: Frame)
	Kit.listLayout(page, 10)
	Kit.label(page, S.t("shop_rename"), { FontFace = Theme.bold, LayoutOrder = 1 })
	local box = Kit.input(page, "PC Usta", { LayoutOrder = 2, Size = UDim2.new(0, 420, 0, 38) })
	box.Text = State.data and State.data.shop.name or ""
	Kit.button(page, S.t("confirm"), function()
		local name = string.sub(box.Text, 1, 28)
		if #name == 0 then
			return
		end
		App.report(Net.request("shop.rename", name), "✔ " .. name)
	end, { LayoutOrder = 3 }, "primary")
	return function() end
end

-- opts: { freePlots = n?, onClose = fn? }
function ShopPanel.open(opts: { [string]: any }?)
	local o = opts or {}
	local conn
	local win = Kit.window(App.screen :: ScreenGui, "🏪 " .. S.t("shop"), Vector2.new(900, 600), function()
		if conn then
			conn:Disconnect()
		end
		if o.onClose then
			o.onClose()
		end
	end)
	local c = win.content
	local d = State.data
	local lvl = d and Upgrades.level(d.shop.level)
	local head = (if lvl then S.t("shop_level", { name = S.pick(lvl.name), n = d.shop.level }) else "")
	if o.freePlots then
		head ..= "   •   🔑 " .. S.t("free_plots", { n = o.freePlots })
	end
	Kit.label(c, head, { Size = UDim2.new(1, 0, 0, 24), TextColor3 = Theme.dim, TextSize = 14 })
	local bottom = if o.freePlots then 22 else 0
	local area = Kit.frame(c, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, -74 - bottom), Position = UDim2.fromOffset(0, 72) })
	local pages, fills = {}, {}
	local builders = { upgrade = upgradePage, items = itemsPage, looks = looksPage, name = namePage }
	local current = "upgrade"
	local tabs = Kit.tabs(c, {
		{ id = "upgrade", text = "🏗️ " .. S.t("shop_expand_tab") },
		{ id = "items", text = "🛋️ " .. S.t("shop_items") },
		{ id = "looks", text = "🎨 " .. S.t("shop_looks") },
		{ id = "name", text = "🪧 " .. S.t("shop_rename") },
	}, function(id)
		current = id
		for k, f in pages do
			f.Visible = k == id
		end
		if not pages[id] then
			local f = Kit.frame(area, { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1) })
			pages[id] = f
			fills[id] = builders[id](f)
		end
	end, { Position = UDim2.fromOffset(0, 30) })
	tabs.select("upgrade")
	if o.freePlots then
		Kit.label(c, S.t("store_realty_hint"), { Size = UDim2.new(1, 0, 0, 20), Position = UDim2.new(0, 0, 1, -18), TextColor3 = Theme.dim, TextSize = 13 })
	end
	conn = State.changed:Connect(function()
		if current ~= "name" and fills[current] then
			fills[current]()
		end
	end)
end

return ShopPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="2086">
            <Properties>
              <string name="Name">StaffPanel</string>
              <string name="Source"><![CDATA[-- StaffPanel: the staff agency (candidates to hire) and your team (wages, dismissing).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Employees = require(Shared.Data.Employees)
local Upgrades = require(Shared.Data.Upgrades)

local UI = script.Parent
local Kit = require(UI.Kit)
local Theme = require(UI.Theme)
local App = require(UI.App)
local S = require(UI.Parent.Strings)
local State = require(UI.Parent.State)

local StaffPanel = {}

local function traitText(id: string?): string
	local t = id and Employees.traitById[id]
	return if t then S.pick(t.name) else ""
end

local function personSub(e): string
	return string.format("%s  •  %s  •  %s", S.stars(e.skill or 1), traitText(e.trait), S.t("staff_wage", { wage = S.money(e.wage or 0) }))
end

local function teamList(list: ScrollingFrame)
	Kit.clear(list)
	local staff = State.data and State.data.staff or {}
	for i, e in staff do
		local role = Employees.roles[e.role]
		local _, right = Kit.row(list, role and role.icon or "🧑", e.name .. "  —  " .. (role and S.pick(role.name) or e.role), personSub(e), { LayoutOrder = i })
		Kit.button(right, S.t("staff_fire"), function()
			local r = Net.request("staff.fire", { uid = e.uid })
			App.report(r, S.t("staff_fired", { name = e.name }))
		end, { Size = UDim2.fromOffset(100, 36) }, "bad")
	end
	if #staff == 0 then
		Kit.label(list, S.t("staff_none"), { TextColor3 = Theme.dim, Size = UDim2.new(1, 0, 0, 40) })
	end
end

local function capacityText(): string
	local d = State.data
	if not d then
		return ""
	end
	local lvl = Upgrades.level(d.shop.level)
	return S.t("staff_capacity", { n = #d.staff, m = lvl.staff })
end

-- The agency: candidates on the right, your team on the left.
function StaffPanel.agency(payload)
	local conn
	local win = Kit.window(App.screen :: ScreenGui, "🧑‍💼 " .. S.t("staff"), Vector2.new(980, 600), function()
		if conn then
			conn:Disconnect()
		end
	end)
	local c = win.content
	local info = Kit.label(c, capacityText(), { Size = UDim2.new(0.5, 0, 0, 24), FontFace = Theme.bold })
	Kit.button(c, "🔄 " .. S.t("staff_refresh"), function()
		App.report(Net.request("staff.refresh"))
	end, { Size = UDim2.fromOffset(220, 32), Position = UDim2.new(1, -220, 0, -4) }, "ghost")

	Kit.label(c, S.t("staff_yours"), { Size = UDim2.new(0.4, 0, 0, 22), Position = UDim2.fromOffset(0, 34), TextColor3 = Theme.dim })
	local team = Kit.list(c, { Size = UDim2.new(0.4, -8, 1, -62), Position = UDim2.fromOffset(0, 60) })
	Kit.label(c, S.t("staff_candidates"), { Size = UDim2.new(0.6, 0, 0, 22), Position = UDim2.new(0.4, 8, 0, 34), TextColor3 = Theme.dim })
	local cands = Kit.list(c, { Size = UDim2.new(0.6, -8, 1, -62), Position = UDim2.new(0.4, 8, 0, 60) }, 8)

	local function fillCandidates()
		Kit.clear(cands)
		local d = State.data
		local hiredFrom = {}
		for _, e in d and d.staff or {} do
			if e.from then
				hiredFrom[e.from] = true
			end
		end
		for i, cand in payload.candidates or {} do
			if not hiredFrom[cand.uid] then
				local role = Employees.roles[cand.role]
				local f = Kit.panel(cands, { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = Theme.card, LayoutOrder = i })
				Kit.padding(f, 10)
				local inner = Kit.frame(f, { BackgroundTransparency = 1, Size = UDim2.new(1, -160, 0, 0), AutomaticSize = Enum.AutomaticSize.Y })
				Kit.listLayout(inner, 2)
				Kit.label(inner, (role and role.icon or "🧑") .. " <b>" .. cand.name .. "</b>  —  " .. (role and S.pick(role.name) or cand.role), { LayoutOrder = 1, Size = UDim2.new(1, 0, 0, 22) })
				Kit.label(inner, personSub(cand), { LayoutOrder = 2, TextColor3 = Theme.warn, TextSize = 14 })
				if role then
					Kit.label(inner, S.pick(role.desc), { LayoutOrder = 3, TextColor3 = Theme.dim, TextSize = 13, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y })
				end
				local shopOk = not role or not d or d.shop.level >= (role.minShop or 1)
				local b = Kit.button(f, if shopOk then S.t("staff_hire", { price = S.money(cand.hireCost) }) else S.t("staff_needs_shop", { n = role.minShop }), function()
					local r = Net.request("staff.hire", { uid = cand.uid })
					App.report(r, S.t("staff_hired", { name = cand.name }))
				end, { Size = UDim2.fromOffset(150, 38), Position = UDim2.new(1, -150, 0, 4), TextSize = if shopOk then 15 else 13 }, "good")
				Kit.setEnabled(b, shopOk and (d ~= nil and d.money >= cand.hireCost))
			end
		end
	end
	local function fill()
		info.Text = capacityText()
		teamList(team)
		fillCandidates()
	end
	fill()
	conn = State.changed:Connect(fill)
end

-- Your team only (from the phone).
function StaffPanel.team()
	local conn
	local win = Kit.window(App.screen :: ScreenGui, "🧑‍🔧 " .. S.t("phone_staff"), Vector2.new(640, 520), function()
		if conn then
			conn:Disconnect()
		end
	end)
	local info = Kit.label(win.content, capacityText(), { Size = UDim2.new(1, 0, 0, 24), FontFace = Theme.bold })
	local list = Kit.list(win.content, { Size = UDim2.new(1, 0, 1, -30), Position = UDim2.fromOffset(0, 28) })
	local function fill()
		info.Text = capacityText()
		teamList(list)
	end
	fill()
	conn = State.changed:Connect(fill)
end

function StaffPanel.init()
	Net.on("staff.open", StaffPanel.agency)
end

return StaffPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="2087">
            <Properties>
              <string name="Name">Stores</string>
              <string name="Source"><![CDATA[-- Stores: the city's counters. One window per service:
--   parts / parts_bazaar  new parts by category (+ daily deals, search)
--   used                  second-hand listings and selling your parts
--   scrap                 junk PCs to strip, and scrap prices for anything
--   tools                 the hardware shop
--   realty                your shop panel and how to move
--   board                 the city leaderboard
--   police                your thief-catching record

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Parts = require(Shared.Data.Parts)
local Tools = require(Shared.Data.Tools)
local Market = require(Shared.Economy.Market)

local UI = script.Parent
local Kit = require(UI.Kit)
local Theme = require(UI.Theme)
local Hud = require(UI.Hud)
local App = require(UI.App)
local ShopPanel = require(UI.ShopPanel)
local QuestsPanel = require(UI.QuestsPanel)
local S = require(UI.Parent.Strings)
local State = require(UI.Parent.State)

local Stores = {}

local MAX_ROWS = 80

-- Opens a window that tells the server we left the counter when it closes, and drops its
-- state listeners.
local function storeWindow(title: string, size: Vector2?)
	local conns = {}
	local win
	win = Kit.window(App.screen :: ScreenGui, title, size or Vector2.new(900, 590), function()
		for _, c in conns do
			c:Disconnect()
		end
		task.spawn(Net.request, "market.close")
	end)
	win.conns = conns
	return win
end

local function storageText(): string
	local d = State.data
	if not d then
		return ""
	end
	return "📦 " .. S.t("storage", { n = #d.inv, m = d.capacity or 0 })
end

local function partSub(p, extra: string?): string
	local spec = Parts.spec(p, S.lang())
	if extra and #extra > 0 then
		return extra .. (if #spec > 0 then " • " .. spec else "")
	end
	return spec
end

local function condText(item): string
	if item.cond and item.cond < 0.999 then
		return S.t("cond", { n = math.floor(item.cond * 100) })
	end
	return S.t("cond_new")
end

-- Buy buttons grey out while you can't afford them.
local function moneyGate(win, buttons: { { b: TextButton, price: number } })
	local function update()
		local m = State.money()
		for _, e in buttons do
			if e.b.Parent and not e.b:GetAttribute("Done") then
				Kit.setEnabled(e.b, m >= e.price)
			end
		end
	end
	update()
	table.insert(win.conns, State.changed:Connect(update))
	return update
end

----------------------------------------------------------------------------------------------------
-- New parts
----------------------------------------------------------------------------------------------------
local function partsStore(o)
	local bazaar = o.service == "parts_bazaar"
	local win = storeWindow((if bazaar then "🔌 " .. S.t("store_bazaar") else "🏬 " .. S.t("store_parts")), Vector2.new(940, 600))
	local c = win.content
	local info = Kit.label(c, "", { Size = UDim2.new(1, -270, 0, 24), TextColor3 = Theme.dim, TextSize = 14 })
	local search = Kit.input(c, "🔍 " .. S.t("search"), { Size = UDim2.fromOffset(250, 30), Position = UDim2.new(1, -250, 0, -3) })
	local function refreshInfo()
		info.Text = Kit.esc(storageText() .. (if bazaar then "   •   " .. S.t("store_bazaar_hint") else ""))
	end
	refreshInfo()
	table.insert(win.conns, State.changed:Connect(refreshInfo))

	local byCat, deals = {}, {}
	for _, e in o.data.catalog or {} do
		local p = Parts.get(e.id)
		if p then
			local entry = { p = p, price = e.price, deal = e.deal }
			byCat[p.cat] = byCat[p.cat] or {}
			table.insert(byCat[p.cat], entry)
			if e.deal then
				table.insert(deals, entry)
			end
		end
	end
	local tabs = {}
	if #deals > 0 then
		table.insert(tabs, { id = "deals", text = "🔥 " .. S.t("deal") })
	end
	for _, cat in Parts.Categories do
		if byCat[cat] then
			table.insert(tabs, { id = cat, text = (Theme.catIcon[cat] or "") .. " " .. S.t("cat_" .. cat) })
		end
	end
	local list = Kit.list(c, { Size = UDim2.new(1, -200, 1, -36), Position = UDim2.fromOffset(200, 34) })
	local selected = tabs[1] and tabs[1].id or "gpu"
	local gate = {}
	local updateGate = moneyGate(win, gate)

	local function fill()
		Kit.clear(list)
		table.clear(gate)
		local q = string.lower(search.Text)
		local rows = {}
		if #q > 0 then
			for _, entries in byCat do
				for _, e in entries do
					if string.find(string.lower(e.p.name), q, 1, true) then
						table.insert(rows, e)
					end
				end
			end
		elseif selected == "deals" then
			rows = table.clone(deals)
		else
			rows = table.clone(byCat[selected] or {})
		end
		table.sort(rows, function(a, b)
			return a.price < b.price
		end)
		for i, e in rows do
			if i > MAX_ROWS then
				break
			end
			local p = e.p
			local extra = nil
			if p.uses then
				extra = S.t("stock_uses", { n = p.uses }) .. " • " .. S.t("owned") .. ": " .. State.stock(p.id)
			end
			local _, right = Kit.row(list, Theme.catIcon[p.cat] or "📦", p.name, if extra then extra else partSub(p), { LayoutOrder = i })
			if e.deal then
				Kit.pill(right, "-25%", Theme.bad, { LayoutOrder = 0 })
			end
			Kit.label(right, S.money(e.price), { Size = UDim2.fromOffset(84, 36), TextColor3 = Theme.money, FontFace = Theme.bold, TextXAlignment = Enum.TextXAlignment.Right, LayoutOrder = 1 })
			local b = Kit.button(right, S.t("buy"), function()
				local r = Net.request("market.buy", { id = p.id, qty = 1 })
				if r.ok then
					Hud.toast(if r.job then S.t("project_added") else S.t("bought", { name = p.name }), "good")
				else
					App.report(r)
				end
			end, { Size = UDim2.fromOffset(92, 36), LayoutOrder = 2 }, "primary")
			table.insert(gate, { b = b, price = e.price })
		end
		if #rows == 0 then
			Kit.label(list, S.t("empty"), { TextColor3 = Theme.dim, Size = UDim2.new(1, 0, 0, 40) })
		end
		updateGate()
	end
	local side = Kit.sidebar(c, tabs, function(id)
		selected = id
		if #search.Text > 0 then
			search.Text = ""
		end
		fill()
	end, { Position = UDim2.fromOffset(0, 34), Size = UDim2.new(0, 190, 1, -36) })
	local pending = false
	search:GetPropertyChangedSignal("Text"):Connect(function()
		if pending then
			return
		end
		pending = true
		task.delay(0.25, function()
			pending = false
			if win.isOpen() then
				fill()
			end
		end)
	end)
	side.select(selected)
end

----------------------------------------------------------------------------------------------------
-- Selling your inventory (used market and scrapyard)
----------------------------------------------------------------------------------------------------
local function sellList(win, parent: Instance, priceOf: (any) -> number)
	local list = Kit.list(parent)
	local function fill()
		Kit.clear(list)
		local items = State.data and State.data.inv or {}
		local sorted = table.clone(items)
		table.sort(sorted, function(a, b)
			return priceOf(a) > priceOf(b)
		end)
		for i, item in sorted do
			local p = Parts.get(item.part)
			if p then
				local sub = condText(item) .. (if item.broken then " • " .. S.t("broken") else "")
				local _, right = Kit.row(list, Theme.catIcon[p.cat] or "📦", p.name, sub, { LayoutOrder = i })
				local price = priceOf(item)
				Kit.button(right, S.t("sell") .. " " .. S.money(price), function()
					local r = Net.request("market.sell", { uid = item.uid })
					if r.ok then
						Hud.toast(S.t("sold", { price = S.money(r.price or price) }), "good")
					else
						App.report(r)
					end
				end, { Size = UDim2.fromOffset(150, 36) }, "warn")
			end
		end
		if #sorted == 0 then
			Kit.label(list, S.t("store_sell_none"), { TextColor3 = Theme.dim, Size = UDim2.new(1, 0, 0, 40) })
		end
	end
	fill()
	table.insert(win.conns, State.changed:Connect(function(d, prev)
		if not prev or #d.inv ~= #prev.inv then
			fill()
		end
	end))
	return list
end

-- A window with a hint line and two pages (buy / sell).
local function twoPages(win, hint: string, buyText: string, buildBuy: (Instance) -> (), buildSell: (Instance) -> ())
	local c = win.content
	Kit.label(c, hint, { Size = UDim2.new(1, 0, 0, 22), TextColor3 = Theme.dim, TextSize = 14 })
	local pages = {}
	local area = Kit.frame(c, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, -72), Position = UDim2.fromOffset(0, 70) })
	local built = {}
	local tabs = Kit.tabs(c, { { id = "buy", text = buyText }, { id = "sell", text = S.t("sell_tab") } }, function(id)
		for k, f in pages do
			f.Visible = k == id
		end
		if not built[id] then
			built[id] = true
			local f = Kit.frame(area, { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1) })
			pages[id] = f
			if id == "buy" then
				buildBuy(f)
			else
				buildSell(f)
			end
		end
	end, { Position = UDim2.fromOffset(0, 28) })
	tabs.select("buy")
end

local function usedStore(o)
	local win = storeWindow("♻️ " .. S.t("store_used"))
	twoPages(win, S.t("store_used_hint"), S.t("buy_tab"), function(page)
		local list = Kit.list(page)
		local gate = {}
		for i, l in o.data.listings or {} do
			local p = Parts.get(l.part)
			if p then
				local sub = condText(l) .. " • " .. S.t("risk", { n = l.risk }) .. " • " .. Parts.spec(p, S.lang())
				local _, right = Kit.row(list, Theme.catIcon[p.cat] or "📦", p.name, sub, { LayoutOrder = i })
				Kit.label(right, S.money(l.price), { Size = UDim2.fromOffset(80, 36), TextColor3 = Theme.money, FontFace = Theme.bold, TextXAlignment = Enum.TextXAlignment.Right })
				local b
				b = Kit.button(right, S.t("buy"), function()
					local r = Net.request("market.buyUsed", { id = l.id })
					if r.ok or r.err == "sold" then
						b:SetAttribute("Done", true)
						b.Text = S.t("sold_out")
						Kit.setEnabled(b, false)
					end
					if r.ok then
						Hud.toast(S.t("bought", { name = p.name }), "good")
					else
						App.report(r)
					end
				end, { Size = UDim2.fromOffset(110, 36) }, "primary")
				table.insert(gate, { b = b, price = l.price })
			end
		end
		moneyGate(win, gate)
	end, function(page)
		sellList(win, page, Market.sellPrice)
	end)
end

local function scrapStore(o)
	local win = storeWindow("🏗️ " .. S.t("store_scrap"))
	twoPages(win, S.t("store_scrap_hint"), "🖥️ " .. S.t("junk_pc"), function(page)
		local list = Kit.list(page)
		local gate = {}
		local looks = { beige = Color3.fromRGB(214, 200, 168), black = Color3.fromRGB(40, 40, 44), grey = Color3.fromRGB(150, 150, 156) }
		for i, j in o.data.junk or {} do
			local f, right = Kit.row(list, "🖥️", S.t("junk_pc") .. " #" .. i, S.t("junk_desc"), { LayoutOrder = i })
			local swatch = Kit.frame(f, { Size = UDim2.fromOffset(10, 40), Position = UDim2.fromOffset(4, 9), BackgroundColor3 = looks[j.look] or Theme.dim })
			Kit.corner(swatch, UDim.new(0, 4))
			Kit.label(right, S.money(j.price), { Size = UDim2.fromOffset(80, 36), TextColor3 = Theme.money, FontFace = Theme.bold, TextXAlignment = Enum.TextXAlignment.Right })
			local b
			b = Kit.button(right, S.t("buy"), function()
				local r = Net.request("market.buyJunk", { id = j.id })
				if r.ok or r.err == "sold" then
					b:SetAttribute("Done", true)
					b.Text = S.t("sold_out")
					Kit.setEnabled(b, false)
				end
				if r.ok then
					Hud.toast(S.t("project_added"), "good")
				else
					App.report(r)
				end
			end, { Size = UDim2.fromOffset(110, 36) }, "primary")
			table.insert(gate, { b = b, price = j.price })
		end
		moneyGate(win, gate)
	end, function(page)
		sellList(win, page, Market.scrapPrice)
	end)
end

----------------------------------------------------------------------------------------------------
-- Tools
----------------------------------------------------------------------------------------------------
local function toolStore()
	local win = storeWindow("🧰 " .. S.t("store_tools"), Vector2.new(860, 600))
	local c = win.content
	Kit.label(c, S.t("store_tools_hint"), { Size = UDim2.new(1, 0, 0, 22), TextColor3 = Theme.dim, TextSize = 14 })
	local list = Kit.list(c, { Size = UDim2.new(1, 0, 1, -30), Position = UDim2.fromOffset(0, 28) })
	local function fill()
		Kit.clear(list)
		local sorted = table.clone(Tools.list)
		table.sort(sorted, function(a, b)
			return (a.order or 99) < (b.order or 99)
		end)
		for i, t in sorted do
			if t.id ~= "hand" then
				local sub = S.pick(t.desc) .. (if t.bits then "  " .. S.t("bits", { list = table.concat(t.bits, ", ") }) else "")
				local _, right = Kit.row(list, t.icon, S.pick(t.name), sub, { LayoutOrder = i })
				if State.owns(t.id) then
					Kit.pill(right, "✔ " .. S.t("tool_owned"), Theme.good)
				else
					Kit.label(right, S.money(t.price), { Size = UDim2.fromOffset(80, 36), TextColor3 = Theme.money, FontFace = Theme.bold, TextXAlignment = Enum.TextXAlignment.Right })
					local locked = State.level() < (t.level or 1)
					local b = Kit.button(right, if locked then S.t("needs_level", { n = t.level }) else S.t("buy"), function()
						local r = Net.request("tools.buy", { id = t.id })
						App.report(r, S.t("bought", { name = S.pick(t.name) }))
					end, { Size = UDim2.fromOffset(if locked then 130 else 92, 36), TextSize = if locked then 13 else 16 }, "primary")
					Kit.setEnabled(b, not locked and State.money() >= t.price)
				end
			end
		end
	end
	fill()
	table.insert(win.conns, State.changed:Connect(fill))
end

----------------------------------------------------------------------------------------------------
-- Leaderboard and police
----------------------------------------------------------------------------------------------------
local function leaders(o, c: Instance)
	Kit.label(c, S.t("board_cols"), { Size = UDim2.new(1, 0, 0, 22), TextColor3 = Theme.dim, TextSize = 14 })
	local list = Kit.list(c, { Size = UDim2.new(1, 0, 1, -30), Position = UDim2.fromOffset(0, 28) })
	local me = game:GetService("Players").LocalPlayer
	for i, row in o.data.rows or {} do
		local medal = if i == 1 then "🥇" elseif i == 2 then "🥈" elseif i == 3 then "🥉" else "#" .. i
		local mine = me and row.name == me.DisplayName
		local f, right = Kit.row(list, medal, row.name .. (if mine then " " .. S.t("board_you") else ""), S.t("level") .. " " .. row.level .. " • " .. S.t("stat_repairs", { n = row.repairs }) .. " • ★ " .. row.rep, { LayoutOrder = i })
		if mine then
			Kit.outline(f, Theme.accent, 2, 0)
		end
		Kit.label(right, S.money(row.money), { Size = UDim2.fromOffset(120, 36), TextColor3 = Theme.money, FontFace = Theme.bold, TextXAlignment = Enum.TextXAlignment.Right })
	end
end

-- City hall: today's tasks and the leaderboard.
local function board(o)
	local win = storeWindow("🏛️ " .. S.t("store_board"), Vector2.new(760, 560))
	local c = win.content
	local area = Kit.frame(c, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, -44), Position = UDim2.fromOffset(0, 44) })
	local pages = {}
	local tabs = Kit.tabs(c, { { id = "quests", text = "📜 " .. S.t("quests_title") }, { id = "leaders", text = "🏆 " .. S.t("board_leaders") } }, function(id)
		for k, f in pages do
			f.Visible = k == id
		end
		if not pages[id] then
			local f = Kit.frame(area, { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1) })
			pages[id] = f
			if id == "quests" then
				local refresh = QuestsPanel.render(f)
				table.insert(win.conns, State.changed:Connect(refresh))
			else
				leaders(o, f)
			end
		end
	end)
	tabs.select("quests")
end

local function police()
	local win = storeWindow("🚓 " .. S.t("store_police"), Vector2.new(520, 300))
	local st = State.data and State.data.stats or {}
	Kit.label(win.content, S.t("store_police_text", { caught = st.caught or 0, robbed = st.robbed or 0 }), { Size = UDim2.fromScale(1, 1), TextSize = 18, TextYAlignment = Enum.TextYAlignment.Top })
end

----------------------------------------------------------------------------------------------------
function Stores.open(o)
	local service = o.service
	if service == "parts" or service == "parts_bazaar" then
		partsStore(o)
	elseif service == "used" then
		usedStore(o)
	elseif service == "scrap" then
		scrapStore(o)
	elseif service == "tools" then
		toolStore()
	elseif service == "realty" then
		ShopPanel.open({ freePlots = o.data.free and #o.data.free or 0, onClose = function()
			task.spawn(Net.request, "market.close")
		end })
	elseif service == "board" then
		board(o)
	elseif service == "police" then
		police()
	end
end

function Stores.init()
	Net.on("service.open", Stores.open)
end

return Stores
]]></string>
