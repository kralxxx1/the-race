    </Properties>
    <Item class="StarterPlayerScripts" referent="2060">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="2061">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="Folder" referent="2062">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="2063">
            <Properties>
              <string name="Name">Ambience</string>
              <string name="Source"><![CDATA[-- Ambience: everything that makes the city feel alive, done locally on each client.
--   * light mood through the day (warm mornings, golden evenings, blue nights), bloom, sun rays
--   * clouds, and rain showers with darker skies
--   * windows, street lamps and signs switching on at dusk
--   * traffic lights cycling (traffic uses Ambience.signal)
--   * the ferris wheel (cabins hang level), carousel, wind turbines, lighthouse beam, the clock
--     tower's hands, swings, bobbing boats, aquarium fish, ducks on the lake, blinking beacons,
--     police lights, server-rack LEDs, chimney smoke
--   * ambient sound loops and a shuffled music playlist (ids in Config.Sounds)

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)

local Ambience = {}

local NIGHT_ON, NIGHT_OFF = 18.4, 6.3

local night = nil :: boolean?
local raining = false
local fx = {} :: { [string]: any }
local tagged: { [string]: { [Instance]: any } } = {}

local function camPos(): Vector3
	local cam = Workspace.CurrentCamera
	return if cam then cam.CFrame.Position else Vector3.zero
end

local function isNight(t: number): boolean
	return t >= NIGHT_ON or t < NIGHT_OFF
end

local function lerp(a: number, b: number, t: number): number
	return a + (b - a) * t
end

----------------------------------------------------------------------------------------------------
-- Tag tracking (instances stream in and out)
----------------------------------------------------------------------------------------------------
local function track(tag: string, onAdd: ((Instance) -> any)?)
	local set = {}
	tagged[tag] = set
	local function add(inst: Instance)
		set[inst] = if onAdd then (onAdd(inst) or true) else true
	end
	for _, inst in CollectionService:GetTagged(tag) do
		task.spawn(add, inst)
	end
	CollectionService:GetInstanceAddedSignal(tag):Connect(add)
	CollectionService:GetInstanceRemovedSignal(tag):Connect(function(inst)
		set[inst] = nil
	end)
	return set
end

----------------------------------------------------------------------------------------------------
-- Night lights
----------------------------------------------------------------------------------------------------
local function lightsOf(inst: Instance): { Light }
	local out = {}
	for _, d in inst:GetChildren() do
		if d:IsA("Light") then
			table.insert(out, d)
		elseif d:IsA("Attachment") then
			for _, l in d:GetChildren() do
				if l:IsA("Light") then
					table.insert(out, l)
				end
			end
		end
	end
	return out
end

local function applyNight(inst: Instance, on: boolean, tag: string)
	if tag == "NightWindow" and inst:IsA("BasePart") then
		-- not every window: some flats stay dark
		local lit = on and ((inst.Position.X * 7.3 + inst.Position.Y * 3.1 + inst.Position.Z * 1.7) % 10) < 6.5
		inst.Transparency = if lit then 0.05 else 1
	elseif tag == "LampBulb" and inst:IsA("BasePart") then
		inst.Material = if on then Enum.Material.Neon else Enum.Material.Glass
		for _, l in lightsOf(inst) do
			l.Enabled = on
		end
	elseif tag == "NightLight" then
		if inst:IsA("BasePart") then
			inst.Material = if on then Enum.Material.Neon else Enum.Material.SmoothPlastic
		end
		for _, l in lightsOf(inst) do
			l.Enabled = on
		end
	elseif tag == "NightOnly" and inst:IsA("BasePart") then
		inst.Transparency = if on then 0.85 else 1
	end
end

local NIGHT_TAGS = { "NightWindow", "LampBulb", "NightLight", "NightOnly" }

-- Switch everything over a couple of seconds so the city lights up street by street.
local function switchNight(on: boolean)
	task.spawn(function()
		local n = 0
		for _, tag in NIGHT_TAGS do
			for inst in tagged[tag] or {} do
				applyNight(inst, on, tag)
				n += 1
				if n % 150 == 0 then
					task.wait()
				end
			end
		end
	end)
end

----------------------------------------------------------------------------------------------------
-- Sky, light mood, weather
----------------------------------------------------------------------------------------------------
local function setupEffects()
	local function get(className: string, name: string, parent: Instance): any
		local e = parent:FindFirstChild(name)
		if not e then
			e = Instance.new(className)
			e.Name = name
			e.Parent = parent
		end
		return e
	end
	fx.bloom = get("BloomEffect", "AmbBloom", Lighting)
	fx.bloom.Intensity = 0.55
	fx.bloom.Size = 26
	fx.bloom.Threshold = 1.6
	fx.rays = get("SunRaysEffect", "AmbRays", Lighting)
	fx.rays.Intensity = 0.05
	fx.rays.Spread = 0.6
	fx.cc = get("ColorCorrectionEffect", "AmbColor", Lighting)
	fx.cc.Saturation = 0.08
	fx.cc.Contrast = 0.06
	fx.dof = get("DepthOfFieldEffect", "AmbDof", Lighting)
	fx.dof.FarIntensity = 0.12
	fx.dof.FocusDistance = 120
	fx.dof.InFocusRadius = 160
	fx.dof.NearIntensity = 0
	local terrain = Workspace:FindFirstChildOfClass("Terrain")
	if terrain then
		fx.clouds = get("Clouds", "AmbClouds", terrain)
		fx.clouds.Cover = 0.55
		fx.clouds.Density = 0.6
	end
	fx.atmosphere = Lighting:FindFirstChildOfClass("Atmosphere")
	-- rain: a particle curtain that follows the camera
	local box = Instance.new("Part")
	box.Name = "RainBox"
	box.Anchored = true
	box.CanCollide = false
	box.CanQuery = false
	box.CanTouch = false
	box.Transparency = 1
	box.Size = Vector3.new(140, 1, 140)
	box.Parent = Workspace
	local rain = Instance.new("ParticleEmitter")
	rain.Name = "Rain"
	rain.Texture = "rbxasset://textures/particles/smoke_main.dds"
	rain.Color = ColorSequence.new(Color3.fromRGB(214, 224, 236))
	rain.LightEmission = 0.15
	rain.LightInfluence = 0.6
	rain.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.55), NumberSequenceKeypoint.new(0.2, 0.25), NumberSequenceKeypoint.new(1, 0.35) })
	rain.Size = NumberSequence.new(0.16)
	rain.Squash = NumberSequence.new(5.5)
	rain.Orientation = Enum.ParticleOrientation.VelocityParallel
	rain.Speed = NumberRange.new(100, 120)
	rain.EmissionDirection = Enum.NormalId.Bottom
	rain.Acceleration = Vector3.new(3, 0, 1.5)
	rain.Lifetime = NumberRange.new(0.6, 0.75)
	rain.Rate = 0
	rain.SpreadAngle = Vector2.new(3, 3)
	rain.Parent = box
	-- little splashes where the drops land
	local splashBox = Instance.new("Part")
	splashBox.Name = "RainSplashes"
	splashBox.Anchored = true
	splashBox.CanCollide = false
	splashBox.CanQuery = false
	splashBox.CanTouch = false
	splashBox.Transparency = 1
	splashBox.Size = Vector3.new(70, 0.2, 70)
	splashBox.Parent = Workspace
	local splash = Instance.new("ParticleEmitter")
	splash.Name = "Splash"
	splash.Texture = "rbxasset://textures/particles/smoke_main.dds"
	splash.Color = ColorSequence.new(Color3.fromRGB(226, 234, 244))
	splash.LightInfluence = 0.7
	splash.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 1) })
	splash.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 0.45) })
	splash.Speed = NumberRange.new(1.5, 3)
	splash.SpreadAngle = Vector2.new(70, 70)
	splash.EmissionDirection = Enum.NormalId.Top
	splash.Acceleration = Vector3.new(0, -14, 0)
	splash.Lifetime = NumberRange.new(0.15, 0.25)
	splash.Rate = 0
	splash.Parent = splashBox
	fx.rainBox = box
	fx.rain = rain
	fx.splashBox = splashBox
	fx.splash = splash
end

-- Colour keys through the day: { hour, ambient, outdoor, tint, brightness, exposure }
local MOOD = {
	{ 0, Color3.fromRGB(28, 34, 58), Color3.fromRGB(46, 56, 92), Color3.fromRGB(196, 210, 255), 0.6, 0.15 },
	{ 5.2, Color3.fromRGB(40, 40, 64), Color3.fromRGB(70, 70, 110), Color3.fromRGB(220, 210, 240), 0.9, 0.1 },
	{ 6.5, Color3.fromRGB(90, 70, 60), Color3.fromRGB(150, 120, 110), Color3.fromRGB(255, 226, 200), 1.8, 0.05 },
	{ 9, Color3.fromRGB(60, 60, 64), Color3.fromRGB(120, 124, 136), Color3.fromRGB(255, 250, 244), 2.6, 0.1 },
	{ 16, Color3.fromRGB(62, 60, 60), Color3.fromRGB(124, 122, 128), Color3.fromRGB(255, 246, 236), 2.6, 0.1 },
	{ 18.3, Color3.fromRGB(96, 66, 50), Color3.fromRGB(170, 120, 96), Color3.fromRGB(255, 214, 176), 1.9, 0.12 },
	{ 19.6, Color3.fromRGB(46, 40, 66), Color3.fromRGB(76, 66, 110), Color3.fromRGB(214, 200, 255), 1.0, 0.15 },
	{ 24, Color3.fromRGB(28, 34, 58), Color3.fromRGB(46, 56, 92), Color3.fromRGB(196, 210, 255), 0.6, 0.15 },
}

local function mood(t: number)
	local a, b = MOOD[1], MOOD[#MOOD]
	for i = 1, #MOOD - 1 do
		if t >= MOOD[i][1] and t < MOOD[i + 1][1] then
			a, b = MOOD[i], MOOD[i + 1]
			break
		end
	end
	local f = (t - a[1]) / math.max(0.001, b[1] - a[1])
	local wet = if raining then 1 else 0
	Lighting.Ambient = a[2]:Lerp(b[2], f)
	Lighting.OutdoorAmbient = a[3]:Lerp(b[3], f):Lerp(Color3.fromRGB(110, 116, 128), wet * 0.4)
	Lighting.Brightness = lerp(a[5], b[5], f) * (1 - wet * 0.35)
	Lighting.ExposureCompensation = lerp(a[6], b[6], f)
	if fx.cc then
		fx.cc.TintColor = a[4]:Lerp(b[4], f):Lerp(Color3.fromRGB(220, 228, 240), wet * 0.5)
		fx.cc.Saturation = 0.08 - wet * 0.12
	end
	if fx.bloom then
		fx.bloom.Intensity = if isNight(t) then 0.9 else 0.5
	end
	if fx.rays then
		fx.rays.Intensity = if raining or isNight(t) then 0 else 0.05
	end
	if fx.clouds then
		fx.clouds.Cover = lerp(fx.clouds.Cover, if raining then 0.9 else 0.55, 0.02)
		fx.clouds.Density = lerp(fx.clouds.Density, if raining then 0.95 else 0.6, 0.02)
		fx.clouds.Color = Color3.new(1, 1, 1):Lerp(Color3.fromRGB(120, 124, 134), if raining then 1 else 0)
	end
	if fx.atmosphere then
		fx.atmosphere.Density = lerp(fx.atmosphere.Density, if raining then 0.42 else 0.3, 0.02)
		fx.atmosphere.Haze = lerp(fx.atmosphere.Haze, if raining then 2.4 else 1.4, 0.02)
	end
end

----------------------------------------------------------------------------------------------------
-- Traffic lights: one city-wide cycle from the server clock
----------------------------------------------------------------------------------------------------
local CYCLE = 30

-- "green" | "amber" | "red" for traffic moving along `axis` ("NS" or "EW").
function Ambience.signal(axis: string): string
	local t = Workspace:GetServerTimeNow() % CYCLE
	local ns = if t < 12 then "green" elseif t < 15 then "amber" else "red"
	local ew = if t < 15 then "red" elseif t < 27 then "green" else "amber"
	return if axis == "NS" then ns else ew
end

local function paintSignal(m: Instance)
	local state = Ambience.signal(m:GetAttribute("Axis") or "NS")
	for _, name in { "Red", "Amber", "Green" } do
		local lamp = m:FindFirstChild(name) :: BasePart?
		if lamp then
			local on = (name == "Red" and state == "red") or (name == "Amber" and state == "amber") or (name == "Green" and state == "green")
			local col = lamp:GetAttribute("OnColor")
			if typeof(col) == "Color3" then
				lamp.Color = if on then col else col:Lerp(Color3.new(0, 0, 0), 0.75)
			end
			lamp.Material = if on then Enum.Material.Neon else Enum.Material.SmoothPlastic
		end
	end
end

----------------------------------------------------------------------------------------------------
-- Moving landmarks
----------------------------------------------------------------------------------------------------
local function near(inst: Instance, range: number): boolean
	local pos
	if inst:IsA("BasePart") then
		pos = inst.Position
	elseif inst:IsA("Model") then
		pos = inst:GetPivot().Position
	end
	return pos ~= nil and (pos - camPos()).Magnitude < range
end

-- Ferris wheel: the frame turns, cabins hang level.
local function ferrisInfo(wheel: Instance)
	if not wheel:IsA("Model") or not wheel.PrimaryPart then
		return nil
	end
	local axle = wheel.PrimaryPart
	local info = { axle0 = axle.CFrame, frame = {}, cabins = {}, angle = 0 }
	for _, d in wheel:GetDescendants() do
		if d:IsA("BasePart") and d ~= axle then
			if d.Name == "Cabin" then
				-- the cabin hangs 3 studs under its rim point
				local rimLocal = axle.CFrame:PointToObjectSpace(d.Position + Vector3.new(0, 3, 0))
				table.insert(info.cabins, { part = d, rim = rimLocal, rot = d.CFrame.Rotation })
			else
				table.insert(info.frame, { part = d, rel = axle.CFrame:ToObjectSpace(d.CFrame) })
			end
		end
	end
	return info
end

local function stepFerris(info, dt: number)
	info.angle += dt * 0.06
	local rot = info.axle0 * CFrame.Angles(info.angle, 0, 0)
	local parts, cfs = {}, {}
	for _, f in info.frame do
		table.insert(parts, f.part)
		table.insert(cfs, rot * f.rel)
	end
	for _, c in info.cabins do
		local rim = rot:PointToWorldSpace(c.rim)
		table.insert(parts, c.part)
		table.insert(cfs, CFrame.new(rim - Vector3.new(0, 3, 0)) * c.rot)
	end
	Workspace:BulkMoveTo(parts, cfs, Enum.BulkMoveMode.FireCFrameChanged)
end

local function clockInfo(hand: Instance)
	local pivot = hand:GetAttribute("Pivot")
	if not hand:IsA("BasePart") or typeof(pivot) ~= "CFrame" then
		return nil
	end
	return { pivot = pivot, rel = pivot:ToObjectSpace(hand.CFrame), minute = hand.Name == "MinuteHand" }
end

local function stepClock(hand: BasePart, info)
	local t = Lighting.ClockTime
	local frac = if info.minute then (t % 1) else ((t % 12) / 12)
	hand.CFrame = info.pivot * CFrame.Angles(0, 0, frac * math.pi * 2) * info.rel
end

local function makeDuck(spot: BasePart): Model
	local m = Instance.new("Model")
	m.Name = "Duck"
	local function part(size: Vector3, color: Color3, shape: Enum.PartType?): Part
		local p = Instance.new("Part")
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.Size = size
		p.Color = color
		p.Material = Enum.Material.SmoothPlastic
		if shape then
			p.Shape = shape
		end
		p.Parent = m
		return p
	end
	local body = part(Vector3.new(1.1, 0.7, 1.6), Color3.fromRGB(240, 236, 220), Enum.PartType.Ball)
	body.Name = "Body"
	local head = part(Vector3.new(0.6, 0.6, 0.6), Color3.fromRGB(40, 110, 60), Enum.PartType.Ball)
	head.Name = "Head"
	local beak = part(Vector3.new(0.25, 0.12, 0.4), Color3.fromRGB(250, 170, 40))
	beak.Name = "Beak"
	m.PrimaryPart = body
	m.Parent = spot
	return m
end

local function stepDuck(spot: BasePart, info, now: number)
	local a = now * 0.25 + info.phase
	local center = spot.Position
	local pos = center + Vector3.new(math.cos(a) * 5, 0.25 + math.sin(now * 2 + info.phase) * 0.05, math.sin(a) * 5)
	local dir = Vector3.new(-math.sin(a), 0, math.cos(a))
	local cf = CFrame.lookAt(pos, pos + dir)
	local m = info.model
	local body = m:FindFirstChild("Body") :: BasePart
	local head = m:FindFirstChild("Head") :: BasePart
	local beak = m:FindFirstChild("Beak") :: BasePart
	Workspace:BulkMoveTo({ body, head, beak }, { cf, cf * CFrame.new(0, 0.45, -0.7), cf * CFrame.new(0, 0.42, -1.05) }, Enum.BulkMoveMode.FireCFrameChanged)
end

----------------------------------------------------------------------------------------------------
-- Sound
----------------------------------------------------------------------------------------------------
local loops: { [string]: Sound } = {}
local gains: { [string]: number } = {}

-- A Config.Sounds entry is an id, or { id = ..., volume = ... } (volume evens out quiet recordings).
local function spec(v: any): (string?, number)
	if type(v) == "table" then
		return v.id, v.volume or 1
	end
	return v, 1
end

local function loop(name: string, entry: any): Sound?
	local id, gain = spec(entry)
	if type(id) ~= "string" or id == "" then
		return nil
	end
	local s = Instance.new("Sound")
	s.Name = "Amb_" .. name
	s.SoundId = id
	s.Looped = true
	s.Volume = 0
	s.Parent = SoundService
	s:Play()
	loops[name] = s
	gains[name] = gain
	return s
end

-- Background music: two decks cross-fading through a shuffled playlist, so it never stops. A
-- track that ends, fails to load or stalls simply hands over to the next one.
local music = { list = {} :: { string }, gains = {} :: { number }, i = 0, decks = {} :: { Sound }, cur = 1, started = 0 }
local FADE = 3

local function nextTrack()
	if #music.list == 0 then
		return
	end
	music.i = music.i % #music.list + 1
	music.cur = 3 - music.cur
	local s = music.decks[music.cur]
	s.SoundId = music.list[music.i]
	s.TimePosition = 0
	s.Volume = 0
	s:Play()
	music.started = os.clock()
end

local function playlist(entries: any)
	if type(entries) == "string" or (type(entries) == "table" and entries.id) then
		entries = { entries }
	end
	if type(entries) ~= "table" then
		return
	end
	for _, e in entries do
		local id, gain = spec(e)
		if type(id) == "string" and id ~= "" then
			table.insert(music.list, id)
			table.insert(music.gains, gain)
		end
	end
	local n = #music.list
	if n == 0 then
		return
	end
	for i = n, 2, -1 do
		local j = math.random(i)
		music.list[i], music.list[j] = music.list[j], music.list[i]
		music.gains[i], music.gains[j] = music.gains[j], music.gains[i]
	end
	for k = 1, 2 do
		local d = Instance.new("Sound")
		d.Name = "Amb_music" .. k
		d.Looped = n == 1
		d.Volume = 0
		d.Parent = SoundService
		music.decks[k] = d
	end
	music.cur = 2
	nextTrack()
end

local volumes = { music = 0.5, sfx = 0.8 }

-- Player settings from the phone (0..1).
function Ambience.setVolumes(musicVol: number?, sfx: number?)
	volumes.music = musicVol or volumes.music
	volumes.sfx = sfx or volumes.sfx
end

-- Is the camera under a roof? (rain stays outside; you hear it drumming on the roof instead)
local indoors, lastRoofCheck, lastGroundCheck = false, 0, 0
local roofParams = RaycastParams.new()
roofParams.FilterType = Enum.RaycastFilterType.Exclude
roofParams.IgnoreWater = true
local function underRoof(): boolean
	local now = os.clock()
	if now - lastRoofCheck < 0.3 then
		return indoors
	end
	lastRoofCheck = now
	local cam = Workspace.CurrentCamera
	if not cam then
		return false
	end
	local ignore = { fx.rainBox, fx.splashBox }
	local char = Players.LocalPlayer and Players.LocalPlayer.Character
	if char then
		table.insert(ignore, char)
	end
	roofParams.FilterDescendantsInstances = ignore
	local hit = Workspace:Raycast(cam.CFrame.Position, Vector3.new(0, 80, 0), roofParams)
	indoors = hit ~= nil
	return indoors
end

local function mix(t: number)
	local function set(name: string, v: number)
		local s = loops[name]
		if s then
			s.Volume = lerp(s.Volume, v * volumes.sfx * (gains[name] or 1), 0.05)
		end
	end
	local inside = underRoof()
	-- the surf grows louder towards the beach (sand starts at z 846)
	local seaside = math.clamp((camPos().Z - 640) / 220, 0, 1)
	local quiet = if inside then 0.35 else 1
	set("day", if isNight(t) or raining then 0 else 0.6 * quiet)
	set("night", if isNight(t) and not raining then 0.6 * quiet else 0)
	set("rain", if raining and not inside then 0.8 else 0)
	set("rainIn", if raining and inside then 0.8 else 0)
	set("sea", seaside * 0.7 * quiet)
	-- music decks: the current one fades in, the other fades out
	local cur = music.decks[music.cur]
	if cur then
		local target = 0.3 * volumes.music * (music.gains[music.i] or 1)
		cur.Volume = lerp(cur.Volume, target, 0.06)
		local other = music.decks[3 - music.cur]
		if other.Volume > 0.005 then
			other.Volume = lerp(other.Volume, 0, 0.06)
		elseif other.IsPlaying then
			other:Stop()
		end
		local age = os.clock() - music.started
		local len = cur.TimeLength
		local finishing = len > FADE * 2 and cur.TimePosition > len - FADE
		local stalled = age > 4 and not cur.IsPlaying
		local missing = age > 20 and not cur.IsLoaded
		if #music.list > 1 and (finishing or stalled or missing) then
			nextTrack()
		end
	end
	-- rain falls outside only
	if fx.rain then
		local rate = if raining and not inside then 520 else 0
		fx.rain.Rate = rate
		fx.splash.Rate = if rate > 0 then 160 else 0
	end
end

Ambience._music = music
Ambience._nextTrack = nextTrack

----------------------------------------------------------------------------------------------------
function Ambience.init()
	setupEffects()
	for _, tag in NIGHT_TAGS do
		track(tag, function(inst)
			if night ~= nil then
				applyNight(inst, night, tag)
			end
			return true
		end)
	end
	track("TrafficLight")
	local ferris = track("FerrisWheel", ferrisInfo)
	local carousels = track("Carousel")
	local turbines = track("WindTurbine")
	local beams = track("LighthouseBeam")
	local hands = track("ClockHand", clockInfo)
	local swings = track("Swing", function(inst)
		return if inst:IsA("BasePart") then { cf = inst.CFrame, phase = math.random() * 6 } else nil
	end)
	local boats = track("Boat", function(inst)
		return if inst:IsA("Model") then { cf = inst:GetPivot(), phase = math.random() * 6 } else nil
	end)
	local fish = track("Fish", function(inst)
		return if inst:IsA("BasePart") then { cf = inst.CFrame, phase = math.random() * 6, speed = 0.4 + math.random() * 0.5 } else nil
	end)
	local ducks = track("DuckSpot", function(inst)
		if inst:IsA("BasePart") then
			return { model = makeDuck(inst), phase = math.random() * 6 }
		end
		return nil
	end)
	local beacons = track("Beacon")
	local sirens = track("Siren")
	local leds = track("RackLed")
	track("Chimney", function(inst)
		if inst:IsA("BasePart") and not inst:FindFirstChild("Smoke") then
			local e = Instance.new("ParticleEmitter")
			e.Name = "Smoke"
			e.Texture = "rbxasset://textures/particles/smoke_main.dds"
			e.Color = ColorSequence.new(Color3.fromRGB(190, 190, 196))
			e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 1) })
			e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 2), NumberSequenceKeypoint.new(1, 9) })
			e.Lifetime = NumberRange.new(5, 8)
			e.Rate = 3
			e.Speed = NumberRange.new(3, 5)
			e.EmissionDirection = Enum.NormalId.Top
			e.Acceleration = Vector3.new(2, 0.5, 0)
			e.Parent = inst
		end
		return true
	end)

	local sounds = Config.Sounds or {}
	loop("day", sounds.AmbienceDay)
	loop("night", sounds.AmbienceNight)
	loop("rain", sounds.Rain)
	loop("rainIn", sounds.RainIndoor)
	loop("sea", sounds.Sea)
	playlist(sounds.Music)

	raining = Workspace:GetAttribute("Raining") == true
	Workspace:GetAttributeChangedSignal("Raining"):Connect(function()
		raining = Workspace:GetAttribute("Raining") == true
	end)

	local slow = 0
	RunService.RenderStepped:Connect(function(dt)
		local t = Lighting.ClockTime
		local now = os.clock()
		-- night switch
		local n = isNight(t)
		if n ~= night then
			night = n
			switchNight(n)
		end
		-- rain follows the camera
		local cam = Workspace.CurrentCamera
		if cam and fx.rainBox then
			local cp = cam.CFrame.Position
			fx.rainBox.CFrame = CFrame.new(cp + Vector3.new(0, 40, 0))
			-- splashes on whatever is below the camera (looked up with the roof check)
			if raining and now - lastGroundCheck > 0.3 then
				lastGroundCheck = now
				local hit = Workspace:Raycast(cp, Vector3.new(0, -120, 0), roofParams)
				fx.splashBox.CFrame = CFrame.new(if hit then hit.Position + Vector3.new(0, 0.1, 0) else Vector3.new(cp.X, 0.8, cp.Z))
			end
		end
		-- continuous movers
		for wheel, info in ferris do
			if type(info) == "table" and wheel.Parent and near(wheel, 900) then
				stepFerris(info, dt)
			end
		end
		for top in carousels do
			if top:IsA("Model") and top.PrimaryPart and near(top, 500) then
				top:PivotTo(top:GetPivot() * CFrame.Angles(0, dt * 0.35, 0))
			end
		end
		for rotor in turbines do
			if rotor:IsA("Model") and rotor.PrimaryPart and near(rotor, 1400) then
				rotor:PivotTo(rotor:GetPivot() * CFrame.Angles(0, 0, dt * (rotor:GetAttribute("Speed") or 0.7)))
			end
		end
		for beam in beams do
			if beam:IsA("Model") and beam.PrimaryPart then
				beam:PivotTo(beam:GetPivot() * CFrame.Angles(0, dt * 0.7, 0))
			end
		end
		for duck, info in ducks do
			if type(info) == "table" and duck.Parent and near(duck, 500) then
				stepDuck(duck :: BasePart, info, now)
			end
		end
		for f, info in fish do
			if type(info) == "table" and f.Parent and near(f, 120) then
				local x = math.sin(now * info.speed + info.phase) * 1.6
				local facing = if math.cos(now * info.speed + info.phase) >= 0 then 0 else math.pi
				local part = f :: BasePart
				part.CFrame = info.cf * CFrame.new(x, math.sin(now * 1.3 + info.phase) * 0.15, 0) * CFrame.Angles(0, facing, 0)
			end
		end
		-- slower things, 10 times a second
		slow += dt
		if slow < 0.1 then
			return
		end
		slow = 0
		mood(t)
		mix(t)
		for m in tagged.TrafficLight do
			if near(m, 400) then
				paintSignal(m)
			end
		end
		for hand, info in hands do
			if type(info) == "table" and hand.Parent then
				stepClock(hand :: BasePart, info)
			end
		end
		for seat, info in swings do
			if type(info) == "table" and seat.Parent and near(seat, 300) then
				local pivot = info.cf * CFrame.new(0, 2.6, 0)
				local part = seat :: BasePart
				part.CFrame = pivot * CFrame.Angles(math.sin(now * 1.6 + info.phase) * 0.45, 0, 0) * CFrame.new(0, -2.6, 0)
			end
		end
		for boat, info in boats do
			if type(info) == "table" and boat.Parent and near(boat, 600) then
				local ph = info.phase
				local model = boat :: Model
				model:PivotTo(info.cf * CFrame.new(0, math.sin(now * 0.8 + ph) * 0.35, 0) * CFrame.Angles(math.sin(now * 0.6 + ph) * 0.025, 0, math.sin(now * 0.7 + ph) * 0.035))
			end
		end
		local blink = (now % 1.6) < 0.35
		for b in beacons do
			if b:IsA("BasePart") then
				b.Transparency = if blink then 0 else 0.85
			end
		end
		local flip = (now % 0.6) < 0.3
		for s in sirens do
			if s:IsA("BasePart") then
				s.Color = if flip then Color3.fromRGB(255, 40, 40) else Color3.fromRGB(40, 80, 255)
			end
		end
		for led in leds do
			if led:IsA("BasePart") and math.random() < 0.15 then
				led.Transparency = if led.Transparency > 0.5 then 0 else 0.8
			end
		end
	end)
end

function Ambience.isNight(): boolean
	return isNight(Lighting.ClockTime)
end

return Ambience
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="2064">
            <Properties>
              <string name="Name">BenchController</string>
              <string name="Source"><![CDATA[-- BenchController: working at a repair bench.
--
--   * orbit camera around the device (right-drag / Q,E to turn, wheel to zoom, Space to stand up)
--   * tool bar (1-0 keys); the tool model follows the mouse over the device
--   * hovering a part shows what the tool would do and, if it can't, why (straight from the rules)
--   * left click acts; timed jobs (prying, desoldering, cleaning...) need the button held;
--     thermal paste is a little hold-and-release game; empty slots open the parts picker
--   * right click lists everything you can do to that part with any tool you own
--   * the side panels run tests (power, stress, POST card, PSU tester, thermal camera, USB tools)
--     and finish the job

local Players = game:GetService("Players")
local GuiService = game:GetService("GuiService")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Signal = require(Shared.Util.Signal)
local Parts = require(Shared.Data.Parts)
local Tools = require(Shared.Data.Tools)
local Rules = require(Shared.Repair.RepairRules)
local ToolModels = require(Shared.Models.ToolModels)

local Client = script.Parent.Parent
local S = require(Client.Strings)
local State = require(Client.State)
local Kit = require(Client.UI.Kit)
local Theme = require(Client.UI.Theme)
local App = require(Client.UI.App)
local BenchViews = require(script.Parent.BenchViews)

local BenchController = {}
BenchController.acted = Signal.new() -- (action, result) after every successful bench action

local player = Players.LocalPlayer

local gui: ScreenGui
local hud
local ui = {} :: { [string]: any }
local active = nil :: any -- { bench = n, model = Workbench, job = summary }
local toolId = "hand"
local toolModel: Model? = nil
local hover = nil :: any -- { id, primary, ok, reason, pos, normal }
local highlight: Highlight
local busy = false
local holding = nil :: any
local orbit = { yaw = 0, pitch = 0.82, dist = 7.2 }
local dragging = false
local dragMoved = 0
local touchStart: Vector2? = nil
local conns = {}

local TIMED = Config.HoldActionSeconds

-- What the work sounds like (Config.Sounds.Bench): these loop while the action is held, the rest
-- play once when the server confirms the action.
local HELD_SOUND = { unscrew = true, screw = true, blow_dust = true, brush = true, clean_paste = true, clean_liquid = true, peel = true }

-- (id, gain): an entry is an id or { id = ..., volume = ... }
local function benchSound(key: string): (string?, number)
	local b = Config.Sounds and Config.Sounds.Bench
	local e = b and b[key]
	if type(e) == "table" then
		return e.id, e.volume or 1
	end
	return e, 1
end

local build -- builds the bench UI (defined below)

----------------------------------------------------------------------------------------------------
-- helpers
----------------------------------------------------------------------------------------------------
local function lang(): string
	return S.lang()
end

local function view()
	return active and BenchViews.view(active.model) or nil
end

local function handle()
	return active and BenchViews.handle(active.model) or nil
end

local function ctx(tool: string)
	return { tool = tool, owned = State.ownedTools(), lang = lang() }
end

local function nodeLabel(v, id: string): string
	return Rules.label(v, id, lang())
end

local function partName(v, id: string): string?
	local s = v.nodes[id]
	local p = s and s.part and Parts.get(s.part)
	return p and p.name or nil
end

local ST = {
	["in"] = { "Takılı", "Fitted" },
	out = { "Sökülmüş", "Removed" },
	empty = { "Boş", "Empty" },
	loose = { "Gevşek", "Loose" },
	open = { "Açık", "Open" },
	closed = { "Kapalı", "Closed" },
	ok = { "Düzgün", "Straight" },
	bent = { "Eğik!", "Bent!" },
	peeled = { "Kaldırılmış", "Peeled" },
}
local function stText(st: string?): string
	local e = st and ST[st]
	return if e then (if lang() == "en" then e[2] else e[1]) else (st or "")
end

local function toolSpeed(id: string): number
	local t = Tools.get(id)
	return t and t.speed or 1
end

-- Everything a tool could do to a node, best guess first.
local function candidates(v, id: string, tid: string)
	local tn = Rules.tnode(v, id)
	local tool = Tools.get(tid)
	if not tn or not tool then
		return {}
	end
	local s = v.nodes[id]
	local st = s and s.st
	local out = {}
	local function add(a: string, args: { [string]: any }?)
		if table.find(tool.actions, a) then
			table.insert(out, { action = a, args = args })
		end
	end
	local k = tn.kind
	if k == "screw" then
		add(if st == "in" then "unscrew" else "screw")
	elseif k == "cable" then
		add(if st == "in" then "unplug" else "plug")
	elseif k == "latch" then
		add(if st == "open" then "close_latch" else "open_latch")
	elseif k == "feet" then
		if st == "in" then
			add("peel")
		else
			add("install")
		end
	elseif k == "panel" then
		if st == "in" then
			if tn.pry then
				add("pry")
			end
			add("remove")
		elseif st == "loose" then
			add("remove")
			add("install")
		else
			add("install")
		end
	elseif k == "comp" then
		local soldered = Rules.isSoldered(v, id)
		if st == "in" then
			if soldered then
				add("desolder")
			end
			if tn.pry then
				add("pry")
			end
			add("remove")
		elseif st == "loose" then
			if soldered then
				add("solder")
			end
			add("remove")
			add("install", { source = "self" })
		elseif st == "out" then
			add("install", { source = "self" })
		elseif st == "empty" then
			add("install", { pick = true })
		end
		if tn.dusty then
			add("blow_dust")
			add("brush")
		end
		add("inspect")
		add("measure")
	elseif k == "pins" then
		add("straighten_pins")
		add("inspect")
	elseif k == "board" then
		add("blow_dust")
		add("brush")
		add("clean_liquid")
		add("inspect")
	end
	if (v.kind == "desktop" and id == "cpu") or (v.kind == "laptop" and id == "lboard") then
		add("clean_paste")
		add("apply_paste")
	end
	if v.kind == "laptop" and id == "keyboard" then
		add("clean_liquid")
	end
	return out
end

-- The action the click will do and whether the rules allow it.
local function resolve(v, id: string, tid: string)
	local list = candidates(v, id, tid)
	local first = nil
	for _, c in list do
		if c.args and c.args.pick then
			return c, true, nil
		end
		local ok, reason, vars = Rules.check(v, c.action, id, c.args, ctx(tid))
		if ok then
			return c, true, nil
		end
		if not first then
			first = { c = c, reason = Rules.message(reason :: string, lang(), vars) }
		end
	end
	if first then
		return first.c, false, first.reason
	end
	return nil, false, nil
end

----------------------------------------------------------------------------------------------------
-- UI
----------------------------------------------------------------------------------------------------
local logN = 0
local LOG_MAX = 60

-- Newest finding on top; the oldest drop off.
local function log(text: string, color: Color3?)
	if not ui.log then
		return
	end
	logN += 1
	Kit.label(ui.log, text, { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextSize = 14, TextColor3 = color or Theme.text, LayoutOrder = -logN })
	local items = {}
	for _, c in ui.log:GetChildren() do
		if c:IsA("TextLabel") then
			table.insert(items, c)
		end
	end
	if #items > LOG_MAX then
		table.sort(items, function(a, b)
			return a.LayoutOrder < b.LayoutOrder
		end)
		for i = LOG_MAX + 1, #items do
			items[i]:Destroy()
		end
	end
end

local function setAdornee(target: Instance?)
	if highlight.Adornee ~= target then
		highlight.Adornee = target
	end
end

local function setHint(text: string?, ok: boolean?)
	if not ui.hint then
		return
	end
	if not text then
		ui.hint.Visible = false
		return
	end
	ui.hint.Visible = true
	ui.hintText.Text = text
	ui.hintStroke.Color = if ok then Theme.good else Theme.bad
end

local function selectTool(id: string)
	if not State.owns(id) then
		return
	end
	toolId = id
	for tid, b in ui.toolButtons or {} do
		Kit.setColor(b, if tid == id then Theme.accent else Theme.card)
	end
	if toolModel then
		toolModel:Destroy()
		toolModel = nil
	end
	local t = Tools.get(id)
	if t and active then
		toolModel = ToolModels.build(t.model or "hand", Workspace)
	end
	if ui.toolName then
		ui.toolName.Text = (t and t.icon or "") .. " " .. (t and S.pick(t.name) or "")
	end
end

local function buildToolbar()
	Kit.clear(ui.tools)
	ui.toolButtons = {}
	local n = 0
	for _, t in Tools.list do
		if State.owns(t.id) and not t.passive then
			n += 1
			local key = if n <= 9 then tostring(n) elseif n == 10 then "0" else ""
			local b = Kit.button(ui.tools, t.icon, function()
				selectTool(t.id)
			end, { Size = UDim2.fromOffset(52, 52), TextSize = 26, LayoutOrder = n })
			b.Name = t.id
			if key ~= "" then
				Kit.label(b, key, { Size = UDim2.fromOffset(14, 14), Position = UDim2.fromOffset(4, 2), TextSize = 12, TextColor3 = Theme.dim, FontFace = Theme.bold })
			end
			ui.toolButtons[t.id] = b
			b:SetAttribute("Key", key)
		end
	end
	selectTool(if State.owns(toolId) then toolId else "hand")
end

local function jobCard()
	local j = active and active.job
	Kit.clear(ui.jobInfo)
	if not j then
		Kit.label(ui.jobInfo, S.t("bench_no_job"), { TextColor3 = Theme.dim })
		return
	end
	Kit.label(ui.jobInfo, "<b>" .. (j.name or "") .. "</b>", { TextSize = 17, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y })
	if j.customer then
		Kit.label(ui.jobInfo, "👤 " .. j.customer.name, { TextColor3 = Theme.dim, TextSize = 14 })
	elseif j.own then
		Kit.label(ui.jobInfo, "🛠️ " .. S.t("job_own"), { TextColor3 = Theme.dim, TextSize = 14 })
	end
	if j.complaint and #j.complaint > 0 then
		Kit.label(ui.jobInfo, "“" .. j.complaint .. "”", { TextSize = 14, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextColor3 = Color3.fromRGB(220, 226, 236), FontFace = Theme.font })
	end
	if j.price and j.price > 0 then
		Kit.label(ui.jobInfo, "💵 " .. S.money(j.price), { TextColor3 = Theme.money, FontFace = Theme.bold })
	end
	local missing = {}
	for _, t in j.tools or {} do
		if not State.owns(t) then
			local tool = Tools.get(t)
			table.insert(missing, tool and (tool.icon .. " " .. S.pick(tool.name)) or t)
		end
	end
	if #missing > 0 then
		Kit.label(ui.jobInfo, S.t("missing_tool", { list = table.concat(missing, ", ") }), { TextColor3 = Theme.bad, TextSize = 14, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y })
	end
end

local function refreshDiag()
	local v = view()
	local has = v ~= nil
	for _, b in ui.diag or {} do
		local need = b:GetAttribute("Tool")
		local kindOnly = b:GetAttribute("Kind")
		b.Visible = has and (not need or State.owns(need)) and (not kindOnly or (v ~= nil and v.kind == kindOnly))
	end
	if ui.finish then
		ui.finish.Visible = has
	end
	if ui.unload then
		ui.unload.Visible = has
	end
	if ui.strap and v then
		Kit.setColor(ui.strap, if v.strap then Theme.good else Theme.card)
	end
end

local function showJobPicker()
	Kit.clear(ui.picker)
	ui.pickerFrame.Visible = true
	local any = false
	for _, j in State.jobs do
		if j.status == "waiting" then
			any = true
			local icon = if j.device == "laptop" then "💻" else "🖥️"
			local sub = (j.customer and ("👤 " .. j.customer.name .. " • ") or "🛠️ ") .. (if j.price and j.price > 0 then S.money(j.price) else S.t("job_own"))
			local _, right = Kit.row(ui.picker, icon, j.name or j.id, sub)
			Kit.button(right, S.t("bench_load"), function()
				local r = Net.request("bench.load", { job = j.id })
				if r.ok then
					active.job = r.job
					BenchViews.apply(active.model, r.view, r.rev)
					ui.pickerFrame.Visible = false
					jobCard()
					refreshDiag()
				else
					hud.toast(S.err(r.err), "bad")
				end
			end, { Size = UDim2.fromOffset(120, 36) }, "primary")
		end
	end
	if not any then
		Kit.label(ui.picker, S.t("job_none"), { TextColor3 = Theme.dim, Size = UDim2.new(1, 0, 0, 60) })
	end
end

-- Shows test results on the side log and the bench monitor.
local function showResult(r)
	if r.findings then
		for _, f in r.findings do
			log("🔍 " .. f)
		end
	end
	if r.reading then
		log("📟 " .. r.reading, Theme.accent)
	end
	if r.quality then
		log(S.t("paste_q", { n = math.floor(r.quality * 100) }), if r.quality > 0.7 then Theme.good else Theme.warn)
	end
	if r.code then
		log(S.t("post_code", { code = r.code }), Theme.accent2)
	end
	if r.eval then
		local e = r.eval
		local st = Rules.StageText[e.stage]
		log("⚡ " .. (if st then S.pick(st) else e.stage), if e.stage == "ok" then Theme.good else Theme.bad)
		if e.temps and (e.temps.cpu or e.temps.gpu) then
			log("🌡️ " .. S.t("temps", { cpu = math.floor(e.temps.cpu or 0), gpu = math.floor(e.temps.gpu or 0) }))
		end
		for _, key in e.issues or {} do
			local it = Rules.IssueText[key]
			log("⚠️ " .. (if it then S.pick(it) else key), Theme.warn)
		end
	end
	if r.software then
		local sw = r.software
		local lines = table.concat(sw.lines or {}, "\n")
		log("💾 " .. S.t("sw_" .. tostring(sw.program)) .. "\n" .. lines, if sw.ok then Theme.text else Theme.bad)
		BenchViews.monitor(active.model, S.t("sw_" .. tostring(sw.program)) .. "\n\n" .. lines, Color3.fromRGB(0, 40, 90))
	end
	if r.esd then
		hud.toast(S.t("t_esd_zap", { node = nodeLabel(view(), r.esd) }), "bad", 6)
	end
end

----------------------------------------------------------------------------------------------------
-- Doing things
----------------------------------------------------------------------------------------------------
-- The motherboard speaker after pressing power: one short beep is a good POST, three are memory
-- (or bent socket pins), four the graphics card; no power or no POST stays silent.
local function postBeeps(stage: string)
	if stage == "no_power" or stage == "no_post" then
		return
	end
	local n = if stage == "beeps" then 3 elseif stage == "no_display" then 4 else 1
	local id, gain = benchSound("beep")
	for i = 0, n - 1 do
		task.delay(0.8 + i * 0.6, App.play, id, 0.35 * gain)
	end
end

local function send(action: string, target: string?, args: { [string]: any }?, tid: string?)
	if busy or not active then
		return nil
	end
	busy = true
	local r = Net.request("repair.act", { action = action, target = target, args = args, tool = tid or toolId })
	busy = false
	if r.view then
		BenchViews.apply(active.model, r.view, r.rev)
	end
	if r.ok then
		if not HELD_SOUND[action] then
			local id, gain = benchSound(action)
			App.play(id, 0.5 * gain)
		end
		if action == "press_power" and r.eval then
			postBeeps(r.eval.stage)
		end
		showResult(r)
		refreshDiag()
		BenchController.acted:Fire(action, r)
	else
		local msg = if r.reason then Rules.message(r.reason, lang(), r.vars) else S.err(r.err)
		setHint(msg, false)
		log("✖ " .. msg, Theme.bad)
	end
	return r
end

-- Holds the mouse for `seconds`; returns true when completed.
local function holdFor(seconds: number, label: string): boolean
	if seconds <= 0 then
		return true
	end
	holding = { t0 = os.clock(), dur = seconds, done = false, cancelled = false }
	ui.hold.Visible = true
	ui.holdLabel.Text = label
	while holding and not holding.cancelled do
		local f = (os.clock() - holding.t0) / holding.dur
		ui.holdBar:set(f)
		if f >= 1 then
			break
		end
		RunService.RenderStepped:Wait()
	end
	local ok = holding ~= nil and not holding.cancelled
	holding = nil
	ui.hold.Visible = false
	return ok
end

-- Thermal paste: hold to squeeze, release in the green zone.
local function pasteGame(target: string)
	local lo, hi = Config.PasteIdealRange[1], Config.PasteIdealRange[2]
	ui.paste.Visible = true
	ui.pasteZone.Position = UDim2.fromScale(lo, 0)
	ui.pasteZone.Size = UDim2.fromScale(hi - lo, 1)
	local t0 = os.clock()
	local amount = 0
	local syringe = toolModel
	local base = syringe and syringe:GetPivot()
	holding = { t0 = t0, dur = 2.4, done = false, cancelled = false, paste = true }
	while holding and not holding.cancelled do
		amount = math.clamp((os.clock() - t0) / 2.4, 0, 1)
		if syringe and base and syringe.Parent then
			-- the plunger goes in as the paste comes out
			syringe:PivotTo(base * CFrame.new(0, -0.12 * amount, 0))
		end
		ui.pasteFill.Size = UDim2.fromScale(amount, 1)
		ui.pasteText.Text = S.t("paste_amount", { n = math.floor(amount * 100) })
		if amount >= 1 then
			break
		end
		RunService.RenderStepped:Wait()
	end
	holding = nil
	task.delay(0.6, function()
		ui.paste.Visible = false
	end)
	if amount < 0.03 then
		return
	end
	send("apply_paste", target, { amount = amount }, "paste_syringe")
end

local function openPartPicker(id: string)
	local v = view()
	if not v then
		return
	end
	local win = Kit.window(gui, S.t("bench_install_title", { slot = nodeLabel(v, id) }), Vector2.new(620, 460))
	local list = Kit.list(win.content)
	local any = false
	local function entry(item, source: string)
		local p = Parts.get(item.part)
		if not p then
			return
		end
		local ok, why = Rules.compatible(v, id, p, lang())
		local cond = if item.cond and item.cond < 0.999 then S.t("cond", { n = math.floor(item.cond * 100) }) else S.t("cond_new")
		local sub = cond .. (if item.broken then " • " .. S.t("broken") else "") .. (if not ok then " • " .. tostring(why) else "")
		local _, right = Kit.row(list, Theme.catIcon[p.cat] or "📦", p.name, sub)
		local b = Kit.button(right, S.t("act_install"), function()
			win.close()
			send("install", id, { source = source, part = item.part, uid = item.uid }, "hand")
		end, { Size = UDim2.fromOffset(110, 36) }, if ok then "primary" else nil)
		Kit.setEnabled(b, ok)
		if ok then
			any = true
		end
	end
	for _, t in v.tray or {} do
		entry(t, "tray")
	end
	local tn = Rules.tnode(v, id)
	for _, item in State.data and State.data.inv or {} do
		local p = Parts.get(item.part)
		if p and tn and p.cat == tn.cat then
			entry(item, "inv")
		end
	end
	if not any then
		Kit.label(list, S.t("bench_install_none"), { TextColor3 = Theme.dim, Size = UDim2.new(1, 0, 0, 40) })
	end
end

-- How each kind of work looks: the tool moves the way it's used and the work shows.
local SMOKE = "rbxasset://textures/particles/smoke_main.dds"
local FX = {
	unscrew = { spin = 16, lift = 0.22 },
	screw = { spin = -16, lift = -0.18 },
	blow_dust = { shake = 0.03, particles = "dust" },
	brush = { sweep = 0.16, particles = "fluff" },
	desolder = { shake = 0.008, particles = "smoke" },
	solder = { shake = 0.008, particles = "smoke" },
	clean_paste = { circle = 0.08 },
	clean_liquid = { circle = 0.12 },
	pry = { lever = 0.22 },
	peel = { lever = 0.18 },
	straighten_pins = { shake = 0.006 },
}

local function emitter(kind: string, pos: Vector3, normal: Vector3): BasePart
	local p = Instance.new("Part")
	p.Name = "BenchFx"
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Transparency = 1
	p.Size = Vector3.new(0.2, 0.2, 0.2)
	p.CFrame = CFrame.lookAt(pos, pos + normal)
	local pe = Instance.new("ParticleEmitter")
	pe.Texture = SMOKE
	pe.EmissionDirection = Enum.NormalId.Front
	pe.LightInfluence = 1
	if kind == "dust" then
		-- a grey cloud blown out of the heatsink
		pe.Color = ColorSequence.new(Color3.fromRGB(150, 145, 135))
		pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.15), NumberSequenceKeypoint.new(1, 1.1) })
		pe.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 1) })
		pe.Lifetime = NumberRange.new(0.5, 1.1)
		pe.Rate = 70
		pe.Speed = NumberRange.new(3, 7)
		pe.SpreadAngle = Vector2.new(55, 55)
		pe.Drag = 3
	elseif kind == "fluff" then
		pe.Color = ColorSequence.new(Color3.fromRGB(170, 165, 155))
		pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.05), NumberSequenceKeypoint.new(1, 0.3) })
		pe.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 1) })
		pe.Lifetime = NumberRange.new(0.4, 0.8)
		pe.Rate = 25
		pe.Speed = NumberRange.new(0.5, 1.5)
		pe.SpreadAngle = Vector2.new(80, 80)
		pe.Acceleration = Vector3.new(0, -2, 0)
	else
		-- solder smoke curling up
		pe.Color = ColorSequence.new(Color3.fromRGB(235, 235, 240))
		pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.05), NumberSequenceKeypoint.new(1, 0.5) })
		pe.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 1) })
		pe.Lifetime = NumberRange.new(1.2, 2)
		pe.Rate = 16
		pe.Speed = NumberRange.new(0.4, 1)
		pe.Acceleration = Vector3.new(0, 2.2, 0)
		pe.RotSpeed = NumberRange.new(-40, 40)
	end
	pe.Parent = p
	p.Parent = Workspace
	return p
end

-- Starts the tool's working motion (and particles); returns the function that ends it.
local function startFx(action: string, pos: Vector3?, normal: Vector3?): () -> ()
	local def = FX[action]
	local model = toolModel
	if not def or not model then
		return function() end
	end
	local base = model:GetPivot()
	local t0 = os.clock()
	local fxPart = if def.particles and pos then emitter(def.particles, pos, normal or Vector3.yAxis) else nil
	local conn = RunService.RenderStepped:Connect(function()
		if not model.Parent then
			return
		end
		local t = os.clock() - t0
		local cf = base
		if def.spin then
			cf *= CFrame.new(0, (def.lift or 0) * math.min(1, t / 1.2), 0) * CFrame.Angles(0, t * def.spin, 0)
		elseif def.sweep then
			cf *= CFrame.new(math.sin(t * 14) * def.sweep, 0, 0) * CFrame.Angles(0, 0, math.sin(t * 14) * 0.25)
		elseif def.circle then
			cf *= CFrame.new(math.cos(t * 9) * def.circle, 0, math.sin(t * 9) * def.circle)
		elseif def.lever then
			cf *= CFrame.Angles(math.sin(t * 7) * def.lever, 0, 0)
		elseif def.shake then
			local a = def.shake
			cf *= CFrame.new(math.noise(t * 20, 1.3) * a, math.noise(t * 20, 2.7) * a, math.noise(t * 20, 4.1) * a)
		end
		model:PivotTo(cf)
	end)
	return function()
		conn:Disconnect()
		if model.Parent then
			model:PivotTo(base)
		end
		if fxPart then
			local pe = fxPart:FindFirstChildWhichIsA("ParticleEmitter")
			if pe then
				pe.Enabled = false
			end
			task.delay(2.2, function()
				fxPart:Destroy()
			end)
		end
	end
end

-- Runs a resolved action (with its hold time or mini-game).
local function perform(id: string, c, tid: string)
	if not c or busy then
		return
	end
	if c.args and c.args.pick then
		openPartPicker(id)
		return
	end
	if c.action == "apply_paste" then
		pasteGame(id)
		return
	end
	local hold = (TIMED[c.action] or 0) / toolSpeed(tid)
	local stopFx = startFx(c.action, hover and hover.pos, hover and hover.normal)
	local stopSound = function() end
	if HELD_SOUND[c.action] then
		local id, gain = benchSound(c.action)
		stopSound = App.loop(id, 0.45 * gain)
	end
	if hold > 0 then
		local label = S.t("act_" .. c.action) .. " • " .. nodeLabel(view(), id)
		if not holdFor(hold, label) then
			stopFx()
			stopSound()
			return
		end
	end
	-- everything else: the tool dips onto the part while the server works
	if not FX[c.action] and toolModel and hover then
		local base = toolModel:GetPivot()
		task.spawn(function()
			for i = 1, 8 do
				if not toolModel then
					break
				end
				toolModel:PivotTo(base * CFrame.new(0, -0.05 * math.sin(i / 8 * math.pi), 0))
				task.wait(0.03)
			end
		end)
	end
	send(c.action, id, c.args, tid)
	stopFx()
	stopSound()
end

local function nodeMenu(id: string)
	local v = view()
	if not v then
		return
	end
	local s = v.nodes[id]
	local title = nodeLabel(v, id)
	local win = Kit.window(gui, title, Vector2.new(520, 440))
	local info = {}
	table.insert(info, stText(s and s.st))
	local pname = partName(v, id)
	if pname then
		table.insert(info, pname)
	end
	if s and s.cond then
		table.insert(info, S.t("cond", { n = math.floor(s.cond * 100) }))
	end
	if s and s.dust and s.dust > 0.02 then
		table.insert(info, "🌫️ " .. math.floor(s.dust * 100) .. "%")
	end
	Kit.label(win.content, table.concat(info, " • "), { TextColor3 = Theme.dim, Size = UDim2.new(1, 0, 0, 24) })
	local list = Kit.list(win.content, { Size = UDim2.new(1, 0, 1, -30), Position = UDim2.fromOffset(0, 30) })
	local shown = {}
	for _, t in Tools.list do
		if State.owns(t.id) and not t.passive then
			for _, c in candidates(v, id, t.id) do
				local key = c.action .. ":" .. tostring(c.args and c.args.source)
				if not shown[key] then
					shown[key] = true
					local ok, reason, vars = true, nil, nil
					if not (c.args and c.args.pick) then
						ok, reason, vars = Rules.check(v, c.action, id, c.args, ctx(t.id))
					end
					local sub = if ok then S.pick(t.name) else Rules.message(reason :: string, lang(), vars)
					local _, right = Kit.row(list, t.icon, S.t("act_" .. c.action), sub)
					local b = Kit.button(right, S.t("use"), function()
						win.close()
						selectTool(t.id)
						perform(id, c, t.id)
					end, { Size = UDim2.fromOffset(100, 36) }, if ok then "primary" else nil)
					Kit.setEnabled(b, ok)
				end
			end
		end
	end
	-- removed parts can be moved to the tray
	local tn = Rules.tnode(v, id)
	if tn and tn.kind == "comp" and s and s.st == "out" then
		local _, right = Kit.row(list, "🗑️", S.t("act_discard"), pname or "")
		Kit.button(right, S.t("use"), function()
			win.close()
			send("discard", id, nil, "hand")
		end, { Size = UDim2.fromOffset(100, 36) }, "warn")
	end
end

----------------------------------------------------------------------------------------------------
-- hover / camera / input
----------------------------------------------------------------------------------------------------
-- The device node under the mouse (or under `at`, a viewport point, for touches).
local function pick(at: Vector2?): (string?, Vector3?, Vector3?)
	local h = handle()
	local cam = Workspace.CurrentCamera
	if not h or not cam then
		return nil, nil, nil
	end
	local m = at or UserInputService:GetMouseLocation()
	local ray = cam:ViewportPointToRay(m.X, m.Y)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { h.model }
	local hit = Workspace:Raycast(ray.Origin, ray.Direction * 60, params)
	if not hit then
		return nil, nil, nil
	end
	return h:nodeOf(hit.Instance), hit.Position, hit.Normal
end

local function updateHover(at: Vector2?)
	local v = view()
	if not v or Kit.currentWindow() then
		setAdornee(nil)
		setHint(nil)
		if toolModel then
			toolModel:PivotTo(CFrame.new(0, -500, 0))
		end
		return
	end
	if busy or holding then
		return -- the tool stays where the work is happening
	end
	local id, pos, normal = pick(at)
	if not id then
		hover = nil
		setAdornee(nil)
		setHint(S.t("bench_hint_pick"), true)
		if toolModel then
			toolModel:PivotTo(CFrame.new(0, -500, 0))
		end
		return
	end
	local c, ok, reason = resolve(v, id, toolId)
	hover = { id = id, c = c, ok = ok, pos = pos, normal = normal }
	local h = handle()
	local nodeModel = h and h.recs[id] and h.recs[id].model or (h and h.cables[id])
	setAdornee(nodeModel)
	highlight.OutlineColor = if c and ok then Theme.good elseif c then Theme.bad else Theme.dim
	local name = nodeLabel(v, id)
	local pname = partName(v, id)
	local title = name .. (if pname then " — " .. pname else "")
	if c then
		local act = S.t("act_" .. c.action)
		setHint("<b>" .. act .. "</b>  " .. title .. (if reason then "\n<font color=\"#ff8080\">" .. reason .. "</font>" else ""), ok)
	else
		setHint(title .. "\n<font color=\"#a0a6b4\">" .. stText(v.nodes[id] and v.nodes[id].st) .. "</font>", true)
	end
	-- the tool hovers just above the surface, tilted towards the camera
	if toolModel and pos and normal then
		local cam = Workspace.CurrentCamera
		local up = (normal + (cam.CFrame.Position - pos).Unit * 0.7).Unit
		local right = up:Cross(Vector3.yAxis)
		if right.Magnitude < 1e-3 then
			right = Vector3.xAxis
		end
		toolModel:PivotTo(CFrame.fromMatrix(pos + normal * 0.03, right.Unit, up))
	end
end

local function updateCamera()
	local cam = Workspace.CurrentCamera
	local root = active and BenchViews.rootOf(active.model)
	if not cam or not root then
		return
	end
	local focus = (root * CFrame.new(-0.4, 0.55, 0)).Position
	local offset = CFrame.Angles(0, orbit.yaw, 0) * CFrame.Angles(-orbit.pitch, 0, 0) * Vector3.new(0, 0, orbit.dist)
	local pos = (root.Rotation * CFrame.new(offset)).Position + focus
	cam.CFrame = CFrame.lookAt(pos, focus)
end

----------------------------------------------------------------------------------------------------
-- enter / exit
----------------------------------------------------------------------------------------------------
local function findBench(n: number): Model?
	local plots = Workspace:FindFirstChild("Plots")
	if not plots then
		return nil
	end
	for _, plot in plots:GetChildren() do
		local shop = plot:FindFirstChild("Shop")
		if shop and shop:GetAttribute("Owner") == player.UserId then
			return shop:FindFirstChild("Workbench_" .. n) :: Model?
		end
	end
	return nil
end

-- The bench screen uses both sides: Roblox's chat window and player list step aside meanwhile.
local function coreGui(on: boolean)
	for _, t in { Enum.CoreGuiType.Chat, Enum.CoreGuiType.PlayerList } do
		pcall(function()
			StarterGui:SetCoreGuiEnabled(t, on)
		end)
	end
end

local function exit()
	if not active then
		return
	end
	active = nil
	coreGui(true)
	for _, c in conns do
		c:Disconnect()
	end
	conns = {}
	ui.root.Visible = false
	ui.pickerFrame.Visible = false
	setAdornee(nil)
	if toolModel then
		toolModel:Destroy()
		toolModel = nil
	end
	Kit.closeWindow()
	hud.setVisible(true)
	local cam = Workspace.CurrentCamera
	if cam then
		cam.CameraType = Enum.CameraType.Custom
		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if hum then
			cam.CameraSubject = hum
		end
	end
end

local function enter(data)
	local model = findBench(data.bench)
	if not model then
		return
	end
	exit()
	-- the language was changed on the phone: rebuild the panels
	if ui.lang ~= S.lang() then
		ui.root:Destroy()
		highlight:Destroy()
		build()
	end
	active = { bench = data.bench, model = model, job = data.job }
	if data.view then
		BenchViews.apply(model, data.view, data.rev)
	end
	ui.root.Visible = true
	ui.title.Text = S.t("bench_title", { n = data.bench })
	hud.setVisible(false)
	coreGui(false)
	Kit.clear(ui.log)
	buildToolbar()
	jobCard()
	refreshDiag()
	if not data.job then
		showJobPicker()
	else
		ui.pickerFrame.Visible = false
	end
	local cam = Workspace.CurrentCamera
	cam.CameraType = Enum.CameraType.Scriptable
	orbit = { yaw = 0, pitch = 0.82, dist = 7.2 }
	table.insert(conns, RunService.RenderStepped:Connect(function()
		updateCamera()
		updateHover()
		if ui.money and State.data then
			ui.money.Text = S.money(State.data.money)
		end
	end))
	table.insert(conns, State.changed:Connect(function()
		buildToolbar()
		refreshDiag()
	end))
	table.insert(conns, State.jobsChanged:Connect(function()
		if active and not active.job and ui.pickerFrame.Visible then
			showJobPicker()
		end
	end))
end

----------------------------------------------------------------------------------------------------
-- building the bench UI (once)
----------------------------------------------------------------------------------------------------
local function diagButton(parent: Instance, id: string, text: string, onClick: () -> (), toolNeeded: string?, kind: string?)
	local b = Kit.button(parent, text, onClick, { Size = UDim2.new(1, 0, 0, 38), TextSize = 15 })
	b.Name = id
	if toolNeeded then
		b:SetAttribute("Tool", toolNeeded)
	end
	if kind then
		b:SetAttribute("Kind", kind)
	end
	ui.diag[id] = b
	return b
end

local function softwareMenu()
	local win = Kit.window(gui, "💾 " .. S.t("bench_usb"), Vector2.new(440, 380))
	local list = Kit.list(win.content)
	for _, prog in { "memtest", "smart", "antivirus", "os_install", "bios_update" } do
		local _, right = Kit.row(list, "💾", S.t("sw_" .. prog), nil)
		Kit.button(right, "▶", function()
			win.close()
			local secs = Config.SoftwareSeconds[prog] or 4
			BenchViews.monitor(active.model, S.t("sw_" .. prog) .. "\n\n" .. S.t("loading"), Color3.fromRGB(0, 40, 90))
			if holdFor(secs * 0.35, S.t("sw_" .. prog)) then
				send("software", nil, { program = prog }, "usb_boot")
			end
		end, { Size = UDim2.fromOffset(60, 36) }, "primary")
	end
end

function build()
	ui.lang = S.lang()
	ui.diag = {}
	local root = Kit.frame(gui, { Name = "Bench", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false })
	ui.root = root
	-- top bar
	local top = Kit.panel(root, { Size = UDim2.new(0, 520, 0, 46), Position = UDim2.new(0.5, 0, 0, 12), AnchorPoint = Vector2.new(0.5, 0), BackgroundTransparency = 0.1 })
	ui.title = Kit.label(top, "", { Size = UDim2.new(0.5, 0, 1, 0), Position = UDim2.fromOffset(14, 0), FontFace = Theme.heavy, TextSize = 20 })
	ui.money = Kit.label(top, "", { Size = UDim2.new(0.3, 0, 1, 0), Position = UDim2.new(0.42, 0, 0, 0), TextColor3 = Theme.money, FontFace = Theme.heavy, TextSize = 20 })
	Kit.button(top, S.t("bench_leave"), function()
		Net.request("bench.leave")
		exit()
	end, { Size = UDim2.fromOffset(100, 34), Position = UDim2.new(1, -108, 0, 6) }, "bad")

	-- left: job and findings
	local left = Kit.panel(root, { Size = UDim2.new(0, 300, 1, -150), Position = UDim2.fromOffset(12, 70), BackgroundTransparency = 0.12 })
	Kit.padding(left, 10)
	ui.jobInfo = Kit.frame(left, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y })
	Kit.listLayout(ui.jobInfo, 4)
	Kit.label(left, "📝 " .. S.t("bench_notes"), { FontFace = Theme.bold, Size = UDim2.new(1, 0, 0, 22), Position = UDim2.new(0, 0, 0.42, 0) })
	ui.log = Kit.list(left, { Size = UDim2.new(1, 0, 0.58, -26), Position = UDim2.new(0, 0, 0.42, 24) }, 4)

	-- right: tests and finishing
	local right = Kit.panel(root, { Size = UDim2.new(0, 210, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Position = UDim2.new(1, -222, 0, 70), BackgroundTransparency = 0.12 })
	Kit.padding(right, 10)
	Kit.listLayout(right, 6)
	diagButton(right, "power", "⏻ " .. S.t("bench_power"), function()
		send("press_power", nil, nil, "hand")
	end)
	diagButton(right, "stress", "🔥 " .. S.t("bench_stress"), function()
		if holdFor(1.5, S.t("bench_stress")) then
			send("stress", nil, nil, "hand")
		end
	end)
	diagButton(right, "post", "🃏 " .. S.t("bench_post"), function()
		send("post_code", nil, nil, "post_card")
	end, "post_card", "desktop")
	diagButton(right, "psu", "🔌 " .. S.t("bench_psu"), function()
		send("psu_test", nil, nil, "psu_tester")
	end, "psu_tester", "desktop")
	diagButton(right, "thermal", "🌡️ " .. S.t("bench_thermal"), function()
		send("thermal_view", nil, nil, "thermal_camera")
	end, "thermal_camera")
	diagButton(right, "usb", "💾 " .. S.t("bench_usb"), softwareMenu, "usb_boot")
	ui.strap = diagButton(right, "strap", "📿 " .. S.t("bench_strap"), function()
		local v = view()
		send("wear_strap", nil, { on = not (v and v.strap) }, "esd_strap")
	end, "esd_strap")
	diagButton(right, "flip", "🔄 " .. S.t("bench_flip"), function()
		send("flip", nil, nil, "hand")
	end, nil, "laptop")
	diagButton(right, "lid", "💻 " .. S.t("bench_lid"), function()
		send("lid", nil, nil, "hand")
	end, nil, "laptop")
	diagButton(right, "ties", "🧷 " .. S.t("bench_ties"), function()
		send("tie_cables", nil, nil, "hand")
	end, nil, "desktop")
	ui.unload = Kit.button(right, "📦 " .. S.t("bench_unload"), function()
		local r = Net.request("bench.unload")
		if r.ok then
			active.job = nil
			BenchViews.apply(active.model, nil)
			jobCard()
			refreshDiag()
			showJobPicker()
		end
	end, { Size = UDim2.new(1, 0, 0, 38), TextSize = 15 }, "ghost")
	ui.finish = Kit.button(right, "✅ " .. S.t("bench_finish"), function()
		local r = Net.request("repair.assess")
		local v = r.ok and r.verdict
		local win = Kit.window(gui, "✅ " .. S.t("bench_finish"), Vector2.new(460, 300))
		local body = Kit.frame(win.content, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, -50) })
		Kit.listLayout(body, 6)
		Kit.label(body, S.t("bench_finish_q"), { Size = UDim2.new(1, 0, 0, 40) })
		if v and not v.fixed then
			local why = {}
			if not v.assembled then
				table.insert(why, S.t("bench_not_assembled", { n = v.missing }))
			end
			local st = Rules.StageText[v.stage]
			if v.stage ~= "ok" and st then
				table.insert(why, S.pick(st))
			end
			for _, k in v.issues or {} do
				local it = Rules.IssueText[k]
				table.insert(why, if it then S.pick(it) else k)
			end
			Kit.label(body, "⚠️ " .. table.concat(why, "\n⚠️ "), { TextColor3 = Theme.warn, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextSize = 14 })
		elseif v then
			Kit.label(body, "👍 " .. S.t("bench_verdict_ok"), { TextColor3 = Theme.good })
		end
		Kit.button(win.content, S.t("confirm"), function()
			win.close()
			local f = Net.request("repair.finish")
			if not f.ok then
				hud.toast(S.err(f.err), "bad")
				return
			end
			if f.kept and f.kept > 0 then
				hud.toast(S.t("bench_kept", { n = f.kept }), "good")
			end
			if f.verdict.fixed then
				hud.toast(if f.own then S.t("bench_resale", { price = S.money(f.resale or 0) }) else S.t("bench_verdict_ok"), "good", 6)
			else
				hud.toast(S.t("bench_verdict_bad", { why = (Rules.StageText[f.verdict.stage] and S.pick(Rules.StageText[f.verdict.stage])) or f.verdict.stage }), "bad", 6)
			end
			active.job = nil
			BenchViews.apply(active.model, nil)
			jobCard()
			refreshDiag()
			showJobPicker()
		end, { Size = UDim2.new(0.48, 0, 0, 40), Position = UDim2.new(0, 0, 1, -42) }, "good")
		Kit.button(win.content, S.t("cancel"), function()
			win.close()
		end, { Size = UDim2.new(0.48, 0, 0, 40), Position = UDim2.new(0.52, 0, 1, -42) }, "ghost")
	end, { Size = UDim2.new(1, 0, 0, 42), TextSize = 16 }, "good")

	-- bottom: tools
	local bottom = Kit.panel(root, { Size = UDim2.new(0, 0, 0, 76), AutomaticSize = Enum.AutomaticSize.X, Position = UDim2.new(0.5, 0, 1, -12), AnchorPoint = Vector2.new(0.5, 1), BackgroundTransparency = 0.12 })
	Kit.padding(bottom, 8)
	ui.toolName = Kit.label(bottom, "", { Size = UDim2.new(1, 0, 0, 0), Position = UDim2.fromOffset(0, -30), TextXAlignment = Enum.TextXAlignment.Center, FontFace = Theme.bold, TextStrokeTransparency = 0.5 })
	ui.tools = Kit.frame(bottom, { BackgroundTransparency = 1, Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X })
	Kit.listLayout(ui.tools, 6, true)

	-- hint box: right above the tool bar, where the eyes are
	ui.hint = Kit.panel(root, { Size = UDim2.fromOffset(560, 0), AutomaticSize = Enum.AutomaticSize.Y, Position = UDim2.new(0.5, 0, 1, -98), AnchorPoint = Vector2.new(0.5, 1), BackgroundTransparency = 0.1, Visible = false })
	ui.hintStroke = ui.hint:FindFirstChildOfClass("UIStroke")
	ui.hintStroke.Thickness = 2
	Kit.padding(ui.hint, 8)
	ui.hintText = Kit.label(ui.hint, "", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextXAlignment = Enum.TextXAlignment.Center, TextSize = 16 })

	-- hold progress
	ui.hold = Kit.panel(root, { Size = UDim2.fromOffset(340, 64), Position = UDim2.new(0.5, 0, 0.62, 0), AnchorPoint = Vector2.new(0.5, 0.5), Visible = false })
	Kit.padding(ui.hold, 10)
	ui.holdLabel = Kit.label(ui.hold, "", { TextXAlignment = Enum.TextXAlignment.Center, FontFace = Theme.bold })
	ui.holdBar = Kit.progress(ui.hold, { Position = UDim2.fromOffset(0, 28), Size = UDim2.new(1, 0, 0, 12) }, Theme.accent2)

	-- thermal paste meter
	ui.paste = Kit.panel(root, { Size = UDim2.fromOffset(420, 90), Position = UDim2.new(0.5, 0, 0.62, 0), AnchorPoint = Vector2.new(0.5, 0.5), Visible = false })
	Kit.padding(ui.paste, 10)
	ui.pasteText = Kit.label(ui.paste, "", { TextXAlignment = Enum.TextXAlignment.Center, FontFace = Theme.bold })
	local track = Kit.frame(ui.paste, { Size = UDim2.new(1, 0, 0, 22), Position = UDim2.fromOffset(0, 30), BackgroundColor3 = Theme.bg })
	Kit.corner(track, UDim.new(0, 6))
	ui.pasteZone = Kit.frame(track, { BackgroundColor3 = Theme.good, BackgroundTransparency = 0.5 })
	ui.pasteFill = Kit.frame(track, { BackgroundColor3 = Color3.fromRGB(170, 172, 180), Size = UDim2.fromScale(0, 1), BackgroundTransparency = 0.15 })
	Kit.corner(ui.pasteFill, UDim.new(0, 6))
	Kit.label(ui.paste, S.t("paste_hint"), { Position = UDim2.fromOffset(0, 56), TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = Theme.dim, TextSize = 14 })

	-- job picker (when the bench is empty)
	ui.pickerFrame = Kit.panel(root, { Size = UDim2.fromOffset(560, 420), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), Visible = false })
	Kit.padding(ui.pickerFrame, 12)
	Kit.label(ui.pickerFrame, "🧰 " .. S.t("bench_pick"), { FontFace = Theme.heavy, TextSize = 20, Size = UDim2.new(1, 0, 0, 30) })
	ui.picker = Kit.list(ui.pickerFrame, { Size = UDim2.new(1, 0, 1, -40), Position = UDim2.fromOffset(0, 38) })

	highlight = Instance.new("Highlight")
	highlight.Name = "BenchHover"
	highlight.FillTransparency = 0.82
	highlight.FillColor = Color3.fromRGB(120, 220, 255)
	highlight.OutlineTransparency = 0
	highlight.DepthMode = Enum.HighlightDepthMode.Occluded
	highlight.Parent = gui
end

----------------------------------------------------------------------------------------------------
function BenchController.init(screen: ScreenGui, hudModule)
	gui = screen
	hud = hudModule
	build()
	Net.on("bench.open", enter)
	Net.on("bench.close", function()
		exit()
	end)

	UserInputService.InputBegan:Connect(function(input, processed)
		if not active then
			return
		end
		local t = input.UserInputType
		if t == Enum.UserInputType.MouseButton2 then
			dragging = true
			dragMoved = 0
			return
		end
		if processed then
			return
		end
		if t == Enum.UserInputType.Touch then
			-- a second tap ends the thermal paste squeeze; otherwise wait: tap acts, drag turns
			if holding and holding.paste then
				holding = nil
				return
			end
			touchStart = Vector2.new(input.Position.X, input.Position.Y)
			dragMoved = 0
			return
		end
		if t == Enum.UserInputType.MouseButton1 then
			if hover and hover.id and not Kit.currentWindow() then
				if hover.c and hover.ok then
					task.spawn(perform, hover.id, hover.c, toolId)
				else
					-- the hint already says why; offer everything that is possible instead
					task.spawn(nodeMenu, hover.id)
				end
			end
		elseif t == Enum.UserInputType.Keyboard then
			local k = input.KeyCode
			if k == Enum.KeyCode.Q then
				orbit.yaw -= 0.25
			elseif k == Enum.KeyCode.E then
				orbit.yaw += 0.25
			else
				local digits = { [Enum.KeyCode.One] = "1", [Enum.KeyCode.Two] = "2", [Enum.KeyCode.Three] = "3", [Enum.KeyCode.Four] = "4", [Enum.KeyCode.Five] = "5", [Enum.KeyCode.Six] = "6", [Enum.KeyCode.Seven] = "7", [Enum.KeyCode.Eight] = "8", [Enum.KeyCode.Nine] = "9", [Enum.KeyCode.Zero] = "0" }
				local d = digits[k]
				if d then
					for id, b in ui.toolButtons do
						if b:GetAttribute("Key") == d then
							selectTool(id)
						end
					end
				end
			end
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if not active then
			return
		end
		local t = input.UserInputType
		if t == Enum.UserInputType.Touch then
			-- a tap (not a drag) acts on the part under the finger; holds then run on their own
			local start = touchStart
			touchStart = nil
			if start and dragMoved < 12 and not Kit.currentWindow() and not holding then
				updateHover(Vector2.new(input.Position.X, input.Position.Y) + GuiService:GetGuiInset())
				if hover and hover.id then
					if hover.c and hover.ok then
						task.spawn(perform, hover.id, hover.c, toolId)
					else
						task.spawn(nodeMenu, hover.id)
					end
				end
			end
		elseif t == Enum.UserInputType.MouseButton1 then
			if holding and holding.t0 then
				local f = (os.clock() - holding.t0) / holding.dur
				if holding.paste then
					holding = nil -- release = stop squeezing
				elseif f < 1 then
					holding.cancelled = true
				end
			end
		elseif t == Enum.UserInputType.MouseButton2 then
			dragging = false
			if dragMoved < 6 and hover and hover.id and not Kit.currentWindow() then
				task.spawn(nodeMenu, hover.id)
			end
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if not active then
			return
		end
		local turning = (input.UserInputType == Enum.UserInputType.MouseMovement and dragging) or (input.UserInputType == Enum.UserInputType.Touch and touchStart ~= nil)
		if turning then
			dragMoved += math.abs(input.Delta.X) + math.abs(input.Delta.Y)
			orbit.yaw -= input.Delta.X * 0.008
			orbit.pitch = math.clamp(orbit.pitch + input.Delta.Y * 0.006, 0.15, 1.45)
		elseif input.UserInputType == Enum.UserInputType.MouseWheel then
			orbit.dist = math.clamp(orbit.dist - input.Position.Z * 0.6, 2.2, 14)
		end
	end)
	UserInputService.TouchPinch:Connect(function(_, scale, _, state)
		if active and state == Enum.UserInputState.Change then
			orbit.dist = math.clamp(orbit.dist / scale, 2.2, 14)
		end
	end)
end

function BenchController.active(): boolean
	return active ~= nil
end

-- tests: drive the bench without input
BenchController._candidates = candidates
BenchController._resolve = resolve
BenchController._view = view
function BenchController._act(id: string, tid: string)
	local v = view()
	local c, ok = resolve(v, id, tid)
	if c and ok then
		perform(id, c, tid)
	end
	return c, ok
end

return BenchController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="2065">
            <Properties>
              <string name="Name">BenchViews</string>
              <string name="Source"><![CDATA[-- BenchViews: draws the device sitting on every nearby workbench from the bench's "DeviceView"
-- attribute (so you see your staff and other players working), animates the changes, and plays
-- the power-on effects (spinning fans, RGB, the bench monitor's boot screen).

local CollectionService = game:GetService("CollectionService")
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local PCModel = require(Shared.Models.PCModel)
local Rules = require(Shared.Repair.RepairRules)
local S = require(script.Parent.Parent.Strings)

local BenchViews = {}

local RANGE_IN = 140
local RANGE_OUT = 190

local folder: Folder
local views: { [Model]: { [string]: any } } = {}
local spinning: { { rotor: Model, stop: number, speed: number } } = {}
local rgbParts: { [BasePart]: number } = {}

local function rootOf(bench: Model): CFrame?
	local anchor = bench:FindFirstChild("DeviceAnchor") :: BasePart?
	if not anchor then
		return nil
	end
	-- the technician looks at the device from the stool side
	return anchor.CFrame * CFrame.Angles(0, math.pi, 0)
end
BenchViews.rootOf = rootOf

local function decode(bench: Model): any
	local raw = bench:GetAttribute("DeviceView")
	if typeof(raw) ~= "string" or #raw == 0 then
		return nil
	end
	local ok, v = pcall(function()
		return HttpService:JSONDecode(raw)
	end)
	return if ok then v else nil
end

local function destroyView(bench: Model)
	local v = views[bench]
	if v and v.handle then
		v.handle:destroy()
	end
	views[bench] = nil
end

-- Shows `view` on the bench (rev guards against stale attribute updates).
function BenchViews.apply(bench: Model, view: any, rev: number?)
	local v = views[bench]
	if v and rev and v.rev and rev < v.rev then
		return
	end
	if not view then
		destroyView(bench)
		return
	end
	local root = rootOf(bench)
	if not root then
		return
	end
	local job = bench:GetAttribute("JobId")
	if v and v.handle and (v.handle.kind ~= view.kind or v.jobId ~= job or v.model ~= view.model) then
		destroyView(bench)
		v = nil
	end
	if not v then
		v = {}
		views[bench] = v
	end
	if not v.handle then
		local ok, h = pcall(PCModel.build, folder, view, root, { animate = true })
		if not ok then
			warn("[BenchViews] " .. tostring(h))
			views[bench] = nil
			return
		end
		v.handle = h
		h.model.Name = "Device_" .. bench:GetFullName()
	else
		local ok, err = pcall(function()
			v.handle:update(view)
		end)
		if not ok then
			warn("[BenchViews] " .. tostring(err))
		end
	end
	v.view = view
	v.rev = rev or v.rev
	v.jobId = job
	v.model = view.model
end

function BenchViews.handle(bench: Model)
	local v = views[bench]
	return v and v.handle or nil
end

function BenchViews.view(bench: Model)
	local v = views[bench]
	return v and v.view or nil
end

local function camPos(): Vector3
	local cam = Workspace.CurrentCamera
	return if cam then cam.CFrame.Position else Vector3.zero
end

local function near(bench: Model, range: number): boolean
	local anchor = bench:FindFirstChild("DeviceAnchor") :: BasePart?
	return anchor ~= nil and (anchor.Position - camPos()).Magnitude < range
end

local function refresh(bench: Model)
	if not bench:IsDescendantOf(Workspace) then
		destroyView(bench)
		return
	end
	if not near(bench, if views[bench] then RANGE_OUT else RANGE_IN) then
		destroyView(bench)
		return
	end
	BenchViews.apply(bench, decode(bench), bench:GetAttribute("DeviceRev"))
end

----------------------------------------------------------------------------------------------------
-- Power-on effects
----------------------------------------------------------------------------------------------------
function BenchViews.monitor(bench: Model, text: string, bg: Color3?)
	local mon = bench:FindFirstChild("BenchMonitor")
	local screen = mon and mon:FindFirstChild("Screen")
	local gui = screen and screen:FindFirstChild("ScreenGui")
	local label = gui and gui:FindFirstChildWhichIsA("TextLabel")
	if label then
		label.Text = text
		label.TextXAlignment = Enum.TextXAlignment.Left
		label.TextYAlignment = Enum.TextYAlignment.Top
		label.TextScaled = false
		label.TextSize = 13
		label.TextWrapped = true
		if bg then
			label.BackgroundColor3 = bg
		end
	end
end

function BenchViews.power(bench: Model, fx: { [string]: any })
	local h = BenchViews.handle(bench)
	if not h then
		return
	end
	local now = os.clock()
	local on = fx.stage ~= "no_power"
	if fx.fans then
		for _, d in h.model:GetDescendants() do
			if d:IsA("Model") and d.Name == "Rotor" then
				table.insert(spinning, { rotor = d, stop = now + 7, speed = 24 + math.random() * 10 })
			end
		end
	end
	for _, d in h.model:GetDescendants() do
		if d:IsA("BasePart") then
			if d:GetAttribute("RGB") and fx.rgb then
				rgbParts[d] = now + 7
			elseif d.Name == "PowerLed" and on then
				d.Transparency = 0
				task.delay(7, function()
					if d.Parent then
						d.Transparency = 0.7
					end
				end)
			end
		end
	end
	local stage = Rules.StageText[fx.stage]
	local text = if stage then S.pick(stage) else ""
	if fx.stage == "no_power" then
		BenchViews.monitor(bench, "", Color3.fromRGB(5, 5, 8))
	elseif fx.stage == "ok" then
		BenchViews.monitor(bench, "Windows\n\n" .. text, Color3.fromRGB(0, 90, 170))
	elseif fx.stage == "no_display" or fx.stage == "no_post" then
		BenchViews.monitor(bench, "NO SIGNAL", Color3.fromRGB(10, 10, 14))
	else
		BenchViews.monitor(bench, "BIOS POST\n\n" .. text, Color3.fromRGB(10, 10, 14))
	end
end

----------------------------------------------------------------------------------------------------
local function watch(bench: Model)
	if not bench:IsA("Model") then
		return
	end
	bench:GetAttributeChangedSignal("DeviceRev"):Connect(function()
		if near(bench, RANGE_OUT) then
			BenchViews.apply(bench, decode(bench), bench:GetAttribute("DeviceRev"))
		end
	end)
	bench:GetAttributeChangedSignal("PowerFx"):Connect(function()
		local raw = bench:GetAttribute("PowerFx")
		if typeof(raw) == "string" and near(bench, RANGE_OUT) then
			local ok, fx = pcall(function()
				return HttpService:JSONDecode(raw)
			end)
			if ok then
				-- let a pending device update land first
				task.defer(BenchViews.power, bench, fx)
			end
		end
	end)
	refresh(bench)
end

function BenchViews.init()
	folder = Instance.new("Folder")
	folder.Name = "BenchDevices"
	folder.Parent = Workspace
	for _, b in CollectionService:GetTagged("Workbench") do
		watch(b)
	end
	CollectionService:GetInstanceAddedSignal("Workbench"):Connect(watch)
	CollectionService:GetInstanceRemovedSignal("Workbench"):Connect(function(b)
		destroyView(b)
	end)
	-- distance culling
	task.spawn(function()
		while true do
			task.wait(1)
			for _, b in CollectionService:GetTagged("Workbench") do
				local has = views[b] ~= nil
				local want = near(b, if has then RANGE_OUT else RANGE_IN) and b:GetAttribute("DeviceView") ~= nil
				if has ~= want then
					refresh(b)
				end
			end
			for b in views do
				if not b.Parent then
					destroyView(b)
				end
			end
		end
	end)
	RunService.RenderStepped:Connect(function(dt)
		for _, v in views do
			if v.handle and v.handle:busy() then
				v.handle:step(dt)
			end
		end
		local now = os.clock()
		for i = #spinning, 1, -1 do
			local s = spinning[i]
			if now > s.stop or not s.rotor.Parent then
				table.remove(spinning, i)
			else
				local left = s.stop - now
				local speed = s.speed * math.min(1, left / 1.5)
				s.rotor:PivotTo(s.rotor:GetPivot() * CFrame.Angles(0, speed * dt, 0))
			end
		end
		for p, untilT in rgbParts do
			if now > untilT or not p.Parent then
				rgbParts[p] = nil
			else
				p.Color = Color3.fromHSV((now * 0.25 + p.Position.X * 0.05) % 1, 0.85, 1)
				p.Transparency = 0.15
			end
		end
	end)
end

return BenchViews
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="2066">
            <Properties>
              <string name="Name">MapController</string>
              <string name="Source"><![CDATA[-- MapController: the city map (M), the corner minimap and GPS directions.
--
-- Both maps are drawn from CityLayout (the same deterministic plan the server built the world
-- from), so nothing has to be streamed in to show far-away places. Positions use scale
-- coordinates inside a canvas: zooming only resizes the canvas, icons keep their size.
-- GPS routes run over the road graph; on the ground a trail of glowing arrows leads the way.

local Players = game:GetService("Players")
local GuiService = game:GetService("GuiService")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local CityLayout = require(Shared.World.CityLayout)
local Locations = require(Shared.Data.Locations)

local Client = script.Parent.Parent
local Kit = require(Client.UI.Kit)
local Theme = require(Client.UI.Theme)
local Hud = require(Client.UI.Hud)
local App = require(Client.UI.App)
local S = require(Client.Strings)

local MapController = {}

local player = Players.LocalPlayer
local L
local minX, minZ, W, H = 0, 0, 1, 1

local mapRoot: Frame? = nil
local viewport: Frame
local canvas: Frame
local nameLabels: { TextLabel } = {}
local plotMarks: { [number]: Frame } = {}
local miniPlotMarks: { [number]: Frame } = {}
local info: Frame
local zoom = 1
local baseScale = 0.3
local arrow: TextLabel
local othersHolder: Frame

local mini: Frame
local miniCanvas: Frame
local miniArrow: TextLabel
local MINI_SCALE = 0.42 -- pixels per stud on the minimap
local MINI_SIZE = 210
local gpsLabel: TextLabel

local gps = { target = nil :: Vector3?, name = "", points = {} :: { Vector3 } }
local routeFolders: { Frame } = {}
local trail: Folder
local arrows: { { BasePart } } = {}
local beacon: BasePart?

local function rgb(t): Color3
	return Color3.fromRGB(t[1], t[2], t[3])
end

local function sx(x: number): number
	return (x - minX) / W
end

local function sz(z: number): number
	return (z - minZ) / H
end

local function myRoot(): BasePart?
	local char = player.Character
	return char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function myPos(): Vector3?
	local root = myRoot()
	if root then
		return root.Position
	end
	local cam = Workspace.CurrentCamera
	return cam and cam.Focus.Position or nil
end

-- Screen pixels per GUI offset unit (Kit.screen shrinks the UI on small screens).
local function uiScale(): number
	local sc = App.screen and App.screen:FindFirstChildOfClass("UIScale")
	return if sc then sc.Scale else 1
end

-- Input positions don't include the top bar inset; our ScreenGui ignores it.
local function screenPoint(input: InputObject): Vector2
	local inset = GuiService:GetGuiInset()
	return Vector2.new(input.Position.X, input.Position.Y) + inset
end

local function heading(): number
	local cam = Workspace.CurrentCamera
	local look = if cam then cam.CFrame.LookVector else Vector3.new(0, 0, -1)
	return math.deg(math.atan2(look.X, -look.Z))
end

----------------------------------------------------------------------------------------------------
-- Drawing the city
----------------------------------------------------------------------------------------------------
local function rect(parent: Instance, x0: number, z0: number, x1: number, z1: number, color: Color3, zi: number): Frame
	local f = Instance.new("Frame")
	f.BorderSizePixel = 0
	f.BackgroundColor3 = color
	f.Position = UDim2.fromScale(sx(x0), sz(z0))
	f.Size = UDim2.fromScale((x1 - x0) / W, (z1 - z0) / H)
	f.ZIndex = zi
	f.Parent = parent
	return f
end

local function plotCenter(p): Vector3
	return (p.cf * CFrame.new(0, 0, p.depth / 2)).Position
end

local function poiColor(poi): Color3
	local cat = poi.def and Locations.categories[poi.def.cat]
	return if cat then rgb(cat.color) else Theme.accent
end

-- Draws everything into `c`; `big` adds names and clickable icons.
local function drawCity(c: Frame, big: boolean, marks: { [number]: Frame }, onPoi: ((any) -> ())?)
	c.BackgroundColor3 = Color3.fromRGB(118, 158, 100)
	local b = L.bounds
	-- hills in the north, beach and sea in the south
	rect(c, b.minX, b.minZ, b.maxX, CityLayout.ZS[1] - 40, Color3.fromRGB(98, 140, 86), 1)
	rect(c, b.minX, CityLayout.BEACH_Z, b.maxX, CityLayout.SEA_Z, Color3.fromRGB(236, 220, 170), 1)
	rect(c, b.minX, CityLayout.SEA_Z, b.maxX, b.maxZ, Color3.fromRGB(64, 140, 196), 1)
	for _, blk in L.blocks do
		local d = CityLayout.Districts[blk.district]
		local col = if d then rgb(d.color) else Color3.fromRGB(200, 200, 200)
		local f = rect(c, blk.x0, blk.z0, blk.x1, blk.z1, col:Lerp(Color3.new(1, 1, 1), 0.1), 2)
		if big then
			local corner = Instance.new("UICorner")
			corner.CornerRadius = UDim.new(0, 3)
			corner.Parent = f
		end
	end
	for _, r in L.roads do
		local hw = r.width / 2
		local x0, x1 = math.min(r.a.X, r.b.X) - hw, math.max(r.a.X, r.b.X) + hw
		local z0, z1 = math.min(r.a.Y, r.b.Y) - hw, math.max(r.a.Y, r.b.Y) + hw
		local col = if r.kind == "ring" then Color3.fromRGB(70, 72, 80) elseif r.kind == "main" then Color3.fromRGB(60, 62, 70) else Color3.fromRGB(84, 86, 94)
		rect(c, x0, z0, x1, z1, col, 3)
	end
	-- shop plots
	for _, p in L.plots do
		local center = plotCenter(p)
		local half = math.max(p.width, p.depth) / 2
		local m = rect(c, center.X - p.width / 2 + 2, center.Z - half + 2, center.X + p.width / 2 - 2, center.Z + half - 2, Color3.fromRGB(150, 150, 160), 4)
		m.BackgroundTransparency = 0.25
		m.Name = "Plot_" .. p.id
		local key = Instance.new("TextLabel")
		key.Name = "Key"
		key.BackgroundTransparency = 1
		key.Text = "🔑"
		key.TextScaled = true
		key.Size = UDim2.fromScale(0.7, 0.7)
		key.Position = UDim2.fromScale(0.15, 0.15)
		key.ZIndex = 5
		key.Visible = false
		key.Parent = m
		marks[p.id] = m
	end
	-- places
	for _, poi in L.pois do
		if poi.def and not poi.parent then
			local icon = Instance.new(if big then "TextButton" else "TextLabel") :: any
			icon.Name = "Poi_" .. poi.id
			if big then
				icon.AutoButtonColor = false
			end
			icon.Text = poi.def.icon or "📍"
			icon.TextScaled = true
			icon.BackgroundColor3 = poiColor(poi)
			icon.BackgroundTransparency = 0.1
			icon.AnchorPoint = Vector2.new(0.5, 0.5)
			icon.Position = UDim2.fromScale(sx(poi.pos.X), sz(poi.pos.Z))
			icon.Size = if big then UDim2.fromOffset(30, 30) else UDim2.fromOffset(18, 18)
			icon.ZIndex = 7
			icon.Parent = c
			local corner = Instance.new("UICorner")
			corner.CornerRadius = UDim.new(1, 0)
			corner.Parent = icon
			if big then
				local stroke = Instance.new("UIStroke")
				stroke.Color = Color3.new(1, 1, 1)
				stroke.Thickness = 2
				stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
				stroke.Parent = icon
				local name = Kit.label(c, S.pick(poi.def.name), {
					AnchorPoint = Vector2.new(0.5, 0),
					Position = UDim2.new(sx(poi.pos.X), 0, sz(poi.pos.Z), 18),
					Size = UDim2.fromOffset(150, 18),
					TextSize = 13,
					FontFace = Theme.bold,
					TextXAlignment = Enum.TextXAlignment.Center,
					TextStrokeTransparency = 0.35,
					ZIndex = 8,
					Visible = false,
				})
				table.insert(nameLabels, name)
				if onPoi then
					(icon :: TextButton).Activated:Connect(function()
						onPoi(poi)
					end)
				end
			end
		end
	end
end

-- Colours plots: yours, other players', free (with a key).
local function paintPlots(marks: { [number]: Frame })
	local owned = {}
	for _, p in Players:GetPlayers() do
		local id = p:GetAttribute("Plot")
		if typeof(id) == "number" then
			owned[id] = p
		end
	end
	for id, m in marks do
		local who = owned[id]
		local key = m:FindFirstChild("Key") :: TextLabel?
		if who == player then
			m.BackgroundColor3 = Theme.accent2
			m.BackgroundTransparency = 0
		elseif who then
			m.BackgroundColor3 = Color3.fromRGB(110, 130, 200)
			m.BackgroundTransparency = 0.15
		else
			m.BackgroundColor3 = Color3.fromRGB(90, 190, 110)
			m.BackgroundTransparency = 0.2
		end
		if key then
			key.Visible = who == nil and m.AbsoluteSize.X > 10
		end
	end
end

----------------------------------------------------------------------------------------------------
-- Route drawing (both maps) and the trail on the ground
----------------------------------------------------------------------------------------------------
local function segment(parent: Instance, a: Vector3, b: Vector3, thickness: number, color: Color3)
	local mx, mz = (a.X + b.X) / 2, (a.Z + b.Z) / 2
	local f = Instance.new("Frame")
	f.BorderSizePixel = 0
	f.BackgroundColor3 = color
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.Position = UDim2.fromScale(sx(mx), sz(mz))
	local dx, dz = b.X - a.X, b.Z - a.Z
	if math.abs(dz) < 0.5 then
		-- along a street: scale sizes stay exact at every zoom
		f.Size = UDim2.new(math.abs(dx) / W, thickness, 0, thickness)
	elseif math.abs(dx) < 0.5 then
		f.Size = UDim2.new(0, thickness, math.abs(dz) / H, thickness)
	else
		-- the short diagonal bits to and from the road (the canvas is scaled uniformly)
		local len = math.sqrt(dx * dx + dz * dz)
		f.Size = UDim2.new(len / W, 0, 0, thickness)
		f.Rotation = math.deg(math.atan2(dz, dx))
	end
	f.ZIndex = 6
	f.Parent = parent
end

local function drawRoute()
	for _, holder in routeFolders do
		Kit.clear(holder)
		for i = 2, #gps.points do
			segment(holder, gps.points[i - 1], gps.points[i], if holder:GetAttribute("Mini") then 4 else 5, Theme.accent)
		end
	end
end

local function v3(p: Vector2, y: number): Vector3
	return Vector3.new(p.X, y, p.Y)
end

local function pathLength(keys: { string }): number
	local len = 0
	for i = 2, #keys do
		local a, b = L.nodes[keys[i - 1]], L.nodes[keys[i]]
		len += math.abs(a.x - b.x) + math.abs(a.z - b.z)
	end
	return len
end

-- Road route from a position to a position: via the nearest road, the intersection graph and
-- the road next to the target.
local function routePoints(from: Vector3, to: Vector3): { Vector3 }
	local y = CityLayout.ROAD_Y + 0.2
	local road, q = CityLayout.nearestRoad(from)
	local roadT, qt = CityLayout.nearestRoad(to)
	if not road or not roadT or not q or not qt then
		return { from, to }
	end
	local start = v3(q, y)
	local finish = v3(qt, y)
	if road == roadT then
		return { from, start, finish, to }
	end
	local best, bestLen = nil, math.huge
	for _, s in { road.from, road.to } do
		for _, e in { roadT.from, roadT.to } do
			local keys = CityLayout.route(s, e)
			local sn, en = L.nodes[s], L.nodes[e]
			local len = math.abs(sn.x - q.X) + math.abs(sn.z - q.Y) + pathLength(keys) + math.abs(en.x - qt.X) + math.abs(en.z - qt.Y)
			if len < bestLen then
				best, bestLen = keys, len
			end
		end
	end
	local pts = { from, start }
	for _, k in best or {} do
		local n = L.nodes[k]
		table.insert(pts, Vector3.new(n.x, y, n.z))
	end
	table.insert(pts, finish)
	table.insert(pts, to)
	return pts
end

local function clearTrail()
	for _, a in arrows do
		a[1].Parent = nil
		a[2].Parent = nil
	end
	if beacon then
		beacon.Parent = nil
	end
end

local function trailBar(): BasePart
	local p = Instance.new("Part")
	p.Name = "GpsArrow"
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.Neon
	p.Size = Vector3.new(0.35, 0.08, 1.56)
	return p
end

-- Glowing chevrons on the road for the next stretch of the route.
local CHEVRON = math.atan2(1, 1.2)
local function updateTrail()
	local pts = gps.points
	if #pts < 2 then
		clearTrail()
		return
	end
	local spacing, maxLen = 9, 260
	local used, carry, walked = 0, 0, 0
	for i = 2, #pts do
		local a, b = pts[i - 1], pts[i]
		local seg = Vector3.new(b.X - a.X, 0, b.Z - a.Z)
		local len = seg.Magnitude
		if len > 0.5 then
			local dir = seg / len
			local t = carry
			while t < len and walked + t < maxLen do
				used += 1
				local arrow = arrows[used]
				if not arrow then
					arrow = { trailBar(), trailBar() }
					arrows[used] = arrow
				end
				local pos = Vector3.new(a.X + dir.X * t, CityLayout.ROAD_Y + 0.12, a.Z + dir.Z * t)
				local cf = CFrame.lookAt(pos, pos + dir)
				-- "^" pointing along the route (forward is -Z)
				arrow[1].CFrame = cf * CFrame.new(-0.5, 0, -0.4) * CFrame.Angles(0, -CHEVRON, 0)
				arrow[2].CFrame = cf * CFrame.new(0.5, 0, -0.4) * CFrame.Angles(0, CHEVRON, 0)
				for _, bar in arrow do
					bar.Color = Theme.accent
					bar.Parent = trail
				end
				t += spacing
			end
			walked += len
			carry = math.max(0, t - len)
			if walked >= maxLen then
				break
			end
		end
	end
	for i = used + 1, #arrows do
		arrows[i][1].Parent = nil
		arrows[i][2].Parent = nil
	end
	-- a tall beam over the destination, visible from far away
	if gps.target then
		if not beacon then
			local p = Instance.new("Part")
			p.Name = "GpsBeacon"
			p.Shape = Enum.PartType.Cylinder
			p.Anchored = true
			p.CanCollide = false
			p.CanQuery = false
			p.CanTouch = false
			p.CastShadow = false
			p.Material = Enum.Material.Neon
			p.Transparency = 0.55
			p.Size = Vector3.new(160, 2.2, 2.2)
			beacon = p
		end
		local bp = beacon :: BasePart
		bp.Color = Theme.accent2
		bp.CFrame = CFrame.new(gps.target + Vector3.new(0, 80, 0)) * CFrame.Angles(0, 0, math.pi / 2)
		bp.Parent = trail
	end
end

function MapController.navigate(pos: Vector3, name: string)
	gps.target = pos
	gps.name = name
	gps.points = {}
	MapController.refreshRoute()
end

function MapController.clearRoute()
	gps.target = nil
	gps.points = {}
	drawRoute()
	clearTrail()
	if gpsLabel then
		gpsLabel.Parent.Visible = false
	end
end

function MapController.refreshRoute()
	local target = gps.target
	local pos = myPos()
	if not target or not pos then
		return
	end
	local dist = (Vector3.new(pos.X, 0, pos.Z) - Vector3.new(target.X, 0, target.Z)).Magnitude
	if dist < 30 then
		Hud.toast(S.t("gps_arrived", { name = gps.name }), "good")
		MapController.clearRoute()
		return
	end
	gps.points = routePoints(pos, target)
	drawRoute()
	updateTrail()
	if gpsLabel then
		gpsLabel.Parent.Visible = true
		-- 1 stud ≈ 0.28 m
		gpsLabel.Text = "📍 " .. S.t("gps_dist", { name = gps.name, d = math.floor(dist * 0.28 + 0.5) })
	end
end

----------------------------------------------------------------------------------------------------
-- The big map
----------------------------------------------------------------------------------------------------
local selectPoi

local function fareTo(pos: Vector3): number
	local me = myPos()
	local d = if me then (me - pos).Magnitude else 0
	return math.floor(Config.TaxiBaseFare + d * Config.TaxiPerStud)
end

local function showInfo(title: string, icon: string, desc: string, pos: Vector3?, poiId: string?, home: boolean?)
	Kit.clear(info)
	if not info:FindFirstChildOfClass("UIListLayout") then
		Kit.listLayout(info, 8)
	end
	Kit.label(info, icon .. " <b>" .. title .. "</b>", { TextSize = 20, LayoutOrder = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y })
	if #desc > 0 then
		Kit.label(info, desc, { TextColor3 = Theme.dim, TextSize = 14, LayoutOrder = 2, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y })
	end
	local me = myPos()
	if pos and me then
		Kit.label(info, "↔ " .. math.floor((me - pos).Magnitude * 0.28) .. " m", { LayoutOrder = 3, TextSize = 14 })
	end
	if pos then
		Kit.button(info, "🧭 " .. S.t("map_route"), function()
			MapController.navigate(pos, title)
			MapController.close()
		end, { Size = UDim2.new(1, 0, 0, 38), LayoutOrder = 4 }, "primary")
	end
	if home then
		Kit.button(info, "🏠 " .. S.t("home"), function()
			MapController.close()
			local r = Net.request("travel.home")
			if not r.ok then
				Hud.toast(S.err(r.err, { wait = r.wait }), "bad")
			end
		end, { Size = UDim2.new(1, 0, 0, 38), LayoutOrder = 5 }, "good")
	elseif poiId and pos then
		Kit.button(info, "🚕 " .. S.t("map_taxi", { price = S.money(fareTo(pos)) }), function()
			local r = Net.request("travel.taxi", poiId)
			if r.ok then
				MapController.close()
				Hud.toast(S.t("taxi_paid", { fare = S.money(r.fare or 0) }), "info")
			else
				App.report(r)
			end
		end, { Size = UDim2.new(1, 0, 0, 38), LayoutOrder = 5 }, "warn")
	end
	if gps.target then
		Kit.button(info, "✖ " .. S.t("map_clear"), function()
			MapController.clearRoute()
			selectPoi(nil)
		end, { Size = UDim2.new(1, 0, 0, 34), LayoutOrder = 6 }, "ghost")
	end
end

-- The side panel: the selected place, or a list of the places that matter for the game.
function selectPoi(poi)
	if poi then
		showInfo(S.pick(poi.def.name), poi.def.icon or "📍", S.pick(poi.def.desc), poi.door or poi.pos, poi.id)
		return
	end
	Kit.clear(info)
	local list = Kit.list(info, nil, 4)
	local n = 0
	local function entry(icon: string, text: string, fn: () -> ())
		n += 1
		local b = Kit.button(list, icon .. "  " .. text, fn, { Size = UDim2.new(1, 0, 0, 34), LayoutOrder = n, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left })
		local pad = Instance.new("UIPadding")
		pad.PaddingLeft = UDim.new(0, 8)
		pad.Parent = b
	end
	local plotId = player:GetAttribute("Plot")
	local myPlot = typeof(plotId) == "number" and L.plots[plotId]
	if myPlot then
		entry("🏪", S.t("map_shop"), function()
			showInfo(S.t("map_shop"), "🏪", "", plotCenter(myPlot), nil, true)
		end)
	end
	for _, poi in L.pois do
		if poi.def and poi.def.service then
			entry(poi.def.icon or "📍", S.pick(poi.def.name), function()
				selectPoi(poi)
			end)
		end
	end
	if gps.target then
		entry("✖", S.t("map_clear"), function()
			MapController.clearRoute()
			selectPoi(nil)
		end)
	end
end

local function canvasSize(): Vector2
	return Vector2.new(W * baseScale * zoom, H * baseScale * zoom)
end

-- The view's size in GUI units (canvas offsets are in GUI units, not screen pixels).
local function viewSize(): Vector2
	return viewport.AbsoluteSize / uiScale()
end

-- anchor: a point in the view, in GUI units
local function setZoom(z: number, anchor: Vector2?)
	local vp = viewSize()
	local pivot = anchor or vp / 2
	local old = canvasSize()
	local pos = Vector2.new(canvas.Position.X.Offset, canvas.Position.Y.Offset)
	-- world point under the pivot stays put
	local fx, fy = (pivot.X - pos.X) / old.X, (pivot.Y - pos.Y) / old.Y
	zoom = math.clamp(z, 1, 7)
	local new = canvasSize()
	canvas.Size = UDim2.fromOffset(new.X, new.Y)
	canvas.Position = UDim2.fromOffset(pivot.X - fx * new.X, pivot.Y - fy * new.Y)
	for _, l in nameLabels do
		l.Visible = zoom >= 2.2
	end
	paintPlots(plotMarks)
end

local function centerOn(pos: Vector3)
	local vp = viewSize()
	local size = canvasSize()
	canvas.Position = UDim2.fromOffset(vp.X / 2 - sx(pos.X) * size.X, vp.Y / 2 - sz(pos.Z) * size.Y)
end

local function buildBig()
	local root = Kit.panel(App.screen, { Name = "Map", Size = UDim2.new(1, -40, 1, -40), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = Theme.panel, Visible = false, ZIndex = 20 })
	mapRoot = root
	Kit.label(root, "🗺️ " .. S.t("map_title"), { Size = UDim2.new(1, -80, 0, 40), Position = UDim2.fromOffset(16, 4), FontFace = Theme.heavy, TextSize = 22 })
	Kit.button(root, "✕", function()
		MapController.close()
	end, { Size = UDim2.fromOffset(36, 36), Position = UDim2.new(1, -46, 0, 6) })
	Kit.label(root, S.t("map_hint"), { Size = UDim2.new(1, -330, 0, 20), Position = UDim2.new(0, 16, 1, -26), TextColor3 = Theme.dim, TextSize = 13 })
	viewport = Kit.frame(root, { Name = "View", Size = UDim2.new(1, -330, 1, -80), Position = UDim2.fromOffset(12, 48), BackgroundColor3 = Color3.fromRGB(64, 140, 196), ClipsDescendants = true })
	Kit.corner(viewport, UDim.new(0, 10))
	canvas = Kit.frame(viewport, { Name = "Canvas", BackgroundColor3 = Color3.fromRGB(118, 158, 100) })
	drawCity(canvas, true, plotMarks, function(poi)
		selectPoi(poi)
	end)
	local route = Kit.frame(canvas, { Name = "Route", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 6 })
	table.insert(routeFolders, route)
	othersHolder = Kit.frame(canvas, { Name = "Others", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 9 })
	arrow = Kit.label(canvas, "▲", { Name = "Me", AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(26, 26), TextSize = 24, TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = Color3.new(1, 1, 1), TextStrokeTransparency = 0, TextStrokeColor3 = Theme.bad, ZIndex = 12 })

	-- side panel and legend
	local side = Kit.panel(root, { Size = UDim2.new(0, 300, 1, -80), Position = UDim2.new(1, -312, 0, 48), BackgroundColor3 = Theme.card })
	Kit.padding(side, 10)
	info = Kit.frame(side, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, -150) })
	local legend = Kit.frame(side, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 140), Position = UDim2.new(0, 0, 1, -140) })
	local grid = Instance.new("UIGridLayout")
	grid.CellSize = UDim2.new(0.5, -4, 0, 18)
	grid.CellPadding = UDim2.fromOffset(4, 2)
	grid.Parent = legend
	local legendItems = {
		{ Theme.accent2, S.t("map_shop") },
		{ Color3.fromRGB(90, 190, 110), S.t("map_free_plot") },
	}
	for _, cat in { "shop", "market", "vehicle", "business", "food", "leisure", "civic", "landmark" } do
		local c = Locations.categories[cat]
		table.insert(legendItems, { rgb(c.color), S.pick(c.name) })
	end
	for _, it in legendItems do
		local row = Kit.frame(legend, { BackgroundTransparency = 1 })
		local dot = Kit.frame(row, { Size = UDim2.fromOffset(12, 12), Position = UDim2.fromOffset(0, 3), BackgroundColor3 = it[1] })
		Kit.corner(dot, UDim.new(1, 0))
		Kit.label(row, it[2], { Size = UDim2.new(1, -16, 1, 0), Position = UDim2.fromOffset(16, 0), TextSize = 12, TextColor3 = Theme.dim, TextWrapped = false, TextTruncate = Enum.TextTruncate.AtEnd })
	end

	-- pan and zoom
	local dragging, last = false, Vector2.zero
	local function inside(p: Vector2): boolean
		local a, s = viewport.AbsolutePosition, viewport.AbsoluteSize
		return p.X >= a.X and p.Y >= a.Y and p.X <= a.X + s.X and p.Y <= a.Y + s.Y
	end
	UserInputService.InputBegan:Connect(function(input)
		if not root.Visible then
			return
		end
		local t = input.UserInputType
		if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
			local p = screenPoint(input)
			if inside(p) then
				dragging, last = true, p
			end
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if not root.Visible then
			return
		end
		local t = input.UserInputType
		if dragging and (t == Enum.UserInputType.MouseMovement or t == Enum.UserInputType.Touch) then
			local p = screenPoint(input)
			local d = (p - last) / uiScale()
			last = p
			canvas.Position = UDim2.fromOffset(canvas.Position.X.Offset + d.X, canvas.Position.Y.Offset + d.Y)
		elseif t == Enum.UserInputType.MouseWheel then
			local p = screenPoint(input)
			if inside(p) then
				setZoom(zoom * (if input.Position.Z > 0 then 1.2 else 1 / 1.2), (p - viewport.AbsolutePosition) / uiScale())
			end
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		local t = input.UserInputType
		if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
	UserInputService.TouchPinch:Connect(function(_, scale, _, state)
		if root.Visible and state == Enum.UserInputState.Change then
			setZoom(zoom * scale)
		end
	end)
end

local function updateBig()
	if not mapRoot or not mapRoot.Visible then
		return
	end
	local pos = myPos()
	if pos then
		arrow.Position = UDim2.fromScale(sx(pos.X), sz(pos.Z))
		arrow.Rotation = heading()
	end
	-- other players
	Kit.clear(othersHolder)
	for _, p in Players:GetPlayers() do
		if p ~= player then
			local char = p.Character
			local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
			if root then
				local dot = Kit.frame(othersHolder, { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(10, 10), Position = UDim2.fromScale(sx(root.Position.X), sz(root.Position.Z)), BackgroundColor3 = Color3.fromRGB(110, 150, 255), ZIndex = 10 })
				Kit.corner(dot, UDim.new(1, 0))
			end
		end
	end
end

function MapController.open()
	if not mapRoot then
		buildBig()
	end
	Kit.closeWindow()
	local root = mapRoot :: Frame
	root.Visible = true
	-- the whole city fits the view at zoom 1
	local vp = viewSize()
	baseScale = math.min(vp.X / W, vp.Y / H)
	setZoom(2.2)
	local pos = myPos()
	if pos then
		centerOn(pos)
	end
	selectPoi(nil)
	updateBig()
end

function MapController.close()
	if mapRoot then
		mapRoot.Visible = false
	end
end

function MapController.toggle()
	if mapRoot and mapRoot.Visible then
		MapController.close()
	else
		MapController.open()
	end
end

-- After a language change: the big map is drawn again on its next opening.
function MapController.relabel()
	if mapRoot then
		mapRoot:Destroy()
		mapRoot = nil
		table.clear(nameLabels)
		table.clear(plotMarks)
		for i = #routeFolders, 1, -1 do
			if not routeFolders[i]:GetAttribute("Mini") then
				table.remove(routeFolders, i)
			end
		end
	end
end

function MapController.isOpen(): boolean
	return mapRoot ~= nil and mapRoot.Visible
end

----------------------------------------------------------------------------------------------------
-- Minimap
----------------------------------------------------------------------------------------------------
local function buildMini()
	-- bottom-left with a mouse; on phones the thumbstick lives there, so top-right instead
	local touch = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	local miniPos = if touch then UDim2.new(1, -16, 0, 60) else UDim2.new(0, 16, 1, -16)
	local miniAnchor = if touch then Vector2.new(1, 0) else Vector2.new(0, 1)
	mini = Kit.panel(App.screen, { Name = "Minimap", Size = UDim2.fromOffset(MINI_SIZE, MINI_SIZE), Position = miniPos, AnchorPoint = miniAnchor, BackgroundColor3 = Color3.fromRGB(64, 140, 196), ClipsDescendants = true })
	Hud.register(mini)
	Kit.outline(mini, Color3.new(1, 1, 1), 3, 0.2)
	miniCanvas = Kit.frame(mini, { Name = "Canvas", Size = UDim2.fromOffset(W * MINI_SCALE, H * MINI_SCALE) })
	drawCity(miniCanvas, false, miniPlotMarks, nil)
	local route = Kit.frame(miniCanvas, { Name = "Route", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 6 })
	route:SetAttribute("Mini", true)
	table.insert(routeFolders, route)
	miniArrow = Kit.label(mini, "▲", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(22, 22), TextSize = 20, TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = Color3.new(1, 1, 1), TextStrokeTransparency = 0, TextStrokeColor3 = Theme.bad, ZIndex = 12 })
	Kit.label(mini, "N", { Size = UDim2.fromOffset(20, 20), Position = UDim2.new(0.5, -10, 0, 2), TextXAlignment = Enum.TextXAlignment.Center, FontFace = Theme.heavy, TextStrokeTransparency = 0.3, ZIndex = 12 })
	local open = Instance.new("TextButton")
	open.BackgroundTransparency = 1
	open.Text = ""
	open.Size = UDim2.fromScale(1, 1)
	open.ZIndex = 13
	open.Parent = mini
	open.Activated:Connect(MapController.open)
	-- GPS: where you're heading and how far, above the minimap
	local gpsPos = if touch then UDim2.new(1, -16, 0, 60 + MINI_SIZE + 8) else UDim2.new(0, 16, 1, -24 - MINI_SIZE)
	local g = Kit.panel(App.screen, { Name = "Gps", Size = UDim2.fromOffset(300, 34), Position = gpsPos, AnchorPoint = miniAnchor, BackgroundTransparency = 0.1, Visible = false })
	Hud.register(g)
	gpsLabel = Kit.label(g, "", { Size = UDim2.new(1, -44, 1, 0), Position = UDim2.fromOffset(10, 0), TextSize = 15, FontFace = Theme.bold, TextWrapped = false, TextTruncate = Enum.TextTruncate.AtEnd })
	Kit.button(g, "✖", function()
		MapController.clearRoute()
	end, { Size = UDim2.fromOffset(28, 28), Position = UDim2.new(1, -31, 0, 3), TextSize = 14 })
end

local function updateMini()
	local pos = myPos()
	if not pos or not mini then
		return
	end
	miniCanvas.Position = UDim2.fromOffset(MINI_SIZE / 2 - sx(pos.X) * W * MINI_SCALE, MINI_SIZE / 2 - sz(pos.Z) * H * MINI_SCALE)
	miniArrow.Rotation = heading()
end

function MapController.setMinimapVisible(on: boolean)
	if mini then
		mini.Visible = on
	end
end

----------------------------------------------------------------------------------------------------
function MapController.init()
	L = CityLayout.get()
	minX, minZ = L.bounds.minX, L.bounds.minZ
	W, H = L.bounds.maxX - L.bounds.minX, L.bounds.maxZ - L.bounds.minZ
	trail = Instance.new("Folder")
	trail.Name = "GpsTrail"
	trail.Parent = Workspace
	buildMini()
	paintPlots(miniPlotMarks)
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if input.KeyCode == Enum.KeyCode.M then
			MapController.toggle()
		elseif input.KeyCode == Enum.KeyCode.Escape and MapController.isOpen() then
			MapController.close()
		end
	end)
	local acc, routeAcc = 0, 0
	RunService.RenderStepped:Connect(function(dt)
		updateMini()
		acc += dt
		routeAcc += dt
		if acc > 0.25 then
			acc = 0
			updateBig()
		end
		if routeAcc > 0.6 then
			routeAcc = 0
			if gps.target then
				MapController.refreshRoute()
			end
		end
	end)
	-- plot ownership changes when players come, go or move
	local function watch(p: Player)
		p:GetAttributeChangedSignal("Plot"):Connect(function()
			paintPlots(miniPlotMarks)
			if mapRoot then
				paintPlots(plotMarks)
			end
		end)
	end
	for _, p in Players:GetPlayers() do
		watch(p)
	end
	Players.PlayerAdded:Connect(watch)
	Players.PlayerRemoving:Connect(function()
		task.defer(function()
			paintPlots(miniPlotMarks)
			if mapRoot then
				paintPlots(plotMarks)
			end
		end)
	end)
end

return MapController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="2067">
            <Properties>
              <string name="Name">Sky</string>
              <string name="Source"><![CDATA[-- Sky: flocks of birds (gulls by the sea, pigeons over town) wheeling around the player, an
-- airliner crossing high above now and then, and hot-air balloons drifting over the city.
-- Everything is local to each client and made of a handful of parts.

local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local CityLayout = require(Shared.World.CityLayout)

local Sky = {}

local rng = Random.new()
local folder: Folder

local FLOCKS = 4
local BIRDS_PER_FLOCK = 7

local function part(size: Vector3, color: Color3, material: Enum.Material?, shape: Enum.PartType?): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Size = size
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	if shape then
		p.Shape = shape
	end
	p.Parent = folder
	return p
end

local function camPos(): Vector3
	local cam = Workspace.CurrentCamera
	return if cam then cam.CFrame.Position else Vector3.zero
end

----------------------------------------------------------------------------------------------------
-- Birds
----------------------------------------------------------------------------------------------------
local flocks = {}

local function placeFlock(f)
	local c = camPos()
	local center = Vector3.new(c.X + rng:NextNumber(-260, 260), 0, c.Z + rng:NextNumber(-260, 260))
	local seaside = center.Z > CityLayout.BEACH_Z - 120
	f.center = center
	f.height = rng:NextNumber(42, 85)
	f.radius = rng:NextNumber(25, 60)
	f.speed = rng:NextNumber(0.25, 0.45) * (if rng:NextNumber() < 0.5 then 1 else -1)
	local color = if seaside then Color3.fromRGB(244, 244, 240) else Color3.fromRGB(120, 124, 132)
	for _, b in f.birds do
		b.body.Color = color
		b.wingL.Color = color
		b.wingR.Color = color
	end
end

local function makeFlock()
	local f = { birds = {}, t = rng:NextNumber() * 10 }
	for i = 1, BIRDS_PER_FLOCK do
		table.insert(f.birds, {
			body = part(Vector3.new(0.45, 0.35, 1.1), Color3.new(1, 1, 1), nil, Enum.PartType.Ball),
			wingL = part(Vector3.new(1.3, 0.06, 0.45), Color3.new(1, 1, 1)),
			wingR = part(Vector3.new(1.3, 0.06, 0.45), Color3.new(1, 1, 1)),
			offset = i / BIRDS_PER_FLOCK * math.pi * 2 * rng:NextNumber(0.85, 1.15),
			lag = rng:NextNumber(-4, 4),
			phase = rng:NextNumber() * 6,
		})
	end
	placeFlock(f)
	return f
end

local function stepFlock(f, dt: number, parts: { BasePart }, cfs: { CFrame })
	f.t += dt
	local c = camPos()
	if (Vector3.new(f.center.X, 0, f.center.Z) - Vector3.new(c.X, 0, c.Z)).Magnitude > 520 then
		placeFlock(f)
	end
	for _, b in f.birds do
		local a = f.t * f.speed + b.offset
		local r = f.radius + b.lag
		local pos = f.center + Vector3.new(math.cos(a) * r, f.height + math.sin(f.t * 0.6 + b.phase) * 3, math.sin(a) * r)
		local dir = Vector3.new(-math.sin(a), 0, math.cos(a)) * math.sign(f.speed)
		local body = CFrame.lookAt(pos, pos + dir)
		local flap = math.sin(f.t * 11 + b.phase) * 0.7
		table.insert(parts, b.body)
		table.insert(cfs, body)
		table.insert(parts, b.wingL)
		table.insert(cfs, body * CFrame.Angles(0, 0, flap) * CFrame.new(-0.7, 0, 0))
		table.insert(parts, b.wingR)
		table.insert(cfs, body * CFrame.Angles(0, 0, -flap) * CFrame.new(0.7, 0, 0))
	end
end

----------------------------------------------------------------------------------------------------
-- Airliner
----------------------------------------------------------------------------------------------------
local plane = nil :: Model?
local flight = nil :: any
local nextFlight = 25

local function buildPlane(): Model
	local m = Instance.new("Model")
	m.Name = "Airliner"
	local white = Color3.fromRGB(240, 242, 246)
	-- built at the origin facing -Z; an invisible root keeps that frame for PivotTo
	local root = part(Vector3.new(1, 1, 1), white)
	root.Name = "Root"
	root.Transparency = 1
	root.CFrame = CFrame.new()
	root.Parent = m
	m.PrimaryPart = root
	local function add(p: BasePart, cf: CFrame)
		p.CFrame = cf
		p.Parent = m
	end
	local f = CFrame.new()
	-- cylinders lie along X: turned along the fuselage
	add(part(Vector3.new(46, 4.4, 4.4), white, nil, Enum.PartType.Cylinder), f * CFrame.Angles(0, math.pi / 2, 0))
	add(part(Vector3.new(4.4, 4.4, 4.4), white, nil, Enum.PartType.Ball), f * CFrame.new(0, 0, -23))
	add(part(Vector3.new(36, 0.6, 7), white), f * CFrame.new(0, -1, -2))
	add(part(Vector3.new(13, 0.5, 4), white), f * CFrame.new(0, 0.8, 21))
	add(part(Vector3.new(0.6, 8, 6), Color3.fromRGB(200, 30, 40)), f * CFrame.new(0, 5, 21))
	add(part(Vector3.new(4.5, 0.4, 44), Color3.fromRGB(30, 80, 170)), f * CFrame.new(0, -0.6, 0))
	for s = -1, 1, 2 do
		add(part(Vector3.new(6, 2.4, 2.4), Color3.fromRGB(190, 192, 198), nil, Enum.PartType.Cylinder), f * CFrame.new(s * 8, -2.4, -4) * CFrame.Angles(0, math.pi / 2, 0))
		local light = part(Vector3.new(0.5, 0.5, 0.5), if s < 0 then Color3.fromRGB(255, 40, 40) else Color3.fromRGB(40, 255, 90), Enum.Material.Neon, Enum.PartType.Ball)
		add(light, f * CFrame.new(s * 18, -1, -2))
	end
	-- contrails
	for s = -1, 1, 2 do
		local a0 = Instance.new("Attachment")
		a0.Position = Vector3.new(s * 8, -2.4, -1)
		a0.Parent = root
		local a1 = Instance.new("Attachment")
		a1.Position = Vector3.new(s * 8, -2.0, -1)
		a1.Parent = root
		local trail = Instance.new("Trail")
		trail.Attachment0 = a0
		trail.Attachment1 = a1
		trail.Lifetime = 7
		trail.Color = ColorSequence.new(Color3.new(1, 1, 1))
		trail.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 1) })
		trail.WidthScale = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 5) })
		trail.FaceCamera = true
		trail.Parent = root
	end
	m.Parent = folder
	return m
end

local function startFlight()
	local c = camPos()
	local heading = rng:NextNumber() * math.pi * 2
	local dir = Vector3.new(math.cos(heading), 0, math.sin(heading))
	local side = Vector3.new(-dir.Z, 0, dir.X) * rng:NextNumber(-500, 500)
	local start = Vector3.new(c.X, 0, c.Z) - dir * 2600 + side + Vector3.new(0, rng:NextNumber(480, 620), 0)
	flight = { pos = start, dir = dir, left = 5200 }
	if not plane then
		plane = buildPlane()
	end
end

local function stepPlane(dt: number)
	nextFlight -= dt
	if not flight and nextFlight <= 0 then
		startFlight()
	end
	if flight and plane then
		local move = 150 * dt
		flight.pos += flight.dir * move
		flight.left -= move
		plane:PivotTo(CFrame.lookAt(flight.pos, flight.pos + flight.dir))
		if flight.left <= 0 then
			flight = nil
			nextFlight = rng:NextNumber(90, 200)
			plane:PivotTo(CFrame.new(0, -2000, 0))
		end
	end
end

----------------------------------------------------------------------------------------------------
-- Hot-air balloons
----------------------------------------------------------------------------------------------------
local balloons = {}

local function buildBalloon(colors: { Color3 }): Model
	local m = Instance.new("Model")
	m.Name = "Balloon"
	local env = part(Vector3.new(22, 26, 22), colors[1], Enum.Material.Fabric, Enum.PartType.Ball)
	env.Parent = m
	m.PrimaryPart = env
	local band = part(Vector3.new(22.4, 6, 22.4), colors[2], Enum.Material.Fabric, Enum.PartType.Ball)
	band.CFrame = CFrame.new(0, 2, 0)
	band.Parent = m
	local skirt = part(Vector3.new(8, 4, 8), colors[2], Enum.Material.Fabric, Enum.PartType.Ball)
	skirt.CFrame = CFrame.new(0, -12, 0)
	skirt.Parent = m
	local basket = part(Vector3.new(4, 3, 4), Color3.fromRGB(150, 100, 60), Enum.Material.WoodPlanks)
	basket.CFrame = CFrame.new(0, -19, 0)
	basket.Parent = m
	for sx = -1, 1, 2 do
		for sz = -1, 1, 2 do
			local rope = part(Vector3.new(0.15, 6, 0.15), Color3.fromRGB(60, 50, 40))
			rope.CFrame = CFrame.new(sx * 1.8, -15.5, sz * 1.8)
			rope.Parent = m
		end
	end
	local flame = part(Vector3.new(1, 1.6, 1), Color3.fromRGB(255, 170, 60), Enum.Material.Neon, Enum.PartType.Ball)
	flame.Name = "Flame"
	flame.CFrame = CFrame.new(0, -15, 0)
	flame.Parent = m
	m.Parent = folder
	return m
end

local function stepBalloons(t: number)
	local night = Lighting.ClockTime >= 19.5 or Lighting.ClockTime < 6
	for i, b in balloons do
		local x = math.sin(t * 0.008 + i * 2.1) * 900
		local z = math.cos(t * 0.006 + i * 1.3) * 700 - 200
		local y = 230 + i * 30 + math.sin(t * 0.15 + i) * 8
		b.model:PivotTo(CFrame.new(x, y, z) * CFrame.Angles(0, t * 0.02 + i, 0))
		local flame = b.model:FindFirstChild("Flame") :: BasePart?
		if flame then
			-- the burner fires now and then
			flame.Transparency = if (t + i * 3) % 9 < 1.2 then 0 else (if night then 0.5 else 0.9)
		end
	end
end

----------------------------------------------------------------------------------------------------
function Sky.init()
	folder = Instance.new("Folder")
	folder.Name = "Sky"
	folder.Parent = Workspace
	for _ = 1, FLOCKS do
		table.insert(flocks, makeFlock())
	end
	for _, colors in { { Color3.fromRGB(230, 60, 60), Color3.fromRGB(250, 210, 60) }, { Color3.fromRGB(60, 120, 220), Color3.fromRGB(240, 240, 240) } } do
		table.insert(balloons, { model = buildBalloon(colors) })
	end
	local t = 0
	RunService.RenderStepped:Connect(function(dt)
		t += dt
		local parts, cfs = {}, {}
		for _, f in flocks do
			stepFlock(f, dt, parts, cfs)
		end
		Workspace:BulkMoveTo(parts, cfs, Enum.BulkMoveMode.FireCFrameChanged)
		stepPlane(dt)
		stepBalloons(t)
	end)
end

-- tools/dump.luau draws these to check their shapes
Sky._buildPlane = buildPlane
Sky._buildBalloon = buildBalloon
function Sky._folder(f: Folder)
	folder = f
end

return Sky
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="2068">
            <Properties>
              <string name="Name">Traffic</string>
              <string name="Source"><![CDATA[-- Traffic: life on the streets around you, simulated on each client (nothing to replicate).
--   * cars and bikes drive in the right-hand lane, follow each other, stop at red lights
--     (Ambience.signal) and for you, and turn through junctions on smooth curves
--   * pedestrians stroll the sidewalks, cross at junctions and stop now and then
-- Only the neighbourhood around the camera is populated; far traffic is recycled.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local CityLayout = require(Shared.World.CityLayout)
local Vehicles = require(Shared.Data.Vehicles)
local VehicleModels = require(Shared.Models.VehicleModels)

local Ambience = require(script.Parent.Ambience)

local Traffic = {}

local player = Players.LocalPlayer
local L
local folder: Folder
local rng = Random.new()

local MAX_CARS = 20
local MAX_PEDS = 26
if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
	-- phones: lighter streets
	MAX_CARS, MAX_PEDS = 10, 14
end
local SPAWN_MIN, SPAWN_MAX, DESPAWN = 80, 320, 430
local CAR_GAP = 10

local cars = {}
local peds = {}

----------------------------------------------------------------------------------------------------
-- Road geometry
----------------------------------------------------------------------------------------------------
local function sidewalkWidth(kind: string): number
	return if kind == "main" then 10 elseif kind == "ring" then 6 else 9
end

local function carriageway(road): number
	return road.width - sidewalkWidth(road.kind) * 2
end

local function nodePos(key: string): Vector3
	local n = L.nodes[key]
	return Vector3.new(n.x, CityLayout.ROAD_Y, n.z)
end

-- Width of the road crossing `road` at node `key` (the junction box to keep clear of).
local function crossWidth(road, key: string): number
	local n = L.nodes[key]
	return if road.vertical then CityLayout.roadWidthH(n.j) else CityLayout.roadWidthV(n.i)
end

-- A road travelled from node `from`: where it starts/ends (junction edges), its direction and
-- right-hand side.
local function leg(road, from: string)
	local to = if road.from == from then road.to else road.from
	local a, b = nodePos(from), nodePos(to)
	local dir = (b - a).Unit
	local right = Vector3.new(-dir.Z, 0, dir.X)
	local s = a + dir * (crossWidth(road, from) / 2)
	local e = b - dir * (crossWidth(road, to) / 2)
	return { road = road, from = from, to = to, dir = dir, right = right, start = s, len = math.max(1, (e - s).Magnitude) }
end

local function hasSignal(key: string): boolean
	local n = L.nodes[key]
	return #n.links == 4 and CityLayout.roadWidthV(n.i) ~= 52 and CityLayout.roadWidthH(n.j) ~= 52
end

local function axisOf(dir: Vector3): string
	return if math.abs(dir.Z) > math.abs(dir.X) then "NS" else "EW"
end

local function camPos(): Vector3
	local cam = Workspace.CurrentCamera
	return if cam then cam.CFrame.Position else Vector3.zero
end

local function flatDist(a: Vector3, b: Vector3): number
	return Vector3.new(a.X - b.X, 0, a.Z - b.Z).Magnitude
end

-- Roads whose middle is within [lo, hi] of p.
local function roadsNear(p: Vector3, lo: number, hi: number)
	local out = {}
	for _, r in L.roads do
		local mid = Vector3.new((r.a.X + r.b.X) / 2, 0, (r.a.Y + r.b.Y) / 2)
		local d = flatDist(mid, p)
		if d >= lo and d <= hi then
			table.insert(out, r)
		end
	end
	return out
end

----------------------------------------------------------------------------------------------------
-- People (pedestrians and drivers): blocky figures made of a few parts
----------------------------------------------------------------------------------------------------
local SKIN = { { 255, 220, 190 }, { 234, 190, 150 }, { 200, 150, 110 }, { 150, 105, 75 }, { 110, 75, 50 } }
local SHIRT = { { 220, 60, 60 }, { 40, 110, 200 }, { 240, 240, 236 }, { 30, 30, 34 }, { 250, 200, 60 }, { 60, 160, 90 }, { 150, 90, 200 }, { 240, 140, 60 }, { 110, 120, 140 } }
local PANTS = { { 40, 50, 80 }, { 30, 30, 34 }, { 120, 100, 80 }, { 70, 80, 90 }, { 180, 170, 150 } }
local HAIR = { { 30, 24, 20 }, { 80, 50, 30 }, { 200, 160, 90 }, { 140, 140, 140 }, { 160, 60, 30 } }

local function c3(t): Color3
	return Color3.fromRGB(t[1], t[2], t[3])
end

local function part(size: Vector3, color: Color3, shape: Enum.PartType?): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Size = size
	p.Color = color
	p.Material = Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if shape then
		p.Shape = shape
	end
	p.Parent = folder
	return p
end

local function pick(list)
	return list[rng:NextInteger(1, #list)]
end

----------------------------------------------------------------------------------------------------
-- Cars
----------------------------------------------------------------------------------------------------
local carDefs = {}

local function randomPlate(): string
	return Vehicles.plate(rng)
end

local function laneOffset(road, lane: number): number
	local cw = carriageway(road)
	if road.kind == "street" then
		return cw / 4
	end
	return if lane == 1 then cw * 0.375 else cw * 0.125
end

local function carCFrame(c): CFrame
	local g = c.leg
	local pos = g.start + g.dir * c.t + g.right * c.offset
	return CFrame.lookAt(pos, pos + g.dir)
end

local function bezier(p0: Vector3, p1: Vector3, p2: Vector3, u: number): (Vector3, Vector3)
	local a = p0:Lerp(p1, u)
	local b = p1:Lerp(p2, u)
	return a:Lerp(b, u), (b - a)
end

-- At the end of a road: pick where to go next and plan the curve through the junction.
local function planTurn(c)
	local g = c.leg
	local node = L.nodes[g.to]
	local options = {}
	for _, link in node.links do
		if link.road ~= g.road.id then
			table.insert(options, L.roads[link.road])
		end
	end
	local nextRoad
	if #options == 0 then
		nextRoad = g.road -- dead end: turn around
	else
		-- going straight on is the most common
		for _, r in options do
			local lg = leg(r, g.to)
			if lg.dir:Dot(g.dir) > 0.9 and rng:NextNumber() < 0.55 then
				nextRoad = r
			end
		end
		nextRoad = nextRoad or options[rng:NextInteger(1, #options)]
	end
	local ng = leg(nextRoad, g.to)
	local lane = if nextRoad.kind == "street" then 0 else c.lane
	local offset = laneOffset(nextRoad, lane)
	local p0 = g.start + g.dir * g.len + g.right * c.offset
	local p2 = ng.start + ng.right * offset
	local p1
	if math.abs(ng.dir:Dot(g.dir)) > 0.9 then
		if ng.dir:Dot(g.dir) > 0 then
			p1 = (p0 + p2) / 2
		else
			p1 = nodePos(g.to) + g.dir * 10 -- U-turn loop
		end
	elseif math.abs(g.dir.X) > 0.5 then
		p1 = Vector3.new(p2.X, p0.Y, p0.Z)
	else
		p1 = Vector3.new(p0.X, p0.Y, p2.Z)
	end
	c.turn = { p0 = p0, p1 = p1, p2 = p2, s = 0, len = (p1 - p0).Magnitude + (p2 - p1).Magnitude, next = ng, lane = lane, offset = offset }
end

local function spawnCar(): boolean
	local near = roadsNear(camPos(), SPAWN_MIN, SPAWN_MAX)
	if #near == 0 then
		return false
	end
	local road = near[rng:NextInteger(1, #near)]
	local g = leg(road, if rng:NextNumber() < 0.5 then road.from else road.to)
	local lane = if road.kind == "street" then 0 else rng:NextInteger(0, 1)
	local t = rng:NextNumber() * g.len * 0.85
	for _, other in cars do
		if other.leg.road == road and other.leg.from == g.from and other.lane == lane and math.abs(other.t - t) < CAR_GAP * 2 then
			return false
		end
	end
	local def = carDefs[rng:NextInteger(1, #carDefs)]
	local c = { def = def, leg = g, lane = lane, offset = laneOffset(road, lane), t = t, speed = 0, cruise = math.min(def.speed * 0.42, if road.kind == "street" then 28 else 38) * rng:NextNumber(0.85, 1.1) }
	local ok, m = pcall(VehicleModels.build, folder, def, CFrame.new(), { color = rng:NextInteger(1, #def.colors), plate = randomPlate(), static = true })
	if not ok then
		return false
	end
	-- someone at the wheel
	local seat = m:FindFirstChild("Driver") :: BasePart?
	if seat then
		local body = part(Vector3.new(1.4, 1.3, 0.8), c3(pick(SHIRT)))
		body.CFrame = seat.CFrame * CFrame.new(0, 0.8, 0.15)
		body.Parent = m
		local head = part(Vector3.new(0.85, 0.85, 0.85), c3(pick(SKIN)))
		head.CFrame = seat.CFrame * CFrame.new(0, 1.9, 0.15)
		head.Parent = m
	end
	for _, d in m:GetDescendants() do
		if d:IsA("BasePart") then
			d.CanQuery = false
			d.CanTouch = false
			d.CastShadow = d.Size.Magnitude > 3
		end
	end
	c.model = m
	c.pivot = m:GetPivot() -- relative to the build origin
	table.insert(cars, c)
	return true
end

local function stepCar(c, dt: number, me: Vector3?)
	local accel, decel = 14, 26
	local target = c.cruise
	if c.turn then
		target = math.min(target, 16)
	else
		local g = c.leg
		local left = g.len - c.t
		-- red or amber light ahead: stop before the zebra crossing (1..6 studs before the
		-- junction); keep going if it's too late to stop
		if hasSignal(g.to) and Ambience.signal(axisOf(g.dir)) ~= "green" and left > 6.5 then
			local stop = left - 8
			if not (stop < 4 and c.speed > 12) then
				target = math.min(target, math.sqrt(2 * decel * math.max(0, stop)))
			end
		end
		-- slow down for corners
		if left < 25 then
			target = math.min(target, 16 + left * 0.8)
		end
		-- the car ahead in our lane
		for _, o in cars do
			if o ~= c and not o.turn and o.leg.road == g.road and o.leg.from == g.from and o.lane == c.lane and o.t > c.t then
				local gap = o.t - c.t - CAR_GAP
				target = math.min(target, math.sqrt(2 * decel * math.max(0, gap)) + o.speed * 0.5)
			end
		end
		-- the player on the road in front
		if me then
			local pos = g.start + g.dir * c.t + g.right * c.offset
			local rel = me - pos
			local ahead = rel:Dot(g.dir)
			if ahead > 0 and ahead < 16 and math.abs(rel:Dot(g.right)) < 3.5 and math.abs(rel.Y) < 8 then
				target = 0
			end
		end
	end
	if c.speed < target then
		c.speed = math.min(target, c.speed + accel * dt)
	else
		c.speed = math.max(target, c.speed - decel * dt)
	end
	local move = c.speed * dt
	if c.turn then
		local tr = c.turn
		tr.s += move
		if tr.s >= tr.len then
			c.leg = tr.next
			c.lane = tr.lane
			c.offset = tr.offset
			c.t = tr.s - tr.len
			c.turn = nil
		end
	else
		c.t += move
		if c.t >= c.leg.len then
			planTurn(c)
			c.turn.s = c.t - c.leg.len
		end
	end
end

local function placeCar(c)
	local cf
	if c.turn then
		local tr = c.turn
		local pos, tangent = bezier(tr.p0, tr.p1, tr.p2, math.clamp(tr.s / tr.len, 0, 1))
		if tangent.Magnitude < 1e-3 then
			tangent = c.leg.dir
		end
		cf = CFrame.lookAt(pos, pos + Vector3.new(tangent.X, 0, tangent.Z))
	else
		cf = carCFrame(c)
	end
	c.model:PivotTo(cf * c.pivot)
end

----------------------------------------------------------------------------------------------------
-- Pedestrians: walking the sidewalks, limbs swung by code
----------------------------------------------------------------------------------------------------
local function sidewalkLeg(road, from: string, side: number)
	local g = leg(road, from)
	local cw = carriageway(road)
	local sw = sidewalkWidth(road.kind)
	g.side = side
	g.lateral = (cw / 2 + sw * rng:NextNumber(0.35, 0.65)) * side
	-- walk the whole block: from junction edge to junction edge
	return g
end

local function spawnPed(): boolean
	local near = roadsNear(camPos(), 30, SPAWN_MAX * 0.7)
	if #near == 0 then
		return false
	end
	local road = near[rng:NextInteger(1, #near)]
	local g = sidewalkLeg(road, if rng:NextNumber() < 0.5 then road.from else road.to, if rng:NextNumber() < 0.5 then 1 else -1)
	local skin, shirt, pants = c3(pick(SKIN)), c3(pick(SHIRT)), c3(pick(PANTS))
	local p = {
		leg = g,
		t = rng:NextNumber() * g.len,
		speed = rng:NextNumber(5.5, 8),
		phase = rng:NextNumber() * 6,
		pause = 0,
		parts = {
			torso = part(Vector3.new(1.9, 2, 1), shirt),
			head = part(Vector3.new(1.15, 1.15, 1.15), skin),
			hair = part(Vector3.new(1.2, 0.35, 1.2), c3(pick(HAIR))),
			armL = part(Vector3.new(0.9, 1.9, 0.9), if rng:NextNumber() < 0.5 then skin else shirt),
			armR = part(Vector3.new(0.9, 1.9, 0.9), if rng:NextNumber() < 0.5 then skin else shirt),
			legL = part(Vector3.new(0.95, 2, 0.95), pants),
			legR = part(Vector3.new(0.95, 2, 0.95), pants),
		},
	}
	table.insert(peds, p)
	return true
end

local function stepPed(p, dt: number)
	if p.pause > 0 then
		p.pause -= dt
		return
	end
	p.t += p.speed * dt
	p.phase += dt * p.speed * 1.25
	if p.t >= p.leg.len then
		-- carry on across the junction if the street continues, otherwise turn back
		local g = p.leg
		local node = L.nodes[g.to]
		local straight = nil
		for _, link in node.links do
			local r = L.roads[link.road]
			if r ~= g.road then
				local lg = leg(r, g.to)
				if lg.dir:Dot(g.dir) > 0.9 then
					straight = r
				end
			end
		end
		if straight and rng:NextNumber() < 0.75 then
			p.leg = sidewalkLeg(straight, g.to, g.side)
			p.t = -crossWidth(g.road, g.to) -- walk over the crossing first
		else
			p.leg = sidewalkLeg(g.road, g.to, -g.side)
			p.t = 0
		end
	elseif rng:NextNumber() < dt * 0.04 then
		p.pause = rng:NextNumber(2, 6) -- a look at the phone, a shop window...
	end
end

local function pedCFrames(p, out: { BasePart }, cfs: { CFrame })
	local g = p.leg
	local pos = g.start + g.dir * p.t + g.right * g.lateral
	pos = Vector3.new(pos.X, CityLayout.WALK_Y, pos.Z)
	local base = CFrame.lookAt(pos, pos + g.dir)
	local walking = p.pause <= 0
	local swing = if walking then math.sin(p.phase) * 0.6 else 0
	local bob = if walking then math.abs(math.sin(p.phase)) * 0.12 else 0
	local hip = base * CFrame.new(0, 2 + bob, 0)
	local parts = p.parts
	local function put(bp: BasePart, cf: CFrame)
		table.insert(out, bp)
		table.insert(cfs, cf)
	end
	put(parts.torso, hip * CFrame.new(0, 1, 0))
	put(parts.head, hip * CFrame.new(0, 2.6, 0))
	put(parts.hair, hip * CFrame.new(0, 3.25, 0.05))
	put(parts.armL, hip * CFrame.new(-1.42, 1.95, 0) * CFrame.Angles(swing, 0, 0) * CFrame.new(0, -0.95, 0))
	put(parts.armR, hip * CFrame.new(1.42, 1.95, 0) * CFrame.Angles(-swing, 0, 0) * CFrame.new(0, -0.95, 0))
	put(parts.legL, hip * CFrame.new(-0.48, 0, 0) * CFrame.Angles(-swing, 0, 0) * CFrame.new(0, -1, 0))
	put(parts.legR, hip * CFrame.new(0.48, 0, 0) * CFrame.Angles(swing, 0, 0) * CFrame.new(0, -1, 0))
end

local function removePed(i: number)
	for _, bp in peds[i].parts do
		bp:Destroy()
	end
	table.remove(peds, i)
end

----------------------------------------------------------------------------------------------------
function Traffic.init()
	L = CityLayout.get()
	folder = Instance.new("Folder")
	folder.Name = "ClientTraffic"
	folder.Parent = Workspace
	for _, v in Vehicles.list do
		if v.kind == "car" then
			table.insert(carDefs, v)
			if v.price < 60000 then
				table.insert(carDefs, v) -- everyday cars twice as common
			end
		end
	end
	local spawnClock = 0
	RunService.Heartbeat:Connect(function(dt)
		local cam = camPos()
		local char = player.Character
		local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		local me = root and root.Position or nil
		-- keep the neighbourhood populated
		spawnClock += dt
		if spawnClock > 0.35 then
			spawnClock = 0
			if #cars < MAX_CARS then
				spawnCar()
			end
			if #peds < MAX_PEDS then
				spawnPed()
			end
		end
		for i = #cars, 1, -1 do
			local c = cars[i]
			stepCar(c, math.min(dt, 0.1), me)
			local pos = c.leg.start + c.leg.dir * c.t
			if flatDist(pos, cam) > DESPAWN then
				c.model:Destroy()
				table.remove(cars, i)
			else
				placeCar(c)
			end
		end
		local moved, cfs = {}, {}
		for i = #peds, 1, -1 do
			local p = peds[i]
			stepPed(p, math.min(dt, 0.1))
			local pos = p.leg.start + p.leg.dir * p.t
			local d = flatDist(pos, cam)
			if d > DESPAWN * 0.75 then
				removePed(i)
			elseif d < 260 then
				pedCFrames(p, moved, cfs)
			end
		end
		if #moved > 0 then
			Workspace:BulkMoveTo(moved, cfs, Enum.BulkMoveMode.FireCFrameChanged)
		end
	end)
end

function Traffic.counts(): (number, number)
	return #cars, #peds
end

return Traffic
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="2069">
            <Properties>
              <string name="Name">Tutorial</string>
              <string name="Source"><![CDATA[-- Tutorial: five short steps for new players, shown in a card at the top of the screen.
-- Progress is saved (settings.set { tutorial = n }); 6 means done.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)

local Client = script.Parent.Parent
local Kit = require(Client.UI.Kit)
local Theme = require(Client.UI.Theme)
local App = require(Client.UI.App)
local Hud = require(Client.UI.Hud)
local S = require(Client.Strings)
local State = require(Client.State)
local BenchController = require(script.Parent.BenchController)

local Tutorial = {}

local DONE = 6
local step = DONE
local card: Frame
local text: TextLabel

local function show()
	if step >= DONE then
		card.Visible = false
		return
	end
	card.Visible = true
	text.Text = S.t("tut_" .. step)
end

local function advance(to: number)
	if to <= step or step >= DONE then
		return
	end
	step = math.min(to, DONE)
	Net.request("settings.set", { tutorial = step })
	show()
	if step == 5 then
		task.delay(14, function()
			advance(DONE)
		end)
	end
end

function Tutorial.init()
	-- lower middle: clear of the toasts (top), the speedometer and the bench hint (bottom)
	card = Kit.panel(App.screen, { Name = "Tutorial", Size = UDim2.fromOffset(560, 0), AutomaticSize = Enum.AutomaticSize.Y, Position = UDim2.new(0.5, 0, 1, -190), AnchorPoint = Vector2.new(0.5, 1), BackgroundTransparency = 0.08, Visible = false })
	Kit.outline(card, Theme.accent2, 2, 0)
	Hud.register(card)
	Kit.padding(card, 12)
	text = Kit.label(card, "", { Size = UDim2.new(1, -70, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextSize = 17, FontFace = Theme.bold })
	Kit.button(card, S.t("tut_skip"), function()
		advance(DONE)
	end, { Size = UDim2.fromOffset(60, 28), Position = UDim2.new(1, -60, 0, 0), TextSize = 13 }, "ghost")

	step = State.data and State.data.tutorial or 1
	if step < 1 then
		step = 1
	end
	show()

	-- step 1 → 2: a job was taken; 2 → 3: a job is on a bench
	State.jobsChanged:Connect(function(jobs)
		for _, j in jobs do
			if j.status == "bench" then
				advance(3)
				return
			end
		end
		if #jobs > 0 then
			advance(2)
		end
	end)
	-- 3 → 4: did something at the bench
	BenchController.acted:Connect(function()
		advance(4)
	end)
	-- 4 → 5: the first customer paid
	Net.on("paid", function()
		advance(5)
	end)
end

return Tutorial
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="2070">
            <Properties>
              <string name="Name">VehicleController</string>
              <string name="Source"><![CDATA[-- VehicleController: driving your car or motorbike, and wheels turning on every vehicle in town.
--
-- The driver's client owns the vehicle's physics (the server hands over network ownership), so it
-- steers it here: throttle/steer come from the VehicleSeat (the default controls fill them in from
-- WASD, a gamepad or the touch thumbstick), the "Drive" LinearVelocity sets the speed along the
-- ground and the "Upright" AlignOrientation sets the heading (and a bike's lean).

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Client = script.Parent.Parent
local Kit = require(Client.UI.Kit)
local Theme = require(Client.UI.Theme)
local App = require(Client.UI.App)
local S = require(Client.Strings)

local VehicleController = {}

local player = Players.LocalPlayer

local driving = nil :: any -- { model, seat, chassis, drive, upright, speed, yaw, lean, max, accel, turn, bike }
local gauge: Frame
local speedLabel: TextLabel
local speedBar
local wheelState: { [Model]: { spin: number, wheels: { { motor: Motor6D, front: boolean, radius: number } } } } = {}

local STUDS_TO_KMH = 1 -- 1 stud ≈ 0.28 m, so studs/s × 3.6 × 0.28 ≈ km/h

local function yawOf(cf: CFrame): number
	local look = cf.LookVector
	return math.atan2(-look.X, -look.Z)
end

local function buildGauge()
	gauge = Kit.panel(App.screen, { Name = "Speedometer", Size = UDim2.fromOffset(240, 92), Position = UDim2.new(0.5, 0, 1, -18), AnchorPoint = Vector2.new(0.5, 1), BackgroundTransparency = 0.15, Visible = false })
	Kit.padding(gauge, 10)
	speedLabel = Kit.label(gauge, "0", { Size = UDim2.new(1, 0, 0, 40), TextSize = 38, FontFace = Theme.heavy, TextXAlignment = Enum.TextXAlignment.Center })
	speedBar = Kit.progress(gauge, { Position = UDim2.fromOffset(0, 44), Size = UDim2.new(1, 0, 0, 8) }, Theme.accent)
	Kit.label(gauge, S.t("drive_hint"), { Position = UDim2.fromOffset(0, 56), Size = UDim2.new(1, 0, 0, 16), TextSize = 12, TextColor3 = Theme.dim, TextXAlignment = Enum.TextXAlignment.Center })
end

-- Parked or gone (checked without touching the possibly destroyed model).
local function vehicleGone(model: Model): boolean
	local folder = Workspace:FindFirstChild("Vehicles")
	return folder == nil or table.find(folder:GetChildren(), model) == nil
end

local function stopDriving()
	if driving then
		local d = driving
		driving = nil
		if not vehicleGone(d.model) then
			d.drive.PlaneVelocity = Vector2.zero
		end
	end
	if gauge then
		gauge.Visible = false
	end
end

local function startDriving(seat: VehicleSeat)
	local model = seat:FindFirstAncestorOfClass("Model")
	local chassis = model and model.PrimaryPart
	if not model or not chassis then
		return
	end
	local drive = chassis:FindFirstChild("Drive") :: LinearVelocity?
	local upright = chassis:FindFirstChild("Upright") :: AlignOrientation?
	if not drive or not upright then
		return
	end
	driving = {
		model = model,
		seat = seat,
		chassis = chassis,
		drive = drive,
		upright = upright,
		speed = 0,
		yaw = yawOf(chassis.CFrame),
		lean = 0,
		max = model:GetAttribute("Speed") or 60,
		accel = model:GetAttribute("Accel") or 25,
		turn = model:GetAttribute("Turn") or 2.5,
		bike = model:GetAttribute("Bike") == true,
	}
	gauge.Visible = true
end

-- One physics step for the vehicle you're driving.
local function drive(dt: number)
	local d = driving
	if vehicleGone(d.model) then
		stopDriving()
		return
	end
	local throttle = d.seat.ThrottleFloat
	local steer = d.seat.SteerFloat
	local s = d.speed
	-- throttle, brakes and rolling resistance
	if throttle > 0.05 then
		if s < 0 then
			s = math.min(0, s + d.accel * 2.6 * dt)
		else
			s += d.accel * throttle * dt * (1 - 0.55 * s / d.max)
		end
	elseif throttle < -0.05 then
		if s > 0 then
			s = math.max(0, s - d.accel * 2.6 * dt)
		else
			s -= d.accel * 0.6 * -throttle * dt
		end
	else
		local drag = d.accel * 0.35 * dt
		s = if s > 0 then math.max(0, s - drag) else math.min(0, s + drag)
	end
	s = math.clamp(s, -d.max * 0.35, d.max)
	-- hitting a wall: the real speed wins
	local forward = CFrame.Angles(0, d.yaw, 0).LookVector
	local actual = d.chassis.AssemblyLinearVelocity:Dot(forward)
	if math.abs(actual) + 6 < math.abs(s) then
		s = actual + math.sign(s) * 6
	end
	d.speed = s
	-- steering: no turning on the spot, a little less at top speed
	local grip = math.clamp(math.abs(s) / 10, 0, 1) * (1 - 0.45 * math.abs(s) / d.max)
	d.yaw -= steer * d.turn * 0.55 * grip * dt * math.sign(s)
	forward = CFrame.Angles(0, d.yaw, 0).LookVector
	d.drive.PlaneVelocity = Vector2.new(forward.X * s, forward.Z * s)
	local rot = CFrame.Angles(0, d.yaw, 0)
	if d.bike then
		local target = -steer * math.clamp(math.abs(s) / 30, 0, 1) * 0.38
		d.lean += (target - d.lean) * math.min(1, dt * 5)
		rot *= CFrame.Angles(0, 0, d.lean)
	end
	d.upright.CFrame = rot
	-- gauge
	local kmh = math.floor(math.abs(s) * STUDS_TO_KMH + 0.5)
	speedLabel.Text = kmh .. " " .. S.t("kmh")
	speedBar:set(math.abs(s) / d.max)
end

-- Every vehicle's wheels spin with its speed; the front ones follow the driver's steering.
local function wheelsOf(model: Model)
	local st = wheelState[model]
	if st then
		return st
	end
	st = { spin = 0, wheels = {} }
	for _, d in model:GetDescendants() do
		if d:IsA("Motor6D") and d.Part1 and d.Part1:GetAttribute("Wheel") then
			table.insert(st.wheels, { motor = d, front = d.Part1:GetAttribute("Front") == true, radius = d.Part1:GetAttribute("Radius") or 1 })
		end
	end
	wheelState[model] = st
	return st
end

local function animateWheels(dt: number)
	local folder = Workspace:FindFirstChild("Vehicles")
	if not folder then
		return
	end
	local cam = Workspace.CurrentCamera
	local camPos = if cam then cam.CFrame.Position else Vector3.zero
	local seen = {}
	for _, model in folder:GetChildren() do
		seen[model] = true
		if model:IsA("Model") and not model:GetAttribute("Display") then
			local chassis = model.PrimaryPart
			if chassis and (chassis.Position - camPos).Magnitude < 250 then
				local st = wheelsOf(model)
				local v = chassis.AssemblyLinearVelocity:Dot(chassis.CFrame.LookVector)
				local seat = model:FindFirstChild("Driver") :: VehicleSeat?
				local steer = if seat then seat.SteerFloat else 0
				for _, w in st.wheels do
					w.angle = (w.angle or 0) - v / w.radius * dt
					local turn = if w.front then CFrame.Angles(0, -steer * 0.45, 0) else CFrame.identity
					w.motor.Transform = turn * CFrame.Angles(w.angle, 0, 0)
				end
			end
		end
	end
	for model in wheelState do
		if not seen[model] then
			wheelState[model] = nil
		end
	end
end

local function watchCharacter(char: Model)
	local hum = char:WaitForChild("Humanoid", 10) :: Humanoid?
	if not hum then
		return
	end
	hum:GetPropertyChangedSignal("SeatPart"):Connect(function()
		local seat = hum.SeatPart
		if seat and seat:IsA("VehicleSeat") and seat.Name == "Driver" then
			startDriving(seat)
		else
			stopDriving()
		end
	end)
end

function VehicleController.init()
	buildGauge()
	if player.Character then
		task.spawn(watchCharacter, player.Character)
	end
	player.CharacterAdded:Connect(watchCharacter)
	RunService.Heartbeat:Connect(function(dt)
		if driving then
			drive(dt)
		end
	end)
	RunService.RenderStepped:Connect(animateWheels)
end

function VehicleController.driving(): boolean
	return driving ~= nil
end

VehicleController._start = startDriving

return VehicleController
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="LocalScript" referent="2071">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[-- PC Tamircisi Simülatörü — client entry point: language, HUD, windows and controllers.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Tools = require(Shared.Data.Tools)
local Market = require(Shared.Economy.Market)

local Client = script.Parent
local S = require(Client.Strings)
local State = require(Client.State)
local UI = Client.UI
local Kit = require(UI.Kit)
local Hud = require(UI.Hud)
local App = require(UI.App)
local CustomerDialog = require(UI.CustomerDialog)
local Stores = require(UI.Stores)
local StaffPanel = require(UI.StaffPanel)
local Garage = require(UI.Garage)
local JobsPanel = require(UI.JobsPanel)
local Inventory = require(UI.Inventory)
local Phone = require(UI.Phone)
local ContractsPanel = require(UI.ContractsPanel)
local Controllers = Client.Controllers
local BenchViews = require(Controllers.BenchViews)
local BenchController = require(Controllers.BenchController)
local MapController = require(Controllers.MapController)
local VehicleController = require(Controllers.VehicleController)
local Ambience = require(Controllers.Ambience)
local Tutorial = require(Controllers.Tutorial)
local Traffic = require(Controllers.Traffic)
local Sky = require(Controllers.Sky)

S.detect()
State.init()
-- wait for the first save snapshot so the language and the numbers are right from the start
local t0 = os.clock()
while not State.ready() and os.clock() - t0 < 15 do
	task.wait(0.1)
end
if State.data and (State.data.lang == "tr" or State.data.lang == "en") then
	S.setLang(State.data.lang)
end

local screen = Kit.screen("PCTamirci", 5)
App.screen = screen
Kit.clickSound = function()
	App.sound("Click", 0.35)
end

local function home()
	Kit.closeWindow()
	MapController.close()
	local r = Net.request("travel.home")
	if r.ok then
		Hud.toast(S.t("travel_home"), "info", 2)
	else
		Hud.toast(S.err(r.err, { wait = r.wait }), "bad")
	end
end

----------------------------------------------------------------------------------------------------
-- Messages from the server
----------------------------------------------------------------------------------------------------
local MONEY_VARS = { amount = true, fine = true, bounty = true, cash = true, price = true, bonus = true, reward = true }
local GOOD = { quest_done = true, offline_income = true, tech_done = true, caught_scammer = true, thief_caught = true, bounty = true, moved = true, manager_bought = true, contract_machine = true, contract_done = true, showcase_put = true, showcase_sold = true }
local BAD = { police_fine = true, customer_left = true, scammer_escaped = true, thief_escaped = true, alarm = true, staff_quit = true, esd_zap = true, jobs_full = true, contract_machine_bad = true }

Net.on("toast", function(t)
	if type(t) ~= "table" or type(t.key) ~= "string" then
		return
	end
	local vars = table.clone(t.vars or {})
	for k, v in vars do
		if MONEY_VARS[k] and type(v) == "number" then
			vars[k] = S.money(v)
		end
	end
	if t.key == "tech_blocked" then
		local detail = tostring(vars.detail or "")
		if vars.reason == "need_part" and S.has("cat_" .. detail) then
			detail = S.t("cat_" .. detail)
		elseif vars.reason == "need_tool" then
			local tool = Tools.get(detail)
			detail = if tool then tool.icon .. " " .. S.pick(tool.name) else detail
		end
		vars.reason = S.t("reason_" .. tostring(vars.reason))
		vars.detail = detail
	elseif t.key == "tech_done" then
		vars.job = tostring(vars.job or "") .. (if vars.fixed then " ✅" else " ⚠️")
	elseif t.key == "thief_escaped" then
		if t.vars and (t.vars.cash or 0) <= 0 then
			vars.cash = ""
		end
	end
	local kind = if GOOD[t.key] then "good" elseif BAD[t.key] then "bad" elseif t.key == "camera_alert" or t.key == "scammer_running" then "warn" else "info"
	Hud.toast(S.t("t_" .. t.key, vars), kind, if kind == "bad" or kind == "warn" then 6 else 4.5)
	if t.key == "alarm" or t.key == "camera_alert" or t.key == "scammer_running" then
		Hud.banner("🚨")
	end
end)

Net.on("paid", function(p)
	if p.failed then
		Hud.toast(S.t("paid_fail", { name = p.name }), "bad", 6)
		return
	end
	Hud.toast(S.t("paid", { name = p.name, price = S.money(p.price), tip = S.money(p.tip or 0), stars = S.stars(p.stars or 0) }), "good", 6)
	if p.text and #p.text > 0 then
		Hud.toast("💬 “" .. p.text .. "”", "info", 6)
	end
	App.sound("Cash", 0.6)
end)

State.changed:Connect(function(d, prev)
	local settings = d.settings or {}
	App.sfxVolume = settings.sfx or 0.8
	Ambience.setVolumes(settings.music, settings.sfx)
	if prev and d.money > prev.money then
		App.sound("Cash", 0.35)
	end
end)

----------------------------------------------------------------------------------------------------
-- UI and controllers
----------------------------------------------------------------------------------------------------
Hud.init(screen, {
	home = home,
	jobs = JobsPanel.toggle,
	inventory = Inventory.toggle,
	phone = Phone.toggle,
	map = MapController.toggle,
})
CustomerDialog.init()
Stores.init()
StaffPanel.init()
Garage.init()
ContractsPanel.init()
Phone.init({
	map = MapController.open,
	home = home,
	relabel = MapController.relabel,
})
BenchViews.init()
BenchController.init(screen, Hud)
MapController.init()
VehicleController.init()
Ambience.init()
Traffic.init()
Sky.init()
Tutorial.init()
if State.data then
	local settings = State.data.settings or {}
	App.sfxVolume = settings.sfx or 0.8
	Ambience.setVolumes(settings.music, settings.sfx)
	if State.data.daily and State.data.daily.day ~= Market.day() then
		task.delay(6, function()
			Hud.toast(S.t("daily_ready"), "good", 6)
		end)
	end
end

-- keyboard shortcuts (M is the map controller's)
UserInputService.InputBegan:Connect(function(input, processed)
	if processed or BenchController.active() then
		return
	end
	local k = input.KeyCode
	if k == Enum.KeyCode.J then
		JobsPanel.toggle()
	elseif k == Enum.KeyCode.B then
		Inventory.toggle()
	elseif k == Enum.KeyCode.P then
		Phone.toggle()
	elseif k == Enum.KeyCode.H then
		home()
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="2072">
          <Properties>
            <string name="Name">State</string>
            <string name="Source"><![CDATA[-- State: what the client knows about the player (the server's data snapshot, jobs, shop) with
-- change signals for the UI.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Signal = require(Shared.Util.Signal)

local State = {}
State.data = nil :: any
State.jobs = {} :: { any }
State.shop = nil :: any
State.changed = Signal.new() -- (data, previous)
State.jobsChanged = Signal.new() -- (jobs)
State.shopChanged = Signal.new()
State.levelUp = Signal.new() -- (level)

local ready = false

function State.init()
	Net.on("data", function(d)
		local prev = State.data
		State.data = d
		if prev and d.level > prev.level then
			State.levelUp:Fire(d.level)
		end
		ready = true
		State.changed:Fire(d, prev)
	end)
	Net.on("jobs", function(list)
		State.jobs = list
		State.jobsChanged:Fire(list)
	end)
	Net.on("shop", function(s)
		State.shop = s
		State.shopChanged:Fire(s)
	end)
	task.spawn(function()
		local r = Net.request("jobs.list")
		if r.ok then
			State.jobs = r.jobs
			State.jobsChanged:Fire(r.jobs)
		end
	end)
end

function State.ready(): boolean
	return ready
end

function State.waitReady()
	while not ready do
		task.wait(0.1)
	end
end

function State.money(): number
	return State.data and State.data.money or 0
end

function State.level(): number
	return State.data and State.data.level or 1
end

function State.owns(tool: string): boolean
	return tool == "hand" or (State.data ~= nil and State.data.tools[tool] == true)
end

function State.ownedTools(): { [string]: boolean }
	local t = { hand = true }
	if State.data then
		for id in State.data.tools do
			t[id] = true
		end
	end
	return t
end

function State.stock(id: string): number
	return State.data and State.data.stock[id] or 0
end

return State
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="2073">
          <Properties>
            <string name="Name">Strings</string>
            <string name="Source"><![CDATA[-- Strings: every piece of UI text in Turkish and English. S.t(key, vars) picks the player's
