-- Interior bits
----------------------------------------------------------------------------------------------------
function Props.chair(parent: Instance, cf: CFrame, color: any?): Model
	local m = B.model("Chair", parent)
	local col = B.color(color or { 40, 44, 50 })
	B.box(m, cf * CFrame.new(0, 1.7, 0), Vector3.new(1.8, 0.3, 1.8), col, M.Fabric)
	B.box(m, cf * CFrame.new(0, 2.9, 0.82), Vector3.new(1.8, 2.2, 0.25), col, M.Fabric)
	for x = -1, 1, 2 do
		for z = -1, 1, 2 do
			B.box(m, cf * CFrame.new(x * 0.75, 0.8, z * 0.75), Vector3.new(0.18, 1.6, 0.18), Color3.fromRGB(150, 150, 155), M.Metal, noCollide())
		end
	end
	local seat = Instance.new("Seat")
	seat.Name = "Seat"
	seat.Anchored = true
	seat.Transparency = 1
	seat.CanCollide = false
	seat.Size = Vector3.new(1.6, 0.3, 1.6)
	seat.CFrame = cf * CFrame.new(0, 1.9, 0)
	seat.Parent = m
	return m
end

local POTS = { "PotDracaena", "PotRubber", "PotSnake", "PotFern", "PotEvergreen", "PotDoor", "PotTall", "PotBanana" }

function Props.plant(parent: Instance, cf: CFrame, rng: Random?): Model
	local r = rng or Random.new()
	local name = Rand.pick(r, POTS)
	-- as tall as a person's shoulder at most, and no wider than the old pot (1.9 studs)
	local size = Assets.size("Garden", name)
	local scale = Assets.scaleFor("Garden", name, Rand.range(r, 3.6, 5.2))
	if size then
		scale = math.min(scale, 1.9 / math.max(size.X, size.Z))
	end
	local real = Assets.place(parent, "Garden", name, cf * CFrame.Angles(0, r:NextInteger(0, 3) * math.pi / 2, 0), scale)
	if real then
		real.Name = "Plant"
		return real
	end
	local m = B.model("Plant", parent)
	B.cylY(m, cf * CFrame.new(0, 0.9, 0), 1.8, 1.6, Rand.pick(r, { Color3.fromRGB(200, 120, 80), Color3.fromRGB(240, 240, 236), Color3.fromRGB(40, 40, 44) }), M.Slate)
	for i = 1, 5 do
		local a = i * 1.3
		B.ellipsoid(m, cf * CFrame.new(math.cos(a) * 0.5, 2.6 + i * 0.25, math.sin(a) * 0.5) * CFrame.Angles(math.cos(a) * 0.5, a, 0), Vector3.new(0.9, 2.6, 0.4), Rand.pick(r, GREENS), M.LeafyGrass, noCollide())
	end
	return m
end

function Props.shelf(parent: Instance, cf: CFrame, w: number, h: number, depth: number, rng: Random?, fill: number?): Model
	local r = rng or Random.new()
	local m = B.model("Shelf", parent)
	local metal = Color3.fromRGB(70, 74, 80)
	for x = -1, 1, 2 do
		B.box(m, cf * CFrame.new(x * (w / 2 - 0.15), h / 2, 0), Vector3.new(0.3, h, depth), metal, M.Metal)
	end
	local levels = math.max(2, math.floor(h / 2.4))
	local boxCols = { Color3.fromRGB(30, 30, 34), Color3.fromRGB(200, 40, 40), Color3.fromRGB(240, 240, 240), Color3.fromRGB(40, 110, 200), Color3.fromRGB(120, 190, 60), Color3.fromRGB(240, 160, 30) }
	for i = 0, levels do
		local y = 0.3 + i * (h - 0.4) / levels
		B.box(m, cf * CFrame.new(0, y, 0), Vector3.new(w, 0.2, depth), metal, M.Metal)
		if i < levels then
			local x = -w / 2 + 0.6
			while x < w / 2 - 1 do
				if r:NextNumber() < (fill or 0.75) then
					local bw = Rand.range(r, 0.9, 1.8)
					local bh = Rand.range(r, 0.8, 1.6)
					local box = B.box(m, cf * CFrame.new(x + bw / 2, y + 0.1 + bh / 2, Rand.range(r, -0.2, 0.2)), Vector3.new(bw, bh, depth * 0.8), Rand.pick(r, boxCols), M.Cardboard, noCollide({ CastShadow = false }))
					box:AddTag("ShelfBox")
					x += bw + 0.15
				else
					x += 1.2
				end
			end
		end
	end
	return m
end

function Props.monitor(parent: Instance, cf: CFrame, text: string?, glow: Color3?): Model
	local m = B.model("Monitor", parent)
	local dark = Color3.fromRGB(20, 20, 24)
	B.box(m, cf * CFrame.new(0, 0.08, 0.2), Vector3.new(1.6, 0.16, 1), dark, M.Metal)
	B.box(m, cf * CFrame.new(0, 0.9, 0.35), Vector3.new(0.25, 1.6, 0.25), dark, M.Metal, noCollide())
	local screen = B.box(m, cf * CFrame.new(0, 1.9, 0.15), Vector3.new(3.4, 2, 0.15), dark, M.SmoothPlastic, noCollide({ Name = "Screen" }))
	B.sign(screen, Enum.NormalId.Front, text or "", { name = "ScreenGui", glow = true, brightness = 1.2, color = Color3.fromRGB(220, 240, 255), background = glow or Color3.fromRGB(16, 40, 80), font = B.Fonts.Mono })
	return m
end

function Props.counter(parent: Instance, cf: CFrame, w: number, color: any?, top: any?): Model
	local m = B.model("Counter", parent)
	B.box(m, cf * CFrame.new(0, 1.9, 0), Vector3.new(w, 3.8, 2.6), B.color(color or { 230, 230, 228 }), M.SmoothPlastic)
	B.box(m, cf * CFrame.new(0, 3.9, -0.1), Vector3.new(w + 0.4, 0.2, 3), B.color(top or { 60, 60, 66 }), M.Marble)
	B.box(m, cf * CFrame.new(0, 0.3, -1.25), Vector3.new(w - 0.4, 0.6, 0.15), Color3.fromRGB(0, 170, 220), M.Neon, noCollide())
	return m
end

function Props.coffeeMachine(parent: Instance, cf: CFrame): Model
	local m = B.model("CoffeeMachine", parent)
	B.box(m, cf * CFrame.new(0, 1, 0), Vector3.new(1.6, 2, 1.4), Color3.fromRGB(180, 180, 186), M.Metal)
	B.box(m, cf * CFrame.new(0, 0.45, -0.6), Vector3.new(0.9, 0.2, 0.4), Color3.fromRGB(40, 40, 40), M.Metal, noCollide())
	B.cylY(m, cf * CFrame.new(0, 0.75, -0.55), 0.4, 0.5, Color3.fromRGB(250, 250, 250), M.SmoothPlastic, noCollide())
	return m
end

function Props.samovar(parent: Instance, cf: CFrame): Model
	local m = B.model("Samovar", parent)
	local brass = Color3.fromRGB(196, 150, 70)
	B.cylY(m, cf * CFrame.new(0, 0.9, 0), 1.8, 1.4, brass, M.Metal)
	B.cylY(m, cf * CFrame.new(0, 2.1, 0), 0.6, 0.9, Color3.fromRGB(240, 240, 240), M.SmoothPlastic)
	B.cylY(m, cf * CFrame.new(0, 2.5, 0), 0.4, 0.5, Color3.fromRGB(150, 50, 40), M.SmoothPlastic)
	for i = 1, 4 do
		local a = i * math.pi / 2
		B.cylY(m, cf * CFrame.new(math.cos(a) * 1.3, 0.35, math.sin(a) * 1.3), 0.7, 0.4, Color3.fromRGB(240, 240, 240), M.Glass, noCollide({ Transparency = 0.3 }))
	end
	return m
end

function Props.aquarium(parent: Instance, cf: CFrame, rng: Random?): Model
	local r = rng or Random.new()
	local m = B.model("Aquarium", parent)
	B.box(m, cf * CFrame.new(0, 1.5, 0), Vector3.new(6, 3, 2.2), Color3.fromRGB(40, 36, 32), M.Wood)
	B.box(m, cf * CFrame.new(0, 4.3, 0), Vector3.new(6, 2.6, 2), Color3.fromRGB(90, 170, 210), M.Glass, { Transparency = 0.55 })
	B.box(m, cf * CFrame.new(0, 3.2, 0), Vector3.new(5.8, 0.3, 1.8), Color3.fromRGB(220, 200, 150), M.Sand, noCollide())
	for _ = 1, 5 do
		local fish = B.ellipsoid(m, cf * CFrame.new(Rand.range(r, -2.4, 2.4), Rand.range(r, 3.8, 5), Rand.range(r, -0.6, 0.6)), Vector3.new(0.6, 0.35, 0.2), Rand.pick(r, { Color3.fromRGB(255, 140, 30), Color3.fromRGB(250, 220, 60), Color3.fromRGB(80, 160, 250) }), M.SmoothPlastic, noCollide())
		fish:AddTag("Fish")
	end
	B.surfaceLight(B.box(m, cf * CFrame.new(0, 5.7, 0), Vector3.new(6, 0.2, 2.2), Color3.fromRGB(40, 36, 32), M.Wood), Enum.NormalId.Bottom, 6, 90, 1.5, Color3.fromRGB(150, 220, 255))
	return m
end

function Props.arcade(parent: Instance, cf: CFrame): Model
	local m = B.model("Arcade", parent)
	B.box(m, cf * CFrame.new(0, 3, 0), Vector3.new(2.6, 6, 2.4), Color3.fromRGB(30, 30, 80), M.SmoothPlastic)
	local screen = B.box(m, cf * CFrame.new(0, 4, -1.1) * CFrame.Angles(math.rad(-12), 0, 0), Vector3.new(2, 1.6, 0.1), Color3.fromRGB(10, 10, 10), M.Glass, noCollide())
	B.sign(screen, Enum.NormalId.Front, "INSERT COIN", { glow = true, color = Color3.fromRGB(255, 240, 80), background = Color3.fromRGB(10, 10, 30), font = B.Fonts.Mono })
	local marquee = B.box(m, cf * CFrame.new(0, 5.6, -1.05), Vector3.new(2.4, 0.6, 0.1), Color3.fromRGB(240, 60, 120), M.Neon, noCollide())
	B.sign(marquee, Enum.NormalId.Front, "PAC-TAMİRCİ", { color = Color3.new(1, 1, 1) })
	return m
end

function Props.tv(parent: Instance, cf: CFrame, text: string): Model
	local m = B.model("TV", parent)
	local frame = B.box(m, cf, Vector3.new(7, 4, 0.3), Color3.fromRGB(18, 18, 20), M.SmoothPlastic, noCollide())
	B.sign(frame, Enum.NormalId.Front, text, { glow = true, color = Color3.new(1, 1, 1), background = Color3.fromRGB(20, 60, 110), rich = true })
	frame:AddTag("WaitingTV")
	return m
end

return Props
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1294">
          <Properties>
            <string name="Name">ShopBuilder</string>
            <string name="Source"><![CDATA[-- ShopBuilder: a player's repair shop on a plot, rebuilt whenever it levels up or gets new items,
-- plus the empty "for rent" lot. Everything gameplay needs is exposed as named markers under
-- a "Points" folder (door, counter, queue, seats, benches, staff spots, thief targets...).
--
-- Local frame: origin = centre of the plot's street edge, -Z = street, the plot extends to +Z.

local B = require(script.Parent.Parent.Util.Builder)
local Rand = require(script.Parent.Parent.Util.Rand)
local Props = require(script.Parent.Props)
local Buildings = require(script.Parent.Buildings)
local Upgrades = require(script.Parent.Parent.Data.Upgrades)

local ShopBuilder = {}
local M = Enum.Material

local SETBACK = 7
local WALL_H = 16

local function nc(extra)
	local t = { CanCollide = false, CanTouch = false }
	if extra then
		for k, v in extra do
			t[k] = v
		end
	end
	return t
end

local function styleById(list, id, default)
	for _, s in list do
		if s.id == id then
			return s
		end
	end
	return default or list[1]
end

local function material(name: string)
	return (Enum.Material :: any)[name] or M.SmoothPlastic
end

-- Floor plan bookkeeping in the shop's local frame (x across, z from the front glass inwards).
-- Claims are { x0, z0, x1, z1 } rectangles: "hard" furniture, "walk" aisles furniture must keep
-- clear, and "stand" spots reserved for people.
local Plan = {}
Plan.__index = Plan

function Plan.new(w: number, d: number)
	return setmetatable({ w = w, d = d, rects = {} }, Plan)
end

-- mode "hard": room for furniture (avoids everything); "stand": room for a person
function Plan:free(r, mode: string): boolean
	local inner = self.w / 2 - 1
	if r[1] < -inner - 1e-3 or r[3] > inner + 1e-3 or r[2] < 1 - 1e-3 or r[4] > self.d - 1 + 1e-3 then
		return false
	end
	for _, c in self.rects do
		if (mode == "hard" or c.kind ~= "walk") and r[1] < c[3] and c[1] < r[3] and r[2] < c[4] and c[2] < r[4] then
			return false
		end
	end
	return true
end

function Plan:claim(r, kind: string)
	table.insert(self.rects, { r[1], r[2], r[3], r[4], kind = kind })
end

-- first offset along a wall run where an item `len` long and `depth` deep fits
function Plan:wallSlot(run, len: number, depth: number): (number?, { number }?)
	local t = 0
	while t + len <= run.len + 1e-3 do
		local r = run:rect(t, len, depth)
		if self:free(r, "hard") then
			return t, r
		end
		t += 0.5
	end
	return nil, nil
end

-- A stretch of wall starting at (x, z), running along (ax, az), facing the room along (ix, iz).
local WallRun = {}
WallRun.__index = WallRun

local function wallRun(x: number, z: number, ax: number, az: number, ix: number, iz: number, len: number)
	return setmetatable({ x = x, z = z, ax = ax, az = az, ix = ix, iz = iz, len = math.max(0, len) }, WallRun)
end

function WallRun:rect(t: number, len: number, depth: number): { number }
	local x0, z0 = self.x + self.ax * t, self.z + self.az * t
	local x1, z1 = x0 + self.ax * len + self.ix * depth, z0 + self.az * len + self.iz * depth
	return { math.min(x0, x1), math.min(z0, z1), math.max(x0, x1), math.max(z0, z1) }
end

-- workbench footprint: 10 along the wall, origin 2.9 off it, stool reaching 7.8 into the room
local BENCH_LEN, BENCH_BACK, BENCH_DEPTH = 10, 2.9, 7.8

local POSTERS = {
	"RTX 5090\nSTOKTA!",
	"ÜCRETSİZ\nARIZA TESPİTİ",
	"6 AY\nGARANTİLİ TAMİR",
	"TERMAL MACUN\nBAKIMI 15 DK",
	"SSD İLE\n10 KAT HIZ",
	"OYUNCU PC\nTOPLAMA",
	"LAPTOP EKRAN\nDEĞİŞİMİ",
	"VERİ\nKURTARMA",
}

-- Workbench facing into the room (cf.LookVector points at the technician).
function ShopBuilder.workbench(parent: Instance, cf: CFrame, index: number, items: { [string]: boolean }, rng: Random)
	local m = B.model("Workbench_" .. index, parent)
	local top = Color3.fromRGB(70, 74, 82)
	local legs = Color3.fromRGB(40, 42, 46)
	-- desk (top surface at y = 3.4)
	B.box(m, cf * CFrame.new(0, 3.25, 0), Vector3.new(10, 0.3, 4.6), top, M.Metal)
	for x = -1, 1, 2 do
		B.box(m, cf * CFrame.new(x * 4.7, 1.55, 0), Vector3.new(0.4, 3.1, 4.2), legs, M.Metal)
	end
	B.box(m, cf * CFrame.new(0, 2.2, 2), Vector3.new(9, 2, 0.3), legs, M.Metal)
	-- drawers
	B.box(m, cf * CFrame.new(3.4, 2, -0.2), Vector3.new(2.4, 2.4, 3.8), Color3.fromRGB(200, 40, 40), M.Metal)
	for k = 0, 2 do
		B.box(m, cf * CFrame.new(3.4, 1.2 + k * 0.8, -2.15), Vector3.new(2.2, 0.6, 0.1), Color3.fromRGB(170, 30, 30), M.Metal, nc())
	end
	-- ESD mat
	local matCol = if items.bench_mat then Color3.fromRGB(40, 110, 200) else Color3.fromRGB(110, 114, 120)
	B.box(m, cf * CFrame.new(-0.6, 3.42, 0), Vector3.new(7, 0.05, 3.8), matCol, M.Rubber, nc({ Name = "Mat" }))
	-- test monitor on the back right
	Props.monitor(m, cf * CFrame.new(3.1, 3.4, 1.4) * CFrame.Angles(0, math.rad(-12), 0), "", Color3.fromRGB(10, 30, 50))
	local mon = m:FindFirstChild("Monitor")
	if mon then
		mon.Name = "BenchMonitor"
		local screen = mon:FindFirstChild("Screen")
		if screen then
			screen:SetAttribute("BenchScreen", true)
		end
	end
	-- magnifier lamp clamped to the back edge (clear of the parts area), arm leaning over the mat
	B.box(m, cf * CFrame.new(-4.3, 3.6, 2.05), Vector3.new(0.5, 0.5, 0.45), legs, M.Metal)
	local armLen = math.sqrt(1.15 ^ 2 + 2.7 ^ 2)
	B.box(m, cf * CFrame.new(-4.3, 5.2, 1.48) * CFrame.Angles(-math.atan2(1.15, 2.7), 0, 0), Vector3.new(0.2, armLen, 0.2), legs, M.Metal, nc())
	local lampHead = B.cyl(m, cf * CFrame.new(-4.2, 6.6, 0.8) * CFrame.Angles(0, 0, math.pi / 2), 0.3, 1.6, legs, M.Metal, nc())
	lampHead.Name = "LampHead"
	if items.bench_led then
		local led = B.cylY(m, cf * CFrame.new(-4.2, 6.42, 0.8), 0.06, 1.4, Color3.fromRGB(255, 250, 240), M.Neon, nc())
		B.spotLight(led, Enum.NormalId.Bottom, 10, 70, 1.4, Color3.fromRGB(255, 250, 240), false)
	end
	-- magnetic screw bowl, where PCModel drops the screws (device frame TRAY)
	B.cylY(m, cf * CFrame.new(2.6, 3.5, -1.2), 0.2, 1.2, Color3.fromRGB(150, 150, 156), M.Metal, nc({ Name = "ScrewTray" }))
	-- stool
	local stool = cf * CFrame.new(0, 0, -3.6)
	B.cylY(m, stool * CFrame.new(0, 1.2, 0), 2.4, 0.4, legs, M.Metal)
	B.cylY(m, stool * CFrame.new(0, 0.1, 0), 0.2, 2, legs, M.Metal)
	local seat = Instance.new("Seat")
	seat.Name = "Stool"
	seat.Anchored = true
	seat.Size = Vector3.new(1.8, 0.4, 1.8)
	seat.Color = Color3.fromRGB(30, 30, 34)
	seat.Material = M.Leather
	seat.TopSurface = Enum.SurfaceType.Smooth
	seat.CFrame = stool * CFrame.new(0, 2.5, 0) * CFrame.Angles(0, math.pi, 0)
	seat.Parent = m
	-- the device sits here; LookVector faces the technician
	local anchor = B.marker(m, "DeviceAnchor", cf * CFrame.new(-0.6, 3.45, 0))
	anchor:SetAttribute("Bench", index)
	local camAnchor = B.marker(m, "CameraAnchor", cf * CFrame.new(-0.6, 9.5, -6.5))
	camAnchor:SetAttribute("Bench", index)
	local prompt = B.prompt(B.marker(m, "PromptAnchor", stool * CFrame.new(0, 3, 0)), "Tezgâha Geç", "Tezgâh " .. index, { distance = 8, name = "BenchPrompt" })
	prompt:SetAttribute("Bench", index)
	m:SetAttribute("Bench", index)
	B.tag(m, "Workbench")
	-- pegboard with tools on the wall behind the bench
	if items.tool_wall then
		local board = B.box(m, cf * CFrame.new(0, 7.6, 2.6), Vector3.new(9, 5, 0.3), Color3.fromRGB(196, 168, 124), M.Wood)
		board.Name = "ToolWall"
		local toolCols = { Color3.fromRGB(220, 40, 30), Color3.fromRGB(30, 100, 200), Color3.fromRGB(240, 170, 20), Color3.fromRGB(40, 40, 44) }
		for k = 0, 7 do
			B.box(m, cf * CFrame.new(-3.8 + k * 1.1, 7.6 + ((k % 2) * 0.6 - 0.3), 2.4), Vector3.new(0.25, Rand.range(rng, 1.4, 2.6), 0.2), toolCols[(k % 4) + 1], M.SmoothPlastic, nc())
		end
	end
	if items.microscope and index == 1 then
		B.cylY(m, cf * CFrame.new(-2.6, 3.9, 1.2), 1, 1.4, Color3.fromRGB(230, 230, 230), M.SmoothPlastic, nc())
		B.cylY(m, cf * CFrame.new(-2.6, 5.2, 1.0), 1.8, 0.5, Color3.fromRGB(40, 40, 44), M.Metal, nc())
	end
	return m
end

-- Empty plot available for rent.
function ShopBuilder.emptyLot(parent: Instance, cf: CFrame, plotW: number, plotD: number, plotId: number): Model
	local m = B.model("Plot_" .. plotId .. "_Empty", parent)
	B.box(m, cf * CFrame.new(0, 0.06, plotD / 2), Vector3.new(plotW - 2, 0.12, plotD - 2), Color3.fromRGB(150, 140, 126), M.Pebble, { Name = "LotGround" })
	-- construction hoarding along the front with a gap
	local hoard = Color3.fromRGB(230, 230, 226)
	B.box(m, cf * CFrame.new(-plotW / 4 - 4, 3, 2), Vector3.new(plotW / 2 - 10, 6, 0.4), hoard, M.SmoothPlastic)
	B.box(m, cf * CFrame.new(plotW / 4 + 4, 3, 2), Vector3.new(plotW / 2 - 10, 6, 0.4), hoard, M.SmoothPlastic)
	local stripe = B.box(m, cf * CFrame.new(-plotW / 4 - 4, 5.4, 1.75), Vector3.new(plotW / 2 - 10, 0.8, 0.1), Color3.fromRGB(0, 160, 210), M.SmoothPlastic, nc())
	stripe.Name = "Stripe"
	-- sign with the prompt
	local post = cf * CFrame.new(0, 0, 4)
	for x = -1, 1, 2 do
		B.box(m, post * CFrame.new(x * 3.6, 4, 0), Vector3.new(0.4, 8, 0.4), Color3.fromRGB(60, 60, 64), M.Metal)
	end
	local board = B.box(m, post * CFrame.new(0, 7.4, 0), Vector3.new(8, 4, 0.3), Color3.fromRGB(240, 200, 40), M.SmoothPlastic)
	B.sign(board, Enum.NormalId.Front, "KİRALIK DÜKKÂN\n#" .. plotId, { color = Color3.fromRGB(30, 30, 30), font = B.Fonts.Heavy })
	local prompt = B.prompt(board, "Bu Dükkânı Tut", "Kiralık Dükkân #" .. plotId, { distance = 14, hold = 0.5, name = "ClaimPrompt" })
	prompt:SetAttribute("Plot", plotId)
	-- a few construction props
	Props.pallet(m, cf * CFrame.new(-plotW / 3, 0.1, plotD * 0.6))
	Props.crate(m, cf * CFrame.new(plotW / 3, 0.1, plotD * 0.5), 3)
	B.box(m, cf * CFrame.new(plotW / 4, 1.2, plotD * 0.7), Vector3.new(6, 2.4, 3), Color3.fromRGB(196, 186, 170), M.Concrete)
	m:SetAttribute("Plot", plotId)
	B.tag(m, "EmptyPlot")
	return m
end

-- Builds a player's shop. opts: level, name, owner, wall, floor, accent, items, plotWidth, plotDepth, plotId
function ShopBuilder.build(parent: Instance, cf: CFrame, opts): (Model, { [string]: any })
	local level = math.clamp(opts.level or 1, 1, #Upgrades.levels)
	local L = Upgrades.levels[level]
	local items = opts.items or {}
	local rng = Random.new(opts.seed or 7)
	local wallStyle = styleById(Upgrades.wallStyles, opts.wall or "white")
	local floorStyle = styleById(Upgrades.floorStyles, opts.floor or "tiles")
	local accentRGB = Upgrades.accentColors[opts.accent or 1] or Upgrades.accentColors[1]
	local accent = Color3.fromRGB(accentRGB[1], accentRGB[2], accentRGB[3])
	local plotW, plotD = opts.plotWidth or 62, opts.plotDepth or 84
	local W, D = L.w, L.d
	local H = if (L.floors or 1) > 1 then 26 else WALL_H

	local shop = B.model("Shop", parent)
	shop:SetAttribute("Level", level)
	local points = B.folder("Points", shop)
	local function point(name: string, pcf: CFrame, attrs: { [string]: any }?)
		local mk = B.marker(points, name, pcf, Vector3.new(1, 1, 1))
		if attrs then
			for k, v in attrs do
				mk:SetAttribute(k, v)
			end
		end
		return mk
	end

	-- forecourt and lot
	B.box(shop, cf * CFrame.new(0, 0.06, SETBACK / 2), Vector3.new(plotW - 2, 0.12, SETBACK), Color3.fromRGB(200, 196, 188), M.Pavement)
	B.box(shop, cf * CFrame.new(0, 0.06, SETBACK + D + (plotD - SETBACK - D) / 2), Vector3.new(plotW - 2, 0.12, math.max(1, plotD - SETBACK - D - 1)), Color3.fromRGB(110, 150, 80), M.Grass)
	local front = cf * CFrame.new(0, 0.12, SETBACK)

	-- the building shell
	local hall = Buildings.hall(shop, front, W, D, H, {
		name = opts.name or "Bilgisayar Tamir",
		accent = accent,
		wall = wallStyle.color,
		wallMat = material(wallStyle.material),
		floor = floorStyle.color,
		floorMat = material(floorStyle.material),
		door = 8,
		modelName = "Building",
	})
	if floorStyle.checker then
		for i = 0, math.floor(W / 4) - 1 do
			for j = 0, math.floor(D / 4) - 1 do
				if (i + j) % 2 == 0 then
					B.box(hall, front * CFrame.new(-W / 2 + 2 + i * 4, 0.22, 2 + j * 4), Vector3.new(4, 0.04, 4), Color3.fromRGB(240, 240, 240), M.SmoothPlastic, nc({ CanCollide = true }))
				end
			end
		end
	end
	if (L.floors or 1) > 1 then
		-- second storey glass band and a rooftop sign
		B.box(shop, front * CFrame.new(0, 17, -0.6), Vector3.new(W, 1, 1.4), accent, M.SmoothPlastic)
		local roofSign = B.box(shop, front * CFrame.new(0, H + 6, D / 2), Vector3.new(math.min(W - 6, 44), 7, 1), Color3.fromRGB(20, 20, 24), M.SmoothPlastic)
		B.sign(roofSign, Enum.NormalId.Front, opts.name or "MEGA TECH", { color = accent, glow = true, brightness = 2.2 })
		B.box(shop, front * CFrame.new(0, H + 1.5, D / 2), Vector3.new(4, 3, 1), Color3.fromRGB(60, 60, 64), M.Metal)
	end
	-- awning in the accent colour
	Buildings.awning(shop, front * CFrame.new(-W / 4 - 2, 11.6, 0), W / 2 - 8, accent, rng)
	Buildings.awning(shop, front * CFrame.new(W / 4 + 2, 11.6, 0), W / 2 - 8, accent, rng)

	-- doorway points
	point("Street", cf * CFrame.new(0, 0.5, -6))
	point("Outside", front * CFrame.new(0, 0.5, -4))
	point("Door", front * CFrame.new(0, 0.5, 3))

	-- zones: front (waiting + counter) up to fz, workshop behind it
	local fz = math.clamp(D * 0.5, 14, 22)
	local inner = W / 2 - 1
	local plan = Plan.new(W, D)
	local function at(x: number, z: number, y: number?): CFrame
		return front * CFrame.new(x, y or 0.12, z)
	end
	local function facing(x: number, z: number, ix: number, iz: number): CFrame
		local o = Vector3.new(x, 0.12, z)
		return front * CFrame.lookAt(o, o + Vector3.new(ix, 0, iz))
	end
	local function local2(cf0: CFrame): (number, number)
		local p = front:PointToObjectSpace(cf0.Position)
		return p.X, p.Z
	end
	local walls = {
		leftFront = wallRun(-inner, 1.2, 0, 1, 1, 0, fz - 1.7),
		rightFront = wallRun(inner, 1.2, 0, 1, -1, 0, fz - 1.7),
		frontLeft = wallRun(-inner, 1.2, 1, 0, 0, 1, inner - 4.6),
		frontRight = wallRun(4.6, 1.2, 1, 0, 0, 1, inner - 4.6),
		leftWork = wallRun(-inner, fz + 0.5, 0, 1, 1, 0, D - 1.5 - fz),
		rightWork = wallRun(inner, fz + 0.5, 0, 1, -1, 0, D - 1.5 - fz),
		back = wallRun(-inner, D - 1, 1, 0, 0, -1, 2 * inner),
	}
	-- puts an item `len` long against the first wall run with room for it; `back` is the
	-- distance from the wall to the item's origin, `depth` how far it reaches into the room
	local function wallItem(runs, len: number, back: number, depth: number, make: (CFrame) -> ()): CFrame?
		for _, run in runs do
			local t, r = plan:wallSlot(run, len, depth)
			if t then
				plan:claim(r, "hard")
				local mid = t + len / 2
				local c = facing(run.x + run.ax * mid + run.ix * back, run.z + run.az * mid + run.iz * back, run.ix, run.iz)
				make(c)
				return c
			end
		end
		return nil
	end
	-- a free spot for a person to stand, searched outwards from (x, z)
	local function standSpot(name: string, x: number, z: number, attrs: { [string]: any }?)
		for ring = 0, 14 do
			local n = math.max(1, ring * 6)
			for k = 0, n - 1 do
				local a = k / n * math.pi * 2
				local px, pz = x + math.cos(a) * ring * 0.7, z + math.sin(a) * ring * 0.7
				local r = { px - 0.75, pz - 0.75, px + 0.75, pz + 0.75 }
				if plan:free(r, "stand") then
					plan:claim(r, "stand")
					return point(name, at(px, pz, 0.5), attrs)
				end
			end
		end
		return point(name, at(x, z, 0.5), attrs)
	end

	-- keep the doorway clear
	plan:claim({ -4.6, 1, 4.6, 7 }, "walk")

	-- counter facing the door right of centre; the receptionist stands behind it
	local counterW = math.min(10, W / 3)
	local xc = math.min(W / 4, inner - 5 - counterW / 2)
	local zc = fz - 5
	local counterCf = at(xc, zc)
	Props.counter(shop, counterCf, counterW, Color3.fromRGB(236, 236, 236), Color3.fromRGB(40, 40, 46))
	plan:claim({ xc - counterW / 2 - 0.2, zc - 1.6, xc + counterW / 2 + 0.2, zc + 1.4 }, "hard")
	if items.safe then
		local sx = xc - counterW / 2 + 1.7
		local safe = B.box(shop, at(sx, zc + 2.9, 1.72), Vector3.new(3, 3.2, 2.4), Color3.fromRGB(60, 64, 70), M.DiamondPlate)
		safe.Name = "Safe"
		plan:claim({ sx - 1.5, zc + 1.7, sx + 1.5, zc + 4.1 }, "hard")
	end
	plan:claim({ xc - counterW / 2, zc + 1.4, xc + counterW / 2, zc + 3.6 }, "walk")
	plan:claim({ xc - counterW / 2, zc - 4.2, xc + counterW / 2, zc - 1.6 }, "walk")
	point("CounterFront", at(xc, zc - 3, 0.5))
	point("CounterBack", at(xc, zc + 2.6, 0.5), { Role = "receptionist" })
	point("Register", counterCf * CFrame.new(counterW / 2 - 2, 4.5, 0.3))
	if items.trophy then
		-- glass trophy cabinet on the wall nearest the counter
		wallItem({ walls.rightFront, walls.leftFront, walls.back, walls.rightWork, walls.leftWork }, 6, 1.15, 2.3, function(c)
			local m = B.model("TrophyCabinet", shop)
			B.box(m, c * CFrame.new(0, 3.5, 0), Vector3.new(6, 7, 2.2), Color3.fromRGB(90, 60, 40), M.Wood)
			for k = 0, 2 do
				B.cylY(m, c * CFrame.new(-1.6 + k * 1.6, 3 + k * 1.4, -0.9), 1.2, 0.8, Color3.fromRGB(230, 190, 60), M.Metal, nc())
			end
		end)
	end

	-- the queue runs back from the counter towards the window, then along it
	local queued = 0
	local function queueSpot(x: number, z: number)
		local r = { x - 0.75, z - 0.75, x + 0.75, z + 0.75 }
		if queued < L.queue and plan:free(r, "stand") then
			queued += 1
			plan:claim(r, "stand")
			point("Queue_" .. queued, at(x, z, 0.5))
		end
	end
	local qz = zc - 5.4
	while qz >= 4.2 and queued < L.queue do
		queueSpot(xc, qz)
		qz -= 2.4
	end
	qz = math.max(qz + 2.4, 4.2)
	for k = 1, 16 do
		queueSpot(xc + k * 2.4, qz)
		queueSpot(xc - k * 2.4, qz + 2.4)
	end

	-- workbenches along the workshop walls, the ones nearest the counter first
	local candidates = {}
	for _, run in { walls.rightWork, walls.leftWork, walls.back } do
		local t = 0
		while t + BENCH_LEN <= run.len + 1e-3 do
			local mid = t + BENCH_LEN / 2
			local x, z = run.x + run.ax * mid + run.ix * BENCH_BACK, run.z + run.az * mid + run.iz * BENCH_BACK
			table.insert(candidates, { run = run, t = t, x = x, z = z, d = (x - xc) ^ 2 + (z - zc) ^ 2 })
			t += BENCH_LEN + 1
		end
	end
	table.sort(candidates, function(a, b)
		return a.d < b.d
	end)
	local placed = 0
	for _, c in candidates do
		local r = c.run:rect(c.t, BENCH_LEN, BENCH_DEPTH)
		if placed < L.benches and plan:free(r, "hard") then
			plan:claim(r, "hard")
			placed += 1
			local bcf = facing(c.x, c.z, c.run.ix, c.run.iz)
			ShopBuilder.workbench(shop, bcf, placed, items, rng)
			point("Staff_" .. placed, bcf * CFrame.new(0, 0.4, -3.6), { Bench = placed })
		end
	end
	shop:SetAttribute("Benches", placed)

	-- a storage island in the middle of big workshops
	if (items.parts_shelves or items.warehouse) and W >= 48 then
		local iz = (fz + D) / 2
		local r = { -5, iz - 5.2, 5, iz + 5.2 }
		if plan:free(r, "hard") then
			plan:claim(r, "hard")
			Props.shelf(shop, facing(-3.6, iz, 1, 0), 10, 9, 2.4, rng, 0.9)
			Props.shelf(shop, facing(3.6, iz, -1, 0), 10, 9, 2.4, rng, 0.9)
			standSpot("Shelf_island", 0, iz - 6.4)
		end
	end
	-- parts shelving: the right wall of the front zone first, then any free wall
	local shelves = 0
	local wantShelves = 1 + (if items.parts_shelves then 2 else 0) + (if items.warehouse then 2 else 0)
	for _ = 1, wantShelves do
		local scf = wallItem({ walls.rightFront, walls.leftWork, walls.rightWork, walls.back }, 7, 1.25, 2.5, function(c)
			Props.shelf(shop, c, 7, 8, 2.4, rng, 0.85)
		end)
		if not scf then
			break
		end
		shelves += 1
		local sx, sz = local2(scf * CFrame.new(0, 0, -2.5))
		standSpot("Shelf_" .. shelves, sx, sz)
	end

	-- waiting area between the left wall and the doorway, chairs facing the TV
	local seats, sx0, sx1, szMin, szMax = 0, math.huge, -math.huge, math.huge, -math.huge
	local row, rowZ = 0, fz - 4
	while seats < L.seats and rowZ >= 5 do
		local sofa = items.sofa and row == 0
		local half = if sofa then 1.8 else 1.1
		local x = -5.8
		while seats < L.seats and x - half >= -inner + 4.6 do
			local r = { x - half, rowZ - 1.3, x + half, rowZ + 1.3 }
			if plan:free(r, "hard") then
				plan:claim(r, "hard")
				seats += 1
				local c = facing(x, rowZ, 0, 1)
				if sofa then
					local m = B.model("Sofa", shop)
					local leather = Color3.fromRGB(110, 70, 40)
					B.box(m, c * CFrame.new(0, 1.4, -0.1), Vector3.new(3.4, 1.6, 2.2), leather, M.Leather)
					B.box(m, c * CFrame.new(0, 2.8, 0.95), Vector3.new(3.4, 2, 0.5), leather, M.Leather)
					local seat = Instance.new("Seat")
					seat.Name = "Seat"
					seat.Anchored = true
					seat.Transparency = 1
					seat.CanCollide = false
					seat.Size = Vector3.new(2.4, 0.3, 1.6)
					seat.CFrame = c * CFrame.new(0, 2.25, -0.1)
					seat.Parent = m
				else
					Props.chair(shop, c, accent:Lerp(Color3.new(0, 0, 0), 0.4))
				end
				point("Seat_" .. seats, c * CFrame.new(0, 0.4, 0), { Seat = true })
				sx0, sx1 = math.min(sx0, x - half), math.max(sx1, x + half)
				szMin, szMax = math.min(szMin, rowZ), math.max(szMax, rowZ)
			end
			x -= half * 2 + 0.4
		end
		row += 1
		rowZ -= 3.4
	end
	if seats > 0 then
		local cx = (sx0 + sx1) / 2
		if items.carpet then
			B.box(shop, at(cx, (szMin + szMax) / 2, 0.05), Vector3.new(sx1 - sx0 + 2, 0.06, szMax - szMin + 4), Color3.fromRGB(160, 40, 50), M.Carpet, nc({ CanCollide = true, Name = "Carpet" }))
		end
		if items.tv then
			local tz = math.min(szMax + 2.6, fz - 0.6)
			B.box(shop, at(cx, tz, (H + 11.5) / 2), Vector3.new(0.3, H - 11.5, 0.3), Color3.fromRGB(30, 30, 34), M.Metal, nc())
			Props.tv(shop, at(cx, tz, 9.5), "<b>" .. (opts.name or "Bilgisayar Tamir") .. "</b>\nHoş geldiniz!")
		end
	end

	-- comforts and decorations wherever a wall has room
	local comfortRuns = { walls.leftFront, walls.frontLeft, walls.rightFront, walls.leftWork, walls.back, walls.rightWork }
	if items.tea then
		wallItem(comfortRuns, 3, 1.55, 3.1, function(c)
			local m = B.model("TeaStation", shop)
			B.box(m, c * CFrame.new(0, 1.6, 0), Vector3.new(3, 3.2, 3), Color3.fromRGB(150, 110, 70), M.Wood)
			Props.samovar(m, c * CFrame.new(0, 3.2, 0))
		end)
	end
	if items.coffee then
		wallItem(comfortRuns, 3, 1.55, 3.1, function(c)
			local m = B.model("CoffeeStation", shop)
			B.box(m, c * CFrame.new(0, 1.6, 0), Vector3.new(3, 3.2, 3), Color3.fromRGB(70, 70, 76), M.Metal)
			Props.coffeeMachine(m, c * CFrame.new(0, 3.2, 0))
		end)
	end
	if items.vending then
		wallItem(comfortRuns, 3, 1.75, 3.4, function(c)
			local m = B.model("Vending", shop)
			B.box(m, c * CFrame.new(0, 3.2, 0.1), Vector3.new(3, 6.4, 3.2), Color3.fromRGB(200, 40, 40), M.SmoothPlastic)
			B.box(m, c * CFrame.new(0, 3.8, -1.55), Vector3.new(2.4, 4, 0.1), Color3.fromRGB(180, 220, 240), M.Glass, nc({ Transparency = 0.3, Name = "VendingGlass" }))
		end)
	end
	if items.aquarium then
		wallItem(comfortRuns, 6, 1.15, 2.3, function(c)
			Props.aquarium(shop, c, rng)
		end)
	end
	if items.arcade then
		wallItem({ walls.leftFront, walls.frontLeft, walls.frontRight, walls.leftWork, walls.back }, 2.6, 1.25, 4, function(c)
			Props.arcade(shop, c)
		end)
	end
	-- showroom displays with PCs for sale behind the front glass
	if items.showcase and level >= 4 then
		for i = 1, 3 do
			local d = wallItem({ walls.frontLeft, walls.frontRight }, 5, 1.8, 3.6, function(c)
				local m = B.model("Showcase", shop)
				B.box(m, c * CFrame.new(0, 1.6, 0), Vector3.new(5, 3.2, 3.4), Color3.fromRGB(240, 240, 240), M.SmoothPlastic)
				B.box(m, c * CFrame.new(0, 3.25, 0), Vector3.new(4.8, 0.1, 3.2), accent, M.Neon, nc())
			end)
			if not d then
				break
			end
			point("Showcase_" .. i, d * CFrame.new(0, 3.3, 0), { Showcase = i })
		end
	end
	if items.plants then
		for _, p in { { -inner + 1.2, fz - 1 }, { inner - 1.2, fz - 1 }, { -inner + 1.2, D - 2.2 }, { inner - 1.2, D - 2.2 }, { 5.8, 2.3 }, { -5.8, 2.3 } } do
			local r = { p[1] - 1, p[2] - 1, p[1] + 1, p[2] + 1 }
			if plan:free(r, "hard") then
				plan:claim(r, "hard")
				Props.plant(shop, at(p[1], p[2]), rng)
			end
		end
		Props.planter(shop, cf * CFrame.new(-W / 2 + 2, 0.12, SETBACK / 2), rng)
		Props.planter(shop, cf * CFrame.new(W / 2 - 2, 0.12, SETBACK / 2), rng)
	end
	if items.music then
		for x = -1, 1, 2 do
			B.box(shop, at(x * (inner - 0.6), 4, H - 2.4), Vector3.new(1.2, 2, 1.2), Color3.fromRGB(20, 20, 22), M.SmoothPlastic, nc({ Name = "Speaker" }))
		end
	end
	if items.ac then
		local ac = B.box(shop, at(0, D - 1.5, H - 3), Vector3.new(7, 2, 1), Color3.fromRGB(246, 246, 246), M.SmoothPlastic, nc())
		ac.Name = "AC"
	end
	if items.posters then
		for i = 1, math.min(#POSTERS, 2 + level) do
			local side = if i % 2 == 0 then 1 else -1
			local z = 6 + (i // 2) * 9
			if z < D - 6 then
				local poster = B.box(shop, at(side * (inner - 0.05), z, 12.3), Vector3.new(0.1, 3.6, 3.2), Color3.fromRGB(20, 20, 24), M.SmoothPlastic, nc())
				B.sign(poster, if side > 0 then Enum.NormalId.Left else Enum.NormalId.Right, POSTERS[i], { color = Color3.new(1, 1, 1), background = accent:Lerp(Color3.new(0, 0, 0), 0.35), glow = true, brightness = 1 })
			end
		end
	end
	if items.rgb_lights then
		for k = 0, 2 do
			local strip = B.box(shop, at(0, 6 + k * (D - 12) / 2, H - 0.5), Vector3.new(W - 4, 0.2, 0.4), Color3.fromHSV(k / 3, 0.8, 1), M.Neon, nc({ CastShadow = false, Name = "RGBStrip" }))
			strip:AddTag("RGBStrip")
		end
	end
	-- security
	if items.camera then
		B.ball(shop, at(inner - 1, 2, H - 1), 1.4, Color3.fromRGB(30, 30, 34), M.Glass)
		local led = B.ball(shop, at(inner - 1, 1.6, H - 1.6), 0.25, Color3.fromRGB(255, 30, 30), M.Neon, nc())
		led.Name = "CameraLed"
	end
	if items.alarm then
		local box = B.box(shop, front * CFrame.new(W / 2 - 3, H - 3, -0.8), Vector3.new(2, 2, 0.6), Color3.fromRGB(230, 40, 30), M.SmoothPlastic)
		box.Name = "AlarmBox"
		box:AddTag("AlarmLight")
	end
	if items.shutter then
		B.box(shop, front * CFrame.new(0, H - 1.6, -1), Vector3.new(W - 2, 2.4, 1.6), Color3.fromRGB(150, 154, 160), M.DiamondPlate)
	end
	-- staff spots
	standSpot("GuardSpot", 6.2, 3.2, { Role = "security" })
	standSpot("ManagerSpot", 0, fz + 3, { Role = "manager" })
	standSpot("CleanerSpot", 0, (fz + D) / 2 - 2, { Role = "cleaner" })
	point("ThiefExit", cf * CFrame.new(if rng:NextNumber() < 0.5 then -plotW / 2 - 20 else plotW / 2 + 20, 0.5, -10))
	-- outside: pylon sign, bench, parking marker
	local pylon = cf * CFrame.new(plotW / 2 - 4, 0.12, 2)
	B.box(shop, pylon * CFrame.new(0, 5, 0), Vector3.new(0.6, 10, 0.6), Color3.fromRGB(60, 60, 64), M.Metal)
	local pylonSign = B.box(shop, pylon * CFrame.new(0, 10.5, 0), Vector3.new(6, 4, 0.8), accent, if items.neon then M.Neon else M.SmoothPlastic)
	B.sign(pylonSign, Enum.NormalId.Front, "🔧 " .. (opts.name or "Tamir"), { color = Color3.new(1, 1, 1), glow = true })
	B.sign(pylonSign, Enum.NormalId.Back, "🔧 " .. (opts.name or "Tamir"), { color = Color3.new(1, 1, 1), glow = true, name = "SignBack" })
	if items.sign_pro then
		local lb = B.box(shop, front * CFrame.new(0, H + 5.6, -0.2), Vector3.new(math.min(W - 4, 30), 3, 1), Color3.fromRGB(250, 250, 250), M.SmoothPlastic)
		B.sign(lb, Enum.NormalId.Front, "BİLGİSAYAR • LAPTOP • TAMİR", { color = accent, glow = true, brightness = 1.6 })
	end
	Props.bench(shop, cf * CFrame.new(-plotW / 2 + 6, 0.12, 2) * CFrame.Angles(0, 0, 0))
	point("Parking", cf * CFrame.new(-plotW / 4, 0.5, -16) * CFrame.Angles(0, math.pi / 2, 0), { Parking = true })
	if items.parking then
		for k = 0, 1 do
			B.box(shop, cf * CFrame.new(-plotW / 4 - 10 + k * 20, 0.12, -16), Vector3.new(0.4, 0.04, 9), Color3.new(1, 1, 1), M.SmoothPlastic, nc())
		end
	end
	if opts.owner then
		local ownerTag = B.box(shop, front * CFrame.new(-W / 2 + 4, 6, -0.7), Vector3.new(5, 1.2, 0.2), Color3.fromRGB(240, 240, 236), M.SmoothPlastic, nc())
		B.sign(ownerTag, Enum.NormalId.Front, "Sahibi: " .. opts.owner, { color = Color3.fromRGB(30, 30, 30), font = B.Fonts.Medium })
	end
	B.tag(shop, "PlayerShop")
	return shop, { front = front, counter = counterCf, width = W, depth = D, height = H }
end

return ShopBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1295">
          <Properties>
            <string name="Name">ToolModels</string>
            <string name="Source"><![CDATA[-- ToolModels: the hand tools you hold over the bench. Each model's tip sits at the origin and the
-- tool extends up along +Y (the bench controller points the tip at what you're working on).

local B = require(script.Parent.Parent.Util.Builder)

local ToolModels = {}
local M = Enum.Material

local function part(m: Model, cf: CFrame, size: Vector3, color, mat: Enum.Material?, extra: { [string]: any }?): BasePart
	local props = { CanCollide = false, CanTouch = false, CanQuery = false, CastShadow = false }
	if extra then
		for k, v in extra do
			props[k] = v
		end
	end
	return B.box(m, cf, size, color, mat or M.SmoothPlastic, props)
end

local function cylY(m: Model, cf: CFrame, h: number, d: number, color, mat: Enum.Material?, extra: { [string]: any }?): BasePart
	local props = { CanCollide = false, CanTouch = false, CanQuery = false, CastShadow = false }
	if extra then
		for k, v in extra do
			props[k] = v
		end
	end
	return B.cylY(m, cf, h, d, color, mat or M.SmoothPlastic, props)
end

local STEEL = Color3.fromRGB(190, 194, 200)

local builders = {}

-- screwdriver: steel shaft, coloured handle
local function driver(m: Model, cf: CFrame, handleCol: Color3, shaftLen: number, handleLen: number, d: number)
	cylY(m, cf * CFrame.new(0, shaftLen / 2, 0), shaftLen, d * 0.3, STEEL, M.Metal, { Name = "Shaft" })
	cylY(m, cf * CFrame.new(0, 0.01, 0), 0.02, d * 0.36, Color3.fromRGB(40, 40, 44), M.Metal)
	cylY(m, cf * CFrame.new(0, shaftLen + handleLen / 2, 0), handleLen, d, handleCol, M.SmoothPlastic, { Name = "Handle" })
	for k = 0, 3 do
		part(m, cf * CFrame.new(0, shaftLen + handleLen / 2, 0) * CFrame.Angles(0, k * math.pi / 4, 0), Vector3.new(d * 1.04, handleLen * 0.8, d * 0.14), handleCol:Lerp(Color3.new(0, 0, 0), 0.25))
	end
	cylY(m, cf * CFrame.new(0, shaftLen + handleLen + 0.02, 0), 0.04, d * 0.9, Color3.fromRGB(30, 30, 32))
end

builders.hand = function(m, cf)
	-- a gloved fingertip
	local glove = Color3.fromRGB(60, 120, 200)
	cylY(m, cf * CFrame.new(0, 0.18, 0), 0.36, 0.14, glove, M.Fabric)
	part(m, cf * CFrame.new(0, 0.5, 0.06), Vector3.new(0.36, 0.34, 0.24), glove, M.Fabric)
	part(m, cf * CFrame.new(0.2, 0.42, 0.02) * CFrame.Angles(0, 0, math.rad(-30)), Vector3.new(0.1, 0.3, 0.12), glove, M.Fabric)
end
builders.screwdriver = function(m, cf)
	driver(m, cf, Color3.fromRGB(220, 50, 40), 0.55, 0.5, 0.16)
end
builders.precision = function(m, cf)
	driver(m, cf, Color3.fromRGB(30, 120, 220), 0.4, 0.42, 0.11)
end
builders.electric_screwdriver = function(m, cf)
	cylY(m, cf * CFrame.new(0, 0.18, 0), 0.36, 0.05, STEEL, M.Metal, { Name = "Shaft" })
	cylY(m, cf * CFrame.new(0, 0.62, 0), 0.6, 0.2, Color3.fromRGB(40, 40, 44), M.SmoothPlastic, { Name = "Handle" })
	part(m, cf * CFrame.new(0.1, 0.62, 0), Vector3.new(0.04, 0.14, 0.08), Color3.fromRGB(80, 200, 255), M.Neon, { Name = "Led" })
end
builders.strap = function(m, cf)
	cylY(m, cf * CFrame.new(0, 0.05, 0), 0.1, 0.36, Color3.fromRGB(30, 90, 200), M.Fabric)
	cylY(m, cf * CFrame.new(0, 0.3, 0), 0.5, 0.03, Color3.fromRGB(240, 220, 40), M.SmoothPlastic)
end
builders.air_can = function(m, cf)
	cylY(m, cf * CFrame.new(0, 0.08, 0), 0.16, 0.02, Color3.fromRGB(220, 40, 40), M.SmoothPlastic, { Name = "Straw" })
	part(m, cf * CFrame.new(0, 0.2, 0), Vector3.new(0.12, 0.1, 0.16), Color3.fromRGB(30, 30, 34))
	cylY(m, cf * CFrame.new(0, 0.62, 0), 0.75, 0.32, Color3.fromRGB(40, 110, 200), M.Metal, { Name = "Can" })
	cylY(m, cf * CFrame.new(0, 1.02, 0), 0.06, 0.28, STEEL, M.Metal)
end
builders.blower = function(m, cf)
	cylY(m, cf * CFrame.new(0, 0.2, 0), 0.4, 0.1, Color3.fromRGB(30, 30, 34))
	part(m, cf * CFrame.new(0, 0.55, 0), Vector3.new(0.3, 0.4, 0.5), Color3.fromRGB(240, 120, 30))
	part(m, cf * CFrame.new(0, 0.62, 0.32), Vector3.new(0.14, 0.5, 0.16), Color3.fromRGB(30, 30, 34))
end
builders.brush = function(m, cf)
	part(m, cf * CFrame.new(0, 0.1, 0), Vector3.new(0.22, 0.2, 0.06), Color3.fromRGB(40, 40, 44), M.Fabric, { Name = "Bristles" })
	part(m, cf * CFrame.new(0, 0.26, 0), Vector3.new(0.22, 0.12, 0.08), STEEL, M.Metal)
	cylY(m, cf * CFrame.new(0, 0.6, 0), 0.6, 0.09, Color3.fromRGB(200, 150, 90), M.Wood)
end
builders.bottle = function(m, cf)
	part(m, cf * CFrame.new(0, 0.08, 0), Vector3.new(0.3, 0.16, 0.26), Color3.fromRGB(240, 240, 236), M.Fabric, { Name = "Cloth" })
	cylY(m, cf * CFrame.new(0, 0.5, 0.25), 0.6, 0.24, Color3.fromRGB(200, 230, 255), M.Glass, { Transparency = 0.3 })
	cylY(m, cf * CFrame.new(0, 0.86, 0.25), 0.12, 0.12, Color3.fromRGB(30, 120, 200))
end
builders.syringe = function(m, cf)
	cylY(m, cf * CFrame.new(0, 0.06, 0), 0.12, 0.03, Color3.fromRGB(150, 150, 156), M.Metal, { Name = "Nozzle" })
	cylY(m, cf * CFrame.new(0, 0.38, 0), 0.52, 0.12, Color3.fromRGB(230, 230, 236), M.Glass, { Transparency = 0.2 })
	cylY(m, cf * CFrame.new(0, 0.36, 0), 0.48, 0.09, Color3.fromRGB(150, 152, 160), M.SmoothPlastic, { Name = "Paste" })
	cylY(m, cf * CFrame.new(0, 0.72, 0), 0.2, 0.05, Color3.fromRGB(200, 200, 204), M.SmoothPlastic, { Name = "Plunger" })
	cylY(m, cf * CFrame.new(0, 0.84, 0), 0.03, 0.16, Color3.fromRGB(200, 200, 204))
end
builders.magnifier = function(m, cf)
	B.cyl(m, cf * CFrame.new(0, 0.32, 0) * CFrame.Angles(0, 0, math.rad(90)) * CFrame.Angles(0, math.rad(90), 0), 0.04, 0.5, Color3.fromRGB(180, 220, 255), M.Glass, { Transparency = 0.5, CanCollide = false, CanQuery = false, CanTouch = false })
	B.cyl(m, cf * CFrame.new(0, 0.32, 0) * CFrame.Angles(0, 0, math.rad(90)) * CFrame.Angles(0, math.rad(90), 0), 0.05, 0.56, Color3.fromRGB(30, 30, 34), M.SmoothPlastic, { Transparency = 0.6, CanCollide = false, CanQuery = false, CanTouch = false })
	cylY(m, cf * CFrame.new(0, 0.8, 0), 0.5, 0.1, Color3.fromRGB(30, 30, 34))
	part(m, cf * CFrame.new(0, 0.58, 0), Vector3.new(0.06, 0.06, 0.06), Color3.fromRGB(255, 255, 240), M.Neon)
end
builders.usb = function(m, cf)
	part(m, cf * CFrame.new(0, 0.08, 0), Vector3.new(0.12, 0.16, 0.05), STEEL, M.Metal)
	part(m, cf * CFrame.new(0, 0.3, 0), Vector3.new(0.16, 0.3, 0.07), Color3.fromRGB(220, 40, 40))
end
builders.multimeter = function(m, cf)
	-- red and black probes; the meter body floats above
	cylY(m, cf * CFrame.new(-0.06, 0.25, 0), 0.5, 0.05, Color3.fromRGB(220, 30, 30), M.SmoothPlastic, { Name = "ProbeRed" })
	cylY(m, cf * CFrame.new(0.12, 0.25, 0.05), 0.5, 0.05, Color3.fromRGB(26, 26, 28), M.SmoothPlastic)
	part(m, cf * CFrame.new(0.1, 0.9, 0.2), Vector3.new(0.5, 0.8, 0.14), Color3.fromRGB(250, 200, 30), M.SmoothPlastic, { Name = "Body" })
	part(m, cf * CFrame.new(0.1, 1.05, 0.13), Vector3.new(0.36, 0.2, 0.02), Color3.fromRGB(150, 180, 150), M.SmoothPlastic, { Name = "Display" })
end
builders.spudger = function(m, cf)
	part(m, cf * CFrame.new(0, 0.15, 0), Vector3.new(0.12, 0.3, 0.02), Color3.fromRGB(240, 120, 30), M.SmoothPlastic, { Name = "Blade" })
	cylY(m, cf * CFrame.new(0, 0.55, 0), 0.55, 0.09, Color3.fromRGB(30, 30, 34))
end
builders.post_card = function(m, cf)
	part(m, cf * CFrame.new(0, 0.25, 0), Vector3.new(0.5, 0.5, 0.03), Color3.fromRGB(20, 80, 40), M.SmoothPlastic)
	part(m, cf * CFrame.new(0, 0.32, 0.02), Vector3.new(0.24, 0.12, 0.02), Color3.fromRGB(255, 40, 40), M.Neon, { Name = "Digits" })
	part(m, cf * CFrame.new(0, 0.03, 0), Vector3.new(0.4, 0.06, 0.03), Color3.fromRGB(214, 176, 72), M.Metal)
end
builders.psu_tester = function(m, cf)
	part(m, cf * CFrame.new(0, 0.3, 0), Vector3.new(0.5, 0.6, 0.16), Color3.fromRGB(40, 40, 44))
	part(m, cf * CFrame.new(0, 0.42, 0.09), Vector3.new(0.36, 0.2, 0.02), Color3.fromRGB(80, 200, 255), M.Neon, { Name = "Display" })
end
builders.tweezers = function(m, cf)
	for _, s in { -1, 1 } do
		part(m, cf * CFrame.new(s * 0.03, 0.35, 0) * CFrame.Angles(0, 0, math.rad(s * 3)), Vector3.new(0.025, 0.7, 0.05), STEEL, M.Metal)
	end
end
builders.soldering_iron = function(m, cf)
	cylY(m, cf * CFrame.new(0, 0.12, 0), 0.24, 0.025, Color3.fromRGB(200, 120, 60), M.Metal, { Name = "Tip" })
	cylY(m, cf * CFrame.new(0, 0.38, 0), 0.3, 0.07, STEEL, M.Metal)
	cylY(m, cf * CFrame.new(0, 0.82, 0), 0.6, 0.14, Color3.fromRGB(40, 110, 200), M.Rubber, { Name = "Grip" })
	part(m, cf * CFrame.new(0, 0.02, 0), Vector3.new(0.03, 0.03, 0.03), Color3.fromRGB(255, 120, 30), M.Neon, { Name = "Glow", Transparency = 0.4 })
end
builders.hot_air = function(m, cf)
	cylY(m, cf * CFrame.new(0, 0.1, 0), 0.2, 0.08, STEEL, M.Metal, { Name = "Nozzle" })
	cylY(m, cf * CFrame.new(0, 0.6, 0), 0.8, 0.2, Color3.fromRGB(40, 40, 44))
end
builders.ultrasonic = function(m, cf)
	part(m, cf * CFrame.new(0, 0.2, 0), Vector3.new(0.6, 0.4, 0.4), STEEL, M.Metal)
	part(m, cf * CFrame.new(0, 0.42, 0), Vector3.new(0.5, 0.04, 0.3), Color3.fromRGB(150, 200, 230), M.Glass, { Transparency = 0.3 })
end
builders.thermal_camera = function(m, cf)
	part(m, cf * CFrame.new(0, 0.35, 0), Vector3.new(0.3, 0.5, 0.2), Color3.fromRGB(240, 170, 30))
	part(m, cf * CFrame.new(0, 0.5, 0.11), Vector3.new(0.24, 0.18, 0.02), Color3.fromRGB(255, 80, 60), M.Neon, { Name = "Display" })
	cylY(m, cf * CFrame.new(0, 0.08, 0), 0.12, 0.12, Color3.fromRGB(30, 30, 34))
end

-- Builds the hand-held model for a tool (model name from Data/Tools).
function ToolModels.build(modelName: string, parent: Instance?): Model
	local m = Instance.new("Model")
	m.Name = "Tool_" .. modelName
	local root = Instance.new("Part")
	root.Name = "Tip"
	root.Size = Vector3.new(0.05, 0.05, 0.05)
	root.Transparency = 1
	root.Anchored = true
	root.CanCollide = false
	root.CanQuery = false
	root.CanTouch = false
	root.Parent = m
	m.PrimaryPart = root
	local fn = builders[modelName] or builders.hand
	fn(m, CFrame.new())
	for _, d in m:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = true
		end
	end
	m.Parent = parent
	return m
end

return ToolModels
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1296">
          <Properties>
            <string name="Name">VehicleModels</string>
            <string name="Source"><![CDATA[-- VehicleModels: every buyable vehicle, built from parts with its own silhouette (cars, vans,
-- the dolmuş, pickups, bikes, scooters...). Drivable vehicles get an arcade chassis:
--   Chassis (PrimaryPart, invisible) + four frictionless skid balls touching the road,
--   LinearVelocity "Drive" (plane velocity) and AlignOrientation "Upright" (yaw target),
--   VehicleSeat "Driver", visual wheels on Motor6Ds (the client spins and steers them).
-- Local frame: origin on the ground under the middle of the vehicle, forward = -Z.

local B = require(script.Parent.Parent.Util.Builder)
local Assets = require(script.Parent.Parent.Util.Assets)

local VehicleModels = {}
local M = Enum.Material

local GLASS = Color3.fromRGB(40, 52, 64)
local BLACK = Color3.fromRGB(24, 24, 26)
local CHROME = Color3.fromRGB(196, 198, 204)
local TIRE = Color3.fromRGB(26, 26, 28)
local RIM = Color3.fromRGB(176, 180, 186)

-- Car silhouettes: length, width, ground clearance, body height, cabin height, wheel radius,
-- wheelbase, hood length, trunk length, roof inset
local CARS = {
	classic = { L = 13.4, W = 5.7, g = 0.8, hb = 2.0, hc = 1.9, wr = 1.05, wb = 7.8, hood = 3.4, trunk = 2.8, inset = 0.25 },
	wagon = { L = 14.2, W = 5.7, g = 0.8, hb = 2.0, hc = 2.0, wr = 1.05, wb = 8.2, hood = 3.4, trunk = 0.6, inset = 0.2 },
	hatch = { L = 11.6, W = 5.5, g = 0.8, hb = 1.9, hc = 2.0, wr = 1.0, wb = 7.2, hood = 2.8, trunk = 0.5, inset = 0.3 },
	sedan = { L = 14.4, W = 6.0, g = 0.8, hb = 2.0, hc = 1.9, wr = 1.15, wb = 8.6, hood = 3.6, trunk = 2.8, inset = 0.4 },
	van = { L = 15.4, W = 6.4, g = 1.0, hb = 2.4, hc = 3.4, wr = 1.2, wb = 9.4, hood = 2.0, trunk = 0, inset = 0.1 },
	minibus = { L = 17.6, W = 6.6, g = 1.0, hb = 2.4, hc = 3.6, wr = 1.25, wb = 10.4, hood = 1.4, trunk = 0, inset = 0.05 },
	pickup = { L = 15.8, W = 6.4, g = 1.4, hb = 2.3, hc = 2.2, wr = 1.4, wb = 9.4, hood = 3.6, trunk = 5.6, inset = 0.25, bed = true },
	suv = { L = 15.0, W = 6.4, g = 1.4, hb = 2.4, hc = 2.4, wr = 1.4, wb = 9.0, hood = 3.4, trunk = 0.8, inset = 0.25, rails = true },
	electric = { L = 14.6, W = 6.1, g = 0.8, hb = 1.9, hc = 1.9, wr = 1.15, wb = 9.0, hood = 3.4, trunk = 2.4, inset = 0.5, smooth = true },
	coupe = { L = 14.0, W = 6.1, g = 0.7, hb = 1.8, hc = 1.6, wr = 1.15, wb = 8.4, hood = 4.4, trunk = 2.4, inset = 0.6 },
	limo = { L = 24.0, W = 6.2, g = 0.8, hb = 2.0, hc = 2.0, wr = 1.15, wb = 17.0, hood = 3.8, trunk = 3.0, inset = 0.3 },
	super = { L = 14.6, W = 6.6, g = 0.55, hb = 1.6, hc = 1.4, wr = 1.2, wb = 8.8, hood = 4.8, trunk = 3.0, inset = 0.9, wedge = true },
}

-- Two-wheelers: wheel radius, wheelbase, seat height
local BIKES = {
	bicycle = { wr = 1.25, wb = 3.6, seat = 3.2 },
	escooter = { wr = 0.45, wb = 3.0, seat = 0.6 },
	moped = { wr = 0.85, wb = 3.6, seat = 2.4 },
	vespa = { wr = 0.75, wb = 3.6, seat = 2.4 },
	enduro = { wr = 1.25, wb = 4.6, seat = 3.3 },
	naked = { wr = 1.05, wb = 4.4, seat = 2.6 },
	chopper = { wr = 1.1, wb = 5.6, seat = 2.1 },
	sport = { wr = 1.05, wb = 4.4, seat = 2.7 },
}

local function c3(t): Color3
	return if typeof(t) == "Color3" then t else Color3.fromRGB(t[1], t[2], t[3])
end

local function vis(m: Model, cf: CFrame, size: Vector3, color, mat: Enum.Material?, extra: { [string]: any }?): BasePart
	local props = { CanCollide = false, CanTouch = false, CanQuery = false }
	if extra then
		for k, v in extra do
			props[k] = v
		end
	end
	return B.box(m, cf, size, color, mat or M.SmoothPlastic, props)
end

local function wedge(m: Model, cf: CFrame, size: Vector3, color, mat: Enum.Material?, extra: { [string]: any }?): BasePart
	local props = { CanCollide = false, CanTouch = false, CanQuery = false }
	if extra then
		for k, v in extra do
			props[k] = v
		end
	end
	return B.wedge(m, cf, size, color, mat or M.SmoothPlastic, props)
end

local function plate(m: Model, cf: CFrame, text: string)
	local p = vis(m, cf, Vector3.new(1.6, 0.4, 0.06), Color3.fromRGB(240, 240, 236), M.SmoothPlastic, { Name = "Plate" })
	vis(m, cf * CFrame.new(-0.72, 0, -0.035), Vector3.new(0.16, 0.38, 0.02), Color3.fromRGB(30, 60, 170), M.SmoothPlastic)
	B.sign(p, Enum.NormalId.Front, text, { color = Color3.fromRGB(20, 20, 20), font = B.Fonts.Mono, pixelsPerStud = 80 })
	return p
end

local function light(m: Model, cf: CFrame, size: Vector3, color: Color3, kind: string): BasePart
	local p = vis(m, cf, size, color, M.Neon, { Name = kind, CastShadow = false })
	p:AddTag(kind)
	return p
end

local function wheel(m: Model, cf: CFrame, r: number, width: number, front: boolean, name: string): BasePart
	local tire = B.cyl(m, cf, width, r * 2, TIRE, M.Rubber, { CanCollide = false, CanTouch = false, CanQuery = false, Name = name })
	tire:SetAttribute("Wheel", true)
	tire:SetAttribute("Front", front)
	tire:SetAttribute("Radius", r)
	-- the rim is welded to the tire so it spins with it
	local rim = B.cyl(m, cf, width + 0.04, r * 1.2, RIM, M.Metal, { CanCollide = false, CanTouch = false, CanQuery = false, Name = name .. "Rim" })
	rim:SetAttribute("RimOf", name)
	for k = 0, 2 do
		B.box(m, cf * CFrame.Angles(k * math.pi / 3, 0, 0), Vector3.new(width + 0.06, r * 1.1, 0.12), Color3.fromRGB(150, 152, 158), M.Metal, { CanCollide = false, CanTouch = false, CanQuery = false, Name = name .. "Spoke" }):SetAttribute("RimOf", name)
	end
	return tire
end

----------------------------------------------------------------------------------------------------
-- Cars
----------------------------------------------------------------------------------------------------
local function buildCar(m: Model, cf: CFrame, def, color: Color3, plateText: string)
	local S = CARS[def.body] or CARS.sedan
	local L, W, g, hb, hc = S.L, S.W, S.g, S.hb, S.hc
	local yb = g + hb / 2
	local trim = color:Lerp(Color3.new(0, 0, 0), 0.55)
	-- lower body
	local body = vis(m, cf * CFrame.new(0, yb, 0), Vector3.new(W, hb, L), color, M.SmoothPlastic, { Name = "Body" })
	body:AddTag("CarPaint")
	-- nose and tail shaping
	if S.wedge then
		wedge(m, cf * CFrame.new(0, g + hb + 0.25, -L / 2 + S.hood / 2) * CFrame.Angles(0, 0, 0), Vector3.new(W * 0.96, 0.5, S.hood), color, M.SmoothPlastic)
	else
		vis(m, cf * CFrame.new(0, g + hb + 0.06, -L / 2 + S.hood / 2), Vector3.new(W * 0.97, 0.12, S.hood), color, M.SmoothPlastic, { Name = "Hood" })
	end
	-- cabin
	local cabinL = L - S.hood - S.trunk
	local cz = -L / 2 + S.hood + cabinL / 2
	local yc = g + hb + hc / 2
	local roofW = W - S.inset * 2
	if S.bed then
		cabinL = L - S.hood - S.trunk
	end
	-- pillars + glass: the cabin is glass with a painted roof
	vis(m, cf * CFrame.new(0, yc, cz), Vector3.new(roofW, hc, cabinL - 1.2), GLASS, M.Glass, { Name = "Windows", Transparency = 0.25 })
	vis(m, cf * CFrame.new(0, g + hb + hc + 0.1, cz), Vector3.new(roofW, 0.2, cabinL - 1.2), color, M.SmoothPlastic, { Name = "Roof" }):AddTag("CarPaint")
	-- slanted windscreen and rear window
	-- wedges are tall at +Z: the windscreen slopes down to the hood, the rear glass to the trunk
	wedge(m, cf * CFrame.new(0, yc, cz - (cabinL - 1.2) / 2 - 0.6), Vector3.new(roofW, hc, 1.2), GLASS, M.Glass, { Transparency = 0.2, Name = "Windscreen" })
	if S.trunk > 0.3 then
		wedge(m, cf * CFrame.new(0, yc, cz + (cabinL - 1.2) / 2 + 0.6) * CFrame.Angles(0, math.pi, 0), Vector3.new(roofW, hc, 1.2), GLASS, M.Glass, { Transparency = 0.2 })
	else
		vis(m, cf * CFrame.new(0, yc, cz + (cabinL - 1.2) / 2 + 0.3), Vector3.new(roofW, hc, 0.6), GLASS, M.Glass, { Transparency = 0.2 })
	end
	-- pillars (B pillar) and door lines
	for _, s in { -1, 1 } do
		vis(m, cf * CFrame.new(s * (roofW / 2 + 0.01), yc, cz), Vector3.new(0.06, hc, 0.4), color, M.SmoothPlastic)
		vis(m, cf * CFrame.new(s * (W / 2 + 0.01), yb + 0.2, cz), Vector3.new(0.04, hb * 0.8, 0.06), trim)
		vis(m, cf * CFrame.new(s * (W / 2 + 0.02), yb + hb * 0.25, cz - 0.6), Vector3.new(0.06, 0.12, 0.5), CHROME, M.Metal)
		-- mirrors
		vis(m, cf * CFrame.new(s * (W / 2 + 0.25), g + hb + 0.35, cz - cabinL / 2 + 0.4), Vector3.new(0.5, 0.35, 0.5), color, M.SmoothPlastic)
	end
	-- pickup bed
	if S.bed then
		local bz = L / 2 - S.trunk / 2
		vis(m, cf * CFrame.new(0, g + hb + 0.02, bz), Vector3.new(W * 0.9, 0.06, S.trunk - 0.4), BLACK)
		for _, s in { -1, 1 } do
			vis(m, cf * CFrame.new(s * (W / 2 - 0.15), g + hb + 0.5, bz), Vector3.new(0.3, 1, S.trunk), color):AddTag("CarPaint")
		end
		vis(m, cf * CFrame.new(0, g + hb + 0.5, L / 2 - 0.15), Vector3.new(W, 1, 0.3), color):AddTag("CarPaint")
	end
	-- roof rails / taxi-style sign / minibus extras
	if S.rails then
		for _, s in { -1, 1 } do
			vis(m, cf * CFrame.new(s * roofW * 0.4, g + hb + hc + 0.32, cz), Vector3.new(0.15, 0.15, cabinL - 1.6), CHROME, M.Metal)
		end
	end
	if def.body == "minibus" then
		local sign = vis(m, cf * CFrame.new(0, g + hb + hc + 0.55, cz - cabinL * 0.3), Vector3.new(2.6, 0.7, 0.8), Color3.fromRGB(240, 240, 240))
		B.sign(sign, Enum.NormalId.Front, "DOLMUŞ", { color = Color3.fromRGB(200, 30, 30), font = B.Fonts.Heavy })
	end
	if def.livery then
		local panel = vis(m, cf * CFrame.new(W / 2 + 0.03, yc, cz + 0.6), Vector3.new(0.02, hc * 0.8, cabinL * 0.7), color, M.SmoothPlastic)
		B.sign(panel, Enum.NormalId.Right, "🔧 PC TAMİR SERVİSİ", { color = Color3.fromRGB(20, 60, 160), font = B.Fonts.Heavy })
		local panel2 = vis(m, cf * CFrame.new(-W / 2 - 0.03, yc, cz + 0.6), Vector3.new(0.02, hc * 0.8, cabinL * 0.7), color, M.SmoothPlastic)
		B.sign(panel2, Enum.NormalId.Left, "🔧 PC TAMİR SERVİSİ", { color = Color3.fromRGB(20, 60, 160), font = B.Fonts.Heavy })
	end
	if def.spoiler then
		vis(m, cf * CFrame.new(0, g + hb + 0.8, L / 2 - 0.5), Vector3.new(W * 0.9, 0.12, 0.9), trim)
		for _, s in { -1, 1 } do
			vis(m, cf * CFrame.new(s * W * 0.35, g + hb + 0.4, L / 2 - 0.5), Vector3.new(0.15, 0.7, 0.3), trim)
		end
	end
	-- bumpers, grille, lights, plates
	local bump = if S.smooth then color else Color3.fromRGB(40, 40, 44)
	vis(m, cf * CFrame.new(0, g + 0.35, -L / 2 - 0.12), Vector3.new(W, 0.7, 0.3), bump)
	vis(m, cf * CFrame.new(0, g + 0.35, L / 2 + 0.12), Vector3.new(W, 0.7, 0.3), bump)
	if not S.smooth then
		vis(m, cf * CFrame.new(0, g + hb * 0.62, -L / 2 - 0.03), Vector3.new(W * 0.45, hb * 0.38, 0.06), BLACK, M.DiamondPlate, { Name = "Grille" })
	else
		light(m, cf * CFrame.new(0, g + hb * 0.75, -L / 2 - 0.04), Vector3.new(W * 0.8, 0.1, 0.06), Color3.fromRGB(220, 240, 255), "Headlight")
	end
	for _, s in { -1, 1 } do
		light(m, cf * CFrame.new(s * (W / 2 - 0.7), g + hb * 0.72, -L / 2 - 0.04), Vector3.new(1.0, 0.4, 0.08), Color3.fromRGB(255, 252, 230), "Headlight")
		light(m, cf * CFrame.new(s * (W / 2 - 0.6), g + hb * 0.7, L / 2 + 0.04), Vector3.new(0.9, 0.35, 0.08), Color3.fromRGB(220, 20, 30), "Taillight")
	end
	plate(m, cf * CFrame.new(0, g + 0.45, -L / 2 - 0.3) * CFrame.Angles(0, 0, 0), plateText)
	plate(m, cf * CFrame.new(0, g + 0.9, L / 2 + 0.3) * CFrame.Angles(0, math.pi, 0), plateText)
	-- wheel arches
	for _, z in { -S.wb / 2, S.wb / 2 } do
		for _, s in { -1, 1 } do
			vis(m, cf * CFrame.new(s * (W / 2 - 0.02), g + hb * 0.15, z), Vector3.new(0.08, S.wr * 1.4, S.wr * 2.6), BLACK)
		end
	end
	return S
end

----------------------------------------------------------------------------------------------------
-- Two-wheelers
----------------------------------------------------------------------------------------------------
local function tube(m: Model, a: Vector3, b: Vector3, d: number, color, cf: CFrame)
	local wa, wb = (cf * CFrame.new(a)).Position, (cf * CFrame.new(b)).Position
	local len = (wb - wa).Magnitude
	if len < 0.01 then
		return
	end
	local look = CFrame.lookAt((wa + wb) / 2, wb)
	B.cyl(m, look * CFrame.Angles(0, math.pi / 2, 0), len, d, color, M.Metal, { CanCollide = false, CanTouch = false, CanQuery = false })
end

local function buildBike(m: Model, cf: CFrame, def, color: Color3, plateText: string)
	local S = BIKES[def.body] or BIKES.naked
	local wr, wb = S.wr, S.wb
	local fz, rz = -wb / 2, wb / 2
	local dark = Color3.fromRGB(30, 30, 32)
	local body = def.body
	if body == "bicycle" then
		local top = S.seat - 0.2
		tube(m, Vector3.new(0, wr, rz), Vector3.new(0, top, 0.2), 0.14, color, cf)
		tube(m, Vector3.new(0, wr, rz), Vector3.new(0, wr + 0.2, 0.2), 0.14, color, cf)
		tube(m, Vector3.new(0, wr + 0.2, 0.2), Vector3.new(0, top, 0.2), 0.16, color, cf)
		tube(m, Vector3.new(0, top, 0.2), Vector3.new(0, top + 0.1, fz + 0.6), 0.16, color, cf)
		tube(m, Vector3.new(0, wr + 0.2, 0.2), Vector3.new(0, top + 0.1, fz + 0.6), 0.16, color, cf)
		tube(m, Vector3.new(0, wr, fz), Vector3.new(0, top + 0.6, fz + 0.5), 0.12, CHROME, cf)
		vis(m, cf * CFrame.new(0, top + 0.6, fz + 0.5), Vector3.new(1.8, 0.1, 0.1), dark)
		vis(m, cf * CFrame.new(0, S.seat, 0.25), Vector3.new(0.45, 0.15, 0.8), dark, M.Leather)
	elseif body == "escooter" then
		vis(m, cf * CFrame.new(0, wr + 0.15, 0), Vector3.new(0.7, 0.18, wb), dark)
		tube(m, Vector3.new(0, wr + 0.2, fz + 0.2), Vector3.new(0, 3.6, fz + 0.4), 0.14, color, cf)
		vis(m, cf * CFrame.new(0, 3.6, fz + 0.4), Vector3.new(1.4, 0.1, 0.1), dark)
		light(m, cf * CFrame.new(0, 3.2, fz + 0.3), Vector3.new(0.2, 0.2, 0.08), Color3.fromRGB(255, 252, 230), "Headlight")
	else
		-- motorbikes: tank, seat, engine block, forks, lights
		local seatY = S.seat
		vis(m, cf * CFrame.new(0, wr + 0.2, 0.2), Vector3.new(0.9, 1.0, 1.4), Color3.fromRGB(60, 60, 64), M.Metal, { Name = "Engine" })
		if body == "vespa" or body == "moped" then
			vis(m, cf * CFrame.new(0, seatY - 0.55, 0.6), Vector3.new(1.3, 1.0, 2.4), color, M.SmoothPlastic):AddTag("CarPaint")
			vis(m, cf * CFrame.new(0, seatY - 0.2, fz + 0.9), Vector3.new(1.2, 1.9, 0.3), color, M.SmoothPlastic):AddTag("CarPaint")
			vis(m, cf * CFrame.new(0, wr + 0.2, -0.3), Vector3.new(0.9, 0.12, 1.6), dark)
		else
			local tank = vis(m, cf * CFrame.new(0, seatY + 0.1, -0.5), Vector3.new(0.9, 0.7, 1.4), color, M.SmoothPlastic, { Name = "Tank" })
			tank:AddTag("CarPaint")
			if body == "sport" then
				wedge(m, cf * CFrame.new(0, seatY + 0.2, fz + 0.9) * CFrame.Angles(0, math.pi, 0), Vector3.new(1.1, 1.3, 1.4), color, M.SmoothPlastic):AddTag("CarPaint")
				vis(m, cf * CFrame.new(0, seatY - 0.3, -0.4), Vector3.new(1.0, 0.9, 2.4), color, M.SmoothPlastic):AddTag("CarPaint")
			end
		end
		vis(m, cf * CFrame.new(0, seatY, 0.75), Vector3.new(0.8, 0.22, 1.6), dark, M.Leather, { Name = "Saddle" })
		-- forks and bars
		local forkTop = if body == "chopper" then Vector3.new(0, seatY + 1.4, fz + 1.4) else Vector3.new(0, seatY + 0.9, fz + 0.6)
		for _, s in { -0.3, 0.3 } do
			tube(m, Vector3.new(s, wr, fz), forkTop + Vector3.new(s, 0, 0), 0.14, CHROME, cf)
		end
		vis(m, cf * CFrame.new(forkTop) * CFrame.new(0, 0.1, 0), Vector3.new(if body == "chopper" then 2.2 else 1.7, 0.1, 0.1), dark)
		light(m, cf * CFrame.new(forkTop) * CFrame.new(0, -0.25, -0.25), Vector3.new(0.45, 0.45, 0.1), Color3.fromRGB(255, 252, 230), "Headlight")
		light(m, cf * CFrame.new(0, seatY - 0.1, rz - 0.3), Vector3.new(0.35, 0.2, 0.08), Color3.fromRGB(220, 20, 30), "Taillight")
		-- exhaust
		B.cyl(m, cf * CFrame.new(0.55, wr * 0.8, rz - 0.6) * CFrame.Angles(0, math.pi / 2, 0), 1.6, 0.3, CHROME, M.Metal, { CanCollide = false, CanTouch = false, CanQuery = false })
		if def.box then
			local box = vis(m, cf * CFrame.new(0, seatY + 0.8, rz - 0.3), Vector3.new(1.4, 1.2, 1.2), Color3.fromRGB(240, 60, 40), M.SmoothPlastic)
			B.sign(box, Enum.NormalId.Back, "KURYE", { color = Color3.new(1, 1, 1), font = B.Fonts.Heavy })
		end
		plate(m, cf * CFrame.new(0, wr + 0.5, rz + 0.1) * CFrame.Angles(0, math.pi, 0), plateText)
	end
	return S
end

----------------------------------------------------------------------------------------------------
-- Real cars (Roblox's official vehicles, assets/shared/Vehicles.rbxm): body shape -> model, scale
----------------------------------------------------------------------------------------------------
local OFFICIAL = {
	classic = { "Sedan", 0.66 },
	wagon = { "SUV", 0.62 },
	hatch = { "Sedan", 0.6 },
	sedan = { "Sedan", 0.68 },
	electric = { "Sedan", 0.68 },
	van = { "Van", 0.62 },
	minibus = { "Van", 0.7 },
	pickup = { "Pickup", 0.6 },
	suv = { "SUV", 0.68 },
	coupe = { "Sports", 0.68 },
	super = { "Sports", 0.74 },
	police = { "Police", 0.68 },
	offroad = { "Offroad", 0.72 },
}

-- Puts the official car's body and wheels into `m` on `cf`, painted `color`; returns its sizes
-- (nil when the asset library is missing, so the parts-built car is used).
local function buildOfficial(m: Model, cf: CFrame, def, color: Color3, plateText: string)
	local spec = OFFICIAL[def.body]
	if not spec then
		return nil
	end
	local template = Assets.get("Vehicles", spec[1] .. "_white") or Assets.get("Vehicles", spec[1] .. "_std")
	if not template then
		return nil
	end
	local scale = spec[2]
	local kit = template:Clone()
	kit:ScaleTo(scale)
	kit:PivotTo(cf)
	for _, d in kit:GetDescendants() do
		if d:IsA("BasePart") and d:GetAttribute("Paint") then
			d.Color = color
			d:AddTag("CarPaint")
		end
	end
	for _, c in kit:GetChildren() do
		if c.Name ~= "Root" then
			c.Parent = m
		end
	end
	local size = template:GetAttribute("Size") * scale
	local seat = template:GetAttribute("Seat") * scale
	local front, back = template:GetAttribute("Front") * scale, template:GetAttribute("Back") * scale
	-- number plates on the bumpers
	plate(m, cf * CFrame.new(0, 1.1 * scale / 0.68, front - 0.04) * CFrame.Angles(0, 0, 0), plateText)
	plate(m, cf * CFrame.new(0, 1.3 * scale / 0.68, back + 0.04) * CFrame.Angles(0, math.pi, 0), plateText)
	kit:Destroy()
	return {
		wr = template:GetAttribute("Radius") * scale,
		wb = template:GetAttribute("WheelBase") * scale,
		track = template:GetAttribute("Track") * scale,
		W = size.X,
		L = size.Z,
		seat = seat,
	}
end

----------------------------------------------------------------------------------------------------
-- build
----------------------------------------------------------------------------------------------------
-- opts: color (index or {r,g,b}), plate (text), static (display only), owner (UserId)
function VehicleModels.build(parent: Instance?, def, cf: CFrame, opts: { [string]: any }?): Model
	local o = opts or {}
	local m = Instance.new("Model")
	m.Name = def.id
	m:SetAttribute("Vehicle", def.id)
	local color = if typeof(o.color) == "number" then c3(def.colors[o.color] or def.colors[1]) elseif o.color then c3(o.color) else c3(def.colors[1])
	local plateText = o.plate or "34 PC 001"
	local isBike = def.kind ~= "car"
	local real = if isBike then nil else buildOfficial(m, cf, def, color, plateText)
	local S = real or (if isBike then buildBike(m, cf, def, color, plateText) else buildCar(m, cf, def, color, plateText))
	local wr = S.wr
	local wb = S.wb
	local width = if isBike then 0.9 elseif real then real.track + 0.9 else (CARS[def.body] or CARS.sedan).W
	-- wheels
	if real then
		-- the real car brings its own (Wheel1-4 with their rims)
	elseif isBike then
		wheel(m, cf * CFrame.new(0, wr, -wb / 2), wr, if def.body == "bicycle" then 0.18 else 0.5, true, "WheelF")
		wheel(m, cf * CFrame.new(0, wr, wb / 2), wr, if def.body == "bicycle" then 0.18 else 0.55, false, "WheelR")
	else
		for i, p in { { -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 } } do
			wheel(m, cf * CFrame.new(p[1] * (width / 2 - 0.45), wr, p[2] * wb / 2), wr, 0.9, p[2] < 0, "Wheel" .. i)
		end
	end
	-- chassis: the invisible physical body every visual part is welded to
	local chassisSize = Vector3.new(math.max(width - 0.6, 1.4), 1, math.max(wb + wr, 3))
	local chassis = B.box(m, cf * CFrame.new(0, wr * 0.7 + 0.5, 0), chassisSize, Color3.new(1, 0, 1), M.SmoothPlastic, { Name = "Chassis", Transparency = 1, CanTouch = false })
	m.PrimaryPart = chassis
	-- seats
	local seatCf
	if isBike then
		seatCf = cf * CFrame.new(0, S.seat + 0.15, 0.6)
	elseif real then
		seatCf = cf * CFrame.new(real.seat)
	else
		local CS = CARS[def.body] or CARS.sedan
		seatCf = cf * CFrame.new(-CS.W * 0.22, CS.g + CS.hb * 0.55, -CS.L / 2 + CS.hood + 1.4)
	end
	local seat = Instance.new("VehicleSeat")
	seat.Name = "Driver"
	seat.Size = Vector3.new(1.6, 0.3, 1.6)
	seat.CFrame = seatCf
	seat.Transparency = 1
	seat.CanCollide = false
	seat.CanTouch = true
	seat.MaxSpeed = 0
	seat.Torque = 0
	seat.HeadsUpDisplay = false
	seat.Anchored = o.static == true
	seat.Disabled = o.static == true
	seat.Parent = m
	if not isBike and (def.seats or 1) > 1 then
		local CS = CARS[def.body] or CARS.sedan
		local rows = math.min(3, math.ceil((def.seats - 1) / 2) + 1)
		local n = 1
		for r = 0, rows - 1 do
			for _, s in { -1, 1 } do
				if not (r == 0 and s == -1) and n < def.seats then
					n += 1
					local ps = Instance.new("Seat")
					ps.Name = "Passenger"
					ps.Size = Vector3.new(1.6, 0.3, 1.6)
					ps.CFrame = if real
						then cf * CFrame.new(-s * real.seat.X, real.seat.Y, real.seat.Z + r * 2.6 * real.L / 14)
						else cf * CFrame.new(s * CS.W * 0.22, CS.g + CS.hb * 0.55, -CS.L / 2 + CS.hood + 1.4 + r * 2.6)
					ps.Transparency = 1
					ps.CanCollide = false
					ps.Anchored = o.static == true
					ps.Disabled = o.static == true
					ps.Parent = m
				end
			end
		end
	end

	if o.static then
		for _, d in m:GetDescendants() do
			if d:IsA("BasePart") then
				d.Anchored = true
				d.CanCollide = false
			end
		end
		m.Parent = parent
		return m
	end

	-- physics: frictionless skids at the wheel spots carry the vehicle
	local physical = PhysicalProperties.new(0.6, 0, 0, 100, 1)
	chassis.Anchored = false
	chassis.CustomPhysicalProperties = PhysicalProperties.new(1.4, 0, 0, 100, 1)
	local skidX = if isBike then 0.8 else width / 2 - 0.45
	local skids = if isBike then { { -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 } } else { { -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 } }
	for i, p in skids do
		local ball = B.ball(m, cf * CFrame.new(p[1] * skidX, wr, p[2] * wb / 2), wr * 2, Color3.new(1, 0, 1), M.SmoothPlastic, { Name = "Skid" .. i, Transparency = 1, CanTouch = false })
		ball.Anchored = false
		ball.CustomPhysicalProperties = physical
	end
	for _, d in m:GetDescendants() do
		if d:IsA("BasePart") and d ~= chassis then
			d.Anchored = false
			if not string.match(d.Name, "^Skid") and d.Name ~= "Driver" and d.Name ~= "Passenger" then
				d.Massless = true
				d.CanCollide = false
			end
			if d:GetAttribute("Wheel") then
				-- spin and steer about the chassis' axes at the wheel's centre, whatever way the
				-- tire mesh itself is turned
				local rel = chassis.CFrame:ToObjectSpace(d.CFrame)
				local motor = Instance.new("Motor6D")
				motor.Name = d.Name .. "Motor"
				motor.Part0 = chassis
				motor.Part1 = d
				motor.C0 = CFrame.new(rel.Position)
				motor.C1 = (rel - rel.Position):Inverse()
				motor.Parent = d
			elseif d:GetAttribute("RimOf") then
				local tire = m:FindFirstChild(d:GetAttribute("RimOf"))
				local w = Instance.new("WeldConstraint")
				w.Part0 = tire
				w.Part1 = d
				w.Parent = d
			else
				local w = Instance.new("WeldConstraint")
				w.Part0 = chassis
				w.Part1 = d
				w.Parent = d
			end
		end
	end
	local center = Instance.new("Attachment")
	center.Name = "Center"
	center.Parent = chassis
	local drive = Instance.new("LinearVelocity")
	drive.Name = "Drive"
	drive.Attachment0 = center
	drive.VelocityConstraintMode = Enum.VelocityConstraintMode.Plane
	drive.PrimaryTangentAxis = Vector3.new(1, 0, 0)
	drive.SecondaryTangentAxis = Vector3.new(0, 0, 1)
	drive.RelativeTo = Enum.ActuatorRelativeTo.World
	drive.PlaneVelocity = Vector2.new(0, 0)
	drive.MaxForce = 2e5
	drive.Parent = chassis
	local upright = Instance.new("AlignOrientation")
	upright.Name = "Upright"
	upright.Mode = Enum.OrientationAlignmentMode.OneAttachment
	upright.Attachment0 = center
	upright.CFrame = cf.Rotation
	upright.MaxTorque = 1e7
	upright.Responsiveness = 24
	upright.Parent = chassis
	m:SetAttribute("Speed", def.speed)
	m:SetAttribute("Accel", def.accel)
	m:SetAttribute("Turn", def.turn)
	m:SetAttribute("Bike", isBike)
	m.Parent = parent
	return m
end

return VehicleModels
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="1297">
        <Properties>
          <string name="Name">Net</string>
          <string name="Source"><![CDATA[-- Net: the only bridge between clients and the server.
--   client -> server : Net.request(action, payload) -> result table   (RemoteFunction "Request")
--   server -> client : Net.push(player, channel, data) / Net.pushAll   (RemoteEvent "Push")
-- The server validates every payload; handlers never trust the client.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Net = {}

local IS_SERVER = RunService:IsServer()
local FOLDER_NAME = "Remotes"

local folder: Folder? = nil
local requestFn: RemoteFunction? = nil
local pushEvent: RemoteEvent? = nil

local handlers: { [string]: (Player, any) -> any } = {}
local listeners: { [string]: { (any) -> () } } = {}
local pending: { [string]: { any } } = {}

-- Token bucket per player: bursts of 40, refills 20 requests per second.
local BUCKET_SIZE = 40
local REFILL_PER_SECOND = 20
local buckets: { [Player]: { tokens: number, last: number } } = {}

local function allow(player: Player): boolean
	local now = os.clock()
	local b = buckets[player]
	if not b then
		b = { tokens = BUCKET_SIZE, last = now }
		buckets[player] = b
	end
	b.tokens = math.min(BUCKET_SIZE, b.tokens + (now - b.last) * REFILL_PER_SECOND)
	b.last = now
	if b.tokens < 1 then
		return false
	end
	b.tokens -= 1
	return true
end

local function deliver(channel: string, data: any)
	local list = listeners[channel]
	if list and #list > 0 then
		for _, fn in list do
			task.spawn(fn, data)
		end
	else
		-- keep early messages until a listener registers (e.g. the first data snapshot)
		local q = pending[channel]
		if not q then
			q = {}
			pending[channel] = q
		end
		table.insert(q, data)
		if #q > 50 then
			table.remove(q, 1)
		end
	end
end

local function ensure()
	if folder then
		return
	end
	if IS_SERVER then
		local f = ReplicatedStorage:FindFirstChild(FOLDER_NAME) :: Folder?
		if not f then
			f = Instance.new("Folder")
			f.Name = FOLDER_NAME
			f.Parent = ReplicatedStorage
		end
		local rf = Instance.new("RemoteFunction")
		rf.Name = "Request"
		rf.Parent = f
		local re = Instance.new("RemoteEvent")
		re.Name = "Push"
		re.Parent = f
		folder, requestFn, pushEvent = f, rf, re

		rf.OnServerInvoke = function(player: Player, action: any, payload: any)
			if typeof(action) ~= "string" or #action > 48 then
				return { ok = false, err = "bad_action" }
			end
			if not allow(player) then
				return { ok = false, err = "rate_limited" }
			end
			local handler = handlers[action]
			if not handler then
				return { ok = false, err = "unknown_action" }
			end
			local ok, result = pcall(handler, player, payload)
			if not ok then
				warn(string.format("[Net] %s failed for %s: %s", action, player.Name, tostring(result)))
				return { ok = false, err = "internal" }
			end
			if result == nil then
				return { ok = true }
			end
			return result
		end
	else
		local f = ReplicatedStorage:WaitForChild(FOLDER_NAME) :: Folder
		folder = f
		requestFn = f:WaitForChild("Request") :: RemoteFunction
		pushEvent = f:WaitForChild("Push") :: RemoteEvent;
		(pushEvent :: RemoteEvent).OnClientEvent:Connect(function(channel: string, data: any)
			deliver(channel, data)
		end)
	end
end

----------------------------------------------------------------------------------------------------
-- Server
----------------------------------------------------------------------------------------------------

function Net.init()
	ensure()
end

function Net.handle(action: string, fn: (Player, any) -> any)
	assert(IS_SERVER, "Net.handle is server-only")
	handlers[action] = fn
end

function Net.push(player: Player, channel: string, data: any)
	ensure();
	(pushEvent :: RemoteEvent):FireClient(player, channel, data)
end

function Net.pushAll(channel: string, data: any)
	ensure();
	(pushEvent :: RemoteEvent):FireAllClients(channel, data)
end

function Net.forget(player: Player)
	buckets[player] = nil
end

----------------------------------------------------------------------------------------------------
-- Client
----------------------------------------------------------------------------------------------------

-- Returns the server's result table ({ ok = bool, err = string?, ... }).
function Net.request(action: string, payload: any?): { [string]: any }
	ensure()
	local ok, result = pcall(function()
		return (requestFn :: RemoteFunction):InvokeServer(action, payload)
	end)
	if not ok then
		return { ok = false, err = "network" }
	end
	if typeof(result) ~= "table" then
		return { ok = false, err = "network" }
	end
	return result
end

function Net.on(channel: string, fn: (any) -> ())
	ensure()
	local list = listeners[channel]
	if not list then
		list = {}
		listeners[channel] = list
	end
	table.insert(list, fn)
	local q = pending[channel]
	if q then
		pending[channel] = nil
		for _, data in q do
			task.spawn(fn, data)
		end
	end
end

-- Test hook: inject a push as if it came from the server.
function Net._deliver(channel: string, data: any)
	deliver(channel, data)
end

----------------------------------------------------------------------------------------------------
-- Payload validation helpers (server side)
----------------------------------------------------------------------------------------------------

local V = {}
Net.V = V

function V.str(v: any, maxLen: number?): boolean
	return typeof(v) == "string" and #v <= (maxLen or 200)
end

function V.id(v: any): boolean
	return typeof(v) == "string" and #v > 0 and #v <= 64 and string.match(v, "^[%w_%-%.]+$") ~= nil
end

function V.num(v: any, lo: number?, hi: number?): boolean
	if typeof(v) ~= "number" or v ~= v or v == math.huge or v == -math.huge then
		return false
	end
	if lo and v < lo then
		return false
	end
	if hi and v > hi then
		return false
	end
	return true
end

function V.int(v: any, lo: number?, hi: number?): boolean
	return V.num(v, lo, hi) and math.floor(v) == v
end

function V.bool(v: any): boolean
	return typeof(v) == "boolean"
end

function V.tbl(v: any): boolean
	return typeof(v) == "table"
end

return Net
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="1298">
        <Properties>
          <string name="Name">Repair</string>
        </Properties>
        <Item class="ModuleScript" referent="1299">
          <Properties>
            <string name="Name">DeviceGen</string>
            <string name="Source"><![CDATA[-- DeviceGen: builds believable, internally consistent devices for customers, the scrapyard and
-- custom-build orders, then applies faults or upgrade requests to them.

local Shared = script.Parent.Parent
local Parts = require(Shared.Data.Parts)
local Devices = require(Shared.Data.Devices)
local Faults = require(Shared.Data.Faults)
local Templates = require(script.Parent.DeviceTemplates)
local Rules = require(script.Parent.RepairRules)
local Rand = require(Shared.Util.Rand)

local DeviceGen = {}

-- Desktop tiers: cpu/gpu perf windows, years, memory and style preferences.
DeviceGen.Tiers = {
	retro = { cpu = { 0, 20 }, years = { 2007, 2014 }, gpu = { 0, 14 }, gpuChance = 0.6, ram = { 2, 8 }, sticks = 2, storage = "hdd", cooler = "stock", cases = { "case_retro" }, fans = { 1, 1 }, psu = "cheap" },
	office = { cpu = { 8, 45 }, years = { 2015, 2024 }, gpu = nil, gpuChance = 0, igpu = true, ram = { 4, 16 }, sticks = 1, storage = "ssd", cooler = "stock", cases = { "case_office", "case_sff" }, fans = { 1, 1 }, psu = "oem" },
	budget = { cpu = { 14, 45 }, years = { 2017, 2024 }, gpu = { 8, 30 }, gpuChance = 1, ram = { 8, 8 }, sticks = 2, storage = "ssd", cooler = "stock", cases = { "case_budgetrgb", "case_q300l", "case_popair" }, fans = { 1, 3 }, psu = "budget" },
	mid = { cpu = { 30, 62 }, years = { 2019, 2025 }, gpu = { 24, 52 }, gpuChance = 1, ram = { 8, 16 }, sticks = 2, storage = "nvme", cooler = "air", cases = { "case_4000d", "case_h5flow", "case_popair", "case_north", "case_budgetrgb" }, fans = { 2, 4 }, psu = "good" },
	high = { cpu = { 50, 86 }, years = { 2020, 2025 }, gpu = { 45, 82 }, gpuChance = 1, ram = { 16, 32 }, sticks = 2, storage = "nvme", cooler = "aio", cases = { "case_o11evo", "case_4000dw", "case_north", "case_nv7", "case_h5flow" }, fans = { 3, 6 }, psu = "good" },
	enthusiast = { cpu = { 75, 101 }, years = { 2022, 2025 }, gpu = { 70, 130 }, gpuChance = 1, ram = { 16, 48 }, sticks = 2, storage = "nvme2", cooler = "aio", cases = { "case_o11vision", "case_nv7", "case_define7xl", "case_o11evo" }, fans = { 4, 6 }, psu = "premium" },
	workstation = { cpu = { 60, 141 }, years = { 2021, 2025 }, gpu = { 28, 95 }, gpuChance = 1, workstationGpu = true, ram = { 32, 64 }, sticks = 4, storage = "nvme2", cooler = "air", cases = { "case_define7xl", "case_north" }, fans = { 3, 6 }, psu = "premium" },
}

local PSU_GROUPS = {
	cheap = { "psu_turbox500", "psu_lite450" },
	oem = { "psu_oem300", "psu_lite450" },
	budget = { "psu_mwe550", "psu_cv650", "psu_turbox500" },
	good = { "psu_pp12m650", "psu_rm750e", "psu_focus750", "psu_a850gl", "psu_rm850x" },
	premium = { "psu_rm850x", "psu_vertex1000", "psu_thor1200", "psu_dpp1300", "psu_ax1600i" },
}

local function filter(list, fn)
	local out = {}
	for _, p in list do
		if fn(p) then
			table.insert(out, p)
		end
	end
	return out
end

local function pick(rng, list, fallback)
	if #list == 0 then
		return fallback
	end
	return list[rng:NextInteger(1, #list)]
end

local function chooseCpu(rng, tier)
	local cands = filter(Parts.byCat.cpu, function(c)
		return c.perf >= tier.cpu[1] and c.perf <= tier.cpu[2] and c.year >= tier.years[1] - 1 and c.year <= tier.years[2] and (not tier.igpu or c.igpu)
	end)
	return pick(rng, cands, Parts.get("cpu_i5_12400f"))
end

local function chooseBoard(rng, cpu, tierName)
	local cands = filter(Parts.byCat.mobo, function(m)
		return m.socket == cpu.socket
	end)
	if tierName == "budget" or tierName == "office" then
		local cheap = filter(cands, function(m)
			return m.price <= 130
		end)
		if #cheap > 0 then
			cands = cheap
		end
	elseif tierName == "high" or tierName == "enthusiast" then
		local fancy = filter(cands, function(m)
			return m.price >= 150 and m.form == "ATX"
		end)
		if #fancy > 0 then
			cands = fancy
		end
	end
	if tierName == "office" then
		local withVideo = filter(cands, function(m)
			return m.video and m.form ~= "ATX"
		end)
		if #withVideo > 0 then
			cands = withVideo
		end
	end
	return pick(rng, cands, Parts.byCat.mobo[1])
end

local function chooseRam(rng, mobo, tier)
	local cands = filter(Parts.byCat.ram, function(r)
		return r.form == "DIMM" and r.mem == mobo.mem and r.size >= tier.ram[1] / 2 and r.size <= tier.ram[2]
	end)
	if #cands == 0 then
		cands = filter(Parts.byCat.ram, function(r)
			return r.form == "DIMM" and r.mem == mobo.mem
		end)
	end
	return pick(rng, cands, nil)
end

local function chooseGpu(rng, tier, cpu, case)
	if not tier.gpu or rng:NextNumber() > tier.gpuChance then
		return nil
	end
	local cands = filter(Parts.byCat.gpu, function(g)
		local ok = g.perf >= tier.gpu[1] and g.perf <= tier.gpu[2] and g.year <= cpu.year + 3 and g.year >= cpu.year - 4
		if tier.workstationGpu then
			ok = ok and g.workstation == true
		elseif g.workstation then
			ok = false
		end
		if case then
			ok = ok and g.len <= case.gpuMax and (not case.lowProfileOnly or g.lowProfile)
		end
		return ok
	end)
	if #cands == 0 then
		cands = filter(Parts.byCat.gpu, function(g)
			return g.perf >= tier.gpu[1] and g.perf <= tier.gpu[2] and not g.workstation and (not case or g.len <= case.gpuMax)
		end)
	end
	return pick(rng, cands, nil)
end

local function chooseCooler(rng, tier, cpu)
	local socket = cpu.socket
	local kind = tier.cooler
	if cpu.tdp > 110 and kind == "stock" then
		kind = "air"
	end
	-- the cooler has to keep up with the CPU (a 350 W Threadripper needs a 360 mm AIO)
	local cands = filter(Parts.byCat.cooler, function(c)
		return c.kind == kind and Parts.coolerFits(c, socket) and c.rating >= cpu.tdp * 0.9
	end)
	if #cands == 0 then
		cands = filter(Parts.byCat.cooler, function(c)
			return Parts.coolerFits(c, socket) and c.rating >= cpu.tdp * 0.9
		end)
	end
	if #cands == 0 then
		cands = filter(Parts.byCat.cooler, function(c)
			return Parts.coolerFits(c, socket)
		end)
	end
	return pick(rng, cands, Parts.get("cool_hyper212"))
end

local function choosePsu(rng, tier, cpu, gpu)
	local draw = Parts.systemDraw(cpu, gpu)
	local group = PSU_GROUPS[tier.psu] or PSU_GROUPS.good
	local cands = {}
	for _, id in group do
		local p = Parts.get(id)
		if p and p.watt >= draw * 1.25 then
			table.insert(cands, p)
		end
	end
	if #cands == 0 then
		cands = filter(Parts.byCat.psu, function(p)
			return p.watt >= draw * 1.25 and p.form == "ATX"
		end)
	end
	return pick(rng, cands, Parts.get("psu_rm850x"))
end

local function chooseCase(rng, tier, mobo)
	local cands = {}
	for _, id in tier.cases do
		local c = Parts.get(id)
		if c and Parts.caseFits(c, mobo.form) then
			table.insert(cands, c)
		end
	end
	if mobo.form == "ITX" and rng:NextNumber() < 0.6 then
		return Parts.get("case_nr200p")
	end
	if #cands == 0 then
		cands = filter(Parts.byCat.case, function(c)
			return Parts.caseFits(c, mobo.form) and c.style ~= "retro"
		end)
	end
	return pick(rng, cands, Parts.get("case_4000d"))
end

local function storageFor(rng, tierName, tier)
	local s = tier.storage
	local out = {}
	local function any(kind, maxPrice)
		return pick(rng, filter(Parts.byCat.storage, function(p)
			return p.kind == kind and p.price <= maxPrice
		end), nil)
	end
	if s == "hdd" then
		out.hdd1 = any("hdd35", 60)
	elseif s == "ssd" then
		if rng:NextNumber() < 0.35 then
			out.hdd1 = any("hdd35", 60)
		else
			out.ssd1 = any("ssd25", 90)
		end
		if tierName == "budget" and rng:NextNumber() < 0.4 then
			out.hdd1 = out.hdd1 or any("hdd35", 60)
		end
	elseif s == "nvme" then
		out.nvme1 = any("nvme", 170)
		if rng:NextNumber() < 0.45 then
			out.hdd1 = any("hdd35", 90)
		end
	elseif s == "nvme2" then
		out.nvme1 = any("nvme", 320)
		if rng:NextNumber() < 0.6 then
			out.nvme2 = any("nvme", 320)
		end
	end
	return out
end

----------------------------------------------------------------------------------------------------
-- State construction
----------------------------------------------------------------------------------------------------
local function initState(kind: string, model: string)
	local T = Templates[kind]
	local dev = {
		kind = kind,
		model = model,
		nodes = {},
		paste = { st = "old", q = 0.55 },
		sw = { bios = "ok" },
		orient = "top",
		lid = "closed",
		liquid = 0,
		tray = {},
		strap = false,
		ties = false,
		tests = 0,
		hidden = {},
		orig = {},
		nextUid = 0,
	}
	for _, id in T.order do
		local tn = T.nodes[id]
		local s: { [string]: any } = {}
		if tn.kind == "root" or tn.kind == "panel" or tn.kind == "board" or tn.kind == "feet" then
			s.st = "in"
		elseif tn.kind == "comp" then
			s.st = "empty"
		elseif tn.kind == "screw" or tn.kind == "cable" then
			s.st = "out"
		elseif tn.kind == "latch" then
			s.st = "closed"
		elseif tn.kind == "pins" then
			s.st = "ok"
		end
		if tn.dusty then
			s.dust = 0
		end
		dev.nodes[id] = s
	end
	if kind == "laptop" then
		dev.nodes.lboard.dust = 0
	end
	return dev
end

local function setPart(dev, id: string, partId: string?, cond: number?)
	if not partId then
		return
	end
	local s = dev.nodes[id]
	s.part = partId
	s.st = "in"
	s.cond = cond or 1
	dev.orig[id] = true
end

-- After parts are placed: screws in where the owner is fitted, cables plugged where both ends are.
local function settle(dev)
	local T = Templates[dev.kind]
	for _, id in T.order do
		local tn = T.nodes[id]
		local s = dev.nodes[id]
		if not Rules.available(dev, id) then
			if tn.kind == "comp" then
				s.st = "empty"
				s.part = nil
				dev.orig[id] = nil
			end
		end
	end
	for _, id in T.order do
		local tn = T.nodes[id]
		local s = dev.nodes[id]
		if tn.kind == "screw" then
			local os = dev.nodes[tn.owner].st
			s.st = if os == "in" and Rules.available(dev, id) then "in" else "out"
		elseif tn.kind == "cable" then
			local a, b = dev.nodes[tn.ends[1]].st, dev.nodes[tn.ends[2]].st
			s.st = if a == "in" and b == "in" and Rules.available(dev, id) then "in" else "out"
		end
	end
end

local function baseDust(dev, rng, lo, hi)
	for _, s in dev.nodes do
		if s.dust ~= nil then
			s.dust = Rand.range(rng, lo, hi)
		end
	end
end

local function setBootDrive(dev)
	for _, d in Rules.drives(dev) do
		local s = dev.nodes[d]
		if s and s.st == "in" and s.part then
			if not dev.boot then
				dev.boot = d
				s.os = "ok"
				s.virus = 0
			else
				s.os = "none"
				s.virus = 0
			end
		end
	end
end

-- Desktop for a tier ("retro", "office", "budget", "mid", "high", "enthusiast", "workstation").
function DeviceGen.desktop(rng: Random, tierName: string)
	local tier = DeviceGen.Tiers[tierName] or DeviceGen.Tiers.mid
	local cpu = chooseCpu(rng, tier)
	local mobo = chooseBoard(rng, cpu, tierName)
	local case = if tierName == "retro" then Parts.get("case_retro") else chooseCase(rng, tier, mobo)
	if not Parts.caseFits(case, mobo.form) then
		case = Parts.get("case_4000d")
	end
	local gpu = chooseGpu(rng, tier, cpu, case)
	if not gpu and not (cpu.igpu and mobo.video) then
		-- every PC needs a picture: give it a cheap card
		gpu = pick(rng, filter(Parts.byCat.gpu, function(g)
			return g.perf <= 20 and not g.workstation and g.len <= case.gpuMax and (not case.lowProfileOnly or g.lowProfile)
		end), Parts.get("gpu_gt710"))
	end
	local ram = chooseRam(rng, mobo, tier)
	local cooler = chooseCooler(rng, tier, cpu)
	local psu = choosePsu(rng, tier, cpu, gpu)
	if case.style == "itx" then
		psu = Parts.get("psu_sf750")
	end

	local dev = initState("desktop", case.id)
	setPart(dev, "mobo", mobo.id)
	setPart(dev, "psu", psu.id, Rand.range(rng, 0.6, 1))
	setPart(dev, "cpu", cpu.id)
	setPart(dev, "cooler", cooler.id, Rand.range(rng, 0.6, 1))
	if gpu then
		setPart(dev, "gpu", gpu.id, Rand.range(rng, 0.6, 1))
	end
	local sticks = math.min(tier.sticks, mobo.memSlots)
	if ram then
		local order = if sticks == 2 and mobo.memSlots == 4 then { 2, 4 } else { 1, 2, 3, 4 }
		for i = 1, sticks do
			setPart(dev, "ram" .. order[i], ram.id, Rand.range(rng, 0.7, 1))
		end
	end
	for slot, part in storageFor(rng, tierName, tier) do
		if slot == "hdd1" and (case.style == "itx" or case.style == "sff") then
			slot = "ssd1"
			part = Parts.get("st_ssd480")
		end
		if string.match(slot, "^nvme") and mobo.m2 == 0 then
			slot = "ssd1"
			part = Parts.get("st_ssd480")
		end
		if part then
			setPart(dev, slot, part.id, Rand.range(rng, 0.6, 1))
		end
	end
	setPart(dev, "cmos", "cmos_cr2032")
	for i = 1, 6 do
		setPart(dev, "cap" .. i, "cap_470")
	end
	-- fans
	local nFans = math.min(case.fanSlots, rng:NextInteger(tier.fans[1], tier.fans[2]))
	local fanModel
	if tierName == "retro" then
		fanModel = "fan_std80"
	elseif tierName == "high" or tierName == "enthusiast" then
		fanModel = Rand.pick(rng, { "fan_af120rgb", "fan_sl120", "fan_nfa12", "fan_p12" })
	elseif tierName == "mid" then
		fanModel = Rand.pick(rng, { "fan_p12", "fan_af120rgb", "fan_std120", "fan_p14" })
	else
		fanModel = "fan_std120"
	end
	for i = 1, nFans do
		setPart(dev, Rules.FanOrder[i], fanModel, Rand.range(rng, 0.6, 1))
	end
	settle(dev)
	setBootDrive(dev)
	local age = 2026 - cpu.year
	dev.paste = if age >= 4 then { st = "old", q = 0.45 } else { st = "fresh", q = 0.8 }
	baseDust(dev, rng, 0.02, math.clamp(age * 0.04, 0.05, 0.22))
	dev.ties = rng:NextNumber() < (if tierName == "high" or tierName == "enthusiast" then 0.6 else 0.15)
	dev.tier = tierName
	return dev
end

function DeviceGen.laptop(rng: Random, classFilter: { string }?)
	local cands = filter(Devices.laptops, function(l)
		return not classFilter or table.find(classFilter, l.class) ~= nil
	end)
	local model = pick(rng, cands, Devices.laptops[1])
	local dev = initState("laptop", model.id)
	dev.lclass = model.class
	setPart(dev, "battery", "lp_battery_" .. model.class, Rand.range(rng, 0.5, 1))
	setPart(dev, "lfan", "lp_fan_" .. model.class, Rand.range(rng, 0.6, 1))
	setPart(dev, "keyboard", "lp_keyboard_" .. model.class)
	setPart(dev, "screen", "lp_screen_" .. model.class)
	setPart(dev, "hinges", "lp_hinge_" .. model.class)
	setPart(dev, "dcjack", "lp_dcjack_" .. model.class)
	setPart(dev, "lcmos", "cmos_cr2032")
	setPart(dev, "lwifi", Rand.pick(rng, { "wifi_ax200", "wifi_ax210" }))
	local ram = pick(rng, filter(Parts.byCat.ram, function(r)
		return r.form == "SODIMM" and r.mem == model.mem and r.size <= 16
	end), nil)
	if ram then
		for i = 1, model.ramSlots do
			if i == 1 or rng:NextNumber() < 0.6 then
				setPart(dev, "lram" .. i, ram.id, Rand.range(rng, 0.7, 1))
			end
		end
	end
	if model.class == "budget15" and rng:NextNumber() < 0.45 then
		setPart(dev, "lsata", Rand.pick(rng, { "st_hdd25_500", "st_hdd25_1t" }), Rand.range(rng, 0.5, 0.9))
		if rng:NextNumber() < 0.5 then
			setPart(dev, "lnvme", "st_nv500sn580")
		end
	else
		setPart(dev, "lnvme", Rand.pick(rng, { "st_nv500sn580", "st_nv1tnv2", "st_nv1tsn770", "st_nv1t970" }))
	end
	settle(dev)
	-- a 2.5" HDD is the boot drive on old budget machines
	if dev.nodes.lsata.st == "in" and (dev.nodes.lnvme.st ~= "in" or rng:NextNumber() < 0.5) then
		dev.boot = "lsata"
		dev.nodes.lsata.os = "ok"
		dev.nodes.lsata.virus = 0
		if dev.nodes.lnvme.st == "in" then
			dev.nodes.lnvme.os = "none"
			dev.nodes.lnvme.virus = 0
		end
	else
		setBootDrive(dev)
	end
	local age = 2026 - model.year
	dev.paste = if age >= 3 then { st = "old", q = 0.45 } else { st = "fresh", q = 0.8 }
	baseDust(dev, rng, 0.02, math.clamp(age * 0.05, 0.05, 0.22))
	dev.nodes.lboard.dust = 0
	return dev
end

-- An empty case for custom builds.
function DeviceGen.emptyCase(caseId: string)
	local dev = initState("desktop", caseId)
	dev.paste = { st = "none", q = 0 }
	dev.build = true
	settle(dev)
	return dev
end

----------------------------------------------------------------------------------------------------
-- Faults
----------------------------------------------------------------------------------------------------
local function installedOf(dev, ids)
	local out = {}
	for _, id in ids do
		local s = dev.nodes[id]
		if s and s.st == "in" and s.part then
			table.insert(out, id)
		end
	end
	return out
end

local function bootKind(dev)
	local b = dev.boot
	local p = b and Rules.part(dev, b)
	return p and p.kind
end
DeviceGen.bootKind = bootKind

-- Applies fault `id`. Returns false if the fault doesn't fit this device.
function DeviceGen.applyFault(dev, id: string, rng: Random): boolean
	local H = dev.hidden
	local desktop = dev.kind == "desktop"
	if id == "psu_dead" then
		H.psu = "dead"
	elseif id == "psu_weak" then
		local gpu = Rules.part(dev, "gpu")
		if not gpu then
			return false
		end
		dev.nodes.psu.part = Rand.pick(rng, { "psu_turbox500", "psu_lite450" })
		H.psu = "weak"
	elseif id == "gpu_dead" or id == "gpu_artifacts" then
		if not Rules.part(dev, "gpu") then
			return false
		end
		H.gpu = if id == "gpu_dead" then "dead" else "artifacts"
	elseif id == "ram_faulty" then
		local sticks = installedOf(dev, if desktop then { "ram1", "ram2", "ram3", "ram4" } else { "lram1", "lram2" })
		if #sticks == 0 then
			return false
		end
		H[Rand.pick(rng, sticks)] = "faulty"
	elseif id == "ram_unseated" then
		local sticks = installedOf(dev, { "ram1", "ram2", "ram3", "ram4" })
		if #sticks == 0 then
			return false
		end
		H[Rand.pick(rng, sticks)] = "unseated"
	elseif id == "cpu_paste" then
		local cpu = Rules.part(dev, "cpu")
		if not cpu or cpu.tdp < 45 then
			return false
		end
		dev.paste = { st = "dry", q = 0.1 }
	elseif id == "no_paste" then
		dev.paste = { st = "none", q = 0 }
	elseif id == "dust" then
		for nid, s in dev.nodes do
			if s.dust ~= nil and nid ~= "lboard" then
				s.dust = Rand.range(rng, 0.7, 1)
			end
		end
	elseif id == "fan_dead" or id == "fan_noisy" then
		local fans = installedOf(dev, Rules.FanOrder)
		if #fans == 0 then
			if id == "fan_dead" then
				H.cooler = "fan_dead"
				return true
			end
			return false
		end
		if id == "fan_dead" and rng:NextNumber() < 0.35 then
			H.cooler = "fan_dead"
		else
			H[Rand.pick(rng, fans)] = if id == "fan_dead" then "dead" else "noisy"
		end
	elseif id == "hdd_failing" then
		local k = bootKind(dev)
		if k ~= "hdd35" and k ~= "hdd25" then
			return false
		end
		H[dev.boot] = "failing"
	elseif id == "ssd_dead" then
		if not dev.boot then
			return false
		end
		H[dev.boot] = "dead"
	elseif id == "os_corrupt" then
		if not dev.boot then
			return false
		end
		dev.nodes[dev.boot].os = "corrupt"
	elseif id == "virus" then
		if not dev.boot then
			return false
		end
		dev.nodes[dev.boot].virus = rng:NextInteger(5, 42)
	elseif id == "cmos_low" then
		H[if desktop then "cmos" else "lcmos"] = "low"
	elseif id == "bios_outdated" then
		local cpu = Rules.part(dev, "cpu")
		local mobo = Rules.part(dev, "mobo")
		if not cpu or not mobo or cpu.year <= mobo.year then
			return false
		end
		dev.sw.bios = "old"
	elseif id == "cap_bulged" then
		H["cap" .. rng:NextInteger(1, 6)] = "bulged"
	elseif id == "mobo_dead" then
		H.mobo = "dead"
	elseif id == "cpu_dead" then
		H.cpu = "dead"
	elseif id == "bent_pins" then
		dev.nodes.socket.st = "bent"
	elseif id == "cable_loose" then
		local gpu = Rules.part(dev, "gpu")
		if gpu and #Parts.gpuConnectors(gpu) > 0 then
			dev.nodes.cpcie1.st = "loose"
		else
			dev.nodes.ceps.st = "loose"
		end
	elseif id == "lap_battery_worn" then
		H.battery = "worn"
	elseif id == "lap_battery_swollen" then
		H.battery = "swollen"
	elseif id == "lap_screen" then
		H.screen = "cracked"
	elseif id == "lap_keyboard" then
		H.keyboard = "dead_keys"
		dev.liquid = 0.22
	elseif id == "lap_overheat" then
		dev.paste = { st = "dry", q = 0.1 }
		dev.nodes.lfan.dust = Rand.range(rng, 0.75, 1)
	elseif id == "lap_fan_noisy" then
		H.lfan = "noisy"
	elseif id == "lap_dcjack" then
		H.dcjack = "dead"
	elseif id == "lap_hinge" then
		H.hinges = "broken"
	elseif id == "lap_liquid" then
		dev.liquid = Rand.range(rng, 0.7, 1)
	elseif id == "lap_wifi" then
		H.lwifi = "dead"
	else
		return false
	end
	dev.faults = dev.faults or {}
	table.insert(dev.faults, id)
	return true
end

----------------------------------------------------------------------------------------------------
-- Requests (upgrades, maintenance, builds) and their checks
----------------------------------------------------------------------------------------------------
function DeviceGen.applyRequest(dev, id: string, rng: Random, budget: number?): { [string]: any }?
	if id == "upgrade_ram" then
		local total = Rules.ramTotal(dev, false)
		-- the most this machine can take with the sticks that exist for it
		local mem, form, slots, soldered
		if dev.kind == "laptop" then
			local m = Rules.laptopModel(dev)
			if not m or m.ramSlots == 0 then
				return nil
			end
			mem, form, slots, soldered = m.mem, "SODIMM", m.ramSlots, m.soldered
		else
			local mobo = Rules.part(dev, "mobo")
			if not mobo then
				return nil
			end
			mem, form, slots, soldered = mobo.mem, "DIMM", mobo.memSlots, 0
		end
		local biggest = 0
		for _, r in Parts.byCat.ram do
			if r.mem == mem and r.form == form then
				biggest = math.max(biggest, r.size)
			end
		end
		local maxTotal = biggest * slots + soldered
		local target = math.min(math.max(16, total * 2), maxTotal)
		if target <= total then
			return nil
		end
		return { id = id, ramMin = target, vars = { target = target } }
	elseif id == "upgrade_ssd" then
		local k = bootKind(dev)
		if k ~= "hdd35" and k ~= "hdd25" then
			return nil
		end
		return { id = id, bootSsd = true }
	elseif id == "upgrade_gpu" then
		local gpu = Rules.part(dev, "gpu")
		if dev.kind ~= "desktop" or not gpu then
			return nil
		end
		local minPerf = math.floor(gpu.perf * 1.4 + 6)
		local b = budget or 400
		-- only ask for what exists, fits the case and roughly fits the budget
		local case = Parts.get(dev.model)
		local possible = false
		for _, p in Parts.byCat.gpu do
			if p.perf >= minPerf and not p.workstation and p.price <= b * 1.5 and (not case or not case.gpuMax or p.len <= case.gpuMax) then
				possible = true
				break
			end
		end
		if not possible then
			return nil
		end
		return { id = id, gpuMin = minPerf, partBudget = b, vars = { budget = b } }
	elseif id == "maintenance" then
		for nid, s in dev.nodes do
			if s.dust ~= nil and nid ~= "lboard" then
				s.dust = Rand.range(rng, 0.45, 0.8)
			end
		end
		dev.paste = { st = "old", q = 0.4 }
		return { id = id, dustMax = 0.15, pasteFresh = true }
	elseif id == "build" then
		local b = budget or 1200
		local tierPerf = math.clamp(math.floor(b / 30), 18, 100)
		return {
			id = id,
			build = true,
			gpuMin = math.floor(tierPerf * 0.9),
			cpuMin = math.floor(math.clamp(tierPerf * 0.7, 20, 90)),
			ramMin = if b >= 1500 then 32 else 16,
			ssd = true,
			partBudget = b,
			vars = { budget = b },
		}
	end
	return nil
end

-- Does the device satisfy the job requirements? Returns ok, list of unmet keys.
function DeviceGen.meets(dev, req: { [string]: any }?): (boolean, { string })
	local unmet = {}
	if not req then
		return true, unmet
	end
	if req.ramMin and Rules.ramTotal(dev, true) < req.ramMin then
		table.insert(unmet, "ram")
	end
	if req.bootSsd or req.ssd then
		local k = bootKind(dev)
		local ev = Rules.evaluate(dev, "post")
		if (k ~= "ssd25" and k ~= "nvme") or ev.boot ~= dev.boot then
			table.insert(unmet, "ssd")
		end
	end
	if req.gpuMin then
		local gpu = Rules.part(dev, "gpu")
		if not gpu or dev.nodes.gpu.st ~= "in" or gpu.perf < req.gpuMin then
			table.insert(unmet, "gpu")
		end
	end
	if req.cpuMin then
		local cpu = Rules.part(dev, "cpu")
		if not cpu or cpu.perf < req.cpuMin then
			table.insert(unmet, "cpu")
		end
	end
	if req.dustMax then
		for id, s in dev.nodes do
			if s.dust and s.dust > req.dustMax and Rules.available(dev, id) and s.st ~= "empty" and id ~= "lboard" then
				table.insert(unmet, "dust")
				break
			end
		end
	end
	if req.pasteFresh and dev.paste.st ~= "fresh" then
		table.insert(unmet, "paste")
	end
	return #unmet == 0, unmet
end

-- Total new-part value of the device (used for prices and the "value" shown on cards).
function DeviceGen.value(dev): number
	if dev.kind == "laptop" then
		local m = Rules.laptopModel(dev)
		return m and m.value or 500
	end
	local v = 0
	for _, s in dev.nodes do
		if s.part then
			local p = Parts.get(s.part)
			if p and p.cat ~= "misc" then
				v += p.price
			end
		end
	end
	local case = Parts.get(dev.model)
	return v + (case and case.price or 0)
end

-- Rough cost of the replacement parts a fault needs (so customers offer sensible money).
function DeviceGen.partsEstimate(dev, faultId: string): number
	local function priceOf(id)
		local p = Rules.part(dev, id)
		return p and p.price or 0
	end
	if faultId == "psu_dead" or faultId == "psu_weak" then
		return math.max(60, priceOf("psu"))
	elseif faultId == "gpu_dead" or faultId == "gpu_artifacts" then
		return math.max(80, priceOf("gpu") * 0.9)
	elseif faultId == "ram_faulty" then
		return math.max(15, priceOf("ram1") + priceOf("ram2") + priceOf("lram1")) * 0.5
	elseif faultId == "fan_dead" or faultId == "fan_noisy" then
		return 15
	elseif faultId == "hdd_failing" or faultId == "ssd_dead" then
		return 50
	elseif faultId == "cmos_low" then
		return 2
	elseif faultId == "cap_bulged" then
		return 2
	elseif faultId == "mobo_dead" then
		return math.max(80, priceOf("mobo"))
	elseif faultId == "cpu_dead" then
		return math.max(60, priceOf("cpu"))
	elseif faultId == "cpu_paste" or faultId == "no_paste" or faultId == "lap_overheat" then
		return 3
	elseif string.sub(faultId, 1, 4) == "lap_" then
		local m = Rules.laptopModel(dev)
		local cls = m and m.class or "budget15"
		local map = { lap_battery_worn = "battery", lap_battery_swollen = "battery", lap_screen = "screen", lap_keyboard = "keyboard", lap_fan_noisy = "fan", lap_dcjack = "dcjack", lap_hinge = "hinge", lap_wifi = "wifi" }
		local sub = map[faultId]
		if sub == "wifi" then
			return 22
		end
		local p = sub and Parts.get("lp_" .. sub .. "_" .. cls)
		return p and p.price or 5
	end
	return 0
end

-- Junk PC from the scrapyard: old, dusty, several random faults, worn parts.
function DeviceGen.junk(rng: Random)
	local tier = Rand.pick(rng, { "retro", "retro", "office", "office", "budget", "budget", "mid" })
	local dev = DeviceGen.desktop(rng, tier)
	baseDust(dev, rng, 0.5, 1)
	dev.paste = { st = "dry", q = 0.05 }
	for _, s in dev.nodes do
		if s.part and s.cond then
			s.cond = Rand.range(rng, 0.25, 0.75)
		end
	end
	local pool = { "psu_dead", "gpu_dead", "ram_faulty", "hdd_failing", "os_corrupt", "virus", "cmos_low", "fan_dead", "mobo_dead", "cap_bulged" }
	Rand.shuffle(rng, pool)
	local n = rng:NextInteger(1, 4)
	for i = 1, n do
		DeviceGen.applyFault(dev, pool[i], rng)
	end
	dev.junk = true
	return dev
end

-- Display name for a device ("Lenovo IdeaPad 3 15", "Corsair 4000D • RTX 4070").
function DeviceGen.name(dev): string
	if dev.kind == "laptop" then
		local m = Rules.laptopModel(dev)
		return m and m.name or "Laptop"
	end
	local gpu = Rules.part(dev, "gpu")
	local cpu = Rules.part(dev, "cpu")
	local bits = {}
	if cpu then
		table.insert(bits, cpu.name)
	end
	if gpu then
		local short = string.gsub(gpu.name, "^GeForce ", "")
		short = string.gsub(short, "^Radeon ", "")
		table.insert(bits, short)
	end
	if #bits == 0 then
		local case = Parts.get(dev.model)
		return case and case.name or "PC"
	end
	return table.concat(bits, " • ")
end

-- Generates a job device for a customer profile.
-- profile = { device = "desktop"|"laptop"|nil, tiers = {...}, classes = {...} }
function DeviceGen.forJob(rng: Random, profile: { [string]: any }, level: number)
	local kind = profile.device
	if not kind then
		kind = if rng:NextNumber() < (profile.laptopChance or 0.4) then "laptop" else "desktop"
	end
	if kind == "laptop" and level < 2 then
		kind = "desktop"
	end
	local dev
	if kind == "laptop" then
		dev = DeviceGen.laptop(rng, profile.classes)
	else
		dev = DeviceGen.desktop(rng, Rand.pick(rng, profile.tiers or { "budget", "mid" }))
	end

	-- Request or fault?
	local job = { kind = "repair", faults = {}, request = nil }
	local reqChance = profile.requestChance or 0.22
	if rng:NextNumber() < reqChance then
		local reqs = filter(Faults.requests, function(r)
			return r.level <= level and (r.device == "any" or r.device == kind) and (r.id ~= "build" or (profile.builds and kind == "desktop"))
		end)
		Rand.shuffle(rng, reqs)
		for _, r in reqs do
			local budget = nil
			if r.id == "upgrade_gpu" then
				budget = Rand.pick(rng, { 250, 350, 450, 600, 800, 1100 })
			elseif r.id == "build" then
				budget = Rand.pick(rng, { 700, 900, 1200, 1500, 2000, 2800, 3600 })
			end
			if r.id == "build" then
				local caseId = Rand.pick(rng, { "case_4000d", "case_4000dw", "case_popair", "case_h5flow", "case_o11evo", "case_o11vision", "case_north", "case_budgetrgb" })
				dev = DeviceGen.emptyCase(caseId)
			end
			local req = DeviceGen.applyRequest(dev, r.id, rng, budget)
			if req then
				job.kind = if r.id == "build" then "build" elseif r.id == "maintenance" then "maintenance" else "upgrade"
				job.request = req
				job.requestId = r.id
				break
			end
		end
	end
	if not job.request then
		local hasGpu = dev.kind == "desktop" and Rules.part(dev, "gpu") ~= nil
		local k = bootKind(dev)
		local pool = Faults.pool(dev.kind, level, { hasGpu = hasGpu, hasHdd = k == "hdd35" or k == "hdd25" })
		local tries = 0
		while #job.faults == 0 and tries < 12 do
			tries += 1
			local f = Rand.weighted(rng, pool)
			if DeviceGen.applyFault(dev, f.id, rng) then
				table.insert(job.faults, f.id)
			end
		end
		-- harder customers sometimes bring two problems
		if profile.extraFaultChance and rng:NextNumber() < profile.extraFaultChance and level >= 3 then
			local f = Rand.weighted(rng, pool)
			if not table.find(job.faults, f.id) and DeviceGen.applyFault(dev, f.id, rng) then
				table.insert(job.faults, f.id)
			end
		end
	end
	job.device = dev
	return job
end

return DeviceGen
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1300">
          <Properties>
            <string name="Name">DeviceTemplates</string>
            <string name="Source"><![CDATA[-- DeviceTemplates: the static node graph of a desktop PC and of a laptop.
--
-- Node kinds
--   comp   a component slot that holds a part (gpu, ram1, psu, battery, screen...)
--   panel  a removable cover (side panel, laptop bottom cover, bezel)
--   screw  a fastener; `owner` is the node it holds, `bit` the screwdriver head
--   cable  a connector; `ends` are the two nodes it joins
--   latch  a clip/lever (RAM clips, PCIe latch, CPU retention arm)
--   (capacitors are comps with solder = true: desolder -> remove -> install -> solder)
--   pins   the CPU socket pins (can be bent)
--   feet   laptop rubber feet hiding screws
--   board  the laptop logic board (inspection / liquid cleaning only)
--
-- Relationships
--   parent          the node this one is mounted on (moves with it)
--   blockers        nodes that must be removed (st ~= "in") first
--   needsUnplugged  cables that must be unplugged first (laptop battery!)
--   side            laptop: "bottom" (needs the laptop flipped) or "top" (needs it upright, lid open)
--   esd             touching it without a wrist strap can kill it
--
-- Which nodes are actually present depends on the installed parts; see RepairRules.available().

local Templates = {}

local function L(tr: string, en: string)
	return { tr = tr, en = en }
end

local function addNode(t, node)
	assert(not t.nodes[node.id], "duplicate node " .. node.id)
	t.nodes[node.id] = node
	table.insert(t.order, node.id)
	node.screws = node.screws or {}
	node.cables = node.cables or {}
	node.latches = node.latches or {}
	node.blockers = node.blockers or {}
	node.needsUnplugged = node.needsUnplugged or {}
	return node
end

local function addScrews(t, owner: string, prefix: string, count: number, bit: string, label, extra: { [string]: any }?)
	local ids = {}
	for i = 1, count do
		local id = prefix .. i
		local n = addNode(t, { id = id, kind = "screw", owner = owner, bit = bit, label = label, index = i })
		if extra then
			for k, v in extra do
				n[k] = v
			end
		end
		table.insert(ids, id)
	end
	t.nodes[owner].screws = ids
	return ids
end

----------------------------------------------------------------------------------------------------
-- Desktop
----------------------------------------------------------------------------------------------------
local function buildDesktop()
	local t = { kind = "desktop", nodes = {}, order = {} }

	addNode(t, { id = "case", kind = "root", label = L("Kasa", "Case"), cat = "case" })
	addNode(t, { id = "side_panel", kind = "panel", parent = "case", label = L("Yan Kapak", "Side Panel") })
	addScrews(t, "side_panel", "sp_s", 4, "thumb", L("Kapak Vidası", "Panel Screw"))

	addNode(t, { id = "psu", kind = "comp", parent = "case", cat = "psu", label = L("Güç Kaynağı (PSU)", "Power Supply"), blockers = { "side_panel" }, dusty = true })
	addScrews(t, "psu", "psu_s", 4, "PH2", L("PSU Vidası", "PSU Screw"))

	addNode(t, { id = "mobo", kind = "comp", parent = "case", cat = "mobo", label = L("Anakart", "Motherboard"), blockers = { "side_panel", "gpu", "cooler" }, esd = true })
	addScrews(t, "mobo", "mb_s", 6, "PH2", L("Anakart Vidası", "Motherboard Screw"))

	addNode(t, { id = "socket", kind = "pins", parent = "mobo", label = L("İşlemci Soketi", "CPU Socket"), blockers = { "cpu" } })
	addNode(t, { id = "cpu", kind = "comp", parent = "mobo", cat = "cpu", label = L("İşlemci", "Processor"), blockers = { "side_panel", "cooler" }, esd = true })
	addNode(t, { id = "cpu_arm", kind = "latch", owner = "cpu", parent = "mobo", label = L("Soket Kolu", "Retention Arm"), blockers = { "cooler" } })
	t.nodes.cpu.latches = { "cpu_arm" }

	addNode(t, { id = "cooler", kind = "comp", parent = "mobo", cat = "cooler", label = L("İşlemci Soğutucu", "CPU Cooler"), blockers = { "side_panel" }, dusty = true })
	addScrews(t, "cooler", "cool_s", 4, "PH2", L("Soğutucu Vidası", "Cooler Screw"))

	for i = 1, 4 do
		local id = "ram" .. i
		addNode(t, { id = id, kind = "comp", parent = "mobo", cat = "ram", form = "DIMM", label = L("RAM Yuvası " .. i, "RAM Slot " .. i), blockers = { "side_panel" }, esd = true, optional = i > 1, index = i })
		addNode(t, { id = id .. "_clip", kind = "latch", owner = id, parent = "mobo", label = L("RAM Mandalı " .. i, "RAM Clip " .. i), blockers = { "side_panel" } })
		t.nodes[id].latches = { id .. "_clip" }
	end

	addNode(t, { id = "gpu", kind = "comp", parent = "case", cat = "gpu", label = L("Ekran Kartı", "Graphics Card"), blockers = { "side_panel" }, esd = true, optional = true, dusty = true })
	addScrews(t, "gpu", "gpu_s", 2, "PH2", L("Braket Vidası", "Bracket Screw"))
	addNode(t, { id = "pcie_latch", kind = "latch", owner = "gpu", parent = "mobo", label = L("PCIe Mandalı", "PCIe Latch"), blockers = { "side_panel" } })
	t.nodes.gpu.latches = { "pcie_latch" }

	addNode(t, { id = "nvme1", kind = "comp", parent = "mobo", cat = "storage", kinds = { "nvme" }, label = L("M.2 Yuvası 1", "M.2 Slot 1"), blockers = { "side_panel" }, esd = true, optional = true, index = 1 })
	addScrews(t, "nvme1", "nv1_s", 1, "PH1", L("M.2 Vidası", "M.2 Screw"))
	addNode(t, { id = "nvme2", kind = "comp", parent = "mobo", cat = "storage", kinds = { "nvme" }, label = L("M.2 Yuvası 2", "M.2 Slot 2"), blockers = { "side_panel", "gpu" }, esd = true, optional = true, index = 2 })
	addScrews(t, "nvme2", "nv2_s", 1, "PH1", L("M.2 Vidası", "M.2 Screw"))

	addNode(t, { id = "hdd1", kind = "comp", parent = "case", cat = "storage", kinds = { "hdd35", "hdd25", "ssd25" }, label = L("3.5\" Disk Yuvası", "3.5\" Drive Bay"), blockers = { "side_panel" }, optional = true })
	addScrews(t, "hdd1", "hdd1_s", 2, "PH2", L("Disk Vidası", "Drive Screw"))
	addNode(t, { id = "ssd1", kind = "comp", parent = "case", cat = "storage", kinds = { "ssd25", "hdd25" }, label = L("2.5\" SSD Yuvası", "2.5\" SSD Mount"), blockers = { "side_panel" }, optional = true })
	addScrews(t, "ssd1", "ssd1_s", 2, "PH2", L("SSD Vidası", "SSD Screw"))

	addNode(t, { id = "cmos", kind = "comp", parent = "mobo", cat = "misc", sub = "cmos", label = L("BIOS Pili", "CMOS Battery"), blockers = { "side_panel", "gpu" } })

	-- VRM capacitors around the socket
	for i = 1, 6 do
		addNode(t, { id = "cap" .. i, kind = "comp", parent = "mobo", cat = "misc", sub = "capacitor", solder = true, label = L("Kondansatör C" .. (40 + i), "Capacitor C" .. (40 + i)), index = i, needsOut = "mobo" })
	end

	-- case fans: front x3, rear, top x2
	local fanSlots = {
		{ "fan_f1", L("Ön Fan 1", "Front Fan 1") },
		{ "fan_f2", L("Ön Fan 2", "Front Fan 2") },
		{ "fan_f3", L("Ön Fan 3", "Front Fan 3") },
		{ "fan_r", L("Arka Fan", "Rear Fan") },
		{ "fan_t1", L("Üst Fan 1", "Top Fan 1") },
		{ "fan_t2", L("Üst Fan 2", "Top Fan 2") },
	}
	t.fanSlots = {}
	for i, f in fanSlots do
		local id = f[1]
		addNode(t, { id = id, kind = "comp", parent = "case", cat = "fan", label = f[2], blockers = { "side_panel" }, optional = true, dusty = true, index = i })
		addScrews(t, id, id .. "_s", 4, "PH2", L("Fan Vidası", "Fan Screw"))
		table.insert(t.fanSlots, id)
	end

	-- Cables
	local function cable(id, a, b, label, extra)
		local n = addNode(t, { id = id, kind = "cable", ends = { a, b }, label = label, blockers = { "side_panel" } })
		if extra then
			for k, v in extra do
				n[k] = v
			end
		end
		table.insert(t.nodes[a].cables, id)
		if b ~= a then
			table.insert(t.nodes[b].cables, id)
		end
		return n
	end
	cable("c24", "psu", "mobo", L("24-pin Anakart Güç", "24-pin ATX Power"))
	cable("ceps", "psu", "mobo", L("8-pin CPU Güç (EPS)", "8-pin CPU Power (EPS)"))
	for i = 1, 3 do
		cable("cpcie" .. i, "psu", "gpu", L("Ekran Kartı Güç " .. i, "GPU Power " .. i), { index = i })
	end
	cable("cfan_cpu", "cooler", "mobo", L("CPU Fan Kablosu", "CPU Fan Header"))
	for _, id in t.fanSlots do
		cable("cfan_" .. id, id, "mobo", L("Fan Kablosu", "Fan Cable"))
	end
	cable("csp_hdd1", "psu", "hdd1", L("SATA Güç (Disk)", "SATA Power (HDD)"))
	cable("csd_hdd1", "hdd1", "mobo", L("SATA Veri (Disk)", "SATA Data (HDD)"))
	cable("csp_ssd1", "psu", "ssd1", L("SATA Güç (SSD)", "SATA Power (SSD)"))
	cable("csd_ssd1", "ssd1", "mobo", L("SATA Veri (SSD)", "SATA Data (SSD)"))

	-- Things that must be in place for the PC to count as assembled
	t.required = { "psu", "mobo", "cpu", "cooler" }
	return t
end

----------------------------------------------------------------------------------------------------
-- Laptop
----------------------------------------------------------------------------------------------------
local function buildLaptop()
	local t = { kind = "laptop", nodes = {}, order = {} }

	addNode(t, { id = "base", kind = "root", label = L("Laptop Gövdesi", "Laptop Chassis") })
	addNode(t, { id = "lboard", kind = "board", parent = "base", label = L("Anakart (Lojik Kart)", "Logic Board"), side = "bottom", blockers = { "bottom_cover" } })

	addNode(t, { id = "feet", kind = "feet", parent = "base", label = L("Kauçuk Ayaklar", "Rubber Feet"), side = "bottom" })
	addNode(t, { id = "bottom_cover", kind = "panel", parent = "base", label = L("Alt Kapak", "Bottom Cover"), side = "bottom", pry = true })
	addScrews(t, "bottom_cover", "bc_s", 10, "model", L("Alt Kapak Vidası", "Bottom Cover Screw"), { side = "bottom" })
	-- two extra screws hidden under the feet on some models
	local hidden = {}
	for i = 1, 2 do
		local id = "bc_h" .. i
		addNode(t, { id = id, kind = "screw", owner = "bottom_cover", bit = "model", label = L("Gizli Vida (Ayak Altı)", "Hidden Screw (Under Foot)"), underFeet = true, side = "bottom", index = 10 + i })
		table.insert(hidden, id)
	end
	for _, id in hidden do
		table.insert(t.nodes.bottom_cover.screws, id)
	end

	local function comp(id, cat, label, extra)
		local n = addNode(t, { id = id, kind = "comp", parent = "base", cat = cat, label = label, side = "bottom", blockers = { "bottom_cover" } })
		if extra then
			for k, v in extra do
				n[k] = v
			end
		end
		return n
	end
	local function cable(id, a, b, label, extra)
		local n = addNode(t, { id = id, kind = "cable", ends = { a, b }, label = label, side = "bottom", blockers = { "bottom_cover" } })
		if extra then
			for k, v in extra do
				n[k] = v
			end
		end
		table.insert(t.nodes[a].cables, id)
		if b ~= a then
			table.insert(t.nodes[b].cables, id)
		end
		return n
	end

	comp("battery", "laptop", L("Batarya", "Battery"), { sub = "battery" })
	addScrews(t, "battery", "bat_s", 4, "PH1", L("Batarya Vidası", "Battery Screw"), { side = "bottom" })
	cable("bat_conn", "battery", "base", L("Batarya Konnektörü", "Battery Connector"))

	for i = 1, 2 do
		local id = "lram" .. i
		comp(id, "ram", L("RAM Yuvası " .. i, "RAM Slot " .. i), { form = "SODIMM", esd = true, optional = true, index = i, needsUnplugged = { "bat_conn" } })
		addNode(t, { id = id .. "_clip", kind = "latch", owner = id, parent = "base", label = L("RAM Mandalı " .. i, "RAM Clip " .. i), side = "bottom", blockers = { "bottom_cover" } })
		t.nodes[id].latches = { id .. "_clip" }
	end

	comp("lnvme", "storage", L("M.2 SSD", "M.2 SSD"), { kinds = { "nvme" }, esd = true, optional = true, needsUnplugged = { "bat_conn" } })
	addScrews(t, "lnvme", "lnv_s", 1, "PH0", L("M.2 Vidası", "M.2 Screw"), { side = "bottom" })

	comp("lsata", "storage", L("2.5\" Disk Yuvası", "2.5\" Drive Bay"), { kinds = { "hdd25", "ssd25" }, optional = true, needsUnplugged = { "bat_conn" } })
	addScrews(t, "lsata", "lsata_s", 2, "PH1", L("Disk Vidası", "Drive Screw"), { side = "bottom" })
	cable("lsata_conn", "lsata", "base", L("SATA Bağlantısı", "SATA Connector"))

	comp("lwifi", "misc", L("Wi-Fi Kartı", "Wi-Fi Card"), { sub = "wifi", esd = true, optional = true, needsUnplugged = { "bat_conn" } })
	addScrews(t, "lwifi", "lwifi_s", 1, "PH0", L("Wi-Fi Vidası", "Wi-Fi Screw"), { side = "bottom" })
	cable("lwifi_ant", "lwifi", "base", L("Anten Kabloları", "Antenna Cables"))

	comp("lfan", "laptop", L("Fan ve Soğutucu", "Fan & Heatsink"), { sub = "fan", dusty = true, needsUnplugged = { "bat_conn" } })
	addScrews(t, "lfan", "lfan_s", 5, "PH1", L("Soğutucu Vidası", "Heatsink Screw"), { side = "bottom" })
	cable("lfan_conn", "lfan", "base", L("Fan Kablosu", "Fan Cable"))

	comp("lcmos", "misc", L("BIOS Pili", "CMOS Battery"), { sub = "cmos", needsUnplugged = { "bat_conn" } })
	cable("lcmos_conn", "lcmos", "base", L("BIOS Pil Kablosu", "CMOS Cable"))

	comp("dcjack", "laptop", L("Şarj Soketi", "DC Jack"), { sub = "dcjack", needsUnplugged = { "bat_conn" } })
	addScrews(t, "dcjack", "dc_s", 1, "PH1", L("Soket Braketi Vidası", "Jack Bracket Screw"), { side = "bottom" })
	cable("dc_conn", "dcjack", "base", L("Şarj Soketi Kablosu", "DC Jack Cable"))

	-- keyboard: screws from the bottom (under the battery), then popped out from the top
	comp("keyboard", "laptop", L("Klavye", "Keyboard"), { sub = "keyboard", side = "top", blockers = { "battery" }, needsUnplugged = { "kb_ribbon" }, pry = true })
	addScrews(t, "keyboard", "kb_s", 6, "PH1", L("Klavye Vidası", "Keyboard Screw"), { side = "bottom", blockers = { "battery" } })
	cable("kb_ribbon", "keyboard", "base", L("Klavye Şerit Kablosu", "Keyboard Ribbon"), { blockers = { "bottom_cover", "battery" } })

	-- lid side
	addNode(t, { id = "bezel", kind = "panel", parent = "base", label = L("Ekran Çerçevesi", "Screen Bezel"), side = "top", pry = true, lidOpen = true })
	comp("screen", "laptop", L("Ekran Paneli", "Display Panel"), { sub = "screen", side = "top", lidOpen = true, blockers = { "bezel" }, needsUnplugged = { "bat_conn", "edp_conn" } })
	addScrews(t, "screen", "scr_s", 4, "PH1", L("Panel Vidası", "Panel Screw"), { side = "top", lidOpen = true, blockers = { "bezel" } })
	cable("edp_conn", "screen", "base", L("Ekran Kablosu (eDP)", "Display Cable (eDP)"), { side = "top", lidOpen = true, blockers = { "bezel" }, afterScrews = "screen" })
	comp("hinges", "laptop", L("Menteşeler", "Hinges"), { sub = "hinge", side = "top", lidOpen = true, blockers = { "bezel" }, needsUnplugged = { "bat_conn" } })
	addScrews(t, "hinges", "hng_s", 4, "PH1", L("Menteşe Vidası", "Hinge Screw"), { side = "top", lidOpen = true, blockers = { "bezel" } })

	t.required = { "battery", "lfan", "keyboard", "screen", "hinges", "dcjack", "lcmos" }
	return t
end

Templates.desktop = buildDesktop()
Templates.laptop = buildLaptop()

function Templates.get(kind: string)
	return Templates[kind]
end

return Templates
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1301">
          <Properties>
            <string name="Name">RepairRules</string>
            <string name="Source"><![CDATA[-- RepairRules: the single source of truth for what a technician may do to a device and what the
-- device does when powered on. The server runs it authoritatively; the client runs the same checks
-- to show hints before sending a request.
--
-- Device state ("dev") is a plain table so it can be sent over the network:
--   kind, model, nodes[id] = { st, part?, cond?, dust?, os?, virus? }, paste = { st, q },
--   orient/lid (laptops), liquid, tray = { items }, strap, ties, tests, boot (drive node id),
--   sw = { bios }, orig = { [nodeId] = true } (slots occupied when the customer brought it in),
--   hidden = { [nodeId] = fault flag } (server only, stripped by Rules.view)

local Shared = script.Parent.Parent
local Templates = require(script.Parent.DeviceTemplates)
local Parts = require(Shared.Data.Parts)
local Tools = require(Shared.Data.Tools)
local Devices = require(Shared.Data.Devices)
local Config = require(Shared.Config)

local Rules = {}
Rules.Templates = Templates

local FAN_ORDER = { "fan_r", "fan_f1", "fan_f2", "fan_f3", "fan_t1", "fan_t2" }
local DESKTOP_DRIVES = { "nvme1", "nvme2", "ssd1", "hdd1" }
local LAPTOP_DRIVES = { "lnvme", "lsata" }
Rules.FanOrder = FAN_ORDER

----------------------------------------------------------------------------------------------------
-- Messages
----------------------------------------------------------------------------------------------------
local REASONS = {
	not_present = { tr = "Bu parça bu cihazda yok.", en = "That part isn't present on this device." },
	no_tool = { tr = "Bu alete sahip değilsin.", en = "You don't own that tool." },
	wrong_tool = { tr = "Bu iş için başka bir alet gerekiyor.", en = "That needs a different tool." },
	wrong_bit = { tr = "Tornavida ucu bu vidaya uymuyor ({bit} lazım).", en = "Wrong bit for this screw ({bit} needed)." },
	wrong_target = { tr = "Bu aletle buna bir şey yapılamaz.", en = "That tool can't be used on this." },
	already = { tr = "Zaten öyle.", en = "Already done." },
	flip_bottom = { tr = "Önce laptopu ters çevir.", en = "Flip the laptop over first." },
	flip_top = { tr = "Önce laptopu düz çevir.", en = "Turn the laptop right side up first." },
	lid_open = { tr = "Önce ekran kapağını aç.", en = "Open the lid first." },
	lid_closed = { tr = "Çevirmeden önce kapağı kapat.", en = "Close the lid before flipping." },
	remove_first = { tr = "Önce şunu çıkar: {node}.", en = "Remove this first: {node}." },
	unplug_first = { tr = "Önce şu kabloyu çıkar: {node}.", en = "Unplug this first: {node}." },
	unscrew_first = { tr = "Önce vidalarını sök ({count} vida kaldı).", en = "Unscrew it first ({count} screws left)." },
	open_latch_first = { tr = "Önce mandalı aç: {node}.", en = "Open the latch first: {node}." },
	peel_first = { tr = "Bu vida kauçuk ayağın altında. Önce ayağı spudger ile kaldır.", en = "This screw hides under a rubber foot. Peel it with a spudger first." },
	pry_first = { tr = "Klipsli: önce spudger ile kanırt.", en = "It's clipped in: pry it with a spudger first." },
	desolder_first = { tr = "Lehimli: önce havya ile lehimini al.", en = "It's soldered: desolder it first." },
	solder_first = { tr = "Önce lehimle.", en = "Solder it first." },
	board_out_first = { tr = "Lehim için anakartı kasadan çıkarıp tezgaha al.", en = "Take the motherboard out of the case to solder." },
	ends_missing = { tr = "Kablonun takılacağı parça yerinde değil.", en = "The part this cable plugs into isn't installed." },
	nothing_to_install = { tr = "Takılacak parça seçilmedi.", en = "No part selected to install." },
	slot_busy = { tr = "Yuva dolu.", en = "The slot is occupied." },
	incompatible = { tr = "Uyumsuz: {why}", en = "Incompatible: {why}" },
	children_attached = { tr = "Önce üzerindeki parçaları çıkar: {node}.", en = "Remove what's mounted on it first: {node}." },
	need_parent = { tr = "Önce {node} takılmalı.", en = "{node} must be installed first." },
	clean_paste_first = { tr = "Eski macunu önce alkolle temizle.", en = "Clean off the old paste first." },
	cooler_off_first = { tr = "Önce işlemci soğutucusunu çıkar.", en = "Remove the CPU cooler first." },
	no_dust = { tr = "Burada temizlenecek toz kalmadı.", en = "No dust left here." },
	no_paste_left = { tr = "Termal macunun bitti. Parçacıdan al.", en = "You're out of thermal paste. Buy some." },
	no_solder_left = { tr = "Lehim telin bitti.", en = "You're out of solder wire." },
	no_ties_left = { tr = "Kablo bağın bitti.", en = "You're out of zip ties." },
	cpu_out_first = { tr = "Pinlere ulaşmak için işlemciyi çıkar.", en = "Remove the CPU to reach the pins." },
	pins_ok = { tr = "Pinler zaten düzgün.", en = "The pins are already straight." },
	not_laptop = { tr = "Bu sadece laptoplarda yapılır.", en = "Only for laptops." },
	not_desktop = { tr = "Bu sadece masaüstü bilgisayarlarda yapılır.", en = "Only for desktops." },
	cables_first = { tr = "Önce tüm kabloları tak.", en = "Plug in all the cables first." },
	no_boot_for_usb = { tr = "USB'den açmak için cihazın görüntü vermesi lazım.", en = "The device must POST with a picture to boot the USB." },
	no_drive = { tr = "Kurulum yapılacak sağlam bir disk yok.", en = "There's no healthy drive to install to." },
	board_needed = { tr = "Bunun için anakart ve PSU takılı olmalı.", en = "The motherboard and PSU must be installed." },
	psu_needed = { tr = "Güç kaynağı yok.", en = "There is no power supply." },
}
Rules.Reasons = REASONS

local function fmt(s: string, vars: { [string]: any }?): string
	if not vars then
		return s
	end
	return (string.gsub(s, "{(%w+)}", function(k)
		local v = vars[k]
		if v == nil then
			return "{" .. k .. "}"
		end
		return tostring(v)
	end))
end

function Rules.message(key: string, lang: string?, vars: { [string]: any }?): string
	local m = REASONS[key]
	if not m then
		return key
	end
	return fmt(if lang == "en" then m.en else m.tr, vars)
end

----------------------------------------------------------------------------------------------------
-- Basic accessors
----------------------------------------------------------------------------------------------------
local function tmpl(dev)
	return Templates[dev.kind]
end

function Rules.tnode(dev, id: string)
	return Templates[dev.kind].nodes[id]
end
local tnode = Rules.tnode

local function st(dev, id: string): string?
	local s = dev.nodes[id]
	return s and s.st
end

local function label(dev, id: string, lang: string?): string
	local tn = tnode(dev, id)
	if not tn or not tn.label then
		return id
	end
	return if lang == "en" then tn.label.en else tn.label.tr
end
Rules.label = label

function Rules.laptopModel(dev)
	if dev.kind ~= "laptop" then
		return nil
	end
	return Devices.laptop(dev.model)
end

-- Part definition of whatever part sits in node `id` (installed or lying out), or nil.
function Rules.part(dev, id: string)
	local s = dev.nodes[id]
	if not s or not s.part then
		return nil
	end
	return Parts.get(s.part)
end
local partOf = Rules.part

local function caseDef(dev)
	if dev.kind ~= "desktop" then
		return nil
	end
	return Parts.get(dev.model)
end

function Rules.isSoldered(dev, id: string): boolean
	local tn = tnode(dev, id)
	if not tn then
		return false
	end
	if tn.solder then
		return true
	end
	if dev.kind == "laptop" and id == "dcjack" then
		local m = Rules.laptopModel(dev)
		return m ~= nil and m.dcSoldered == true
	end
	return false
end

-- Does this node exist on this particular device (given its parts)?
function Rules.available(dev, id: string): boolean
	local tn = tnode(dev, id)
	if not tn then
		return false
	end
	if tn.kind == "screw" or tn.kind == "latch" then
		if tn.kind == "screw" and tn.underFeet then
			local m = Rules.laptopModel(dev)
			if not m or (tn.index - 10) > m.feetScrews then
				return false
			end
		end
		if tn.kind == "screw" and dev.kind == "laptop" and tn.owner == "dcjack" and Rules.isSoldered(dev, "dcjack") then
			return false
		end
		return Rules.available(dev, tn.owner)
	end
	if tn.kind == "cable" then
		local i = string.match(id, "^cpcie(%d)$")
		if i then
			local g = partOf(dev, "gpu")
			if not g or #Parts.gpuConnectors(g) < tonumber(i) :: number then
				return false
			end
		end
		if id == "dc_conn" and Rules.isSoldered(dev, "dcjack") then
			return false
		end
		return Rules.available(dev, tn.ends[1]) and Rules.available(dev, tn.ends[2])
	end

	if dev.kind == "desktop" then
		local mobo = partOf(dev, "mobo")
		local case = caseDef(dev)
		local ram = string.match(id, "^ram(%d)$")
		if ram then
			return mobo ~= nil and tonumber(ram) :: number <= mobo.memSlots
		end
		local nv = string.match(id, "^nvme(%d)$")
		if nv then
			return mobo ~= nil and tonumber(nv) :: number <= mobo.m2
		end
		if tn.parent == "mobo" or id == "gpu" then
			return mobo ~= nil
		end
		local fi = table.find(FAN_ORDER, id)
		if fi then
			return case ~= nil and fi <= case.fanSlots
		end
		if id == "hdd1" then
			return case ~= nil and case.style ~= "itx" and case.style ~= "sff"
		end
		return true
	else
		local m = Rules.laptopModel(dev)
		if not m then
			return false
		end
		local lr = string.match(id, "^lram(%d)$")
		if lr then
			return tonumber(lr) :: number <= m.ramSlots
		end
		if id == "lsata" then
			return m.class == "budget15"
		end
		if id == "feet" then
			return m.feetScrews > 0
		end
		return true
	end
end
local available = Rules.available

-- Resolves the screwdriver head a screw needs.
function Rules.screwBit(dev, id: string): string
	local tn = tnode(dev, id)
	if tn.bit == "model" then
		local m = Rules.laptopModel(dev)
		return if m then m.screwBit else "PH1"
	end
	if dev.kind == "desktop" and (string.sub(id, 1, 3) == "nv1" or string.sub(id, 1, 3) == "nv2") then
		local mobo = partOf(dev, "mobo")
		if mobo and mobo.price >= 250 then
			return "toolless"
		end
	end
	return tn.bit
end

local function toolBitOk(toolId: string, bit: string): boolean
	if bit == "thumb" then
		return toolId == "hand" or Tools.canDo(toolId, "unscrew", "PH2")
	end
	if bit == "toolless" then
		return toolId == "hand" or Tools.canDo(toolId, "unscrew", "PH1")
	end
	return Tools.canDo(toolId, "unscrew", bit)
end

----------------------------------------------------------------------------------------------------
-- Compatibility
----------------------------------------------------------------------------------------------------
local function why(lang, tr, en)
	return if lang == "en" then en else tr
end

-- Can part `p` go into node `id`? Returns ok, explanation.
function Rules.compatible(dev, id: string, p, lang: string?): (boolean, string?)
	local tn = tnode(dev, id)
	if not tn or tn.kind ~= "comp" or not p then
		return false, why(lang, "yanlış yuva", "wrong slot")
	end
	if p.cat ~= tn.cat then
		return false, why(lang, "bu yuvaya bu tür parça takılmaz", "wrong kind of part for this slot")
	end
	if tn.sub and p.sub ~= tn.sub then
		return false, why(lang, "bu yuvaya bu tür parça takılmaz", "wrong kind of part for this slot")
	end
	if p.cat == "laptop" then
		local m = Rules.laptopModel(dev)
		if not m or p.lclass ~= m.class then
			return false, why(lang, "başka laptop sınıfı için", "made for another laptop class")
		end
		return true
	end
	if p.cat == "misc" and p.sub == "wifi" and dev.kind == "laptop" and p.slot ~= "m2" then
		return false, why(lang, "laptopa sadece M.2 Wi-Fi kartı takılır", "laptops take M.2 Wi-Fi cards only")
	end
	if p.cat == "storage" and tn.kinds and not table.find(tn.kinds, p.kind) then
		return false, why(lang, "disk tipi bu yuvaya uymuyor", "drive type doesn't fit this bay")
	end
	if dev.kind == "desktop" then
		local mobo = partOf(dev, "mobo")
		local case = caseDef(dev)
		if p.cat == "ram" then
			if p.form ~= "DIMM" then
				return false, why(lang, "laptop RAM'i (SO-DIMM) masaüstüne takılmaz", "laptop SO-DIMM doesn't fit a desktop")
			end
			if mobo and p.mem ~= mobo.mem then
				return false, why(lang, "anakart " .. mobo.mem .. " istiyor", "board needs " .. mobo.mem)
			end
		elseif p.cat == "cpu" then
			if mobo and p.socket ~= mobo.socket then
				return false, why(lang, "soket farklı (" .. mobo.socket .. " lazım)", "different socket (" .. mobo.socket .. " needed)")
			end
		elseif p.cat == "mobo" then
			if case and not Parts.caseFits(case, p.form) then
				return false, why(lang, "kasaya sığmaz (" .. p.form .. ")", "doesn't fit the case (" .. p.form .. ")")
			end
		elseif p.cat == "cooler" then
			local socket = mobo and mobo.socket
			if socket and not Parts.coolerFits(p, socket) then
				return false, why(lang, socket .. " soketine uymuyor", "doesn't fit " .. socket)
			end
			if case and (case.style == "sff" or case.style == "office") and p.kind == "aio" then
				return false, why(lang, "kasada radyatör yeri yok", "no radiator room in this case")
			end
		elseif p.cat == "gpu" then
			if case and p.len > case.gpuMax then
				return false, why(lang, "kart kasaya sığmıyor (" .. p.len .. " cm)", "card too long for the case (" .. p.len .. " cm)")
			end
			if case and case.lowProfileOnly and not p.lowProfile then
				return false, why(lang, "bu kasaya sadece düşük profil kart girer", "this case only fits low-profile cards")
			end
		elseif p.cat == "psu" then
			if case and case.style == "itx" and p.form ~= "SFX" then
				return false, why(lang, "ITX kasa SFX güç kaynağı ister", "ITX case needs an SFX PSU")
			end
		elseif p.cat == "storage" then
			if string.match(id, "^nvme") and p.kind ~= "nvme" then
				return false, why(lang, "M.2 yuvasına NVMe takılır", "M.2 slot takes NVMe")
			end
		elseif p.cat == "case" then
			return false, why(lang, "kasa değiştirilemez", "the case can't be swapped")
		end
	else
		local m = Rules.laptopModel(dev)
		if p.cat == "ram" then
			if p.form ~= "SODIMM" then
				return false, why(lang, "laptop SO-DIMM ister", "laptops need SO-DIMM")
			end
			if m and p.mem ~= m.mem then
				return false, why(lang, "laptop " .. m.mem .. " istiyor", "laptop needs " .. m.mem)
			end
		end
	end
	return true
end

----------------------------------------------------------------------------------------------------
-- Prerequisite helpers
----------------------------------------------------------------------------------------------------
local function sideOk(dev, tn)
	if dev.kind ~= "laptop" then
		return true
	end
	local side = tn.side
	local lidOpen = tn.lidOpen
	if not side and tn.owner then
		local o = tnode(dev, tn.owner)
		side = o and o.side
		lidOpen = lidOpen or (o and o.lidOpen)
	end
	if side == "bottom" and dev.orient ~= "bottom" then
		return false, "flip_bottom"
	end
	if side == "top" then
		if dev.orient ~= "top" then
			return false, "flip_top"
		end
		if lidOpen and dev.lid ~= "open" then
			return false, "lid_open"
		end
	end
	return true
end

local function blocking(dev, list)
	for _, b in list do
		if available(dev, b) then
			local s = st(dev, b)
			if s == "in" or s == "loose" then
				return b
			end
		end
	end
	return nil
end

local function stillPlugged(dev, list)
	for _, c in list do
		if available(dev, c) and st(dev, c) ~= "out" then
			return c
		end
	end
	return nil
end

local function screwsLeft(dev, owner: string): number
	local tn = tnode(dev, owner)
	local n = 0
	for _, sid in tn.screws do
		if available(dev, sid) and st(dev, sid) == "in" then
			n += 1
		end
	end
	return n
end

local function cablesStillIn(dev, owner: string)
	local tn = tnode(dev, owner)
	for _, cid in tn.cables do
		if available(dev, cid) and st(dev, cid) ~= "out" then
			return cid
		end
	end
	return nil
end

local function latchClosed(dev, owner: string)
	local tn = tnode(dev, owner)
	for _, lid in tn.latches do
		if available(dev, lid) and st(dev, lid) ~= "open" then
			return lid
		end
	end
	return nil
end

local MOBO_CHILDREN = { "cpu", "ram1", "ram2", "ram3", "ram4", "nvme1", "nvme2", "cmos", "cooler" }

local function fail(key: string, vars: { [string]: any }?)
	return false, key, vars
end

local function nodeVar(dev, id, ctx)
	return { node = label(dev, id, ctx and ctx.lang), id = id }
end

----------------------------------------------------------------------------------------------------
-- check(): can `action` be done to `target` right now?
-- ctx = { tool = toolId, owned = { [toolId] = true }, lang = "tr"|"en" }
-- args = action specific (install: { source = "self"|"inv"|"used"|"tray", part = id, uid = id })
-- returns ok, reasonKey, reasonVars
----------------------------------------------------------------------------------------------------
local TARGETLESS = {
	flip = true, lid = true, press_power = true, stress = true, software = true, wear_strap = true,
	tie_cables = true, psu_test = true, post_code = true, thermal_view = true, diagnose = true,
}
-- Bench buttons that work whatever tool is in hand.
local UNTOOLED = { press_power = true, stress = true, discard = true, diagnose = true, flip = true, lid = true, tie_cables = true }
Rules.Untooled = UNTOOLED

function Rules.check(dev, action: string, target: string?, args: { [string]: any }?, ctx: { [string]: any }): (boolean, string?, { [string]: any }?)
	args = args or {}
	local toolId = ctx.tool or "hand"
	local tool = Tools.get(toolId)
	if not tool then
		return fail("wrong_tool")
	end
	if toolId ~= "hand" and ctx.owned and not ctx.owned[toolId] then
		return fail("no_tool")
	end
	if not UNTOOLED[action] and not table.find(tool.actions, action) then
		return fail("wrong_tool")
	end

	local tn, s
	if not TARGETLESS[action] then
		if typeof(target) ~= "string" then
			return fail("not_present")
		end
		tn = tnode(dev, target :: string)
		if not tn or not available(dev, target :: string) then
			return fail("not_present")
		end
		s = dev.nodes[target :: string]
	end

	if action == "unscrew" or action == "screw" then
		if tn.kind ~= "screw" then
			return fail("wrong_target")
		end
		local bit = Rules.screwBit(dev, target :: string)
		if not toolBitOk(toolId, bit) then
			return fail("wrong_bit", { bit = bit })
		end
		if action == "unscrew" and s.st ~= "in" then
			return fail("already")
		end
		if action == "screw" then
			if s.st == "in" then
				return fail("already")
			end
			local os = st(dev, tn.owner)
			if os ~= "in" and os ~= "loose" then
				return fail("need_parent", nodeVar(dev, tn.owner, ctx))
			end
		end
		if tn.underFeet and st(dev, "feet") ~= "peeled" then
			return fail("peel_first")
		end
		local ok, why = sideOk(dev, tn)
		if not ok then
			return fail(why :: string)
		end
		local b = blocking(dev, tn.blockers) or blocking(dev, tnode(dev, tn.owner).blockers)
		if b then
			return fail("remove_first", nodeVar(dev, b, ctx))
		end
		return true
	elseif action == "unplug" or action == "plug" then
		if tn.kind ~= "cable" then
			return fail("wrong_target")
		end
		if action == "unplug" and s.st == "out" then
			return fail("already")
		end
		if action == "plug" then
			if s.st == "in" then
				return fail("already")
			end
			for _, e in tn.ends do
				local es = st(dev, e)
				if es ~= "in" then
					return fail("ends_missing")
				end
			end
		end
		local ok, why = sideOk(dev, tn)
		if not ok then
			return fail(why :: string)
		end
		local b = blocking(dev, tn.blockers)
		if b then
			return fail("remove_first", nodeVar(dev, b, ctx))
		end
		if tn.afterScrews and screwsLeft(dev, tn.afterScrews) > 0 then
			return fail("unscrew_first", { count = screwsLeft(dev, tn.afterScrews), id = tn.afterScrews })
		end
		return true
	elseif action == "open_latch" or action == "close_latch" then
		if tn.kind ~= "latch" then
			return fail("wrong_target")
		end
		if action == "open_latch" and s.st == "open" then
			return fail("already")
		end
		if action == "close_latch" and s.st == "closed" then
			return fail("already")
		end
		local ok, why = sideOk(dev, tn)
		if not ok then
			return fail(why :: string)
		end
		local b = blocking(dev, tn.blockers)
		if b then
			return fail("remove_first", nodeVar(dev, b, ctx))
		end
		return true
	elseif action == "remove" then
		if tn.kind == "feet" then
			return fail("wrong_target")
		end
		if tn.kind ~= "comp" and tn.kind ~= "panel" then
			return fail("wrong_target")
		end
		if s.st == "out" or s.st == "empty" then
			return fail("already")
		end
		if Rules.isSoldered(dev, target :: string) and s.st == "in" then
			return fail("desolder_first")
		end
		if tn.pry and s.st == "in" then
			return fail("pry_first")
		end
		local ok, why = sideOk(dev, tn)
		if not ok then
			return fail(why :: string)
		end
		-- reachability first (panels, covers, the battery), then the part's own fasteners
		local b = blocking(dev, tn.blockers)
		if b then
			return fail("remove_first", nodeVar(dev, b, ctx))
		end
		local u = stillPlugged(dev, tn.needsUnplugged)
		if u then
			return fail("unplug_first", nodeVar(dev, u, ctx))
		end
		if tn.solder and tn.needsOut and st(dev, tn.needsOut) ~= "out" then
			return fail("board_out_first")
		end
		local left = screwsLeft(dev, target :: string)
		if left > 0 then
			return fail("unscrew_first", { count = left, id = target })
		end
		local c = cablesStillIn(dev, target :: string)
		if c then
			return fail("unplug_first", nodeVar(dev, c, ctx))
		end
		local l = latchClosed(dev, target :: string)
		if l then
			return fail("open_latch_first", nodeVar(dev, l, ctx))
		end
		return true
	elseif action == "install" then
		if tn.kind == "feet" then
			if s.st ~= "peeled" then
				return fail("already")
			end
			local ok, why = sideOk(dev, tn)
			if not ok then
				return fail(why :: string)
			end
			return true
		end
		if tn.kind == "panel" then
			if s.st ~= "out" and s.st ~= "loose" then
				return fail("already")
			end
			local ok, why = sideOk(dev, tn)
			if not ok then
				return fail(why :: string)
			end
			return true
		end
		if tn.kind ~= "comp" then
			return fail("wrong_target")
		end
		local source = args.source
		if source == "self" then
			local pried = tn.pry and s.st == "loose"
			if s.st ~= "out" and not pried then
				return fail(if s.st == "empty" then "nothing_to_install" else "already")
			end
		else
			if s.st == "in" or s.st == "loose" then
				return fail("slot_busy")
			end
			local p = args.part and Parts.get(args.part)
			if not p then
				return fail("nothing_to_install")
			end
			local ok, whyNot = Rules.compatible(dev, target :: string, p, ctx.lang)
			if not ok then
				return fail("incompatible", { why = whyNot })
			end
			if s.st == "out" and target == "mobo" then
				for _, child in MOBO_CHILDREN do
					if st(dev, child) == "in" then
						return fail("children_attached", nodeVar(dev, child, ctx))
					end
				end
			end
		end
		if tn.parent and tn.parent ~= "case" and tn.parent ~= "base" then
			local ps = st(dev, tn.parent)
			if ps == nil or ps == "empty" then
				return fail("need_parent", nodeVar(dev, tn.parent, ctx))
			end
		end
		local ok, why = sideOk(dev, tn)
		if not ok then
			return fail(why :: string)
		end
		local b = blocking(dev, tn.blockers)
		if b then
			return fail("remove_first", nodeVar(dev, b, ctx))
		end
		local u = stillPlugged(dev, tn.needsUnplugged)
		if u then
			return fail("unplug_first", nodeVar(dev, u, ctx))
		end
		if tn.cat == "ram" or tn.cat == "cpu" then
			local l = latchClosed(dev, target :: string)
			if l then
				return fail("open_latch_first", nodeVar(dev, l, ctx))
			end
		end
		if tn.solder and tn.needsOut and st(dev, tn.needsOut) ~= "out" then
			return fail("board_out_first")
		end
		return true
	elseif action == "discard" then
		if tn.kind ~= "comp" or s.st ~= "out" then
			return fail("already")
		end
		if target == "mobo" then
			for _, child in MOBO_CHILDREN do
				if st(dev, child) == "in" then
					return fail("children_attached", nodeVar(dev, child, ctx))
				end
			end
		end
		return true
	elseif action == "pry" then
		if not tn.pry then
			return fail("wrong_target")
		end
		if s.st ~= "in" then
			return fail("already")
		end
		local ok, why = sideOk(dev, tn)
		if not ok then
			return fail(why :: string)
		end
		local left = screwsLeft(dev, target :: string)
		if left > 0 then
			-- hidden screws under the feet count too
			return fail("unscrew_first", { count = left, id = target })
		end
		local b = blocking(dev, tn.blockers)
		if b then
			return fail("remove_first", nodeVar(dev, b, ctx))
		end
		local u = stillPlugged(dev, tn.needsUnplugged)
		if u then
			return fail("unplug_first", nodeVar(dev, u, ctx))
		end
		return true
	elseif action == "peel" then
		if tn.kind ~= "feet" then
			return fail("wrong_target")
		end
		if s.st ~= "in" then
			return fail("already")
		end
		local ok, why = sideOk(dev, tn)
		if not ok then
			return fail(why :: string)
		end
		return true
	elseif action == "flip" then
		if dev.kind ~= "laptop" then
			return fail("not_laptop")
		end
		if dev.lid == "open" then
			return fail("lid_closed")
		end
		return true
	elseif action == "lid" then
		if dev.kind ~= "laptop" then
			return fail("not_laptop")
		end
		if dev.orient ~= "top" then
			return fail("flip_top")
		end
		return true
	elseif action == "clean_paste" or action == "apply_paste" then
		local cpuNode = if dev.kind == "desktop" then "cpu" else "lboard"
		if target ~= cpuNode then
			return fail("wrong_target")
		end
		if dev.kind == "desktop" then
			if st(dev, "cpu") == "empty" then
				return fail("not_present")
			end
			if st(dev, "cooler") == "in" then
				return fail("cooler_off_first")
			end
		else
			if dev.orient ~= "bottom" then
				return fail("flip_bottom")
			end
			if st(dev, "lfan") == "in" then
				return fail("remove_first", nodeVar(dev, "lfan", ctx))
			end
		end
		local p = dev.paste.st
		if action == "clean_paste" then
			if p == "clean" or p == "none" then
				return fail("already")
			end
		else
			if p == "dry" or p == "old" then
				return fail("clean_paste_first")
			end
			if p == "fresh" then
				return fail("already")
			end
		end
		return true
	elseif action == "blow_dust" or action == "brush" then
		if not tn.dusty and target ~= "lboard" then
			return fail("wrong_target")
		end
		if s.st == "empty" then
			return fail("not_present")
		end
		if dev.kind == "desktop" then
			if st(dev, "side_panel") == "in" then
				return fail("remove_first", nodeVar(dev, "side_panel", ctx))
			end
		else
			if dev.orient ~= "bottom" then
				return fail("flip_bottom")
			end
			if st(dev, "bottom_cover") ~= "out" then
				return fail("remove_first", nodeVar(dev, "bottom_cover", ctx))
			end
		end
		local dusty = (s.dust or 0) > 0.02
		local wet = target == "lboard" and (dev.liquid or 0) > 0.02 and action == "brush"
		if not dusty and not wet then
			return fail("no_dust")
		end
		return true
	elseif action == "clean_liquid" then
		if dev.kind ~= "laptop" then
			return fail("not_laptop")
		end
		if target ~= "lboard" and target ~= "keyboard" then
			return fail("wrong_target")
		end
		if dev.orient ~= "bottom" then
			return fail("flip_bottom")
		end
		if st(dev, "bottom_cover") ~= "out" then
			return fail("remove_first", nodeVar(dev, "bottom_cover", ctx))
		end
		if stillPlugged(dev, { "bat_conn" }) then
			return fail("unplug_first", nodeVar(dev, "bat_conn", ctx))
		end
		if (dev.liquid or 0) <= 0.02 then
			return fail("already")
		end
		return true
	elseif action == "desolder" or action == "solder" then
		if not Rules.isSoldered(dev, target :: string) then
			return fail("wrong_target")
		end
		if action == "desolder" and s.st ~= "in" then
			return fail(if s.st == "loose" then "already" else "not_present")
		end
		if action == "solder" then
			if toolId ~= "soldering_station" then
				return fail("wrong_tool")
			end
			if s.st ~= "loose" then
				return fail(if s.st == "in" then "already" else "not_present")
			end
		end
		if tn.needsOut and st(dev, tn.needsOut) ~= "out" then
			return fail("board_out_first")
		end
		local ok, why = sideOk(dev, tn)
		if not ok then
			return fail(why :: string)
		end
		local b = blocking(dev, tn.blockers)
		if b then
			return fail("remove_first", nodeVar(dev, b, ctx))
		end
		local u = stillPlugged(dev, tn.needsUnplugged)
		if u then
			return fail("unplug_first", nodeVar(dev, u, ctx))
		end
		return true
	elseif action == "straighten_pins" then
		if target ~= "socket" then
			return fail("wrong_target")
		end
		if st(dev, "cpu") == "in" then
			return fail("cpu_out_first")
		end
		if s.st ~= "bent" then
			return fail("pins_ok")
		end
		return true
	elseif action == "tie_cables" then
		if dev.kind ~= "desktop" then
			return fail("not_desktop")
		end
		if st(dev, "side_panel") == "in" then
			return fail("remove_first", nodeVar(dev, "side_panel", ctx))
		end
		if dev.ties then
			return fail("already")
		end
		for id, tn2 in tmpl(dev).nodes do
			if tn2.kind == "cable" and available(dev, id) then
				local a, b = st(dev, tn2.ends[1]), st(dev, tn2.ends[2])
				if a == "in" and b == "in" and st(dev, id) ~= "in" then
					return fail("cables_first")
				end
			end
		end
		return true
	elseif action == "inspect" or action == "measure" then
		return true
	elseif action == "software" then
		local prog = args.program
		if prog == "bios_update" then
			if st(dev, "mobo") ~= "in" and dev.kind == "desktop" then
				return fail("board_needed")
			end
			return true
		end
		local r = Rules.evaluate(dev, "post")
		if r.stage ~= "ok" and r.stage ~= "no_boot" and r.stage ~= "no_os" and r.stage ~= "os_error" and r.stage ~= "fan_error" then
			return fail("no_boot_for_usb")
		end
		return true
	elseif action == "psu_test" then
		if dev.kind ~= "desktop" then
			return fail("not_desktop")
		end
		if st(dev, "psu") == "empty" then
			return fail("psu_needed")
		end
		return true
	elseif action == "post_code" then
		if dev.kind ~= "desktop" then
			return fail("not_desktop")
		end
		return true
	end
	return true
end

----------------------------------------------------------------------------------------------------
-- apply(): performs a checked action. Mutates dev and returns a result table.
-- ctx (server) may provide:
--   takePart(source, partId, uid) -> { part, cond, hidden } | nil   (removes from inventory / tray)
--   usePaste() -> quality 0..1 | nil, useSolder() -> bool, useTies(n) -> bool
--   rng (Random) for ESD and intermittent faults
----------------------------------------------------------------------------------------------------
local ESD_SENSITIVE = { gpu = true, cpu = true, mobo = true, ram1 = true, ram2 = true, ram3 = true, ram4 = true, nvme1 = true, nvme2 = true, lram1 = true, lram2 = true, lnvme = true, lwifi = true }

local function newUid(dev): string
	dev.nextUid = (dev.nextUid or 0) + 1
	return "t" .. dev.nextUid
end

local function pushTray(dev, nodeId: string, s)
	local item = { uid = newUid(dev), node = nodeId, part = s.part, cond = s.cond or 1, origin = s.origin or "device", hidden = dev.hidden and dev.hidden[nodeId] or nil }
	table.insert(dev.tray, item)
	if dev.hidden then
		dev.hidden[nodeId] = nil
	end
	s.part = nil
	s.cond = nil
	s.origin = nil
	s.st = "empty"
	return item
end

local function resetBoardFixtures(dev)
	for i = 1, 6 do
		local c = dev.nodes["cap" .. i]
		if c then
			c.st = "in"
			c.part = "cap_470"
			if dev.hidden then
				dev.hidden["cap" .. i] = nil
			end
		end
	end
	if dev.nodes.socket then
		dev.nodes.socket.st = "ok"
	end
	for _, l in { "cpu_arm", "pcie_latch", "ram1_clip", "ram2_clip", "ram3_clip", "ram4_clip" } do
		if dev.nodes[l] then
			dev.nodes[l].st = "closed"
		end
	end
end

local function esdRisk(dev, nodeId: string, ctx)
	if dev.strap or not ESD_SENSITIVE[nodeId] or not ctx.rng or not dev.hidden then
		return nil
	end
	if ctx.rng:NextNumber() < Config.EsdDamageChance then
		dev.hidden[nodeId] = if string.find(nodeId, "ram") then "faulty" else "dead"
		dev.esdEvents = (dev.esdEvents or 0) + 1
		return nodeId
	end
	return nil
end

function Rules.apply(dev, action: string, target: string?, args: { [string]: any }?, ctx: { [string]: any }): { [string]: any }
	args = args or {}
	local ok, reason, vars = Rules.check(dev, action, target, args, ctx)
	if not ok then
		return { ok = false, reason = reason, vars = vars, msg = Rules.message(reason :: string, ctx.lang, vars) }
	end
	local s = target and dev.nodes[target]
	local result: { [string]: any } = { ok = true, action = action, target = target }

	if action == "unscrew" or action == "unplug" then
		s.st = "out"
	elseif action == "screw" or action == "plug" then
		s.st = "in"
	elseif action == "open_latch" then
		s.st = "open"
	elseif action == "close_latch" then
		s.st = "closed"
	elseif action == "remove" then
		s.st = "out"
		result.esd = esdRisk(dev, target :: string, ctx)
	elseif action == "discard" then
		result.tray = pushTray(dev, target :: string, s)
	elseif action == "install" then
		local tn = tnode(dev, target :: string)
		if tn.kind == "panel" or tn.kind == "feet" then
			s.st = "in"
		else
			if args.source ~= "self" then
				local taken = { part = args.part, cond = 1, hidden = nil, origin = args.source }
				if ctx.takePart then
					taken = ctx.takePart(args.source, args.part, args.uid)
					if not taken then
						return { ok = false, reason = "nothing_to_install", msg = Rules.message("nothing_to_install", ctx.lang) }
					end
				end
				if s.st == "out" then
					result.tray = pushTray(dev, target :: string, s)
				end
				if target == "mobo" then
					-- a new board comes with its own capacitors, socket and clips
					resetBoardFixtures(dev)
				end
				s.part = taken.part
				s.cond = taken.cond or 1
				s.origin = taken.origin or args.source
				if dev.hidden then
					dev.hidden[target :: string] = taken.hidden
				end
				local p = Parts.get(taken.part)
				if p and p.cat == "storage" then
					s.os = "none"
					s.virus = 0
				end
				if p and p.cat == "cpu" then
					dev.paste.st = "none"
					dev.paste.q = 0
				end
				if p and p.cat == "cooler" and (dev.paste.st == "clean" or dev.paste.st == "none") then
					-- new coolers ship with pre-applied paste
					dev.paste.st = "fresh"
					dev.paste.q = 0.8
				end
				if target == "mobo" then
					dev.sw.bios = "ok"
				end
			elseif dev.hidden and dev.hidden[target :: string] == "unseated" then
				-- reseating fixes it
				dev.hidden[target :: string] = nil
			end
			s.st = if Rules.isSoldered(dev, target :: string) then "loose" else "in"
			-- clips snap shut when a module is pressed home
			if tn.cat == "ram" then
				for _, l in tn.latches do
					dev.nodes[l].st = "closed"
				end
			elseif target == "gpu" then
				dev.nodes.pcie_latch.st = "closed"
			end
			result.esd = esdRisk(dev, target :: string, ctx)
		end
	elseif action == "pry" then
		local tn = tnode(dev, target :: string)
		s.st = if tn.id == "bezel" then "out" else "loose"
	elseif action == "peel" then
		s.st = "peeled"
	elseif action == "flip" then
		dev.orient = if dev.orient == "top" then "bottom" else "top"
	elseif action == "lid" then
		dev.lid = if dev.lid == "open" then "closed" else "open"
	elseif action == "clean_paste" then
		dev.paste.st = "clean"
		dev.paste.q = 0
	elseif action == "apply_paste" then
		local amount = math.clamp(tonumber(args.amount) or 0.5, 0, 1)
		local brand = 0.85
		if ctx.usePaste then
			local b = ctx.usePaste()
			if not b then
				return { ok = false, reason = "no_paste_left", msg = Rules.message("no_paste_left", ctx.lang) }
			end
			brand = b
		end
		local lo, hi = Config.PasteIdealRange[1], Config.PasteIdealRange[2]
		local spread
		if amount < lo then
			spread = 1 - (lo - amount) / lo * 1.2
		elseif amount > hi then
			spread = 1 - (amount - hi) / (1 - hi) * 0.6
		else
			spread = 1
		end
		dev.paste.st = "fresh"
		dev.paste.q = math.clamp(spread, 0.15, 1) * brand
		result.quality = dev.paste.q
		result.amount = amount
	elseif action == "blow_dust" or action == "brush" then
		local tool = Tools.get(ctx.tool or "air_can")
		local speed = if tool then tool.speed else 1
		local step = if action == "blow_dust" then 0.36 else 0.24
		s.dust = math.max(0, (s.dust or 0) - step * speed)
		if action == "brush" and target == "lboard" then
			dev.liquid = math.max(0, (dev.liquid or 0) - 0.2)
		end
		result.dust = s.dust
	elseif action == "clean_liquid" then
		local tool = Tools.get(ctx.tool or "isopropyl")
		local speed = if tool then tool.speed else 1
		dev.liquid = math.max(0, (dev.liquid or 0) - 0.45 * speed)
		result.liquid = dev.liquid
	elseif action == "desolder" then
		s.st = "loose"
	elseif action == "solder" then
		if ctx.useSolder and not ctx.useSolder() then
			return { ok = false, reason = "no_solder_left", msg = Rules.message("no_solder_left", ctx.lang) }
		end
		s.st = "in"
	elseif action == "straighten_pins" then
		s.st = "ok"
	elseif action == "wear_strap" then
		dev.strap = args.on == true
	elseif action == "tie_cables" then
		if ctx.useTies and not ctx.useTies(4) then
			return { ok = false, reason = "no_ties_left", msg = Rules.message("no_ties_left", ctx.lang) }
		end
		dev.ties = true
	elseif action == "press_power" then
		dev.tests = (dev.tests or 0) + 1
		result.eval = Rules.evaluate(dev, "post")
	elseif action == "stress" then
		dev.tests = (dev.tests or 0) + 1
		result.eval = Rules.evaluate(dev, "stress")
	elseif action == "software" then
		result.software = Rules.runSoftware(dev, args.program, ctx.lang)
	elseif action == "inspect" then
		result.findings = Rules.inspect(dev, target :: string, ctx.lang)
	elseif action == "measure" then
		result.reading = Rules.measure(dev, target :: string, ctx.lang)
	elseif action == "psu_test" then
		result.reading = Rules.psuTest(dev, ctx.lang)
	elseif action == "post_code" then
		local r = Rules.evaluate(dev, "post")
		result.code = r.code
		result.eval = r
	elseif action == "thermal_view" then
		result.eval = Rules.evaluate(dev, "stress")
	end
	return result
end

----------------------------------------------------------------------------------------------------
-- Power-on simulation
----------------------------------------------------------------------------------------------------
local STAGE_TEXT = {
	ok = { tr = "Sistem sorunsuz açıldı.", en = "The system booted fine." },
	no_power = { tr = "Hiçbir tepki yok: fan dönmüyor, ışık yok.", en = "No response: no fans, no lights." },
	no_post = { tr = "Fanlar dönüyor ama sistem POST'u geçemiyor.", en = "Fans spin but the system won't POST." },
	beeps = { tr = "Uzun bip sesleri: bellek algılanmadı.", en = "Long beeps: no memory detected." },
	no_display = { tr = "Sistem çalışıyor ama görüntü yok.", en = "The system runs but there's no picture." },
	fan_error = { tr = "BIOS uyarısı: CPU Fan Error!", en = "BIOS warning: CPU Fan Error!" },
	no_boot = { tr = "\"Boot device not found\" — önyüklenebilir disk yok.", en = "\"Boot device not found\" — no bootable drive." },
	no_os = { tr = "Disk boş: işletim sistemi kurulu değil.", en = "The drive is empty: no operating system." },
	os_error = { tr = "Windows açılmıyor: Otomatik Onarım döngüsü.", en = "Windows won't start: Automatic Repair loop." },
	overheat = { tr = "Aşırı ısınma! Sistem kendini kapattı.", en = "Overheating! The system shut itself down." },
	unstable = { tr = "Yük altında kararsız: test başarısız.", en = "Unstable under load: test failed." },
}
Rules.StageText = STAGE_TEXT

local ISSUE_TEXT = {
	cmos = { tr = "CMOS checksum hatası, saat sıfırlandı.", en = "CMOS checksum error, clock reset." },
	virus = { tr = "Şüpheli işlemler ve reklam pencereleri var.", en = "Suspicious processes and pop-ups." },
	fan_dead = { tr = "Bir kasa fanı dönmüyor.", en = "A case fan isn't spinning." },
	fan_noise = { tr = "Bir fandan tıkırtı geliyor.", en = "A fan is clicking." },
	fan_unplugged = { tr = "Bir fanın kablosu takılı değil.", en = "A fan isn't plugged in." },
	slow_disk = { tr = "Disk çok yavaş ve hata veriyor.", en = "The drive is very slow and throwing errors." },
	artifacts = { tr = "Ekranda renkli artefaktlar var.", en = "Coloured artefacts on screen." },
	dusty = { tr = "İç kısım hâlâ tozlu.", en = "The inside is still dusty." },
	hot = { tr = "Sıcaklıklar bu donanım için anormal yüksek (throttling).", en = "Temperatures are abnormally high for this hardware (throttling)." },
	battery_worn = { tr = "Batarya sağlığı çok düşük.", en = "Battery health is very low." },
	battery_swollen = { tr = "Batarya şişmiş!", en = "The battery is swollen!" },
	screen_broken = { tr = "Ekran paneli kırık / görüntü yok.", en = "The display is cracked / blank." },
	keyboard = { tr = "Bazı tuşlar çalışmıyor.", en = "Some keys don't work." },
	hinge = { tr = "Menteşe kırık.", en = "The hinge is broken." },
	not_charging = { tr = "Adaptör takılıyken şarj olmuyor.", en = "It doesn't charge from the adapter." },
	wifi = { tr = "Wi-Fi kartı algılanmıyor.", en = "No Wi-Fi card detected." },
	liquid = { tr = "Kartta sıvı kalıntısı ve korozyon var.", en = "Liquid residue and corrosion on the board." },
	low_ram = { tr = "Bellek kapasitesi düştü (bir modül çalışmıyor).", en = "Memory capacity dropped (a module isn't working)." },
}
Rules.IssueText = ISSUE_TEXT

local function inN(dev, id)
	return available(dev, id) and st(dev, id) == "in"
end

local function h(dev, id)
	return dev.hidden and dev.hidden[id]
end

local function driveWorks(dev, id): boolean
	if not inN(dev, id) then
		return false
	end
	if h(dev, id) == "dead" then
		return false
	end
	if dev.kind == "desktop" and (id == "ssd1" or id == "hdd1") then
		if st(dev, "csp_" .. id) ~= "in" or st(dev, "csd_" .. id) ~= "in" then
			return false
		end
	end
	if dev.kind == "laptop" and id == "lsata" and st(dev, "lsata_conn") ~= "in" then
		return false
	end
	return true
end
Rules.driveWorks = driveWorks

function Rules.drives(dev): { string }
	return if dev.kind == "desktop" then DESKTOP_DRIVES else LAPTOP_DRIVES
end

-- Installed RAM in GB counting only working modules (plus soldered laptop memory).
function Rules.ramTotal(dev, workingOnly: boolean?): number
	local total = 0
	local ids = if dev.kind == "desktop" then { "ram1", "ram2", "ram3", "ram4" } else { "lram1", "lram2" }
	for _, id in ids do
		if inN(dev, id) then
			local p = partOf(dev, id)
			if p and (not workingOnly or (h(dev, id) ~= "faulty" and h(dev, id) ~= "dead" and h(dev, id) ~= "unseated")) then
				total += p.size
			end
		end
	end
	if dev.kind == "laptop" then
		local m = Rules.laptopModel(dev)
		total += m and m.soldered or 0
	end
	return total
end

-- CPU temperature model shared by the evaluation and the UI's expected-temperature hint.
function Rules.cpuTemp(power: number, rCooler: number, paste, dust: number, workingFans: number): number
	local rPaste
	if paste.st == "fresh" then
		rPaste = 0.035 + (1 - (paste.q or 0.8)) * 0.1
	elseif paste.st == "old" then
		rPaste = 0.07
	elseif paste.st == "dry" then
		rPaste = 0.45
	else
		rPaste = 0.7
	end
	local t = 30 + power * (rCooler * (1 + dust * 0.9) + rPaste)
	if workingFans == 0 then
		t += 5
	end
	return t
end

local function evaluateDesktop(dev, mode: string)
	local r = { stage = "ok", fans = false, rgb = false, code = "A0", issues = {}, temps = {} }
	local function stop(stage, code)
		r.stage = stage
		r.code = code or r.code
		return r
	end
	local psu, mobo = partOf(dev, "psu"), partOf(dev, "mobo")
	if not inN(dev, "psu") or not inN(dev, "mobo") or not psu or not mobo then
		return stop("no_power", "--")
	end
	if st(dev, "c24") ~= "in" or h(dev, "psu") == "dead" then
		return stop("no_power", "--")
	end
	r.fans = true
	local cpu = partOf(dev, "cpu")
	local gpu = inN(dev, "gpu") and partOf(dev, "gpu") or nil
	r.rgb = (gpu ~= nil and gpu.perf > 40) or (partOf(dev, "ram1") ~= nil and partOf(dev, "ram1").rgb == true)
	if st(dev, "ceps") ~= "in" then
		return stop("no_post", "00")
	end
	if h(dev, "mobo") == "dead" then
		return stop("no_post", "00")
	end
	for i = 1, 6 do
		local cid = "cap" .. i
		if dev.nodes[cid] then
			if st(dev, cid) ~= "in" then
				return stop("no_post", "00")
			end
			if h(dev, cid) == "bulged" and ((dev.tests or 0) % 2 == 1 or mode == "stress") then
				return stop(if mode == "stress" then "unstable" else "no_post", "00")
			end
		end
	end
	if not inN(dev, "cpu") or not cpu or h(dev, "cpu") == "dead" then
		return stop("no_post", "00")
	end
	if st(dev, "cpu_arm") ~= "closed" then
		return stop("no_post", "00")
	end
	if st(dev, "socket") == "bent" then
		return stop("beeps", "55")
	end
	if dev.sw.bios == "old" then
		return stop("no_post", "00")
	end
	-- memory
	local sticks, working = 0, 0
	for i = 1, 4 do
		local id = "ram" .. i
		if inN(dev, id) then
			sticks += 1
			local f = h(dev, id)
			if f == "unseated" or st(dev, id .. "_clip") ~= "closed" then
				return stop("beeps", "55")
			end
			if f ~= "dead" then
				working += 1
			end
		end
	end
	if sticks == 0 or working == 0 then
		return stop("beeps", "55")
	end
	-- cooling (BIOS checks the CPU fan header)
	if not inN(dev, "cooler") then
		r.temps.cpu = 105
		return stop("overheat", "A0")
	end
	if st(dev, "cfan_cpu") ~= "in" or h(dev, "cooler") == "fan_dead" then
		return stop("fan_error", "A0")
	end
	-- video
	if gpu then
		for i = 1, #Parts.gpuConnectors(gpu) do
			if st(dev, "cpcie" .. i) ~= "in" then
				return stop("no_display", "d6")
			end
		end
		if h(dev, "gpu") == "dead" then
			return stop("no_display", "d6")
		end
	elseif not (cpu.igpu and mobo.video) then
		return stop("no_display", "d6")
	end
	-- boot drive
	local boot = dev.boot
	if not boot or not driveWorks(dev, boot) then
		boot = nil
		for _, d in DESKTOP_DRIVES do
			if driveWorks(dev, d) and dev.nodes[d].os and dev.nodes[d].os ~= "none" then
				boot = d
				break
			end
		end
	end
	if not boot then
		local anyDrive = false
		for _, d in DESKTOP_DRIVES do
			if driveWorks(dev, d) then
				anyDrive = true
			end
		end
		return stop(if anyDrive then "no_os" else "no_boot", "A2")
	end
	local bootState = dev.nodes[boot]
	if bootState.os == "corrupt" then
		return stop("os_error", "A0")
	end
	if h(dev, boot) == "failing" then
		table.insert(r.issues, "slow_disk")
	end
	if (bootState.virus or 0) > 0 then
		table.insert(r.issues, "virus")
	end
	r.boot = boot

	-- non-fatal checks
	if not inN(dev, "cmos") or h(dev, "cmos") == "low" then
		table.insert(r.issues, "cmos")
	end
	if working < sticks then
		table.insert(r.issues, "low_ram")
	end
	local workingFans = 0
	for _, fid in FAN_ORDER do
		if inN(dev, fid) then
			local f = h(dev, fid)
			if st(dev, "cfan_" .. fid) ~= "in" then
				table.insert(r.issues, "fan_unplugged")
			elseif f == "dead" then
				table.insert(r.issues, "fan_dead")
			else
				workingFans += 1
				if f == "noisy" then
					table.insert(r.issues, "fan_noise")
				end
			end
		end
	end
	if gpu and h(dev, "gpu") == "artifacts" then
		table.insert(r.issues, "artifacts")
	end
	local dustMax = 0
	for id, s in dev.nodes do
		if s.dust and available(dev, id) and s.st ~= "empty" then
			dustMax = math.max(dustMax, s.dust)
		end
	end
	if dustMax > 0.25 then
		table.insert(r.issues, "dusty")
	end

	-- thermals: temperature rise = power x (cooler resistance + paste resistance)
	local cooler = partOf(dev, "cooler")
	local power = cpu.tdp
	local rCooler = 40 / math.max(cooler and cooler.rating or 60, 1)
	local coolerDust = (dev.nodes.cooler and dev.nodes.cooler.dust) or 0
	local cpuTemp = Rules.cpuTemp(power, rCooler, dev.paste, coolerDust, workingFans)
	local expected = Rules.cpuTemp(power, rCooler, { st = "fresh", q = 0.85 }, 0, math.max(workingFans, 1))
	local gpuTemp, gpuExpected = 0, 0
	if gpu then
		local gpuDust = (dev.nodes.gpu and dev.nodes.gpu.dust) or 0
		gpuTemp = 44 + gpu.tdp * 0.07 + gpuDust * 32
		gpuExpected = 44 + gpu.tdp * 0.07
	end
	if mode ~= "stress" then
		cpuTemp = 30 + (cpuTemp - 30) * 0.45
		expected = 30 + (expected - 30) * 0.45
		gpuTemp = if gpu then 32 + (gpuTemp - 32) * 0.4 else 0
		gpuExpected = if gpu then 32 + (gpuExpected - 32) * 0.4 else 0
	end
	r.temps.cpu = math.floor(cpuTemp + 0.5)
	r.temps.cpuExpected = math.floor(expected + 0.5)
	if gpu then
		r.temps.gpu = math.floor(gpuTemp + 0.5)
	end
	if cpuTemp > 100 or gpuTemp > 95 then
		return stop("overheat", "A0")
	end
	-- a technician notices temperatures far above what this hardware should run at
	if mode == "stress" and (cpuTemp - expected > 15 or (gpu and gpuTemp - gpuExpected > 18)) then
		table.insert(r.issues, "hot")
	end
	if mode == "stress" then
		local draw = Parts.systemDraw(cpu, gpu)
		r.draw = draw
		if h(dev, "psu") == "weak" or psu.watt < draw * 1.05 then
			return stop("unstable", "A0")
		end
		if working < sticks then
			return stop("unstable", "A0")
		end
		if gpu and h(dev, "gpu") == "artifacts" then
			return stop("unstable", "A0")
		end
		if h(dev, boot) == "failing" then
			return stop("unstable", "A0")
		end
		for i = 1, 4 do
			if inN(dev, "ram" .. i) and h(dev, "ram" .. i) == "faulty" then
				return stop("unstable", "A0")
			end
		end
	end
	return r
end

local function evaluateLaptop(dev, mode: string)
	local r = { stage = "ok", fans = false, rgb = false, code = "A0", issues = {}, temps = {} }
	local function stop(stage, code)
		r.stage = stage
		r.code = code or r.code
		return r
	end
	local m = Rules.laptopModel(dev)
	local charger = inN(dev, "dcjack") and h(dev, "dcjack") ~= "dead" and (Rules.isSoldered(dev, "dcjack") or st(dev, "dc_conn") == "in")
	local battery = inN(dev, "battery") and st(dev, "bat_conn") == "in" and h(dev, "battery") ~= "dead"
	if not charger and not battery then
		return stop("no_power", "--")
	end
	if (dev.liquid or 0) > 0.3 then
		return stop("no_power", "--")
	end
	r.fans = inN(dev, "lfan")
	local memory = Rules.ramTotal(dev, false)
	if memory <= 0 then
		return stop("beeps", "55")
	end
	for i = 1, 2 do
		local id = "lram" .. i
		if inN(dev, id) and (h(dev, id) == "unseated" or st(dev, id .. "_clip") ~= "closed") then
			return stop("beeps", "55")
		end
	end
	if not inN(dev, "lfan") then
		r.temps.cpu = 104
		return stop("overheat", "A0")
	end
	if st(dev, "lfan_conn") ~= "in" then
		return stop("fan_error", "A0")
	end
	-- the bench monitor is plugged into HDMI, so a broken panel is an issue, not a blank test
	if not inN(dev, "screen") or st(dev, "edp_conn") ~= "in" or h(dev, "screen") == "cracked" then
		table.insert(r.issues, "screen_broken")
	end
	local boot = dev.boot
	if not boot or not driveWorks(dev, boot) then
		boot = nil
		for _, d in LAPTOP_DRIVES do
			if driveWorks(dev, d) and dev.nodes[d].os and dev.nodes[d].os ~= "none" then
				boot = d
				break
			end
		end
	end
	if not boot then
		local anyDrive = false
		for _, d in LAPTOP_DRIVES do
			if driveWorks(dev, d) then
				anyDrive = true
			end
		end
		return stop(if anyDrive then "no_os" else "no_boot", "A2")
	end
	r.boot = boot
	if dev.nodes[boot].os == "corrupt" then
		return stop("os_error", "A0")
	end
	if h(dev, boot) == "failing" then
		table.insert(r.issues, "slow_disk")
	end
	if (dev.nodes[boot].virus or 0) > 0 then
		table.insert(r.issues, "virus")
	end
	if not inN(dev, "lcmos") or st(dev, "lcmos_conn") ~= "in" or h(dev, "lcmos") == "low" then
		table.insert(r.issues, "cmos")
	end
	local bh = h(dev, "battery")
	if not inN(dev, "battery") or st(dev, "bat_conn") ~= "in" or bh == "worn" or bh == "dead" then
		table.insert(r.issues, "battery_worn")
	elseif bh == "swollen" then
		table.insert(r.issues, "battery_swollen")
	end
	if not charger then
		table.insert(r.issues, "not_charging")
	end
	if not inN(dev, "keyboard") or st(dev, "kb_ribbon") ~= "in" or h(dev, "keyboard") == "dead_keys" then
		table.insert(r.issues, "keyboard")
	end
	if not inN(dev, "hinges") or h(dev, "hinges") == "broken" then
		table.insert(r.issues, "hinge")
	end
	if not inN(dev, "lwifi") or st(dev, "lwifi_ant") ~= "in" or h(dev, "lwifi") == "dead" then
		table.insert(r.issues, "wifi")
	end
	if (dev.liquid or 0) > 0.02 then
		table.insert(r.issues, "liquid")
	end
	if h(dev, "lfan") == "noisy" then
		table.insert(r.issues, "fan_noise")
	end
	local fanDust = (dev.nodes.lfan and dev.nodes.lfan.dust) or 0
	if fanDust > 0.25 then
		table.insert(r.issues, "dusty")
	end
	local gaming = m and (m.class == "gaming15" or m.class == "gaming17")
	local power = if gaming then 95 else 28
	local rCooler = if gaming then 0.42 else 1.1
	local cpuTemp = Rules.cpuTemp(power, rCooler, dev.paste, fanDust, 1)
	local expected = Rules.cpuTemp(power, rCooler, { st = "fresh", q = 0.85 }, 0, 1)
	if mode ~= "stress" then
		cpuTemp = 35 + (cpuTemp - 35) * 0.45
		expected = 35 + (expected - 35) * 0.45
	end
	r.temps.cpu = math.floor(cpuTemp + 0.5)
	r.temps.cpuExpected = math.floor(expected + 0.5)
	if cpuTemp > 100 then
		return stop("overheat", "A0")
	end
	if mode == "stress" and cpuTemp - expected > 12 then
		table.insert(r.issues, "hot")
	end
	if mode == "stress" then
		for i = 1, 2 do
			local id = "lram" .. i
			if inN(dev, id) and h(dev, id) == "faulty" then
				return stop("unstable", "A0")
			end
		end
		if h(dev, boot) == "failing" then
			return stop("unstable", "A0")
		end
	end
	return r
end

-- mode = "post" (power on and boot) or "stress" (full load test)
function Rules.evaluate(dev, mode: string?)
	local m = mode or "post"
	if dev.kind == "desktop" then
		return evaluateDesktop(dev, m)
	end
	return evaluateLaptop(dev, m)
end

----------------------------------------------------------------------------------------------------
-- Assembly / completion
----------------------------------------------------------------------------------------------------
-- Returns ok, list of { id, why } describing what is still open/missing.
function Rules.assembled(dev): (boolean, { { [string]: any } })
	local missing = {}
	local T = tmpl(dev)
	for _, id in T.order do
		local tn = T.nodes[id]
		if available(dev, id) then
			local s = dev.nodes[id]
			if tn.kind == "comp" then
				local mustHave = table.find(T.required, id) ~= nil or (dev.orig and dev.orig[id])
				if s.st == "out" then
					table.insert(missing, { id = id, why = "out" })
				elseif s.st == "loose" then
					table.insert(missing, { id = id, why = if Rules.isSoldered(dev, id) then "solder" else "loose" })
				elseif s.st == "empty" and mustHave then
					table.insert(missing, { id = id, why = "empty" })
				end
			elseif tn.kind == "panel" then
				if s.st ~= "in" then
					table.insert(missing, { id = id, why = "panel" })
				end
			elseif tn.kind == "screw" then
				local os = st(dev, tn.owner)
				if (os == "in") and s.st ~= "in" then
					table.insert(missing, { id = id, why = "screw" })
				end
			elseif tn.kind == "cable" then
				if st(dev, tn.ends[1]) == "in" and st(dev, tn.ends[2]) == "in" and s.st ~= "in" then
					table.insert(missing, { id = id, why = "cable" })
				end
			elseif tn.kind == "latch" then
				if st(dev, tn.owner) == "in" and s.st ~= "closed" then
					table.insert(missing, { id = id, why = "latch" })
				end
			elseif tn.kind == "feet" then
				if s.st ~= "in" then
					table.insert(missing, { id = id, why = "feet" })
				end
			end
		end
	end
	if dev.kind == "desktop" then
		local any = false
		for i = 1, 4 do
			if inN(dev, "ram" .. i) then
				any = true
			end
		end
		if not any then
			table.insert(missing, { id = "ram1", why = "empty" })
		end
	end
	return #missing == 0, missing
end

----------------------------------------------------------------------------------------------------
-- Diagnostics
----------------------------------------------------------------------------------------------------
local function T2(lang, tr, en)
	return if lang == "en" then en else tr
end

function Rules.inspect(dev, target: string, lang: string?): { string }
	local out = {}
	local tn = tnode(dev, target)
	local s = dev.nodes[target]
	if not tn or not s then
		return { T2(lang, "Bakılacak bir şey yok.", "Nothing to look at.") }
	end
	local f = h(dev, target)
	if s.dust and s.dust > 0.15 then
		table.insert(out, T2(lang, string.format("Toz tabakası: %%%d", math.floor(s.dust * 100)), string.format("Dust layer: %d%%", math.floor(s.dust * 100))))
	end
	if target == "mobo" or (tn.parent == "mobo" and tn.solder) then
		for i = 1, 6 do
			if h(dev, "cap" .. i) == "bulged" then
				table.insert(out, T2(lang, "C" .. (40 + i) .. " kondansatörünün tepesi şişmiş ve kahverengi sızıntı var!", "Capacitor C" .. (40 + i) .. " has a bulged top and brown leakage!"))
			end
		end
		if f == "dead" then
			table.insert(out, T2(lang, "VRM bölgesinde küçük bir yanık izi var.", "A small burn mark near the VRM."))
		end
	end
	if target == "socket" then
		if s.st == "bent" then
			table.insert(out, T2(lang, "Soketin ortasında birkaç pin eğilmiş!", "Several pins in the middle of the socket are bent!"))
		elseif st(dev, "cpu") == "in" then
			table.insert(out, T2(lang, "Pinleri görmek için işlemciyi çıkarmalısın.", "Remove the CPU to see the pins."))
		end
	end
	if target == "cpu" or target == "lboard" then
		local covered = (dev.kind == "desktop" and st(dev, "cooler") == "in") or (dev.kind == "laptop" and st(dev, "lfan") == "in")
		if covered then
			table.insert(out, T2(lang, "Termal macunu görmek için soğutucuyu çıkar.", "Remove the cooler to see the paste."))
		else
			local p = dev.paste.st
			if p == "dry" then
				table.insert(out, T2(lang, "Termal macun kurumuş, çatlamış ve tebeşir gibi.", "The paste is dried out, cracked and chalky."))
			elseif p == "old" then
				table.insert(out, T2(lang, "Macun eski ama kullanılabilir.", "The paste is old but usable."))
			elseif p == "none" or p == "clean" then
				table.insert(out, T2(lang, "İşlemcinin üstünde macun yok.", "There's no paste on the CPU."))
			elseif p == "fresh" then
				table.insert(out, T2(lang, "Taze macun sürülmüş.", "Fresh paste applied."))
			end
		end
	end
	if target == "lboard" and (dev.liquid or 0) > 0.02 then
		table.insert(out, T2(lang, "Kartta yapışkan sıvı izi ve yeşil korozyon var.", "Sticky residue and green corrosion on the board."))
	end
	if string.match(target, "ram%d") then
		if f == "unseated" then
			table.insert(out, T2(lang, "Modül yuvaya tam oturmamış, bir ucu havada.", "The module isn't fully seated; one end is raised."))
		elseif f == "faulty" then
			table.insert(out, T2(lang, "Dışarıdan bakınca sağlam görünüyor. Bellek testi yap.", "Looks fine from outside. Run a memory test."))
		end
	end
	if tn.kind == "cable" and s.st == "loose" then
		table.insert(out, T2(lang, "Konnektör yarıya kadar takılı, mandalı oturmamış!", "The plug is only half in; the latch isn't engaged!"))
	end
	if tn.kind == "comp" then
		for _, cid in tn.cables do
			if dev.nodes[cid] and dev.nodes[cid].st == "loose" then
				table.insert(out, T2(lang, label(dev, cid, lang) .. " gevşek görünüyor.", label(dev, cid, lang) .. " looks loose."))
			end
		end
	end
	if target == "gpu" and f == "dead" then
		table.insert(out, T2(lang, "Kartın arka yüzünde bir mosfet kararmış.", "A MOSFET on the back of the card is blackened."))
	elseif target == "gpu" and f == "artifacts" then
		table.insert(out, T2(lang, "Bellek çiplerinin etrafında ısı lekeleri var.", "Heat stains around the memory chips."))
	end
	if target == "psu" and f == "dead" then
		table.insert(out, T2(lang, "PSU'dan hafif yanık kokusu geliyor.", "A faint burnt smell from the PSU."))
	end
	if target == "battery" then
		if f == "swollen" then
			table.insert(out, T2(lang, "Batarya şişmiş! Delmeden, bükmeden çıkar.", "The battery is swollen! Don't puncture or bend it."))
		elseif f == "worn" then
			table.insert(out, T2(lang, "Batarya etiketi 2019 tarihli, çok yaşlı.", "The battery label is dated 2019 — very old."))
		end
	end
	if target == "screen" and f == "cracked" then
		table.insert(out, T2(lang, "Panel köşeden ortaya doğru çatlamış.", "The panel is cracked from the corner inward."))
	end
	if target == "keyboard" and f == "dead_keys" then
		table.insert(out, T2(lang, "Tuşların altında kurumuş şekerli çay var.", "Dried sweet tea under the keys."))
	end
	if target == "hinges" and f == "broken" then
		table.insert(out, T2(lang, "Sol menteşenin bağlantısı kırılmış.", "The left hinge mount has snapped."))
	end
	if target == "dcjack" and f == "dead" then
		table.insert(out, T2(lang, "Soketin içindeki pin kırık ve oynuyor.", "The centre pin inside the jack is broken and loose."))
	end
	if (target == "lfan" or string.match(target, "^fan_")) and f == "noisy" then
		table.insert(out, T2(lang, "Fan pervanesi elle çevirince takılıyor, yatak bitmiş.", "The fan catches when spun by hand; the bearing is worn."))
	end
	if (target == "lfan" or string.match(target, "^fan_")) and f == "dead" then
		table.insert(out, T2(lang, "Fan motoru hiç dönmüyor.", "The fan motor doesn't turn at all."))
	end
	if #out == 0 then
		table.insert(out, T2(lang, "Gözle görülür bir sorun yok.", "Nothing visibly wrong."))
	end
	return out
end

function Rules.measure(dev, target: string, lang: string?): string
	local f = h(dev, target)
	if target == "psu" or target == "c24" then
		local pf = h(dev, "psu")
		if st(dev, "psu") == "empty" then
			return T2(lang, "PSU yok.", "No PSU.")
		end
		if pf == "dead" then
			return "12V: 0.00V • 5V: 0.00V • 3.3V: 0.00V • 5VSB: 0.00V"
		elseif pf == "weak" then
			return T2(lang, "12V: 11.24V (düşük!) • 5V: 4.81V • 3.3V: 3.22V", "12V: 11.24V (low!) • 5V: 4.81V • 3.3V: 3.22V")
		end
		return "12V: 12.06V • 5V: 5.03V • 3.3V: 3.31V • 5VSB: 5.01V"
	elseif target == "cmos" or target == "lcmos" then
		if st(dev, target) == "empty" then
			return T2(lang, "Pil yok.", "No battery.")
		end
		return if f == "low" then T2(lang, "2.31V (düşük — 3V olmalı)", "2.31V (low — should be 3V)") else "3.02V"
	elseif string.match(target, "^cap%d") then
		if st(dev, target) ~= "in" and st(dev, target) ~= "loose" then
			return T2(lang, "Kondansatör yok.", "No capacitor.")
		end
		return if f == "bulged" then T2(lang, "Kapasitans 118µF (470µF olmalı) — ARIZALI", "Capacitance 118µF (should be 470µF) — FAILED") else "466µF"
	elseif target == "battery" then
		if f == "dead" then
			return "0.42V"
		elseif f == "worn" then
			return T2(lang, "10.9V — tasarım kapasitesinin %31'i", "10.9V — 31% of design capacity")
		elseif f == "swollen" then
			return T2(lang, "11.1V — hücreler dengesiz!", "11.1V — cells unbalanced!")
		end
		return "12.4V"
	elseif target == "dcjack" then
		return if f == "dead" then T2(lang, "0.0V (soketten akım geçmiyor)", "0.0V (no current through the jack)") else "19.5V"
	end
	return T2(lang, "Burada ölçülecek anlamlı bir değer yok.", "Nothing meaningful to measure here.")
end

function Rules.psuTest(dev, lang: string?): string
	local f = h(dev, "psu")
	if f == "dead" then
		return T2(lang, "PG: YOK • 12V 0.0 • 5V 0.0 • 3.3V 0.0 — PSU ARIZALI", "PG: NONE • 12V 0.0 • 5V 0.0 • 3.3V 0.0 — PSU FAILED")
	elseif f == "weak" then
		return T2(lang, "PG: 380ms • 12V 11.3 (dalgalı) • 5V 4.8 — ZAYIF", "PG: 380ms • 12V 11.3 (ripple) • 5V 4.8 — WEAK")
	end
	return T2(lang, "PG: 250ms • 12V 12.1 • 5V 5.0 • 3.3V 3.3 — SAĞLAM", "PG: 250ms • 12V 12.1 • 5V 5.0 • 3.3V 3.3 — OK")
end

-- POST code meanings shown next to the 2-digit display
Rules.PostCodes = {
	["--"] = { tr = "Güç yok", en = "No power" },
	["00"] = { tr = "İşlemci / anakart başlatılamadı", en = "CPU / board init failed" },
	["55"] = { tr = "Bellek algılanmadı", en = "Memory not detected" },
	["d6"] = { tr = "Görüntü cihazı yok (VGA)", en = "No console output device (VGA)" },
	["A2"] = { tr = "Önyükleme diski bulunamadı", en = "Boot device not found" },
	["A0"] = { tr = "İşletim sistemine geçildi", en = "Handed over to the OS" },
}

function Rules.runSoftware(dev, program: string, lang: string?): { [string]: any }
	local out = { program = program, ok = true, lines = {} }
	local function line(tr, en)
		table.insert(out.lines, T2(lang, tr, en))
	end
	if program == "memtest" then
		local bad = false
		local ids = if dev.kind == "desktop" then { "ram1", "ram2", "ram3", "ram4" } else { "lram1", "lram2" }
		for i, id in ids do
			if inN(dev, id) then
				if h(dev, id) == "faulty" then
					bad = true
					line(string.format("DIMM %d: 1.204 HATA!", i), string.format("DIMM %d: 1,204 ERRORS!", i))
				else
					line(string.format("DIMM %d: geçti", i), string.format("DIMM %d: pass", i))
				end
			end
		end
		if not bad then
			line("Bellek testi temiz.", "Memory test clean.")
		end
		out.found = bad
	elseif program == "smart" then
		local any = false
		for _, d in Rules.drives(dev) do
			if inN(dev, d) then
				any = true
				local p = partOf(dev, d)
				local name = p and p.name or d
				local f = h(dev, d)
				if f == "failing" then
					line(name .. ": Yeniden atanmış sektör 1832 — DİSK ÖLÜYOR", name .. ": Reallocated sectors 1832 — DRIVE FAILING")
					out.found = true
				elseif f == "dead" then
					line(name .. ": yanıt vermiyor", name .. ": not responding")
					out.found = true
				else
					line(name .. ": Sağlık İyi (%97)", name .. ": Health Good (97%)")
				end
			end
		end
		if not any then
			line("Disk bulunamadı.", "No drives found.")
		end
	elseif program == "antivirus" then
		local boot = dev.boot
		local s = boot and dev.nodes[boot]
		if s and (s.virus or 0) > 0 then
			line(string.format("%d tehdit bulundu ve temizlendi.", s.virus), string.format("%d threats found and removed.", s.virus))
			out.removed = s.virus
			s.virus = 0
			out.found = true
		else
			line("Tehdit bulunamadı.", "No threats found.")
		end
	elseif program == "os_install" then
		-- install onto the fastest healthy drive
		local best, bestSpeed = nil, -1
		for _, d in Rules.drives(dev) do
			if driveWorks(dev, d) and h(dev, d) ~= "failing" then
				local p = partOf(dev, d)
				if p and p.speed > bestSpeed then
					best, bestSpeed = d, p.speed
				end
			end
		end
		if not best then
			out.ok = false
			line("Kurulum için sağlam bir disk yok.", "No healthy drive to install to.")
		else
			dev.nodes[best].os = "ok"
			dev.nodes[best].virus = 0
			dev.boot = best
			out.drive = best
			line("Windows 11 kuruldu, sürücüler yüklendi.", "Windows 11 installed, drivers loaded.")
		end
	elseif program == "bios_update" then
		if dev.sw.bios == "old" then
			dev.sw.bios = "ok"
			line("BIOS Flashback: güncelleme tamam, yeni işlemci destekleniyor.", "BIOS Flashback: update complete, new CPU supported.")
			out.found = true
		else
			line("BIOS zaten güncel.", "BIOS already up to date.")
		end
	elseif program == "battery_report" then
		local f = h(dev, "battery")
		if f == "worn" or f == "dead" then
			line("Batarya sağlığı: %31 — değiştirilmeli.", "Battery health: 31% — replace it.")
			out.found = true
		elseif f == "swollen" then
			line("Batarya hücreleri dengesiz, şişme riski!", "Battery cells unbalanced, swelling risk!")
			out.found = true
		else
			line("Batarya sağlığı: %94", "Battery health: 94%")
		end
	elseif program == "keyboard_test" then
		if h(dev, "keyboard") == "dead_keys" then
			line("Çalışmayan tuşlar: A S D F J K L Ş", "Dead keys: A S D F J K L ;")
			out.found = true
		else
			line("Tüm tuşlar çalışıyor.", "All keys work.")
		end
	else
		out.ok = false
		line("Bilinmeyen program.", "Unknown program.")
	end
	return out
end

----------------------------------------------------------------------------------------------------
-- Client view (no hidden faults)
----------------------------------------------------------------------------------------------------
local function deepCopy(t)
	local c = {}
	for k, v in t do
		c[k] = if type(v) == "table" then deepCopy(v) else v
	end
	return c
end
Rules.deepCopy = deepCopy

function Rules.view(dev)
	local v = {}
	for k, val in dev do
		if k ~= "hidden" and k ~= "faults" and k ~= "requests" then
			v[k] = if type(val) == "table" then deepCopy(val) else val
		end
	end
	if v.tray then
		for _, item in v.tray do
			item.hidden = nil
		end
	end
	-- Visible symptoms the model must render even though the cause is hidden
	v.visible = {}
	if dev.hidden then
		for id, f in dev.hidden do
			if f == "bulged" or f == "cracked" or f == "swollen" or f == "unseated" or f == "broken" or f == "noisy" or f == "dead_keys" then
				v.visible[id] = f
			end
		end
	end
	return v
end

return Rules
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1302">
          <Properties>
            <string name="Name">TechBot</string>
            <string name="Source"><![CDATA[-- TechBot: a technician that repairs a device only through RepairRules.apply, the same way a
-- player does, resolving whatever the rules complain about ("remove the side panel first",
-- "flip the laptop"...). Hired technicians use it on the server (step by step, so their work
-- shows on the bench) and the tests use it to prove every fault can be fixed.
--
-- opts:
--   ctx(action, target)  -> RepairRules ctx (tool, owned, lang, rng, takePart, usePaste...)
--   pickPart(id, filter) -> part id to install into node `id` or nil (default: catalogue)
--   onStep(action, target, result)  called after every successful action (may yield)
--   budget               maximum number of actions (default 3000)

local Shared = script.Parent.Parent
local Parts = require(Shared.Data.Parts)
local Tools = require(Shared.Data.Tools)
local Rules = require(script.Parent.RepairRules)

local TechBot = {}
TechBot.__index = TechBot

local ALL_TOOLS = {}
for _, t in Tools.list do
	ALL_TOOLS[t.id] = true
end

local PREFER = {
	blow_dust = "air_can",
	brush = "brush",
	clean_paste = "isopropyl",
	clean_liquid = "isopropyl",
	apply_paste = "paste_syringe",
	desolder = "soldering_station",
	solder = "soldering_station",
	straighten_pins = "tweezers",
	pry = "spudger_kit",
	peel = "spudger_kit",
	software = "usb_boot",
	measure = "multimeter",
	inspect = "magnifier",
	psu_test = "psu_tester",
	post_code = "post_card",
	wear_strap = "esd_strap",
}

function TechBot.new(dev, opts: { [string]: any }?)
	local self = setmetatable({ dev = dev, opts = opts or {}, log = {}, actions = 0 }, TechBot)
	self.budget = self.opts.budget or 3000
	return self
end

function TechBot.toolFor(dev, action: string, target: string?): string
	if action == "unscrew" or action == "screw" then
		local bit = Rules.screwBit(dev, target :: string)
		if bit == "thumb" or bit == "toolless" then
			return "hand"
		end
		for _, id in { "screwdriver_ph2", "precision_kit", "electric_screwdriver" } do
			if Tools.canDo(id, "unscrew", bit) then
				return id
			end
		end
		return "precision_kit"
	end
	return PREFER[action] or "hand"
end

function TechBot:ctx(action: string, target: string?)
	if self.opts.ctx then
		return self.opts.ctx(action, target, TechBot.toolFor(self.dev, action, target))
	end
	return { tool = TechBot.toolFor(self.dev, action, target), owned = ALL_TOOLS, lang = "en" }
end

function TechBot:try(action: string, target: string?, args)
	-- a professional puts the wrist strap on before touching anything (if the shop has one)
	if not self.strapChecked and action ~= "wear_strap" then
		self.strapChecked = true
		if not self.dev.strap then
			local ctx = self:ctx("wear_strap", nil)
			if ctx.owned and ctx.owned.esd_strap then
				ctx.tool = "esd_strap"
				local res = Rules.apply(self.dev, "wear_strap", nil, { on = true }, ctx)
				table.insert(self.log, "wear_strap -> " .. (if res.ok then "ok" else tostring(res.reason)))
			end
		end
	end
	self.actions += 1
	if self.actions > self.budget then
		error("technician exceeded action budget")
	end
	local res = Rules.apply(self.dev, action, target, args, self:ctx(action, target))
	table.insert(self.log, string.format("%s %s -> %s", action, tostring(target), if res.ok then "ok" else tostring(res.reason)))
	if res.ok and self.opts.onStep then
		self.opts.onStep(action, target, res)
	end
	return res
end

function TechBot:tail(n: number): string
	local out = {}
	for i = math.max(1, #self.log - n), #self.log do
		table.insert(out, "  " .. self.log[i])
	end
	return table.concat(out, "\n")
end

-- Performs action, resolving prerequisites the rules complain about.
function TechBot:ensure(action: string, target: string?, args, depth: number?)
	local d = depth or 0
	if d > 30 then
		error("prerequisite recursion too deep for " .. action .. " " .. tostring(target))
	end
	for _ = 1, 40 do
		local res = self:try(action, target, args)
		if res.ok then
			return res
		end
		if res.reason == "already" or res.reason == "no_dust" or res.reason == "pins_ok" then
			return res
		end
		if not self:resolve(res.reason, res.vars or {}, action, target, d + 1) then
			error(string.format("cannot resolve '%s' while doing %s %s\nlast steps:\n%s", tostring(res.reason), action, tostring(target), self:tail(25)))
		end
	end
	error("gave up on " .. action .. " " .. tostring(target))
end

function TechBot:unscrewAll(owner: string, depth: number?)
	local tn = Rules.tnode(self.dev, owner)
	for _, sid in tn.screws do
		if Rules.available(self.dev, sid) and self.dev.nodes[sid].st == "in" then
			self:ensure("unscrew", sid, nil, depth)
		end
	end
end

function TechBot:resolve(reason: string, vars, _action: string, target: string?, depth: number): boolean
	local dev = self.dev
	if reason == "remove_first" then
		local id = vars.id
		local tn = Rules.tnode(dev, id)
		if tn.pry and dev.nodes[id].st == "in" then
			self:ensure("pry", id, nil, depth)
			if dev.nodes[id].st == "out" then
				return true
			end
		end
		self:ensure("remove", id, nil, depth)
		return true
	elseif reason == "unscrew_first" then
		self:unscrewAll(vars.id or target, depth)
		return true
	elseif reason == "unplug_first" then
		self:ensure("unplug", vars.id, nil, depth)
		return true
	elseif reason == "open_latch_first" then
		self:ensure("open_latch", vars.id, nil, depth)
		return true
	elseif reason == "peel_first" then
		self:ensure("peel", "feet", nil, depth)
		return true
	elseif reason == "pry_first" then
		self:ensure("pry", target, nil, depth)
		return true
	elseif reason == "desolder_first" then
		self:ensure("desolder", target, nil, depth)
		return true
	elseif reason == "board_out_first" then
		self:ensure("remove", "mobo", nil, depth)
		return true
	elseif reason == "cooler_off_first" then
		self:ensure("remove", "cooler", nil, depth)
		return true
	elseif reason == "cpu_out_first" then
		self:ensure("remove", "cpu", nil, depth)
		return true
	elseif reason == "flip_bottom" or reason == "flip_top" then
		if dev.lid == "open" then
			self:ensure("lid", nil, nil, depth)
		end
		self:ensure("flip", nil, nil, depth)
		return true
	elseif reason == "lid_open" or reason == "lid_closed" then
		if reason == "lid_open" and dev.orient ~= "top" then
			self:ensure("flip", nil, nil, depth)
		end
		self:ensure("lid", nil, nil, depth)
		return true
	elseif reason == "clean_paste_first" then
		self:ensure("clean_paste", target, nil, depth)
		return true
	elseif reason == "children_attached" then
		self:ensure("remove", vars.id, nil, depth)
		return true
	elseif reason == "need_parent" then
		local id = vars.id
		if dev.nodes[id].st == "out" then
			self:ensure("install", id, { source = "self" }, depth)
			return true
		end
		return false
	elseif reason == "solder_first" then
		self:ensure("solder", target, nil, depth)
		return true
	elseif reason == "ends_missing" then
		local tn = Rules.tnode(dev, target :: string)
		for _, e in tn.ends do
			if dev.nodes[e].st == "out" then
				self:ensure("install", e, { source = "self" }, depth)
			end
		end
		return true
	end
	return false
end

-- Cheapest compatible catalogue part (rotating through the cheap ones for variety).
function TechBot:catalogPart(id: string, filter): string?
	local tn = Rules.tnode(self.dev, id)
	local cands = {}
	for _, p in Parts.byCat[tn.cat] or {} do
		if Rules.compatible(self.dev, id, p, "en") and (not filter or filter(p)) then
			table.insert(cands, p)
		end
	end
	if #cands == 0 then
		return nil
	end
	table.sort(cands, function(a, b)
		return a.price < b.price
	end)
	return cands[math.min(#cands, 1 + (self.actions % math.min(#cands, 3)))].id
end

function TechBot:partFor(id: string, filter): string
	local pid = if self.opts.pickPart then self.opts.pickPart(id, filter) else self:catalogPart(id, filter)
	if not pid then
		local tn = Rules.tnode(self.dev, id)
		error({ needPart = tn.cat, node = id })
	end
	return pid
end

function TechBot:replace(id: string, filter)
	local dev = self.dev
	local pid = self:partFor(id, filter)
	if dev.nodes[id].st == "in" or dev.nodes[id].st == "loose" then
		local tn = Rules.tnode(dev, id)
		if Rules.isSoldered(dev, id) and dev.nodes[id].st == "in" then
			self:ensure("desolder", id)
		end
		if tn.pry and dev.nodes[id].st == "in" then
			self:ensure("pry", id)
		end
		self:ensure("remove", id)
	end
	self:ensure("install", id, { source = "inv", part = pid })
	return pid
end

function TechBot:repaste()
	local dev = self.dev
	local cpuNode = if dev.kind == "desktop" then "cpu" else "lboard"
	if dev.kind == "desktop" then
		if dev.nodes.cooler.st == "in" then
			self:ensure("remove", "cooler")
		end
	elseif dev.nodes.lfan.st == "in" then
		self:ensure("remove", "lfan")
	end
	if dev.paste.st == "dry" or dev.paste.st == "old" or dev.paste.st == "fresh" then
		self:ensure("clean_paste", cpuNode)
	end
	self:ensure("apply_paste", cpuNode, { amount = 0.5 })
end

function TechBot:dustAll()
	local dev = self.dev
	for id, s in dev.nodes do
		if s.dust and s.dust > 0.02 and id ~= "lboard" and Rules.available(dev, id) and s.st ~= "empty" then
			for _ = 1, 8 do
				local r = self:ensure("blow_dust", id)
				if not r.ok or (s.dust or 0) <= 0.02 then
					break
				end
			end
		end
	end
end

-- Puts everything back together until RepairRules.assembled() is happy.
function TechBot:reassemble()
	local dev = self.dev
	for _ = 1, 400 do
		local ok, missing = Rules.assembled(dev)
		if ok then
			return true
		end
		table.sort(missing, function(a, b)
			local pa = (a.why == "panel" or a.why == "feet") and 1 or 0
			local pb = (b.why == "panel" or b.why == "feet") and 1 or 0
			return pa < pb
		end)
		local m = missing[1]
		local id = m.id
		if m.why == "out" then
			if (id == "cooler" or id == "lfan") and dev.paste.st ~= "fresh" then
				local cpuNode = if id == "cooler" then "cpu" else "lboard"
				if dev.paste.st == "dry" or dev.paste.st == "old" then
					self:ensure("clean_paste", cpuNode)
				end
				self:ensure("apply_paste", cpuNode, { amount = 0.5 })
			end
			self:ensure("install", id, { source = "self" })
		elseif m.why == "loose" then
			self:ensure("install", id, { source = "self" })
		elseif m.why == "solder" then
			self:ensure("solder", id)
		elseif m.why == "empty" then
			self:ensure("install", id, { source = "inv", part = self:partFor(id) })
		elseif m.why == "panel" or m.why == "feet" then
			self:ensure("install", id)
		elseif m.why == "screw" then
			self:ensure("screw", id)
		elseif m.why == "cable" then
			self:ensure("plug", id)
		elseif m.why == "latch" then
			self:ensure("close_latch", id)
		else
			error("unknown missing reason " .. tostring(m.why))
		end
	end
	error("reassembly did not converge:\n" .. self:tail(30))
end

local function hiddenNode(dev, prefixes: { string }): string?
	for id in dev.hidden or {} do
		for _, pre in prefixes do
			if string.sub(id, 1, #pre) == pre then
				return id
			end
		end
	end
	return nil
end

-- The repair procedure for each fault (uses the server-side hidden fault map).
function TechBot:fix(faultId: string)
	local dev = self.dev
	if faultId == "psu_dead" or faultId == "psu_weak" then
		local draw = Parts.systemDraw(Rules.part(dev, "cpu"), Rules.part(dev, "gpu"))
		self:replace("psu", function(p)
			return p.watt >= draw * 1.3 and p.quality >= 0.8
		end)
	elseif faultId == "gpu_dead" or faultId == "gpu_artifacts" then
		local old = Rules.part(dev, "gpu")
		self:replace("gpu", function(p)
			return not old or (p.perf >= old.perf * 0.8 and p.tdp <= old.tdp * 1.2)
		end)
	elseif faultId == "ram_faulty" then
		local id = hiddenNode(dev, { "ram", "lram" })
		if id then
			local old = Rules.part(dev, id)
			self:replace(id, function(p)
				return not old or p.size >= old.size
			end)
		end
	elseif faultId == "ram_unseated" then
		local id = hiddenNode(dev, { "ram" })
		if id then
			self:ensure("remove", id)
			self:ensure("install", id, { source = "self" })
		end
	elseif faultId == "cpu_paste" or faultId == "no_paste" or faultId == "lap_overheat" then
		self:repaste()
		if faultId == "lap_overheat" then
			self:dustAll()
		end
	elseif faultId == "dust" then
		self:dustAll()
	elseif faultId == "fan_dead" or faultId == "fan_noisy" then
		local id = hiddenNode(dev, { "fan_", "cooler" })
		if id == "cooler" then
			local cpu = Rules.part(dev, "cpu")
			self:replace("cooler", function(p)
				return p.rating >= (cpu and cpu.tdp or 65)
			end)
		elseif id then
			self:replace(id)
		end
	elseif faultId == "hdd_failing" or faultId == "ssd_dead" then
		local boot = dev.boot
		self:replace(boot, function(p)
			return p.kind == "ssd25" or p.kind == "nvme" or Rules.tnode(dev, boot).kinds[1] == p.kind
		end)
		self:reassemble()
		self:ensure("software", nil, { program = "os_install" })
	elseif faultId == "os_corrupt" then
		self:reassemble()
		self:ensure("software", nil, { program = "os_install" })
	elseif faultId == "virus" then
		self:reassemble()
		self:ensure("software", nil, { program = "antivirus" })
	elseif faultId == "cmos_low" then
		self:replace(if dev.kind == "desktop" then "cmos" else "lcmos")
	elseif faultId == "bios_outdated" then
		self:ensure("software", nil, { program = "bios_update" })
	elseif faultId == "cap_bulged" then
		local id = hiddenNode(dev, { "cap" })
		if id then
			self:replace(id)
			self:ensure("solder", id)
		end
	elseif faultId == "mobo_dead" then
		local cpu = Rules.part(dev, "cpu")
		local ram = Rules.part(dev, "ram1") or Rules.part(dev, "ram2")
		self:replace("mobo", function(p)
			return p.socket == cpu.socket and (not ram or p.mem == ram.mem) and p.memSlots >= 2
		end)
	elseif faultId == "cpu_dead" then
		local needsIgpu = dev.nodes.gpu.st ~= "in"
		local old = Rules.part(dev, "cpu")
		self:replace("cpu", function(p)
			return (p.igpu or not needsIgpu) and p.tdp <= old.tdp
		end)
	elseif faultId == "bent_pins" then
		self:ensure("straighten_pins", "socket")
	elseif faultId == "cable_loose" then
		if dev.nodes.cpcie1 and dev.nodes.cpcie1.st == "loose" then
			self:ensure("plug", "cpcie1")
		else
			self:ensure("plug", "ceps")
		end
	elseif faultId == "lap_battery_worn" or faultId == "lap_battery_swollen" then
		self:replace("battery")
	elseif faultId == "lap_screen" then
		self:replace("screen")
	elseif faultId == "lap_keyboard" then
		self:ensure("clean_liquid", "lboard")
		self:replace("keyboard")
	elseif faultId == "lap_fan_noisy" then
		self:replace("lfan")
	elseif faultId == "lap_dcjack" then
		self:replace("dcjack")
		if Rules.isSoldered(dev, "dcjack") then
			self:ensure("solder", "dcjack")
		end
	elseif faultId == "lap_hinge" then
		self:replace("hinges")
	elseif faultId == "lap_liquid" then
		for _ = 1, 4 do
			if (dev.liquid or 0) <= 0.02 then
				break
			end
			self:ensure("clean_liquid", "lboard")
		end
	elseif faultId == "lap_wifi" then
		self:replace("lwifi")
	else
		error("bot doesn't know how to fix " .. faultId)
	end
end

-- Completes a customer request (upgrade/maintenance/build).
function TechBot:fulfil(reqId: string, req)
	local dev = self.dev
	if reqId == "upgrade_ram" then
		local ids = if dev.kind == "desktop" then { "ram1", "ram2", "ram3", "ram4" } else { "lram1", "lram2" }
		local need = req and req.ramMin or 16
		local slots = {}
		for _, id in ids do
			if Rules.available(dev, id) then
				table.insert(slots, id)
			end
		end
		local soldered = 0
		if dev.kind == "laptop" then
			local m = Rules.laptopModel(dev)
			soldered = m and m.soldered or 0
		end
		local per = math.max(4, math.ceil((need - soldered) / math.max(1, #slots)))
		for _, id in slots do
			self:replace(id, function(p)
				return p.size >= per
			end)
		end
	elseif reqId == "upgrade_ssd" then
		local slot = if dev.kind == "desktop" then (if Rules.available(dev, "nvme1") then "nvme1" else "ssd1") else "lnvme"
		if dev.nodes[slot].st == "in" then
			slot = if dev.kind == "desktop" then "ssd1" else "lnvme"
		end
		self:replace(slot, function(p)
			return p.kind == "nvme" or p.kind == "ssd25"
		end)
		self:reassemble()
		self:ensure("software", nil, { program = "os_install" })
	elseif reqId == "upgrade_gpu" then
		self:replace("gpu", function(p)
			return p.perf >= (req and req.gpuMin or 0) and not p.workstation
		end)
		local cpu, gpu = Rules.part(dev, "cpu"), Rules.part(dev, "gpu")
		local psu = Rules.part(dev, "psu")
		if psu and psu.watt < Parts.systemDraw(cpu, gpu) * 1.1 then
			self:replace("psu", function(p)
				return p.watt >= Parts.systemDraw(cpu, gpu) * 1.3
			end)
		end
	elseif reqId == "maintenance" then
		self:dustAll()
		self:repaste()
	elseif reqId == "build" then
		self:build(req or {})
	else
		error("bot can't do request " .. reqId)
	end
end

-- Builds a PC from parts into an empty case to the customer's specification: the cheapest
-- CPU and GPU that reach the targets, a board for the CPU that fits the case, two sticks of RAM,
-- a cooler and PSU with headroom and an NVMe drive with Windows on it.
function TechBot:build(req)
	local dev = self.dev
	-- the CPU decides the platform (from the shelf, or what the manager orders)
	local cpuId = self:partFor("cpu", function(p)
		return p.perf >= (req.cpuMin or 0) and p.tdp <= 170 and p.socket ~= "sTR5" and (p.igpu or req.gpuMin ~= nil)
	end)
	local cpu = Parts.get(cpuId) :: any
	if dev.nodes.side_panel and dev.nodes.side_panel.st == "in" then
		self:ensure("remove", "side_panel")
	end
	local mobo = self:partFor("mobo", function(p)
		return p.socket == cpu.socket and p.memSlots >= 2
	end)
	self:ensure("install", "mobo", { source = "inv", part = mobo })
	-- a fresh board needs its BIOS battery
	if dev.nodes.cmos and dev.nodes.cmos.st ~= "in" then
		self:replace("cmos")
	end
	self:ensure("open_latch", "cpu_arm")
	self:ensure("install", "cpu", { source = "inv", part = cpuId })
	self:ensure("close_latch", "cpu_arm")
	self:ensure("apply_paste", "cpu", { amount = 0.5 })
	self:replace("cooler", function(p)
		return p.rating >= cpu.tdp
	end)
	local board = Rules.part(dev, "mobo")
	local slots = if board and board.memSlots >= 4 then { "ram2", "ram4" } else { "ram1", "ram2" }
	local per = math.max(8, math.ceil((req.ramMin or 16) / 2))
	local stick = self:partFor(slots[1], function(p)
		return p.size >= per
	end)
	for _, slot in slots do
		self:ensure("install", slot, { source = "inv", part = stick })
	end
	if req.gpuMin then
		self:replace("gpu", function(p)
			return p.perf >= req.gpuMin and not p.workstation
		end)
	end
	local draw = Parts.systemDraw(cpu, Rules.part(dev, "gpu"))
	self:replace("psu", function(p)
		return p.watt >= draw * 1.3
	end)
	self:replace("nvme1", function(p)
		return p.kind == "nvme" and p.size >= 500
	end)
	self:reassemble()
	self:ensure("software", nil, { program = "os_install" })
end

return TechBot
]]></string>
