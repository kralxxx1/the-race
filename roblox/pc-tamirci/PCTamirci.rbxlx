      <Item class="Script" referent="1313">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- PC Tamircisi Simülatörü — server entry point.
-- Builds the city (or reuses a baked copy), then starts every service in dependency order.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local CityLayout = require(Shared.World.CityLayout)

local Server = script.Parent
local WorldBuilder = require(Server.World.WorldBuilder)
local Services = Server.Services

Net.init()

local world = WorldBuilder.build()
print(string.format("[PC Tamircisi] city ready (%s, %.1fs)", if world:GetAttribute("Reused") then "baked" else "built", world:GetAttribute("BuildSeconds") or 0))

local DataService = require(Services.DataService)
local PlotService = require(Services.PlotService)
local NpcService = require(Services.NpcService)
local RepairService = require(Services.RepairService)
local CustomerService = require(Services.CustomerService)
local MarketService = require(Services.MarketService)
local EmployeeService = require(Services.EmployeeService)
local ThiefService = require(Services.ThiefService)
local VehicleService = require(Services.VehicleService)
local TimeService = require(Services.TimeService)
local ContractService = require(Services.ContractService)
local ShowcaseService = require(Services.ShowcaseService)
local QuestService = require(Services.QuestService)

local order = { DataService, PlotService, NpcService, RepairService, QuestService, CustomerService, MarketService, EmployeeService, ThiefService, VehicleService, ContractService, ShowcaseService, TimeService }
for _, s in order do
	s.init()
end
for _, s in order do
	s.start()
end

TimeService.newDay:Connect(function()
	EmployeeService.payday()
end)

----------------------------------------------------------------------------------------------------
-- Getting around: your shop on first spawn, taxi rides and "back to my shop"
----------------------------------------------------------------------------------------------------
local lastHome: { [Player]: number } = {}

local function moveTo(player: Player, cf: CFrame)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not char or not hum then
		return false
	end
	if hum.SeatPart then
		hum.Sit = false
		task.wait(0.15)
	end
	char:PivotTo(cf + Vector3.new(0, 3.5, 0))
	return true
end

local function shopDoor(player: Player): CFrame?
	local shop = PlotService.shopOf(player)
	local outside = shop and shop.points and shop.points:FindFirstChild("Outside")
	if outside then
		local door = shop.points:FindFirstChild("Door")
		return CFrame.lookAt(outside.Position, if door then door.Position else outside.Position + Vector3.new(0, 0, 1))
	end
	return nil
end

-- the first time a player's shop appears, bring them to it
local welcomed: { [Player]: boolean } = {}
PlotService.built:Connect(function(player)
	if welcomed[player] then
		return
	end
	welcomed[player] = true
	task.spawn(function()
		local char = player.Character
		for _ = 1, 100 do
			if char or not player.Parent then
				break
			end
			task.wait(0.1)
			char = player.Character
		end
		if not char then
			return
		end
		char:WaitForChild("HumanoidRootPart", 10)
		task.wait(0.5)
		local cf = shopDoor(player)
		if cf then
			moveTo(player, cf)
		end
	end)
end)
Players.PlayerAdded:Connect(function(player)
	player.CharacterAdded:Connect(function(char)
		-- respawns put you back at the shop
		if welcomed[player] then
			task.defer(function()
				char:WaitForChild("HumanoidRootPart", 10)
				local cf = shopDoor(player)
				if cf then
					moveTo(player, cf)
				end
			end)
		end
	end)
end)
Players.PlayerRemoving:Connect(function(player)
	welcomed[player] = nil
	lastHome[player] = nil
end)

Net.handle("travel.home", function(player)
	if lastHome[player] and os.clock() - lastHome[player] < Config.ShopTeleportCooldown then
		return { ok = false, err = "cooldown", wait = math.ceil(Config.ShopTeleportCooldown - (os.clock() - lastHome[player])) }
	end
	local cf = shopDoor(player)
	if not cf then
		return { ok = false }
	end
	lastHome[player] = os.clock()
	return { ok = moveTo(player, cf) }
end)

-- Taxi: pay by distance, get dropped on the pavement in front of the place.
Net.handle("travel.taxi", function(player, poiId)
	if not Net.V.id(poiId) then
		return { ok = false }
	end
	local poi = CityLayout.get().poiById[poiId]
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not poi or not root then
		return { ok = false }
	end
	local dist = (root.Position - poi.pos).Magnitude
	local fare = math.floor(Config.TaxiBaseFare + dist * Config.TaxiPerStud)
	if not DataService.money(player, -fare, "taxi") then
		return { ok = false, err = "money", fare = fare }
	end
	local road, closest = CityLayout.nearestRoad(poi.pos)
	local drop = poi.pos
	if road and closest then
		local p = Vector3.new(closest.X, CityLayout.WALK_Y, closest.Y)
		local away = (Vector3.new(poi.pos.X, 0, poi.pos.Z) - Vector3.new(p.X, 0, p.Z))
		if away.Magnitude > 1 then
			p += away.Unit * (road.width / 2 + 4)
		end
		drop = p
	end
	moveTo(player, CFrame.lookAt(drop, Vector3.new(poi.pos.X, drop.Y, poi.pos.Z)))
	QuestService.bump(player, "taxi")
	return { ok = true, fare = fare }
end)

print("[PC Tamircisi] server started")
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="1314">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="1315">
          <Properties>
            <string name="Name">ContractService</string>
            <string name="Source"><![CDATA[-- ContractService: bulk work from the internet café and the data centre. A contract is a batch
-- of machines (maintenance, upgrades or repairs) paid per machine as each one is finished, with
-- a bonus when every machine came back working. One contract at a time; the data centre only
-- deals with shops that have the "Corporate Contracts Desk".

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Faults = require(Shared.Data.Faults)
local DeviceGen = require(Shared.Repair.DeviceGen)
local Rules = require(Shared.Repair.RepairRules)
local Market = require(Shared.Economy.Market)
local Rand = require(Shared.Util.Rand)

local DataService = require(script.Parent.DataService)
local RepairService = require(script.Parent.RepairService)
local MarketService = require(script.Parent.MarketService)
local QuestService = require(script.Parent.QuestService)

local ContractService = {}

local V = Net.V
local rng = Random.new()

local function N(tr, en)
	return { tr = tr, en = en }
end

local CLIENTS = {
	internet_cafe = {
		name = N("Pixel İnternet Kafe", "Pixel Internet Café"),
		level = 3,
		offers = {
			{ key = "cafe_care", kind = "maintenance", tiers = { "mid", "high" }, count = { 3, 4 }, pay = 75, bonus = 140, title = N("Oyun bilgisayarlarının bakımı", "Gaming PC maintenance") },
			{ key = "cafe_fix", kind = "repair", tiers = { "budget", "mid" }, count = { 2, 3 }, pay = 125, bonus = 160, title = N("Arızalanan kafe bilgisayarları", "Broken café PCs") },
			{ key = "cafe_ssd", kind = "upgrade_ssd", tiers = { "office", "budget" }, count = { 2, 4 }, pay = 95, bonus = 150, title = N("Eski bilgisayarlara SSD", "SSDs for the old PCs") },
		},
	},
	datacenter = {
		name = N("Bulut Veri Merkezi", "Cloud Data Centre"),
		level = 6,
		item = "contracts",
		offers = {
			{ key = "dc_fix", kind = "repair", tiers = { "workstation", "high" }, count = { 3, 5 }, pay = 290, bonus = 700, title = N("Arızalı iş istasyonları", "Faulty workstations") },
			{ key = "dc_ram", kind = "upgrade_ram", tiers = { "workstation", "high" }, count = { 3, 4 }, pay = 230, bonus = 520, title = N("Bellek yükseltmesi", "Memory upgrades") },
			{ key = "dc_care", kind = "maintenance", tiers = { "workstation", "enthusiast" }, count = { 4, 5 }, pay = 190, bonus = 560, title = N("Sunucu odası bakımı", "Server room maintenance") },
		},
	},
}

local active: { [Player]: { [string]: any } } = {}
local near: { [Player]: { poi: string, t: number } } = {}
local nextId = 0

-- Today's numbers for an offer (the same for everyone on a day).
local function countFor(poi: string, offer): number
	local h = Rand.hash(poi .. offer.key .. Market.day())
	return offer.count[1] + h % (offer.count[2] - offer.count[1] + 1)
end

local function eligible(player: Player, client): (boolean, string?)
	local p = DataService.get(player)
	if not p then
		return false, "bad"
	end
	if p.level < client.level then
		return false, "level"
	end
	if client.item and not p.shop.items[client.item] then
		return false, "contract_desk"
	end
	return true, nil
end

local function payload(player: Player, poi: string)
	local client = CLIENTS[poi]
	local ok, why = eligible(player, client)
	local offers = {}
	for _, o in client.offers do
		table.insert(offers, { key = o.key, kind = o.kind, title = o.title, count = countFor(poi, o), pay = o.pay, bonus = o.bonus })
	end
	local a = active[player]
	return {
		poi = poi,
		name = client.name,
		locked = not ok,
		why = why,
		level = client.level,
		offers = offers,
		active = a and { title = a.title, done = a.done, total = a.total, client = a.name } or nil,
	}
end

-- One machine for the contract: a device of the right tier with the fault or request.
local function machine(offer, level: number)
	for _ = 1, 8 do
		local dev = DeviceGen.desktop(rng, Rand.pick(rng, offer.tiers))
		if offer.kind == "repair" then
			local hasGpu = Rules.part(dev, "gpu") ~= nil
			local pool = Faults.pool("desktop", math.max(level, 4), { hasGpu = hasGpu, hasHdd = false })
			for _ = 1, 10 do
				local f = Rand.weighted(rng, pool)
				if DeviceGen.applyFault(dev, f.id, rng) then
					return { device = dev, faults = { f.id }, kind = "repair" }
				end
			end
		else
			local req = DeviceGen.applyRequest(dev, offer.kind, rng)
			if req then
				return { device = dev, faults = {}, request = req, requestId = offer.kind, kind = if offer.kind == "maintenance" then "maintenance" else "upgrade" }
			end
		end
	end
	return nil
end

local function accept(player: Player, args)
	if not V.tbl(args) or not V.id(args.poi) or not V.id(args.key) then
		return { ok = false, err = "bad" }
	end
	local client = CLIENTS[args.poi]
	local n = near[player]
	if not client or not n or n.poi ~= args.poi or os.clock() - n.t > 600 then
		return { ok = false, err = "far" }
	end
	local ok, why = eligible(player, client)
	if not ok then
		return { ok = false, err = why }
	end
	if active[player] then
		return { ok = false, err = "contract_busy" }
	end
	local offer
	for _, o in client.offers do
		if o.key == args.key then
			offer = o
		end
	end
	if not offer then
		return { ok = false, err = "bad" }
	end
	local count = countFor(args.poi, offer)
	local jobs = 0
	for _ in RepairService.jobs(player) do
		jobs += 1
	end
	if jobs + count > RepairService.MAX_JOBS then
		return { ok = false, err = "jobs_full" }
	end
	nextId += 1
	local c = { id = "C" .. nextId, poi = args.poi, name = client.name, title = offer.title, total = count, done = 0, fixed = 0, pay = offer.pay, bonus = offer.bonus, jobs = {} }
	local p = DataService.get(player)
	local lang = DataService.lang(player)
	for i = 1, count do
		local m = machine(offer, p and p.level or 1)
		if m then
			m.price = offer.pay
			m.text = string.format("%s — %s #%d", if lang == "en" then client.name.en else client.name.tr, if lang == "en" then offer.title.en else offer.title.tr, i)
			m.contract = { id = c.id, name = client.name }
			local job = RepairService.createJob(player, m)
			if job then
				c.jobs[job.id] = true
			end
		end
	end
	c.total = 0
	for _ in c.jobs do
		c.total += 1
	end
	if c.total == 0 then
		return { ok = false, err = "internal" }
	end
	active[player] = c
	return { ok = true, count = c.total }
end

-- A contract machine left the bench: pay for it (if it works) and close the contract when the
-- last one is done.
local function finished(player: Player, job)
	local c = active[player]
	if not job.contract or not c or job.contract.id ~= c.id or not c.jobs[job.id] then
		return
	end
	c.jobs[job.id] = nil
	c.done += 1
	local fixed = job.verdict and job.verdict.fixed
	local p = DataService.get(player)
	if fixed then
		c.fixed += 1
		DataService.money(player, c.pay, "contract")
		QuestService.bump(player, "contract")
		DataService.addXp(player, 22)
		if p then
			p.stats.repairs += 1
		end
	else
		DataService.rep(player, -1.5)
		if p then
			p.stats.failed += 1
		end
	end
	RepairService.removeJob(player, job.id)
	Net.push(player, "toast", { key = if fixed then "contract_machine" else "contract_machine_bad", vars = { n = c.done, m = c.total, price = c.pay } })
	if c.done >= c.total then
		active[player] = nil
		if c.fixed == c.total then
			DataService.money(player, c.bonus, "contract")
			DataService.addXp(player, 80)
			DataService.rep(player, 3)
			Net.push(player, "toast", { key = "contract_done", vars = { bonus = c.bonus } })
		else
			Net.push(player, "toast", { key = "contract_partial", vars = { n = c.fixed, m = c.total } })
		end
	end
end

function ContractService.active(player: Player)
	return active[player]
end

function ContractService.init() end

function ContractService.start()
	MarketService.opened:Connect(function(player, service, poi)
		if service ~= "contracts" or not CLIENTS[poi] then
			return
		end
		near[player] = { poi = poi, t = os.clock() }
		Net.push(player, "contracts.open", payload(player, poi))
	end)
	Net.handle("contracts.accept", accept)
	RepairService.jobFinished:Connect(finished)
	-- a contract job thrown away (e.g. the player sold it) still counts as done, unpaid
	RepairService.jobRemoved:Connect(function(player, id)
		local c = active[player]
		if c and c.jobs[id] then
			c.jobs[id] = nil
			c.done += 1
			if c.done >= c.total then
				active[player] = nil
			end
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		active[player] = nil
		near[player] = nil
	end)
end

return ContractService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1316">
          <Properties>
            <string name="Name">CustomerService</string>
            <string name="Source"><![CDATA[-- CustomerService: people who walk into your shop with a broken device.
--
-- Life of a customer: walks in from the street, queues, explains the problem at the counter and
-- names a price (you accept, haggle or refuse), sits down to wait (nagging if they're the annoying
-- kind) or pops out, comes back to the counter when the job is ready, pays, tips and reviews.
-- Patience runs out if you take too long. Specials: the scammer may bolt with the device without
-- paying (catch him!), the shady seller offers "brand new" parts of dubious origin.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Signal = require(Shared.Util.Signal)
local Rand = require(Shared.Util.Rand)
local Parts = require(Shared.Data.Parts)
local Faults = require(Shared.Data.Faults)
local Customers = require(Shared.Data.Customers)
local Upgrades = require(Shared.Data.Upgrades)
local DeviceGen = require(Shared.Repair.DeviceGen)

local DataService = require(script.Parent.DataService)
local PlotService = require(script.Parent.PlotService)
local RepairService = require(script.Parent.RepairService)
local QuestService = require(script.Parent.QuestService)
local NpcService = require(script.Parent.NpcService)

local CustomerService = {}
CustomerService.atCounter = Signal.new() -- (player, cust) someone is waiting to be served
CustomerService.robbed = Signal.new() -- (player, cust) a scammer ran off

local V = Net.V
local rng = Random.new()
local shops: { [Player]: { [string]: any } } = {}
local byId: { [string]: any } = {}
local total = 0
local nextId = 0

----------------------------------------------------------------------------------------------------
-- helpers
----------------------------------------------------------------------------------------------------
local function shopState(player: Player)
	local s = shops[player]
	if not s then
		s = { list = {}, queue = {}, counter = nil, next = os.clock() + 8 }
		shops[player] = s
	end
	return s
end

local function point(player: Player, name: string): BasePart?
	local shop = PlotService.shopOf(player)
	return shop and shop.points and shop.points:FindFirstChild(name) or nil
end

local function sumItems(player: Player, field: string): number
	local p = DataService.get(player)
	local n = 0
	if p then
		for _, item in Upgrades.items do
			if item[field] and p.shop.items[item.id] then
				n += item[field]
			end
		end
	end
	return n
end

local function line(cust, kind: string, vars: { [string]: any }?): string
	return Customers.line(cust.arch, kind, cust.lang, rng, vars) or ""
end

local function say(cust, kind: string, vars: { [string]: any }?, seconds: number?)
	local text = line(cust, kind, vars)
	if cust.model and cust.model.Parent and #text > 0 then
		NpcService.say(cust.model, text, seconds or 6)
	end
	return text
end

local function money(n: number): string
	return Config.CurrencySymbol .. tostring(math.floor(n + 0.5))
end

-- What a fair technician would charge for this job.
local function fairPrice(job): number
	if job.request then
		if job.requestId == "build" then
			return (job.request.budget or 1500) * 1.12
		elseif job.requestId == "upgrade_gpu" then
			return (job.request.budget or 400) + Config.LaborBase * 1.5
		end
	end
	local total0 = 0
	local diff = 0
	for _, fid in job.faults or {} do
		local f = Faults.get(fid)
		diff = math.max(diff, f and f.difficulty or 1)
		total0 += DeviceGen.partsEstimate(job.device, fid) * Config.PartMarkupFair
	end
	if job.requestId then
		local f = Faults.get(job.requestId)
		diff = math.max(diff, f and f.difficulty or 1)
		if job.requestId == "upgrade_ram" then
			total0 += 40 * Config.PartMarkupFair
		elseif job.requestId == "upgrade_ssd" then
			total0 += 45 * Config.PartMarkupFair
		elseif job.requestId == "maintenance" then
			total0 += 8
		end
	end
	return total0 + Config.LaborBase * (0.8 + diff * 0.6)
end

local function complaint(cust, job): string
	if job.requestId then
		local f = Faults.get(job.requestId)
		local list = f and f.symptoms and (if cust.lang == "en" then f.symptoms.en else f.symptoms.tr) or {}
		local s = list[rng:NextInteger(1, math.max(1, #list))] or ""
		local r = job.request or {}
		s = string.gsub(s, "{(%w+)}", function(k)
			if k == "budget" then
				return money(r.budget or 0)
			elseif k == "target" then
				return tostring(r.ramMin or 16)
			end
			return ""
		end)
		return s
	end
	local parts = {}
	for _, fid in job.faults or {} do
		local f = Faults.get(fid)
		local list = f and f.symptoms and (if cust.lang == "en" then f.symptoms.en else f.symptoms.tr) or {}
		if #list > 0 then
			table.insert(parts, list[rng:NextInteger(1, #list)])
		end
	end
	return table.concat(parts, " ")
end

----------------------------------------------------------------------------------------------------
-- spawning and movement
----------------------------------------------------------------------------------------------------
local function pickArchetype(level: number)
	local pool = {}
	for _, a in Customers.archetypes do
		if (a.level or 1) <= level then
			table.insert(pool, a)
		end
	end
	return Rand.weighted(rng, pool)
end

local function patienceSeconds(cust, player: Player): number
	local r = Config.CustomerPatienceMinutes
	local base = Rand.range(rng, r[1], r[2]) * 60 * (cust.arch.patience or 1)
	local comfort = sumItems(player, "comfort")
	return base * (1 + comfort / 120)
end

local function removeCustomer(cust)
	if cust.gone then
		return
	end
	cust.gone = true
	local s = shops[cust.owner]
	if s then
		local i = table.find(s.list, cust)
		if i then
			table.remove(s.list, i)
		end
		local q = table.find(s.queue, cust)
		if q then
			table.remove(s.queue, q)
		end
		if s.counter == cust then
			s.counter = nil
		end
	end
	byId[cust.id] = nil
	total -= 1
	if cust.model then
		NpcService.despawn(cust.model)
		cust.model = nil
	end
end

local function leave(cust, run: boolean?)
	if cust.gone then
		return
	end
	cust.state = "leave"
	if cust.prompt then
		cust.prompt:Destroy()
		cust.prompt = nil
	end
	local s = shops[cust.owner]
	if s then
		local q = table.find(s.queue, cust)
		if q then
			table.remove(s.queue, q)
		end
		if s.counter == cust then
			s.counter = nil
		end
	end
	task.spawn(function()
		if cust.model and cust.model.Parent then
			local door, outside, street = point(cust.owner, "Door"), point(cust.owner, "Outside"), point(cust.owner, "Street")
			local path = {}
			for _, p in { door, outside, street } do
				if p then
					table.insert(path, p)
				end
			end
			if street then
				table.insert(path, street.Position + street.CFrame.RightVector * Rand.range(rng, -40, 40))
			end
			NpcService.walkPath(cust.model, path, run)
		end
		removeCustomer(cust)
	end)
end
CustomerService.leave = leave

-- Moves everyone in the queue to their slot; the head steps up to a free counter.
local function advance(player: Player)
	local s = shops[player]
	if not s then
		return
	end
	if not s.counter and #s.queue > 0 then
		local head = table.remove(s.queue, 1)
		s.counter = head
		head.state = "counter"
		task.spawn(function()
			local cf = point(player, "CounterFront")
			if cf and head.model then
				NpcService.walkTo(head.model, cf.Position)
				local back = point(player, "CounterBack")
				if back then
					NpcService.face(head.model, back.Position)
				end
			end
			if head.state == "counter" and not head.gone then
				head.counterSince = os.clock()
				CustomerService.enablePrompt(head)
				say(head, "greet", nil, 7)
				CustomerService.atCounter:Fire(player, head)
			end
		end)
	end
	for i, c in s.queue do
		local q = point(player, "Queue_" .. i) or point(player, "Queue_1")
		if q and c.model and c.slot ~= i then
			c.slot = i
			task.spawn(NpcService.walkTo, c.model, q.Position)
		end
	end
end

local function spawnCustomer(player: Player)
	local p = DataService.get(player)
	local shop = PlotService.shopOf(player)
	if not p or not shop then
		return
	end
	local s = shopState(player)
	local arch = pickArchetype(p.level)
	nextId += 1
	local name, gender = Customers.randomName(rng, arch.id == "tourist")
	local cust = {
		id = "C" .. nextId,
		owner = player,
		arch = arch,
		name = name,
		gender = gender,
		lang = DataService.lang(player),
		state = "arrive",
		rounds = 0,
	}
	-- the device and what's wrong with it are decided now
	if arch.special ~= "stolen_offer" then
		local profile = {
			laptopChance = arch.device and arch.device.laptopChance,
			tiers = arch.device and arch.device.tiers,
			classes = arch.device and arch.device.classes,
			extraFaultChance = arch.extraFaultChance,
			builds = arch.id == "gamer_teen" or arch.id == "streamer" or arch.id == "rich" or arch.id == "esports",
		}
		local ok, job = pcall(DeviceGen.forJob, rng, profile, p.level)
		if not ok or not job then
			return
		end
		cust.jobData = job
		cust.fair = fairPrice(job)
		cust.offer = math.max(20, math.floor(cust.fair * (arch.budget or 1) * Rand.range(rng, 0.85, 1.05)))
		cust.max = math.floor(cust.fair * (arch.budget or 1) * (1.08 + (1 - (arch.haggle or 0.5)) * 0.25))
		cust.text = complaint(cust, job)
	end
	local street = point(player, "Street")
	if not street then
		return
	end
	local side = if rng:NextNumber() < 0.5 then -1 else 1
	local start = street.CFrame * CFrame.new(side * Rand.range(rng, 30, 60), 3, 0)
	cust.model = NpcService.spawn({ look = arch.look, gender = gender, name = name, cf = start, tag = "Customer", speed = if arch.id == "hurry" then 14 else Rand.range(rng, 8.5, 11) })
	cust.model:SetAttribute("CustomerId", cust.id)
	cust.model:SetAttribute("Shop", player.UserId)
	NpcService.tag(cust.model, name)
	byId[cust.id] = cust
	table.insert(s.list, cust)
	total += 1
	cust.patienceEnd = os.clock() + patienceSeconds(cust, player) * 0.6
	task.spawn(function()
		local path = {}
		for _, n in { "Street", "Outside", "Door" } do
			local pt = point(player, n)
			if pt then
				table.insert(path, pt)
			end
		end
		NpcService.walkPath(cust.model, path)
		if cust.gone then
			return
		end
		cust.state = "queue"
		table.insert(s.queue, cust)
		advance(player)
	end)
end

----------------------------------------------------------------------------------------------------
-- talking
----------------------------------------------------------------------------------------------------
function CustomerService.enablePrompt(cust)
	if cust.prompt or not cust.model then
		return
	end
	local root = cust.model.PrimaryPart
	if not root then
		return
	end
	local pp = Instance.new("ProximityPrompt")
	pp.Name = "TalkPrompt"
	pp.ActionText = if cust.lang == "en" then "Talk" else "Konuş"
	pp.ObjectText = cust.name
	pp.KeyboardKeyCode = Enum.KeyCode.E
	pp.MaxActivationDistance = 11
	pp.RequiresLineOfSight = false
	pp:SetAttribute("Customer", cust.id)
	pp.Parent = root
	cust.prompt = pp
end

local function offerPayload(cust)
	local job = cust.jobData
	return {
		id = cust.id,
		name = cust.name,
		arch = cust.arch.id,
		archName = cust.arch.name,
		kind = if cust.arch.special == "stolen_offer" then "sell" else "repair",
		text = cust.text,
		device = job and DeviceGen.name(job.device) or nil,
		deviceKind = job and job.device.kind or nil,
		requestId = job and job.requestId or nil,
		offer = cust.offer,
		rounds = Config.MaxHaggleRounds - cust.rounds,
		tools = (function()
			local t = {}
			for _, fid in job and job.faults or {} do
				local f = Faults.get(fid)
				for _, tool in f and f.tools or {} do
					if not table.find(t, tool) then
						table.insert(t, tool)
					end
				end
			end
			return t
		end)(),
		sale = cust.sale,
	}
end

-- The shady seller's "deal": a high-end part far below its price.
local function makeSale(cust)
	local cats = { "gpu", "cpu", "ram", "storage" }
	local list = Parts.byCat[Rand.pick(rng, cats)]
	local good = {}
	for _, p in list do
		if p.price >= 150 and not p.workstation then
			table.insert(good, p)
		end
	end
	local part = Rand.pick(rng, good)
	cust.sale = { part = part.id, name = part.name, price = math.floor(part.price * Rand.range(rng, 0.22, 0.4)), retail = part.price }
	cust.offer = cust.sale.price
	cust.text = if cust.lang == "en" then string.format("Psst... brand new %s, no box. %s, today only.", part.name, money(cust.sale.price)) else string.format("Abi bak, sıfır %s, kutusu yok. %s, sadece bugün.", part.name, money(cust.sale.price))
end

local function accept(player: Player, cust, price: number)
	local job = cust.jobData
	local created = RepairService.createJob(player, {
		device = job.device,
		faults = job.faults,
		request = job.request,
		requestId = job.requestId,
		kind = job.kind,
		price = price,
		text = cust.text,
		customer = { name = cust.name, arch = cust.arch.id, id = cust.id },
	})
	if not created then
		Net.push(player, "toast", { key = "jobs_full" })
		return false
	end
	cust.job = created.id
	cust.price = price
	cust.state = "waiting"
	cust.waitStart = os.clock()
	cust.patienceEnd = os.clock() + patienceSeconds(cust, player)
	if cust.prompt then
		cust.prompt:Destroy()
		cust.prompt = nil
	end
	local p = DataService.get(player)
	if p then
		p.stats.customers += 1
	end
	say(cust, "accept", nil, 5)
	local s = shops[player]
	if s and s.counter == cust then
		s.counter = nil
	end
	advance(player)
	-- find a seat, or step out and come back later
	task.spawn(function()
		task.wait(1.5)
		local shop = PlotService.shopOf(player)
		local seated = false
		if shop and cust.model then
			for i = 1, 20 do
				local sp = point(player, "Seat_" .. i)
				if not sp then
					break
				end
				local seat = nil
				for _, d in shop.model:GetDescendants() do
					if d:IsA("Seat") and d.Name == "Seat" and not d.Occupant and (d.Position - sp.Position).Magnitude < 3 then
						seat = d
						break
					end
				end
				if seat and not seat:GetAttribute("Reserved") then
					seat:SetAttribute("Reserved", true)
					cust.seat = seat
					NpcService.walkTo(cust.model, sp.Position)
					seated = NpcService.sit(cust.model, seat)
					break
				end
			end
		end
		if not seated and not cust.gone then
			-- no free seat: step out and come back for the pickup
			say(cust, "waiting", nil, 4)
			cust.away = true
			task.wait(1)
			local path = {}
			for _, n in { "Door", "Outside", "Street" } do
				local pt = point(player, n)
				if pt then
					table.insert(path, pt)
				end
			end
			if cust.model then
				NpcService.walkPath(cust.model, path)
			end
			if cust.model and cust.state == "waiting" then
				NpcService.despawn(cust.model)
				cust.model = nil
			end
		end
	end)
	return true
end

-- Handles the dialog buttons. action: accept | haggle | reject | buy (shady)
local function reply(player: Player, payload)
	if not V.tbl(payload) or not V.id(payload.id) or not V.id(payload.action) then
		return { ok = false }
	end
	local cust = byId[payload.id]
	if not cust or cust.owner ~= player or cust.state ~= "counter" then
		return { ok = false, err = "gone" }
	end
	local action = payload.action
	if action == "reject" then
		say(cust, "declined", nil, 4)
		leave(cust)
		advance(player)
		return { ok = true, done = true }
	end
	if cust.arch.special == "stolen_offer" then
		if action == "buy" or action == "accept" then
			if not DataService.money(player, -cust.sale.price, "shady") then
				return { ok = false, err = "money" }
			end
			local item = DataService.addPart(player, cust.sale.part, Rand.range(rng, 0.7, 1), "shady", if rng:NextNumber() < 0.35 then true else nil)
			if not item then
				DataService.money(player, cust.sale.price)
				return { ok = false, err = "storage" }
			end
			-- stolen goods: sometimes the police come knocking
			if rng:NextNumber() < 0.3 then
				task.delay(rng:NextInteger(40, 120), function()
					if player.Parent then
						local p = DataService.get(player)
						local fine = math.floor(cust.sale.retail * 0.5)
						if p then
							DataService.takePart(player, item.uid)
							DataService.money(player, -math.min(fine, p.money))
							DataService.rep(player, -6)
							Net.push(player, "toast", { key = "police_fine", vars = { part = cust.sale.name, fine = fine } })
						end
					end
				end)
			end
			say(cust, "happy", nil, 4)
			leave(cust)
			advance(player)
			return { ok = true, done = true }
		end
		return { ok = false }
	end
	if action == "accept" then
		local ok = accept(player, cust, cust.offer)
		return { ok = ok, done = ok }
	elseif action == "haggle" then
		local ask = payload.price
		if not V.num(ask, 1, cust.fair * 10) then
			return { ok = false }
		end
		ask = math.floor(ask)
		if ask <= cust.offer then
			local ok = accept(player, cust, ask)
			return { ok = ok, done = ok }
		end
		cust.rounds += 1
		local chance = 1 - (cust.arch.haggle or 0.5) * (ask - cust.offer) / math.max(1, cust.max - cust.offer)
		if ask <= cust.max and rng:NextNumber() < chance then
			local ok = accept(player, cust, ask)
			return { ok = ok, done = ok, price = ask }
		end
		if cust.rounds >= Config.MaxHaggleRounds or ask > cust.max * 1.6 then
			say(cust, "reject", nil, 5)
			leave(cust)
			advance(player)
			return { ok = true, done = true, walked = true }
		end
		-- counter offer: meet partway
		cust.offer = math.floor(math.min(cust.max, cust.offer + (ask - cust.offer) * Rand.range(rng, 0.25, 0.5)))
		local text = say(cust, "haggle", { price = money(cust.offer) }, 6)
		return { ok = true, counter = cust.offer, text = text, offer = offerPayload(cust) }
	end
	return { ok = false }
end

----------------------------------------------------------------------------------------------------
-- pickup and payment
----------------------------------------------------------------------------------------------------
local function pay(player: Player, cust, job)
	local verdict = job.verdict or RepairService.assess(job)
	local p = DataService.get(player)
	if not p then
		return
	end
	local waited = os.clock() - (cust.waitStart or os.clock())
	local patience = (cust.patienceEnd or os.clock()) - (cust.waitStart or os.clock())
	local harsh = cust.arch.harsh or 0.4
	if verdict.fixed then
		local stars = verdict.stars
		if patience > 0 and waited / patience > 0.7 then
			stars -= 1
		end
		if rng:NextNumber() < harsh * 0.5 then
			stars -= 1
		end
		stars = math.clamp(stars, 1, 5)
		local tip = 0
		if stars >= 4 and rng:NextNumber() < (cust.arch.tip or 0.2) * (1 + sumItems(player, "comfort") / 100) then
			tip = math.floor(job.price * Rand.range(rng, 0.08, 0.22))
		end
		-- the scammer bolts instead of paying, half of the time
		if cust.arch.id == "scammer" and rng:NextNumber() < 0.55 then
			cust.state = "fleeing"
			NpcService.say(cust.model, if cust.lang == "en" then "Thanks! Bye!" else "Sağ ol usta, hadi eyvallah!", 3)
			CustomerService.robbed:Fire(player, cust, job)
			RepairService.removeJob(player, job.id)
			return
		end
		DataService.money(player, job.price + tip, "repair")
		QuestService.bump(player, "deliver")
		local diff = 1
		for _, fid in job.faults or {} do
			local f = Faults.get(fid)
			diff = math.max(diff, f and f.difficulty or 1)
		end
		DataService.addXp(player, 15 + diff * 12 + stars * 3)
		DataService.rep(player, (stars - 2.5) * 1.2)
		p.stats.repairs += 1
		if stars == 5 then
			p.stats.perfect += 1
			QuestService.bump(player, "perfect")
		end
		local text = say(cust, if stars >= 4 then "happy" else "meh", nil, 6)
		if tip > 0 then
			task.delay(2.5, function()
				if cust.model then
					NpcService.say(cust.model, line(cust, "tip"), 4)
				end
			end)
		end
		DataService.review(player, stars, text, cust.name)
		Net.push(player, "paid", { name = cust.name, price = job.price, tip = tip, stars = stars, text = text })
	else
		local text = say(cust, "notFixed", nil, 6)
		DataService.rep(player, -4 * (1 + harsh))
		DataService.review(player, 1, text, cust.name)
		p.stats.failed += 1
		Net.push(player, "paid", { name = cust.name, price = 0, tip = 0, stars = 1, text = text, failed = true, verdict = verdict })
	end
	RepairService.removeJob(player, job.id)
end

local function pickup(player: Player, job)
	local cid = job.customer and job.customer.id
	local cust = cid and byId[cid]
	if not cust or cust.owner ~= player then
		RepairService.removeJob(player, job.id)
		return
	end
	cust.state = "pickup"
	task.spawn(function()
		if not cust.model or not cust.model.Parent then
			-- they stepped out: walk back in from the street
			local street = point(player, "Street")
			if not street then
				return
			end
			cust.model = NpcService.spawn({ look = cust.arch.look, gender = cust.gender, name = cust.name, cf = street.CFrame * CFrame.new(Rand.range(rng, -30, 30), 3, 0), tag = "Customer" })
			cust.model:SetAttribute("CustomerId", cust.id)
			NpcService.tag(cust.model, cust.name)
			NpcService.walkPath(cust.model, { point(player, "Outside"), point(player, "Door") })
		end
		if cust.seat then
			cust.seat:SetAttribute("Reserved", nil)
			cust.seat = nil
		end
		say(cust, "pickup", nil, 3)
		local cf = point(player, "CounterFront")
		if cf and cust.model then
			NpcService.walkTo(cust.model, cf.Position + Vector3.new(rng:NextNumber() * 2 - 1, 0, 0))
		end
		task.wait(1)
		if cust.gone then
			return
		end
		pay(player, cust, job)
		if cust.state == "fleeing" then
			local exit = point(player, "ThiefExit")
			CustomerService.flee(cust, exit)
		else
			task.wait(2)
			leave(cust)
		end
	end)
end

-- A runner heading for the exit; the owner can catch them (handled by ThiefService's prompt).
function CustomerService.flee(cust, exit: BasePart?)
	if not cust.model then
		return
	end
	local hum = cust.model:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.WalkSpeed = 15
	end
	cust.model:SetAttribute("Runner", true)
	cust.model:AddTag("Runner")
	task.spawn(function()
		local path = { point(cust.owner, "Door"), point(cust.owner, "Outside") }
		if exit then
			table.insert(path, exit)
		end
		NpcService.walkPath(cust.model, path, true)
		if not cust.gone and cust.state == "fleeing" then
			if cust.owner.Parent then
				Net.push(cust.owner, "toast", { key = "scammer_escaped", vars = { name = cust.name } })
				DataService.rep(cust.owner, -1)
			end
			removeCustomer(cust)
		end
	end)
end

-- Called when a runner is caught: they pay up (with a little extra for the trouble).
function CustomerService.caught(cust, catcher: Player?)
	if cust.gone or cust.state ~= "fleeing" then
		return false
	end
	cust.state = "caught"
	local player = cust.owner
	local amount = math.floor((cust.price or 50) * 1.25)
	DataService.money(player, amount, "caught")
	DataService.addXp(player, 30)
	local p = DataService.get(player)
	if p then
		p.stats.caught += 1
	end
	QuestService.bump(catcher or player, "catch")
	NpcService.say(cust.model, if cust.lang == "en" then "OK OK! Here's your money!" else "Tamam tamam! Al paranı!", 4)
	Net.push(player, "toast", { key = "caught_scammer", vars = { amount = amount, by = catcher and catcher.DisplayName or "" } })
	task.delay(2.5, function()
		leave(cust)
	end)
	return true
end

function CustomerService.byModel(model: Instance)
	local id = model:GetAttribute("CustomerId")
	return id and byId[id] or nil
end

function CustomerService.get(id: string)
	return byId[id]
end

function CustomerService.ofShop(player: Player)
	return shops[player]
end

-- Lets a receptionist take the counter: accepts jobs the shop can handle.
function CustomerService.autoServe(player: Player, cust): boolean
	if cust.state ~= "counter" then
		return false
	end
	if cust.arch.special == "stolen_offer" then
		say(cust, "declined", nil, 3)
		leave(cust)
		advance(player)
		return true
	end
	local owned = DataService.owned(player)
	for _, fid in cust.jobData.faults or {} do
		local f = Faults.get(fid)
		for _, t in f and f.tools or {} do
			if not owned[t] then
				say(cust, "declined", nil, 3)
				leave(cust)
				advance(player)
				return true
			end
		end
	end
	return accept(player, cust, math.floor((cust.offer + cust.max) / 2))
end

----------------------------------------------------------------------------------------------------
-- lifecycle
----------------------------------------------------------------------------------------------------
local function tick()
	local now = os.clock()
	for player, s in shops do
		local shop = PlotService.shopOf(player)
		local p = DataService.get(player)
		if not shop or not p then
			continue
		end
		-- spawning
		local active = 0
		for _, c in s.list do
			if c.state == "arrive" or c.state == "queue" or c.state == "counter" then
				active += 1
			end
		end
		local lvl = Upgrades.levels[p.shop.level]
		if now >= s.next and active < (lvl and lvl.queue or 2) + 1 and total < Config.MaxCustomersPerServer then
			local attract = sumItems(player, "attract")
			local speed = 1 + attract / 40 + (p.rep - 50) / 100 + (p.shop.level - 1) * 0.08
			local interval = math.max(Config.CustomerSpawnMin, Config.CustomerSpawnBase / math.max(0.3, speed)) * Rand.range(rng, 0.7, 1.3)
			s.next = now + interval
			task.spawn(spawnCustomer, player)
		end
		-- patience, nagging
		for _, c in table.clone(s.list) do
			if c.gone then
				continue
			end
			if (c.state == "queue" or c.state == "counter") and c.patienceEnd and now > c.patienceEnd then
				say(c, "angry", nil, 5)
				DataService.rep(player, -1.5)
				leave(c)
				advance(player)
			elseif c.state == "waiting" then
				local job = c.job and RepairService.job(player, c.job)
				if not job then
					leave(c)
				elseif now > c.patienceEnd and job.status ~= "ready" then
					RepairService.removeJob(player, job.id)
					DataService.rep(player, -5 * (1 + (c.arch.harsh or 0.4)))
					DataService.review(player, 1, line(c, "angry"), c.name)
					Net.push(player, "toast", { key = "customer_left", vars = { name = c.name } })
					if c.seat then
						c.seat:SetAttribute("Reserved", nil)
						c.seat = nil
					end
					if c.model and c.model.Parent then
						say(c, "angry", nil, 5)
						leave(c)
					else
						removeCustomer(c)
					end
				elseif c.model and c.model.Parent then
					local every = c.arch.nag or 55
					if not c.lastNag or now - c.lastNag > every then
						c.lastNag = now + rng:NextNumber() * 10
						if c.arch.nag or rng:NextNumber() < 0.35 then
							say(c, "nag", nil, 5)
						end
					end
				end
			end
		end
	end
end

function CustomerService.init() end

function CustomerService.start()
	game:GetService("ProximityPromptService").PromptTriggered:Connect(function(prompt, player)
		if prompt.Name ~= "TalkPrompt" then
			return
		end
		local cust = byId[prompt:GetAttribute("Customer") or ""]
		if not cust or cust.state ~= "counter" then
			return
		end
		if cust.owner ~= player then
			Net.push(player, "toast", { key = "not_your_customer" })
			return
		end
		if cust.arch.special == "stolen_offer" and not cust.sale then
			makeSale(cust)
		end
		if cust.model then
			local char = player.Character
			local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
			if root then
				NpcService.face(cust.model, root.Position)
			end
		end
		Net.push(player, "customer.talk", offerPayload(cust))
	end)
	Net.handle("customer.reply", reply)

	RepairService.jobFinished:Connect(function(player, job)
		if job.customer then
			task.delay(2, pickup, player, job)
		end
	end)

	PlotService.built:Connect(function(player)
		shopState(player)
	end)
	PlotService.released:Connect(function(player)
		local s = shops[player]
		if s then
			for _, c in table.clone(s.list) do
				removeCustomer(c)
			end
		end
		shops[player] = nil
	end)
	Players.PlayerRemoving:Connect(function(player)
		local s = shops[player]
		if s then
			for _, c in table.clone(s.list) do
				removeCustomer(c)
			end
		end
		shops[player] = nil
	end)

	task.spawn(function()
		while true do
			task.wait(1)
			local ok, err = pcall(tick)
			if not ok then
				warn("[CustomerService] " .. tostring(err))
			end
		end
	end)
end

return CustomerService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1317">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[-- DataService: each player's save (money, XP, tools, parts, shop, staff, vehicles...).
-- Saves through a session-locked DataStore so two servers never overwrite each other; when
-- DataStores aren't available (Studio without API access) it keeps saves in memory instead.

local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Signal = require(Shared.Util.Signal)
local Parts = require(Shared.Data.Parts)
local Upgrades = require(Shared.Data.Upgrades)

local DataService = {}
DataService.loaded = Signal.new() -- (player, profile)
DataService.levelUp = Signal.new() -- (player, level)
DataService.earned = Signal.new() -- (player, amount, reason) for every income

local profiles: { [Player]: { [string]: any } } = {}
local dirty: { [Player]: boolean } = {}
local memory: { [number]: any } = {}
local store: DataStore? = nil
local memoryMode = false

local function deepCopy(t)
	if type(t) ~= "table" then
		return t
	end
	local c = {}
	for k, v in t do
		c[k] = deepCopy(v)
	end
	return c
end
DataService.deepCopy = deepCopy

local function defaults()
	local tools = {}
	for _, id in Config.StartTools do
		tools[id] = true
	end
	local stock = {}
	for id, n in Config.StartInventory do
		local p = Parts.get(id)
		stock[id] = n * (p and p.uses or 1)
	end
	return {
		v = 1,
		money = Config.StartMoney,
		xp = 0,
		level = 1,
		rep = 50,
		reviews = {},
		tools = tools,
		inv = {},
		stock = stock,
		shop = { plot = nil, level = 1, name = nil, wall = "white", floor = "tiles", accent = 1, items = {} },
		staff = {},
		vehicles = {},
		stats = { repairs = 0, earned = 0, perfect = 0, caught = 0, robbed = 0, failed = 0, customers = 0, days = 0 },
		tutorial = 1,
		nextUid = 0,
		last = 0,
		daily = { day = 0, streak = 0 },
		quests = { day = 0, list = {} },
		settings = { music = 0.5, sfx = 0.8 },
	}
end
DataService.defaults = defaults

-- Fills fields added after a save was written.
local function migrate(data)
	local d = defaults()
	for k, v in d do
		if data[k] == nil then
			data[k] = v
		elseif type(v) == "table" and type(data[k]) == "table" and #v == 0 then
			for k2, v2 in v do
				if data[k][k2] == nil then
					data[k][k2] = deepCopy(v2)
				end
			end
		end
	end
	data.v = d.v
	return data
end

local function keyOf(player: Player): string
	return "u_" .. player.UserId
end

----------------------------------------------------------------------------------------------------
-- Load / save
----------------------------------------------------------------------------------------------------
local function loadFromStore(player: Player)
	local key = keyOf(player)
	local result = nil
	for attempt = 1, 6 do
		local locked = false
		local ok, err = pcall(function()
			(store :: DataStore):UpdateAsync(key, function(old)
				if old and old.lock and old.lock.job ~= game.JobId and os.time() - (old.lock.t or 0) < 150 and attempt < 6 then
					locked = true
					return nil
				end
				local data = old or defaults()
				data.lock = { job = game.JobId, t = os.time() }
				result = data
				return data
			end)
		end)
		if ok and not locked and result then
			return result
		end
		if not ok then
			warn("[DataService] load failed for " .. player.Name .. ": " .. tostring(err))
		end
		task.wait(if locked then 5 else 2)
		if not player.Parent then
			return nil
		end
	end
	return result
end

local function saveToStore(player: Player, profile, release: boolean)
	local copy = deepCopy(profile)
	copy.last = os.time()
	copy.lock = if release then nil else { job = game.JobId, t = os.time() }
	if memoryMode or not store then
		memory[player.UserId] = copy
		return true
	end
	local ok, err = pcall(function()
		(store :: DataStore):UpdateAsync(keyOf(player), function(old)
			if old and old.lock and old.lock.job ~= game.JobId then
				return nil -- another server took over; never clobber it
			end
			return copy
		end)
	end)
	if not ok then
		warn("[DataService] save failed for " .. player.Name .. ": " .. tostring(err))
	end
	return ok
end

----------------------------------------------------------------------------------------------------
-- Client snapshot (coalesced to one push per frame)
----------------------------------------------------------------------------------------------------
local function snapshot(profile)
	local s = deepCopy(profile)
	s.lock = nil
	for _, item in s.inv do
		item.hiddenBroken = nil -- the player finds out by testing the part
	end
	s.capacity = DataService.capacityOf(profile)
	s.xpNext = DataService.xpFor(profile.level)
	return s
end

function DataService.touch(player: Player)
	if not profiles[player] or dirty[player] then
		return
	end
	dirty[player] = true
	task.defer(function()
		dirty[player] = nil
		local p = profiles[player]
		if p and player.Parent then
			Net.push(player, "data", snapshot(p))
			local ls = player:FindFirstChild("leaderstats")
			if ls then
				local money = ls:FindFirstChild("Para") :: IntValue
				local level = ls:FindFirstChild("Seviye") :: IntValue
				money.Value = math.floor(p.money)
				level.Value = p.level
			end
		end
	end)
end

local function makeLeaderstats(player: Player, p)
	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	local money = Instance.new("IntValue")
	money.Name = "Para"
	money.Value = math.floor(p.money)
	money.Parent = ls
	local level = Instance.new("IntValue")
	level.Name = "Seviye"
	level.Value = p.level
	level.Parent = ls
	ls.Parent = player
end

local function onJoin(player: Player)
	local data
	if memoryMode then
		data = memory[player.UserId] and deepCopy(memory[player.UserId]) or defaults()
	else
		data = loadFromStore(player)
		if not data then
			if player.Parent then
				player:Kick("Kayıt yüklenemedi, lütfen tekrar gir. / Your save could not be loaded, please rejoin.")
			end
			return
		end
	end
	if not player.Parent then
		return
	end
	data = migrate(data)
	data.lock = nil
	if Config.StudioDebugMoney and game:GetService("RunService"):IsStudio() then
		data.money = math.max(data.money, 1e6)
	end
	profiles[player] = data
	makeLeaderstats(player, data)
	player:SetAttribute("Level", data.level)
	DataService.loaded:Fire(player, data)
	DataService.touch(player)
end

local function onLeave(player: Player)
	local p = profiles[player]
	if p then
		saveToStore(player, p, true)
		profiles[player] = nil
	end
	dirty[player] = nil
end

function DataService.init()
	local ok = pcall(function()
		store = DataStoreService:GetDataStore(Config.DataStoreName)
		-- a cheap read proves API access works
		;(store :: DataStore):GetAsync("__probe")
	end)
	if not ok then
		memoryMode = true
		warn("[DataService] DataStore unavailable (enable Studio API access to save); using memory saves.")
	end
end

function DataService.start()
	Players.PlayerAdded:Connect(onJoin)
	Players.PlayerRemoving:Connect(onLeave)
	-- language, volumes and tutorial progress from the phone
	Net.handle("settings.set", function(player, payload)
		local p = profiles[player]
		if not p or not Net.V.tbl(payload) then
			return { ok = false }
		end
		if payload.lang == "tr" or payload.lang == "en" then
			p.lang = payload.lang
		end
		if Net.V.num(payload.music, 0, 1) then
			p.settings.music = payload.music
		end
		if Net.V.num(payload.sfx, 0, 1) then
			p.settings.sfx = payload.sfx
		end
		if Net.V.int(payload.tutorial, 0, 99) then
			p.tutorial = payload.tutorial
		end
		DataService.touch(player)
		return { ok = true }
	end)
	for _, p in Players:GetPlayers() do
		task.spawn(onJoin, p)
	end
	task.spawn(function()
		while true do
			task.wait(Config.AutosaveSeconds)
			for player, p in profiles do
				task.spawn(saveToStore, player, p, false)
			end
		end
	end)
	game:BindToClose(function()
		local threads = 0
		for player, p in profiles do
			threads += 1
			task.spawn(function()
				saveToStore(player, p, true)
				threads -= 1
			end)
		end
		local t0 = os.clock()
		while threads > 0 and os.clock() - t0 < 25 do
			task.wait(0.2)
		end
	end)
end

----------------------------------------------------------------------------------------------------
-- Accessors used by the other services
----------------------------------------------------------------------------------------------------
function DataService.get(player: Player)
	return profiles[player]
end

function DataService.all()
	return profiles
end

function DataService.isMemoryMode(): boolean
	return memoryMode
end

-- Adds (or with a negative amount, takes) money. Refuses to go below zero.
function DataService.money(player: Player, delta: number, reason: string?): boolean
	local p = profiles[player]
	if not p then
		return false
	end
	if p.money + delta < 0 then
		return false
	end
	p.money = math.floor((p.money + delta) * 100 + 0.5) / 100
	if delta > 0 then
		p.stats.earned += delta
		DataService.earned:Fire(player, delta, reason)
	end
	DataService.touch(player)
	return true
end

function DataService.xpFor(level: number): number
	return math.floor(Config.XpBase * level ^ Config.XpExponent)
end

function DataService.addXp(player: Player, amount: number): number
	local p = profiles[player]
	if not p then
		return 0
	end
	p.xp += math.floor(amount)
	local gained = 0
	while p.level < Config.MaxLevel and p.xp >= DataService.xpFor(p.level) do
		p.xp -= DataService.xpFor(p.level)
		p.level += 1
		gained += 1
		DataService.levelUp:Fire(player, p.level)
	end
	if gained > 0 then
		player:SetAttribute("Level", p.level)
	end
	DataService.touch(player)
	return gained
end

function DataService.rep(player: Player, delta: number)
	local p = profiles[player]
	if p then
		p.rep = math.clamp(p.rep + delta, 0, 100)
		DataService.touch(player)
	end
end

function DataService.review(player: Player, stars: number, text: string, who: string)
	local p = profiles[player]
	if not p then
		return
	end
	table.insert(p.reviews, 1, { s = stars, t = text, w = who, at = os.time() })
	while #p.reviews > Config.ReviewHistory do
		table.remove(p.reviews)
	end
	DataService.touch(player)
end

-- Storage: shop level capacity + shelving upgrades.
function DataService.capacityOf(p): number
	local lvl = Upgrades.levels[p.shop.level] or Upgrades.levels[1]
	local cap = lvl.storage
	for _, item in Upgrades.items do
		if item.storage and p.shop.items[item.id] then
			cap += item.storage
		end
	end
	return cap
end

function DataService.newUid(player: Player): string
	local p = profiles[player]
	p.nextUid += 1
	return "i" .. p.nextUid
end

-- Inventory parts: { uid, part, cond, origin, broken }
function DataService.addPart(player: Player, partId: string, cond: number?, origin: string?, broken: any?): any?
	local p = profiles[player]
	if not p or not Parts.get(partId) then
		return nil
	end
	if #p.inv >= DataService.capacityOf(p) then
		return nil
	end
	local item = { uid = DataService.newUid(player), part = partId, cond = math.clamp(cond or 1, 0, 1), origin = origin or "new", broken = broken }
	table.insert(p.inv, item)
	DataService.touch(player)
	return item
end

function DataService.findPart(player: Player, uid: string): (any?, number?)
	local p = profiles[player]
	if not p then
		return nil, nil
	end
	for i, item in p.inv do
		if item.uid == uid then
			return item, i
		end
	end
	return nil, nil
end

-- Removes a part by uid (or the best-condition one of a part id) and returns it.
function DataService.takePart(player: Player, uid: string?, partId: string?): any?
	local p = profiles[player]
	if not p then
		return nil
	end
	local best, bestI = nil, nil
	for i, item in p.inv do
		if (uid and item.uid == uid) or (not uid and partId and item.part == partId) then
			if uid or not best or (not item.broken and (best.broken or item.cond > best.cond)) then
				best, bestI = item, i
			end
			if uid then
				break
			end
		end
	end
	if not best then
		return nil
	end
	table.remove(p.inv, bestI)
	DataService.touch(player)
	return best
end

-- Consumables (paste, solder, zip ties) are counted in uses.
function DataService.addStock(player: Player, id: string, uses: number)
	local p = profiles[player]
	if p then
		p.stock[id] = (p.stock[id] or 0) + uses
		DataService.touch(player)
	end
end

function DataService.useStock(player: Player, id: string, n: number?): boolean
	local p = profiles[player]
	local need = n or 1
	if not p or (p.stock[id] or 0) < need then
		return false
	end
	p.stock[id] -= need
	if p.stock[id] <= 0 then
		p.stock[id] = nil
	end
	DataService.touch(player)
	return true
end

-- Best thermal paste in stock; returns its quality or nil.
function DataService.usePaste(player: Player): number?
	local p = profiles[player]
	if not p then
		return nil
	end
	local bestId, bestQ = nil, -1
	for id, uses in p.stock do
		local part = Parts.get(id)
		if part and part.paste and uses > 0 and part.paste > bestQ then
			bestId, bestQ = id, part.paste
		end
	end
	if not bestId then
		return nil
	end
	DataService.useStock(player, bestId, 1)
	return bestQ
end

function DataService.ownsTool(player: Player, id: string): boolean
	local p = profiles[player]
	return id == "hand" or (p ~= nil and p.tools[id] == true)
end

function DataService.owned(player: Player): { [string]: boolean }
	local p = profiles[player]
	local t = { hand = true }
	if p then
		for id in p.tools do
			t[id] = true
		end
	end
	return t
end

function DataService.lang(player: Player): string
	local p = profiles[player]
	if p and p.lang then
		return p.lang
	end
	local ok, id = pcall(function()
		return player.LocaleId
	end)
	if ok and type(id) == "string" and string.sub(id, 1, 2) ~= "tr" then
		return "en"
	end
	return "tr"
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1318">
          <Properties>
            <string name="Name">EmployeeService</string>
            <string name="Source"><![CDATA[-- EmployeeService: hiring at the staff agency, wages, and the staff at work in your shop.
--   technician   picks a waiting job, sits at a free bench and repairs it step by step (TechBot);
--                careless ones occasionally leave a mistake the customer will notice
--   receptionist serves customers at the counter when you're busy
--   manager      orders missing parts for the technicians, speeds the team up
--   security     stands by the door and chases thieves (ThiefService asks for guards)
--   cleaner      keeps the place tidy: customers are more patient

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Signal = require(Shared.Util.Signal)
local Parts = require(Shared.Data.Parts)
local Employees = require(Shared.Data.Employees)
local Upgrades = require(Shared.Data.Upgrades)
local Market = require(Shared.Economy.Market)
local Rules = require(Shared.Repair.RepairRules)
local TechBot = require(Shared.Repair.TechBot)

local DataService = require(script.Parent.DataService)
local PlotService = require(script.Parent.PlotService)
local RepairService = require(script.Parent.RepairService)
local CustomerService = require(script.Parent.CustomerService)
local NpcService = require(script.Parent.NpcService)
local MarketService = require(script.Parent.MarketService)

local EmployeeService = {}
EmployeeService.hired = Signal.new()
EmployeeService.stepScale = 1 -- tests run the technicians flat out

local V = Net.V
local rng = Random.new()
-- [player] = { [uid] = { rec, model, busy, job } }
local staff: { [Player]: { [string]: any } } = {}
local candidateSeed: { [Player]: number } = {}

local LOOK = { technician = "technician", receptionist = "receptionist", manager = "manager", security = "guard", cleaner = "cleaner" }

local function rolesOf(player: Player)
	local p = DataService.get(player)
	local count = {}
	for _, e in p and p.staff or {} do
		count[e.role] = (count[e.role] or 0) + 1
	end
	return count
end

function EmployeeService.has(player: Player, role: string): boolean
	return (rolesOf(player)[role] or 0) > 0
end

function EmployeeService.guards(player: Player)
	local out = {}
	for _, s in staff[player] or {} do
		if s.rec.role == "security" and s.model and s.model.Parent then
			table.insert(out, s)
		end
	end
	return out
end

-- Comfort that staff add to the shop (cleaner, tea maker...).
function EmployeeService.comfort(player: Player): number
	local n = 0
	for _, s in staff[player] or {} do
		local t = Employees.traitById[s.rec.trait]
		n += (t and t.comfort or 0) + (if s.rec.role == "cleaner" then 6 else 0)
	end
	return n
end

local function point(player: Player, name: string): BasePart?
	local shop = PlotService.shopOf(player)
	return shop and shop.points and shop.points:FindFirstChild(name) or nil
end

local function spotFor(player: Player, s): BasePart?
	local role = s.rec.role
	if role == "receptionist" then
		return point(player, "CounterBack")
	elseif role == "manager" then
		return point(player, "ManagerSpot")
	elseif role == "security" then
		return point(player, "GuardSpot")
	elseif role == "cleaner" then
		return point(player, "CleanerSpot")
	end
	return point(player, "ManagerSpot") or point(player, "CleanerSpot")
end

local function despawnAll(player: Player)
	for _, s in staff[player] or {} do
		s.stop = true
		if s.model then
			NpcService.despawn(s.model)
			s.model = nil
		end
	end
end

local function spawnStaff(player: Player)
	despawnAll(player)
	local p = DataService.get(player)
	local shop = PlotService.shopOf(player)
	if not p or not shop then
		return
	end
	local list = {}
	staff[player] = list
	for _, rec in p.staff do
		local s = { rec = rec }
		list[rec.uid] = s
		local spot = spotFor(player, s)
		local cf = if spot then spot.CFrame + Vector3.new(0, 3, 0) else shop.info.front * CFrame.new(0, 3, 6)
		s.model = NpcService.spawn({ look = LOOK[rec.role] or "casual", gender = rec.gender, name = rec.name, seed = rec.look, cf = cf, tag = "Staff", speed = 11 })
		s.model:SetAttribute("Staff", rec.role)
		local role = Employees.roles[rec.role]
		NpcService.tag(s.model, (role and role.icon or "") .. " " .. rec.name)
	end
end

----------------------------------------------------------------------------------------------------
-- Technicians
----------------------------------------------------------------------------------------------------
-- A part from the owner's inventory for node `id`; the manager buys one if nothing fits.
local function pickPart(player: Player, dev, id: string, filter, canBuy: boolean): string?
	local p = DataService.get(player)
	if not p then
		return nil
	end
	local tn = Rules.tnode(dev, id)
	local best = nil
	for _, item in p.inv do
		local part = Parts.get(item.part)
		if part and part.cat == tn.cat and not item.broken and Rules.compatible(dev, id, part, "en") and (not filter or filter(part)) then
			if not best or item.cond > best.cond then
				best = item
			end
		end
	end
	if best then
		return best.part
	end
	if not canBuy then
		return nil
	end
	local cheapest, price = nil, math.huge
	for _, part in Parts.byCat[tn.cat] or {} do
		if Rules.compatible(dev, id, part, "en") and (not filter or filter(part)) then
			local pr = Market.price(part)
			if pr < price then
				cheapest, price = part, pr
			end
		end
	end
	if cheapest and DataService.money(player, -math.floor(price * 1.1), "manager_order") then
		DataService.addPart(player, cheapest.id, 1, "new")
		Net.push(player, "toast", { key = "manager_bought", vars = { part = cheapest.name, price = math.floor(price * 1.1) } })
		return cheapest.id
	end
	return nil
end

local function techWork(player: Player, s, bench: number, job)
	local rec = s.rec
	local speed = Employees.speed(rec) * RepairService.workSpeed(player) * (if EmployeeService.has(player, "manager") then 1.1 else 1)
	local stepTime = math.clamp(1.1 / speed, 0.25, 2.2) * EmployeeService.stepScale
	local owned = DataService.owned(player)
	local missingTool = nil
	local bot = TechBot.new(job.device, {
		ctx = function(_, _, tool)
			if not owned[tool] then
				missingTool = tool
			end
			return RepairService.ctx(player, job, tool, owned)
		end,
		pickPart = function(id, filter)
			return pickPart(player, job.device, id, filter, EmployeeService.has(player, "manager"))
		end,
		onStep = function()
			RepairService.publish(player, bench)
			if stepTime > 0 then
				task.wait(stepTime)
			end
			if s.stop or not player.Parent then
				error({ stopped = true })
			end
		end,
	})
	local ok, err = pcall(function()
		for _, fid in job.faults or {} do
			bot:fix(fid)
		end
		if job.requestId then
			bot:fulfil(job.requestId, job.request)
		end
		bot:reassemble()
		-- careless hands: a forgotten fan cable now and then
		if rng:NextNumber() > Employees.success(rec) and job.device.kind == "desktop" then
			for _, id in Rules.FanOrder do
				local c = job.device.nodes["cfan_" .. id]
				if c and c.st == "in" then
					c.st = "out"
					break
				end
			end
		end
		bot:reassemble()
	end)
	if ok then
		local done, info = RepairService.finish(player, job.id)
		if done then
			Net.push(player, "toast", { key = "tech_done", vars = { name = rec.name, job = job.name, fixed = info.verdict.fixed } })
		end
		return
	end
	if type(err) == "table" and err.stopped then
		return
	end
	-- couldn't finish: leave it for the boss
	local reason = "stuck"
	local detail = nil
	if type(err) == "table" and err.needPart then
		reason = "need_part"
		detail = err.needPart
	elseif missingTool then
		reason = "need_tool"
		detail = missingTool
	end
	job.blocked = { reason = reason, detail = detail, by = rec.name, t = os.clock() }
	RepairService.clearBench(player, bench)
	Net.push(player, "toast", { key = "tech_blocked", vars = { name = rec.name, job = job.name, reason = reason, detail = detail or "" } })
end

local function techLoop(player: Player, s)
	while not s.stop and player.Parent do
		task.wait(3 + rng:NextNumber() * 3)
		if s.stop or s.busy then
			continue
		end
		local shop = PlotService.shopOf(player)
		if not shop or not s.model then
			continue
		end
		-- the oldest waiting customer job nobody is stuck on
		local pick = nil
		for _, job in RepairService.jobs(player) do
			local blocked = job.blocked and os.clock() - job.blocked.t < 90
			if job.status == "waiting" and not job.own and not blocked and (not pick or job.created < pick.created) then
				pick = job
			end
		end
		if not pick then
			continue
		end
		local bench = RepairService.freeBench(player)
		if not bench then
			continue
		end
		if not RepairService.load(player, bench, pick.id, s.rec.uid) then
			continue
		end
		s.busy = true
		local benchModel = shop.benches[bench]
		local staffPt = point(player, "Staff_" .. bench)
		if staffPt and s.model then
			NpcService.walkTo(s.model, staffPt.Position)
			local stool = benchModel and benchModel:FindFirstChild("Stool") :: Seat?
			NpcService.sit(s.model, stool)
		end
		techWork(player, s, bench, pick)
		s.busy = false
		if s.model then
			local hum = s.model:FindFirstChildOfClass("Humanoid")
			if hum then
				hum.Sit = false
			end
			local spot = spotFor(player, s)
			if spot then
				NpcService.walkTo(s.model, spot.Position)
			end
		end
	end
end

----------------------------------------------------------------------------------------------------
-- Receptionist
----------------------------------------------------------------------------------------------------
local function ownerNearCounter(player: Player): boolean
	local counter = point(player, "CounterBack")
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not counter or not root then
		return false
	end
	return (root.Position - counter.Position).Magnitude < 14 and RepairService.session(player) == nil
end

----------------------------------------------------------------------------------------------------
-- Network
----------------------------------------------------------------------------------------------------
local function candidates(player: Player)
	local seed = candidateSeed[player] or (Market.day() * 1000 + player.UserId % 997)
	candidateSeed[player] = seed
	return Employees.candidates(seed, 8)
end

local function openAgency(player: Player)
	local p = DataService.get(player)
	local lvl = p and Upgrades.levels[p.shop.level]
	Net.push(player, "staff.open", { candidates = candidates(player), staff = p and p.staff or {}, capacity = lvl and lvl.staff or 1 })
end

local function hire(player: Player, payload)
	local p = DataService.get(player)
	if not p or not V.tbl(payload) or not V.id(payload.uid) then
		return { ok = false }
	end
	local cand = nil
	for _, c in candidates(player) do
		if c.uid == payload.uid then
			cand = c
		end
	end
	if not cand then
		return { ok = false, err = "gone" }
	end
	for _, e in p.staff do
		if e.from == cand.uid then
			return { ok = false, err = "already" }
		end
	end
	local role = Employees.roles[cand.role]
	local lvl = Upgrades.levels[p.shop.level]
	if #p.staff >= lvl.staff then
		return { ok = false, err = "capacity" }
	end
	if p.shop.level < (role.minShop or 1) then
		return { ok = false, err = "shop_level", need = role.minShop }
	end
	if (rolesOf(player)[cand.role] or 0) >= role.max then
		return { ok = false, err = "role_max" }
	end
	if not DataService.money(player, -cand.hireCost, "hire") then
		return { ok = false, err = "money" }
	end
	local rec = table.clone(cand)
	rec.from = cand.uid -- the same candidate can't be hired twice
	rec.uid = cand.uid .. "_" .. tostring(os.time() % 100000)
	table.insert(p.staff, rec)
	DataService.touch(player)
	spawnStaff(player)
	EmployeeService.startWork(player)
	EmployeeService.hired:Fire(player, rec)
	return { ok = true }
end

local function fire(player: Player, payload)
	local p = DataService.get(player)
	if not p or not V.tbl(payload) or not V.id(payload.uid) then
		return { ok = false }
	end
	for i, e in p.staff do
		if e.uid == payload.uid then
			table.remove(p.staff, i)
			DataService.touch(player)
			spawnStaff(player)
			EmployeeService.startWork(player)
			return { ok = true }
		end
	end
	return { ok = false }
end

function EmployeeService.startWork(player: Player)
	for _, s in staff[player] or {} do
		if s.rec.role == "technician" and not s.loop then
			s.loop = true
			task.spawn(techLoop, player, s)
		end
	end
end

-- Pays wages at the end of an in-game day; unpaid staff quit.
function EmployeeService.payday()
	for player, p in DataService.all() do
		local total = 0
		for _, e in p.staff do
			total += e.wage
		end
		if total > 0 then
			if DataService.money(player, -total, "wages") then
				Net.push(player, "toast", { key = "wages_paid", vars = { amount = total } })
			else
				local quitter = table.remove(p.staff)
				DataService.touch(player)
				Net.push(player, "toast", { key = "staff_quit", vars = { name = quitter and quitter.name or "" } })
				spawnStaff(player)
				EmployeeService.startWork(player)
			end
		end
	end
end

-- A shop with a manager keeps working while its owner is away: technicians earn by the hour
-- (up to Config.OfflineEarningsMaxHours), paid out when the owner comes back.
function EmployeeService.offlineEarnings(player: Player, p): number
	local last = p.last or 0
	if last <= 0 then
		return 0
	end
	local hours = math.min(Config.OfflineEarningsMaxHours, (os.time() - last) / 3600)
	if hours < 0.1 then
		return 0
	end
	local manager, perHour = false, 0
	for _, e in p.staff do
		if e.role == "manager" then
			manager = true
		elseif e.role == "technician" then
			perHour += 30 + (e.skill or 1) * 12
		elseif e.role == "receptionist" then
			perHour += 15
		end
	end
	if not manager or perHour <= 0 then
		return 0
	end
	local total = math.floor(perHour * hours)
	DataService.money(player, total, "offline")
	Net.push(player, "toast", { key = "offline_income", vars = { amount = total, hours = string.format("%.1f", hours) } })
	return total
end

function EmployeeService.init() end

function EmployeeService.start()
	DataService.loaded:Connect(function(player, p)
		EmployeeService.offlineEarnings(player, p)
	end)
	PlotService.built:Connect(function(player)
		spawnStaff(player)
		EmployeeService.startWork(player)
	end)
	PlotService.released:Connect(function(player)
		despawnAll(player)
		staff[player] = nil
	end)
	Players.PlayerRemoving:Connect(function(player)
		despawnAll(player)
		staff[player] = nil
		candidateSeed[player] = nil
	end)
	MarketService.opened:Connect(function(player, service)
		if service == "staff" then
			openAgency(player)
		end
	end)
	Net.handle("staff.hire", hire)
	Net.handle("staff.fire", fire)
	Net.handle("staff.refresh", function(player)
		if not DataService.money(player, -50, "refresh") then
			return { ok = false, err = "money" }
		end
		candidateSeed[player] = rng:NextInteger(1, 1e9)
		openAgency(player)
		return { ok = true }
	end)
	-- receptionists take the counter when you're not there
	CustomerService.atCounter:Connect(function(player, cust)
		if not EmployeeService.has(player, "receptionist") then
			return
		end
		task.delay(6, function()
			if cust.state == "counter" and not ownerNearCounter(player) then
				CustomerService.autoServe(player, cust)
			end
		end)
	end)
end

return EmployeeService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1319">
          <Properties>
            <string name="Name">MarketService</string>
            <string name="Source"><![CDATA[-- MarketService: the city's shops. Opens the right UI when a player walks up to a service counter
-- and handles buying/selling: new parts (depot, bazaar), second-hand deals, the scrapyard's junk
-- PCs, tools, consumables and everything for your own shop (levels, items, looks).

local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Signal = require(Shared.Util.Signal)
local Parts = require(Shared.Data.Parts)
local Tools = require(Shared.Data.Tools)
local Upgrades = require(Shared.Data.Upgrades)
local Market = require(Shared.Economy.Market)
local DeviceGen = require(Shared.Repair.DeviceGen)
local Builder = require(Shared.Util.Builder)

local DataService = require(script.Parent.DataService)
local PlotService = require(script.Parent.PlotService)
local RepairService = require(script.Parent.RepairService)
local QuestService = require(script.Parent.QuestService)

local MarketService = {}
MarketService.opened = Signal.new() -- (player, service, poi) for services owned by other modules

local V = Net.V
local rng = Random.new()
local bought: { [string]: boolean } = {} -- used/junk listings sold today (per server)
local nearService: { [Player]: { service: string, poi: string, t: number, pos: Vector3 } } = {}

local OTHER = { cars = true, bikes = true, bicycles = true, staff = true, contracts = true }

-- the player must still be close to the counter they opened
local function at(player: Player, services: { string }): boolean
	local n = nearService[player]
	if not n or not table.find(services, n.service) then
		return false
	end
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	return root ~= nil and (root.Position - n.pos).Magnitude < 60
end

local function openPayload(service: string, poi: string)
	local day = Market.day()
	if service == "parts" or service == "parts_bazaar" then
		return { catalog = Market.catalog(service, day) }
	elseif service == "used" then
		local list = {}
		for _, l in Market.used(poi, day) do
			if not bought[l.id] then
				table.insert(list, l)
			end
		end
		return { listings = list }
	elseif service == "scrap" then
		local list = {}
		for _, j in Market.junk(day) do
			if not bought[j.id] then
				table.insert(list, j)
			end
		end
		return { junk = list }
	elseif service == "tools" then
		return {}
	elseif service == "realty" then
		local free = {}
		for _, plot in require(Shared.World.CityLayout).get().plots do
			if not PlotService.ownerOf(plot.id) then
				table.insert(free, plot.id)
			end
		end
		return { free = free }
	elseif service == "board" then
		return { rows = MarketService.leaders() }
	elseif service == "police" then
		return {}
	end
	return {}
end

-- Everyone on the server, best technicians first.
function MarketService.leaders()
	local rows = {}
	for p, prof in DataService.all() do
		table.insert(rows, { name = p.DisplayName, level = prof.level, money = math.floor(prof.money), rep = math.floor(prof.rep), repairs = prof.stats.repairs })
	end
	table.sort(rows, function(a, b)
		return a.repairs * 10 + a.level > b.repairs * 10 + b.level
	end)
	return rows
end

-- The board in front of city hall shows the server's top technicians.
local function paintBoards()
	local lines = { "<b>🏆 EN İYİ TAMİRCİLER</b>" }
	local rows = MarketService.leaders()
	for i = 1, math.min(8, #rows) do
		local r = rows[i]
		table.insert(lines, string.format("%d. %s  •  Sv.%d  •  %d tamir", i, r.name, r.level, r.repairs))
	end
	if #rows == 0 then
		table.insert(lines, "—")
	end
	local text = table.concat(lines, "\n")
	for _, board in CollectionService:GetTagged("Leaderboard") do
		if board:IsA("BasePart") then
			local gui = board:FindFirstChild("Leaders")
			local existing = gui and gui:FindFirstChild("Text") :: TextLabel?
			local label = existing or Builder.sign(board, Enum.NormalId.Front, "", { name = "Leaders", rich = true, color = Color3.fromRGB(250, 236, 190), background = Color3.fromRGB(24, 28, 38), glow = true, brightness = 1.2, padding = 0.05 })
			label.Text = text
		end
	end
end

MarketService._paintBoards = paintBoards

function MarketService.open(player: Player, service: string, poi: string, pos: Vector3)
	nearService[player] = { service = service, poi = poi, t = os.clock(), pos = pos }
	if OTHER[service] then
		MarketService.opened:Fire(player, service, poi)
		return
	end
	Net.push(player, "service.open", { service = service, poi = poi, data = openPayload(service, poi) })
end

----------------------------------------------------------------------------------------------------
-- Buying parts and consumables
----------------------------------------------------------------------------------------------------
local function buyPart(player: Player, payload)
	if not at(player, { "parts", "parts_bazaar" }) then
		return { ok = false, err = "far" }
	end
	if not V.tbl(payload) or not V.id(payload.id) then
		return { ok = false }
	end
	local qty = if V.int(payload.qty, 1, 20) then payload.qty else 1
	local service = nearService[player].service
	local p = Parts.get(payload.id)
	if not p then
		return { ok = false }
	end
	if service == "parts_bazaar" and (p.cat == "misc" or (p.year or 2030) > 2019) then
		return { ok = false, err = "not_sold_here" }
	end
	if p.cat == "case" and service ~= "parts" then
		return { ok = false }
	end
	local unit = Market.price(p)
	if service == "parts_bazaar" then
		unit = math.max(1, math.floor(unit * 0.72))
	end
	local cost = unit * qty
	local prof = DataService.get(player)
	if not prof or prof.money < cost then
		return { ok = false, err = "money" }
	end
	-- consumables go to stock (counted in uses)
	if p.uses then
		DataService.money(player, -cost, "buy")
		DataService.addStock(player, p.id, p.uses * qty)
		QuestService.bump(player, "buy", qty)
		return { ok = true }
	end
	if p.cat == "case" then
		-- a case starts a build project instead of sitting on a shelf
		DataService.money(player, -cost, "buy")
		local dev = DeviceGen.emptyCase(p.id)
		local job = RepairService.createJob(player, { device = dev, kind = "build", own = true, price = 0, text = p.name })
		if not job then
			DataService.money(player, cost)
			return { ok = false, err = "jobs_full" }
		end
		return { ok = true, job = job.id }
	end
	if #prof.inv + qty > DataService.capacityOf(prof) then
		return { ok = false, err = "storage" }
	end
	DataService.money(player, -cost, "buy")
	QuestService.bump(player, "buy", qty)
	for _ = 1, qty do
		local cond = if service == "parts_bazaar" then math.floor((0.82 + rng:NextNumber() * 0.18) * 100) / 100 else 1
		local broken = if service == "parts_bazaar" and rng:NextNumber() < 0.08 then true else nil
		DataService.addPart(player, p.id, cond, if service == "parts_bazaar" then "bazaar" else "new", broken)
	end
	return { ok = true }
end

local function buyUsed(player: Player, payload)
	if not at(player, { "used" }) or not V.tbl(payload) or not V.id(payload.id) then
		return { ok = false, err = "far" }
	end
	local poi = nearService[player].poi
	local listing = nil
	for _, l in Market.used(poi) do
		if l.id == payload.id then
			listing = l
		end
	end
	if not listing or bought[listing.id] then
		return { ok = false, err = "sold" }
	end
	local prof = DataService.get(player)
	if not prof or prof.money < listing.price then
		return { ok = false, err = "money" }
	end
	if #prof.inv >= DataService.capacityOf(prof) then
		return { ok = false, err = "storage" }
	end
	bought[listing.id] = true
	DataService.money(player, -listing.price, "used")
	QuestService.bump(player, "buy")
	local broken = if rng:NextNumber() * 100 < listing.risk then true else nil
	-- hidden: the player only finds out when testing it
	local item = DataService.addPart(player, listing.part, listing.cond, "used", nil)
	if item and broken then
		item.hiddenBroken = true
	end
	return { ok = true }
end

local function sell(player: Player, payload)
	if not at(player, { "used", "scrap" }) or not V.tbl(payload) or not V.id(payload.uid) then
		return { ok = false, err = "far" }
	end
	local service = nearService[player].service
	local item = DataService.findPart(player, payload.uid)
	if not item then
		return { ok = false }
	end
	local price = if service == "scrap" then Market.scrapPrice(item) else Market.sellPrice(item)
	if service == "used" and item.hiddenBroken then
		-- the dealer tests it: broken goods fetch scrap money
		price = math.max(1, math.floor(price * 0.15))
	end
	DataService.takePart(player, payload.uid)
	DataService.money(player, price, "sell")
	QuestService.bump(player, "sell")
	return { ok = true, price = price }
end

local function buyJunk(player: Player, payload)
	if not at(player, { "scrap" }) or not V.tbl(payload) or not V.id(payload.id) then
		return { ok = false, err = "far" }
	end
	local listing = nil
	for _, j in Market.junk() do
		if j.id == payload.id then
			listing = j
		end
	end
	if not listing or bought[listing.id] then
		return { ok = false, err = "sold" }
	end
	if not DataService.money(player, -listing.price, "junk") then
		return { ok = false, err = "money" }
	end
	bought[listing.id] = true
	QuestService.bump(player, "junk")
	local dev = DeviceGen.junk(Random.new(listing.seed))
	local job = RepairService.createJob(player, { device = dev, kind = "refurb", own = true, price = 0, faults = {}, text = DeviceGen.name(dev) })
	if not job then
		DataService.money(player, listing.price)
		bought[listing.id] = nil
		return { ok = false, err = "jobs_full" }
	end
	return { ok = true, job = job.id }
end

local function buyTool(player: Player, payload)
	if not at(player, { "tools" }) or not V.tbl(payload) or not V.id(payload.id) then
		return { ok = false, err = "far" }
	end
	local tool = Tools.get(payload.id)
	local prof = DataService.get(player)
	if not tool or not prof or prof.tools[tool.id] then
		return { ok = false }
	end
	if prof.level < (tool.level or 1) then
		return { ok = false, err = "level" }
	end
	if not DataService.money(player, -tool.price, "tool") then
		return { ok = false, err = "money" }
	end
	prof.tools[tool.id] = true
	DataService.touch(player)
	return { ok = true }
end

----------------------------------------------------------------------------------------------------
-- Your shop: levels, items, looks (from the estate agent or anywhere with the phone)
----------------------------------------------------------------------------------------------------
local function upgradeShop(player: Player)
	local prof = DataService.get(player)
	if not prof then
		return { ok = false }
	end
	local nextLevel = Upgrades.levels[prof.shop.level + 1]
	if not nextLevel then
		return { ok = false, err = "max" }
	end
	if prof.level < nextLevel.req then
		return { ok = false, err = "level", need = nextLevel.req }
	end
	if not DataService.money(player, -nextLevel.cost, "upgrade") then
		return { ok = false, err = "money" }
	end
	prof.shop.level += 1
	DataService.addXp(player, 60 * prof.shop.level)
	DataService.touch(player)
	PlotService.build(player)
	return { ok = true, level = prof.shop.level }
end

local function buyItem(player: Player, payload)
	if not V.tbl(payload) or not V.id(payload.id) then
		return { ok = false }
	end
	local item = Upgrades.get(payload.id)
	local prof = DataService.get(player)
	if not item or not prof or prof.shop.items[item.id] then
		return { ok = false }
	end
	if prof.level < (item.level or 1) then
		return { ok = false, err = "level" }
	end
	if not DataService.money(player, -item.cost, "item") then
		return { ok = false, err = "money" }
	end
	prof.shop.items[item.id] = true
	DataService.touch(player)
	PlotService.build(player)
	return { ok = true }
end

local function setStyle(player: Player, payload)
	local prof = DataService.get(player)
	if not prof or not V.tbl(payload) then
		return { ok = false }
	end
	local changed = false
	local function valid(list, id)
		for _, s in list do
			if s.id == id then
				return true
			end
		end
		return false
	end
	if payload.wall and V.id(payload.wall) and valid(Upgrades.wallStyles, payload.wall) then
		prof.shop.wall = payload.wall
		changed = true
	end
	if payload.floor and V.id(payload.floor) and valid(Upgrades.floorStyles, payload.floor) then
		prof.shop.floor = payload.floor
		changed = true
	end
	if payload.accent and V.int(payload.accent, 1, #Upgrades.accentColors) then
		prof.shop.accent = payload.accent
		changed = true
	end
	if changed then
		DataService.touch(player)
		PlotService.build(player)
	end
	return { ok = changed }
end

----------------------------------------------------------------------------------------------------
function MarketService.init() end

function MarketService.start()
	ProximityPromptService.PromptTriggered:Connect(function(prompt, player)
		if prompt.Name ~= "ServicePrompt" then
			return
		end
		local anchor = prompt.Parent
		local service = anchor and anchor:GetAttribute("Service")
		local poi = anchor and anchor:GetAttribute("Poi")
		if typeof(service) ~= "string" or typeof(poi) ~= "string" then
			return
		end
		MarketService.open(player, service, poi, (anchor :: BasePart).Position)
	end)
	Net.handle("market.buy", buyPart)
	Net.handle("market.buyUsed", buyUsed)
	Net.handle("market.sell", sell)
	Net.handle("market.buyJunk", buyJunk)
	Net.handle("tools.buy", buyTool)
	Net.handle("shop.upgrade", upgradeShop)
	Net.handle("shop.buyItem", buyItem)
	Net.handle("shop.style", setStyle)
	Net.handle("market.close", function(player)
		nearService[player] = nil
		return { ok = true }
	end)
	Net.handle("daily.claim", function(player)
		local prof = DataService.get(player)
		local day = Market.day()
		if not prof or prof.daily.day == day then
			return { ok = false, err = "claimed" }
		end
		prof.daily.streak = if prof.daily.day == day - 1 then prof.daily.streak + 1 else 1
		prof.daily.day = day
		local reward = 100 + math.min(prof.daily.streak, 7) * 75 + prof.level * 15
		DataService.money(player, reward, "daily")
		DataService.addXp(player, 20 * math.min(prof.daily.streak, 7))
		return { ok = true, reward = reward, streak = prof.daily.streak }
	end)
	Players.PlayerRemoving:Connect(function(player)
		nearService[player] = nil
	end)
	task.spawn(function()
		while true do
			pcall(paintBoards)
			task.wait(20)
		end
	end)
	-- and right away when someone arrives
	DataService.loaded:Connect(function()
		task.defer(pcall, paintBoards)
	end)
	-- forget today's sold listings at midnight
	task.spawn(function()
		local day = Market.day()
		while true do
			task.wait(60)
			if Market.day() ~= day then
				day = Market.day()
				bought = {}
			end
		end
	end)
end

return MarketService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1320">
          <Properties>
            <string name="Name">NpcService</string>
            <string name="Source"><![CDATA[-- NpcService: people in the city — customers, staff, thieves. Builds an R15 body from a base rig,
-- dresses it from a "look" (clothes colours plus hair, hats, glasses, bags made of parts), plays
-- the default R15 animations and shows speech bubbles.

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ServerStorage = game:GetService("ServerStorage")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local B = require(Shared.Util.Builder)
local Rand = require(Shared.Util.Rand)

local NpcService = {}

local ANIMS = {
	idle = "rbxassetid://507766666",
	walk = "rbxassetid://507777826",
	run = "rbxassetid://507767714",
	sit = "rbxassetid://2506281703",
	wave = "rbxassetid://507770239",
	point = "rbxassetid://507770453",
	cheer = "rbxassetid://507770677",
	laugh = "rbxassetid://507770818",
}
NpcService.Anims = ANIMS

local SKIN = {
	{ 255, 224, 196 }, { 241, 194, 160 }, { 224, 172, 130 }, { 198, 140, 98 }, { 160, 108, 72 }, { 120, 80, 52 }, { 92, 60, 40 },
}
local HAIR = { { 20, 18, 16 }, { 60, 40, 26 }, { 110, 70, 40 }, { 180, 140, 90 }, { 220, 190, 130 }, { 140, 50, 30 }, { 200, 200, 200 } }

-- Clothes palette per look: shirt, pants, extras
local LOOKS = {
	student = { shirt = { { 70, 110, 180 }, { 200, 80, 60 }, { 90, 150, 90 }, { 240, 240, 240 } }, pants = { { 40, 60, 110 }, { 30, 30, 36 } }, extras = { "backpack", "cap_back" } },
	gamer = { shirt = { { 30, 30, 34 }, { 120, 40, 200 }, { 20, 160, 120 } }, pants = { { 30, 30, 34 }, { 60, 60, 70 } }, extras = { "headset" } },
	streamer = { shirt = { { 240, 80, 160 }, { 40, 200, 230 }, { 30, 30, 34 } }, pants = { { 30, 30, 34 } }, extras = { "headset", "dyed" } },
	aunt = { shirt = { { 150, 60, 80 }, { 90, 110, 70 }, { 170, 140, 110 } }, pants = { { 70, 50, 60 }, { 60, 60, 70 } }, extras = { "scarf", "handbag" } },
	uncle = { shirt = { { 120, 110, 100 }, { 90, 90, 96 }, { 150, 130, 100 } }, pants = { { 60, 56, 50 }, { 40, 40, 44 } }, extras = { "flatcap", "mustache" } },
	grandpa = { shirt = { { 150, 140, 120 }, { 110, 90, 70 } }, pants = { { 70, 64, 56 } }, extras = { "glasses", "white_hair", "mustache" } },
	business = { shirt = { { 34, 36, 44 }, { 50, 50, 56 } }, pants = { { 30, 32, 40 } }, extras = { "tie", "briefcase" } },
	casual = { shirt = { { 90, 130, 170 }, { 200, 200, 200 }, { 170, 90, 70 }, { 100, 140, 90 } }, pants = { { 50, 70, 120 }, { 40, 40, 44 }, { 110, 100, 80 } }, extras = {} },
	cheap = { shirt = { { 120, 120, 110 }, { 100, 90, 80 } }, pants = { { 70, 70, 66 } }, extras = { "cap" } },
	designer = { shirt = { { 20, 20, 22 } }, pants = { { 26, 26, 30 } }, extras = { "beret", "glasses" } },
	developer = { shirt = { { 80, 84, 92 }, { 40, 70, 60 } }, pants = { { 40, 50, 80 } }, extras = { "glasses", "backpack" } },
	doctor = { shirt = { { 244, 244, 246 } }, pants = { { 70, 110, 140 } }, extras = { "stethoscope" } },
	hurry = { shirt = { { 240, 120, 40 }, { 40, 120, 220 } }, pants = { { 30, 30, 34 } }, extras = { "headband" } },
	influencer = { shirt = { { 250, 170, 200 }, { 250, 250, 250 } }, pants = { { 240, 220, 230 } }, extras = { "sunglasses", "dyed" } },
	kid = { shirt = { { 250, 200, 40 }, { 60, 180, 240 }, { 240, 90, 90 } }, pants = { { 40, 80, 160 } }, extras = { "cap" }, kid = true },
	knowitall = { shirt = { { 160, 140, 90 }, { 90, 110, 130 } }, pants = { { 80, 70, 60 } }, extras = { "glasses" } },
	miner = { shirt = { { 240, 140, 30 } }, pants = { { 50, 50, 56 } }, extras = { "hardhat" } },
	musician = { shirt = { { 30, 30, 32 }, { 110, 30, 30 } }, pants = { { 30, 30, 34 } }, extras = { "guitar", "long_hair" } },
	rich = { shirt = { { 240, 236, 226 }, { 30, 30, 34 } }, pants = { { 240, 236, 226 }, { 30, 30, 34 } }, extras = { "sunglasses", "chain" } },
	shady = { shirt = { { 26, 26, 28 } }, pants = { { 30, 30, 34 } }, extras = { "hood", "sunglasses" } },
	teacher = { shirt = { { 120, 90, 120 }, { 90, 120, 100 } }, pants = { { 60, 60, 70 } }, extras = { "glasses", "book" } },
	tourist = { shirt = { { 250, 150, 60 }, { 60, 200, 200 } }, pants = { { 200, 190, 160 } }, extras = { "sunhat", "camera" } },
	annoying = { shirt = { { 250, 60, 160 }, { 250, 230, 40 } }, pants = { { 120, 40, 200 } }, extras = { "sunglasses_up" } },
	shopkeeper = { shirt = { { 240, 240, 240 } }, pants = { { 40, 40, 44 } }, extras = { "apron" } },
	technician = { shirt = { { 40, 110, 200 } }, pants = { { 36, 40, 50 } }, extras = { "lanyard" } },
	thief = { shirt = { { 30, 30, 34 } }, pants = { { 30, 30, 34 } }, extras = { "beanie", "mask" } },
	guard = { shirt = { { 30, 40, 70 } }, pants = { { 26, 28, 40 } }, extras = { "guardcap" } },
	manager = { shirt = { { 34, 36, 44 } }, pants = { { 30, 32, 40 } }, extras = { "tie" } },
	cleaner = { shirt = { { 90, 160, 120 } }, pants = { { 40, 60, 60 } }, extras = { "apron" } },
	receptionist = { shirt = { { 200, 60, 70 }, { 240, 240, 240 } }, pants = { { 30, 30, 34 } }, extras = { "lanyard" } },
}
NpcService.Looks = LOOKS

local folder: Folder
local baseRigs: { [string]: Model } = {}

local function c3(t): Color3
	return Color3.fromRGB(t[1], t[2], t[3])
end

local function makeBase(kind: string): Model
	local desc = Instance.new("HumanoidDescription")
	if kind == "kid" then
		desc.HeightScale = 0.78
		desc.WidthScale = 0.85
		desc.HeadScale = 1.08
	end
	local ok, rig = pcall(function()
		return Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
	end)
	if not ok or not rig then
		error("could not create NPC rig: " .. tostring(rig))
	end
	rig.Name = "BaseRig_" .. kind
	local animate = rig:FindFirstChild("Animate")
	if animate then
		animate:Destroy()
	end
	rig.Parent = ServerStorage
	return rig
end

local function part(body: BasePart, offset: CFrame, size: Vector3, color: Color3, mat: Enum.Material?, shape: string?): BasePart
	local p
	if shape == "ball" then
		p = B.ball(nil, body.CFrame * offset, size.X, color, mat or Enum.Material.SmoothPlastic)
	elseif shape == "cyl" then
		p = B.cyl(nil, body.CFrame * offset, size.X, size.Y, color, mat or Enum.Material.SmoothPlastic)
	else
		p = B.box(nil, body.CFrame * offset, size, color, mat or Enum.Material.SmoothPlastic)
	end
	p.Anchored = false
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.Massless = true
	p.CastShadow = size.Magnitude > 0.6
	local w = Instance.new("WeldConstraint")
	w.Part0 = body
	w.Part1 = p
	w.Parent = p
	p.Parent = body.Parent
	return p
end

-- Hair and accessories from part shapes, attached to the body.
local function dress(model: Model, extras: { string }, hair: Color3, gender: string, rng: Random)
	local head = model:FindFirstChild("Head") :: BasePart
	local torso = model:FindFirstChild("UpperTorso") :: BasePart
	local rightHand = model:FindFirstChild("RightHand") :: BasePart
	if not head or not torso then
		return
	end
	local hs = head.Size
	local has = {}
	for _, e in extras do
		has[e] = true
	end
	-- hair
	local hood = has.hood or has.scarf
	if not hood and not has.hardhat then
		local hairCol = if has.white_hair then Color3.fromRGB(220, 220, 220) else hair
		if has.dyed then
			hairCol = Rand.pick(rng, { Color3.fromRGB(240, 90, 160), Color3.fromRGB(80, 200, 240), Color3.fromRGB(160, 90, 240) })
		end
		part(head, CFrame.new(0, hs.Y * 0.42, 0.02), Vector3.new(hs.X * 1.06, hs.Y * 0.32, hs.Z * 1.06), hairCol, Enum.Material.SmoothPlastic)
		part(head, CFrame.new(0, hs.Y * 0.1, hs.Z * 0.42), Vector3.new(hs.X * 1.04, hs.Y * 0.6, hs.Z * 0.24), hairCol, Enum.Material.SmoothPlastic)
		if gender == "f" or has.long_hair then
			part(head, CFrame.new(0, -hs.Y * 0.25, hs.Z * 0.48), Vector3.new(hs.X * 1.02, hs.Y * 0.9, hs.Z * 0.2), hairCol, Enum.Material.SmoothPlastic)
			if rng:NextNumber() < 0.35 then
				part(head, CFrame.new(0, hs.Y * 0.45, hs.Z * 0.55), Vector3.new(hs.X * 0.4, hs.Y * 0.4, hs.X * 0.4), hairCol, Enum.Material.SmoothPlastic, "ball")
			end
		end
	end
	local function hat(color: Color3, h: number, brim: boolean, mat: Enum.Material?)
		part(head, CFrame.new(0, hs.Y * 0.5 + h / 2, 0), Vector3.new(hs.X * 1.1, h, hs.Z * 1.1), color, mat)
		if brim then
			part(head, CFrame.new(0, hs.Y * 0.5, -hs.Z * 0.55), Vector3.new(hs.X * 1.05, 0.06, hs.Z * 0.6), color, mat)
		end
	end
	if has.cap or has.cap_back then
		local col = Rand.pick(rng, { Color3.fromRGB(200, 40, 40), Color3.fromRGB(30, 30, 34), Color3.fromRGB(40, 90, 200), Color3.fromRGB(240, 240, 240) })
		part(head, CFrame.new(0, hs.Y * 0.52, 0), Vector3.new(hs.X * 1.08, hs.Y * 0.28, hs.Z * 1.08), col)
		part(head, CFrame.new(0, hs.Y * 0.42, if has.cap_back then hs.Z * 0.75 else -hs.Z * 0.75), Vector3.new(hs.X * 0.9, 0.06, hs.Z * 0.55), col)
	end
	if has.flatcap then
		part(head, CFrame.new(0, hs.Y * 0.5, -hs.Z * 0.1), Vector3.new(hs.X * 1.12, hs.Y * 0.2, hs.Z * 1.3), Color3.fromRGB(80, 70, 60), Enum.Material.Fabric)
	end
	if has.beret then
		part(head, CFrame.new(hs.X * 0.1, hs.Y * 0.55, 0), Vector3.new(hs.X * 1.1, hs.Y * 0.18, hs.Z * 1.1), Color3.fromRGB(20, 20, 22), Enum.Material.Fabric, "cyl")
	end
	if has.hardhat then
		hat(Color3.fromRGB(250, 200, 30), hs.Y * 0.35, true)
	end
	if has.sunhat then
		part(head, CFrame.new(0, hs.Y * 0.52, 0) * CFrame.Angles(0, 0, math.pi / 2), Vector3.new(0.08, hs.X * 2, hs.X * 2), Color3.fromRGB(230, 210, 160), Enum.Material.Fabric, "cyl")
		part(head, CFrame.new(0, hs.Y * 0.68, 0), Vector3.new(hs.X * 1.05, hs.Y * 0.3, hs.Z * 1.05), Color3.fromRGB(230, 210, 160), Enum.Material.Fabric)
	end
	if has.guardcap then
		hat(Color3.fromRGB(20, 26, 50), hs.Y * 0.22, true)
	end
	if has.beanie then
		part(head, CFrame.new(0, hs.Y * 0.45, 0), Vector3.new(hs.X * 1.1, hs.Y * 0.45, hs.Z * 1.1), Color3.fromRGB(30, 30, 34), Enum.Material.Fabric)
	end
	if has.headband then
		part(head, CFrame.new(0, hs.Y * 0.3, 0), Vector3.new(hs.X * 1.08, 0.12, hs.Z * 1.08), Color3.fromRGB(240, 240, 240), Enum.Material.Fabric)
	end
	if has.scarf then
		part(head, CFrame.new(0, hs.Y * 0.12, hs.Z * 0.08), Vector3.new(hs.X * 1.18, hs.Y * 1.1, hs.Z * 1.12), Rand.pick(rng, { Color3.fromRGB(140, 40, 60), Color3.fromRGB(60, 90, 140), Color3.fromRGB(200, 170, 120) }), Enum.Material.Fabric)
	end
	if has.hood then
		part(head, CFrame.new(0, hs.Y * 0.15, hs.Z * 0.12), Vector3.new(hs.X * 1.2, hs.Y * 1.15, hs.Z * 1.15), Color3.fromRGB(26, 26, 28), Enum.Material.Fabric)
	end
	-- face items (the face looks along -Z)
	if has.glasses then
		part(head, CFrame.new(0, hs.Y * 0.08, -hs.Z * 0.52), Vector3.new(hs.X * 0.9, hs.Y * 0.2, 0.04), Color3.fromRGB(30, 30, 34), Enum.Material.Glass).Transparency = 0.35
	end
	if has.sunglasses then
		part(head, CFrame.new(0, hs.Y * 0.08, -hs.Z * 0.52), Vector3.new(hs.X * 0.92, hs.Y * 0.22, 0.04), Color3.fromRGB(10, 10, 12), Enum.Material.Glass)
	end
	if has.sunglasses_up then
		part(head, CFrame.new(0, hs.Y * 0.45, -hs.Z * 0.3), Vector3.new(hs.X * 0.92, hs.Y * 0.2, 0.05), Color3.fromRGB(240, 60, 160), Enum.Material.Glass)
	end
	if has.mustache then
		part(head, CFrame.new(0, -hs.Y * 0.18, -hs.Z * 0.51), Vector3.new(hs.X * 0.45, hs.Y * 0.09, 0.05), if has.white_hair then Color3.fromRGB(210, 210, 210) else hair)
	end
	if has.mask then
		part(head, CFrame.new(0, -hs.Y * 0.12, -hs.Z * 0.5), Vector3.new(hs.X * 0.95, hs.Y * 0.45, 0.06), Color3.fromRGB(20, 20, 22), Enum.Material.Fabric)
	end
	if has.headset then
		for _, s in { -1, 1 } do
			part(head, CFrame.new(s * hs.X * 0.55, hs.Y * 0.05, 0), Vector3.new(0.12, hs.Y * 0.42, hs.Y * 0.42), Color3.fromRGB(26, 26, 30), Enum.Material.SmoothPlastic, "cyl")
		end
		part(head, CFrame.new(0, hs.Y * 0.56, 0), Vector3.new(hs.X * 1.15, 0.1, 0.16), Color3.fromRGB(26, 26, 30))
		local led = part(head, CFrame.new(hs.X * 0.62, hs.Y * 0.05, 0), Vector3.new(0.02, hs.Y * 0.2, hs.Y * 0.2), Color3.fromRGB(120, 60, 255), Enum.Material.Neon)
		led.CastShadow = false
	end
	-- torso items (front is -Z)
	local ts = torso.Size
	if has.tie then
		part(torso, CFrame.new(0, ts.Y * 0.1, -ts.Z * 0.51), Vector3.new(ts.X * 0.12, ts.Y * 0.6, 0.04), Color3.fromRGB(140, 20, 30))
	end
	if has.backpack then
		part(torso, CFrame.new(0, 0, ts.Z * 0.75), Vector3.new(ts.X * 0.8, ts.Y * 0.85, ts.Z * 0.6), Rand.pick(rng, { Color3.fromRGB(40, 60, 120), Color3.fromRGB(30, 30, 34), Color3.fromRGB(180, 50, 50) }), Enum.Material.Fabric)
	end
	if has.guitar then
		part(torso, CFrame.new(0, 0, ts.Z * 0.7) * CFrame.Angles(0, 0, math.rad(30)), Vector3.new(ts.X * 0.7, ts.Y * 1.6, 0.2), Color3.fromRGB(30, 30, 34), Enum.Material.Fabric)
	end
	if has.stethoscope then
		part(torso, CFrame.new(0, ts.Y * 0.2, -ts.Z * 0.5), Vector3.new(ts.X * 0.5, 0.06, 0.06), Color3.fromRGB(30, 30, 34))
	end
	if has.chain then
		part(torso, CFrame.new(0, ts.Y * 0.3, -ts.Z * 0.5), Vector3.new(ts.X * 0.45, 0.06, 0.04), Color3.fromRGB(230, 190, 60), Enum.Material.Metal)
	end
	if has.apron then
		part(torso, CFrame.new(0, -ts.Y * 0.05, -ts.Z * 0.51), Vector3.new(ts.X * 0.85, ts.Y * 0.9, 0.04), Color3.fromRGB(110, 76, 50), Enum.Material.Fabric)
	end
	if has.lanyard then
		local card = part(torso, CFrame.new(0, -ts.Y * 0.1, -ts.Z * 0.52), Vector3.new(0.3, 0.38, 0.03), Color3.fromRGB(240, 240, 240))
		card.CastShadow = false
	end
	if has.camera then
		part(torso, CFrame.new(ts.X * 0.2, -ts.Y * 0.2, -ts.Z * 0.6), Vector3.new(0.4, 0.28, 0.22), Color3.fromRGB(26, 26, 28))
	end
	-- hand items
	if rightHand then
		if has.briefcase then
			part(rightHand, CFrame.new(0, -0.45, 0), Vector3.new(0.25, 0.75, 1.0), Color3.fromRGB(60, 40, 30), Enum.Material.Leather)
		elseif has.handbag then
			part(rightHand, CFrame.new(0, -0.35, 0), Vector3.new(0.3, 0.55, 0.75), Color3.fromRGB(120, 40, 50), Enum.Material.Leather)
		elseif has.book then
			part(rightHand, CFrame.new(0, -0.2, -0.1), Vector3.new(0.15, 0.6, 0.45), Color3.fromRGB(150, 40, 40))
		end
	end
end

-- Creates an NPC. opts: look, gender, name, seed, cf, tag
-- Standing NPCs are anchored so dozens of idle customers and staff cost the server nothing;
-- they are released while walking or sitting down.
local function setAnchored(model: Model, on: boolean)
	local root = model.PrimaryPart
	if root then
		root.Anchored = on
	end
end
NpcService.setAnchored = setAnchored

function NpcService.spawn(opts: { [string]: any }): Model
	local rng = Random.new(opts.seed or math.random(1, 1e9))
	local look = LOOKS[opts.look or "casual"] or LOOKS.casual
	local base = baseRigs[if look.kid then "kid" else "adult"]
	local model = base:Clone()
	model.Name = opts.name or "NPC"
	local skin = c3(Rand.pick(rng, SKIN))
	local shirt = c3(Rand.pick(rng, look.shirt))
	local pants = c3(Rand.pick(rng, look.pants))
	local bc = model:FindFirstChildOfClass("BodyColors")
	if not bc then
		bc = Instance.new("BodyColors")
		bc.Parent = model
	end
	bc.HeadColor3 = skin
	bc.TorsoColor3 = shirt
	bc.LeftArmColor3 = shirt
	bc.RightArmColor3 = shirt
	bc.LeftLegColor3 = pants
	bc.RightLegColor3 = pants
	-- hands keep the skin colour
	for _, n in { "LeftHand", "RightHand" } do
		local h = model:FindFirstChild(n)
		if h and h:IsA("BasePart") then
			h.Color = skin
		end
	end
	for _, n in { "LeftFoot", "RightFoot" } do
		local f = model:FindFirstChild(n)
		if f and f:IsA("BasePart") then
			f.Color = Color3.fromRGB(30, 30, 32)
		end
	end
	local hum = model:FindFirstChildOfClass("Humanoid") :: Humanoid
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	hum.WalkSpeed = opts.speed or 10
	hum.BreakJointsOnDeath = false
	for _, s in { Enum.HumanoidStateType.Climbing, Enum.HumanoidStateType.Swimming, Enum.HumanoidStateType.FallingDown, Enum.HumanoidStateType.Ragdoll, Enum.HumanoidStateType.Dead, Enum.HumanoidStateType.Flying } do
		hum:SetStateEnabled(s, false)
	end
	if not hum:FindFirstChildOfClass("Animator") then
		Instance.new("Animator").Parent = hum
	end
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart
	model.PrimaryPart = root
	if opts.cf then
		model:PivotTo(opts.cf)
	end
	dress(model, look.extras or {}, c3(Rand.pick(rng, HAIR)), opts.gender or "m", rng)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.CanQuery = d == root
			if d ~= root then
				d.CanCollide = false
			end
		end
	end
	if opts.tag then
		model:AddTag(opts.tag)
	end
	model:SetAttribute("Npc", true)
	model.Parent = opts.parent or folder
	pcall(function()
		root:SetNetworkOwner(nil)
	end)
	setAnchored(model, true)
	NpcService.play(model, "idle")
	return model
end

-- Plays one of the default animations (loops idle/walk/run/sit).
function NpcService.play(model: Model, name: string, speed: number?)
	local hum = model:FindFirstChildOfClass("Humanoid")
	local animator = hum and hum:FindFirstChildOfClass("Animator")
	if not animator then
		return
	end
	local current = model:GetAttribute("Anim")
	if current == name then
		return
	end
	model:SetAttribute("Anim", name)
	for _, t in animator:GetPlayingAnimationTracks() do
		t:Stop(0.2)
	end
	local anim = Instance.new("Animation")
	anim.AnimationId = ANIMS[name] or ANIMS.idle
	local ok, track = pcall(function()
		return animator:LoadAnimation(anim)
	end)
	if ok and track then
		track.Looped = name == "idle" or name == "walk" or name == "run" or name == "sit"
		track:Play(0.2)
		if speed then
			track:AdjustSpeed(speed)
		end
	end
end

-- Walks to a position; yields until arrived or timeout. Teleports the last bit if stuck.
function NpcService.walkTo(model: Model, pos: Vector3, timeout: number?, run: boolean?): boolean
	local hum = model:FindFirstChildOfClass("Humanoid")
	local root = model.PrimaryPart
	if not hum or not root or not model.Parent then
		return false
	end
	setAnchored(model, false)
	if hum.SeatPart then
		hum.Sit = false
		hum.Jump = true
		task.wait(0.2)
	end
	NpcService.play(model, if run then "run" else "walk", if run then 1 else hum.WalkSpeed / 12)
	local limit = timeout or ((root.Position - pos).Magnitude / math.max(4, hum.WalkSpeed) + 3)
	local done = false
	local reached = false
	local conn = hum.MoveToFinished:Connect(function(r)
		done = true
		reached = r
	end)
	hum:MoveTo(pos)
	local t0 = os.clock()
	while not done and os.clock() - t0 < limit and model.Parent do
		task.wait(0.1)
		-- MoveTo expires after 8 s; keep nudging
		if not done and os.clock() - t0 > 7 then
			hum:MoveTo(pos)
		end
	end
	conn:Disconnect()
	if model.Parent and (root.Position - pos).Magnitude > 3 then
		model:PivotTo(CFrame.new(pos + Vector3.new(0, hum.HipHeight + root.Size.Y / 2, 0)) * root.CFrame.Rotation)
	end
	if model.Parent then
		NpcService.play(model, "idle")
		if not hum.SeatPart then
			setAnchored(model, true)
		end
	end
	return reached
end

-- Follows a list of points (Vector3 or CFrame or marker parts).
function NpcService.walkPath(model: Model, points: { any }, run: boolean?): boolean
	for _, p in points do
		local pos = if typeof(p) == "Vector3" then p elseif typeof(p) == "CFrame" then p.Position else (p :: BasePart).Position
		if not model.Parent then
			return false
		end
		NpcService.walkTo(model, pos, nil, run)
	end
	return model.Parent ~= nil
end

function NpcService.face(model: Model, pos: Vector3)
	local root = model.PrimaryPart
	if root then
		local p = root.Position
		model:PivotTo(CFrame.lookAt(p, Vector3.new(pos.X, p.Y, pos.Z)))
	end
end

function NpcService.sit(model: Model, seat: Seat?)
	local hum = model:FindFirstChildOfClass("Humanoid")
	if hum and seat and not seat.Occupant then
		setAnchored(model, false)
		seat:Sit(hum)
		NpcService.play(model, "sit")
		return true
	end
	return false
end

-- Speech bubble above the head.
function NpcService.say(model: Model, text: string, seconds: number?, color: Color3?)
	local head = model:FindFirstChild("Head")
	if not head then
		return
	end
	local old = head:FindFirstChild("Bubble")
	if old then
		old:Destroy()
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "Bubble"
	gui.Size = UDim2.fromOffset(240, 70)
	gui.StudsOffset = Vector3.new(0, 2.6, 0)
	gui.MaxDistance = 70
	gui.LightInfluence = 0
	local frame = Instance.new("TextLabel")
	frame.Size = UDim2.fromScale(1, 1)
	frame.BackgroundColor3 = color or Color3.fromRGB(255, 255, 255)
	frame.BackgroundTransparency = 0.05
	frame.TextColor3 = Color3.fromRGB(25, 25, 30)
	frame.TextWrapped = true
	frame.TextScaled = true
	frame.FontFace = B.Fonts.Medium
	frame.Text = text
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, 8)
	pad.PaddingRight = UDim.new(0, 8)
	pad.PaddingTop = UDim.new(0, 4)
	pad.PaddingBottom = UDim.new(0, 4)
	pad.Parent = frame
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 12)
	corner.Parent = frame
	local size = Instance.new("UITextSizeConstraint")
	size.MaxTextSize = 22
	size.Parent = frame
	frame.Parent = gui
	gui.Parent = head
	task.delay(seconds or 5, function()
		if gui.Parent then
			gui:Destroy()
		end
	end)
end

-- Small floating name/mood tag.
function NpcService.tag(model: Model, text: string, color: Color3?)
	local head = model:FindFirstChild("Head")
	if not head then
		return
	end
	local gui = head:FindFirstChild("NameTag") :: BillboardGui?
	if not gui then
		local g = Instance.new("BillboardGui")
		g.Name = "NameTag"
		g.Size = UDim2.fromOffset(200, 26)
		g.StudsOffset = Vector3.new(0, 1.6, 0)
		g.MaxDistance = 40
		g.LightInfluence = 0
		local l = Instance.new("TextLabel")
		l.Name = "Label"
		l.Size = UDim2.fromScale(1, 1)
		l.BackgroundTransparency = 1
		l.TextColor3 = Color3.new(1, 1, 1)
		l.TextStrokeTransparency = 0.4
		l.FontFace = B.Fonts.Bold
		l.TextScaled = true
		l.Parent = g
		g.Parent = head
		gui = g
	end
	local l = (gui :: BillboardGui):FindFirstChild("Label") :: TextLabel
	l.Text = text
	l.TextColor3 = color or Color3.new(1, 1, 1)
end

function NpcService.despawn(model: Model)
	if model then
		model:Destroy()
	end
end

function NpcService.folder(): Folder
	return folder
end

function NpcService.init()
	folder = Instance.new("Folder")
	folder.Name = "NPCs"
	folder.Parent = Workspace
	baseRigs.adult = makeBase("adult")
	baseRigs.kid = makeBase("kid")
end

function NpcService.start() end

return NpcService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1321">
          <Properties>
            <string name="Name">PlotService</string>
            <string name="Source"><![CDATA[-- PlotService: the 66 shop plots. Every online player owns one shop; free plots show a "for rent"
-- lot. Shops are rebuilt when they level up or get new items.

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextService = game:GetService("TextService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local CityLayout = require(Shared.World.CityLayout)
local ShopBuilder = require(Shared.Models.ShopBuilder)
local Upgrades = require(Shared.Data.Upgrades)
local Signal = require(Shared.Util.Signal)
local Net = require(Shared.Net)

local DataService = require(script.Parent.DataService)

local PlotService = {}
PlotService.built = Signal.new() -- (player, shop) after a shop is (re)built
PlotService.released = Signal.new() -- (player, plotId)

local folder: Folder
local owners: { [number]: Player } = {}
local shops: { [Player]: { [string]: any } } = {}
local lots: { [number]: Model } = {}
local moveCooldown: { [Player]: number } = {}

local function plotById(id: number)
	return CityLayout.get().plots[id]
end

local function buildLot(id: number)
	local plot = plotById(id)
	if lots[id] then
		lots[id]:Destroy()
	end
	local holder = folder:FindFirstChild("Plot_" .. id) or Instance.new("Model")
	holder.Name = "Plot_" .. id
	holder:SetAttribute("Plot", id)
	holder.Parent = folder
	lots[id] = ShopBuilder.emptyLot(holder, plot.cf, plot.width, plot.depth, id)
end

local function shopName(player: Player, p): string
	if p.shop.name and #p.shop.name > 0 then
		return p.shop.name
	end
	return player.DisplayName .. " Bilgisayar"
end

-- (Re)builds the player's shop on its plot.
function PlotService.build(player: Player)
	local p = DataService.get(player)
	local id = p and p.shop.plot
	if not p or not id or owners[id] ~= player then
		return nil
	end
	local plot = plotById(id)
	local old = shops[player]
	if old and old.model then
		old.model:Destroy()
	end
	if lots[id] then
		lots[id]:Destroy()
		lots[id] = nil
	end
	local holder = folder:FindFirstChild("Plot_" .. id) or Instance.new("Model")
	holder.Name = "Plot_" .. id
	holder:SetAttribute("Plot", id)
	holder:SetAttribute("Owner", player.UserId)
	holder.Parent = folder
	local model, info = ShopBuilder.build(holder, plot.cf, {
		level = p.shop.level,
		name = shopName(player, p),
		owner = player.DisplayName,
		wall = p.shop.wall,
		floor = p.shop.floor,
		accent = p.shop.accent,
		items = p.shop.items,
		plotWidth = plot.width,
		plotDepth = plot.depth,
		seed = id * 31 + p.shop.level,
	})
	model:SetAttribute("Owner", player.UserId)
	model:SetAttribute("OwnerName", player.DisplayName)
	model:SetAttribute("Plot", id)
	local benches = {}
	for _, d in model:GetChildren() do
		local idx = d:GetAttribute("Bench")
		if d:IsA("Model") and idx then
			benches[idx] = d
		end
	end
	local shop = {
		player = player,
		plotId = id,
		plot = plot,
		model = model,
		info = info,
		level = p.shop.level,
		benches = benches,
		points = model:FindFirstChild("Points"),
	}
	shops[player] = shop
	player:SetAttribute("Plot", id)
	PlotService.built:Fire(player, shop)
	Net.push(player, "shop", { plot = id, level = p.shop.level, name = shopName(player, p), benches = #benches })
	return shop
end

function PlotService.claim(player: Player, id: number): boolean
	local plot = plotById(id)
	if not plot or (owners[id] and owners[id] ~= player) then
		return false
	end
	local p = DataService.get(player)
	if not p then
		return false
	end
	local previous = shops[player]
	if previous and previous.plotId ~= id then
		PlotService.release(player)
	end
	owners[id] = player
	p.shop.plot = id
	DataService.touch(player)
	PlotService.build(player)
	return true
end

function PlotService.release(player: Player)
	local shop = shops[player]
	if not shop then
		return
	end
	if shop.model then
		shop.model:Destroy()
	end
	shops[player] = nil
	owners[shop.plotId] = nil
	buildLot(shop.plotId)
	PlotService.released:Fire(player, shop.plotId)
end

-- The saved plot if it is free, otherwise the free plot closest to the city centre.
local function assign(player: Player)
	local p = DataService.get(player)
	if not p then
		return
	end
	local want = p.shop.plot
	if want and plotById(want) and not owners[want] then
		PlotService.claim(player, want)
		return
	end
	local best, bestD = nil, math.huge
	for _, plot in CityLayout.get().plots do
		if not owners[plot.id] then
			local d = plot.cf.Position.Magnitude + math.random() * 120
			if d < bestD then
				best, bestD = plot.id, d
			end
		end
	end
	if best then
		PlotService.claim(player, best)
	end
end

function PlotService.shopOf(player: Player)
	return shops[player]
end

function PlotService.ownerOf(id: number): Player?
	return owners[id]
end

function PlotService.shops()
	return shops
end

-- Which shop (and its owner) a world position lies in.
function PlotService.shopAt(pos: Vector3)
	for player, shop in shops do
		local l = shop.plot.cf:PointToObjectSpace(pos)
		if math.abs(l.X) < shop.plot.width / 2 and l.Z > -2 and l.Z < shop.plot.depth then
			return shop, player
		end
	end
	return nil, nil
end

function PlotService.init()
	folder = Instance.new("Folder")
	folder.Name = "Plots"
	folder.Parent = Workspace
	for _, plot in CityLayout.get().plots do
		buildLot(plot.id)
	end
end

function PlotService.start()
	DataService.loaded:Connect(function(player)
		assign(player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		PlotService.release(player)
		moveCooldown[player] = nil
	end)
	-- renting an empty lot moves your shop there
	game:GetService("ProximityPromptService").PromptTriggered:Connect(function(prompt, player)
		if prompt.Name ~= "ClaimPrompt" then
			return
		end
		local id = prompt:GetAttribute("Plot")
		if typeof(id) ~= "number" or owners[id] then
			return
		end
		if moveCooldown[player] and os.clock() - moveCooldown[player] < 20 then
			Net.push(player, "toast", { key = "move_wait" })
			return
		end
		moveCooldown[player] = os.clock()
		if PlotService.claim(player, id) then
			Net.push(player, "toast", { key = "moved", vars = { plot = id } })
		end
	end)
	Net.handle("shop.rename", function(player, name)
		local p = DataService.get(player)
		if not p or not Net.V.str(name, 28) then
			return { ok = false }
		end
		local clean = string.gsub(name, "[%c<>]", "")
		-- shop names are shown to everyone on the sign: run them through Roblox's text filter
		local ok, filtered = pcall(function()
			local result = TextService:FilterStringAsync(clean, player.UserId, Enum.TextFilterContext.PublicChat)
			return result:GetNonChatStringForBroadcastAsync()
		end)
		if not ok or typeof(filtered) ~= "string" then
			return { ok = false, err = "filter" }
		end
		p.shop.name = filtered
		DataService.touch(player)
		PlotService.build(player)
		return { ok = true }
	end)
end

function PlotService.levelInfo(player: Player)
	local p = DataService.get(player)
	return p and Upgrades.levels[p.shop.level]
end

return PlotService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1322">
          <Properties>
            <string name="Name">QuestService</string>
            <string name="Source"><![CDATA[-- QuestService: three daily tasks per player (Data/Quests). Other services report progress with
-- QuestService.bump(player, kind, amount); income counts through DataService.earned. Finished
-- tasks are claimed from the city hall board or the phone.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Quests = require(Shared.Data.Quests)
local Market = require(Shared.Economy.Market)
local Rand = require(Shared.Util.Rand)

local DataService = require(script.Parent.DataService)

local QuestService = {}

local V = Net.V

-- income that counts towards "earn"
local EARNING = { repair = true, contract = true, showcase = true, resale = true, sell = true, bounty = true, tip = true }

-- Today's three tasks for the player (made on first use each day).
function QuestService.ensure(player: Player)
	local p = DataService.get(player)
	if not p then
		return nil
	end
	local day = Market.day()
	if p.quests and p.quests.day == day and #p.quests.list > 0 then
		return p.quests
	end
	local rng = Rand.new(day * 7919 + player.UserId % 100003)
	local pool = {}
	for _, q in Quests.list do
		if (q.level or 1) <= p.level then
			table.insert(pool, q)
		end
	end
	Rand.shuffle(rng, pool)
	local scale = Quests.scale(p.level)
	local list = {}
	for i = 1, math.min(3, #pool) do
		local q = pool[i]
		local goal = rng:NextInteger(q.goal[1], q.goal[2])
		if q.money then
			goal = math.floor(goal * scale / 50 + 0.5) * 50
		end
		table.insert(list, { id = q.id, goal = goal, n = 0, claimed = false, reward = math.floor(q.reward * scale), xp = q.xp })
	end
	p.quests = { day = day, list = list }
	DataService.touch(player)
	return p.quests
end

function QuestService.bump(player: Player, kind: string, amount: number?)
	local qs = QuestService.ensure(player)
	if not qs then
		return
	end
	local changed = false
	for _, q in qs.list do
		if q.id == kind and q.n < q.goal then
			q.n = math.min(q.goal, q.n + (amount or 1))
			changed = true
			if q.n >= q.goal then
				Net.push(player, "toast", { key = "quest_done", vars = { reward = q.reward } })
			end
		end
	end
	if changed then
		DataService.touch(player)
	end
end

local function claim(player: Player, payload)
	if not V.tbl(payload) or not V.int(payload.i, 1, 3) then
		return { ok = false, err = "bad" }
	end
	local qs = QuestService.ensure(player)
	local q = qs and qs.list[payload.i]
	if not q or q.claimed or q.n < q.goal then
		return { ok = false, err = "not_done" }
	end
	q.claimed = true
	DataService.money(player, q.reward, "quest")
	DataService.addXp(player, q.xp)
	DataService.touch(player)
	return { ok = true, reward = q.reward }
end

function QuestService.init() end

function QuestService.start()
	Net.handle("quests.claim", claim)
	DataService.loaded:Connect(function(player)
		QuestService.ensure(player)
	end)
	DataService.earned:Connect(function(player, delta, reason)
		if EARNING[reason or ""] then
			QuestService.bump(player, "earn", math.floor(delta))
		end
	end)
end

return QuestService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1323">
          <Properties>
            <string name="Name">RepairService</string>
            <string name="Source"><![CDATA[-- RepairService: jobs (customer devices and your own projects), workbenches and every repair action.
--
-- A job's device lives on the server with its hidden faults. When a job sits on a bench, the
-- bench model carries the client-safe view (RepairRules.view) as a JSON attribute so every
-- player sees the device; the technician at the bench sends actions through "repair.act", which
-- runs RepairRules.apply here with the player's real tools, parts and consumables.

local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Signal = require(Shared.Util.Signal)
local Parts = require(Shared.Data.Parts)
local Tools = require(Shared.Data.Tools)
local Faults = require(Shared.Data.Faults)
local Upgrades = require(Shared.Data.Upgrades)
local Rules = require(Shared.Repair.RepairRules)
local DeviceGen = require(Shared.Repair.DeviceGen)

local DataService = require(script.Parent.DataService)
local PlotService = require(script.Parent.PlotService)

local RepairService = {}
RepairService.jobFinished = Signal.new() -- (player, job) the device is ready for pickup
RepairService.jobRemoved = Signal.new() -- (player, jobId)

local V = Net.V
local jobs: { [Player]: { [string]: any } } = {}
local nextId = 0
local sessions: { [Player]: { [string]: any } } = {}
local benches: { [Player]: { [number]: { [string]: any } } } = {}
local rng = Random.new()

local MAX_JOBS = 12
RepairService.MAX_JOBS = MAX_JOBS

----------------------------------------------------------------------------------------------------
-- Jobs
----------------------------------------------------------------------------------------------------
local function jobList(player: Player)
	local t = jobs[player]
	if not t then
		t = {}
		jobs[player] = t
	end
	return t
end

-- What the client may know about a job (no hidden faults, no device internals).
function RepairService.summary(job)
	local symptoms = {}
	local lang = job.lang or "tr"
	for _, fid in job.faults or {} do
		local f = Faults.get(fid)
		if f then
			table.insert(symptoms, { diag = f.diag, text = job.complaint and job.complaint[fid] or "" })
		end
	end
	return {
		id = job.id,
		kind = job.kind,
		own = job.own,
		name = job.name,
		customer = job.customer and { name = job.customer.name, arch = job.customer.arch } or nil,
		complaint = job.text,
		requestId = job.requestId,
		request = job.request,
		price = job.price,
		status = job.status,
		bench = job.bench,
		deadline = job.deadline,
		device = job.device.kind,
		model = job.device.model,
		tools = job.tools,
		lang = lang,
		symptoms = symptoms,
		blocked = job.blocked and { reason = job.blocked.reason, detail = job.blocked.detail, by = job.blocked.by } or nil,
		client = job.contract and job.contract.name or nil, -- contract work: the company's name
		showcase = job.showcase,
		-- own projects: what the second-hand dealer would pay right now
		resale = if job.own and job.status ~= "bench" then RepairService.resale(job) else nil,
	}
end

function RepairService.jobs(player: Player)
	return jobList(player)
end

function RepairService.job(player: Player, id: string)
	return jobList(player)[id]
end

function RepairService.summaries(player: Player)
	local out = {}
	for _, job in jobList(player) do
		table.insert(out, RepairService.summary(job))
	end
	table.sort(out, function(a, b)
		return a.id < b.id
	end)
	return out
end

function RepairService.pushJobs(player: Player)
	Net.push(player, "jobs", RepairService.summaries(player))
end

-- data: { device, faults?, request?, requestId?, kind, price, customer?, text?, own?, deadline? }
function RepairService.createJob(player: Player, data): any?
	local list = jobList(player)
	local count = 0
	for _ in list do
		count += 1
	end
	if count >= MAX_JOBS then
		return nil
	end
	nextId += 1
	local job = data
	job.id = string.format("J%04d", nextId)
	job.status = "waiting"
	job.created = os.clock()
	job.lang = DataService.lang(player)
	job.name = DeviceGen.name(job.device)
	local tools = {}
	for _, fid in job.faults or {} do
		local f = Faults.get(fid)
		for _, t in f and f.tools or {} do
			tools[t] = true
		end
	end
	job.tools = {}
	for t in tools do
		table.insert(job.tools, t)
	end
	list[job.id] = job
	RepairService.pushJobs(player)
	return job
end

function RepairService.removeJob(player: Player, id: string)
	local job = jobList(player)[id]
	if not job then
		return
	end
	if job.bench then
		RepairService.clearBench(player, job.bench)
	end
	jobList(player)[id] = nil
	RepairService.jobRemoved:Fire(player, id)
	RepairService.pushJobs(player)
end

----------------------------------------------------------------------------------------------------
-- Benches
----------------------------------------------------------------------------------------------------
local function benchState(player: Player, i: number)
	local b = benches[player]
	if not b then
		b = {}
		benches[player] = b
	end
	if not b[i] then
		b[i] = { rev = 0 }
	end
	return b[i]
end

local function benchModel(player: Player, i: number): Model?
	local shop = PlotService.shopOf(player)
	return shop and shop.benches[i] or nil
end
RepairService.benchModel = benchModel

-- Writes the bench's device view where every client can see it.
function RepairService.publish(player: Player, i: number)
	local st = benchState(player, i)
	local m = benchModel(player, i)
	if not m then
		return
	end
	st.rev += 1
	local job = st.job and jobList(player)[st.job]
	if job then
		m:SetAttribute("DeviceView", HttpService:JSONEncode(Rules.view(job.device)))
		m:SetAttribute("JobId", job.id)
	else
		m:SetAttribute("DeviceView", nil)
		m:SetAttribute("JobId", nil)
	end
	m:SetAttribute("DeviceRev", st.rev)
end

function RepairService.clearBench(player: Player, i: number)
	local st = benchState(player, i)
	local job = st.job and jobList(player)[st.job]
	if job then
		job.bench = nil
		if job.status == "bench" then
			job.status = "waiting"
		end
	end
	st.job = nil
	st.worker = nil
	RepairService.publish(player, i)
end

function RepairService.benchJob(player: Player, i: number)
	local st = benchState(player, i)
	return st.job and jobList(player)[st.job] or nil
end

function RepairService.freeBench(player: Player): number?
	local shop = PlotService.shopOf(player)
	if not shop then
		return nil
	end
	for i = 1, #shop.benches do
		local st = benchState(player, i)
		if not st.job and not st.worker then
			return i
		end
	end
	return nil
end

-- Puts a waiting job onto bench i. worker: the player or an employee uid.
function RepairService.load(player: Player, i: number, jobId: string, worker: any?): (boolean, string?)
	local job = jobList(player)[jobId]
	if not job or not benchModel(player, i) then
		return false, "not_found"
	end
	if job.status ~= "waiting" then
		return false, "busy"
	end
	local st = benchState(player, i)
	if st.job and st.job ~= jobId then
		return false, "bench_busy"
	end
	st.job = jobId
	st.worker = worker
	job.status = "bench"
	job.bench = i
	if worker == player then
		job.blocked = nil -- the boss takes over
	end
	RepairService.publish(player, i)
	RepairService.pushJobs(player)
	return true
end

----------------------------------------------------------------------------------------------------
-- Actions
----------------------------------------------------------------------------------------------------
local function items(player: Player)
	local p = DataService.get(player)
	return p and p.shop.items or {}
end

-- RepairRules ctx for a player (or an employee working for that player)
function RepairService.ctx(player: Player, job, toolId: string, owned: { [string]: boolean }?)
	local mat = items(player).bench_mat
	local base = rng
	local rr = {
		NextNumber = function()
			local n = base:NextNumber()
			return if mat then math.min(1, n * 2) else n
		end,
		NextInteger = function(_, a, b)
			return base:NextInteger(a, b)
		end,
	}
	return {
		tool = toolId,
		owned = owned or DataService.owned(player),
		lang = DataService.lang(player),
		rng = rr,
		takePart = function(source: string, partId: string, uid: string?)
			if source == "inv" then
				local item = DataService.takePart(player, uid, partId)
				if not item then
					return nil
				end
				local dead = item.broken or item.hiddenBroken
				local cat = Parts.get(item.part) and (Parts.get(item.part) :: any).cat
				return { part = item.part, cond = item.cond, hidden = if dead then (if cat == "ram" then "faulty" else "dead") else nil, origin = item.origin }
			elseif source == "tray" then
				for k, t in job.device.tray do
					if t.uid == uid then
						table.remove(job.device.tray, k)
						return { part = t.part, cond = t.cond, hidden = t.hidden, origin = t.origin }
					end
				end
			end
			return nil
		end,
		usePaste = function()
			return DataService.usePaste(player)
		end,
		useSolder = function()
			return DataService.useStock(player, "solder_wire", 1)
		end,
		useTies = function(n)
			return DataService.useStock(player, "zip_ties", n)
		end,
	}
end

local TIMED = Config.HoldActionSeconds

-- Runs one repair action on bench i for `player`'s shop. Returns the client result.
function RepairService.act(player: Player, i: number, action: string, target: string?, args, toolId: string, worker: any?)
	local st = benchState(player, i)
	local job = st.job and jobList(player)[st.job]
	if not job then
		return { ok = false, err = "no_job" }
	end
	-- pacing: timed actions can't be spammed
	local now = os.clock()
	local tool = Tools.get(toolId)
	local need = (TIMED[action] or 0.08) * 0.75 / ((tool and tool.speed) or 1)
	if worker == nil and st.last and now - st.last < need then
		return { ok = false, err = "too_fast" }
	end
	st.last = now
	local res = Rules.apply(job.device, action, target, args or {}, RepairService.ctx(player, job, toolId))
	if res.ok then
		job.touched = true
		RepairService.publish(player, i)
		if res.eval then
			local m = benchModel(player, i)
			if m then
				m:SetAttribute("PowerFx", HttpService:JSONEncode({ stage = res.eval.stage, fans = res.eval.fans, rgb = res.eval.rgb, t = os.time(), n = st.rev }))
			end
		end
		if res.esd then
			Net.push(player, "toast", { key = "esd_zap", vars = { node = Rules.label(job.device, res.esd, DataService.lang(player)) } })
		end
	end
	res.view = Rules.view(job.device)
	res.rev = st.rev
	return res
end

----------------------------------------------------------------------------------------------------
-- Assessment
----------------------------------------------------------------------------------------------------
function RepairService.assess(job)
	local dev = job.device
	local assembled, missing = Rules.assembled(dev)
	local ev = Rules.evaluate(dev, "stress")
	local fixed = assembled and ev.stage == "ok" and #ev.issues == 0
	local unmet = {}
	if job.request then
		local ok, um = DeviceGen.meets(dev, job.request)
		if not ok then
			fixed = false
			unmet = um
		end
	end
	-- quality points for the review
	local stars = if fixed then 5 else 1
	local notes = {}
	if fixed then
		if (dev.esdEvents or 0) > 0 then
			stars -= 1
			table.insert(notes, "esd")
		end
		if dev.paste and dev.paste.st == "fresh" and (dev.paste.q or 0) < 0.55 then
			stars -= 1
			table.insert(notes, "paste")
		end
		if dev.kind == "desktop" and dev.ties then
			table.insert(notes, "tidy")
		end
	end
	return { fixed = fixed, assembled = assembled, missing = #missing, stage = ev.stage, issues = ev.issues, unmet = unmet, stars = math.max(1, stars), notes = notes }
end

-- Moves the job off its bench and marks it ready; its replaced parts go to the inventory.
function RepairService.finish(player: Player, jobId: string): (boolean, any)
	local job = jobList(player)[jobId]
	if not job then
		return false, "not_found"
	end
	local verdict = RepairService.assess(job)
	job.verdict = verdict
	-- parts that came out of the device stay with you
	local kept, scrapped = 0, 0
	for _, t in job.device.tray do
		local p = Parts.get(t.part)
		if p and p.cat ~= "misc" or (p and p.sub == "wifi") then
			local broken = t.hidden ~= nil or (t.cond or 1) < 0.25
			if DataService.addPart(player, t.part, t.cond, if t.origin == "device" then "removed" else t.origin, if broken then true else nil) then
				kept += 1
			else
				scrapped += 1
			end
		end
	end
	job.device.tray = {}
	if job.bench then
		RepairService.clearBench(player, job.bench)
	end
	job.status = "ready"
	RepairService.pushJobs(player)
	RepairService.jobFinished:Fire(player, job)
	return true, { verdict = verdict, kept = kept, scrapped = scrapped }
end

-- Value of a working own project when sold to the second-hand dealer.
function RepairService.resale(job): number
	local v = DeviceGen.value(job.device)
	local verdict = RepairService.assess(job)
	if not verdict.fixed then
		return math.floor(v * 0.12)
	end
	return math.floor(v * 0.62)
end

----------------------------------------------------------------------------------------------------
-- Sessions (a player sitting at a bench)
----------------------------------------------------------------------------------------------------
local function stopSession(player: Player, silent: boolean?)
	local s = sessions[player]
	if not s then
		return
	end
	sessions[player] = nil
	local st = benchState(player, s.bench)
	if st.worker == player then
		st.worker = nil
	end
	if s.conn then
		s.conn:Disconnect()
	end
	if not silent then
		Net.push(player, "bench.close", { bench = s.bench })
	end
end

local function startSession(player: Player, i: number)
	local shop = PlotService.shopOf(player)
	local m = benchModel(player, i)
	if not shop or not m then
		return
	end
	local st = benchState(player, i)
	if st.worker and st.worker ~= player then
		Net.push(player, "toast", { key = "bench_staff" })
		return
	end
	stopSession(player, true)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local stool = m:FindFirstChild("Stool") :: Seat?
	if hum and stool and not stool.Occupant then
		stool:Sit(hum)
	end
	st.worker = player
	local s = { bench = i, since = os.clock() }
	sessions[player] = s
	if hum then
		s.conn = hum:GetPropertyChangedSignal("SeatPart"):Connect(function()
			if hum.SeatPart ~= stool and sessions[player] == s then
				stopSession(player)
			end
		end)
	end
	local job = st.job and jobList(player)[st.job]
	Net.push(player, "bench.open", {
		bench = i,
		job = job and RepairService.summary(job) or nil,
		view = job and Rules.view(job.device) or nil,
		rev = st.rev,
		jobs = RepairService.summaries(player),
	})
end

function RepairService.session(player: Player)
	return sessions[player]
end

----------------------------------------------------------------------------------------------------
-- Network
----------------------------------------------------------------------------------------------------
local function sessionBench(player: Player): number?
	local s = sessions[player]
	return s and s.bench or nil
end

function RepairService.init() end

function RepairService.start()
	ProximityPromptService.PromptTriggered:Connect(function(prompt, player)
		if prompt.Name ~= "BenchPrompt" then
			return
		end
		local i = prompt:GetAttribute("Bench")
		local shop = PlotService.shopOf(player)
		if not shop or typeof(i) ~= "number" or not prompt:IsDescendantOf(shop.model) then
			Net.push(player, "toast", { key = "not_your_bench" })
			return
		end
		startSession(player, i)
	end)

	Net.handle("bench.leave", function(player)
		local s = sessions[player]
		if s then
			local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
			stopSession(player)
			if hum then
				hum.Sit = false
				hum.Jump = true
			end
		end
		return { ok = true }
	end)

	Net.handle("bench.load", function(player, payload)
		local i = sessionBench(player)
		if not i or not V.tbl(payload) or not V.id(payload.job) then
			return { ok = false, err = "bad" }
		end
		local st = benchState(player, i)
		if st.job then
			RepairService.clearBench(player, i)
		end
		local ok, err = RepairService.load(player, i, payload.job, player)
		if not ok then
			return { ok = false, err = err }
		end
		st.worker = player
		local job = jobList(player)[payload.job]
		return { ok = true, job = RepairService.summary(job), view = Rules.view(job.device), rev = st.rev }
	end)

	Net.handle("bench.unload", function(player)
		local i = sessionBench(player)
		if not i then
			return { ok = false }
		end
		RepairService.clearBench(player, i)
		benchState(player, i).worker = player
		RepairService.pushJobs(player)
		return { ok = true }
	end)

	Net.handle("repair.act", function(player, payload)
		local i = sessionBench(player)
		if not i then
			return { ok = false, err = "no_session" }
		end
		if not V.tbl(payload) or not V.id(payload.action) or (payload.target ~= nil and not V.id(payload.target)) or not V.id(payload.tool or "hand") then
			return { ok = false, err = "bad" }
		end
		local args = payload.args
		if args ~= nil then
			if not V.tbl(args) then
				return { ok = false, err = "bad" }
			end
			local clean = {}
			if args.source ~= nil and V.id(args.source) then
				clean.source = args.source
			end
			if args.part ~= nil and V.id(args.part) then
				clean.part = args.part
			end
			if args.uid ~= nil and V.id(args.uid) then
				clean.uid = args.uid
			end
			if args.program ~= nil and V.id(args.program) then
				clean.program = args.program
			end
			if args.amount ~= nil and V.num(args.amount, 0, 1) then
				clean.amount = args.amount
			end
			if args.on ~= nil and V.bool(args.on) then
				clean.on = args.on
			end
			args = clean
		end
		return RepairService.act(player, i, payload.action, payload.target, args, payload.tool or "hand")
	end)

	Net.handle("repair.finish", function(player)
		local i = sessionBench(player)
		local job = i and RepairService.benchJob(player, i)
		if not job then
			return { ok = false, err = "no_job" }
		end
		local ok, info = RepairService.finish(player, job.id)
		if not ok then
			return { ok = false, err = info }
		end
		return { ok = true, verdict = info.verdict, kept = info.kept, scrapped = info.scrapped, own = job.own, resale = if job.own then RepairService.resale(job) else nil }
	end)

	Net.handle("repair.assess", function(player)
		local i = sessionBench(player)
		local job = i and RepairService.benchJob(player, i)
		if not job then
			return { ok = false }
		end
		return { ok = true, verdict = RepairService.assess(job) }
	end)

	Net.handle("jobs.list", function(player)
		return { ok = true, jobs = RepairService.summaries(player) }
	end)

	-- selling a finished own project to the used-PC dealer
	Net.handle("jobs.sell", function(player, payload)
		if not V.tbl(payload) or not V.id(payload.job) then
			return { ok = false }
		end
		local job = jobList(player)[payload.job]
		if not job or not job.own or job.status == "bench" or job.status == "showcase" then
			return { ok = false, err = "not_sellable" }
		end
		local price = RepairService.resale(job)
		RepairService.removeJob(player, job.id)
		DataService.money(player, price, "resale")
		if job.verdict and job.verdict.fixed then
			DataService.addXp(player, 25)
		end
		return { ok = true, price = price }
	end)

	Players.PlayerRemoving:Connect(function(player)
		stopSession(player, true)
		jobs[player] = nil
		benches[player] = nil
	end)

	-- benches are rebuilt with the shop: re-publish what's on them
	PlotService.built:Connect(function(player, shop)
		local b = benches[player]
		if not b then
			return
		end
		for i, st in b do
			if i > #shop.benches then
				if st.job then
					RepairService.clearBench(player, i)
				end
				b[i] = nil
			else
				RepairService.publish(player, i)
			end
		end
	end)
end

-- Shop items that speed up bench work (LED lamp, tool wall, test monitor, microscope).
function RepairService.workSpeed(player: Player): number
	local s = 1
	local owned = items(player)
	for _, item in Upgrades.items do
		if item.speed and owned[item.id] then
			s += item.speed
		end
	end
	return s
end

return RepairService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1324">
          <Properties>
            <string name="Name">ShowcaseService</string>
            <string name="Source"><![CDATA[-- ShowcaseService: the PC showcase in the shop window (a shop item from level 4). Put a finished
-- build of your own on a stand; walk-in buyers pay more for it than the second-hand dealer.
-- The prompt on a stand puts your best finished project on it, or takes the PC back.

local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Rules = require(Shared.Repair.RepairRules)
local PCModel = require(Shared.Models.PCModel)
local DeviceGen = require(Shared.Repair.DeviceGen)

local DataService = require(script.Parent.DataService)
local PlotService = require(script.Parent.PlotService)
local RepairService = require(script.Parent.RepairService)

local ShowcaseService = {}

local rng = Random.new()
local SALE_EVERY = 40 -- seconds between buyer visits
local SALE_CHANCE = 0.22 -- per PC on display per visit
local PRICE_FACTOR = 1.35 -- on top of what the second-hand dealer pays

local models: { [Player]: { [number]: Model } } = {}

local function slotPart(player: Player, slot: number): BasePart?
	local shop = PlotService.shopOf(player)
	local points = shop and shop.points
	return points and points:FindFirstChild("Showcase_" .. slot) :: BasePart?
end

local function jobOn(player: Player, slot: number)
	for _, job in RepairService.jobs(player) do
		if job.status == "showcase" and job.showcase == slot then
			return job
		end
	end
	return nil
end

local function clearModel(player: Player, slot: number)
	local list = models[player]
	if list and list[slot] then
		list[slot]:Destroy()
		list[slot] = nil
	end
end

-- The PC itself, standing on the stand with its window towards the street.
local function showModel(player: Player, slot: number, job)
	clearModel(player, slot)
	local part = slotPart(player, slot)
	if not part then
		return
	end
	local shop = PlotService.shopOf(player)
	local view = Rules.view(job.device)
	local ok, h = pcall(PCModel.build, shop.model, view, PCModel.displayCFrame(part.CFrame, view), { animate = false })
	if not ok then
		warn("[ShowcaseService] " .. tostring(h))
		return
	end
	h.model.Name = "ShowcasePC_" .. slot
	for _, d in h.model:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = true
			d.CanCollide = false
		end
	end
	models[player] = models[player] or {}
	models[player][slot] = h.model
end

-- The finished own project worth the most that isn't on display yet.
local function bestProject(player: Player)
	local best, bestValue = nil, -1
	for _, job in RepairService.jobs(player) do
		if job.own and job.status == "ready" and job.verdict and job.verdict.fixed then
			local v = DeviceGen.value(job.device)
			if v > bestValue then
				best, bestValue = job, v
			end
		end
	end
	return best
end

local function onPrompt(player: Player, slot: number)
	local job = jobOn(player, slot)
	if job then
		job.status = "ready"
		job.showcase = nil
		clearModel(player, slot)
		RepairService.pushJobs(player)
		Net.push(player, "toast", { key = "showcase_back", vars = { name = job.name } })
		return
	end
	local pick = bestProject(player)
	if not pick then
		Net.push(player, "toast", { key = "showcase_none" })
		return
	end
	pick.status = "showcase"
	pick.showcase = slot
	showModel(player, slot, pick)
	RepairService.pushJobs(player)
	Net.push(player, "toast", { key = "showcase_put", vars = { name = pick.name, price = math.floor(RepairService.resale(pick) * PRICE_FACTOR) } })
end

-- Prompts on the stands and the PCs back on them after the shop was rebuilt.
local function setup(player: Player, shop)
	models[player] = {}
	local points = shop.points
	if not points then
		return
	end
	for _, pt in points:GetChildren() do
		local slot = pt:GetAttribute("Showcase")
		if typeof(slot) == "number" and pt:IsA("BasePart") then
			local prompt = Instance.new("ProximityPrompt")
			prompt.Name = "ShowcasePrompt"
			prompt.ActionText = "Vitrin"
			prompt.ObjectText = "PC Vitrini"
			prompt.HoldDuration = 0.3
			prompt.MaxActivationDistance = 9
			prompt.RequiresLineOfSight = false
			prompt:SetAttribute("Slot", slot)
			prompt.Parent = pt
			local job = jobOn(player, slot)
			if job then
				showModel(player, slot, job)
			end
		end
	end
	-- stands that disappeared (the item can't be lost, but levels can rebuild the front)
	for _, job in RepairService.jobs(player) do
		if job.status == "showcase" and not slotPart(player, job.showcase) then
			job.status = "ready"
			job.showcase = nil
		end
	end
end

local function sellRound()
	for player, list in models do
		for slot in table.clone(list) do
			local job = jobOn(player, slot)
			if not job then
				clearModel(player, slot)
			elseif rng:NextNumber() < SALE_CHANCE then
				local price = math.floor(RepairService.resale(job) * PRICE_FACTOR)
				clearModel(player, slot)
				RepairService.removeJob(player, job.id)
				DataService.money(player, price, "showcase")
				DataService.addXp(player, 35)
				DataService.rep(player, 1)
				Net.push(player, "toast", { key = "showcase_sold", vars = { name = job.name, price = price } })
			end
		end
	end
end

function ShowcaseService.init() end

function ShowcaseService.start()
	PlotService.built:Connect(setup)
	PlotService.released:Connect(function(player)
		models[player] = nil
	end)
	Players.PlayerRemoving:Connect(function(player)
		models[player] = nil
	end)
	ProximityPromptService.PromptTriggered:Connect(function(prompt, player)
		if prompt.Name ~= "ShowcasePrompt" then
			return
		end
		local shop = PlotService.shopOf(player)
		local slot = prompt:GetAttribute("Slot")
		if not shop or typeof(slot) ~= "number" or not prompt:IsDescendantOf(shop.model) then
			Net.push(player, "toast", { key = "not_your_bench" })
			return
		end
		onPrompt(player, slot)
	end)
	task.spawn(function()
		while true do
			task.wait(SALE_EVERY)
			local ok, err = pcall(sellRound)
			if not ok then
				warn("[ShowcaseService] " .. tostring(err))
			end
		end
	end)
end

ShowcaseService._sellRound = sellRound
ShowcaseService._prompt = onPrompt

return ShowcaseService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1325">
          <Properties>
            <string name="Name">ThiefService</string>
            <string name="Source"><![CDATA[-- ThiefService: shoplifters. Now and then (more often at night) a thief slips into a shop, grabs
-- cash from the register or a part from the shelves and runs for it. Anyone can catch a runner
-- with the "Catch!" prompt; guards chase them; cameras warn the owner and alarms slow them down.
-- Scammers who bolt with a repaired device use the same chase.

local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Rand = require(Shared.Util.Rand)
local Parts = require(Shared.Data.Parts)
local Upgrades = require(Shared.Data.Upgrades)
local Employees = require(Shared.Data.Employees)
local Customers = require(Shared.Data.Customers)

local DataService = require(script.Parent.DataService)
local QuestService = require(script.Parent.QuestService)
local PlotService = require(script.Parent.PlotService)
local NpcService = require(script.Parent.NpcService)
local CustomerService = require(script.Parent.CustomerService)
local EmployeeService = require(script.Parent.EmployeeService)

local ThiefService = {}

local rng = Random.new()
local nextVisit: { [Player]: number } = {}
local thieves: { [Model]: { [string]: any } } = {}

local LINES = {
	tr = { caught = { "Tamam tamam, bırak!", "Açım abi, kusura bakma...", "Bir daha yapmam, söz!" }, enter = { "Şöyle bir bakınayım...", "Hmm, ne var ne yok?" } },
	en = { caught = { "OK, OK, let go!", "I was hungry, sorry...", "I won't do it again, promise!" }, enter = { "Just browsing...", "Hmm, what's around here?" } },
}

local function point(player: Player, name: string): BasePart?
	local shop = PlotService.shopOf(player)
	return shop and shop.points and shop.points:FindFirstChild(name) or nil
end

local function isNight(): boolean
	local t = Lighting.ClockTime
	return t >= Config.NightStart or t < Config.NightEnd
end

local function security(player: Player): (number, number)
	local p = DataService.get(player)
	if not p then
		return 0, 0
	end
	return Upgrades.total(p.shop.items, "security"), Upgrades.total(p.shop.items, "protect")
end

local function addCatchPrompt(model: Model, text: string)
	local root = model.PrimaryPart
	if not root or root:FindFirstChild("CatchPrompt") then
		return
	end
	local pp = Instance.new("ProximityPrompt")
	pp.Name = "CatchPrompt"
	pp.ActionText = text
	pp.ObjectText = "🚨"
	pp.HoldDuration = 0.35
	pp.MaxActivationDistance = 9
	pp.RequiresLineOfSight = false
	pp.KeyboardKeyCode = Enum.KeyCode.F
	pp.Parent = root
end

local function finish(model: Model)
	thieves[model] = nil
	NpcService.despawn(model)
end

-- The thief is caught: loot goes back to the owner, the catcher gets the bounty.
local function caught(t, catcher: Player?, byGuard: string?)
	if t.done then
		return
	end
	t.done = true
	local owner = t.owner
	local lang = DataService.lang(owner)
	NpcService.say(t.model, Rand.pick(rng, LINES[lang].caught), 4)
	NpcService.play(t.model, "idle")
	local hum = t.model:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.WalkSpeed = 0
	end
	if t.cash and t.cash > 0 then
		DataService.money(owner, t.cash, "recovered")
	end
	if t.item then
		table.insert(DataService.get(owner).inv, t.item)
		DataService.touch(owner)
	end
	local bounty = Config.ThiefBountyBase + (if t.cash then math.floor(t.cash * 0.1) else 0)
	local who = catcher or owner
	DataService.money(who, bounty, "bounty")
	DataService.addXp(who, 40)
	local prof = DataService.get(who)
	if prof then
		prof.stats.caught += 1
	end
	QuestService.bump(who, "catch")
	Net.push(owner, "toast", { key = "thief_caught", vars = { by = byGuard or (catcher and catcher.DisplayName) or "", bounty = bounty } })
	if catcher and catcher ~= owner then
		Net.push(catcher, "toast", { key = "bounty", vars = { amount = bounty } })
	end
	task.delay(3, function()
		local exit = point(owner, "ThiefExit")
		if exit and t.model.Parent then
			if hum then
				hum.WalkSpeed = 8
			end
			NpcService.walkTo(t.model, exit.Position, 12)
		end
		finish(t.model)
	end)
end

local function escaped(t)
	if t.done then
		return
	end
	t.done = true
	local owner = t.owner
	if owner.Parent then
		local prof = DataService.get(owner)
		if prof then
			prof.stats.robbed += 1
		end
		Net.push(owner, "toast", { key = "thief_escaped", vars = { cash = t.cash or 0, part = t.item and (Parts.get(t.item.part) or {}).name or "" } })
		DataService.rep(owner, -1)
	end
	finish(t.model)
end

-- Guards run after the thief; their catch chance grows with skill and the "strong" trait.
local function sendGuards(t)
	for _, g in EmployeeService.guards(t.owner) do
		task.spawn(function()
			local rec = g.rec
			local trait = Employees.traitById[rec.trait]
			local chance = 0.45 + rec.skill * 0.08 + (trait and trait.catch or 0)
			for _ = 1, 12 do
				if t.done or not g.model or not t.model.Parent then
					return
				end
				local target = t.model.PrimaryPart
				if target then
					NpcService.walkTo(g.model, target.Position, 1.2, true)
					if (g.model.PrimaryPart.Position - target.Position).Magnitude < 6 then
						if rng:NextNumber() < chance then
							caught(t, nil, rec.name)
						end
						return
					end
				end
			end
		end)
	end
end

local function visit(player: Player)
	local shop = PlotService.shopOf(player)
	local prof = DataService.get(player)
	if not shop or not prof then
		return
	end
	local street, door, register, exit = point(player, "Street"), point(player, "Door"), point(player, "Register"), point(player, "ThiefExit")
	if not street or not door or not register or not exit then
		return
	end
	local _, protect = security(player)
	local lang = DataService.lang(player)
	local name = Customers.randomName(rng, false)
	local model = NpcService.spawn({ look = if rng:NextNumber() < 0.5 then "thief" else "shady", name = name, cf = street.CFrame * CFrame.new(Rand.range(rng, -40, 40), 3, 0), speed = 9 })
	model:SetAttribute("Thief", true)
	model:AddTag("Runner")
	local t = { model = model, owner = player, phase = "sneak" }
	thieves[model] = t
	NpcService.tag(model, name)
	task.spawn(function()
		NpcService.walkPath(model, { point(player, "Outside"), door })
		if t.done then
			return
		end
		if prof.shop.items.camera then
			Net.push(player, "toast", { key = "camera_alert" })
		end
		NpcService.say(model, Rand.pick(rng, LINES[lang].enter), 3)
		-- cash from the register, or a part from the shelf if the register is guarded by a safe
		local shelf = point(player, "Shelf_1")
		local goShelf = (protect >= 0.5 and rng:NextNumber() < 0.6 and #prof.inv > 0) or prof.money < 50
		local target = if goShelf and shelf then shelf else register
		NpcService.walkTo(model, target.Position)
		if t.done then
			return
		end
		t.phase = "steal"
		addCatchPrompt(model, if lang == "en" then "Catch!" else "Yakala!")
		local stealTime = Config.ThiefStealSeconds * (if prof.shop.items.alarm then 1.6 else 1)
		if prof.shop.items.alarm then
			local shopModel = shop.model
			for _, d in shopModel:GetDescendants() do
				if d:HasTag("AlarmLight") then
					d:SetAttribute("Alarm", os.clock())
				end
			end
			Net.push(player, "toast", { key = "alarm" })
		end
		sendGuards(t)
		task.wait(stealTime)
		if t.done then
			return
		end
		if target == register then
			local amount = math.min(prof.money * Config.ThiefMaxStealFraction, Config.ThiefMaxStealCap) * (1 - protect)
			amount = math.floor(amount * Rand.range(rng, 0.5, 1))
			if amount > 0 and DataService.money(player, -amount, "theft") then
				t.cash = amount
			end
		elseif #prof.inv > 0 then
			local i = rng:NextInteger(1, #prof.inv)
			t.item = table.remove(prof.inv, i)
			DataService.touch(player)
		end
		t.phase = "run"
		NpcService.say(model, "🏃", 2)
		local hum = model:FindFirstChildOfClass("Humanoid")
		if hum then
			hum.WalkSpeed = if prof.shop.items.alarm then 13 else 16
		end
		NpcService.walkPath(model, { door, point(player, "Outside"), exit }, true)
		if not t.done then
			escaped(t)
		end
	end)
end

ThiefService.visit = visit

function ThiefService.init() end

function ThiefService.start()
	ProximityPromptService.PromptTriggered:Connect(function(prompt, player)
		if prompt.Name ~= "CatchPrompt" then
			return
		end
		local model = prompt:FindFirstAncestorOfClass("Model")
		if not model then
			return
		end
		-- the prompt goes away once every PromptTriggered listener has seen it
		local function remove()
			prompt.Enabled = false
			task.defer(function()
				prompt:Destroy()
			end)
		end
		local t = thieves[model]
		if t then
			caught(t, player)
			remove()
			return
		end
		local cust = CustomerService.byModel(model)
		if cust and CustomerService.caught(cust, player) then
			remove()
		end
	end)
	-- scammers who run off get the same prompt
	CustomerService.robbed:Connect(function(player, cust)
		if cust.model then
			addCatchPrompt(cust.model, if DataService.lang(player) == "en" then "Catch!" else "Yakala!")
			Net.push(player, "toast", { key = "scammer_running", vars = { name = cust.name } })
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		nextVisit[player] = nil
		for model, t in thieves do
			if t.owner == player then
				finish(model)
			end
		end
	end)
	task.spawn(function()
		while true do
			task.wait(5)
			local now = os.clock()
			for player in PlotService.shops() do
				local p = DataService.get(player)
				if p and p.level >= 2 then
					if not nextVisit[player] then
						nextVisit[player] = now + Rand.range(rng, 120, 300)
					elseif now >= nextVisit[player] then
						local range = if isNight() then Config.ThiefIntervalNight else Config.ThiefIntervalDay
						local sec = security(player)
						local shutterNight = p.shop.items.shutter and isNight()
						nextVisit[player] = now + Rand.range(rng, range[1], range[2]) * (1 + sec * 0.15) * (if shutterNight then 1.8 else 1)
						if rng:NextNumber() < (if shutterNight then 0.35 else 0.8) then
							task.spawn(visit, player)
						end
					end
				end
			end
		end
	end)
end

return ThiefService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1326">
          <Properties>
            <string name="Name">TimeService</string>
            <string name="Source"><![CDATA[-- TimeService: the day/night cycle, the weather and the in-game calendar.
-- One day lasts Config.DayLengthMinutes real minutes; nights pass faster. Wages are paid at dawn.

local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Signal = require(Shared.Util.Signal)

local TimeService = {}
TimeService.newDay = Signal.new() -- (day)

local rng = Random.new()

local function isNight(t: number): boolean
	return t >= Config.NightStart or t < Config.NightEnd
end

function TimeService.init()
	Lighting.ClockTime = 9.5
	Workspace:SetAttribute("Day", 1)
	Workspace:SetAttribute("Raining", false)
end

function TimeService.start()
	-- clock
	task.spawn(function()
		local hoursPerSecond = 24 / (Config.DayLengthMinutes * 60)
		local last = os.clock()
		while true do
			task.wait(0.25)
			local now = os.clock()
			local dt = now - last
			last = now
			local t = Lighting.ClockTime
			local speed = if isNight(t) then Config.NightSpeed else 1
			local nt = t + dt * hoursPerSecond * speed
			if t < Config.NightEnd and nt >= Config.NightEnd then
				local day = (Workspace:GetAttribute("Day") or 1) + 1
				Workspace:SetAttribute("Day", day)
				TimeService.newDay:Fire(day)
			end
			Lighting.ClockTime = nt % 24
		end
	end)
	-- weather: occasional showers, rarely at night
	task.spawn(function()
		while true do
			task.wait(rng:NextInteger(240, 600))
			if rng:NextNumber() < 0.35 then
				Workspace:SetAttribute("Raining", true)
				task.wait(rng:NextInteger(90, 240))
				Workspace:SetAttribute("Raining", false)
			end
		end
	end)
end

function TimeService.isNight(): boolean
	return isNight(Lighting.ClockTime)
end

return TimeService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1327">
          <Properties>
            <string name="Name">VehicleService</string>
            <string name="Source"><![CDATA[-- VehicleService: dealerships (display models, buying) and your own vehicles. Owned vehicles are
-- called up from the phone or the dealer; only the owner can take the driver's seat, and the
-- driver gets network ownership so the client-side controller can drive it smoothly.

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Vehicles = require(Shared.Data.Vehicles)
local VehicleModels = require(Shared.Models.VehicleModels)
local CityLayout = require(Shared.World.CityLayout)

local DataService = require(script.Parent.DataService)
local PlotService = require(script.Parent.PlotService)
local MarketService = require(script.Parent.MarketService)

local VehicleService = {}

local V = Net.V
local rng = Random.new()
local folder: Folder
local active: { [Player]: Model } = {}
local lastSpawn: { [Player]: number } = {}

local function plateFor(player: Player): string
	local p = DataService.get(player)
	if p and not p.plate then
		p.plate = Vehicles.plate(Random.new(player.UserId))
		DataService.touch(player)
	end
	return p and p.plate or "34 PC 001"
end

local function despawn(player: Player)
	local m = active[player]
	if m then
		local seat = m:FindFirstChild("Driver") :: VehicleSeat?
		if seat and seat.Occupant then
			seat.Occupant.Sit = false
		end
		m.Parent = nil
		m:Destroy()
		active[player] = nil
	end
end

-- A spot on the nearest road beside the player, in the right-hand lane, facing along it.
local function roadSpot(pos: Vector3): CFrame
	local road, closest = CityLayout.nearestRoad(pos)
	if road and closest then
		local d2 = road.b - road.a
		local dir = if d2.Magnitude > 1e-3 then Vector3.new(d2.X, 0, d2.Y).Unit else Vector3.new(0, 0, 1)
		-- drive in the direction that keeps the player's side on the right
		local toPlayer = Vector3.new(pos.X - closest.X, 0, pos.Z - closest.Y)
		local right = Vector3.new(-dir.Z, 0, dir.X)
		if toPlayer:Dot(right) < 0 then
			dir = -dir
			right = -right
		end
		local lane = Vector3.new(closest.X, CityLayout.ROAD_Y, closest.Y) + right * road.width * 0.22
		return CFrame.lookAt(lane, lane + dir)
	end
	return CFrame.new(pos + Vector3.new(6, 0, 0))
end

local function spawnFor(player: Player, id: string)
	local p = DataService.get(player)
	local def = Vehicles.get(id)
	if not p or not def or not p.vehicles[id] then
		return { ok = false, err = "not_owned" }
	end
	if lastSpawn[player] and os.clock() - lastSpawn[player] < 4 then
		return { ok = false, err = "wait" }
	end
	lastSpawn[player] = os.clock()
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return { ok = false }
	end
	despawn(player)
	local cf = roadSpot(root.Position)
	-- the parking space in front of your shop, if you bought one and you're nearby
	local shop = PlotService.shopOf(player)
	if shop and p.shop.items.parking then
		local park = shop.points and shop.points:FindFirstChild("Parking")
		if park and (park.Position - root.Position).Magnitude < 80 then
			cf = CFrame.new(park.Position.X, CityLayout.ROAD_Y, park.Position.Z) * park.CFrame.Rotation
		end
	end
	local m = VehicleModels.build(nil, def, cf, { color = p.vehicles[id].color or 1, plate = plateFor(player) })
	m.Name = player.Name .. "_" .. id
	m:SetAttribute("Owner", player.UserId)
	m.Parent = folder
	active[player] = m
	local seat = m:FindFirstChild("Driver") :: VehicleSeat
	local conn
	conn = seat:GetPropertyChangedSignal("Occupant"):Connect(function()
		if not m.Parent then
			conn:Disconnect()
			return
		end
		local hum = seat.Occupant
		local chassis = m.PrimaryPart
		if not hum then
			pcall(function()
				chassis:SetNetworkOwnershipAuto()
			end)
			return
		end
		local who = Players:GetPlayerFromCharacter(hum.Parent)
		if who ~= player then
			-- only the owner drives
			hum.Sit = false
			return
		end
		pcall(function()
			chassis:SetNetworkOwner(player)
		end)
	end)
	-- seat the owner right away
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum then
		task.defer(function()
			-- the car may be gone again (parked or the player left) before this runs
			pcall(function()
				if seat.Parent and hum.Parent then
					seat:Sit(hum)
				end
			end)
		end)
	end
	return { ok = true }
end

local function buy(player: Player, payload)
	if not V.tbl(payload) or not V.id(payload.id) then
		return { ok = false }
	end
	local def = Vehicles.get(payload.id)
	local p = DataService.get(player)
	if not def or not p then
		return { ok = false }
	end
	if p.vehicles[def.id] then
		return { ok = false, err = "owned" }
	end
	if p.level < (def.level or 1) then
		return { ok = false, err = "level" }
	end
	local color = if V.int(payload.color, 1, #def.colors) then payload.color else 1
	if not DataService.money(player, -def.price, "vehicle") then
		return { ok = false, err = "money" }
	end
	p.vehicles[def.id] = { color = color }
	DataService.addXp(player, math.floor(def.price / 200) + 20)
	DataService.touch(player)
	return { ok = true }
end

local function placeDisplays()
	local counters = {}
	for _, marker in CollectionService:GetTagged("DealerDisplay") do
		local dealer = marker:GetAttribute("Dealer")
		local list = {}
		for _, v in Vehicles.list do
			if v.dealer == dealer then
				table.insert(list, v)
			end
		end
		if #list > 0 then
			counters[dealer] = (counters[dealer] or 0) + 1
			local def = list[((counters[dealer] - 1) % #list) + 1]
			local cf = (marker :: BasePart).CFrame * CFrame.new(0, -0.5, 0)
			local m = VehicleModels.build(folder, def, cf, { color = rng:NextInteger(1, #def.colors), plate = "GALERİ", static = true })
			m.Name = "Display_" .. def.id
			m:SetAttribute("Display", true)
		end
	end
end

function VehicleService.init()
	folder = Instance.new("Folder")
	folder.Name = "Vehicles"
	folder.Parent = Workspace
end

function VehicleService.start()
	task.defer(placeDisplays)
	MarketService.opened:Connect(function(player, service)
		if service == "cars" or service == "bikes" or service == "bicycles" then
			local p = DataService.get(player)
			Net.push(player, "dealer.open", { dealer = service, owned = p and p.vehicles or {} })
		end
	end)
	Net.handle("vehicle.buy", buy)
	Net.handle("vehicle.spawn", function(player, payload)
		if not V.tbl(payload) or not V.id(payload.id) then
			return { ok = false }
		end
		return spawnFor(player, payload.id)
	end)
	Net.handle("vehicle.despawn", function(player)
		despawn(player)
		return { ok = true }
	end)
	Players.PlayerRemoving:Connect(function(player)
		despawn(player)
		lastSpawn[player] = nil
	end)
end

function VehicleService.active(player: Player): Model?
	return active[player]
end

return VehicleService
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="1328">
        <Properties>
          <string name="Name">World</string>
        </Properties>
        <Item class="ModuleScript" referent="1329">
          <Properties>
            <string name="Name">Blocks</string>
            <string name="Source"><![CDATA[-- Blocks: the ordinary city fabric between the landmarks — houses, apartment blocks, office
-- towers, historic streets, warehouses and seaside hotels — chosen by district.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local B = require(Shared.Util.Builder)
local Rand = require(Shared.Util.Rand)
local Props = require(Shared.Models.Props)
local Buildings = require(Shared.Models.Buildings)
local CityLayout = require(Shared.World.CityLayout)

local Blocks = {}
local M = Enum.Material
local P = B.Palette
local WALK_Y = CityLayout.WALK_Y

local GROUND = {
	SUB = { M.Grass, Color3.fromRGB(104, 146, 76) },
	SCH = { M.Pavement, Color3.fromRGB(190, 186, 176) },
	FIR = { M.Concrete, Color3.fromRGB(170, 168, 162) },
	UNI = { M.Grass, Color3.fromRGB(104, 150, 78) },
	PRK = { M.Grass, Color3.fromRGB(100, 150, 74) },
	HOS = { M.Pavement, Color3.fromRGB(200, 198, 192) },
	IND = { M.Concrete, Color3.fromRGB(150, 150, 146) },
	SCR = { M.Ground, Color3.fromRGB(110, 96, 80) },
	DAT = { M.Concrete, Color3.fromRGB(160, 162, 166) },
	OLD = { M.Cobblestone, Color3.fromRGB(176, 164, 146) },
	DWN = { M.Pavement, Color3.fromRGB(196, 192, 184) },
	PLZ = { M.Marble, Color3.fromRGB(226, 220, 206) },
	TEC = { M.Pavement, Color3.fromRGB(190, 192, 196) },
	TEP = { M.Pavement, Color3.fromRGB(190, 192, 196) },
	DLR = { M.Concrete, Color3.fromRGB(196, 196, 194) },
	SPT = { M.Grass, Color3.fromRGB(100, 150, 74) },
	LUN = { M.Pavement, Color3.fromRGB(214, 200, 190) },
	SEA = { M.Pavement, Color3.fromRGB(220, 212, 196) },
	CST = { M.Pavement, Color3.fromRGB(226, 216, 196) },
	HAR = { M.Concrete, Color3.fromRGB(140, 142, 144) },
	MAR = { M.WoodPlanks, Color3.fromRGB(170, 140, 100) },
}

function Blocks.ground(parent: Instance, block)
	local g = GROUND[block.district] or GROUND.DWN
	local w, d = block.x1 - block.x0, block.z1 - block.z0
	local base = B.box(parent, CFrame.new((block.x0 + block.x1) / 2, WALK_Y / 2, (block.z0 + block.z1) / 2), Vector3.new(w, WALK_Y, d), g[2], g[1])
	base.Name = "Ground"
	return base
end

-- Splits a strip into building lots of roughly `lot` width.
local function lots(x0: number, x1: number, lot: number, rng: Random)
	local out = {}
	local x = x0
	while x1 - x > lot * 0.6 do
		local w = math.min(x1 - x, lot * Rand.range(rng, 0.8, 1.25))
		if x1 - (x + w) < lot * 0.6 then
			w = x1 - x
		end
		table.insert(out, { x = x + w / 2, w = w })
		x += w
	end
	return out
end

-- Fills one half of a block. face = "n" (front on z0, facing north) or "s" (front on z1, facing south).
local function half(parent: Instance, block, face: string, rng: Random)
	local district = block.district
	local zFront = if face == "n" then block.z0 else block.z1
	local look = if face == "n" then Vector3.new(0, 0, -1) else Vector3.new(0, 0, 1)
	local depth = (block.z1 - block.z0) / 2 - 4
	local function frontCf(x: number, inset: number?)
		local p = Vector3.new(x, WALK_Y, zFront - look.Z * (inset or 0))
		return CFrame.lookAt(p, p + look)
	end

	if district == "SUB" then
		if rng:NextNumber() < 0.22 then
			-- a row of small apartment blocks with a corner shop
			for i, l in lots(block.x0 + 4, block.x1 - 4, 46, rng) do
				Buildings.building(parent, frontCf(l.x, 6), {
					w = l.w - 6, d = math.min(depth - 8, 30), floors = rng:NextInteger(3, 5), style = "apartment", rng = rng,
					ground = if i == 1 then "shop" else "plain", roof = if rng:NextNumber() < 0.4 then "gable" else nil,
				})
			end
		else
			for _, l in lots(block.x0 + 2, block.x1 - 2, 40, rng) do
				Buildings.house(parent, frontCf(l.x), l.w, depth, rng)
			end
		end
	elseif district == "DWN" then
		for _, l in lots(block.x0 + 2, block.x1 - 2, 62, rng) do
			local style = Rand.pick(rng, { "modern", "modern", "office", "office", "apartment" })
			local tall = rng:NextNumber() < 0.4
			Buildings.building(parent, frontCf(l.x, 4), {
				w = l.w - 4, d = math.min(depth - 4, 56), floors = if tall then rng:NextInteger(9, 16) else rng:NextInteger(4, 8),
				floorH = 13, style = style, rng = rng, ground = if rng:NextNumber() < 0.6 then "shop" else "lobby",
				name = if rng:NextNumber() < 0.5 then Rand.pick(rng, { "Plaza İş Merkezi", "Kule 34", "Atlas Ofis", "Merkez Han", "Yıldız Tower", "Business Park", "Global Center" }) else nil,
			})
		end
		for _ = 1, 2 do
			local x = Rand.range(rng, block.x0 + 12, block.x1 - 12)
			Props.planter(parent, frontCf(x, 3), rng)
		end
	elseif district == "OLD" then
		for _, l in lots(block.x0 + 1, block.x1 - 1, 22, rng) do
			Buildings.building(parent, frontCf(l.x, 1), {
				w = l.w - 0.5, d = math.min(depth - 2, 34), floors = rng:NextInteger(2, 4), floorH = 12, style = "historic", rng = rng,
				ground = "shop", shops = 1, roof = if rng:NextNumber() < 0.55 then "gable" else nil, blankSides = true,
			})
		end
	elseif district == "SEA" then
		for _, l in lots(block.x0 + 2, block.x1 - 2, 56, rng) do
			Buildings.building(parent, frontCf(l.x, 10), {
				w = l.w - 6, d = math.min(depth - 10, 36), floors = rng:NextInteger(5, 8), style = "apartment", rng = rng,
				ground = "shop", name = Rand.pick(rng, { "Martı Kafe", "Deniz Restoran", "Sahil Pansiyon", "Lagün Otel", "Mavi Bistro", "Yakamoz Cafe" }),
			})
			for t = 1, 3 do
				local x = l.x - l.w / 2 + 6 + t * (l.w - 12) / 4
				Props.parasolTable(parent, frontCf(x, 5), nil, rng)
			end
		end
	elseif district == "CST" then
		for _, l in lots(block.x0 + 2, block.x1 - 2, 36, rng) do
			local m = Buildings.building(parent, frontCf(l.x, 8), {
				w = l.w - 8, d = math.min(depth - 8, 24), floors = rng:NextInteger(1, 2), floorH = 12, style = "apartment",
				wallColor = { 246, 246, 242 }, rng = rng, ground = "shop", blankSides = true,
				name = Rand.pick(rng, { "Plaj Büfe", "Dalga Bar", "Kumsal Cafe", "Güneş Dondurma", "Balıkçı Sefa", "Ada Çay Bahçesi", "Sörf Kulübü" }),
				accent = Rand.pick(rng, { { 30, 110, 190 }, { 20, 150, 170 }, { 230, 120, 40 } }),
			})
			m.Name = "BeachHouse"
			Props.parasolTable(parent, frontCf(l.x - 6, 4), nil, rng)
			Props.parasolTable(parent, frontCf(l.x + 6, 4), nil, rng)
		end
	elseif district == "IND" or district == "HAR" then
		local w = block.x1 - block.x0 - 16
		Buildings.warehouse(parent, frontCf((block.x0 + block.x1) / 2, 10), w, math.min(depth - 14, 70), rng, {
			sign = Rand.pick(rng, { "ÖZTÜRK METAL", "ANADOLU LOJİSTİK", "EGE PLASTİK", "YILMAZ MAKİNA", "KARDEŞLER TEKSTİL", "MARMARA GIDA", "DEMİR DÖKÜM" }),
			chimney = rng:NextNumber() < 0.5,
		})
		for _ = 1, 4 do
			local x = Rand.range(rng, block.x0 + 10, block.x1 - 10)
			Props.pallet(parent, frontCf(x, 5))
		end
		Props.barrel(parent, frontCf(block.x0 + 8, 4), { 200, 60, 40 })
		Props.barrel(parent, frontCf(block.x0 + 11, 4))
	else
		-- anything else: a mid-rise mixed building
		Buildings.building(parent, frontCf((block.x0 + block.x1) / 2, 6), {
			w = block.x1 - block.x0 - 20, d = math.min(depth - 8, 40), floors = rng:NextInteger(3, 6), style = "apartment", rng = rng, ground = "shop",
		})
	end
end
Blocks.half = half

-- The service alley between the two rows of shop plots.
function Blocks.plotAlley(parent: Instance, block, rng: Random)
	local zMid = (block.z0 + block.z1) / 2
	B.box(parent, CFrame.new((block.x0 + block.x1) / 2, WALK_Y + 0.02, zMid), Vector3.new(block.x1 - block.x0 - 2, 0.06, 7), P.asphaltLight, M.Asphalt, { CanCollide = false })
	for _ = 1, 3 do
		local x = Rand.range(rng, block.x0 + 10, block.x1 - 10)
		local d = B.box(parent, CFrame.new(x, WALK_Y + 2.2, zMid), Vector3.new(6, 4.4, 3.4), Rand.pick(rng, { Color3.fromRGB(40, 110, 60), Color3.fromRGB(60, 60, 70), Color3.fromRGB(150, 60, 40) }), M.Metal)
		d.Name = "Dumpster"
	end
end

function Blocks.build(parent: Instance, yieldEvery: (() -> ())?)
	local L = CityLayout.get()
	local folder = B.folder("Blocks", parent)
	local rng = Random.new(7331)
	for _, block in L.blocks do
		local bm = B.model("Block_" .. block.id .. "_" .. block.district, folder)
		if block.district ~= "PRK" then
			Blocks.ground(bm, block)
		end
		if block.kind == "plots" then
			Blocks.plotAlley(bm, block, rng)
		else
			local used = { n = false, s = false }
			if block.pois then
				for _, pid in block.pois do
					local poi = L.poiById[pid]
					if poi and poi.site then
						if poi.site.face == "n" and poi.site.z1 < (block.z0 + block.z1) / 2 then
							used.n = true
						elseif poi.site.face == "s" then
							used.s = true
						else
							used.n, used.s = true, true
						end
					end
				end
			end
			if block.group then
				used.n, used.s = true, true
			end
			if not used.n then
				half(bm, block, "n", rng)
			end
			if not used.s then
				half(bm, block, "s", rng)
			end
		end
		if yieldEvery then
			yieldEvery()
		end
	end
	return folder
end

return Blocks
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1330">
          <Properties>
            <string name="Name">Landmarks</string>
            <string name="Source"><![CDATA[-- Landmarks: builds every named place from the layout (commerce, civic and nature groups).

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local CityLayout = require(Shared.World.CityLayout)

local Commerce = require(script.Parent.LandmarksCommerce)
local Civic = require(script.Parent.LandmarksCivic)
local Nature = require(script.Parent.LandmarksNature)

local Landmarks = {}

function Landmarks.build(parent: Instance, yieldFn: (() -> ())?)
	local L = CityLayout.get()
	Commerce.build(parent, L, yieldFn)
	Civic.build(parent, L, yieldFn)
	Nature.build(parent, L, yieldFn)
	Landmarks.errors = { Commerce.lastError, Civic.lastError, Nature.lastError }
end

return Landmarks
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1331">
          <Properties>
            <string name="Name">LandmarksCivic</string>
            <string name="Source"><![CDATA[-- Civic landmarks: Republic Square (clock tower, fountain, city hall, bank, café), the university,
-- hospital, school, fire station and stadium.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local B = require(Shared.Util.Builder)
local Rand = require(Shared.Util.Rand)
local Props = require(Shared.Models.Props)
local Buildings = require(Shared.Models.Buildings)
local CityLayout = require(Shared.World.CityLayout)
local Commerce = require(script.Parent.LandmarksCommerce)

local Civic = {}
local M = Enum.Material
local WALK_Y = CityLayout.WALK_Y

local function nc(extra)
	local t = { CanCollide = false, CanTouch = false }
	if extra then
		for k, v in extra do
			t[k] = v
		end
	end
	return t
end

local function colonnade(parent, cf: CFrame, width: number, height: number, count: number, color)
	for i = 0, count - 1 do
		local x = -width / 2 + width * (i + 0.5) / count
		B.cylY(parent, cf * CFrame.new(x, height / 2 + 1, 0), height, 2.2, color, M.Marble)
		B.box(parent, cf * CFrame.new(x, 0.5, 0), Vector3.new(3, 1, 3), color, M.Marble)
		B.box(parent, cf * CFrame.new(x, height + 1.5, 0), Vector3.new(3, 1, 3), color, M.Marble)
	end
end

----------------------------------------------------------------------------------------------------
-- Republic Square
----------------------------------------------------------------------------------------------------
local function plaza(parent, poi, rng)
	local m = B.model("RepublicSquare", parent)
	local c = poi.pos
	local center = CFrame.new(c.X, WALK_Y, c.Z)
	local marble = Color3.fromRGB(236, 232, 222)
	-- patterned paving rings
	B.cylY(m, center * CFrame.new(0, 0.05, 0), 0.1, 92, Color3.fromRGB(196, 176, 150), M.Cobblestone, nc({ CanCollide = true }))
	B.cylY(m, center * CFrame.new(0, 0.08, 0), 0.1, 74, Color3.fromRGB(226, 220, 206), M.Marble, nc({ CanCollide = true }))
	-- fountain ring around the clock tower
	B.cylY(m, center * CFrame.new(0, 1, 0), 2, 46, marble, M.Marble)
	local water = B.cylY(m, center * CFrame.new(0, 1.9, 0), 0.4, 43, Color3.fromRGB(60, 150, 190), M.Glass, nc({ Transparency = 0.25, Reflectance = 0.2 }))
	water.Name = "FountainWater"
	for i = 0, 7 do
		local a = i * math.pi / 4
		local jet = B.box(m, center * CFrame.new(math.cos(a) * 16, 2.2, math.sin(a) * 16), Vector3.new(0.6, 0.6, 0.6), marble, M.Marble, nc())
		local pe = Instance.new("ParticleEmitter")
		pe.Name = "Jet"
		pe.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		pe.Color = ColorSequence.new(Color3.fromRGB(200, 230, 255))
		pe.LightEmission = 0.3
		pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0.15) })
		pe.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
		pe.Lifetime = NumberRange.new(1.1, 1.4)
		pe.Rate = 40
		pe.Speed = NumberRange.new(14, 16)
		pe.SpreadAngle = Vector2.new(6, 6)
		pe.Acceleration = Vector3.new(0, -22, 0)
		pe.EmissionDirection = Enum.NormalId.Top
		pe.Parent = jet
	end
	-- clock tower (Izmir-style): base, shaft, clock stage, lantern
	local stone = Color3.fromRGB(230, 214, 186)
	local tower = center * CFrame.new(0, 2, 0)
	B.box(m, tower * CFrame.new(0, 3, 0), Vector3.new(12, 6, 12), stone, M.Sandstone)
	B.box(m, tower * CFrame.new(0, 17, 0), Vector3.new(8, 22, 8), stone, M.Sandstone)
	for sx = -1, 1, 2 do
		for sz = -1, 1, 2 do
			B.cylY(m, tower * CFrame.new(sx * 4, 17, sz * 4), 22, 1.4, Color3.fromRGB(214, 196, 166), M.Marble)
		end
	end
	B.box(m, tower * CFrame.new(0, 31, 0), Vector3.new(10, 6, 10), stone, M.Sandstone)
	local faces = { { Enum.NormalId.Front, 0 }, { Enum.NormalId.Back, math.pi }, { Enum.NormalId.Left, math.pi / 2 }, { Enum.NormalId.Right, -math.pi / 2 } }
	for _, f in faces do
		local faceCf = tower * CFrame.new(0, 31, 0) * CFrame.Angles(0, f[2], 0) * CFrame.new(0, 0, -5.1)
		local dial = B.cyl(m, faceCf * CFrame.Angles(0, math.pi / 2, 0), 0.2, 5, Color3.fromRGB(250, 248, 240), M.SmoothPlastic, nc({ Name = "ClockDial" }))
		dial.Name = "ClockDial"
		local hour = B.box(m, faceCf * CFrame.new(0, 0.9, -0.2), Vector3.new(0.35, 1.8, 0.1), Color3.fromRGB(20, 20, 20), M.Metal, nc({ Name = "HourHand" }))
		local minute = B.box(m, faceCf * CFrame.new(0, 1.2, -0.3), Vector3.new(0.22, 2.4, 0.1), Color3.fromRGB(20, 20, 20), M.Metal, nc({ Name = "MinuteHand" }))
		for _, hand in { hour, minute } do
			hand:SetAttribute("Pivot", faceCf * CFrame.new(0, 0, -0.25))
			hand:AddTag("ClockHand")
		end
	end
	B.box(m, tower * CFrame.new(0, 35, 0), Vector3.new(11, 1, 11), Color3.fromRGB(200, 180, 150), M.Sandstone)
	for sx = -1, 1, 2 do
		for sz = -1, 1, 2 do
			B.cylY(m, tower * CFrame.new(sx * 3, 38.5, sz * 3), 6, 1, stone, M.Marble)
		end
	end
	B.cylY(m, tower * CFrame.new(0, 42, 0), 1, 8, stone, M.Sandstone)
	B.ball(m, tower * CFrame.new(0, 44.5, 0), 6, Color3.fromRGB(110, 120, 130), M.Slate)
	B.cylY(m, tower * CFrame.new(0, 48.5, 0), 3, 0.5, Color3.fromRGB(220, 180, 80), M.Metal, nc())
	-- benches, trees and lamps around the square
	for i = 0, 11 do
		local a = i * math.pi / 6 + math.pi / 12
		local p = center * CFrame.new(math.cos(a) * 42, 0, math.sin(a) * 42)
		if i % 3 == 0 then
			Props.tree(m, p, "oak", rng)
		elseif i % 3 == 1 then
			Props.bench(m, CFrame.lookAt(p.Position, center.Position) * CFrame.Angles(0, math.pi, 0))
		else
			Props.streetLamp(m, CFrame.lookAt(p.Position, center.Position), "classic")
		end
	end
	Props.flag(m, center * CFrame.new(-30, 0, -58), 30)
	Props.flag(m, center * CFrame.new(30, 0, -58), 30)
	Props.simitCart(m, CFrame.lookAt((center * CFrame.new(26, 0, 30)).Position, center.Position))
	Props.newsKiosk(m, CFrame.lookAt((center * CFrame.new(-60, 0, 60)).Position, center.Position))
	-- city hall on the north edge, facing the square (front = local -Z = south)
	local hallCf = CFrame.lookAt(Vector3.new(c.X, WALK_Y, c.Z - 64), Vector3.new(c.X, WALK_Y, c.Z))
	local facadeCf = hallCf * CFrame.new(0, 0, -26)
	Buildings.hall(m, facadeCf, 72, 22, 16, { name = "BELEDİYE", accent = { 160, 30, 40 }, wall = { 236, 228, 210 }, wallMat = M.Limestone, floor = { 200, 190, 170 }, floorMat = M.Marble, glassFront = false, modelName = "CityHall", sign = false })
	colonnade(m, facadeCf * CFrame.new(0, 0, -4), 50, 18, 8, Color3.fromRGB(240, 236, 226))
	B.box(m, facadeCf * CFrame.new(0, 20.6, -4.5), Vector3.new(54, 1.2, 4), Color3.fromRGB(236, 228, 210), M.Limestone)
	-- triangular pediment: two wedges whose tall edges meet in the middle
	for side = -1, 1, 2 do
		B.wedge(m, facadeCf * CFrame.new(side * 13.5, 24.2, -4.5) * CFrame.Angles(0, -side * math.pi / 2, 0), Vector3.new(2, 6, 27), Color3.fromRGB(236, 228, 210), M.Limestone)
	end
	local hallSign = B.box(m, facadeCf * CFrame.new(0, 22.4, -5.8), Vector3.new(20, 2, 0.4), Color3.fromRGB(150, 30, 40), M.SmoothPlastic, nc())
	B.sign(hallSign, Enum.NormalId.Front, "BELEDİYE BAŞKANLIĞI", { color = Color3.fromRGB(250, 230, 180), font = B.Fonts.Serif })
	B.ball(m, facadeCf * CFrame.new(0, 22, 11), 18, Color3.fromRGB(90, 120, 140), M.Slate)
	for s = 0, 5 do
		B.box(m, facadeCf * CFrame.new(0, 0.2 + (5 - s) * 0.3, -(6 + s * 1.2)), Vector3.new(30 + s * 2, 0.4, 1.4), Color3.fromRGB(226, 220, 206), M.Marble)
	end
	-- leaderboard board in front of city hall
	local board = B.box(m, facadeCf * CFrame.new(-22, 6, -16), Vector3.new(10, 9, 0.6), Color3.fromRGB(30, 34, 44), M.Metal)
	board.Name = "LeaderboardBoard"
	B.tag(board, "Leaderboard")
	local anchor = B.marker(m, "ServiceAnchor", facadeCf * CFrame.new(0, 3, -14), Vector3.new(10, 6, 4))
	anchor:SetAttribute("Service", "board")
	anchor:SetAttribute("Poi", "cityhall")
	B.prompt(anchor, "Görev Panosu", "Belediye", { distance = 16, name = "ServicePrompt" })
	B.tag(anchor, "ServicePoint")
	-- bank on the east edge, café on the west edge
	local bankCf = CFrame.lookAt(Vector3.new(c.X + 66, WALK_Y, c.Z - 10), Vector3.new(c.X, WALK_Y, c.Z - 10))
	Buildings.building(m, bankCf, { w = 36, d = 24, floors = 3, floorH = 13, style = "historic", ground = "lobby", name = "ŞEHİR BANKASI", rng = rng, blankSides = true })
	Props.atm(m, bankCf * CFrame.new(-12, 0, -1))
	Props.atm(m, bankCf * CFrame.new(-8, 0, -1))
	local cafeCf = CFrame.lookAt(Vector3.new(c.X - 66, WALK_Y, c.Z + 20), Vector3.new(c.X, WALK_Y, c.Z + 20))
	Buildings.building(m, cafeCf, { w = 34, d = 22, floors = 2, floorH = 12, style = "apartment", ground = "shop", shops = 1, name = "MEYDAN KAFE ☕", accent = { 120, 70, 40 }, rng = rng, blankSides = true })
	for i = 0, 3 do
		Props.parasolTable(m, cafeCf * CFrame.new(-12 + i * 8, 0, -8), { 120, 70, 40 }, rng)
	end
	return m
end

----------------------------------------------------------------------------------------------------
-- University campus
----------------------------------------------------------------------------------------------------
local function university(parent, poi, rng)
	local b = poi.site
	local m = B.model("University", parent)
	local cx, cz = (b.x0 + b.x1) / 2, (b.z0 + b.z1) / 2
	-- main building along the south (facing the quad and Park Caddesi)
	local mainCf = CFrame.lookAt(Vector3.new(cx, WALK_Y, b.z1 - 70), Vector3.new(cx, WALK_Y, b.z1 + 10))
	Buildings.building(m, mainCf, { w = 140, d = 40, floors = 4, floorH = 14, style = "historic", ground = "lobby", name = "TEKNİK ÜNİVERSİTE", rng = rng, roof = "gable" })
	colonnade(m, mainCf * CFrame.new(0, 0, -3), 40, 18, 6, Color3.fromRGB(240, 236, 226))
	-- library (modern glass box) on the east side
	local libCf = CFrame.lookAt(Vector3.new(b.x1 - 70, WALK_Y, cz - 20), Vector3.new(b.x1 - 140, WALK_Y, cz - 20))
	Buildings.building(m, libCf, { w = 70, d = 46, floors = 3, floorH = 14, style = "modern", ground = "lobby", name = "KÜTÜPHANE", rng = rng, glassColor = { 80, 120, 140 } })
	-- dorms on the west side
	for k = 0, 1 do
		local dormCf = CFrame.lookAt(Vector3.new(b.x0 + 40, WALK_Y, b.z0 + 70 + k * 110), Vector3.new(b.x0 + 140, WALK_Y, b.z0 + 70 + k * 110))
		Buildings.building(m, dormCf, { w = 70, d = 30, floors = 6, style = "apartment", ground = "lobby", name = "ÖĞRENCİ YURDU " .. (k + 1), rng = rng })
	end
	-- the quad: lawn paths, trees, statue, fountain
	local quad = CFrame.new(cx, WALK_Y, cz - 30)
	B.box(m, quad * CFrame.new(0, 0.05, 0), Vector3.new(14, 0.1, 220), Color3.fromRGB(200, 190, 170), M.Pavement, nc({ CanCollide = true }))
	B.box(m, quad * CFrame.new(0, 0.05, 0), Vector3.new(220, 0.1, 14), Color3.fromRGB(200, 190, 170), M.Pavement, nc({ CanCollide = true }))
	B.cylY(m, quad * CFrame.new(0, 1.5, 0), 3, 8, Color3.fromRGB(200, 196, 190), M.Granite)
	B.box(m, quad * CFrame.new(0, 6, 0), Vector3.new(2, 6, 2), Color3.fromRGB(110, 90, 60), M.Metal)
	B.ball(m, quad * CFrame.new(0, 10, 0), 3, Color3.fromRGB(110, 90, 60), M.Metal)
	for _ = 1, 26 do
		local p = quad * CFrame.new(Rand.range(rng, -150, 150), 0, Rand.range(rng, -130, 110))
		if math.abs(p.X - cx) > 12 and math.abs(p.Z - (cz - 30)) > 12 then
			Props.tree(m, p, Rand.pick(rng, { "oak", "oak", "birch", "pine" }), rng)
		end
	end
	for i = 0, 5 do
		Props.bench(m, quad * CFrame.new(-60 + i * 24, 0, 12))
	end
	-- basketball court
	local court = CFrame.new(b.x1 - 60, WALK_Y, b.z0 + 50)
	B.box(m, court * CFrame.new(0, 0.06, 0), Vector3.new(50, 0.12, 28), Color3.fromRGB(190, 90, 60), M.SmoothPlastic, nc({ CanCollide = true }))
	for k = -1, 1, 2 do
		B.cylY(m, court * CFrame.new(k * 24, 5, 0), 10, 0.5, Color3.fromRGB(60, 60, 64), M.Metal)
		B.box(m, court * CFrame.new(k * 23.4, 10, 0), Vector3.new(0.3, 3.4, 5), Color3.fromRGB(240, 240, 240), M.SmoothPlastic)
		B.cylY(m, court * CFrame.new(k * 22.4, 9, 0), 0.2, 1.8, Color3.fromRGB(230, 90, 30), M.Metal, nc())
	end
	return m
end

----------------------------------------------------------------------------------------------------
-- Hospital, school, fire station, stadium
----------------------------------------------------------------------------------------------------
local function hospital(parent, poi, rng)
	local cf, w, d = Commerce.siteFrame(poi, 10)
	local m = Buildings.building(parent, cf, { w = w - 30, d = d - 30, floors = 8, floorH = 13, style = "office", ground = "lobby", name = "ŞEHİR HASTANESİ", rng = rng, wallColor = { 240, 242, 246 }, glassColor = { 70, 120, 150 } })
	local H = 8 * 13
	local roof = cf * CFrame.new(0, H + 1.4, (d - 30) / 2)
	B.cylY(m, roof, 0.4, 30, Color3.fromRGB(80, 84, 90), M.Concrete)
	B.box(m, roof * CFrame.new(0, 0.25, 0), Vector3.new(4, 0.1, 18), Color3.fromRGB(240, 240, 240), M.SmoothPlastic, nc())
	B.box(m, roof * CFrame.new(0, 0.25, 0), Vector3.new(14, 0.1, 4), Color3.fromRGB(240, 240, 240), M.SmoothPlastic, nc())
	local cross = B.box(m, cf * CFrame.new(-(w - 30) / 2 + 10, H - 10, -1), Vector3.new(10, 10, 1), Color3.fromRGB(255, 255, 255), M.SmoothPlastic)
	B.sign(cross, Enum.NormalId.Front, "☾", { color = Color3.fromRGB(220, 20, 30), glow = true })
	local er = B.box(m, cf * CFrame.new((w - 30) / 2 - 12, 11, -2), Vector3.new(14, 3, 1), Color3.fromRGB(200, 20, 30), M.Neon, nc())
	B.sign(er, Enum.NormalId.Front, "ACİL", { color = Color3.new(1, 1, 1) })
	-- ambulance bay
	B.box(parent, cf * CFrame.new((w - 30) / 2 - 12, 0.05, -10), Vector3.new(16, 0.1, 14), Color3.fromRGB(240, 200, 40), M.SmoothPlastic, nc({ CanCollide = true }))
	return m
end

local function school(parent, poi, rng)
	local cf, w, d = Commerce.siteFrame(poi, 8)
	local m = Buildings.building(parent, cf * CFrame.new(0, 0, d / 2 - 10), { w = w - 30, d = 34, floors = 3, floorH = 12, style = "apartment", wallColor = { 238, 210, 160 }, ground = "lobby", name = "ATATÜRK İLKOKULU", rng = rng, roof = "gable" })
	-- schoolyard with court markings and hoops
	local yard = cf * CFrame.new(0, 0.06, d / 4 - 6)
	B.box(parent, yard, Vector3.new(w - 30, 0.12, d / 2 - 22), Color3.fromRGB(70, 110, 160), M.SmoothPlastic, nc({ CanCollide = true }))
	B.box(parent, yard * CFrame.new(0, 0.07, 0), Vector3.new(0.5, 0.02, d / 2 - 26), Color3.new(1, 1, 1), M.SmoothPlastic, nc())
	B.cylY(parent, yard * CFrame.new(0, 0.07, 0), 0.02, 12, Color3.new(1, 1, 1), M.SmoothPlastic, nc())
	for k = -1, 1, 2 do
		B.cylY(parent, yard * CFrame.new(k * (w / 2 - 22), 5, 0), 10, 0.5, Color3.fromRGB(60, 60, 64), M.Metal)
		B.box(parent, yard * CFrame.new(k * (w / 2 - 22.6), 10, 0), Vector3.new(0.3, 3, 4.6), Color3.fromRGB(240, 240, 240), M.SmoothPlastic)
	end
	Props.flag(parent, cf * CFrame.new(-w / 2 + 14, 0, 6), 24)
	Props.fence(parent, (cf * CFrame.new(-w / 2 + 4, 0, 2)).Position, (cf * CFrame.new(-6, 0, 2)).Position, "metal", 6)
	Props.fence(parent, (cf * CFrame.new(6, 0, 2)).Position, (cf * CFrame.new(w / 2 - 4, 0, 2)).Position, "metal", 6)
	return m
end

local function fireStation(parent, poi, _rng)
	local cf, w, _d = Commerce.siteFrame(poi, 8)
	local m = B.model("FireStation", parent)
	local brick = Color3.fromRGB(160, 60, 46)
	local bw, bd, bh = w - 40, 50, 22
	B.box(m, cf * CFrame.new(0, bh / 2, bd / 2 + 4), Vector3.new(bw, bh, bd), brick, M.Brick)
	for i = -1, 1 do
		local door = B.box(m, cf * CFrame.new(i * 22, 7.5, 3.6), Vector3.new(16, 15, 0.4), Color3.fromRGB(200, 40, 30), M.DiamondPlate)
		door.Name = "GarageDoor"
		for k = 0, 2 do
			B.box(m, cf * CFrame.new(i * 22, 9 + k * 2, 3.3), Vector3.new(14, 0.8, 0.2), Color3.fromRGB(180, 210, 230), M.Glass, nc({ Transparency = 0.3 }))
		end
	end
	local sign = B.box(m, cf * CFrame.new(0, bh - 3, 3.4), Vector3.new(30, 3, 0.4), Color3.fromRGB(240, 240, 240), M.SmoothPlastic)
	B.sign(sign, Enum.NormalId.Front, "İTFAİYE 112", { color = Color3.fromRGB(200, 30, 30) })
	-- drill tower
	B.box(m, cf * CFrame.new(bw / 2 + 10, 25, 20), Vector3.new(12, 50, 12), brick, M.Brick)
	-- fire truck parked out front
	local truck = cf * CFrame.new(-22, 0, -14)
	B.box(m, truck * CFrame.new(0, 4, 0), Vector3.new(9, 6, 26), Color3.fromRGB(200, 30, 30), M.Metal)
	B.box(m, truck * CFrame.new(0, 6.6, -10.5), Vector3.new(8.6, 3.4, 4.6), Color3.fromRGB(150, 190, 220), M.Glass, { Transparency = 0.4 })
	B.box(m, truck * CFrame.new(0, 7.6, 3), Vector3.new(2, 1, 20), Color3.fromRGB(200, 200, 205), M.Metal)
	for _, z in { -8, 0, 8 } do
		for x = -1, 1, 2 do
			B.cyl(m, truck * CFrame.new(x * 4.4, 1.8, z), 1.4, 3.6, Color3.fromRGB(26, 26, 26), M.Rubber)
		end
	end
	local bar = B.box(m, truck * CFrame.new(0, 7.4, -9), Vector3.new(6, 0.6, 1), Color3.fromRGB(40, 80, 255), M.Neon, nc())
	bar:AddTag("Siren")
	return m
end

local function stadium(parent, poi, _rng)
	local _cf, w, d = Commerce.siteFrame(poi, 6)
	local m = B.model("Stadium", parent)
	local c = poi.pos
	local center = CFrame.new(c.X, WALK_Y, c.Z)
	local pw, pd = math.min(w - 50, 120), math.min(d - 50, 90)
	B.box(m, center * CFrame.new(0, 0.1, 0), Vector3.new(pw + 12, 0.2, pd + 12), Color3.fromRGB(80, 150, 70), M.Grass)
	for k = -3, 3 do
		B.box(m, center * CFrame.new(k * pw / 7, 0.21, 0), Vector3.new(pw / 7, 0.02, pd), if k % 2 == 0 then Color3.fromRGB(86, 160, 74) else Color3.fromRGB(74, 146, 66), M.Grass, nc())
	end
	local white = Color3.fromRGB(245, 245, 245)
	B.box(m, center * CFrame.new(0, 0.24, 0), Vector3.new(0.5, 0.02, pd), white, M.SmoothPlastic, nc())
	B.box(m, center * CFrame.new(0, 0.24, -pd / 2), Vector3.new(pw, 0.02, 0.5), white, M.SmoothPlastic, nc())
	B.box(m, center * CFrame.new(0, 0.24, pd / 2), Vector3.new(pw, 0.02, 0.5), white, M.SmoothPlastic, nc())
	B.box(m, center * CFrame.new(-pw / 2, 0.24, 0), Vector3.new(0.5, 0.02, pd), white, M.SmoothPlastic, nc())
	B.box(m, center * CFrame.new(pw / 2, 0.24, 0), Vector3.new(0.5, 0.02, pd), white, M.SmoothPlastic, nc())
	for k = -1, 1, 2 do
		local goal = center * CFrame.new(k * (pw / 2 + 0.5), 0, 0)
		B.box(m, goal * CFrame.new(0, 4, -6), Vector3.new(0.4, 8, 0.4), white, M.Metal)
		B.box(m, goal * CFrame.new(0, 4, 6), Vector3.new(0.4, 8, 0.4), white, M.Metal)
		B.box(m, goal * CFrame.new(0, 8, 0), Vector3.new(0.4, 0.4, 12.4), white, M.Metal)
		B.box(m, goal * CFrame.new(k * 3, 4, 0), Vector3.new(0.1, 8, 12), white, M.ForceField, nc({ Transparency = 0.6 }))
	end
	-- stands (stepped) on all sides
	-- a stand faces the pitch and rises away from it (local +Z)
	local function stand(pos: Vector3, length: number)
		local cf2 = CFrame.lookAt(pos, Vector3.new(center.X, pos.Y, center.Z))
		for s = 0, 6 do
			B.box(m, cf2 * CFrame.new(0, 1 + s * 1.6, s * 2.4), Vector3.new(length, 2, 2.6), if s % 2 == 0 then Color3.fromRGB(200, 30, 40) else Color3.fromRGB(240, 240, 240), M.SmoothPlastic)
		end
		B.box(m, cf2 * CFrame.new(0, 7, 17), Vector3.new(length, 14, 1), Color3.fromRGB(170, 170, 176), M.Concrete)
	end
	stand((center * CFrame.new(0, 0, pd / 2 + 10)).Position, pw + 10)
	stand((center * CFrame.new(0, 0, -(pd / 2 + 10))).Position, pw + 10)
	stand((center * CFrame.new(pw / 2 + 10, 0, 0)).Position, pd)
	stand((center * CFrame.new(-(pw / 2 + 10), 0, 0)).Position, pd)
	-- floodlights
	for sx = -1, 1, 2 do
		for sz = -1, 1, 2 do
			local p = center * CFrame.new(sx * (pw / 2 + 24), 0, sz * (pd / 2 + 24))
			B.box(m, p * CFrame.new(0, 22, 0), Vector3.new(1.4, 44, 1.4), Color3.fromRGB(150, 150, 156), M.Metal)
			local head = B.box(m, CFrame.lookAt((p * CFrame.new(0, 44, 0)).Position, center.Position), Vector3.new(8, 4, 1), Color3.fromRGB(240, 240, 250), M.Neon, nc({ Name = "Floodlight" }))
			local l = B.spotLight(head, Enum.NormalId.Front, 60, 70, 2.5, Color3.fromRGB(255, 255, 250), false)
			l.Enabled = false
			head:AddTag("NightLight")
		end
	end
	local board = B.box(m, center * CFrame.new(0, 20, -(pd / 2 + 30)), Vector3.new(30, 10, 1), Color3.fromRGB(10, 10, 12), M.SmoothPlastic)
	B.sign(board, Enum.NormalId.Back, "TAMİRSPOR 2 - 1 ÇİPSPOR", { glow = true, color = Color3.fromRGB(255, 200, 40), font = B.Fonts.Mono })
	return m
end

function Civic.build(parent: Instance, L, yieldFn: (() -> ())?)
	local rng = Random.new(1923)
	local folder = B.folder("Civic", parent)
	local builders = { plaza = plaza, university = university, hospital = hospital, school = school, fire_station = fireStation, stadium = stadium }
	for id, fn in builders do
		local poi = L.poiById[id]
		if poi then
			local ok, err = pcall(fn, folder, poi, rng)
			if not ok then
				warn("[World] failed to build " .. id .. ": " .. tostring(err))
				Civic.lastError = err
			end
			if yieldFn then
				yieldFn()
			end
		end
	end
	return folder
end

return Civic
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1332">
          <Properties>
            <string name="Name">LandmarksCommerce</string>
            <string name="Source"><![CDATA[-- Commerce landmarks: every shop, market and dealer the player visits, plus food places and other
-- businesses that fill the commercial streets. Service counters are tagged "ServicePoint" with
-- attributes Service / Poi / ClerkCF so the gameplay services can hook them up.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local B = require(Shared.Util.Builder)
local Rand = require(Shared.Util.Rand)
local Props = require(Shared.Models.Props)
local Buildings = require(Shared.Models.Buildings)
local CityLayout = require(Shared.World.CityLayout)

local Commerce = {}
local M = Enum.Material
local WALK_Y = CityLayout.WALK_Y

local function nc(extra)
	local t = { CanCollide = false, CanTouch = false }
	if extra then
		for k, v in extra do
			t[k] = v
		end
	end
	return t
end

-- Front-centre frame of a POI site, facing its street.
function Commerce.siteFrame(poi, inset: number?)
	local s = poi.site
	local look = if s.face == "s" then Vector3.new(0, 0, 1) else Vector3.new(0, 0, -1)
	local z = if s.face == "s" then s.z1 else s.z0
	local p = Vector3.new((s.x0 + s.x1) / 2, WALK_Y, z - look.Z * (inset or 0))
	return CFrame.lookAt(p, p + look), s.x1 - s.x0, s.z1 - s.z0
end

-- Counter with a prompt that opens a gameplay service.
function Commerce.servicePoint(parent: Instance, cf: CFrame, service: string, poiId: string, action: string, object: string?, width: number?)
	local counter = Props.counter(parent, cf, width or 9)
	local anchor = B.marker(counter, "ServiceAnchor", cf * CFrame.new(0, 3.2, -2.2), Vector3.new(6, 6, 2))
	anchor:SetAttribute("Service", service)
	anchor:SetAttribute("Poi", poiId)
	anchor:SetAttribute("ClerkCF", cf * CFrame.new(0, 0, 3))
	B.prompt(anchor, action, object, { distance = 14, name = "ServicePrompt" })
	B.tag(anchor, "ServicePoint")
	-- a cash register and a monitor on the counter
	Props.monitor(counter, cf * CFrame.new(-(width or 9) / 2 + 2, 4, 0.2), "", Color3.fromRGB(12, 40, 70))
	B.box(counter, cf * CFrame.new((width or 9) / 2 - 2, 4.5, 0.3), Vector3.new(1.8, 1, 1.4), Color3.fromRGB(30, 30, 34), M.SmoothPlastic, nc())
	return anchor
end

-- A clerk-less "talk" spot (staff agency desk, police front desk...).
local function deskRow(parent: Instance, cf: CFrame, n: number, rng: Random)
	for i = 1, n do
		local c = cf * CFrame.new((i - (n + 1) / 2) * 8, 0, 0)
		B.box(parent, c * CFrame.new(0, 1.8, 0), Vector3.new(6, 0.3, 3.2), Color3.fromRGB(150, 110, 80), M.Wood)
		for x = -1, 1, 2 do
			B.box(parent, c * CFrame.new(x * 2.7, 0.9, 0), Vector3.new(0.3, 1.8, 3), Color3.fromRGB(60, 60, 64), M.Metal)
		end
		Props.monitor(parent, c * CFrame.new(0, 1.95, 0.6), "", Color3.fromRGB(20, 50, 90))
		Props.chair(parent, c * CFrame.new(0, 0, 2.4) * CFrame.Angles(0, math.pi, 0), Rand.pick(rng, { { 40, 40, 44 }, { 30, 60, 120 } }))
	end
end

