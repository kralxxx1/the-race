        <Item class="ModuleScript" referent="1306">
          <Properties>
            <string name="Name">Format</string>
            <string name="Source"><![CDATA[-- Format: money, numbers, durations and clock strings for both languages.

local Config = require(script.Parent.Parent.Config)

local Format = {}

local function groupDigits(n: number, sep: string): string
	local s = tostring(math.floor(math.abs(n) + 0.5))
	local out = s:reverse():gsub("(%d%d%d)", "%1" .. sep):reverse()
	if string.sub(out, 1, #sep) == sep then
		out = string.sub(out, #sep + 1)
	end
	return out
end

-- "$12,345" (en) / "$12.345" (tr)
function Format.money(n: number, lang: string?): string
	local sep = if lang == "en" then "," else "."
	local sign = if n < 0 then "-" else ""
	return sign .. Config.CurrencySymbol .. groupDigits(n, sep)
end

function Format.number(n: number, lang: string?): string
	local sep = if lang == "en" then "," else "."
	local sign = if n < 0 then "-" else ""
	return sign .. groupDigits(n, sep)
end

-- 1.2K, 3.4M, 5.6B
function Format.compact(n: number): string
	local a = math.abs(n)
	local sign = if n < 0 then "-" else ""
	if a >= 1e9 then
		return sign .. string.format("%.1fB", a / 1e9)
	elseif a >= 1e6 then
		return sign .. string.format("%.1fM", a / 1e6)
	elseif a >= 1e4 then
		return sign .. string.format("%.1fK", a / 1e3)
	end
	return sign .. tostring(math.floor(a + 0.5))
end

-- 125 -> "2:05"
function Format.duration(seconds: number): string
	seconds = math.max(0, math.floor(seconds + 0.5))
	local m = seconds // 60
	local s = seconds % 60
	if m >= 60 then
		return string.format("%d:%02d:%02d", m // 60, m % 60, s)
	end
	return string.format("%d:%02d", m, s)
end

-- 14.5 -> "14:30"
function Format.clock(clockTime: number): string
	local h = math.floor(clockTime) % 24
	local m = math.floor((clockTime % 1) * 60)
	return string.format("%02d:%02d", h, m)
end

function Format.percent(x: number): string
	return string.format("%d%%", math.floor(x * 100 + 0.5))
end

-- Storage sizes: 512 -> "512 GB", 2048 -> "2 TB"
function Format.storage(gb: number): string
	if gb >= 1000 then
		local tb = gb / 1000
		if tb == math.floor(tb) then
			return string.format("%d TB", tb)
		end
		return string.format("%.1f TB", tb)
	end
	return string.format("%d GB", gb)
end

-- "★★★★☆"
function Format.stars(rating: number): string
	local full = math.clamp(math.floor(rating + 0.5), 0, 5)
	return string.rep("★", full) .. string.rep("☆", 5 - full)
end

return Format
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1307">
          <Properties>
            <string name="Name">Rand</string>
            <string name="Source"><![CDATA[-- Rand: deterministic helpers on top of Roblox's Random.
-- Everything procedural (city, customers, devices, market listings) takes an explicit rng so that
-- the same seed always produces the same result on the server and on every client.

local Rand = {}

export type Rng = Random

function Rand.new(seed: number?): Random
	if seed then
		return Random.new(seed)
	end
	return Random.new()
end

-- Stable 31-bit hash of a string (FNV-1a), for turning ids into seeds.
function Rand.hash(s: string): number
	local h = 2166136261
	for i = 1, #s do
		h = bit32.bxor(h, string.byte(s, i))
		h = (h * 16777619) % 4294967296
	end
	return h % 2147483647
end

function Rand.int(rng: Random, a: number, b: number): number
	return rng:NextInteger(a, b)
end

function Rand.range(rng: Random, a: number, b: number): number
	return a + (b - a) * rng:NextNumber()
end

function Rand.chance(rng: Random, p: number): boolean
	return rng:NextNumber() < p
end

function Rand.pick<T>(rng: Random, list: { T }): T
	return list[rng:NextInteger(1, #list)]
end

-- Picks from a list of entries using entry[weightKey] (default "weight") as weight.
function Rand.weighted<T>(rng: Random, list: { T }, weightKey: string?): T
	local key = weightKey or "weight"
	local total = 0
	for _, item in list do
		total += (item :: any)[key] or 1
	end
	local r = rng:NextNumber() * total
	for _, item in list do
		r -= (item :: any)[key] or 1
		if r <= 0 then
			return item
		end
	end
	return list[#list]
end

-- Picks a key of a { [key] = weight } map.
function Rand.weightedKey(rng: Random, weights: { [any]: number }): any
	local keys = {}
	local total = 0
	for k, w in weights do
		table.insert(keys, k)
		total += w
	end
	table.sort(keys, function(a, b)
		return tostring(a) < tostring(b)
	end)
	local r = rng:NextNumber() * total
	for _, k in keys do
		r -= weights[k]
		if r <= 0 then
			return k
		end
	end
	return keys[#keys]
end

function Rand.shuffle<T>(rng: Random, list: { T }): { T }
	for i = #list, 2, -1 do
		local j = rng:NextInteger(1, i)
		list[i], list[j] = list[j], list[i]
	end
	return list
end

-- Normal-ish distribution (sum of uniforms), clamped.
function Rand.gauss(rng: Random, mean: number, spread: number, lo: number?, hi: number?): number
	local v = (rng:NextNumber() + rng:NextNumber() + rng:NextNumber() - 1.5) / 1.5
	local x = mean + v * spread
	if lo then
		x = math.max(lo, x)
	end
	if hi then
		x = math.min(hi, x)
	end
	return x
end

-- Short unique id for runtime objects.
local counter = 0
function Rand.uid(prefix: string?): string
	counter += 1
	return string.format("%s%x%x", prefix or "", counter, math.random(0, 0xFFFF))
end

return Rand
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1308">
          <Properties>
            <string name="Name">Signal</string>
            <string name="Source"><![CDATA[-- Signal: a tiny event object for module-to-module communication.
-- Handlers run in their own thread so one failing listener cannot break the others.

local Signal = {}
Signal.__index = Signal

export type Connection = { Connected: boolean, Disconnect: (Connection) -> () }

function Signal.new()
	return setmetatable({ _handlers = {} :: { any } }, Signal)
end

function Signal:Connect(fn: (...any) -> ())
	local conn = { Connected = true, _fn = fn }
	local handlers = self._handlers
	function conn.Disconnect(c)
		if not c.Connected then
			return
		end
		c.Connected = false
		local i = table.find(handlers, c)
		if i then
			table.remove(handlers, i)
		end
	end
	table.insert(handlers, conn)
	return conn
end

function Signal:Once(fn: (...any) -> ())
	local conn
	conn = self:Connect(function(...)
		conn:Disconnect()
		fn(...)
	end)
	return conn
end

function Signal:Fire(...)
	-- copy so handlers may disconnect while iterating
	local list = table.clone(self._handlers)
	for _, c in list do
		if c.Connected then
			task.spawn(c._fn, ...)
		end
	end
end

function Signal:Wait()
	local thread = coroutine.running()
	self:Once(function(...)
		task.spawn(thread, ...)
	end)
	return coroutine.yield()
end

function Signal:DisconnectAll()
	for _, c in table.clone(self._handlers) do
		c:Disconnect()
	end
end

return Signal
]]></string>
          </Properties>
        </Item>
      </Item>
