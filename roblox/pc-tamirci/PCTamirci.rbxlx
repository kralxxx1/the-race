----------------------------------------------------------------------------------------------------
-- Laptop service parts, matched by laptop class.
-- classes: budget15, ultra14, business14, gaming15, gaming17
----------------------------------------------------------------------------------------------------
local LAPTOP_CLASSES = { "budget15", "ultra14", "business14", "gaming15", "gaming17" }
Parts.LaptopClasses = LAPTOP_CLASSES
local CLASS_LABEL = {
	budget15 = "15.6\" Ekonomik",
	ultra14 = "14\" İnce (Ultrabook)",
	business14 = "14\" İş Serisi",
	gaming15 = "15.6\" Oyuncu",
	gaming17 = "17.3\" Oyuncu",
}
Parts.LaptopClassLabel = CLASS_LABEL

local LAPTOP_PRICES = {
	budget15 = { battery = 35, screen = 55, keyboard = 22, fan = 15, hinge = 12, dcjack = 8 },
	ultra14 = { battery = 60, screen = 120, keyboard = 45, fan = 25, hinge = 25, dcjack = 12 },
	business14 = { battery = 55, screen = 80, keyboard = 35, fan = 20, hinge = 18, dcjack = 10 },
	gaming15 = { battery = 65, screen = 110, keyboard = 50, fan = 30, hinge = 20, dcjack = 12 },
	gaming17 = { battery = 80, screen = 150, keyboard = 60, fan = 35, hinge = 25, dcjack = 14 },
}
local LAPTOP_PART_NAMES = {
	battery = "Batarya",
	screen = "Ekran Paneli",
	keyboard = "Klavye (TR-Q)",
	fan = "Fan + Soğutucu",
	hinge = "Menteşe Seti",
	dcjack = "Şarj Soketi (DC Jack)",
}
for _, cls in LAPTOP_CLASSES do
	for kind, price in LAPTOP_PRICES[cls] do
		add({
			id = "lp_" .. kind .. "_" .. cls,
			cat = "laptop",
			sub = kind,
			lclass = cls,
			name = LAPTOP_PART_NAMES[kind] .. " — " .. CLASS_LABEL[cls],
			price = price,
		})
	end
end

----------------------------------------------------------------------------------------------------
-- Lookup and helpers
----------------------------------------------------------------------------------------------------

Parts.list = list
Parts.byId = byId
Parts.byCat = byCat

Parts.Categories = { "gpu", "cpu", "mobo", "ram", "storage", "psu", "cooler", "fan", "case", "misc", "laptop" }

function Parts.get(id: string): Part?
	return byId[id]
end

function Parts.coolerFits(cooler: Part, socket: string): boolean
	if cooler.sockets == "all" then
		return true
	end
	local amd = socket == "AM4" or socket == "AM5" or socket == "AM3" or socket == "AM3+"
	if cooler.sockets == "amd" then
		return amd and socket ~= "AM3"
	end
	if cooler.sockets == "intel" then
		return not amd and socket ~= "LGA2011-3" and socket ~= "sTR5"
	end
	return false
end

function Parts.caseFits(case: Part, form: string): boolean
	return table.find(case.forms, form) ~= nil
end

-- GPU power connector count shown on the card: returns { "8", "8" } etc.
function Parts.gpuConnectors(gpu: Part): { string }
	local p = gpu.power
	if p == "none" then
		return {}
	elseif p == "6" then
		return { "6" }
	elseif p == "8" then
		return { "8" }
	elseif p == "6+8" then
		return { "6", "8" }
	elseif p == "2x8" then
		return { "8", "8" }
	elseif p == "3x8" then
		return { "8", "8", "8" }
	elseif p == "12v" then
		return { "12v" }
	end
	return {}
end

-- Estimated wall draw used for PSU checks.
function Parts.systemDraw(cpuPart: Part?, gpuPart: Part?): number
	local w = 70
	if cpuPart then
		w += cpuPart.tdp
	end
	if gpuPart then
		w += gpuPart.tdp
	end
	return w
end

-- Short spec line for UIs ("8 GB • 115 W • 2023").
function Parts.spec(p: Part, lang: string?): string
	local en = lang == "en"
	if p.cat == "gpu" then
		return string.format("%d GB VRAM • %d W • %s %d", p.vram, p.tdp, if en then "Perf" else "Güç", math.floor(p.perf))
	elseif p.cat == "cpu" then
		return string.format("%s • %dC/%dT • %.1f GHz • %d W%s", p.socket, p.cores, p.threads, p.ghz, p.tdp, if p.igpu then "" else (if en then " • no iGPU" else " • iGPU yok"))
	elseif p.cat == "mobo" then
		return string.format("%s • %s • %s • %s%s", p.socket, p.chipset, p.form, p.mem, if p.wifi then " • Wi-Fi" else "")
	elseif p.cat == "ram" then
		return string.format("%s %s • %d GB • %d MHz%s", p.mem, p.form, p.size, p.speed, if p.rgb then " • RGB" else "")
	elseif p.cat == "storage" then
		local kind = ({ hdd35 = "HDD 3.5\"", hdd25 = "HDD 2.5\"", ssd25 = "SATA SSD", nvme = "NVMe M.2" })[p.kind]
		return string.format("%s • %s • %d MB/s", kind, if p.size >= 1000 then string.format("%g TB", p.size / 1000) else string.format("%d GB", p.size), p.speed)
	elseif p.cat == "psu" then
		return string.format("%d W • %s • %s", p.watt, p.eff, p.form)
	elseif p.cat == "cooler" then
		return string.format("%s • %d W%s", string.upper(p.kind), p.rating, if p.rgb then " • RGB" else "")
	elseif p.cat == "fan" then
		return string.format("%d mm%s", p.size, if p.rgb then " • RGB" else "")
	elseif p.cat == "case" then
		return string.format("%s • GPU ≤ %d cm", table.concat(p.forms, "/"), p.gpuMax)
	elseif p.cat == "misc" and p.uses then
		return string.format("%d %s", p.uses, if en then "uses" else "kullanım")
	elseif p.cat == "laptop" then
		return CLASS_LABEL[p.lclass]
	end
	return ""
end

return Parts
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1281">
          <Properties>
            <string name="Name">Quests</string>
            <string name="Source"><![CDATA[-- Quests: the daily tasks on the city hall board. Every player gets three a day (the same three
-- all day, new ones at midnight UTC); {n} in the name is the goal.

local Quests = {}

local function N(tr, en)
	return { tr = tr, en = en }
end

Quests.list = {
	{ id = "deliver", icon = "🔧", goal = { 2, 4 }, reward = 140, xp = 40, name = N("Müşteriye {n} onarılmış cihaz teslim et", "Deliver {n} repaired devices") },
	{ id = "perfect", icon = "⭐", goal = { 1, 2 }, reward = 180, xp = 50, name = N("Müşterilerden {n} kez 5 yıldız al", "Get {n} five-star reviews") },
	{ id = "sell", icon = "♻️", goal = { 2, 4 }, reward = 90, xp = 25, name = N("2. el pazarına ya da hurdalığa {n} parça sat", "Sell {n} parts to a dealer") },
	{ id = "buy", icon = "🛒", goal = { 2, 5 }, reward = 80, xp = 20, name = N("Parçacılardan {n} parça al", "Buy {n} parts") },
	{ id = "junk", icon = "🏗️", goal = { 1, 1 }, reward = 120, xp = 30, level = 2, name = N("Hurdalıktan bir hurda kasa al", "Buy a junk PC at the scrapyard") },
	{ id = "catch", icon = "🚨", goal = { 1, 1 }, reward = 200, xp = 60, level = 2, name = N("Bir hırsız ya da dolandırıcı yakala", "Catch a thief or a scammer") },
	{ id = "taxi", icon = "🚕", goal = { 1, 2 }, reward = 60, xp = 15, name = N("{n} kez taksiye bin", "Take {n} taxi rides") },
	{ id = "contract", icon = "🏢", goal = { 2, 3 }, reward = 220, xp = 60, level = 3, name = N("{n} sözleşme makinesini sorunsuz teslim et", "Deliver {n} working contract machines") },
	{ id = "earn", icon = "💰", goal = { 300, 900 }, reward = 150, xp = 40, money = true, name = N("Bugün {n} kazan", "Earn {n} today") },
}

Quests.byId = {}
for _, q in Quests.list do
	Quests.byId[q.id] = q
end

function Quests.get(id: string)
	return Quests.byId[id]
end

-- Rewards grow with the player's level.
function Quests.scale(level: number): number
	return 1 + math.max(0, level - 1) * 0.08
end

return Quests
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1282">
          <Properties>
            <string name="Name">Tools</string>
            <string name="Source"><![CDATA[-- Tools: the repair tools a technician can own. Sold at the "Alet-Edevat" hardware shop.
-- `actions` lists the repair actions the tool performs (see Repair/RepairRules).
-- `speed` scales how fast the tool works (electric screwdriver, blower).

local Tools = {}

export type Tool = { [string]: any }

Tools.list = {
	{
		id = "hand", icon = "✋", model = "hand", price = 0, level = 1, order = 1, speed = 1,
		name = { tr = "El", en = "Hands" },
		desc = { tr = "Kablo çek/tak, mandal aç, parça çıkar/tak, kelebek vidalar, güç düğmesi.", en = "Unplug/plug cables, open latches, remove/install parts, thumbscrews, power button." },
		actions = { "unplug", "plug", "open_latch", "close_latch", "remove", "install", "press_power", "flip", "lid", "tie_cables", "unscrew", "screw" },
		bits = { "thumb", "toolless" },
	},
	{
		id = "screwdriver_ph2", icon = "🪛", model = "screwdriver", price = 12, level = 1, order = 2, speed = 1,
		name = { tr = "PH2 Yıldız Tornavida", en = "PH2 Phillips Screwdriver" },
		desc = { tr = "Kasa, anakart, PSU, soğutucu ve disk vidaları için.", en = "Case, motherboard, PSU, cooler and drive screws." },
		actions = { "unscrew", "screw" }, bits = { "PH2" }, color = { 220, 60, 40 },
	},
	{
		id = "precision_kit", icon = "🔩", model = "precision", price = 35, level = 2, order = 3, speed = 1,
		name = { tr = "Hassas Tornavida Seti", en = "Precision Screwdriver Kit" },
		desc = { tr = "PH0, PH1, T5 uçları: laptop ve M.2 vidaları.", en = "PH0, PH1, T5 bits: laptop and M.2 screws." },
		actions = { "unscrew", "screw" }, bits = { "PH0", "PH1", "T5", "PH2" }, color = { 30, 120, 220 },
	},
	{
		id = "electric_screwdriver", icon = "⚡", model = "electric_screwdriver", price = 90, level = 6, order = 4, speed = 2.6,
		name = { tr = "Akülü Hassas Tornavida", en = "Electric Precision Screwdriver" },
		desc = { tr = "Tüm uçlar, vidaları 2,5 kat hızlı söker.", en = "All bits, drives screws 2.5x faster." },
		actions = { "unscrew", "screw" }, bits = { "PH0", "PH1", "PH2", "T5" }, color = { 40, 40, 44 },
	},
	{
		id = "esd_strap", icon = "📿", model = "strap", price = 8, level = 1, order = 5, speed = 1,
		name = { tr = "Antistatik Bileklik", en = "Anti-static Wrist Strap" },
		desc = { tr = "Takılıyken statik elektrik parçalara zarar vermez.", en = "While worn, static discharge cannot damage parts." },
		actions = { "wear_strap" }, passive = true,
	},
	{
		id = "air_can", icon = "🌬️", model = "air_can", price = 9, level = 1, order = 6, speed = 1,
		name = { tr = "Basınçlı Hava Spreyi", en = "Compressed Air Can" },
		desc = { tr = "Fan, soğutucu ve kartlardaki tozu üfler.", en = "Blows dust out of fans, heatsinks and cards." },
		actions = { "blow_dust" },
	},
	{
		id = "air_blower", icon = "💨", model = "blower", price = 75, level = 5, order = 7, speed = 2.5,
		name = { tr = "Elektrikli Hava Üfleyici", en = "Electric Air Duster" },
		desc = { tr = "Tozu 2,5 kat hızlı temizler.", en = "Clears dust 2.5x faster." },
		actions = { "blow_dust" },
	},
	{
		id = "brush", icon = "🖌️", model = "brush", price = 6, level = 1, order = 8, speed = 1,
		name = { tr = "Antistatik Fırça", en = "Anti-static Brush" },
		desc = { tr = "Hassas yüzeylerdeki toz ve sıvı kalıntısını fırçalar.", en = "Brushes dust and liquid residue off delicate boards." },
		actions = { "brush" },
	},
	{
		id = "isopropyl", icon = "🧴", model = "bottle", price = 10, level = 1, order = 9, speed = 1,
		name = { tr = "İzopropil Alkol %99 + Bez", en = "99% Isopropyl + Cloth" },
		desc = { tr = "Eski termal macunu ve sıvı temas izlerini temizler.", en = "Cleans old thermal paste and liquid residue." },
		actions = { "clean_paste", "clean_liquid" },
	},
	{
		id = "paste_syringe", icon = "💉", model = "syringe", price = 0, level = 1, order = 10, speed = 1,
		name = { tr = "Termal Macun", en = "Thermal Paste" },
		desc = { tr = "İşlemcinin ortasına bezelye büyüklüğünde sür. Envanterden macun harcar.", en = "Apply a pea-sized dot. Uses paste from inventory." },
		actions = { "apply_paste" },
	},
	{
		id = "magnifier", icon = "🔍", model = "magnifier", price = 18, level = 1, order = 11, speed = 1,
		name = { tr = "LED'li Büyüteç", en = "LED Magnifier" },
		desc = { tr = "Şişmiş kondansatör, yanık, eğik pin ve gevşek parçaları gösterir.", en = "Reveals bulged capacitors, burns, bent pins and loose parts." },
		actions = { "inspect" },
	},
	{
		id = "usb_boot", icon = "💾", model = "usb", price = 15, level = 1, order = 12, speed = 1,
		name = { tr = "Önyüklenebilir USB", en = "Bootable USB Toolkit" },
		desc = { tr = "Windows kurulumu, bellek testi, antivirüs, disk ve BIOS araçları.", en = "Windows installer, memory test, antivirus, disk and BIOS tools." },
		actions = { "software" },
	},
	{
		id = "multimeter", icon = "📟", model = "multimeter", price = 45, level = 2, order = 13, speed = 1,
		name = { tr = "Dijital Multimetre", en = "Digital Multimeter" },
		desc = { tr = "PSU hatları, BIOS pili ve kondansatörleri ölçer.", en = "Measures PSU rails, the BIOS battery and capacitors." },
		actions = { "measure" },
	},
	{
		id = "spudger_kit", icon = "🪚", model = "spudger", price = 12, level = 2, order = 14, speed = 1,
		name = { tr = "Plastik Açma Aparatı Seti", en = "Spudger / Pry Tool Kit" },
		desc = { tr = "Laptop kapaklarını, çerçeveleri ve kauçuk ayakları açar.", en = "Opens laptop covers, bezels and rubber feet." },
		actions = { "pry", "peel" },
	},
	{
		id = "post_card", icon = "🃏", model = "post_card", price = 25, level = 3, order = 15, speed = 1,
		name = { tr = "POST Debug Kartı", en = "POST Debug Card" },
		desc = { tr = "PCIe yuvasına takılır, açılış hata kodunu gösterir.", en = "Plugs into PCIe, shows the boot error code." },
		actions = { "post_code" },
	},
	{
		id = "psu_tester", icon = "🔌", model = "psu_tester", price = 30, level = 4, order = 16, speed = 1,
		name = { tr = "PSU Test Cihazı", en = "PSU Tester" },
		desc = { tr = "Güç kaynağını anakarttan bağımsız test eder.", en = "Tests a power supply without the motherboard." },
		actions = { "psu_test" },
	},
	{
		id = "tweezers", icon = "🥢", model = "tweezers", price = 10, level = 4, order = 17, speed = 1,
		name = { tr = "Antistatik Cımbız", en = "ESD Tweezers" },
		desc = { tr = "Eğik soket pinlerini düzeltir, küçük parçaları tutar.", en = "Straightens bent socket pins, handles tiny parts." },
		actions = { "straighten_pins" },
	},
	{
		id = "soldering_station", icon = "🔥", model = "soldering_iron", price = 120, level = 7, order = 18, speed = 1,
		name = { tr = "Havya İstasyonu", en = "Soldering Station" },
		desc = { tr = "Kondansatör ve soket lehimler/söker. Lehim teli harcar.", en = "Solders and desolders capacitors and jacks. Uses solder wire." },
		actions = { "desolder", "solder" },
	},
	{
		id = "hot_air", icon = "♨️", model = "hot_air", price = 220, level = 10, order = 19, speed = 1.8,
		name = { tr = "Sıcak Hava İstasyonu", en = "Hot Air Rework Station" },
		desc = { tr = "Lehim sökmeyi hızlandırır, şarj soketi işlerinde şart değil ama çok hızlı.", en = "Desolders much faster; great for DC jack jobs." },
		actions = { "desolder" },
	},
	{
		id = "ultrasonic", icon = "🫧", model = "ultrasonic", price = 300, level = 14, order = 20, speed = 2,
		name = { tr = "Ultrasonik Temizleyici", en = "Ultrasonic Cleaner" },
		desc = { tr = "Sıvı temaslı kartları kusursuz temizler.", en = "Perfectly cleans liquid-damaged boards." },
		actions = { "clean_liquid" },
	},
	{
		id = "thermal_camera", icon = "🌡️", model = "thermal_camera", price = 400, level = 12, order = 21, speed = 1,
		name = { tr = "Termal Kamera", en = "Thermal Camera" },
		desc = { tr = "Çalışırken ısınan parçaları renkli gösterir.", en = "Shows hot components in colour while running." },
		actions = { "thermal_view" },
	},
}

Tools.byId = {}
for _, t in Tools.list do
	Tools.byId[t.id] = t
end
table.sort(Tools.list, function(a, b)
	return a.order < b.order
end)

function Tools.get(id: string): Tool?
	return Tools.byId[id]
end

-- Which owned tool can perform `action` (fastest wins). Returns the tool id or nil.
function Tools.bestFor(action: string, owned: { [string]: boolean }, bit: string?): string?
	local best, bestSpeed = nil, -1
	for _, t in Tools.list do
		if owned[t.id] and table.find(t.actions, action) then
			if bit == nil or (t.bits and table.find(t.bits, bit)) then
				if t.speed > bestSpeed then
					best, bestSpeed = t.id, t.speed
				end
			end
		end
	end
	return best
end

function Tools.canDo(toolId: string, action: string, bit: string?): boolean
	local t = Tools.byId[toolId]
	if not t or not table.find(t.actions, action) then
		return false
	end
	if bit and (action == "unscrew" or action == "screw") then
		return t.bits ~= nil and table.find(t.bits, bit) ~= nil
	end
	return true
end

return Tools
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1283">
          <Properties>
            <string name="Name">Upgrades</string>
            <string name="Source"><![CDATA[-- Upgrades: shop expansion levels and everything you can buy for your shop.
--   comfort  customers wait longer and tip more (sum of all owned items)
--   attract  more customers walk in
--   security makes thefts harder / gets alerts; protect = share of cash a safe keeps from thieves
--   speed    bench work speed bonus;  storage = extra inventory slots

local Upgrades = {}

local function N(tr, en)
	return { tr = tr, en = en }
end

Upgrades.levels = {
	{ level = 1, name = N("Küçük Dükkân", "Small Shop"), cost = 0, req = 1, w = 28, d = 30, benches = 1, queue = 2, seats = 2, staff = 1, storage = 40 },
	{ level = 2, name = N("Esnaf Dükkânı", "Local Shop"), cost = 4000, req = 3, w = 34, d = 36, benches = 2, queue = 3, seats = 3, staff = 2, storage = 80 },
	{ level = 3, name = N("Servis Merkezi", "Service Centre"), cost = 15000, req = 6, w = 42, d = 42, benches = 3, queue = 4, seats = 4, staff = 3, storage = 150 },
	{ level = 4, name = N("Büyük Servis", "Big Service Centre"), cost = 45000, req = 10, w = 48, d = 50, benches = 4, queue = 5, seats = 6, staff = 5, storage = 250 },
	{ level = 5, name = N("Teknoloji Mağazası", "Tech Store"), cost = 120000, req = 15, w = 54, d = 56, benches = 6, queue = 6, seats = 8, staff = 7, storage = 400 },
	{ level = 6, name = N("Mega Teknoloji Merkezi", "Mega Tech Centre"), cost = 350000, req = 22, w = 56, d = 60, benches = 8, queue = 8, seats = 10, staff = 10, storage = 700, floors = 2 },
}

Upgrades.items = {
	-- Comfort / decoration
	{ id = "carpet", cat = "decor", name = N("Halı", "Rug"), cost = 400, level = 1, comfort = 3, icon = "🟥" },
	{ id = "plants", cat = "decor", name = N("Saksı Bitkileri", "Potted Plants"), cost = 300, level = 1, comfort = 4, icon = "🪴" },
	{ id = "posters", cat = "decor", name = N("Donanım Posterleri", "Hardware Posters"), cost = 250, level = 1, comfort = 3, icon = "🖼️" },
	{ id = "tea", cat = "decor", name = N("Çay Ocağı (Semaver)", "Tea Samovar"), cost = 600, level = 1, comfort = 8, icon = "🫖" },
	{ id = "coffee", cat = "decor", name = N("Kahve Makinesi", "Coffee Machine"), cost = 900, level = 2, comfort = 8, icon = "☕" },
	{ id = "music", cat = "decor", name = N("Müzik Sistemi", "Sound System"), cost = 1200, level = 2, comfort = 7, icon = "🔊" },
	{ id = "tv", cat = "decor", name = N("Bekleme Salonu TV", "Waiting Room TV"), cost = 1500, level = 2, comfort = 10, icon = "📺" },
	{ id = "neon", cat = "decor", name = N("Neon Tabela", "Neon Sign"), cost = 1800, level = 2, comfort = 4, attract = 10, icon = "💡" },
	{ id = "ac", cat = "decor", name = N("Klima", "Air Conditioning"), cost = 2200, level = 3, comfort = 10, icon = "❄️" },
	{ id = "sofa", cat = "decor", name = N("Deri Koltuk Takımı", "Leather Sofa Set"), cost = 2800, level = 3, comfort = 10, icon = "🛋️" },
	{ id = "vending", cat = "decor", name = N("Atıştırmalık Otomatı", "Snack Machine"), cost = 1600, level = 3, comfort = 7, icon = "🍫" },
	{ id = "rgb_lights", cat = "decor", name = N("RGB Tavan Işıkları", "RGB Ceiling Lights"), cost = 2500, level = 4, comfort = 6, attract = 8, icon = "🌈" },
	{ id = "aquarium", cat = "decor", name = N("Akvaryum", "Aquarium"), cost = 3500, level = 4, comfort = 12, icon = "🐠" },
	{ id = "arcade", cat = "decor", name = N("Retro Atari Makinesi", "Retro Arcade Cabinet"), cost = 5000, level = 5, comfort = 12, icon = "🕹️" },
	{ id = "trophy", cat = "decor", name = N("Ödül Vitrini", "Trophy Cabinet"), cost = 7500, level = 6, comfort = 8, attract = 10, icon = "🏆" },
	-- Business
	{ id = "sign_pro", cat = "business", name = N("Işıklı Kutu Tabela", "Lightbox Sign"), cost = 1200, level = 1, attract = 6, icon = "🪧" },
	{ id = "parking", cat = "business", name = N("Otopark Yeri", "Parking Spot"), cost = 2000, level = 2, icon = "🅿️", desc = N("Aracın dükkânının önünde doğar.", "Your vehicle spawns outside your shop.") },
	{ id = "website", cat = "business", name = N("Web Sitesi", "Website"), cost = 3000, level = 3, attract = 12, icon = "🌐" },
	{ id = "ads", cat = "business", name = N("Gazete ve Radyo Reklamı", "Newspaper & Radio Ads"), cost = 4500, level = 5, attract = 15, icon = "📻" },
	{ id = "showcase", cat = "business", name = N("PC Vitrini", "PC Showcase"), cost = 6000, level = 4, icon = "🖥️", desc = N("Topladığın PC'leri vitrine koy; gelen alıcılar satın alır.", "Display PCs you build; walk-in buyers purchase them.") },
	{ id = "contracts", cat = "business", name = N("Kurumsal Sözleşme Ofisi", "Corporate Contracts Desk"), cost = 12000, level = 6, attract = 5, icon = "📑", desc = N("İnternet kafe ve şirketlerden toplu işler gelir.", "Bulk jobs from internet cafés and companies.") },
	-- Security
	{ id = "camera", cat = "security", name = N("Güvenlik Kamerası", "Security Camera"), cost = 1500, level = 2, security = 1, icon = "📹", desc = N("Hırsız içeri girince haber verir.", "Alerts you when a thief walks in.") },
	{ id = "alarm", cat = "security", name = N("Alarm Sistemi", "Alarm System"), cost = 3000, level = 3, security = 2, icon = "🚨", desc = N("Hırsızlıkta siren ve ışıklar çalışır, hırsız yavaşlar.", "Siren and lights during a theft; thieves panic and slow down.") },
	{ id = "shutter", cat = "security", name = N("Kepenk", "Roller Shutter"), cost = 2500, level = 3, security = 2, icon = "🔒", desc = N("Gece hırsız gelme ihtimali düşer.", "Fewer break-ins at night.") },
	{ id = "safe", cat = "security", name = N("Çelik Kasa", "Steel Safe"), cost = 4000, level = 4, security = 3, protect = 0.5, icon = "🗄️", desc = N("Paranın yarısı çalınamaz.", "Half of your cash can't be stolen.") },
	-- Workshop
	{ id = "bench_mat", cat = "workshop", name = N("ESD Tezgah Matı", "ESD Bench Mat"), cost = 200, level = 1, esd = 0.5, icon = "🟦", desc = N("Bileklik unutulsa bile statik riski yarıya iner.", "Halves the static risk even without a strap.") },
	{ id = "bench_led", cat = "workshop", name = N("Tezgah LED Lambası", "Bench LED Lamp"), cost = 350, level = 1, speed = 0.05, icon = "🔦" },
	{ id = "tool_wall", cat = "workshop", name = N("Alet Panosu", "Tool Wall"), cost = 800, level = 2, speed = 0.05, icon = "🧰" },
	{ id = "parts_shelves", cat = "workshop", name = N("Parça Rafları", "Parts Shelving"), cost = 1500, level = 2, storage = 60, icon = "📦" },
	{ id = "test_bench", cat = "workshop", name = N("Test Monitörü (27\")", "27\" Test Monitor"), cost = 1100, level = 2, speed = 0.05, icon = "🖥️" },
	{ id = "microscope", cat = "workshop", name = N("Dijital Mikroskop", "Digital Microscope"), cost = 2500, level = 7, speed = 0.1, icon = "🔬", desc = N("Lehim işleri hızlanır.", "Soldering work goes faster.") },
	{ id = "warehouse", cat = "workshop", name = N("Depo Odası", "Storeroom"), cost = 8000, level = 4, storage = 300, icon = "🏬" },
}

Upgrades.byId = {}
for _, it in Upgrades.items do
	Upgrades.byId[it.id] = it
end

Upgrades.categories = {
	{ id = "decor", name = N("Konfor & Dekor", "Comfort & Decor") },
	{ id = "business", name = N("İşletme", "Business") },
	{ id = "security", name = N("Güvenlik", "Security") },
	{ id = "workshop", name = N("Atölye", "Workshop") },
}

-- Wall / floor / facade looks you can pick (free) in the shop panel.
Upgrades.wallStyles = {
	{ id = "white", name = N("Beyaz Sıva", "White Plaster"), color = { 236, 232, 224 }, material = "Plaster" },
	{ id = "brick", name = N("Tuğla", "Brick"), color = { 150, 80, 60 }, material = "Brick" },
	{ id = "wood", name = N("Ahşap Lambri", "Wood Panels"), color = { 150, 110, 76 }, material = "WoodPlanks" },
	{ id = "concrete", name = N("Brüt Beton", "Raw Concrete"), color = { 150, 150, 148 }, material = "Concrete" },
	{ id = "navy", name = N("Lacivert", "Navy"), color = { 40, 56, 92 }, material = "SmoothPlastic" },
	{ id = "mint", name = N("Mint Yeşili", "Mint"), color = { 170, 214, 196 }, material = "Plaster" },
	{ id = "gamer", name = N("Oyuncu Siyahı", "Gamer Black"), color = { 26, 26, 30 }, material = "SmoothPlastic" },
	{ id = "terracotta", name = N("Kiremit", "Terracotta"), color = { 196, 110, 76 }, material = "Plaster" },
}
Upgrades.floorStyles = {
	{ id = "tiles", name = N("Seramik", "Ceramic Tiles"), color = { 214, 210, 202 }, material = "CeramicTiles" },
	{ id = "parquet", name = N("Parke", "Parquet"), color = { 168, 122, 82 }, material = "WoodPlanks" },
	{ id = "epoxy", name = N("Epoksi", "Epoxy"), color = { 70, 76, 86 }, material = "SmoothPlastic" },
	{ id = "marble", name = N("Mermer", "Marble"), color = { 230, 228, 222 }, material = "Marble" },
	{ id = "checker", name = N("Dama", "Checkerboard"), color = { 30, 30, 30 }, material = "SmoothPlastic", checker = true },
	{ id = "carpet", name = N("Halı Kaplama", "Carpet"), color = { 70, 70, 96 }, material = "Carpet" },
}
Upgrades.accentColors = {
	{ 0, 170, 220 }, { 230, 70, 60 }, { 255, 170, 30 }, { 120, 200, 80 }, { 170, 90, 230 }, { 240, 240, 240 }, { 255, 105, 180 }, { 30, 30, 30 },
}

function Upgrades.level(n: number)
	return Upgrades.levels[math.clamp(n, 1, #Upgrades.levels)]
end

function Upgrades.get(id: string)
	return Upgrades.byId[id]
end

-- Sums a numeric field over the owned items { [id] = true }.
function Upgrades.total(owned: { [string]: boolean }?, field: string): number
	local sum = 0
	if not owned then
		return 0
	end
	for id, has in owned do
		local it = Upgrades.byId[id]
		if has and it and it[field] then
			sum += it[field]
		end
	end
	return sum
end

return Upgrades
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1284">
          <Properties>
            <string name="Name">Vehicles</string>
            <string name="Source"><![CDATA[-- Vehicles: everything you can buy at the dealerships and drive around the city.
-- speed = top speed (studs/s), accel = studs/s², turn = steering response, body = VehicleModels shape.

local Vehicles = {}

local function N(tr, en)
	return { tr = tr, en = en }
end

Vehicles.list = {
	-- Bicycle shop
	{ id = "bicycle", dealer = "bicycles", kind = "bicycle", body = "bicycle", name = N("Şehir Bisikleti", "City Bike"), price = 250, level = 1, speed = 38, accel = 22, turn = 3.2, seats = 1, colors = { { 220, 60, 50 }, { 40, 110, 200 }, { 30, 30, 30 }, { 245, 200, 60 } } },
	{ id = "escooter", dealer = "bicycles", kind = "scooter", body = "escooter", name = N("Elektrikli Scooter", "E-Scooter"), price = 600, level = 1, speed = 36, accel = 26, turn = 3.4, seats = 1, colors = { { 30, 30, 30 }, { 240, 240, 240 }, { 30, 160, 120 } } },
	-- Motorcycle dealer
	{ id = "moped", dealer = "bikes", kind = "bike", body = "moped", name = N("Kurye Motoru 110", "Courier Moped 110"), price = 1800, level = 2, speed = 56, accel = 30, turn = 3, seats = 1, colors = { { 200, 30, 40 }, { 240, 240, 240 }, { 30, 70, 160 } }, box = true },
	{ id = "vespina", dealer = "bikes", kind = "bike", body = "vespa", name = N("Vespina 150 Retro", "Vespina 150 Retro"), price = 3500, level = 3, speed = 62, accel = 30, turn = 3, seats = 2, colors = { { 150, 210, 200 }, { 245, 230, 190 }, { 210, 60, 60 }, { 120, 160, 220 } } },
	{ id = "toprak", dealer = "bikes", kind = "bike", body = "enduro", name = N("Toprak 450 Enduro", "Toprak 450 Enduro"), price = 9000, level = 5, speed = 76, accel = 40, turn = 3.2, seats = 1, colors = { { 240, 120, 30 }, { 40, 40, 40 }, { 30, 90, 200 } } },
	{ id = "ruzgar", dealer = "bikes", kind = "bike", body = "naked", name = N("Rüzgar 250 Naked", "Rüzgar 250 Naked"), price = 8000, level = 4, speed = 82, accel = 42, turn = 3, seats = 2, colors = { { 30, 30, 30 }, { 220, 220, 220 }, { 200, 40, 40 } } },
	{ id = "kartal_chopper", dealer = "bikes", kind = "bike", body = "chopper", name = N("Kartal Chopper 1200", "Kartal Chopper 1200"), price = 15000, level = 7, speed = 86, accel = 36, turn = 2.4, seats = 2, colors = { { 20, 20, 22 }, { 120, 20, 20 }, { 200, 170, 90 } } },
	{ id = "simsek", dealer = "bikes", kind = "bike", body = "sport", name = N("Şimşek R6 Yarış", "Şimşek R6 Racer"), price = 18000, level = 8, speed = 112, accel = 58, turn = 3.4, seats = 2, colors = { { 20, 60, 170 }, { 230, 230, 230 }, { 200, 20, 30 }, { 40, 200, 80 } } },
	-- Car dealer
	{ id = "sahin", dealer = "cars", kind = "car", body = "classic", name = N("Şahin 1.6 (Klasik)", "Şahin 1.6 (Classic)"), price = 6000, level = 2, speed = 70, accel = 26, turn = 2.4, seats = 4, colors = { { 240, 240, 236 }, { 200, 30, 30 }, { 40, 60, 120 }, { 30, 30, 30 }, { 120, 140, 80 } } },
	{ id = "dogan", dealer = "cars", kind = "car", body = "classic", name = N("Doğan SLX", "Doğan SLX"), price = 7500, level = 3, speed = 74, accel = 28, turn = 2.5, seats = 4, colors = { { 190, 190, 196 }, { 30, 30, 30 }, { 110, 20, 30 } }, spoiler = true },
	{ id = "kartal_sw", dealer = "cars", kind = "car", body = "wagon", name = N("Kartal Station Wagon", "Kartal Station Wagon"), price = 8000, level = 3, speed = 72, accel = 27, turn = 2.4, seats = 5, colors = { { 230, 226, 214 }, { 70, 90, 60 }, { 90, 60, 40 } } },
	{ id = "minik", dealer = "cars", kind = "car", body = "hatch", name = N("Minik Hatchback", "Minik Hatchback"), price = 12000, level = 4, speed = 80, accel = 34, turn = 2.9, seats = 4, colors = { { 230, 60, 60 }, { 250, 210, 60 }, { 70, 160, 220 }, { 240, 240, 240 } } },
	{ id = "kompakt", dealer = "cars", kind = "car", body = "sedan", name = N("Kompakt Sedan", "Compact Sedan"), price = 18000, level = 5, speed = 86, accel = 34, turn = 2.6, seats = 5, colors = { { 30, 30, 34 }, { 200, 200, 205 }, { 40, 70, 130 }, { 120, 20, 30 } } },
	{ id = "servis_van", dealer = "cars", kind = "car", body = "van", name = N("Servis Vanı (Tamirci)", "Service Van"), price = 22000, level = 5, speed = 72, accel = 26, turn = 2.2, seats = 2, colors = { { 240, 240, 240 }, { 30, 120, 200 }, { 240, 160, 30 } }, livery = true },
	{ id = "dolmus", dealer = "cars", kind = "car", body = "minibus", name = N("Klasik Dolmuş", "Classic Minibus"), price = 25000, level = 6, speed = 68, accel = 22, turn = 2, seats = 8, colors = { { 250, 205, 40 }, { 240, 240, 240 } } },
	{ id = "pikap", dealer = "cars", kind = "car", body = "pickup", name = N("Pikap 4x4", "4x4 Pickup"), price = 30000, level = 7, speed = 82, accel = 32, turn = 2.3, seats = 4, colors = { { 150, 30, 30 }, { 30, 30, 30 }, { 200, 200, 196 }, { 60, 90, 60 } } },
	{ id = "suv", dealer = "cars", kind = "car", body = "suv", name = N("SUV Premium", "Premium SUV"), price = 45000, level = 9, speed = 90, accel = 38, turn = 2.4, seats = 5, colors = { { 20, 20, 24 }, { 240, 240, 240 }, { 70, 80, 90 }, { 30, 50, 90 } } },
	{ id = "elektro", dealer = "cars", kind = "car", body = "electric", name = N("Volt Elektrikli Sedan", "Volt Electric Sedan"), price = 55000, level = 10, speed = 98, accel = 52, turn = 2.8, seats = 5, colors = { { 240, 240, 240 }, { 200, 20, 30 }, { 30, 30, 34 }, { 40, 90, 170 } }, electric = true },
	{ id = "coupe", dealer = "cars", kind = "car", body = "coupe", name = N("Turbo Coupe GT", "Turbo Coupe GT"), price = 70000, level = 12, speed = 108, accel = 50, turn = 3, seats = 2, colors = { { 240, 200, 40 }, { 20, 20, 24 }, { 200, 30, 30 }, { 40, 120, 200 } }, spoiler = true },
	{ id = "limuzin", dealer = "cars", kind = "car", body = "limo", name = N("Limuzin", "Limousine"), price = 160000, level = 16, speed = 80, accel = 26, turn = 1.8, seats = 6, colors = { { 20, 20, 22 }, { 240, 240, 240 } } },
	{ id = "super", dealer = "cars", kind = "car", body = "super", name = N("Yıldırım Süper Spor", "Yıldırım Supercar"), price = 250000, level = 18, speed = 140, accel = 80, turn = 3.2, seats = 2, colors = { { 240, 120, 20 }, { 50, 200, 80 }, { 20, 20, 22 }, { 220, 30, 40 }, { 240, 240, 240 } }, spoiler = true },
}

Vehicles.byId = {}
for _, v in Vehicles.list do
	Vehicles.byId[v.id] = v
end

Vehicles.dealers = {
	cars = N("Oto Galeri", "Car Dealership"),
	bikes = N("Motor Bayi", "Motorcycle Dealer"),
	bicycles = N("Bisiklet & Scooter", "Bikes & Scooters"),
}

function Vehicles.get(id: string)
	return Vehicles.byId[id]
end

-- Random Turkish-style plate: "34 ABC 123"
function Vehicles.plate(rng: Random): string
	local cities = { "34", "06", "35", "16", "07", "01", "42", "61", "41", "26", "55", "33" }
	local letters = "ABCDEFGHJKLMNPRSTUVYZ"
	local function letter()
		local i = rng:NextInteger(1, #letters)
		return string.sub(letters, i, i)
	end
	local n = rng:NextInteger(1, 3)
	local l = ""
	for _ = 1, n do
		l ..= letter()
	end
	local digits = if n == 1 then rng:NextInteger(1000, 9999) elseif n == 2 then rng:NextInteger(100, 9999) else rng:NextInteger(10, 999)
	return cities[rng:NextInteger(1, #cities)] .. " " .. l .. " " .. tostring(digits)
end

return Vehicles
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="1285">
        <Properties>
          <string name="Name">Economy</string>
        </Properties>
        <Item class="ModuleScript" referent="1286">
          <Properties>
            <string name="Name">Market</string>
            <string name="Source"><![CDATA[-- Market: prices and listings, shared by the server (which sells) and the client (which shows them).
-- Everything is deterministic for a given UTC day so all players see the same deals.

local Shared = script.Parent.Parent
local Config = require(Shared.Config)
local Parts = require(Shared.Data.Parts)
local Rand = require(Shared.Util.Rand)

local Market = {}

function Market.day(): number
	return math.floor(os.time() / 86400)
end

local function swing(id: string, day: number): number
	local h = Rand.hash(id .. ":" .. day) % 1000 / 1000
	return 1 + (h * 2 - 1) * Config.DailyPriceSwing
end

-- Today's deals: a handful of parts 25 % off.
local dealCache = { day = -1, set = {} }
function Market.deals(day: number): { [string]: boolean }
	if dealCache.day == day then
		return dealCache.set
	end
	local rng = Rand.new(day * 7 + 3)
	local out = {}
	local pool = {}
	for _, p in Parts.list do
		if p.cat ~= "misc" and p.cat ~= "case" then
			table.insert(pool, p.id)
		end
	end
	for _ = 1, 10 do
		out[pool[rng:NextInteger(1, #pool)]] = true
	end
	dealCache.day, dealCache.set = day, out
	return out
end

-- New price at the parts depot.
function Market.price(p, day: number?): number
	local d = day or Market.day()
	local v = p.price * swing(p.id, d)
	if Market.deals(d)[p.id] then
		v *= 0.75
	end
	return math.max(1, math.floor(v + 0.5))
end

-- What can be bought at a service: "parts" sells everything new, the bazaar older generations.
function Market.catalog(service: string, day: number?)
	local d = day or Market.day()
	local out = {}
	for _, p in Parts.list do
		local ok = true
		if p.cat == "case" and service ~= "parts" then
			ok = false
		end
		if service == "parts_bazaar" then
			ok = ok and p.cat ~= "misc" and (p.year or 2030) <= 2019
		end
		if ok then
			local price = Market.price(p, d)
			if service == "parts_bazaar" then
				price = math.max(1, math.floor(price * 0.72))
			end
			table.insert(out, { id = p.id, price = price, deal = Market.deals(d)[p.id] == true })
		end
	end
	return out
end

-- Second-hand listings at a market (cond 0.35..0.95); some hide faults (decided at purchase).
function Market.used(poi: string, day: number?)
	local d = day or Market.day()
	local rng = Rand.new(Rand.hash(poi) + d * 131)
	local out = {}
	local cats = { "gpu", "gpu", "cpu", "ram", "ram", "storage", "storage", "psu", "mobo", "cooler", "fan" }
	for i = 1, 14 do
		local list = Parts.byCat[Rand.pick(rng, cats)]
		local p = list[rng:NextInteger(1, #list)]
		local cond = math.floor(Rand.range(rng, 0.35, 0.95) * 100) / 100
		local price = math.max(2, math.floor(p.price * Config.UsedSellRate * cond * 1.35 + 0.5))
		table.insert(out, { id = poi .. "_" .. d .. "_" .. i, part = p.id, cond = cond, price = price, risk = math.floor((1 - cond) * 40) })
	end
	-- laptops' service parts turn up too
	for i = 1, 4 do
		local list = Parts.byCat.laptop
		local p = list[rng:NextInteger(1, #list)]
		local cond = math.floor(Rand.range(rng, 0.5, 0.95) * 100) / 100
		table.insert(out, { id = poi .. "_" .. d .. "_L" .. i, part = p.id, cond = cond, price = math.max(2, math.floor(p.price * 0.55 * cond + 0.5)), risk = 12 })
	end
	return out
end

-- Junk PCs at the scrapyard (the device itself is generated on purchase from `seed`).
function Market.junk(day: number?)
	local d = day or Market.day()
	local rng = Rand.new(d * 977 + 5)
	local out = {}
	for i = 1, 5 do
		table.insert(out, { id = "junk_" .. d .. "_" .. i, seed = rng:NextInteger(1, 1e8), price = rng:NextInteger(35, 160), look = Rand.pick(rng, { "beige", "black", "grey" }) })
	end
	return out
end

-- What the second-hand dealer pays for an inventory item.
function Market.sellPrice(item): number
	local p = Parts.get(item.part)
	if not p then
		return 0
	end
	if item.broken then
		return math.max(1, math.floor(p.price * 0.06))
	end
	return math.max(1, math.floor(p.price * Config.UsedSellRate * (item.cond or 1) + 0.5))
end

-- What the scrapyard pays (metal and gold): little, but for anything.
function Market.scrapPrice(item): number
	local p = Parts.get(item.part)
	if not p then
		return 0
	end
	return math.max(1, math.floor(p.price * 0.09 + 0.5))
end

return Market
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="1287">
        <Properties>
          <string name="Name">Models</string>
        </Properties>
        <Item class="ModuleScript" referent="1288">
          <Properties>
            <string name="Name">Buildings</string>
            <string name="Source"><![CDATA[-- Buildings: procedural facades for the city.
-- Local frame for every building: origin = centre of the front edge at ground level,
-- the front faces the street (-Z), the building extends to +Z (depth d) and +Y.
--
-- Styles: "modern" (glass curtain wall), "office" (ribbon windows), "apartment" (plaster, balconies,
-- AC units, dishes), "historic" (stone/brick, arched windows, cornice), "industrial" (warehouse),
-- plus houses and storefronts. Lit windows are tagged "NightWindow" and switched on by clients at night.

local B = require(script.Parent.Parent.Util.Builder)
local Rand = require(script.Parent.Parent.Util.Rand)
local Props = require(script.Parent.Props)

local Buildings = {}
local M = Enum.Material
local P = B.Palette

local PLASTER = {
	{ 240, 228, 200 }, { 236, 206, 176 }, { 244, 232, 170 }, { 196, 222, 206 }, { 196, 214, 232 },
	{ 214, 150, 120 }, { 246, 244, 238 }, { 226, 196, 214 }, { 230, 214, 180 }, { 200, 186, 160 },
}
local GLASS = { { 60, 96, 120 }, { 70, 110, 110 }, { 54, 70, 96 }, { 90, 120, 140 }, { 40, 60, 70 } }
local STONE = { { 214, 200, 176 }, { 196, 182, 160 }, { 222, 214, 196 }, { 170, 120, 96 } }
local AWNING = { { 200, 40, 40 }, { 30, 110, 60 }, { 30, 70, 150 }, { 230, 140, 30 }, { 120, 40, 90 }, { 40, 40, 44 } }

Buildings.ShopNames = {
	"Yıldız Eczanesi", "Berber Ali", "Kuaför Selin", "Lezzet Lokantası", "Ege Fırını", "Güven Kırtasiye",
	"Lale Çiçekçilik", "Altın Kuyumcu", "Merkez Optik", "Şifa Eczanesi", "Usta Terzi", "Anadolu Halı",
	"Mavi Butik", "Kristal Saat", "Yeni Kitabevi", "Doğa Kuruyemiş", "Sultan Baklava", "Hilal Pastanesi",
	"Gül Mobilya", "Bereket Market", "Deniz Balık", "Kardeşler Kasap", "Taze Manav", "Nur Döviz",
	"Ayakkabı Dünyası", "Spor Merkezi", "Oyuncak Diyarı", "Foto Işık", "Matbaa 34", "Pet Shop Pati",
	"Noter", "Diş Kliniği", "Veteriner Can", "Lostra Salonu", "Telefoncu Emre", "Elektrikçi Hasan",
	"Nalbur Osman", "Simitçi", "Börekçi Hatice", "Pide Salonu", "Tatlıcı Ömer", "Çay Bahçesi",
	"Kafe Mola", "Burger Bros", "Sushi Ada", "Mantı Evi", "Gözleme Evi", "Kahve Durağı",
}
local SHOP_COLORS = { { 200, 40, 40 }, { 30, 120, 70 }, { 30, 80, 170 }, { 230, 140, 30 }, { 120, 40, 120 }, { 20, 20, 24 }, { 200, 170, 60 }, { 0, 150, 190 } }

local function nc(extra)
	local t = { CanCollide = false, CanTouch = false }
	if extra then
		for k, v in extra do
			t[k] = v
		end
	end
	return t
end

-- Facade grid on one face. faceCf = centre of the face at ground level with -Z pointing outward.
-- Builds bands, piers and a glass layer; optional lit windows for the night.
local function facade(model: Instance, faceCf: CFrame, width: number, floors: number, floorH: number, opts)
	local cols = opts.cols or math.max(1, math.floor(width / 7))
	local pier = opts.pier or 1.4
	local sill = opts.sill or 3.2
	local lintel = opts.lintel or 2.4
	local wallCol = opts.wall
	local wallMat = opts.wallMat or M.Concrete
	local glassCol = opts.glass or Color3.fromRGB(60, 96, 120)
	local startFloor = opts.startFloor or 0
	local depth = opts.depth or 1
	local ww = (width - (cols + 1) * pier) / cols
	for f = startFloor, floors - 1 do
		local y0 = f * floorH
		local winH = floorH - sill - lintel
		-- bands
		B.box(model, faceCf * CFrame.new(0, y0 + sill / 2, 0), Vector3.new(width, sill, depth), wallCol, wallMat)
		B.box(model, faceCf * CFrame.new(0, y0 + floorH - lintel / 2, 0), Vector3.new(width, lintel, depth), wallCol, wallMat)
		-- piers
		for c = 0, cols do
			local x = -width / 2 + pier / 2 + c * (ww + pier)
			B.box(model, faceCf * CFrame.new(x, y0 + sill + winH / 2, 0), Vector3.new(pier, winH, depth), wallCol, wallMat)
		end
		-- glass strip recessed behind the piers
		B.box(model, faceCf * CFrame.new(0, y0 + sill + winH / 2, depth * 0.3), Vector3.new(width - pier, winH, 0.3), glassCol, M.Glass, { Transparency = opts.glassT or 0.25, Reflectance = 0.05 })
		if opts.frames then
			for c = 0, cols - 1 do
				local x = -width / 2 + pier + ww / 2 + c * (ww + pier)
				B.box(model, faceCf * CFrame.new(x, y0 + sill - 0.15, -depth / 2 - 0.25), Vector3.new(ww + 0.6, 0.3, 0.6), opts.frameCol or P.white, M.SmoothPlastic, nc())
				if opts.arched then
					B.cyl(model, faceCf * CFrame.new(x, y0 + sill + winH, 0.1) * CFrame.Angles(0, math.pi / 2, 0), depth + 0.1, ww, glassCol, M.Glass, nc({ Transparency = 0.25 }))
				end
			end
		end
		-- lit windows (client toggles at night)
		if opts.rng and opts.nightWindows ~= false then
			for c = 0, cols - 1 do
				if opts.rng:NextNumber() < (opts.litChance or 0.35) then
					local x = -width / 2 + pier + ww / 2 + c * (ww + pier)
					local lit = B.box(model, faceCf * CFrame.new(x, y0 + sill + winH / 2, depth * 0.3 + 0.6), Vector3.new(ww * 0.9, winH * 0.85, 0.2), Rand.pick(opts.rng, { Color3.fromRGB(255, 214, 150), Color3.fromRGB(255, 236, 200), Color3.fromRGB(220, 236, 255) }), M.Neon, nc({ Transparency = 1, CastShadow = false, Name = "NightWindow" }))
					lit:AddTag("NightWindow")
				end
			end
		end
	end
	return cols, ww
end

-- Striped awning above a storefront. cf = centre of the shopfront top edge on the facade.
function Buildings.awning(parent: Instance, cf: CFrame, width: number, color: Color3, _rng: Random?)
	local stripes = math.max(2, math.floor(width / 2.2))
	local sw = width / stripes
	local white = Color3.fromRGB(245, 243, 236)
	for i = 0, stripes - 1 do
		local col = if i % 2 == 0 then color else white
		-- wedge: tall side at the wall, sloping down towards the street
		B.wedge(parent, cf * CFrame.new(-width / 2 + sw * (i + 0.5), -0.9, -2) * CFrame.Angles(0, 0, 0), Vector3.new(sw, 1.8, 4), col, M.Fabric, nc())
	end
	B.box(parent, cf * CFrame.new(0, -1.9, -4.05), Vector3.new(width, 0.4, 0.1), color, M.Fabric, nc())
end

-- Ground-floor shop: glass front, door, sign band, interior glow.
function Buildings.shopfront(parent: Instance, cf: CFrame, width: number, height: number, opts)
	local o = opts or {}
	local rng = o.rng or Random.new()
	local frame = o.frameCol or Color3.fromRGB(40, 42, 46)
	local name = o.name or Rand.pick(rng, Buildings.ShopNames)
	local accent = B.color(o.accent or Rand.pick(rng, SHOP_COLORS))
	-- glass and frame
	B.box(parent, cf * CFrame.new(0, height * 0.42, 0.2), Vector3.new(width - 1, height * 0.8, 0.25), Color3.fromRGB(150, 180, 196), M.Glass, { Transparency = 0.55 })
	for _, x in { -width / 2 + 0.4, width / 2 - 0.4 } do
		B.box(parent, cf * CFrame.new(x, height / 2, 0), Vector3.new(0.8, height, 0.8), frame, M.Metal)
	end
	B.box(parent, cf * CFrame.new(0, 0.4, 0), Vector3.new(width, 0.8, 0.9), frame, M.Metal)
	local doorX = o.doorX or (width / 2 - 4)
	B.box(parent, cf * CFrame.new(doorX, 3.6, 0), Vector3.new(0.25, 7.2, 0.6), frame, M.Metal, nc())
	B.box(parent, cf * CFrame.new(doorX + 3.2, 3.6, 0), Vector3.new(0.25, 7.2, 0.6), frame, M.Metal, nc())
	-- sign band
	local band = B.box(parent, cf * CFrame.new(0, height * 0.9, -0.3), Vector3.new(width, height * 0.2, 1.2), accent, M.SmoothPlastic)
	B.sign(band, Enum.NormalId.Front, name, { color = Color3.fromRGB(255, 255, 255), glow = true, brightness = 1.3, font = o.font or B.Fonts.Heavy })
	-- interior suggestion: back wall, counter, shelves and a neon strip
	if o.interior ~= false then
		B.box(parent, cf * CFrame.new(0, height * 0.42, 7), Vector3.new(width - 1.4, height * 0.84, 0.4), accent:Lerp(Color3.new(1, 1, 1), 0.65), M.SmoothPlastic, nc())
		B.box(parent, cf * CFrame.new(-width * 0.15, 1.8, 4), Vector3.new(width * 0.4, 3.6, 1.6), Color3.fromRGB(230, 226, 220), M.Wood, nc())
		for i = -1, 1, 2 do
			B.box(parent, cf * CFrame.new(i * width * 0.3, height * 0.4, 6.4), Vector3.new(width * 0.22, height * 0.6, 0.8), Color3.fromRGB(120, 90, 60), M.Wood, nc())
		end
		B.box(parent, cf * CFrame.new(0, height * 0.82, 3.5), Vector3.new(width * 0.7, 0.2, 0.4), Color3.fromRGB(255, 244, 220), M.Neon, nc({ CastShadow = false }))
	end
	if o.awning ~= false and rng:NextNumber() < (o.awningChance or 0.6) then
		Buildings.awning(parent, cf * CFrame.new(0, height * 0.79, -0.2), width - 1.4, B.color(o.awningColor or Rand.pick(rng, AWNING)), rng)
	end
	return name
end

local function roofClutter(model: Instance, cf: CFrame, w: number, d: number, y: number, rng: Random, style: string)
	-- parapet
	local pc = Color3.fromRGB(150, 150, 150)
	B.box(model, cf * CFrame.new(0, y + 0.8, 0.5), Vector3.new(w, 1.6, 1), pc, M.Concrete)
	B.box(model, cf * CFrame.new(0, y + 0.8, d - 0.5), Vector3.new(w, 1.6, 1), pc, M.Concrete)
	B.box(model, cf * CFrame.new(-w / 2 + 0.5, y + 0.8, d / 2), Vector3.new(1, 1.6, d), pc, M.Concrete)
	B.box(model, cf * CFrame.new(w / 2 - 0.5, y + 0.8, d / 2), Vector3.new(1, 1.6, d), pc, M.Concrete)
	local n = rng:NextInteger(1, 3)
	for _ = 1, n do
		local x, z = Rand.range(rng, -w / 2 + 4, w / 2 - 4), Rand.range(rng, 4, d - 4)
		local kind = rng:NextInteger(1, 5)
		if kind == 1 then
			-- AC unit
			B.box(model, cf * CFrame.new(x, y + 1.2, z), Vector3.new(4, 2.4, 3), Color3.fromRGB(200, 200, 204), M.Metal)
			B.cylY(model, cf * CFrame.new(x, y + 2.45, z), 0.15, 2.2, Color3.fromRGB(40, 40, 44), M.Metal, nc())
		elseif kind == 2 then
			-- water tank
			B.cylY(model, cf * CFrame.new(x, y + 2.2, z), 4.4, 4, Color3.fromRGB(230, 230, 230), M.SmoothPlastic)
		elseif kind == 3 then
			-- stair housing
			B.box(model, cf * CFrame.new(x, y + 3, z), Vector3.new(6, 6, 6), Color3.fromRGB(180, 176, 168), M.Concrete)
		elseif kind == 4 then
			-- solar panels
			for i = 0, 2 do
				B.box(model, cf * CFrame.new(x + i * 3.2 - 3.2, y + 1.3, z) * CFrame.Angles(math.rad(-25), 0, 0), Vector3.new(3, 0.2, 5), Color3.fromRGB(30, 44, 80), M.Glass, nc({ Reflectance = 0.2 }))
			end
		else
			-- antenna mast and dish
			B.cylY(model, cf * CFrame.new(x, y + 5, z), 10, 0.25, Color3.fromRGB(160, 160, 160), M.Metal, nc())
			B.cyl(model, cf * CFrame.new(x + 0.8, y + 2, z) * CFrame.Angles(0, math.rad(30), math.rad(20)), 0.3, 2.6, Color3.fromRGB(230, 230, 230), M.SmoothPlastic, nc())
		end
	end
	if style == "modern" and rng:NextNumber() < 0.5 then
		local beacon = B.ball(model, cf * CFrame.new(w / 2 - 2, y + 2, d - 2), 0.8, Color3.fromRGB(255, 40, 40), M.Neon, nc({ Name = "Beacon" }))
		beacon:AddTag("Beacon")
	end
end

-- General purpose multi-storey building.
-- opts: w, d, floors, floorH, style, ground ("shop"|"lobby"|"plain"), name, rng, wallColor, glassColor, roof
function Buildings.building(parent: Instance, cf: CFrame, opts): Model
	local rng = opts.rng or Random.new()
	local style = opts.style or "apartment"
	local w, d = opts.w or 30, opts.d or 30
	local floors = opts.floors or 4
	local fh = opts.floorH or 13
	local H = floors * fh
	local m = B.model(opts.modelName or "Building", parent)
	m:SetAttribute("Style", style)

	local wall, wallMat, glass
	if style == "modern" then
		wall = B.color(opts.wallColor or Rand.pick(rng, { { 90, 96, 106 }, { 200, 204, 210 }, { 50, 54, 60 } }))
		wallMat = M.Metal
		glass = B.color(opts.glassColor or Rand.pick(rng, GLASS))
	elseif style == "office" then
		wall = B.color(opts.wallColor or Rand.pick(rng, { { 210, 206, 196 }, { 180, 176, 170 }, { 226, 222, 214 } }))
		wallMat = M.Concrete
		glass = B.color(opts.glassColor or Rand.pick(rng, GLASS))
	elseif style == "historic" then
		wall = B.color(opts.wallColor or Rand.pick(rng, STONE))
		wallMat = if rng:NextNumber() < 0.35 then M.Brick else M.Limestone
		glass = Color3.fromRGB(60, 80, 90)
	else
		wall = B.color(opts.wallColor or Rand.pick(rng, PLASTER))
		wallMat = M.Plaster
		glass = Color3.fromRGB(70, 96, 110)
	end

	-- floor slabs and back/side shells (solid, cheap)
	local shellCol = wall:Lerp(Color3.new(0, 0, 0), 0.06)
	B.box(m, cf * CFrame.new(0, H / 2, d - 0.5), Vector3.new(w, H, 1), shellCol, wallMat)
	B.box(m, cf * CFrame.new(0, H + 0.4, d / 2), Vector3.new(w, 0.8, d), Color3.fromRGB(120, 120, 124), M.Concrete)

	-- ground floor on the street side
	local groundH = fh
	local ground = opts.ground or "plain"
	if ground == "shop" then
		local shops = opts.shops or (if w >= 30 then 2 else 1)
		local sw = w / shops
		for i = 0, shops - 1 do
			Buildings.shopfront(m, cf * CFrame.new(-w / 2 + sw * (i + 0.5), 0, 0), sw, groundH, { rng = rng, name = if i == 0 then opts.name else nil, accent = opts.accent })
		end
	elseif ground == "lobby" then
		B.box(m, cf * CFrame.new(0, groundH / 2, 0.4), Vector3.new(w - 2, groundH, 0.3), glass, M.Glass, { Transparency = 0.45 })
		for _, x in { -w / 2 + 0.6, w / 2 - 0.6 } do
			B.box(m, cf * CFrame.new(x, groundH / 2, 0), Vector3.new(1.2, groundH, 1.2), wall, wallMat)
		end
		local canopy = B.box(m, cf * CFrame.new(0, groundH * 0.72, -3), Vector3.new(math.min(16, w - 4), 0.6, 6), Color3.fromRGB(40, 44, 50), M.Metal)
		if opts.name then
			B.sign(canopy, Enum.NormalId.Front, opts.name, { color = Color3.new(1, 1, 1), glow = true, font = B.Fonts.Bold })
		end
		B.box(m, cf * CFrame.new(0, groundH * 0.95, 0), Vector3.new(w, groundH * 0.1, 1.2), wall, wallMat)
		B.box(m, cf * CFrame.new(0, groundH * 0.6, 6), Vector3.new(w - 4, 0.3, 0.3), Color3.fromRGB(255, 240, 210), M.Neon, nc())
	else
		facade(m, cf * CFrame.new(0, 0, 0.5), w, 1, fh, { wall = wall, wallMat = wallMat, glass = glass, cols = math.max(1, math.floor(w / 8)), rng = rng, litChance = 0.2, frames = style == "apartment" or style == "historic", arched = style == "historic" })
	end

	-- upper floors: front facade
	if floors > 1 then
		local fopts = { wall = wall, wallMat = wallMat, glass = glass, startFloor = 1, rng = rng }
		if style == "modern" then
			fopts.pier, fopts.sill, fopts.lintel, fopts.cols, fopts.glassT = 0.5, 1.2, 0.8, math.max(2, math.floor(w / 5)), 0.15
		elseif style == "office" then
			fopts.pier, fopts.sill, fopts.lintel, fopts.cols = 0.8, 4, 2, math.max(2, math.floor(w / 6))
		elseif style == "historic" then
			fopts.frames, fopts.arched, fopts.cols, fopts.sill, fopts.lintel, fopts.frameCol = true, true, math.max(2, math.floor(w / 7)), 3.6, 3, Color3.fromRGB(236, 230, 214)
		else
			fopts.frames, fopts.cols = true, math.max(2, math.floor(w / 7))
		end
		local cols, ww = facade(m, cf * CFrame.new(0, 0, 0.5), w, floors, fh, fopts)
		-- apartment details: balconies, AC units, satellite dishes
		if style == "apartment" then
			local pier = 1.4
			for f = 1, floors - 1 do
				for c = 0, cols - 1 do
					local x = -w / 2 + pier + ww / 2 + c * (ww + pier)
					local y = f * fh
					if (c + f) % 2 == 0 and rng:NextNumber() < 0.8 then
						B.box(m, cf * CFrame.new(x, y + 0.2, -1.8), Vector3.new(ww + 1.4, 0.4, 3.6), Color3.fromRGB(220, 216, 208), M.Concrete)
						B.box(m, cf * CFrame.new(x, y + 1.9, -3.5), Vector3.new(ww + 1.4, 3, 0.15), Color3.fromRGB(150, 190, 210), M.Glass, nc({ Transparency = 0.5 }))
						B.box(m, cf * CFrame.new(x, y + 3.45, -3.5), Vector3.new(ww + 1.4, 0.2, 0.25), Color3.fromRGB(80, 84, 90), M.Metal, nc())
						if rng:NextNumber() < 0.3 then
							B.cyl(m, cf * CFrame.new(x + ww / 2 - 0.6, y + 4, -2) * CFrame.Angles(0, math.rad(80), math.rad(15)), 0.25, 1.8, Color3.fromRGB(235, 235, 235), M.SmoothPlastic, nc())
						end
						if rng:NextNumber() < 0.35 then
							Props.plant(m, cf * CFrame.new(x - ww / 2 + 1, y + 0.4, -2.5), rng)
						end
					elseif rng:NextNumber() < 0.35 then
						-- AC unit hanging under the window
						B.box(m, cf * CFrame.new(x + ww * 0.25, y + 1.2, -0.9), Vector3.new(2.6, 1.8, 1), Color3.fromRGB(236, 236, 236), M.SmoothPlastic, nc())
						B.cyl(m, cf * CFrame.new(x + ww * 0.25 - 0.4, y + 1.2, -1.42) * CFrame.Angles(0, math.pi / 2, 0), 0.05, 1.3, Color3.fromRGB(60, 60, 60), M.Metal, nc())
					end
				end
			end
		elseif style == "historic" then
			-- cornice and pilasters
			B.box(m, cf * CFrame.new(0, H - 0.6, -0.6), Vector3.new(w + 1.2, 1.2, 2.2), Color3.fromRGB(236, 230, 214), M.Limestone)
			B.box(m, cf * CFrame.new(0, fh, -0.4), Vector3.new(w + 0.6, 0.8, 1.6), Color3.fromRGB(236, 230, 214), M.Limestone)
			for _, x in { -w / 2 + 0.7, w / 2 - 0.7 } do
				B.box(m, cf * CFrame.new(x, H / 2, -0.4), Vector3.new(1.6, H, 1.4), Color3.fromRGB(226, 220, 204), M.Limestone)
			end
		end
	end

	-- sides
	for side = -1, 1, 2 do
		local faceCf = cf * CFrame.new(side * (w / 2 - 0.5), 0, d / 2) * CFrame.Angles(0, side * math.pi / 2, 0)
		if opts.blankSides then
			B.box(m, faceCf * CFrame.new(0, H / 2, 0), Vector3.new(d - 1, H, 1), shellCol, wallMat)
		else
			facade(m, faceCf, d - 1, floors, fh, { wall = shellCol, wallMat = wallMat, glass = glass, cols = math.max(1, math.floor(d / 12)), pier = 3, rng = rng, litChance = 0.2 })
		end
	end

	-- roof
	if opts.roof == "gable" then
		local roofCol = B.color(opts.roofColor or Rand.pick(rng, { { 160, 70, 50 }, { 120, 60, 50 }, { 90, 90, 96 } }))
		local rh = math.min(w, d) * 0.28
		-- front half rises towards the ridge at d/2 (wedge's tall side is its +Z), back half is mirrored
		B.wedge(m, cf * CFrame.new(0, H + rh / 2, d * 0.25), Vector3.new(w + 1, rh, d / 2 + 0.5), roofCol, M.ClayRoofTiles)
		B.wedge(m, cf * CFrame.new(0, H + rh / 2, d * 0.75) * CFrame.Angles(0, math.pi, 0), Vector3.new(w + 1, rh, d / 2 + 0.5), roofCol, M.ClayRoofTiles)
	else
		roofClutter(m, cf, w, d, H + 0.8, rng, style)
	end
	return m
end

-- Walk-in hall: open doorway, glass front, interior floor, lit ceiling, sign. Used by every place
-- the player can enter (stores, dealers, agencies, player shops).
-- opts: name, accent, wall, wallMat, floor, floorMat, glassFront (bool), door (width), doorX, sign (bool)
-- Returns the model plus a table of useful interior points.
function Buildings.hall(parent: Instance, cf: CFrame, w: number, d: number, h: number, opts)
	local o = opts or {}
	local m = B.model(o.modelName or "Hall", parent)
	local wall = B.color(o.wall or { 236, 234, 228 })
	local wallMat = o.wallMat or M.Plaster
	local floorCol = B.color(o.floor or { 214, 210, 202 })
	local floorMat = o.floorMat or M.CeramicTiles
	local accent = B.color(o.accent or { 0, 150, 200 })
	local doorW = o.door or 8
	local doorX = o.doorX or 0
	local t = 1
	-- floor and roof
	B.box(m, cf * CFrame.new(0, 0.1, d / 2), Vector3.new(w, 0.2, d), floorCol, floorMat).Name = "Floor"
	B.box(m, cf * CFrame.new(0, h + 0.5, d / 2), Vector3.new(w + 1, 1, d + 1), Color3.fromRGB(120, 120, 124), M.Concrete).Name = "Roof"
	B.box(m, cf * CFrame.new(0, h - 0.1, d / 2), Vector3.new(w - 2 * t, 0.2, d - 2 * t), Color3.fromRGB(246, 246, 244), M.SmoothPlastic, nc({ Name = "Ceiling" }))
	-- back and side walls
	B.box(m, cf * CFrame.new(0, h / 2, d - t / 2), Vector3.new(w, h, t), wall, wallMat).Name = "BackWall"
	for side = -1, 1, 2 do
		B.box(m, cf * CFrame.new(side * (w / 2 - t / 2), h / 2, d / 2), Vector3.new(t, h, d), wall, wallMat).Name = "SideWall"
	end
	-- front: glass panels left/right of the doorway, header above
	local doorH = math.min(10, h - 2)
	local leftW = (w / 2 + doorX - doorW / 2)
	local rightW = (w / 2 - doorX - doorW / 2)
	local frame = Color3.fromRGB(40, 42, 46)
	local function frontPanel(x0: number, width: number)
		if width <= 0.5 then
			return
		end
		local cx = x0 + width / 2
		if o.glassFront ~= false then
			B.box(m, cf * CFrame.new(cx, h * 0.42, t / 2), Vector3.new(width - 0.4, h * 0.8, 0.3), Color3.fromRGB(150, 182, 198), M.Glass, { Transparency = 0.5 })
			B.box(m, cf * CFrame.new(cx, 0.5, t / 2), Vector3.new(width, 1, t), frame, M.Metal)
			B.box(m, cf * CFrame.new(x0 + 0.3, h / 2, t / 2), Vector3.new(0.6, h, t), frame, M.Metal)
		else
			B.box(m, cf * CFrame.new(cx, h / 2, t / 2), Vector3.new(width, h, t), wall, wallMat)
		end
	end
	frontPanel(-w / 2, leftW)
	frontPanel(doorX + doorW / 2, rightW)
	B.box(m, cf * CFrame.new(w / 2 - 0.3, h / 2, t / 2), Vector3.new(0.6, h, t), frame, M.Metal)
	B.box(m, cf * CFrame.new(doorX, (doorH + h) / 2, t / 2), Vector3.new(doorW, h - doorH, t), if o.glassFront ~= false then frame else wall, M.Metal).Name = "DoorHeader"
	-- sliding door leaves parked beside the opening
	for side = -1, 1, 2 do
		local leaf = B.box(m, cf * CFrame.new(doorX + side * (doorW / 2 + doorW / 4 - 0.2), doorH / 2, -0.3), Vector3.new(doorW / 2, doorH - 0.4, 0.2), Color3.fromRGB(160, 196, 210), M.Glass, nc({ Transparency = 0.55, Name = "DoorLeaf" }))
		leaf:SetAttribute("Side", side)
	end
	-- sign band
	if o.sign ~= false then
		local band = B.box(m, cf * CFrame.new(0, h + 2.4, -0.4), Vector3.new(math.min(w - 2, math.max(16, #(o.name or "") * 2.2)), 3.8, 0.8), accent, M.SmoothPlastic)
		band.Name = "SignBand"
		B.sign(band, Enum.NormalId.Front, o.name or "", { color = Color3.new(1, 1, 1), glow = true, brightness = 1.4, font = o.font or B.Fonts.Heavy })
	end
	-- ceiling lights
	local rows = math.max(1, math.floor(d / 14))
	local cols = math.max(1, math.floor(w / 14))
	for r = 1, rows do
		for c = 1, cols do
			local x = -w / 2 + w * (c - 0.5) / cols
			local z = d * (r - 0.5) / rows
			local panel = B.box(m, cf * CFrame.new(x, h - 0.3, z), Vector3.new(4, 0.2, 4), Color3.fromRGB(255, 250, 240), M.Neon, nc({ CastShadow = false, Name = "CeilingLight" }))
			if (r + c) % 2 == 0 or (rows * cols <= 2) then
				B.pointLight(panel, math.max(w, d) * 0.6, 0.9, Color3.fromRGB(255, 244, 228), false)
			end
		end
	end
	local points = {
		door = (cf * CFrame.new(doorX, 0, 2)).Position,
		outside = (cf * CFrame.new(doorX, 0, -6)).Position,
		back = (cf * CFrame.new(0, 0, d - 4)).Position,
	}
	return m, points
end

-- Two-storey suburban house with a gable roof, garden, fence and driveway.
function Buildings.house(parent: Instance, cf: CFrame, lotW: number, lotD: number, rng: Random): Model
	local m = B.model("House", parent)
	local w = math.min(lotW - 10, Rand.range(rng, 20, 28))
	local d = Rand.range(rng, 18, 24)
	local floors = if rng:NextNumber() < 0.7 then 2 else 1
	local fh = 11
	local H = floors * fh
	local setback = Rand.range(rng, 12, 16)
	local hc = cf * CFrame.new(Rand.range(rng, -2, 2), 0, setback)
	local wall = B.color(Rand.pick(rng, PLASTER))
	local trim = Color3.fromRGB(246, 244, 238)
	-- garden ground
	B.box(m, cf * CFrame.new(0, 0.3, lotD / 2), Vector3.new(lotW - 2, 0.2, lotD - 2), P.grass, M.Grass, nc({ CanCollide = true }))
	-- shell
	B.box(m, hc * CFrame.new(0, H / 2 + 0.6, d / 2), Vector3.new(w, H, d), wall, M.Plaster)
	B.box(m, hc * CFrame.new(0, 0.6, d / 2), Vector3.new(w + 1, 1.2, d + 1), Color3.fromRGB(170, 160, 150), M.Concrete)
	-- windows
	for f = 0, floors - 1 do
		for i = -1, 1 do
			if not (f == 0 and i == 0) then
				local x = i * w / 3
				local y = f * fh + 6
				B.box(m, hc * CFrame.new(x, y, -0.05), Vector3.new(4.4, 4.4, 0.3), trim, M.SmoothPlastic, nc())
				B.box(m, hc * CFrame.new(x, y, -0.15), Vector3.new(3.6, 3.6, 0.2), Color3.fromRGB(80, 110, 130), M.Glass, nc({ Transparency = 0.2 }))
				B.box(m, hc * CFrame.new(x, y - 2.5, -0.5), Vector3.new(4.8, 0.4, 1), trim, M.SmoothPlastic, nc())
				if rng:NextNumber() < 0.5 then
					local shutter = Rand.pick(rng, { Color3.fromRGB(40, 90, 70), Color3.fromRGB(110, 60, 40), Color3.fromRGB(50, 70, 110) })
					for s = -1, 1, 2 do
						B.box(m, hc * CFrame.new(x + s * 2.9, y, -0.2), Vector3.new(1.4, 4.4, 0.2), shutter, M.Wood, nc())
					end
				end
				if rng:NextNumber() < 0.3 then
					local lit = B.box(m, hc * CFrame.new(x, y, 0.3), Vector3.new(3.4, 3.4, 0.2), Color3.fromRGB(255, 214, 150), M.Neon, nc({ Transparency = 1, Name = "NightWindow" }))
					lit:AddTag("NightWindow")
				end
			end
		end
	end
	-- door and porch
	local doorCol = Rand.pick(rng, { Color3.fromRGB(110, 60, 40), Color3.fromRGB(40, 60, 100), Color3.fromRGB(150, 40, 40), Color3.fromRGB(240, 240, 236) })
	B.box(m, hc * CFrame.new(0, 4.6, -0.1), Vector3.new(4, 7.6, 0.4), doorCol, M.Wood)
	B.ball(m, hc * CFrame.new(1.4, 4.4, -0.4), 0.35, Color3.fromRGB(220, 190, 90), M.Metal, nc())
	B.box(m, hc * CFrame.new(0, 9.4, -2), Vector3.new(7, 0.4, 4), trim, M.SmoothPlastic)
	for s = -1, 1, 2 do
		B.box(m, hc * CFrame.new(s * 3.2, 5, -3.7), Vector3.new(0.5, 8.8, 0.5), trim, M.Wood)
	end
	B.box(m, hc * CFrame.new(0, 0.8, -2.5), Vector3.new(6, 0.6, 3), Color3.fromRGB(180, 170, 160), M.Concrete)
	-- gable roof
	local roofCol = B.color(Rand.pick(rng, { { 170, 70, 50 }, { 130, 60, 46 }, { 80, 84, 92 }, { 110, 90, 70 } }))
	local rh = Rand.range(rng, 6, 9)
	local ry = H + 0.6 + rh / 2
	B.wedge(m, hc * CFrame.new(0, ry, d * 0.25), Vector3.new(w + 2, rh, d / 2 + 1.2), roofCol, M.ClayRoofTiles)
	B.wedge(m, hc * CFrame.new(0, ry, d * 0.75) * CFrame.Angles(0, math.pi, 0), Vector3.new(w + 2, rh, d / 2 + 1.2), roofCol, M.ClayRoofTiles)
	B.box(m, hc * CFrame.new(w * 0.25, H + rh + 1, d * 0.6), Vector3.new(2.2, 5, 2.2), Color3.fromRGB(150, 80, 60), M.Brick)
	-- garden: fence, driveway, tree, mailbox, flowers
	B.box(m, cf * CFrame.new(lotW / 2 - 5, 0.42, setback / 2 + 4), Vector3.new(6, 0.1, setback + 8), Color3.fromRGB(150, 146, 140), M.Pavement, nc({ CanCollide = true }))
	Props.fence(m, (cf * CFrame.new(-lotW / 2 + 1, 0.4, 1.5)).Position, (cf * CFrame.new(lotW / 2 - 8.5, 0.4, 1.5)).Position, Rand.pick(rng, { "wood", "hedge", "metal", "wall" }), 3)
	Props.tree(m, cf * CFrame.new(-lotW / 2 + 6, 0.4, setback * 0.5), Rand.pick(rng, { "oak", "oak", "birch", "cypress", "pine" }), rng)
	if rng:NextNumber() < 0.6 then
		Props.flowerBed(m, cf * CFrame.new(-3, 0.4, setback - 3), 8, 2.4, rng)
	end
	Props.mailbox(m, cf * CFrame.new(lotW / 2 - 9, 0.4, 2.5))
	m:SetAttribute("HouseDoor", (hc * CFrame.new(0, 3, -4)).Position)
	B.tag(m, "House")
	return m
end

-- Warehouse / factory hall.
function Buildings.warehouse(parent: Instance, cf: CFrame, w: number, d: number, rng: Random, opts): Model
	local o = opts or {}
	local m = B.model("Warehouse", parent)
	local h = o.height or Rand.range(rng, 16, 24)
	local col = B.color(o.color or Rand.pick(rng, { { 200, 200, 196 }, { 120, 140, 160 }, { 170, 120, 90 }, { 90, 110, 100 }, { 210, 200, 170 } }))
	B.box(m, cf * CFrame.new(0, h / 2, d / 2), Vector3.new(w, h, d), col, M.Metal)
	-- vertical ribs on the front
	local ribs = math.floor(w / 4)
	for i = 0, ribs do
		B.box(m, cf * CFrame.new(-w / 2 + i * w / ribs, h / 2, -0.15), Vector3.new(0.4, h, 0.3), col:Lerp(Color3.new(0, 0, 0), 0.12), M.Metal, nc())
	end
	-- roller doors
	local doors = math.max(1, math.floor(w / 26))
	for i = 1, doors do
		local x = -w / 2 + w * i / (doors + 1)
		B.box(m, cf * CFrame.new(x, 6, -0.3), Vector3.new(12, 12, 0.4), Color3.fromRGB(150, 154, 160), M.DiamondPlate)
		B.box(m, cf * CFrame.new(x, 12.4, -0.6), Vector3.new(13, 0.8, 1), Color3.fromRGB(240, 190, 30), M.SmoothPlastic, nc())
	end
	-- sawtooth roof
	local teeth = math.max(2, math.floor(d / 14))
	for i = 0, teeth - 1 do
		local z = d * (i + 0.5) / teeth
		B.wedge(m, cf * CFrame.new(0, h + 2.5, z), Vector3.new(w, 5, d / teeth), col:Lerp(Color3.new(1, 1, 1), 0.2), M.Metal)
		-- glazing on the vertical (+Z) face of each tooth
		B.box(m, cf * CFrame.new(0, h + 2.5, z + d / teeth / 2 + 0.2), Vector3.new(w - 1, 4.6, 0.3), Color3.fromRGB(150, 190, 210), M.Glass, nc({ Transparency = 0.4 }))
	end
	if o.sign then
		local sign = B.box(m, cf * CFrame.new(0, h - 3, -0.6), Vector3.new(math.min(w - 6, 40), 4, 0.6), Color3.fromRGB(30, 50, 90), M.SmoothPlastic)
		B.sign(sign, Enum.NormalId.Front, o.sign, { color = Color3.new(1, 1, 1), font = B.Fonts.Heavy })
	end
	if o.chimney then
		local x = w / 2 - 6
		B.cylY(m, cf * CFrame.new(x, h + 14, d - 8), 28, 4, Color3.fromRGB(150, 70, 60), M.Brick)
		local top = B.cylY(m, cf * CFrame.new(x, h + 28.2, d - 8), 0.4, 4.6, Color3.fromRGB(60, 60, 60), M.Metal)
		top:AddTag("Chimney")
	end
	return m
end

return Buildings
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1289">
          <Properties>
            <string name="Name">DesktopLayout</string>
            <string name="Source"><![CDATA[-- DesktopLayout: where every node of a desktop sits and how to draw it, for PCModel.
--
-- The case lies on its side the way technicians work on it: the open side faces up (+Y), the front
-- panel is on the left (-X), the rear I/O on the right (+X), the top of the tower away from the
-- technician (-Z) and the PSU end towards them (+Z). Board parts are posed in the motherboard's
-- own frame (origin at its top-rear corner, PCB surface at y = 0).

local Shared = script.Parent.Parent
local Parts = require(Shared.Data.Parts)
local Rules = require(Shared.Repair.RepairRules)
local Templates = require(Shared.Repair.DeviceTemplates)
local PCParts = require(script.Parent.PCParts)

local DesktopLayout = {}

local cm = PCParts.cm
local T = Templates.desktop

local function partOf(view, id: string)
	local s = view.nodes[id]
	return s and s.part and Parts.get(s.part) or nil
end

local function screwBit(view, id: string): string
	local ok, bit = pcall(Rules.screwBit, view, id)
	return if ok then bit else "PH2"
end

local MOUNT_HOLES = {
	ATX = { { 5.5, 0.6 }, { 23.6, 0.8 }, { 23.6, 17.3 }, { 23.6, 29.7 }, { 1.2, 29.7 }, { 1.2, 17 } },
	mATX = { { 5.5, 0.6 }, { 23.6, 0.8 }, { 23.6, 17.3 }, { 23.6, 23.6 }, { 1.2, 23.6 }, { 1.2, 17 } },
	ITX = { { 5.5, 0.6 }, { 16.2, 0.8 }, { 16.2, 16.2 }, { 1.2, 16.2 }, { 12.6, 4.9 }, { 9, 16.4 } },
}

-- Everything the layout derives from the case and the installed board/PSU.
local function geometry(view)
	local casePart = Parts.get(view.model)
	local dims = PCParts.caseDims(casePart)
	local lx, ly, lz = dims.X, dims.Y, dims.Z
	local style = casePart and casePart.style or "airflow"
	local mobo = partOf(view, "mobo")
	local BL = PCParts.boardLayout(mobo)
	local g = { case = casePart, dims = dims, style = style, board = BL, moboPart = mobo }
	-- PSU: bottom-rear, or front-top in slim cases; turned flat if the case is too low
	local psuPart = partOf(view, "psu")
	local pd = PCParts.psuDims(psuPart)
	local rot = CFrame.new()
	local dx, dy, dz = pd.X, pd.Y, pd.Z
	if dy > ly - 0.08 then
		rot = CFrame.Angles(math.pi / 2, 0, 0)
		dy, dz = pd.Z, pd.Y
	end
	if style == "sff" then
		g.psu = CFrame.new(-lx / 2 + 0.06 + dx / 2, 0.04 + dy / 2, -lz / 2 + 0.05 + dz / 2) * rot
	else
		g.psu = CFrame.new(lx / 2 - 0.04 - dx / 2, 0.04 + dy / 2, lz / 2 - 0.1 - dz / 2) * rot
	end
	g.psuSize = Vector3.new(dx, dy, dz)
	-- board: top-rear corner below the top fans (closer to the top in short cases)
	local topGap = if style == "office" then 0.12 elseif style == "retro" then 0.15 elseif style == "sff" then 0.12 else 0.34
	g.mobo = CFrame.new(lx / 2 - 0.2, 0.1, -lz / 2 + topGap)
	-- the front strip between the front panel and the board
	g.frontX0 = -lx / 2 + cm(2.4) + 0.2
	g.frontX1 = lx / 2 - 0.2 - cm(BL.W)
	return g
end
DesktopLayout.geometry = geometry

-- Drive bays laid on the tray in the front strip; turned lengthwise if the strip is narrow.
local function bayPose(g, d: Vector3, atTop: boolean): CFrame
	local gap = g.frontX1 - g.frontX0
	local lz = g.dims.Z
	local rot = CFrame.new()
	local w, depth = d.X, d.Z
	if w > gap - 0.04 then
		rot = CFrame.Angles(0, math.pi / 2, 0)
		w, depth = d.Z, d.X
	end
	local x = g.frontX0 + w / 2 + 0.02
	local z = if atTop then -lz / 2 + 0.45 + depth / 2 else lz / 2 - 0.08 - depth / 2
	if g.style == "sff" and atTop then
		z = lz / 2 - 0.08 - depth / 2
	end
	return CFrame.new(x, 0.04, z) * rot
end

-- Case fan homes: axis +Y of the fan model turned to blow along the case.
local function fanHome(g, id: string, size: number): CFrame
	local lx, ly, lz = g.dims.X, g.dims.Y, g.dims.Z
	local t = cm(2.6)
	if id == "fan_r" then
		local y = math.max(ly / 2, 0.38 + size / 2)
		return CFrame.new(lx / 2 - 0.035 - t / 2, math.min(y, ly - size / 2 - 0.02), g.mobo.Z + cm(8)) * CFrame.Angles(0, 0, math.pi / 2)
	elseif string.sub(id, 1, 5) == "fan_f" then
		local i = tonumber(string.sub(id, 6)) or 1
		return CFrame.new(-lx / 2 + cm(2.4) + t / 2, ly / 2, (i - 2) * (size + 0.04)) * CFrame.Angles(0, 0, -math.pi / 2)
	else
		local i = tonumber(string.sub(id, 6)) or 1
		local x = if i == 1 then -0.62 else 0.38
		return CFrame.new(x, math.min(ly / 2 + 0.1, ly - size / 2 - 0.02), -lz / 2 + 0.035 + t / 2) * CFrame.Angles(math.pi / 2, 0, 0)
	end
end

local function fanSize(fanPart): number
	return cm(fanPart and fanPart.size or 120) / 10
end

function DesktopLayout.describe(view, _opts)
	local g = geometry(view)
	local BL = g.board
	local lx, ly, lz = g.dims.X, g.dims.Y, g.dims.Z
	local nodes = {}
	local order = {}
	local visible = view.visible or {}

	local function st(id: string): string?
		local s = view.nodes[id]
		return s and s.st
	end

	local function add(id: string, s)
		s.kind = s.kind or (T.nodes[id] and T.nodes[id].kind) or "comp"
		nodes[id] = s
		table.insert(order, id)
		return s
	end

	-- screws of an owner: homes are given relative to the owner
	local function screws(owner: string, homes: { CFrame })
		local tn = T.nodes[owner]
		for i, sid in tn.screws do
			local home = homes[i] or homes[#homes]
			if not Rules.available(view, sid) or nodes[owner] == nil or nodes[owner].hide then
				add(sid, { hide = true, kind = "screw" })
			else
				local bit = screwBit(view, sid)
				add(sid, {
					kind = "screw",
					parent = owner,
					home = home,
					out = st(sid) ~= "in",
					sig = "screw:" .. bit,
					build = function(cf)
						return PCParts.screw(cf, bit)
					end,
				})
			end
		end
	end

	-- a component slot: hidden when empty, laid out when removed
	local function comp(id: string, parent: string?, home: CFrame, builder: (CFrame, any) -> Model, extra: { [string]: any }?)
		local s = view.nodes[id]
		local part = partOf(view, id)
		if not s or s.st == "empty" or not part or not Rules.available(view, id) then
			return add(id, { hide = true })
		end
		local spec = {
			parent = parent,
			home = home,
			out = s.st == "out",
			sig = id .. ":" .. part.id,
			build = function(cf)
				return builder(cf, part)
			end,
		}
		if extra then
			for k, v in extra do
				spec[k] = v
			end
		end
		return add(id, spec)
	end

	-- the chassis
	add("case", {
		kind = "root",
		home = CFrame.new(),
		sig = "case:" .. tostring(view.model),
		build = function(cf)
			local m = PCParts.chassis(cf, g.case)
			return m
		end,
	})

	-- side panel and its thumb screws
	local panelSt = st("side_panel")
	add("side_panel", {
		kind = "panel",
		parent = "case",
		home = CFrame.new(0, ly + 0.0125, 0),
		offset = if panelSt == "loose" then CFrame.new(0, 0.06, 0) else nil,
		out = panelSt == "out",
		lean = true,
		sig = "panel:" .. tostring(view.model),
		build = function(cf)
			return PCParts.sidePanel(cf, g.case, g.dims)
		end,
	})
	local spHomes = {}
	for _, o in { { 1, -1 }, { 1, 1 }, { -1, -1 }, { -1, 1 } } do
		table.insert(spHomes, CFrame.new(o[1] * (lx / 2 - 0.14), 0.0125, o[2] * (lz / 2 - 0.14)))
	end
	screws("side_panel", spHomes)

	-- power supply
	comp("psu", "case", g.psu, function(cf, p)
		return PCParts.psu(cf, p)
	end)
	local pd = PCParts.psuDims(partOf(view, "psu"))
	screws("psu", {
		CFrame.new(pd.X / 2 - cm(0.8), pd.Y / 2, -pd.Z / 2 + cm(0.9)),
		CFrame.new(pd.X / 2 - cm(0.8), pd.Y / 2, pd.Z / 2 - cm(0.9)),
		CFrame.new(-pd.X / 2 + cm(0.8), pd.Y / 2, -pd.Z / 2 + cm(0.9)),
		CFrame.new(-pd.X / 2 + cm(0.8), pd.Y / 2, pd.Z / 2 - cm(0.9)),
	})

	-- motherboard and everything on it
	comp("mobo", "case", g.mobo, function(cf, p)
		local m = PCParts.mobo(cf, p)
		return m
	end)
	local holes = MOUNT_HOLES[BL.form] or MOUNT_HOLES.ATX
	local mbHomes = {}
	for _, h in holes do
		table.insert(mbHomes, BL.at(h[1], h[2]))
	end
	screws("mobo", mbHomes)

	local socket = g.moboPart and g.moboPart.socket or "AM4"
	if g.moboPart and st("mobo") ~= "empty" and Rules.available(view, "socket") then
		local bent = st("socket") == "bent" and st("cpu") ~= "in"
		add("socket", {
			kind = "pins",
			parent = "mobo",
			home = BL.socket,
			sig = "pins:" .. socket .. ":" .. tostring(bent),
			build = function(cf)
				return PCParts.pins(cf, socket, bent)
			end,
		})
	else
		add("socket", { hide = true })
	end

	local paste = view.paste or { st = "none" }
	comp("cpu", "mobo", BL.socket * CFrame.new(0, cm(0.55), 0), function(cf, p)
		local m = PCParts.cpu(cf, p)
		if paste.st ~= "clean" and paste.st ~= "none" then
			local blob = PCParts.paste(cf * CFrame.new(0, cm(0.42), 0))
			local part = blob:FindFirstChild("Blob") :: BasePart
			if part then
				local sw, sh = PCParts.socketSize(p.socket or "AM4")
				if paste.st == "fresh" then
					part.Size = Vector3.new(0.008, cm(sw * 0.45), cm(sw * 0.45))
					part.Color = Color3.fromRGB(150, 152, 160)
				elseif paste.st == "old" then
					part.Size = Vector3.new(0.006, cm(math.min(sw, sh) * 0.72), cm(math.min(sw, sh) * 0.72))
					part.Color = Color3.fromRGB(120, 122, 128)
				else
					part.Size = Vector3.new(0.006, cm(math.min(sw, sh) * 0.66), cm(math.min(sw, sh) * 0.66))
					part.Color = Color3.fromRGB(200, 200, 196)
					part.Material = Enum.Material.Slate
				end
			end
			blob.Parent = m
		end
		return m
	end, {
		sig = "cpu:" .. tostring(view.nodes.cpu and view.nodes.cpu.part) .. ":" .. tostring(paste.st),
	})

	if g.moboPart and Rules.available(view, "cpu_arm") and st("mobo") ~= "empty" then
		local sw, sh = PCParts.socketSize(socket)
		local open = st("cpu_arm") == "open"
		add("cpu_arm", {
			kind = "latch",
			parent = "mobo",
			home = BL.socket * CFrame.new(cm(sh / 2 + 0.9), cm(0.2), cm(sw / 2 + 0.5)),
			offset = if open then CFrame.Angles(math.rad(100), 0, 0) else nil,
			sig = "arm",
			build = function(cf)
				return PCParts.latch(cf, "arm")
			end,
		})
	else
		add("cpu_arm", { hide = true })
	end

	-- cooler: an AIO's radiator hangs behind the front fans
	local coolerHome = BL.socket * CFrame.new(0, cm(0.97), 0)
	local radInCase = CFrame.new(-lx / 2 + cm(2.4) + cm(2.6) + 0.12, ly / 2, 0) * CFrame.Angles(0, math.pi / 2, 0)
	comp("cooler", "mobo", coolerHome, function(cf, p)
		local ctx = { radCf = (g.mobo * coolerHome):ToObjectSpace(radInCase) }
		return PCParts.cooler(cf, p, ctx)
	end)
	local coolerPart = partOf(view, "cooler")
	local base = if coolerPart and coolerPart.kind == "air" then cm(1.2) elseif coolerPart and coolerPart.kind == "aio" then cm(0.4) else cm(1.2)
	screws("cooler", {
		CFrame.new(-cm(3.7), base, -cm(3.7)),
		CFrame.new(cm(3.7), base, -cm(3.7)),
		CFrame.new(-cm(3.7), base, cm(3.7)),
		CFrame.new(cm(3.7), base, cm(3.7)),
	})

	-- memory and clips
	for i = 1, 4 do
		local id = "ram" .. i
		local slot = BL.ram[i]
		if slot then
			local unseated = visible[id] == "unseated"
			comp(id, "mobo", slot * CFrame.new(0, cm(0.25), 0), function(cf, p)
				return PCParts.ram(cf, p)
			end, {
				offset = if unseated then CFrame.new(0, 0.03, 0) * CFrame.Angles(0, 0, math.rad(5)) else nil,
				outRot = CFrame.Angles(0, 0, -math.pi / 2),
			})
			local clipId = id .. "_clip"
			if Rules.available(view, clipId) and st("mobo") ~= "empty" then
				local open = st(clipId) == "open"
				add(clipId, {
					kind = "latch",
					parent = "mobo",
					home = slot * CFrame.new(0, 0, -cm(BL.ramLen / 2 + 0.7)),
					offset = if open then CFrame.Angles(math.rad(-45), 0, 0) else nil,
					sig = "clip",
					build = function(cf)
						return PCParts.latch(cf, "ram")
					end,
				})
			else
				add(clipId, { hide = true })
			end
		else
			add(id, { hide = true })
			add(id .. "_clip", { hide = true })
		end
	end

	-- graphics card (posed from the board's x16 slot, mounted to the case)
	local gpuPart = partOf(view, "gpu")
	local gpuHome = g.mobo * CFrame.new(-cm(2), cm(0.8), cm(15.3))
	local connectors = if gpuPart then Parts.gpuConnectors(gpuPart) else {}
	comp("gpu", "case", gpuHome, function(cf, p)
		local m = PCParts.gpu(cf, p, connectors)
		return m
	end, {
		offset = if visible.gpu == "unseated" then CFrame.new(0, 0.03, 0) * CFrame.Angles(math.rad(-3), 0, 0) else nil,
		outRot = CFrame.Angles(math.rad(-90), 0, 0),
	})
	local _, gh = PCParts.gpuDims(gpuPart)
	screws("gpu", {
		CFrame.new(cm(0.8), gh + cm(0.35), cm(0.1)),
		CFrame.new(cm(0.8), gh + cm(0.35), cm(2.1)),
	})
	if Rules.available(view, "pcie_latch") and st("mobo") ~= "empty" then
		local open = st("pcie_latch") == "open"
		add("pcie_latch", {
			kind = "latch",
			parent = "mobo",
			home = BL.pcieLatch,
			offset = if open then CFrame.Angles(0, 0, math.rad(-35)) else nil,
			sig = "pcie",
			build = function(cf)
				return PCParts.latch(cf, "pcie")
			end,
		})
	else
		add("pcie_latch", { hide = true })
	end

	-- M.2 drives
	for i = 1, 2 do
		local id = "nvme" .. i
		local slot = BL.nvme[i] or BL.nvme[1]
		local d = PCParts.storageDims(partOf(view, id))
		comp(id, "mobo", slot * CFrame.new(-cm(0.2), cm(0.4), 0), function(cf, p)
			return PCParts.storage(cf, p)
		end)
		screws(id, { CFrame.new(-d.X / 2 + cm(0.15), cm(0.35), 0) })
	end

	-- drive bays
	local hddPart = partOf(view, "hdd1")
	local hd = PCParts.storageDims(hddPart or Parts.get("st_hdd1t"))
	comp("hdd1", "case", bayPose(g, hd, false), function(cf, p)
		return PCParts.storage(cf, p)
	end)
	screws("hdd1", {
		CFrame.new(-hd.X / 2 + cm(1.6), hd.Y, -hd.Z / 2 + cm(1)),
		CFrame.new(-hd.X / 2 + cm(1.6), hd.Y, hd.Z / 2 - cm(1)),
	})
	local ssdPart = partOf(view, "ssd1")
	local sd = PCParts.storageDims(ssdPart or Parts.get("st_ssd480"))
	comp("ssd1", "case", bayPose(g, sd, true), function(cf, p)
		return PCParts.storage(cf, p)
	end)
	screws("ssd1", {
		CFrame.new(-sd.X / 2 + cm(1.2), sd.Y, -sd.Z / 2 + cm(0.9)),
		CFrame.new(-sd.X / 2 + cm(1.2), sd.Y, sd.Z / 2 - cm(0.9)),
	})

	-- CMOS battery and the service capacitors
	comp("cmos", "mobo", BL.cmos * CFrame.new(0, cm(0.05), 0), function(cf)
		return PCParts.cmos(cf)
	end)
	for i = 1, 6 do
		local id = "cap" .. i
		local bulged = visible[id] == "bulged"
		local s = view.nodes[id]
		comp(id, "mobo", BL.caps[i], function(cf)
			return PCParts.capacitor(cf, bulged)
		end, {
			sig = id .. ":" .. tostring(s and s.part) .. ":" .. tostring(bulged),
			offset = if s and s.st == "loose" then CFrame.new(0, 0.06, 0) * CFrame.Angles(0, 0, math.rad(8)) else nil,
		})
	end

	-- case fans (with their four screws)
	for _, id in T.fanSlots do
		local fp = partOf(view, id)
		local size = fanSize(fp)
		comp(id, "case", fanHome(g, id, size), function(cf, p)
			return PCParts.fan(cf, p)
		end)
		local c = size * 0.41
		screws(id, {
			CFrame.new(-c, cm(1.3), -c),
			CFrame.new(c, cm(1.3), -c),
			CFrame.new(-c, cm(1.3), c),
			CFrame.new(c, cm(1.3), c),
		})
	end

	-- cables (drawn by PCModel from the posed nodes)
	local cables = DesktopLayout.cables(view, g)

	-- every template node must be described
	for _, id in T.order do
		if not nodes[id] and T.nodes[id].kind ~= "cable" then
			add(id, { hide = true })
		end
	end
	return { base = CFrame.new(-0.5, 0, 0), order = order, nodes = nodes, cables = cables }
end

----------------------------------------------------------------------------------------------------
-- Cable routes
----------------------------------------------------------------------------------------------------
local ROUTE_Y = { atx24 = 0.24, eps = 0.3, pcie = 1.3, sata_power = 0.26, sata_data = 0.22, fan = 0.2 }

function DesktopLayout.cables(view, g)
	local BL = g.board
	local list = {}
	local function st(id: string): string?
		local s = view.nodes[id]
		return s and s.st
	end
	local function cable(id: string, style: string, src: (any) -> Vector3?, dst: (any) -> CFrame?, viaFront: boolean?)
		if not Rules.available(view, id) then
			return
		end
		local tn = T.nodes[id]
		local plugged = st(id) == "in"
		local a, b = st(tn.ends[1]), st(tn.ends[2])
		if not plugged and not (a == "in" and b == "in") then
			return
		end
		table.insert(list, {
			id = id,
			style = style,
			route = function(h)
				local w0 = src(h)
				local head = dst(h)
				if not w0 or not head then
					return nil
				end
				local headH = PCParts.CableStyle[style].head[2]
				if not plugged then
					-- pulled off: the plug hangs above its socket
					head = CFrame.new(0, 0.32, 0) * head * CFrame.new(0.06, 0, 0.08) * CFrame.Angles(math.rad(25), 0, math.rad(15))
				end
				-- route in the device frame, then back to the world
				local R = h.root
				local a = R:PointToObjectSpace(w0)
				local top = (R:ToObjectSpace(head) * CFrame.new(0, headH, 0)).Position
				local y = ROUTE_Y[style] or 0.3
				local pts = { a, Vector3.new(a.X, math.max(a.Y, y), a.Z) }
				if viaFront then
					local fx = R:PointToObjectSpace(((h:worldOf("mobo") or R) * BL.at(BL.W + 1.6, 0)).Position).X
					table.insert(pts, Vector3.new(fx, math.max(a.Y, y), a.Z))
					table.insert(pts, Vector3.new(fx, math.max(a.Y, y), top.Z))
				end
				-- square runs: along Z first, then across X
				local last = pts[#pts]
				table.insert(pts, Vector3.new(last.X, last.Y, top.Z))
				table.insert(pts, Vector3.new(top.X, math.max(top.Y, y), top.Z))
				table.insert(pts, top)
				for i, p in pts do
					pts[i] = R * p
				end
				return pts, head
			end,
		})
	end

	local function on(id: string, rel: CFrame): (any) -> CFrame?
		return function(h)
			local w = h:worldOf(id)
			return w and w * rel or nil
		end
	end
	local function psuOut(rel: Vector3): (any) -> Vector3?
		return function(h)
			local w = h:worldOf("psu")
			if not w then
				return nil
			end
			local d = g.psuSize
			return (w * CFrame.new(-d.X / 2 - 0.02 + rel.X, rel.Y, rel.Z)).Position
		end
	end

	cable("c24", "atx24", psuOut(Vector3.new(0, 0.1, -0.15)), on("mobo", BL.atx24 * CFrame.new(0, cm(1.1), 0)), true)
	cable("ceps", "eps", psuOut(Vector3.new(0, 0.25, 0)), on("mobo", BL.eps * CFrame.new(0, cm(1), 0)), true)
	local gpuPart = partOf(view, "gpu")
	local sockets = if gpuPart then PCParts.gpuSockets(gpuPart, Parts.gpuConnectors(gpuPart)) else {}
	for i = 1, 3 do
		if sockets[i] then
			cable("cpcie" .. i, "pcie", psuOut(Vector3.new(0, 0.3, 0.12 * i)), on("gpu", sockets[i]))
		end
	end
	local coolerPart = partOf(view, "cooler")
	local fanAt = if coolerPart and coolerPart.kind == "air" then CFrame.new(-cm(4), cm(9), cm(5)) elseif coolerPart and coolerPart.kind == "aio" then CFrame.new(cm(2.5), cm(2), cm(2.5)) else CFrame.new(cm(4), cm(3.6), cm(3))
	cable("cfan_cpu", "fan", function(h)
		local w = h:worldOf("cooler")
		return w and (w * fanAt).Position or nil
	end, on("mobo", BL.cpuFan * CFrame.new(0, cm(0.6), 0)))
	for k, id in Rules.FanOrder do
		local header = BL.sysFan[k] or BL.sysFan[1]
		cable("cfan_" .. id, "fan", function(h)
			local w = h:worldOf(id)
			return w and (w * CFrame.new(cm(5), -cm(1.3), cm(5))).Position or nil
		end, on("mobo", header * CFrame.new(0, cm(0.6), 0)))
	end
	-- SATA: power from the PSU, data to the board's ports; drive sockets are on the +X end
	local function driveSocket(id: string, z: number): (any) -> CFrame?
		return function(h)
			local w = h:worldOf(id)
			if not w then
				return nil
			end
			local d = PCParts.storageDims(partOf(view, id))
			-- plug pushed in along +X, its width across the drive (Z)
			return w * CFrame.new(d.X / 2 + 0.01, d.Y * 0.45, z * d.Z) * CFrame.fromMatrix(Vector3.zero, Vector3.new(0, 0, 1), Vector3.new(1, 0, 0))
		end
	end
	local function driveSrc(id: string, z: number): (any) -> Vector3?
		local f = driveSocket(id, z)
		return function(h)
			local c = f(h)
			return c and (c * CFrame.new(0, 0.06, 0)).Position or nil
		end
	end
	cable("csp_hdd1", "sata_power", psuOut(Vector3.new(0, 0.15, 0.25)), driveSocket("hdd1", -0.15))
	cable("csd_hdd1", "sata_data", driveSrc("hdd1", 0.25), on("mobo", BL.sata[1] * CFrame.new(0, cm(1), 0)))
	cable("csp_ssd1", "sata_power", psuOut(Vector3.new(0, 0.2, 0.3)), driveSocket("ssd1", -0.15))
	cable("csd_ssd1", "sata_data", driveSrc("ssd1", 0.2), on("mobo", BL.sata[2] * CFrame.new(0, cm(1), 0)))
	return list
end

----------------------------------------------------------------------------------------------------
-- Per-state looks that don't need a rebuild
----------------------------------------------------------------------------------------------------
function DesktopLayout.decorate(handle, view)
	for id, rec in handle.recs do
		if rec.model then
			local s = view.nodes[id]
			local dust = s and s.dust or 0
			for _, d in rec.model:GetDescendants() do
				if d:IsA("BasePart") and d:GetAttribute("Dust") then
					local opacity = math.clamp((dust - 0.03) * 3.2, 0, 0.9)
					d.Transparency = 1 - opacity
				end
			end
		end
	end
	-- zip-tied cable runs read as tidy (cable model gets a couple of white ties)
	if view.ties then
		for id, m in handle.cables do
			if id == "c24" or id == "ceps" then
				local head = m:FindFirstChild("Head") :: BasePart?
				if head then
					PCParts.box(m, head.CFrame * CFrame.new(0, 0, 0.3), Vector3.new(0.2, 0.09, 0.02), Color3.fromRGB(240, 240, 240), Enum.Material.SmoothPlastic, { Name = "Tie" })
				end
			end
		end
	end
end

return DesktopLayout
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1290">
          <Properties>
            <string name="Name">LaptopLayout</string>
            <string name="Source"><![CDATA[-- LaptopLayout: where every node of a laptop sits and how to draw it, for PCModel.
--
-- Base frame (node "base"): origin in the middle of the chassis, keyboard deck up (+Y), hinge at
-- -Z, palm rest edge at +Z. Internals are drawn to be seen from below, because the technician
-- flips the laptop (base rotates 180° about Z) to open the bottom cover. The lid is a synthetic
-- node "lid" hinged on the deck; the bezel, screen and hinges ride on it.

local Shared = script.Parent.Parent
local Parts = require(Shared.Data.Parts)
local Devices = require(Shared.Data.Devices)
local Rules = require(Shared.Repair.RepairRules)
local Templates = require(Shared.Repair.DeviceTemplates)
local PCParts = require(script.Parent.PCParts)

local LaptopLayout = {}

local cm = PCParts.cm
local box = PCParts.box
local cyl = PCParts.cyl
local newModel = PCParts.newModel
local M = Enum.Material
local T = Templates.laptop

local DOWN = CFrame.Angles(math.pi, 0, 0) -- faces -Y (seen from below)

local function partOf(view, id: string)
	local s = view.nodes[id]
	return s and s.part and Parts.get(s.part) or nil
end

local function screwBit(view, id: string): string
	local ok, bit = pcall(Rules.screwBit, view, id)
	return if ok then bit else "PH1"
end

-- Dimensions in studs: w, d, base thickness, lid thickness.
function LaptopLayout.dims(view)
	local model = Devices.laptop(view.model) or Devices.laptops[1]
	local d = Devices.laptopDims[model.class] or { 36, 24, 2 }
	local total = cm(d[3])
	local lidT = math.clamp(total * 0.3, cm(0.5), cm(0.8))
	return { w = cm(d[1]), d = cm(d[2]), t = total - lidT, lidT = lidT, model = model }
end

-- fractional position on the base (x, z in -0.5..0.5 of width/depth) at height y
local function at(D, fx: number, fz: number, y: number?): CFrame
	return CFrame.new(fx * D.w, y or 0, fz * D.d)
end

----------------------------------------------------------------------------------------------------
-- Builders
----------------------------------------------------------------------------------------------------
local function shellColor(D): Color3
	local c = D.model.color or { 60, 60, 66 }
	return Color3.fromRGB(c[1], c[2], c[3])
end

local function brandOf(D): string
	return string.upper(string.match(D.model.name or "", "^(%S+)") or "")
end

-- base shell: palm rest deck with touchpad and keyboard well, side walls, ports
local function buildBase(cf: CFrame, D): Model
	local m = newModel("Chassis", cf)
	local shell = shellColor(D)
	local w, d, t = D.w, D.d, D.t
	local deck = box(m, cf * CFrame.new(0, t / 2 - 0.006, 0), Vector3.new(w, 0.012, d), shell, M.Metal, { Name = "Deck" })
	deck:SetAttribute("Detail", "deck")
	-- side walls
	for _, x in { -w / 2 + 0.006, w / 2 - 0.006 } do
		box(m, cf * CFrame.new(x, 0, 0), Vector3.new(0.012, t, d), shell, M.Metal)
	end
	box(m, cf * CFrame.new(0, 0, d / 2 - 0.006), Vector3.new(w, t, 0.012), shell, M.Metal)
	box(m, cf * CFrame.new(0, 0, -d / 2 + 0.006), Vector3.new(w, t, 0.012), shell:Lerp(Color3.new(0, 0, 0), 0.25), M.Metal)
	-- inner frame (seen from below when the cover is off)
	box(m, cf * CFrame.new(0, t / 2 - 0.02, 0), Vector3.new(w - 0.03, 0.01, d - 0.03), Color3.fromRGB(40, 42, 46), M.Metal, { Name = "InnerFrame" })
	-- touchpad and keyboard well
	box(m, cf * at(D, 0, 0.25, t / 2 + 0.001), Vector3.new(w * 0.34, 0.003, d * 0.24), shell:Lerp(Color3.new(1, 1, 1), 0.08), M.Glass, { Name = "Touchpad" })
	box(m, cf * at(D, 0, -0.19, t / 2 + 0.0005), Vector3.new(w * 0.9, 0.002, d * 0.44), Color3.fromRGB(18, 18, 20), M.SmoothPlastic, { Name = "KeyboardWell" })
	-- ports on the sides
	for k = 0, 2 do
		box(m, cf * at(D, -0.5, -0.1 + k * 0.08, 0) * CFrame.new(-0.004, 0, 0), Vector3.new(0.006, t * 0.35, cm(1.3)), Color3.fromRGB(16, 16, 18))
		box(m, cf * at(D, 0.5, -0.05 + k * 0.08, 0) * CFrame.new(0.004, 0, 0), Vector3.new(0.006, t * 0.35, cm(1.3)), Color3.fromRGB(16, 16, 18))
	end
	-- speakers (front corners, inside)
	for _, fx in { -0.4, 0.4 } do
		box(m, cf * at(D, fx, 0.4, -t / 2 + 0.02), Vector3.new(cm(4), 0.012, cm(1.8)), Color3.fromRGB(20, 20, 22), M.SmoothPlastic)
	end
	-- power LED
	box(m, cf * at(D, 0.42, 0.495, t * 0.2), Vector3.new(cm(0.6), cm(0.15), 0.004), Color3.fromRGB(255, 255, 255), M.Neon, { Name = "PowerLed", Transparency = 0.7 })
	return m
end

local function buildBottomCover(cf: CFrame, D): Model
	local m = newModel("BottomCover", cf)
	local shell = shellColor(D):Lerp(Color3.new(0, 0, 0), 0.15)
	local w, d = D.w, D.d
	local plate = box(m, cf, Vector3.new(w - 0.004, 0.012, d - 0.004), shell, M.SmoothPlastic, { Name = "Plate" })
	plate:SetAttribute("Detail", "cover")
	-- intake vents (on the outer face, -Y)
	for r = 0, 5 do
		box(m, cf * at(D, -0.12, -0.32 + r * 0.035, -0.007), Vector3.new(w * 0.5, 0.004, cm(0.35)), Color3.fromRGB(12, 12, 14))
	end
	-- model sticker
	local sticker = box(m, cf * at(D, 0.25, 0.25, -0.007), Vector3.new(cm(6), 0.002, cm(3)), Color3.fromRGB(236, 236, 232), M.SmoothPlastic)
	sticker.CFrame = sticker.CFrame * DOWN
	PCParts.label(sticker, Enum.NormalId.Top, D.model.name or "", Color3.fromRGB(30, 30, 30), 300, nil)
	return m
end

local function buildFeet(cf: CFrame, D, peeled: boolean): Model
	local m = newModel("Feet", cf)
	for _, fz in { -0.42, 0.42 } do
		local foot = cf * at(D, 0, fz, -0.012)
		if peeled then
			-- peeled back strips curl up at one end
			box(m, foot * CFrame.new(-D.w * 0.2, -0.03, 0) * CFrame.Angles(0, 0, math.rad(-12)), Vector3.new(D.w * 0.38, cm(0.3), cm(1)), Color3.fromRGB(26, 26, 28), M.Rubber)
		else
			box(m, foot, Vector3.new(D.w * 0.76, cm(0.3), cm(1)), Color3.fromRGB(26, 26, 28), M.Rubber)
		end
		box(m, foot, Vector3.new(D.w * 0.76, 0.06, 0.14), Color3.new(0, 0, 0), M.SmoothPlastic, { Name = "Hitbox", Transparency = 1 })
	end
	return m
end

local function swell(m: Model, cf: CFrame, w: number, h: number, d: number)
	local bulge = Instance.new("Part")
	bulge.Name = "Swelling"
	bulge.Anchored = true
	bulge.CanCollide = false
	bulge.CanTouch = false
	bulge.Size = Vector3.new(w * 0.9, h * 1.1, d * 0.85)
	bulge.CFrame = cf * CFrame.new(0, -h * 0.15, 0)
	bulge.Color = Color3.fromRGB(40, 40, 44)
	bulge.Material = M.SmoothPlastic
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = bulge
	bulge.Parent = m
end

local function buildBattery(cf: CFrame, D, swollen: boolean): Model
	local m = newModel("Battery", cf)
	local w, d, h = D.w * 0.8, D.d * 0.36, D.t * 0.55
	if D.model.class == "budget15" then
		w = D.w * 0.48
	end
	local body = box(m, cf, Vector3.new(w, h, d), Color3.fromRGB(28, 28, 30), M.SmoothPlastic, { Name = "Cells" })
	body:SetAttribute("Detail", "battery")
	if swollen then
		swell(m, cf, w, h, d)
	end
	local lab = box(m, cf * CFrame.new(0, -h / 2 - 0.002, 0), Vector3.new(w * 0.6, 0.003, d * 0.6), Color3.fromRGB(236, 236, 232), M.SmoothPlastic, { Name = "Label" })
	lab.CFrame = lab.CFrame * DOWN
	PCParts.label(lab, Enum.NormalId.Top, "Li-ion 11.4V\n" .. brandOf(D), Color3.fromRGB(30, 30, 30), 220, nil)
	-- the connector tail runs to the board (towards -Z)
	box(m, cf * CFrame.new(0, -h / 2 + 0.01, -d / 2 - cm(0.8)), Vector3.new(cm(2.4), 0.008, cm(1.6)), Color3.fromRGB(196, 150, 70), M.SmoothPlastic)
	return m
end


-- blower fan(s), heat pipes, fin stacks and the copper plate over the dies
local function buildCooling(cf: CFrame, D): Model
	local m = newModel("Cooling", cf)
	local gaming = D.model.class == "gaming15" or D.model.class == "gaming17"
	local copper = Color3.fromRGB(196, 116, 70)
	local fanXs = if gaming then { -0.32, 0.32 } else { 0.3 }
	local dia = D.w * (if gaming then 0.17 else 0.15)
	for _, fx in fanXs do
		local c = cf * at(D, fx, -0.02, 0)
		box(m, c, Vector3.new(dia * 1.08, D.t * 0.5, dia * 1.08), Color3.fromRGB(26, 26, 28), M.SmoothPlastic, { Name = "FanHousing" })
		local rotorCf = c * CFrame.new(0, -D.t * 0.25 - 0.002, 0)
		PCParts.rotor(m, rotorCf, dia * 0.92, Color3.fromRGB(40, 40, 44), Color3.fromRGB(60, 60, 64), 25)
		-- fin stack towards the back vent
		box(m, cf * at(D, fx, -0.15, 0), Vector3.new(dia * 1.05, D.t * 0.45, cm(1.6)), Color3.fromRGB(150, 150, 156), M.Metal, { Name = "Fins" })
		PCParts.dustLayer(m, cf * at(D, fx, -0.02, -D.t * 0.26), Vector3.new(dia * 1.1, 0.01, dia * 1.1))
	end
	-- heat pipes from the dies to each fin stack
	for k = 0, (if gaming then 2 else 1) do
		cyl(m, cf * at(D, 0, 0.07 + k * 0.025, -D.t * 0.2), "X", D.w * (if gaming then 0.7 else 0.4), cm(0.6), copper, M.Metal)
	end
	-- cold plate over CPU (+GPU)
	box(m, cf * at(D, 0, 0.1, -D.t * 0.15), Vector3.new(D.w * (if gaming then 0.3 else 0.16), cm(0.25), cm(4)), copper, M.Metal, { Name = "ColdPlate" })
	return m
end

-- logic board with the CPU/GPU dies, chips and (if wet) corrosion
local function buildBoard(cf: CFrame, D, paste, liquid: number): Model
	local m = newModel("LogicBoard", cf)
	local gaming = D.model.class == "gaming15" or D.model.class == "gaming17"
	local pcb = box(m, cf, Vector3.new(D.w * 0.92, cm(0.16), D.d * 0.52), Color3.fromRGB(20, 40, 30), M.SmoothPlastic, { Name = "PCB" })
	pcb:SetAttribute("Detail", "board")
	local under = -cm(0.08) - 0.002
	-- dies (under the cold plate) with paste
	local dies = { { -0.1, 0.2 } }
	if gaming then
		table.insert(dies, { 0.11, 0.2 })
	end
	for _, dpos in dies do
		local c = cf * CFrame.new(dpos[1] * D.w, under, (dpos[2] - 0.22) * D.d)
		box(m, c, Vector3.new(cm(2.4), 0.008, cm(2.4)), Color3.fromRGB(32, 110, 60), M.SmoothPlastic)
		box(m, c * CFrame.new(0, -0.005, 0), Vector3.new(cm(1.4), 0.006, cm(1.2)), Color3.fromRGB(60, 60, 70), M.Glass, { Name = "Die" })
		if paste and paste.st ~= "clean" and paste.st ~= "none" then
			local blob = cyl(m, c * CFrame.new(0, -0.01, 0), "Y", 0.004, cm(if paste.st == "fresh" then 1 else 1.5), if paste.st == "dry" then Color3.fromRGB(200, 200, 196) else Color3.fromRGB(140, 142, 150), M.SmoothPlastic, { Name = "Paste", CastShadow = false })
			blob:SetAttribute("Paste", paste.st)
		end
	end
	-- chips, connectors
	for k = 0, 5 do
		box(m, cf * CFrame.new((-0.35 + k * 0.14) * D.w, under, 0.12 * D.d), Vector3.new(cm(1.2), 0.008, cm(1.2)), Color3.fromRGB(16, 16, 18))
	end
	-- liquid damage: green-white corrosion blotches
	if liquid > 0.02 then
		for k = 0, 3 do
			local stain = PCParts.box(m, cf * CFrame.new((-0.25 + k * 0.17) * D.w, under - 0.003, (-0.05 + (k % 2) * 0.1) * D.d), Vector3.new(cm(3 + k), 0.003, cm(2.2 + k * 0.6)), Color3.fromRGB(150, 190, 150), M.Slate, { Name = "Corrosion", CastShadow = false })
			stain.Transparency = math.clamp(1 - liquid * 1.6, 0.05, 0.9)
		end
	end
	return m
end

local function buildKeyboard(cf: CFrame, D): Model
	local m = newModel("Keyboard", cf)
	local w, d = D.w * 0.88, D.d * 0.42
	box(m, cf, Vector3.new(w, 0.01, d), Color3.fromRGB(26, 26, 28), M.Metal, { Name = "Plate" })
	local rows = 6
	local cols = 15
	local pitchX = w / cols
	local pitchZ = d / rows
	local key = Color3.fromRGB(34, 34, 38)
	for r = 0, rows - 1 do
		local n = if r == 5 then 9 else cols
		for c = 0, n - 1 do
			local kw = pitchX * 0.86
			local x = -w / 2 + pitchX * (c + 0.5)
			if r == 5 and c == 4 then
				kw = pitchX * 5.4 -- space bar
				x = -w / 2 + pitchX * 6.9
			elseif r == 5 and c > 4 then
				x = -w / 2 + pitchX * (c + 5.5)
			end
			if r == 5 and c > 4 and x > w / 2 then
				break
			end
			box(m, cf * CFrame.new(x, 0.007, -d / 2 + pitchZ * (r + 0.5)), Vector3.new(kw, 0.008, pitchZ * 0.84), key, M.SmoothPlastic, { CastShadow = false })
		end
	end
	return m
end

-- lid shell (the outer A-cover with the logo)
local function buildLid(cf: CFrame, D): Model
	local m = newModel("Lid", cf)
	local shell = shellColor(D)
	local w, d, lt = D.w, D.d, D.lidT
	local back = box(m, cf * CFrame.new(0, lt * 0.62, d / 2), Vector3.new(w, lt * 0.76, d), shell, M.Metal, { Name = "Cover" })
	back:SetAttribute("Detail", "lid")
	local logo = box(m, cf * CFrame.new(0, lt + 0.001, d * 0.5), Vector3.new(cm(8), 0.002, cm(2.4)), shell:Lerp(Color3.new(1, 1, 1), 0.4), M.Metal, { Name = "Logo" })
	PCParts.label(logo, Enum.NormalId.Top, brandOf(D), Color3.fromRGB(230, 230, 230), 300, nil)
	-- the inner face behind the panel
	box(m, cf * CFrame.new(0, lt * 0.22, d / 2), Vector3.new(w - 0.01, lt * 0.06, d - 0.01), Color3.fromRGB(20, 20, 22), M.SmoothPlastic)
	return m
end

local function buildBezel(cf: CFrame, D): Model
	local m = newModel("Bezel", cf)
	local w, d = D.w, D.d
	local col = Color3.fromRGB(14, 14, 16)
	local y = -0.002
	box(m, cf * CFrame.new(0, y, cm(1)), Vector3.new(w, 0.012, cm(2)), col)
	box(m, cf * CFrame.new(0, y, d - cm(0.5)), Vector3.new(w, 0.012, cm(1)), col)
	box(m, cf * CFrame.new(-w / 2 + cm(0.6), y, d / 2), Vector3.new(cm(1.2), 0.012, d), col)
	box(m, cf * CFrame.new(w / 2 - cm(0.6), y, d / 2), Vector3.new(cm(1.2), 0.012, d), col)
	cyl(m, cf * CFrame.new(0, y - 0.002, d - cm(0.5)), "Y", 0.002, cm(0.4), Color3.fromRGB(30, 40, 60), M.Glass)
	box(m, cf * CFrame.new(0, y, d / 2), Vector3.new(w, 0.02, d), Color3.new(0, 0, 0), M.SmoothPlastic, { Name = "Hitbox", Transparency = 1 })
	return m
end

local function buildScreen(cf: CFrame, D, cracked: boolean): Model
	local m = newModel("Screen", cf)
	local w, d = D.w - cm(1.6), D.d - cm(2.4)
	box(m, cf * CFrame.new(0, cm(0.18), d / 2 + cm(1.4)), Vector3.new(w, cm(0.3), d), Color3.fromRGB(150, 152, 158), M.Metal, { Name = "PanelBack" })
	local face = box(m, cf * CFrame.new(0, 0.004, d / 2 + cm(1.4)), Vector3.new(w - cm(0.6), 0.004, d - cm(0.6)), Color3.fromRGB(8, 10, 14), M.Glass, { Name = "Face" })
	face:SetAttribute("Screen", true)
	if cracked then
		local c0 = cf * CFrame.new(w * 0.15, 0.001, d * 0.55)
		for k = 0, 7 do
			local a = k * math.pi / 4 + 0.3
			local len = (0.25 + (k % 3) * 0.12) * d
			box(m, c0 * CFrame.Angles(0, a, 0) * CFrame.new(len / 2, 0, 0), Vector3.new(len, 0.002, 0.01), Color3.fromRGB(220, 230, 240), M.Neon, { Name = "Crack", CastShadow = false, Transparency = 0.2 })
		end
	end
	return m
end

local function buildHinges(cf: CFrame, D, broken: boolean): Model
	local m = newModel("Hinges", cf)
	for i, x in { -D.w / 2 + cm(3.5), D.w / 2 - cm(3.5) } do
		local c = cf * CFrame.new(x, 0, 0)
		if broken and i == 2 then
			c = c * CFrame.Angles(math.rad(18), 0, 0)
		end
		cyl(m, c, "X", cm(3), cm(0.7), Color3.fromRGB(60, 60, 66), M.Metal)
		box(m, c * CFrame.new(0, cm(0.25), cm(1.6)), Vector3.new(cm(2.4), cm(0.15), cm(3)), Color3.fromRGB(150, 150, 156), M.Metal, { Name = "Plate" })
		if broken and i == 2 then
			box(m, c * CFrame.new(0, cm(0.3), cm(1.2)), Vector3.new(cm(1.5), 0.004, 0.01), Color3.fromRGB(240, 240, 240), M.SmoothPlastic, { Name = "Crack" })
		end
	end
	return m
end

local function buildDcJack(cf: CFrame): Model
	local m = newModel("DCJack", cf)
	box(m, cf, Vector3.new(cm(1.4), cm(1), cm(1.8)), Color3.fromRGB(26, 26, 28), M.SmoothPlastic, { Name = "Body" })
	cyl(m, cf * CFrame.new(-cm(0.72), 0, 0), "X", 0.004, cm(0.55), Color3.fromRGB(176, 180, 186), M.Metal)
	box(m, cf, Vector3.new(0.14, 0.08, 0.16), Color3.new(0, 0, 0), M.SmoothPlastic, { Name = "Hitbox", Transparency = 1 })
	return m
end

local function buildWifi(cf: CFrame): Model
	local m = newModel("WiFi", cf)
	box(m, cf, Vector3.new(cm(2.2), cm(0.15), cm(3)), Color3.fromRGB(20, 60, 36), M.SmoothPlastic)
	local shield = box(m, cf * CFrame.new(0, -cm(0.12), -cm(0.2)), Vector3.new(cm(1.8), cm(0.1), cm(2)), Color3.fromRGB(180, 184, 190), M.Metal, { Name = "Shield" })
	PCParts.label(shield, Enum.NormalId.Bottom, "Wi-Fi 6", Color3.fromRGB(30, 30, 30), 600, nil)
	for _, x in { -cm(0.5), cm(0.5) } do
		cyl(m, cf * CFrame.new(x, -cm(0.15), cm(1)), "Y", cm(0.15), cm(0.45), Color3.fromRGB(196, 170, 90), M.Metal)
	end
	box(m, cf, Vector3.new(0.18, 0.06, 0.24), Color3.new(0, 0, 0), M.SmoothPlastic, { Name = "Hitbox", Transparency = 1 })
	return m
end

local function buildCoin(cf: CFrame): Model
	local m = newModel("CMOS", cf)
	cyl(m, cf, "Y", cm(0.35), cm(2.1), Color3.fromRGB(20, 20, 22), M.SmoothPlastic)
	cyl(m, cf * CFrame.new(0, -cm(0.18), 0), "Y", 0.003, cm(1.6), Color3.fromRGB(70, 140, 220), M.SmoothPlastic)
	box(m, cf, Vector3.new(0.16, 0.06, 0.16), Color3.new(0, 0, 0), M.SmoothPlastic, { Name = "Hitbox", Transparency = 1 })
	return m
end

----------------------------------------------------------------------------------------------------
-- describe
----------------------------------------------------------------------------------------------------
function LaptopLayout.describe(view, _opts)
	local D = LaptopLayout.dims(view)
	local d, t, lt = D.d, D.t, D.lidT
	local nodes = {}
	local order = {}
	local visible = view.visible or {}
	local flipped = view.orient == "bottom"
	local lidOpen = view.lid == "open"

	local function st(id: string): string?
		local s = view.nodes[id]
		return s and s.st
	end
	local function add(id: string, s)
		s.kind = s.kind or (T.nodes[id] and T.nodes[id].kind) or "comp"
		nodes[id] = s
		table.insert(order, id)
		return s
	end
	local function screws(owner: string, homes: { CFrame })
		local tn = T.nodes[owner]
		for i, sid in tn.screws do
			local home = homes[i] or homes[#homes]
			if not Rules.available(view, sid) or nodes[owner] == nil or nodes[owner].hide then
				add(sid, { hide = true, kind = "screw" })
			else
				local bit = screwBit(view, sid)
				add(sid, {
					kind = "screw",
					parent = owner,
					home = home,
					out = st(sid) ~= "in",
					sig = "screw:" .. bit,
					build = function(cf)
						return PCParts.screw(cf, bit)
					end,
				})
			end
		end
	end
	local function comp(id: string, parent: string, home: CFrame, builder: (CFrame, any) -> Model, extra: { [string]: any }?)
		local s = view.nodes[id]
		local part = partOf(view, id)
		if not s or s.st == "empty" or not part or not Rules.available(view, id) then
			return add(id, { hide = true })
		end
		local spec = {
			parent = parent,
			home = home,
			out = s.st == "out",
			offset = if s.st == "loose" then CFrame.new(0, -0.04, 0) else nil,
			sig = id .. ":" .. part.id,
			build = function(cf)
				return builder(cf, part)
			end,
		}
		if extra then
			for k, v in extra do
				spec[k] = v
			end
		end
		return add(id, spec)
	end

	-- the chassis rests on its feet, or upside down on the closed lid
	local feetH = cm(0.3)
	local baseHome = if flipped then CFrame.new(0, lt + t / 2, 0) * CFrame.Angles(0, 0, math.pi) else CFrame.new(0, feetH + t / 2, 0)
	add("base", {
		kind = "root",
		home = baseHome,
		sig = "base:" .. tostring(view.model),
		build = function(cf)
			return buildBase(cf, D)
		end,
	})
	add("lid", {
		kind = "lid",
		parent = "base",
		home = CFrame.new(0, t / 2, -d / 2 + cm(0.4)) * (if lidOpen then CFrame.Angles(math.rad(-108), 0, 0) else CFrame.new()),
		sig = "lid:" .. tostring(view.model),
		build = function(cf)
			return buildLid(cf, D)
		end,
	})
	add("lboard", {
		kind = "board",
		parent = "base",
		home = at(D, 0, -0.22, t * 0.12),
		sig = "board:" .. tostring(view.paste and view.paste.st) .. ":" .. tostring(math.floor((view.liquid or 0) * 10)),
		build = function(cf)
			return buildBoard(cf, D, view.paste, view.liquid or 0)
		end,
	})

	-- bottom cover with its feet and screws
	local coverSt = st("bottom_cover")
	add("bottom_cover", {
		kind = "panel",
		parent = "base",
		home = CFrame.new(0, -t / 2 - 0.006, 0),
		offset = if coverSt == "loose" then CFrame.new(0, -0.05, 0) * CFrame.Angles(math.rad(3), 0, 0) else nil,
		out = coverSt == "out",
		lean = true,
		sig = "cover:" .. tostring(view.model),
		build = function(cf)
			return buildBottomCover(cf, D)
		end,
	})
	if Rules.available(view, "feet") then
		local peeled = st("feet") == "peeled"
		add("feet", {
			kind = "feet",
			parent = "bottom_cover",
			home = CFrame.new(),
			sig = "feet:" .. tostring(peeled),
			build = function(cf)
				return buildFeet(cf, D, peeled)
			end,
		})
	else
		add("feet", { hide = true })
	end
	local coverScrews = {}
	for _, p in { { -0.44, -0.46 }, { -0.22, -0.46 }, { 0, -0.46 }, { 0.22, -0.46 }, { 0.44, -0.46 }, { -0.44, 0.46 }, { -0.15, 0.46 }, { 0.15, 0.46 }, { 0.44, 0.46 }, { 0, 0.05 } } do
		table.insert(coverScrews, at(D, p[1], p[2], -0.006) * DOWN)
	end
	table.insert(coverScrews, at(D, -0.3, -0.42, -0.006) * DOWN)
	table.insert(coverScrews, at(D, 0.3, -0.42, -0.006) * DOWN)
	screws("bottom_cover", coverScrews)

	-- internals (drawn facing down)
	local yIn = -t / 2 + cm(0.25)
	local swollen = visible.battery == "swollen"
	local budget = D.model.class == "budget15"
	comp("battery", "base", at(D, if budget then -0.2 else 0, 0.27, -t * 0.12), function(cf)
		return buildBattery(cf, D, swollen)
	end, { sig = "battery:" .. tostring(view.nodes.battery and view.nodes.battery.part) .. ":" .. tostring(swollen) })
	local bw = if budget then D.w * 0.48 else D.w * 0.8
	local bh = D.t * 0.55
	screws("battery", {
		CFrame.new(-bw / 2 + cm(1), -bh / 2, -D.d * 0.15) * DOWN,
		CFrame.new(bw / 2 - cm(1), -bh / 2, -D.d * 0.15) * DOWN,
		CFrame.new(-bw / 2 + cm(1), -bh / 2, D.d * 0.15) * DOWN,
		CFrame.new(bw / 2 - cm(1), -bh / 2, D.d * 0.15) * DOWN,
	})

	for i = 1, 2 do
		local id = "lram" .. i
		local slot = at(D, -0.13 + (i - 1) * 0.24, -0.1, yIn + cm(0.2))
		comp(id, "base", slot * CFrame.Angles(math.pi / 2, 0, 0) * CFrame.Angles(0, math.pi / 2, 0) * CFrame.Angles(0, 0, math.pi), function(cf, p)
			return PCParts.ram(cf, p)
		end)
		local clipId = id .. "_clip"
		if Rules.available(view, clipId) then
			local open = st(clipId) == "open"
			add(clipId, {
				kind = "latch",
				parent = "base",
				home = slot * CFrame.new(-cm(4), 0, cm(2.2)) * DOWN,
				offset = if open then CFrame.Angles(0, 0, math.rad(-40)) else nil,
				sig = "clip",
				build = function(cf)
					return PCParts.latch(cf, "ram")
				end,
			})
		else
			add(clipId, { hide = true })
		end
	end

	local nvmeHome = at(D, 0.37, -0.06, yIn) * CFrame.Angles(0, 0, math.pi)
	comp("lnvme", "base", nvmeHome, function(cf, p)
		return PCParts.storage(cf, p)
	end)
	local nd = PCParts.storageDims(partOf(view, "lnvme") or Parts.get("st_nv500sn580"))
	screws("lnvme", { CFrame.new(-nd.X / 2 + cm(0.15), cm(0.35), 0) })

	comp("lsata", "base", at(D, 0.26, 0.27, yIn) * CFrame.Angles(0, 0, math.pi), function(cf, p)
		return PCParts.storage(cf, p)
	end)
	local sd = PCParts.storageDims(partOf(view, "lsata") or Parts.get("st_hdd25_500"))
	screws("lsata", {
		CFrame.new(-sd.X / 2 + cm(1), sd.Y, -sd.Z / 2 + cm(0.8)),
		CFrame.new(-sd.X / 2 + cm(1), sd.Y, sd.Z / 2 - cm(0.8)),
	})

	comp("lwifi", "base", at(D, -0.38, -0.08, yIn), function(cf)
		return buildWifi(cf)
	end)
	screws("lwifi", { CFrame.new(0, -cm(0.1), -cm(1.4)) * DOWN })

	comp("lfan", "base", at(D, 0, -0.3, -t * 0.08), function(cf)
		return buildCooling(cf, D)
	end)
	local fanScrews = {}
	for k = 1, 5 do
		local fx = -0.36 + (k - 1) * 0.18
		table.insert(fanScrews, CFrame.new(fx * D.w, -t * 0.26, 0.12 * D.d) * DOWN)
	end
	screws("lfan", fanScrews)

	comp("lcmos", "base", at(D, -0.44, 0.02, yIn), function(cf)
		return buildCoin(cf)
	end)

	comp("dcjack", "base", at(D, -0.47, -0.4, 0), function(cf)
		return buildDcJack(cf)
	end, { offset = if st("dcjack") == "loose" then CFrame.new(0, -0.04, 0) else nil })
	screws("dcjack", { CFrame.new(cm(0.4), -cm(0.6), 0) * DOWN })

	-- keyboard on the deck; its screws are reached from below, under the battery
	comp("keyboard", "base", at(D, 0, -0.19, t / 2 + 0.006), function(cf)
		return buildKeyboard(cf, D)
	end, { offset = if st("keyboard") == "loose" then CFrame.new(0, 0.05, 0) else nil, outRot = CFrame.new() })
	local kbScrews = {}
	for _, p in { { -0.3, 0.42 }, { -0.1, 0.42 }, { 0.1, 0.42 }, { 0.3, 0.42 }, { -0.2, 0.7 }, { 0.2, 0.7 } } do
		table.insert(kbScrews, CFrame.new(p[1] * D.w, -t + cm(0.3), p[2] * D.d) * DOWN)
	end
	screws("keyboard", kbScrews)

	-- lid side: bezel over the panel, panel screws, hinges
	local bezelSt = st("bezel")
	add("bezel", {
		kind = "panel",
		parent = "lid",
		home = CFrame.new(),
		out = bezelSt == "out",
		sig = "bezel:" .. tostring(view.model),
		build = function(cf)
			return buildBezel(cf, D)
		end,
	})
	local cracked = visible.screen == "cracked" or visible.screen == "broken"
	comp("screen", "lid", CFrame.new(0, 0.002, 0), function(cf)
		return buildScreen(cf, D, cracked)
	end, { sig = "screen:" .. tostring(view.nodes.screen and view.nodes.screen.part) .. ":" .. tostring(cracked) })
	local sw2, sd2 = (D.w - cm(1.6)) / 2 - cm(0.6), D.d - cm(1.6)
	screws("screen", {
		CFrame.new(-sw2, 0.012, cm(1.9)) * DOWN,
		CFrame.new(sw2, 0.012, cm(1.9)) * DOWN,
		CFrame.new(-sw2, 0.012, sd2) * DOWN,
		CFrame.new(sw2, 0.012, sd2) * DOWN,
	})
	local brokenHinge = visible.hinges == "broken"
	comp("hinges", "lid", CFrame.new(0, 0, 0), function(cf)
		return buildHinges(cf, D, brokenHinge)
	end, { sig = "hinges:" .. tostring(view.nodes.hinges and view.nodes.hinges.part) .. ":" .. tostring(brokenHinge) })
	screws("hinges", {
		CFrame.new(-D.w / 2 + cm(3), 0.012, cm(1.2)) * DOWN,
		CFrame.new(-D.w / 2 + cm(4), 0.012, cm(1.2)) * DOWN,
		CFrame.new(D.w / 2 - cm(4), 0.012, cm(1.2)) * DOWN,
		CFrame.new(D.w / 2 - cm(3), 0.012, cm(1.2)) * DOWN,
	})

	for _, id in T.order do
		if not nodes[id] and T.nodes[id].kind ~= "cable" then
			add(id, { hide = true })
		end
	end
	return { base = CFrame.new(-0.4, 0, 0), order = order, nodes = nodes, cables = LaptopLayout.cables(view, D) }
end

----------------------------------------------------------------------------------------------------
-- Cables: short runs lying on the board; plugs face down (away from the deck)
----------------------------------------------------------------------------------------------------
function LaptopLayout.cables(view, D)
	local list = {}
	local t = D.t
	local yIn = -t / 2 + cm(0.25)
	local function cable(id: string, style: string, fromNode: string, fromRel: CFrame, toNode: string, toRel: CFrame)
		if not Rules.available(view, id) then
			return
		end
		local tn = T.nodes[id]
		local s = view.nodes[id]
		local plugged = s and s.st == "in"
		local a = view.nodes[tn.ends[1]]
		local b = view.nodes[tn.ends[2]]
		local endsIn = (tn.ends[1] == "base" or (a and a.st == "in")) and (tn.ends[2] == "base" or (b and b.st == "in"))
		if not plugged and not endsIn then
			return
		end
		table.insert(list, {
			id = id,
			style = style,
			route = function(h)
				local fw = h:worldOf(fromNode)
				local tw = h:worldOf(toNode)
				if not fw or not tw then
					return nil
				end
				local head = tw * toRel
				if not plugged then
					head = head * CFrame.new(0, 0.12, -0.05) * CFrame.Angles(math.rad(30), 0, 0)
				end
				local p0 = (fw * fromRel).Position
				local p1 = (head * CFrame.new(0, PCParts.CableStyle[style].head[2], 0)).Position
				return { p0, p0:Lerp(p1, 0.5), p1 }, head
			end,
		})
	end
	local function base(fx: number, fz: number, y: number?): CFrame
		return at(D, fx, fz, y or yIn) * DOWN
	end
	cable("bat_conn", "thin", "battery", CFrame.new(0, -t * 0.25, -D.d * 0.18), "base", base(0, 0.06))
	cable("lsata_conn", "ribbon", "lsata", CFrame.new(cm(5), cm(0.4), 0), "base", base(0.16, 0.13))
	cable("lwifi_ant", "thin", "lwifi", CFrame.new(0, -cm(0.2), cm(1)), "base", base(-0.38, -0.45))
	cable("lfan_conn", "thin", "lfan", CFrame.new(D.w * 0.22, -t * 0.25, D.d * 0.05), "base", base(0.2, -0.12))
	cable("lcmos_conn", "thin", "lcmos", CFrame.new(cm(1), 0, 0), "base", base(-0.36, 0.02))
	cable("dc_conn", "thin", "dcjack", CFrame.new(cm(0.7), 0, cm(0.6)), "base", base(-0.36, -0.36))
	cable("kb_ribbon", "ribbon", "keyboard", CFrame.new(0, -0.02, D.d * 0.2), "base", base(0, 0.16, -t / 2 + cm(0.6)))
	cable("edp_conn", "ribbon", "lid", CFrame.new(0, cm(0.3), cm(0.3)), "screen", CFrame.new(0, 0.006, cm(0.9)) * DOWN)
	return list
end

function LaptopLayout.decorate(handle, view)
	for id, rec in handle.recs do
		if rec.model then
			local s = view.nodes[id]
			local dust = s and s.dust or 0
			for _, d in rec.model:GetDescendants() do
				if d:IsA("BasePart") and d:GetAttribute("Dust") then
					d.Transparency = 1 - math.clamp((dust - 0.03) * 3.2, 0, 0.9)
				end
			end
		end
	end
end

return LaptopLayout
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1291">
          <Properties>
            <string name="Name">PCModel</string>
            <string name="Source"><![CDATA[-- PCModel: turns a device view (RepairRules.view) into a 3D model on the bench and keeps it in sync.
--
-- Every template node gets its own Model (attribute NodeId) placed either
--   * attached: relative to its visual parent (board parts ride on the motherboard, screws on
--     their owner), or
--   * laid out: relative to the device root (removed parts are packed onto the mat, removed
--     screws drop into the magnetic tray, removed side panels lean against the pegboard).
-- update(view) rebuilds what changed and moves the rest; with opts.animate the moves are queued as
-- smooth transitions that the client advances with step(dt). Layouts come from DesktopLayout and
-- LaptopLayout, which describe each node (parent, home pose, how to build it).
--
-- rootCf: the device frame on the bench (+Y up, the technician looks along -Z, +X is their right).

local PCParts = require(script.Parent.PCParts)
local DesktopLayout = require(script.Parent.DesktopLayout)
local LaptopLayout = require(script.Parent.LaptopLayout)
local Parts = require(script.Parent.Parent.Data.Parts)

local PCModel = {}

local Handle = {}
Handle.__index = Handle

-- default spots on the bench, relative to the device root
local TRAY = CFrame.new(-3.2, 0.14, 1.2)
local OUT_REGION = { x0 = 1.45, x1 = 4.3, z0 = -1.8, z1 = 2.1 } -- the lamp clamp sits behind z0
local LEAN = CFrame.new(-0.4, 0, -2.1)

local function hashOf(s: string): number
	local h = 7
	for i = 1, #s do
		h = (h * 31 + string.byte(s, i)) % 1000003
	end
	return h
end

-- local AABB of a model relative to `frame`
local function extents(model: Model, frame: CFrame): (Vector3, Vector3)
	local lo = Vector3.new(math.huge, math.huge, math.huge)
	local hi = Vector3.new(-math.huge, -math.huge, -math.huge)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and d.Name ~= "Root" and d.Transparency < 1 then
			local h = d.Size / 2
			local c = d.CFrame
			for _, sx in { -1, 1 } do
				for _, sy in { -1, 1 } do
					for _, sz in { -1, 1 } do
						local p = frame:PointToObjectSpace(c * Vector3.new(h.X * sx, h.Y * sy, h.Z * sz))
						lo = lo:Min(p)
						hi = hi:Max(p)
					end
				end
			end
		end
	end
	if lo.X == math.huge then
		return Vector3.zero, Vector3.zero
	end
	return lo, hi
end

local function rotatedBox(lo: Vector3, hi: Vector3, rot: CFrame): (Vector3, Vector3)
	local rlo = Vector3.new(math.huge, math.huge, math.huge)
	local rhi = Vector3.new(-math.huge, -math.huge, -math.huge)
	for _, x in { lo.X, hi.X } do
		for _, y in { lo.Y, hi.Y } do
			for _, z in { lo.Z, hi.Z } do
				local p = rot * Vector3.new(x, y, z)
				rlo = rlo:Min(p)
				rhi = rhi:Max(p)
			end
		end
	end
	return rlo, rhi
end

function PCModel.build(parent: Instance?, view, rootCf: CFrame, opts: { [string]: any }?): any
	local self = setmetatable({}, Handle)
	self.opts = opts or {}
	self.root = rootCf
	self.kind = view.kind
	self.layout = if view.kind == "laptop" then LaptopLayout else DesktopLayout
	self.tray = self.opts.tray or TRAY
	self.recs = {}
	self.cables = {}
	self.anims = {}
	local model = Instance.new("Model")
	model.Name = "Device"
	model:SetAttribute("DeviceKind", view.kind)
	self.model = model
	self.nodesFolder = Instance.new("Folder")
	self.nodesFolder.Name = "Nodes"
	self.nodesFolder.Parent = model
	self.cableFolder = Instance.new("Folder")
	self.cableFolder.Name = "Cables"
	self.cableFolder.Parent = model
	self:update(view)
	model.Parent = parent
	return self
end

-- World frame of a node's visual parent.
function Handle:parentWorld(rec): CFrame
	if rec.parent then
		local p = self.recs[rec.parent]
		if p and p.world then
			return p.world
		end
	end
	return self.root * self.base
end

function Handle:worldOf(id: string): CFrame?
	local rec = self.recs[id]
	return rec and rec.world
end

-- Walks up from a hit part to the node it belongs to.
function Handle:nodeOf(part: Instance?): string?
	local p = part
	while p and p ~= self.model do
		local id = p:GetAttribute("NodeId")
		if id then
			return id
		end
		p = p.Parent
	end
	return nil
end

function Handle:destroy()
	self.model:Destroy()
	self.recs = {}
	self.anims = {}
end

-- Places a node (and, recursively, everything attached to it) from its current pose.
function Handle:poseNode(id: string)
	local rec = self.recs[id]
	if not rec then
		return
	end
	if rec.attached then
		rec.world = self:parentWorld(rec) * rec.cur
	else
		rec.world = self.root * rec.cur
	end
	if rec.model then
		rec.model:PivotTo(rec.world)
	end
	for _, child in rec.children do
		self:poseNode(child)
	end
end

function Handle:poseAll()
	for _, id in self.order do
		local rec = self.recs[id]
		if rec and (not rec.parent or not self.recs[rec.parent]) then
			self:poseNode(id)
		end
	end
end

----------------------------------------------------------------------------------------------------
-- update
----------------------------------------------------------------------------------------------------
function Handle:update(view)
	self.view = view
	local spec = self.layout.describe(view, self.opts)
	self.base = spec.base or CFrame.new()
	self.order = spec.order
	local animate = self.opts.animate and self.built
	local seen = {}

	-- 1. (re)build node models and work out where each one wants to be
	local targets = {}
	for _, id in spec.order do
		local s = spec.nodes[id]
		seen[id] = true
		local rec = self.recs[id]
		if not rec then
			rec = { id = id, children = {}, attached = true, cur = CFrame.new() }
			self.recs[id] = rec
		end
		rec.parent = s.parent
		rec.kind = s.kind
		rec.spec = s
		if s.hide then
			if rec.model then
				rec.model:Destroy()
				rec.model = nil
			end
			rec.sig = nil
			rec.hidden = true
		else
			local fresh = false
			if rec.sig ~= s.sig or not rec.model then
				if rec.model then
					rec.model:Destroy()
				end
				local m = s.build(CFrame.new())
				m.Name = "N_" .. id
				m:SetAttribute("NodeId", id)
				m.Parent = self.nodesFolder
				rec.model = m
				rec.sig = s.sig
				rec.lo, rec.hi = extents(m, CFrame.new())
				fresh = true
			end
			rec.fresh = fresh or rec.hidden
			rec.hidden = false
			if s.out then
				targets[id] = { attached = false }
			else
				targets[id] = { attached = true, cf = s.home * (s.offset or CFrame.new()) }
			end
		end
	end
	for id, rec in self.recs do
		if not seen[id] then
			if rec.model then
				rec.model:Destroy()
			end
			self.recs[id] = nil
		end
	end
	-- children lists
	for _, rec in self.recs do
		rec.children = {}
	end
	for _, id in spec.order do
		local rec = self.recs[id]
		if rec and rec.parent and self.recs[rec.parent] then
			table.insert(self.recs[rec.parent].children, id)
		end
	end

	-- 2. lay out everything that is off the device
	self:packOut(spec, targets)

	-- 3. move: immediately, or as queued transitions
	for _, id in spec.order do
		local rec = self.recs[id]
		local t = targets[id]
		if rec and t and not rec.hidden then
			local changed = rec.attached ~= t.attached or not rec.cur:FuzzyEq(t.cf, 1e-4)
			if changed then
				if animate and not rec.fresh and self.opts.animate then
					self:queue(rec, t)
				else
					self.anims[id] = nil
					rec.attached = t.attached
					rec.cur = t.cf
				end
			end
		end
	end
	self:poseAll()
	self.built = true

	-- 4. the cables and per-state looks
	self:rebuildCables(spec)
	if self.layout.decorate then
		self.layout.decorate(self, view)
	end
end

-- Packs removed parts onto the mat, screws into the tray, covers against the pegboard.
function Handle:packOut(spec, targets)
	local items = {}
	local screwIndex = 0
	for _, id in spec.order do
		local s = spec.nodes[id]
		local rec = self.recs[id]
		local t = targets[id]
		if t and not t.attached and rec and rec.model then
			if s.kind == "screw" then
				screwIndex += 1
				local h = hashOf(id)
				local a = (h % 360) * math.pi / 180
				local r = 0.04 + (h % 9) * 0.035
				t.cf = self.tray * CFrame.new(math.cos(a) * r, 0.01 + (screwIndex % 4) * 0.018, math.sin(a) * r) * CFrame.Angles(0, a, math.rad((h % 3) * 30 + 70))
			elseif s.lean then
				-- stand it up against the pegboard, leaning back slightly
				t.cf = LEAN * CFrame.Angles(math.rad(-96), 0, 0) * CFrame.new(0, 0, -rec.lo.Z)
			else
				local rot = s.outRot or CFrame.new()
				local lo, hi = rotatedBox(rec.lo, rec.hi, rot)
				local size = hi - lo
				-- prefer the long side along Z (the region is deep, not wide)
				if size.X > size.Z and size.X > OUT_REGION.x1 - OUT_REGION.x0 - 0.1 then
					rot = CFrame.Angles(0, math.pi / 2, 0) * rot
					lo, hi = rotatedBox(rec.lo, rec.hi, rot)
					size = hi - lo
				end
				table.insert(items, { id = id, t = t, rot = rot, lo = lo, hi = hi, size = size, area = size.X * size.Z, order = #items })
			end
		end
	end
	table.sort(items, function(a, b)
		if math.abs(a.area - b.area) > 1e-3 then
			return a.area > b.area
		end
		return a.order < b.order
	end)
	-- column packing; overflow stacks a second layer on top
	local R = OUT_REGION
	local x, z, colW, layerY, layerH = R.x0, R.z0, 0, 0.01, 0
	for _, it in items do
		local w, d = it.size.X, it.size.Z
		if z + d > R.z1 and z > R.z0 then
			x += colW + 0.12
			z = R.z0
			colW = 0
		end
		if x + w > R.x1 + 0.3 and x > R.x0 then
			x, z, colW = R.x0, R.z0, 0
			layerY += layerH + 0.02
			layerH = 0
		end
		local cx = x + w / 2 - (it.lo.X + it.hi.X) / 2
		local cz = z + d / 2 - (it.lo.Z + it.hi.Z) / 2
		it.t.cf = CFrame.new(cx, layerY - it.lo.Y, cz) * it.rot
		z += d + 0.1
		colW = math.max(colW, w)
		layerH = math.max(layerH, it.size.Y)
	end
end

----------------------------------------------------------------------------------------------------
-- Cables: rebuilt from the current poses after every update
----------------------------------------------------------------------------------------------------
function Handle:rebuildCables(spec)
	for _, m in self.cables do
		m:Destroy()
	end
	self.cables = {}
	if not spec.cables then
		return
	end
	for _, c in spec.cables do
		local ok, points, headCf = pcall(c.route, self)
		if ok and points then
			local m = PCParts.cable(points, c.style, headCf)
			m.Name = "N_" .. c.id
			m:SetAttribute("NodeId", c.id)
			m.Parent = self.cableFolder
			self.cables[c.id] = m
		end
	end
end

----------------------------------------------------------------------------------------------------
-- Animation (client only)
----------------------------------------------------------------------------------------------------
local DUR = { screw = 0.9, latch = 0.25, panel = 0.75, comp = 0.8, root = 0.9, lid = 0.7, feet = 0.3 }

-- frame of a node relative to the root right now
function Handle:rootRelative(rec): CFrame
	return self.root:ToObjectSpace(rec.world or self.root)
end

function Handle:queue(rec, t)
	local from = self:rootRelative(rec)
	local kind = rec.kind
	local anim = {
		rec = rec,
		t = 0,
		dur = DUR[kind] or 0.6,
		from = from,
		target = t,
	}
	if (kind == "latch" or kind == "root" or kind == "lid" or kind == "feet" or kind == "pins") and t.attached and rec.attached then
		-- rotations about the parent: interpolate in the parent frame
		anim.local0 = rec.cur
		anim.lift = if kind == "root" then 0.9 else 0
	else
		anim.lift = if kind == "screw" then 0.35 elseif kind == "panel" then 0.5 else 0.6
	end
	-- for the duration the node floats relative to the root
	self.anims[rec.id] = anim
end

-- Advances every running transition; returns true while anything is moving.
function Handle:step(dt: number): boolean
	local any = false
	for id, a in self.anims do
		local rec = a.rec
		a.t = math.min(1, a.t + dt / a.dur)
		local e = a.t * a.t * (3 - 2 * a.t) -- smoothstep
		if a.local0 then
			local target = a.target.cf
			rec.attached = true
			rec.cur = a.local0:Lerp(target, e)
			if a.lift > 0 then
				rec.cur = CFrame.new(0, a.lift * 4 * e * (1 - e), 0) * rec.cur
			end
		else
			local toRel
			if a.target.attached then
				local pw = self:parentWorld(rec)
				toRel = self.root:ToObjectSpace(pw * a.target.cf)
			else
				toRel = a.target.cf
			end
			local p = a.from:Lerp(toRel, e)
			local lift = a.lift * 4 * e * (1 - e)
			local spin = CFrame.new()
			if rec.kind == "screw" then
				spin = CFrame.Angles(0, (if a.target.attached then -1 else 1) * e * math.pi * 6, 0)
			end
			rec.attached = false
			rec.cur = CFrame.new(0, lift, 0) * p * spin
		end
		if a.t >= 1 then
			rec.attached = a.target.attached
			rec.cur = a.target.cf
			self.anims[id] = nil
		else
			any = true
		end
		self:poseNode(id)
	end
	return any
end

function Handle:busy(): boolean
	return next(self.anims) ~= nil
end

-- Root frame for showing a device on a display stand (the stand's top surface frame): towers
-- stand upright with their window facing +Z of the stand.
function PCModel.displayCFrame(standCf: CFrame, view): CFrame
	if view.kind ~= "desktop" then
		return standCf * CFrame.new(0, 0.05, 0)
	end
	local dims = PCParts.caseDims(Parts.get(view.model))
	-- lying, the case spans y 0..dims.Y (window up) and z ±dims.Z/2 (tower top at -Z)
	return standCf * CFrame.new(0.5, dims.Z / 2 + 0.05, -dims.Y / 2) * CFrame.Angles(math.pi / 2, 0, 0)
end

PCModel.Handle = Handle
PCModel.hash = hashOf
return PCModel
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1292">
          <Properties>
            <string name="Name">PCParts</string>
            <string name="Source"><![CDATA[-- PCParts: builders for every desktop component the repair bench shows. Each builder draws the part
-- in its own local frame (`cf`) at real proportions (S studs per centimetre; screws, clips and pins
-- are exaggerated so they stay readable and clickable) and returns a Model whose PrimaryPart sits
-- at `cf`. Nothing collides; everything can be ray-picked.

local B = require(script.Parent.Parent.Util.Builder)

local PCParts = {}
local M = Enum.Material

local S = 0.075 -- studs per centimetre
PCParts.S = S

local function cm(v: number): number
	return v * S
end
PCParts.cm = cm

local GOLD = Color3.fromRGB(214, 176, 72)
local STEEL = Color3.fromRGB(176, 180, 186)
local DARK = Color3.fromRGB(26, 26, 30)
local SLOT = Color3.fromRGB(34, 34, 38)

-- PCB, heatsink and accent colours per motherboard theme
local THEMES = {
	black = { pcb = { 24, 24, 28 }, sink = { 52, 54, 60 }, accent = { 120, 124, 132 } },
	aorus = { pcb = { 22, 22, 26 }, sink = { 44, 44, 50 }, accent = { 255, 122, 0 } },
	rog = { pcb = { 20, 20, 24 }, sink = { 40, 42, 48 }, accent = { 230, 20, 40 } },
	tuf = { pcb = { 36, 34, 30 }, sink = { 92, 92, 96 }, accent = { 236, 184, 30 } },
	gray = { pcb = { 42, 44, 48 }, sink = { 150, 154, 162 }, accent = { 200, 204, 210 } },
	blue = { pcb = { 22, 52, 112 }, sink = { 70, 96, 140 }, accent = { 150, 190, 240 } },
	green = { pcb = { 26, 88, 46 }, sink = { 170, 174, 180 }, accent = { 210, 214, 220 } },
	red = { pcb = { 24, 24, 28 }, sink = { 170, 30, 34 }, accent = { 230, 60, 60 } },
	white = { pcb = { 232, 232, 236 }, sink = { 244, 244, 246 }, accent = { 200, 204, 210 } },
}
PCParts.Themes = THEMES

local function col(c: any): Color3
	return B.color(c)
end

----------------------------------------------------------------------------------------------------
-- Model helpers
----------------------------------------------------------------------------------------------------
local function newModel(name: string, cf: CFrame): Model
	local m = Instance.new("Model")
	m.Name = name
	local r = Instance.new("Part")
	r.Name = "Root"
	r.Anchored = true
	r.CanCollide = false
	r.CanTouch = false
	r.CanQuery = false
	r.Transparency = 1
	r.Size = Vector3.new(0.05, 0.05, 0.05)
	r.CFrame = cf
	r.Parent = m
	m.PrimaryPart = r
	return m
end
PCParts.newModel = newModel

local function props(extra: { [string]: any }?, size: Vector3?)
	local t: { [string]: any } = { CanCollide = false, CanTouch = false }
	if size and math.max(size.X, size.Y, size.Z) < 0.12 then
		t.CastShadow = false
	end
	if extra then
		for k, v in extra do
			t[k] = v
		end
	end
	return t
end

local function box(m: Instance, cf: CFrame, size: Vector3, color: any, mat: Enum.Material?, extra: { [string]: any }?): BasePart
	return B.box(m, cf, size, color, mat or M.SmoothPlastic, props(extra, size))
end
PCParts.box = box

-- cylinder along the local axis of cf ("X", "Y" or "Z")
local function cyl(m: Instance, cf: CFrame, axis: string, length: number, diameter: number, color: any, mat: Enum.Material?, extra: { [string]: any }?): BasePart
	local size = Vector3.new(length, diameter, diameter)
	if axis == "Y" then
		return B.cylY(m, cf, length, diameter, color, mat or M.SmoothPlastic, props(extra, size))
	elseif axis == "Z" then
		return B.cylZ(m, cf, length, diameter, color, mat or M.SmoothPlastic, props(extra, size))
	end
	return B.cyl(m, cf, length, diameter, color, mat or M.SmoothPlastic, props(extra, size))
end
PCParts.cyl = cyl

-- small text sticker on a face of `part`
local function label(part: BasePart, face: Enum.NormalId, text: string, color: any, ppS: number?, font: Font?)
	B.sign(part, face, text, { color = col(color), pixelsPerStud = ppS or 300, font = font or B.Fonts.Bold })
end
PCParts.label = label

-- Fan rotor (blades + hub) spinning around the local Y axis of cf; tagged for the bench animator.
local function rotor(m: Instance, cf: CFrame, diameter: number, bladeCol: any, hubCol: any, blades: number?): Model
	local r = newModel("Rotor", cf)
	r:SetAttribute("SpinAxis", "Y")
	local n = blades or 7
	for i = 1, n do
		local a = (i / n) * math.pi * 2
		local bcf = cf * CFrame.Angles(0, a, 0) * CFrame.new(diameter * 0.27, 0, 0) * CFrame.Angles(math.rad(28), 0, 0)
		box(r, bcf, Vector3.new(diameter * 0.36, math.max(0.006, diameter * 0.02), diameter * 0.2), bladeCol, M.SmoothPlastic)
	end
	cyl(r, cf, "Y", diameter * 0.12, diameter * 0.32, hubCol, M.SmoothPlastic)
	r.Parent = m
	return r
end
PCParts.rotor = rotor

-- Grey-brown fuzz over a surface; PCModel sets its transparency from the dust level.
local function dustLayer(m: Instance, cf: CFrame, size: Vector3): BasePart
	local d = box(m, cf, size, Color3.fromRGB(150, 140, 122), M.Fabric, { Name = "Dust", Transparency = 1, CastShadow = false })
	d:SetAttribute("Dust", true)
	return d
end
PCParts.dustLayer = dustLayer

----------------------------------------------------------------------------------------------------
-- Screws (head up along +Y; the shaft points down)
----------------------------------------------------------------------------------------------------
function PCParts.screw(cf: CFrame, bit: string): Model
	local m = newModel("Screw", cf)
	local head, height, color
	if bit == "thumb" then
		head, height, color = 0.13, 0.06, Color3.fromRGB(30, 30, 32)
	elseif bit == "toolless" then
		head, height, color = 0.09, 0.04, Color3.fromRGB(60, 60, 64)
	elseif bit == "PH2" then
		head, height, color = 0.075, 0.025, Color3.fromRGB(170, 174, 180)
	else
		head, height, color = 0.05, 0.018, Color3.fromRGB(30, 30, 32)
	end
	cyl(m, cf * CFrame.new(0, height / 2, 0), "Y", height, head, color, M.Metal)
	if bit == "thumb" then
		-- knurled thumb screw with a phillips slot on top
		cyl(m, cf * CFrame.new(0, height + 0.004, 0), "Y", 0.008, head * 0.7, Color3.fromRGB(70, 70, 74), M.Metal)
	end
	if bit ~= "toolless" then
		local slot = Color3.fromRGB(16, 16, 18)
		local w = head * 0.12
		local top = height + 0.002 + (if bit == "thumb" then 0.008 else 0)
		if bit == "T5" then
			for k = 0, 2 do
				box(m, cf * CFrame.new(0, top, 0) * CFrame.Angles(0, k * math.pi / 3, 0), Vector3.new(head * 0.55, 0.004, w), slot)
			end
		else
			box(m, cf * CFrame.new(0, top, 0), Vector3.new(head * 0.6, 0.004, w), slot)
			box(m, cf * CFrame.new(0, top, 0), Vector3.new(w, 0.004, head * 0.6), slot)
		end
	end
	-- threaded shaft (hidden inside the hole while fitted)
	cyl(m, cf * CFrame.new(0, -0.03, 0), "Y", 0.06, head * 0.45, Color3.fromRGB(150, 150, 156), M.Metal, { Name = "Shaft" })
	-- generous invisible pick target
	box(m, cf * CFrame.new(0, height / 2, 0), Vector3.new(0.2, 0.12, 0.2), DARK, M.SmoothPlastic, { Name = "Hitbox", Transparency = 1, CastShadow = false })
	return m
end

----------------------------------------------------------------------------------------------------
-- Case (lying on its side: open side up +Y, front at -X, rear at +X, top at -Z, bottom at +Z)
----------------------------------------------------------------------------------------------------
local CASE_DIMS = {
	retro = { 42, 19, 42 },
	office = { 38, 17.5, 38 },
	sff = { 42, 11, 34 },
	airflow = { 45, 22, 46 },
	glass = { 44, 21, 45 },
	showcase = { 46, 28, 47 },
	wood = { 45, 23, 47 },
	fulltower = { 54, 24, 57 },
	itx = { 37, 18.5, 29 },
}

function PCParts.caseDims(casePart): Vector3
	local d = CASE_DIMS[casePart and casePart.style or "airflow"] or CASE_DIMS.airflow
	return Vector3.new(cm(d[1]), cm(d[2]), cm(d[3]))
end

local CASE_COLORS = {
	black = { 30, 30, 34 },
	white = { 236, 236, 238 },
	beige = { 214, 204, 176 },
}

function PCParts.caseColor(casePart): Color3
	return col(CASE_COLORS[casePart and casePart.color or "black"] or CASE_COLORS.black)
end

-- The chassis (root of the desktop). Origin: centre of the footprint on the bench.
function PCParts.chassis(cf: CFrame, casePart): (Model, Vector3)
	local m = newModel("Chassis", cf)
	local dims = PCParts.caseDims(casePart)
	local lx, ly, lz = dims.X, dims.Y, dims.Z
	local body = PCParts.caseColor(casePart)
	local inner = body:Lerp(Color3.new(0, 0, 0), 0.25)
	local t = 0.035
	local style = casePart and casePart.style or "airflow"
	-- motherboard tray (now the floor)
	box(m, cf * CFrame.new(0, t / 2, 0), Vector3.new(lx, t, lz), inner, M.Metal, { Name = "Tray" })
	-- cable grommets beside the board
	for k = 0, 2 do
		box(m, cf * CFrame.new(-lx / 2 + cm(12.5), t + 0.002, -lz / 2 + cm(9) + k * cm(9)), Vector3.new(cm(1.4), 0.004, cm(5)), DARK, M.Rubber)
	end
	-- front panel (thick, with mesh or glass) at -X
	local frontMat = if style == "airflow" or style == "itx" then M.DiamondPlate else M.SmoothPlastic
	local front = box(m, cf * CFrame.new(-lx / 2 + cm(1.2), ly / 2, 0), Vector3.new(cm(2.4), ly, lz), body, frontMat, { Name = "FrontPanel" })
	if style == "wood" then
		for k = -3, 3 do
			box(m, cf * CFrame.new(-lx / 2 - 0.004, ly / 2, k * lz / 8), Vector3.new(0.01, ly * 0.9, lz / 9.5), Color3.fromRGB(120, 78, 44), M.Wood)
		end
	elseif style == "retro" then
		-- 5.25" bays and a floppy slot
		for k = 0, 2 do
			box(m, cf * CFrame.new(-lx / 2 - 0.004, ly / 2, -lz / 2 + cm(5) + k * cm(4.6)), Vector3.new(0.01, cm(14.8), cm(4.2)), Color3.fromRGB(200, 190, 162), M.SmoothPlastic)
		end
		box(m, cf * CFrame.new(-lx / 2 - 0.006, ly / 2, -lz / 2 + cm(19)), Vector3.new(0.01, cm(10), cm(0.6)), DARK)
	end
	front:SetAttribute("Detail", "front")
	-- power button and LED on the front top edge
	cyl(m, cf * CFrame.new(-lx / 2 + cm(1.2), ly - 0.01, -lz / 2 + cm(3)), "Y", 0.02, cm(1.6), Color3.fromRGB(70, 70, 74), M.Metal, { Name = "PowerButton" })
	box(m, cf * CFrame.new(-lx / 2 + cm(1.2), ly - 0.01, -lz / 2 + cm(5)), Vector3.new(0.03, 0.02, 0.03), Color3.fromRGB(60, 200, 255), M.Neon, { Name = "PowerLed", Transparency = 0.7 })
	-- rear panel with I/O cut-out, expansion slot covers and PSU opening
	box(m, cf * CFrame.new(lx / 2 - t / 2, ly / 2, 0), Vector3.new(t, ly, lz), inner, M.Metal, { Name = "RearPanel" })
	for k = 0, 6 do
		box(m, cf * CFrame.new(lx / 2 + 0.003, ly * 0.5, cm(1.5) + k * cm(2.03) - lz / 2 + cm(19.5)), Vector3.new(0.006, ly * 0.55, cm(1.7)), Color3.fromRGB(70, 72, 76), M.Metal)
	end
	-- top (-Z) and bottom (+Z) walls
	local topWall = box(m, cf * CFrame.new(0, ly / 2, -lz / 2 + t / 2), Vector3.new(lx, ly, t), body, if style == "airflow" or style == "showcase" then M.DiamondPlate else M.Metal, { Name = "TopPanel" })
	topWall:SetAttribute("Detail", "top")
	box(m, cf * CFrame.new(0, ly / 2, lz / 2 - t / 2), Vector3.new(lx, ly, t), body, M.Metal, { Name = "BottomPanel" })
	-- PSU intake vent under the power supply
	box(m, cf * CFrame.new(lx / 2 - cm(8), ly * 0.4, lz / 2 + 0.002), Vector3.new(cm(12), cm(11), 0.004), Color3.fromRGB(14, 14, 16), M.DiamondPlate)
	-- feet on the old bottom
	for _, x in { -lx / 2 + cm(5), lx / 2 - cm(5) } do
		box(m, cf * CFrame.new(x, ly / 2, lz / 2 + cm(0.8)), Vector3.new(cm(4), ly * 0.7, cm(1.6)), Color3.fromRGB(40, 40, 44), M.Rubber)
	end
	-- PSU shroud (front half) and the drive cage under it
	if style ~= "sff" and style ~= "office" and style ~= "retro" and style ~= "itx" then
		local sz = lz / 2 - cm(10.5)
		box(m, cf * CFrame.new(-lx / 4, ly / 2, sz), Vector3.new(lx / 2, ly, t), inner, M.Metal, { Name = "Shroud" })
		box(m, cf * CFrame.new(-lx / 4, ly - 0.01, sz + cm(0.5)), Vector3.new(lx / 2 - cm(2), 0.012, cm(1)), body:Lerp(Color3.new(1, 1, 1), 0.2), M.Metal)
	end
	-- RGB strip on showcase/glass cases
	if casePart and casePart.rgb then
		local strip = box(m, cf * CFrame.new(-lx / 2 + cm(2.6), ly * 0.5, 0), Vector3.new(0.02, ly * 0.8, lz * 0.9), Color3.fromRGB(140, 60, 255), M.Neon, { Name = "CaseRGB", Transparency = 0.4 })
		strip:SetAttribute("RGB", true)
	end
	-- brand badge on the front
	local badge = box(m, cf * CFrame.new(-lx / 2 - 0.004, ly * 0.5, lz / 2 - cm(4)), Vector3.new(0.008, cm(1.5), cm(5)), Color3.fromRGB(200, 200, 204), M.Metal)
	badge.Name = "Badge"
	return m, dims
end

-- Side panel lying on top of the case: origin at its centre, glass or steel.
function PCParts.sidePanel(cf: CFrame, casePart, dims: Vector3): Model
	local m = newModel("SidePanel", cf)
	local body = PCParts.caseColor(casePart)
	local w, d = dims.X, dims.Z
	if casePart and casePart.glass then
		box(m, cf, Vector3.new(w - 0.02, 0.025, d - 0.02), Color3.fromRGB(70, 82, 96), M.Glass, { Name = "Glass", Transparency = 0.62, CastShadow = false })
		-- tinted border print
		local border = Color3.fromRGB(16, 16, 18)
		box(m, cf * CFrame.new(0, 0.014, -d / 2 + 0.06), Vector3.new(w, 0.004, 0.12), border)
		box(m, cf * CFrame.new(0, 0.014, d / 2 - 0.06), Vector3.new(w, 0.004, 0.12), border)
		box(m, cf * CFrame.new(-w / 2 + 0.06, 0.014, 0), Vector3.new(0.12, 0.004, d), border)
		box(m, cf * CFrame.new(w / 2 - 0.06, 0.014, 0), Vector3.new(0.12, 0.004, d), border)
	else
		box(m, cf, Vector3.new(w, 0.02, d), body, M.Metal, { Name = "Steel" })
		-- vent perforation patch
		box(m, cf * CFrame.new(-w * 0.15, 0.011, -d * 0.12), Vector3.new(w * 0.35, 0.003, d * 0.3), body:Lerp(Color3.new(0, 0, 0), 0.4), M.DiamondPlate)
	end
	-- grab handle at the rear edge
	box(m, cf * CFrame.new(w / 2 - 0.05, 0.02, 0), Vector3.new(0.05, 0.02, d * 0.3), body:Lerp(Color3.new(0, 0, 0), 0.3), M.Metal)
	return m
end

----------------------------------------------------------------------------------------------------
-- Motherboard. Local frame: origin at the top-rear corner on the PCB surface; +u (cm) runs to the
-- front (-X), +w (cm) down the board (+Z). layout() returns where every slot and header sits.
----------------------------------------------------------------------------------------------------
local BOARD_SIZE = { ATX = { 24.4, 30.5 }, mATX = { 24.4, 24.4 }, ITX = { 17, 17 }, EATX = { 27.7, 30.5 } }

local function socketSize(socket: string): (number, number)
	if socket == "LGA1700" or socket == "LGA1851" then
		return 4.5, 3.75
	elseif socket == "LGA2011-3" then
		return 5.25, 4.5
	elseif socket == "sTR5" then
		return 7.5, 7.2
	elseif string.sub(socket, 1, 2) == "AM" then
		return 4, 4
	end
	return 3.75, 3.75
end
PCParts.socketSize = socketSize

function PCParts.boardLayout(moboPart)
	local form = moboPart and moboPart.form or "ATX"
	local size = BOARD_SIZE[form] or BOARD_SIZE.ATX
	local W, H = size[1], size[2]
	local itx = form == "ITX"
	local L = { form = form, W = W, H = H }
	local function at(u: number, w: number, y: number?): CFrame
		return CFrame.new(-cm(u), y or 0, cm(w))
	end
	L.at = at
	local su = if itx then 8 else 10
	L.socket = at(su, 8)
	L.socketSize = { socketSize(moboPart and moboPart.socket or "AM4") }
	L.ram = {}
	local slots = moboPart and moboPart.memSlots or 4
	for i = 1, slots do
		local u = (if itx then 13.6 else 16.4) + (i - 1) * 0.85
		L.ram[i] = at(u, 8.1)
	end
	L.ramLen = 13.3
	L.pcie = at(7.95, 15.3) -- slot centre, slot runs along u from 3.5 to 12.4
	L.pcieLatch = at(13, 15.3)
	L.nvme = { at(8.5, 13), at(8.5, 19.5) }
	if itx then
		L.nvme = { at(8.5, 12.3) }
	end
	L.cmos = at(14.5, 17.6)
	L.caps = {
		at(4.2, 3.0), at(4.2, 4.5), at(4.2, 6.0),
		at(su - 2, 11.2), at(su, 11.2), at(su + 2, 11.2),
	}
	L.atx24 = at(W - 1.3, 8.6)
	L.eps = at(12.6, 0.8)
	L.cpuFan = at(14.6, 0.8)
	L.sysFan = { at(W - 1, 2), at(W - 1, 16), at(W - 6, H - 1), at(W - 9, H - 1), at(3, H - 1), at(W - 12, H - 1) }
	L.sata = { at(W - 1.1, math.min(H - 3, 22)), at(W - 1.1, math.min(H - 5, 24.2)) }
	L.chipset = at(17.5, math.min(H - 5, 20.3))
	return L
end

local function themeOf(moboPart)
	return THEMES[moboPart and moboPart.theme or "black"] or THEMES.black
end

function PCParts.mobo(cf: CFrame, moboPart): (Model, any)
	local m = newModel("Motherboard", cf)
	local L = PCParts.boardLayout(moboPart)
	local th = themeOf(moboPart)
	local pcb, sink, accent = col(th.pcb), col(th.sink), col(th.accent)
	local W, H = L.W, L.H
	local at = L.at
	local pcbPart = box(m, cf * CFrame.new(-cm(W) / 2, -0.008, cm(H) / 2), Vector3.new(cm(W), 0.016, cm(H)), pcb, M.SmoothPlastic, { Name = "PCB" })
	pcbPart:SetAttribute("Detail", "pcb")
	-- traces / silkscreen hints
	local silk = pcb:Lerp(Color3.new(1, 1, 1), 0.12)
	for k = 1, 5 do
		box(m, cf * at(W * 0.55, H * (0.15 + k * 0.14), 0.0005), Vector3.new(cm(W * 0.35), 0.001, 0.006), silk)
	end
	-- mounting holes (silver rings)
	for _, h in { { 0.8, 0.8 }, { W - 0.8, 0.8 }, { 0.8, H - 0.8 }, { W - 0.8, H - 0.8 }, { W * 0.5, 0.8 }, { W * 0.5, H - 0.8 } } do
		cyl(m, cf * at(h[1], h[2], 0.002), "Y", 0.004, cm(0.9), STEEL, M.Metal)
	end
	-- rear I/O shroud
	local ioH = math.min(15, H - 2)
	local io = box(m, cf * at(1.6, 0.6 + ioH / 2, cm(1.8)), Vector3.new(cm(3.2), cm(3.6), cm(ioH)), sink, M.Metal, { Name = "IOShroud" })
	io:SetAttribute("Detail", "io")
	box(m, cf * at(1.6, 0.6 + ioH / 2, cm(3.62)), Vector3.new(cm(2.6), 0.004, cm(ioH - 1)), accent, if moboPart and (moboPart.theme == "rog" or moboPart.theme == "aorus") then M.Neon else M.Metal, { Name = "IOAccent" })
	-- VRM heatsinks: one above the socket, one between the socket and the I/O
	local su = if L.form == "ITX" then 8 else 10
	box(m, cf * at(su + 1, 2.6, cm(1.6)), Vector3.new(cm(10), cm(3.2), cm(2.4)), sink, M.Metal, { Name = "VRMTop" })
	box(m, cf * at(4.7, 8, cm(1.6)), Vector3.new(cm(2.2), cm(3.2), cm(8.5)), sink, M.Metal, { Name = "VRMRear" })
	for k = -2, 2 do
		box(m, cf * at(su + 1 + k * 1.8, 2.6, cm(3.22)), Vector3.new(cm(0.4), 0.004, cm(2.2)), sink:Lerp(Color3.new(0, 0, 0), 0.35), M.Metal)
	end
	-- socket frame (the pins and the arm are their own nodes)
	local sw, sh = L.socketSize[1], L.socketSize[2]
	local socketCf = cf * L.socket
	box(m, socketCf * CFrame.new(0, cm(0.25), 0), Vector3.new(cm(sh + 1.4), cm(0.5), cm(sw + 1.4)), Color3.fromRGB(60, 60, 64), M.Metal, { Name = "SocketFrame" })
	box(m, socketCf * CFrame.new(0, cm(0.52), 0), Vector3.new(cm(sh + 0.2), 0.004, cm(sw + 0.2)), Color3.fromRGB(28, 28, 30), M.SmoothPlastic, { Name = "SocketBed" })
	-- cooler backplate standoffs
	for _, o in { { -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 } } do
		cyl(m, socketCf * CFrame.new(o[1] * cm(3.7), cm(0.3), o[2] * cm(3.7)), "Y", cm(0.6), cm(0.7), STEEL, M.Metal)
	end
	-- memory slots
	for i, slotCf in L.ram do
		local s = cf * slotCf
		local slotCol = if i % 2 == 1 then SLOT else Color3.fromRGB(80, 82, 88)
		box(m, s * CFrame.new(0, cm(0.35), 0), Vector3.new(cm(0.75), cm(0.7), cm(L.ramLen + 1.6)), slotCol, M.SmoothPlastic, { Name = "RamSlot" .. i })
		box(m, s * CFrame.new(0, cm(0.71), 0), Vector3.new(cm(0.25), 0.003, cm(L.ramLen)), Color3.fromRGB(10, 10, 12))
	end
	-- PCIe slots (x16 with steel armour, plus extra slots on bigger boards)
	local pcieCf = cf * L.pcie
	box(m, pcieCf * CFrame.new(0, cm(0.4), 0), Vector3.new(cm(8.9), cm(0.8), cm(0.85)), STEEL, M.Metal, { Name = "PCIeSlot" })
	box(m, pcieCf * CFrame.new(0, cm(0.81), 0), Vector3.new(cm(8.6), 0.003, cm(0.25)), Color3.fromRGB(10, 10, 12))
	local extra = if L.form == "ATX" or L.form == "EATX" then { 18, 23.5, 27 } elseif L.form == "mATX" then { 18, 21.5 } else {}
	for _, w in extra do
		local long = w == 23.5
		box(m, cf * at(if long then 7.95 else 5, w, cm(0.35)), Vector3.new(cm(if long then 8.9 else 2.5), cm(0.7), cm(0.8)), SLOT)
	end
	-- M.2 slots: connector + standoff, optional heatsink cover is part of the drive
	for i, nv in L.nvme do
		if i <= (moboPart and moboPart.m2 or 1) then
			local c = cf * nv
			box(m, c * CFrame.new(cm(3.8), cm(0.25), 0), Vector3.new(cm(0.6), cm(0.5), cm(2.4)), SLOT, M.SmoothPlastic, { Name = "M2Slot" .. i })
			cyl(m, c * CFrame.new(-cm(4.1), cm(0.15), 0), "Y", cm(0.3), cm(0.5), GOLD, M.Metal)
		end
	end
	-- chipset heatsink with the brand
	local chip = box(m, cf * L.chipset * CFrame.new(0, cm(0.6), 0), Vector3.new(cm(5.5), cm(1.2), cm(4.8)), sink, M.Metal, { Name = "Chipset" })
	label(chip, Enum.NormalId.Top, string.upper(moboPart and moboPart.brand or "ASUS") .. "\n" .. (moboPart and moboPart.chipset or ""), th.accent, 260)
	-- power connectors
	box(m, cf * L.atx24 * CFrame.new(0, cm(0.55), 0), Vector3.new(cm(1.25), cm(1.1), cm(5.3)), Color3.fromRGB(236, 236, 230), M.SmoothPlastic, { Name = "ATX24" })
	box(m, cf * L.eps * CFrame.new(0, cm(0.5), 0), Vector3.new(cm(2.2), cm(1), cm(1.1)), Color3.fromRGB(236, 236, 230), M.SmoothPlastic, { Name = "EPS" })
	-- headers
	for _, hcf in { L.cpuFan, table.unpack(L.sysFan) } do
		box(m, cf * hcf * CFrame.new(0, cm(0.3), 0), Vector3.new(cm(1), cm(0.6), cm(0.4)), Color3.fromRGB(236, 236, 230))
	end
	for _, s in L.sata do
		box(m, cf * s * CFrame.new(0, cm(0.5), 0), Vector3.new(cm(0.9), cm(1), cm(1.6)), Color3.fromRGB(40, 40, 44))
	end
	-- CMOS battery holder
	cyl(m, cf * L.cmos * CFrame.new(0, cm(0.15), 0), "Y", cm(0.3), cm(2.3), Color3.fromRGB(40, 40, 44), M.SmoothPlastic)
	-- a row of solid caps around the socket area (decoration; the six service caps are nodes)
	for k = 0, 4 do
		cyl(m, cf * at(4.2 + k * 0.9, 13.2, cm(0.55)), "Y", cm(1.1), cm(0.75), Color3.fromRGB(40, 40, 44), M.Metal)
	end
	-- board name silkscreen
	local nameplate = box(m, cf * at(W * 0.6, H - 2.4, 0.001), Vector3.new(cm(8), 0.002, cm(1.4)), pcb)
	label(nameplate, Enum.NormalId.Top, moboPart and moboPart.name or "", Color3.fromRGB(220, 220, 220), 220, B.Fonts.Medium)
	return m, L
end

-- Socket pin field; bent pins show as dark specks.
function PCParts.pins(cf: CFrame, socket: string, bent: boolean): Model
	local m = newModel("Pins", cf)
	local sw, sh = socketSize(socket)
	box(m, cf * CFrame.new(0, cm(0.55), 0), Vector3.new(cm(sh - 0.2), 0.004, cm(sw - 0.2)), Color3.fromRGB(178, 150, 82), M.Metal, { Name = "PinField" })
	if bent then
		for k = 0, 3 do
			box(m, cf * CFrame.new(cm(-0.8 + k * 0.45), cm(0.57), cm(0.3 - k * 0.2)), Vector3.new(0.025, 0.005, 0.025), Color3.fromRGB(40, 30, 20), M.SmoothPlastic, { Name = "BentPin" })
		end
	end
	box(m, cf * CFrame.new(0, cm(0.55), 0), Vector3.new(cm(sh), 0.03, cm(sw)), DARK, M.SmoothPlastic, { Name = "Hitbox", Transparency = 1 })
	return m
end

-- Latches: "ram" (DIMM clip at a slot end), "pcie" (x16 latch), "arm" (CPU retention lever).
-- Origin at the hinge; PCModel rotates them open around local X (ram/pcie) or Z (arm).
function PCParts.latch(cf: CFrame, kind: string): Model
	local m = newModel("Latch", cf)
	if kind == "arm" then
		box(m, cf * CFrame.new(0, cm(0.3), -cm(2.6)), Vector3.new(cm(0.35), cm(0.35), cm(5.2)), STEEL, M.Metal, { Name = "Lever" })
		box(m, cf * CFrame.new(cm(0.5), cm(0.3), -cm(5.1)), Vector3.new(cm(1.2), cm(0.35), cm(0.35)), STEEL, M.Metal)
		box(m, cf * CFrame.new(0, cm(0.3), -cm(2.6)), Vector3.new(0.12, 0.1, cm(5.2)), DARK, M.SmoothPlastic, { Name = "Hitbox", Transparency = 1 })
	elseif kind == "pcie" then
		box(m, cf * CFrame.new(0, cm(0.6), 0), Vector3.new(cm(1.2), cm(1.1), cm(0.9)), Color3.fromRGB(70, 72, 78), M.SmoothPlastic)
		box(m, cf * CFrame.new(0, cm(0.6), 0), Vector3.new(0.14, 0.12, 0.14), DARK, M.SmoothPlastic, { Name = "Hitbox", Transparency = 1 })
	else
		box(m, cf * CFrame.new(0, cm(0.75), 0), Vector3.new(cm(0.75), cm(1.5), cm(0.8)), Color3.fromRGB(64, 66, 72), M.SmoothPlastic)
		box(m, cf * CFrame.new(0, cm(0.75), 0), Vector3.new(0.12, 0.14, 0.12), DARK, M.SmoothPlastic, { Name = "Hitbox", Transparency = 1 })
	end
	return m
end

----------------------------------------------------------------------------------------------------
-- CPU (origin: bottom centre, lying flat, pins/pads down)
----------------------------------------------------------------------------------------------------
function PCParts.cpu(cf: CFrame, cpuPart): Model
	local m = newModel("CPU", cf)
	local socket = cpuPart and cpuPart.socket or "AM4"
	local sw, sh = socketSize(socket)
	local amd = cpuPart and cpuPart.brand == "amd"
	local substrate = if amd then Color3.fromRGB(32, 110, 60) else Color3.fromRGB(28, 96, 58)
	box(m, cf * CFrame.new(0, cm(0.06), 0), Vector3.new(cm(sh), cm(0.12), cm(sw)), substrate, M.SmoothPlastic, { Name = "Substrate" })
	if string.sub(socket, 1, 3) == "AM3" or socket == "AM4" then
		-- PGA: golden pin field underneath
		box(m, cf * CFrame.new(0, -0.004, 0), Vector3.new(cm(sh - 0.4), 0.008, cm(sw - 0.4)), GOLD, M.Metal)
	end
	-- heat spreader with the laser-etched name
	local ihsW, ihsH = sh * 0.78, sw * 0.78
	local ihs = box(m, cf * CFrame.new(0, cm(0.12) + cm(0.15), 0), Vector3.new(cm(ihsW), cm(0.3), cm(ihsH)), Color3.fromRGB(190, 192, 198), M.Metal, { Name = "IHS" })
	local brand = if amd then "AMD RYZEN" else "INTEL® CORE™"
	if cpuPart and string.find(cpuPart.name or "", "Core 2") then
		brand = "INTEL® CORE™2"
	elseif cpuPart and string.find(cpuPart.name or "", "Xeon") then
		brand = "INTEL® XEON®"
	elseif cpuPart and string.find(cpuPart.name or "", "Threadripper") then
		brand = "AMD THREADRIPPER"
	end
	local model = cpuPart and string.gsub(cpuPart.name or "", "^%S+%s+", "") or ""
	label(ihs, Enum.NormalId.Top, brand .. "\n" .. model, Color3.fromRGB(70, 70, 76), 900, B.Fonts.Medium)
	-- orientation triangle
	box(m, cf * CFrame.new(-cm(sh / 2 - 0.3), cm(0.125), cm(sw / 2 - 0.3)), Vector3.new(0.02, 0.003, 0.02), GOLD, M.Metal)
	return m
end

-- Thermal paste blob on top of the IHS; PCModel tunes its look from paste.st/q.
function PCParts.paste(cf: CFrame): Model
	local m = newModel("Paste", cf)
	cyl(m, cf * CFrame.new(0, 0.004, 0), "Y", 0.008, cm(2.6), Color3.fromRGB(160, 162, 168), M.SmoothPlastic, { Name = "Blob", CastShadow = false })
	return m
end

----------------------------------------------------------------------------------------------------
-- Coolers (origin: centre of the CPU contact plate, standing up +Y). ctx = { topZ = distance in
-- studs from the CPU to the case's top panel (for AIO radiators), up = case inner height }
----------------------------------------------------------------------------------------------------
local function fanFrame(m: Instance, cf: CFrame, size: number, frameCol: Color3, bladeCol: Color3, rgb: boolean?)
	-- square frame around a circular opening, axis along local Y
	local t = cm(2.5)
	local s = size
	local bar = s * 0.09
	for _, o in { { 0, -1 }, { 0, 1 } } do
		box(m, cf * CFrame.new(0, 0, o[2] * (s / 2 - bar / 2)), Vector3.new(s, t, bar), frameCol, M.SmoothPlastic)
	end
	for _, o in { -1, 1 } do
		box(m, cf * CFrame.new(o * (s / 2 - bar / 2), 0, 0), Vector3.new(bar, t, s - bar * 2), frameCol, M.SmoothPlastic)
	end
	-- corner fillers make the opening read as round
	for _, o in { { -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 } } do
		box(m, cf * CFrame.new(o[1] * s * 0.36, 0, o[2] * s * 0.36) * CFrame.Angles(0, math.rad(45), 0), Vector3.new(s * 0.22, t * 0.96, s * 0.12), frameCol, M.SmoothPlastic)
	end
	-- motor struts on the back side
	for k = 0, 3 do
		box(m, cf * CFrame.new(0, -t * 0.4, 0) * CFrame.Angles(0, k * math.pi / 2 + math.rad(20), 0) * CFrame.new(s * 0.25, 0, 0), Vector3.new(s * 0.5, t * 0.12, s * 0.03), frameCol, M.SmoothPlastic)
	end
	rotor(m, cf * CFrame.new(0, t * 0.05, 0), s * 0.92, bladeCol, frameCol)
	if rgb then
		local ring = cyl(m, cf * CFrame.new(0, t * 0.48, 0), "Y", 0.006, s * 0.95, Color3.fromRGB(150, 70, 255), M.Neon, { Name = "FanRGB", Transparency = 0.55 })
		ring:SetAttribute("RGB", true)
	end
	box(m, cf, Vector3.new(s, t, s), DARK, M.SmoothPlastic, { Name = "Hitbox", Transparency = 1 })
end
PCParts.fanFrame = fanFrame

function PCParts.cooler(cf: CFrame, coolerPart, ctx): Model
	local m = newModel("Cooler", cf)
	local kind = coolerPart and coolerPart.kind or "stock"
	local alu = Color3.fromRGB(196, 198, 204)
	local copper = Color3.fromRGB(196, 116, 70)
	local black = Color3.fromRGB(28, 28, 32)
	local rgb = coolerPart and coolerPart.rgb
	if kind == "stock" then
		local amd = coolerPart and coolerPart.sockets == "amd"
		if amd then
			-- AMD Wraith: square black shroud with a round fan
			box(m, cf * CFrame.new(0, cm(2.2), 0), Vector3.new(cm(9.5), cm(4.4), cm(9.5)), black, M.SmoothPlastic, { Name = "Shroud" })
			rotor(m, cf * CFrame.new(0, cm(4.45), 0), cm(8.6), black:Lerp(Color3.new(1, 1, 1), 0.1), black)
			if rgb then
				local ring = cyl(m, cf * CFrame.new(0, cm(4.5), 0), "Y", 0.008, cm(9.2), Color3.fromRGB(255, 60, 160), M.Neon, { Name = "CoolerRGB", Transparency = 0.5 })
				ring:SetAttribute("RGB", true)
			end
			dustLayer(m, cf * CFrame.new(0, cm(4.6), 0), Vector3.new(cm(9.6), 0.01, cm(9.6)))
		else
			-- Intel stock: round aluminium sink, copper core, black fan on top
			cyl(m, cf * CFrame.new(0, cm(1.4), 0), "Y", cm(2.8), cm(9.4), alu, M.Metal, { Name = "Sink" })
			cyl(m, cf * CFrame.new(0, cm(1.4), 0), "Y", cm(2.82), cm(3), copper, M.Metal)
			cyl(m, cf * CFrame.new(0, cm(3.4), 0), "Y", cm(1.2), cm(9), black, M.SmoothPlastic)
			rotor(m, cf * CFrame.new(0, cm(4.05), 0), cm(8), black:Lerp(Color3.new(1, 1, 1), 0.12), black)
			dustLayer(m, cf * CFrame.new(0, cm(4.2), 0), Vector3.new(cm(9.2), 0.01, cm(9.2)))
		end
	elseif kind == "air" then
		local towers = coolerPart and coolerPart.towers or 1
		local h = cm(15.6)
		-- base plate and heat pipes
		box(m, cf * CFrame.new(0, cm(0.6), 0), Vector3.new(cm(4), cm(1.2), cm(4)), copper, M.Metal, { Name = "Base" })
		local finCol = if coolerPart and coolerPart.noctua then alu elseif coolerPart and (coolerPart.id == "cool_drp5" or coolerPart.id == "cool_nhd15" or coolerPart.id == "cool_hyper212") then black else alu
		local tw = cm(5)
		local xs = if towers == 2 then { -cm(4.6), cm(4.6) } else { 0 }
		for _, x in xs do
			for k = -1, 1 do
				cyl(m, cf * CFrame.new(x * 0.5 + k * cm(0.9), h * 0.45, 0), "Y", h * 0.9, cm(0.6), copper, M.Metal)
			end
			local stack = box(m, cf * CFrame.new(x, h * 0.62, 0), Vector3.new(tw, h * 0.72, cm(12.4)), finCol, M.Metal, { Name = "FinStack" })
			stack:SetAttribute("Detail", "fins")
			-- fin lines on the top
			for k = -5, 5 do
				box(m, cf * CFrame.new(x, h * 0.98 + 0.002, k * cm(1.1)), Vector3.new(tw, 0.004, 0.006), finCol:Lerp(Color3.new(0, 0, 0), 0.35), M.Metal)
			end
			-- top cap
			box(m, cf * CFrame.new(x, h * 0.99, 0), Vector3.new(tw * 1.02, cm(0.5), cm(12.6)), if coolerPart and coolerPart.id == "cool_ak620d" then Color3.fromRGB(20, 20, 22) else finCol:Lerp(Color3.new(0, 0, 0), 0.2), M.Metal)
			dustLayer(m, cf * CFrame.new(x, h * 0.62, 0), Vector3.new(tw * 1.04, h * 0.74, cm(12.6)))
		end
		-- fan(s) on the intake (front, -X) side of each tower
		local fanCol = if coolerPart and coolerPart.noctua then Color3.fromRGB(110, 76, 50) else black
		local bladeCol = if coolerPart and coolerPart.noctua then Color3.fromRGB(210, 190, 160) else black:Lerp(Color3.new(1, 1, 1), 0.08)
		local fx = if towers == 2 then 0 else -tw / 2 - cm(1.4)
		local fanSize = if towers == 2 then cm(14) else cm(12)
		local fanModel = newModel("CoolerFan", cf * CFrame.new(fx, h * 0.6, 0) * CFrame.Angles(0, 0, math.pi / 2))
		fanFrame(fanModel, cf * CFrame.new(fx, h * 0.6, 0) * CFrame.Angles(0, 0, math.pi / 2), fanSize, fanCol, bladeCol, rgb)
		fanModel.Parent = m
		if coolerPart and coolerPart.id == "cool_ak620d" then
			local disp = box(m, cf * CFrame.new(0, h * 1.01, 0), Vector3.new(cm(8), 0.006, cm(4)), Color3.fromRGB(10, 10, 12), M.SmoothPlastic, { Name = "TempDisplay" })
			label(disp, Enum.NormalId.Top, "45°C", Color3.fromRGB(80, 200, 255), 300, B.Fonts.Mono)
		end
	else
		-- AIO: pump block on the CPU, tubes up to the radiator on the top panel
		local block = cyl(m, cf * CFrame.new(0, cm(1.9), 0), "Y", cm(3.8), cm(6.6), black, M.SmoothPlastic, { Name = "Pump" })
		local cap = cyl(m, cf * CFrame.new(0, cm(3.85), 0), "Y", 0.008, cm(5.4), if rgb then Color3.fromRGB(120, 60, 255) else Color3.fromRGB(60, 60, 66), if rgb then M.Neon else M.Metal, { Name = "PumpCap" })
		if rgb then
			cap:SetAttribute("RGB", true)
		end
		if coolerPart and coolerPart.lcd then
			label(cap, Enum.NormalId.Top, "38°C", Color3.fromRGB(255, 255, 255), 400, B.Fonts.Heavy)
		end
		block:SetAttribute("Detail", "pump")
		local rad = coolerPart and coolerPart.radiator or 240
		local fans = if rad >= 360 then 3 else 2
		local radLen = cm(fans * 12 + 3.6)
		-- radiator (long axis X, fans on +Z) where the layout mounts it; beside the pump otherwise
		local radCf = cf * ((ctx and ctx.radCf) or CFrame.new(-cm(14), cm(8), 0) * CFrame.Angles(0, math.pi / 2, 0))
		box(m, radCf, Vector3.new(radLen, cm(12), cm(2.7)), black, M.Metal, { Name = "Radiator" })
		for k = -10, 10 do
			box(m, radCf * CFrame.new(k * radLen / 22, 0, cm(1.36)), Vector3.new(0.006, cm(11), 0.004), Color3.fromRGB(60, 60, 66), M.Metal)
		end
		for i = 1, fans do
			local x = -radLen / 2 + cm(1.8) + cm(6) + (i - 1) * cm(12)
			local fcf = radCf * CFrame.new(x, 0, cm(2.7)) * CFrame.Angles(math.pi / 2, 0, 0)
			local fm = newModel("RadFan", fcf)
			fanFrame(fm, fcf, cm(12), black, black:Lerp(Color3.new(1, 1, 1), 0.08), rgb)
			fm.Parent = m
		end
		dustLayer(m, radCf * CFrame.new(0, 0, cm(1.5)), Vector3.new(radLen, cm(12), 0.01))
		-- two tubes from the pump to the radiator end
		local p0 = (cf * CFrame.new(cm(1.2), cm(2.5), -cm(2.5))).Position
		local p1 = (radCf * CFrame.new(radLen / 2 - cm(2), cm(3), cm(1))).Position
		for k = 0, 1 do
			local off = Vector3.new(0, 0, k * cm(1.4))
			local a, b = p0 + off, p1 + off
			local mid = (a + b) / 2 + Vector3.new(0, cm(3), 0)
			for _, seg in { { a, mid }, { mid, b } } do
				local d = (seg[2] - seg[1]).Magnitude
				local sc = CFrame.lookAt((seg[1] + seg[2]) / 2, seg[2]) * CFrame.Angles(0, math.pi / 2, 0)
				cyl(m, sc, "X", d, cm(1.2), Color3.fromRGB(22, 22, 24), M.Rubber)
			end
		end
	end
	return m
end

----------------------------------------------------------------------------------------------------
-- Memory (origin: centre of the contact edge; length along Z, height +Y, thickness X)
----------------------------------------------------------------------------------------------------
local RAM_COLORS = {
	green = { 30, 100, 56 },
	black = { 26, 26, 30 },
	silver = { 190, 192, 198 },
	white = { 238, 238, 240 },
	blue = { 30, 70, 160 },
	red = { 170, 30, 34 },
}

function PCParts.ram(cf: CFrame, ramPart): Model
	local m = newModel("RAM", cf)
	local so = ramPart and ramPart.form == "SODIMM"
	local len = if so then cm(6.95) else cm(13.3)
	local h = if so then cm(3) else cm(3.1)
	local colour = ramPart and ramPart.color or "green"
	local bare = colour == "green"
	local pcb = Color3.fromRGB(30, 100, 56)
	box(m, cf * CFrame.new(0, h / 2, 0), Vector3.new(cm(0.12), h, len), pcb, M.SmoothPlastic, { Name = "PCB" })
	box(m, cf * CFrame.new(0, cm(0.25), 0), Vector3.new(cm(0.14), cm(0.5), len * 0.94), GOLD, M.Metal, { Name = "Contacts" })
	-- notch
	box(m, cf * CFrame.new(0, cm(0.2), len * 0.1), Vector3.new(cm(0.2), cm(0.45), cm(0.3)), Color3.fromRGB(12, 12, 14))
	if bare then
		-- memory chips on both sides
		for side = -1, 1, 2 do
			for k = 0, (if so then 3 else 7) do
				local z = -len / 2 + len * (k + 0.75) / (if so then 4.6 else 8.6)
				box(m, cf * CFrame.new(side * cm(0.12), h * 0.55, z), Vector3.new(cm(0.12), cm(1.1), cm(1.1)), Color3.fromRGB(20, 20, 22))
			end
		end
	else
		local spread = col(RAM_COLORS[colour] or RAM_COLORS.black)
		local hs = box(m, cf * CFrame.new(0, h * 0.58, 0), Vector3.new(cm(0.62), h * 0.84, len * 0.99), spread, M.Metal, { Name = "Spreader" })
		label(hs, Enum.NormalId.Right, string.upper(ramPart and ramPart.name or "") , if colour == "white" or colour == "silver" then Color3.fromRGB(30, 30, 30) else Color3.fromRGB(230, 230, 230), 260, B.Fonts.Bold)
		if ramPart and ramPart.rgb then
			local bar = box(m, cf * CFrame.new(0, h + cm(0.35), 0), Vector3.new(cm(0.5), cm(0.7), len * 0.96), Color3.fromRGB(120, 200, 255), M.Neon, { Name = "RamRGB", Transparency = 0.35 })
			bar:SetAttribute("RGB", true)
		end
	end
	-- capacity sticker
	local sticker = box(m, cf * CFrame.new(-cm(0.4), h * 0.5, len * 0.2), Vector3.new(0.004, cm(1.2), cm(3)), Color3.fromRGB(240, 240, 236), M.SmoothPlastic)
	label(sticker, Enum.NormalId.Left, (ramPart and ramPart.size or 8) .. "GB " .. (ramPart and ramPart.mem or ""), Color3.fromRGB(30, 30, 30), 600, B.Fonts.Bold)
	box(m, cf * CFrame.new(0, h / 2, 0), Vector3.new(0.12, h, len), DARK, M.SmoothPlastic, { Name = "Hitbox", Transparency = 1 })
	return m
end

----------------------------------------------------------------------------------------------------
-- Graphics card. Origin: bracket end of the PCIe fingers, card runs to -X, stands up +Y,
-- cooler and fans on the +Z side, backplate on -Z. info.connectors = power socket frames.
----------------------------------------------------------------------------------------------------
function PCParts.gpuDims(gpuPart): (number, number, number)
	local p = gpuPart or {}
	local len = cm(p.len or 24)
	local h = cm(if p.lowProfile then 6.9 elseif (p.slots or 2) >= 3 then 14 elseif (p.slots or 2) >= 2.5 then 13.2 else 12)
	local t = cm((p.slots or 2) * 2 - 0.4)
	return len, h, t
end

-- Power socket frames on the card's top edge (relative to the card origin, at the socket mouth).
function PCParts.gpuSockets(gpuPart, connectors: { string }): { CFrame }
	local L, H, T = PCParts.gpuDims(gpuPart)
	local frames = {}
	local n = #connectors
	for i = 1, n do
		local x = -L * 0.72 + (i - (n + 1) / 2) * cm(2.2)
		table.insert(frames, CFrame.new(x, H * 0.97 + cm(0.6), cm(0.3) + T * 0.35))
	end
	return frames
end

function PCParts.gpu(cf: CFrame, gpuPart, connectors: { string }): (Model, { CFrame })
	local m = newModel("GPU", cf)
	local p = gpuPart or {}
	local L, H, T = PCParts.gpuDims(p)
	local shroud, accent
	if p.workstation then
		shroud, accent = Color3.fromRGB(24, 24, 26), Color3.fromRGB(196, 160, 60)
	elseif p.brand == "amd" then
		shroud, accent = Color3.fromRGB(32, 32, 36), Color3.fromRGB(204, 30, 42)
	elseif p.brand == "intel" then
		shroud, accent = Color3.fromRGB(44, 46, 52), Color3.fromRGB(0, 113, 197)
	elseif (p.year or 2016) >= 2020 and (p.perf or 0) >= 55 then
		shroud, accent = Color3.fromRGB(150, 152, 158), Color3.fromRGB(30, 30, 32) -- founders style
	else
		shroud, accent = Color3.fromRGB(38, 38, 42), Color3.fromRGB(118, 185, 0)
	end
	local pcb = Color3.fromRGB(20, 30, 24)
	-- PCB and edge fingers
	box(m, cf * CFrame.new(-L / 2, H * 0.47, 0), Vector3.new(L - cm(0.4), H * 0.92, cm(0.16)), pcb, M.SmoothPlastic, { Name = "PCB" })
	box(m, cf * CFrame.new(-cm(5.95), -cm(0.35), 0), Vector3.new(cm(8.9), cm(0.8), cm(0.12)), GOLD, M.Metal, { Name = "Fingers" })
	-- I/O bracket with display outputs
	local bracketW = cm((p.slots or 2) * 2)
	box(m, cf * CFrame.new(cm(0.35), H * 0.5, bracketW / 2 - cm(0.6)), Vector3.new(cm(0.1), H + cm(0.6), bracketW), STEEL, M.Metal, { Name = "Bracket" })
	box(m, cf * CFrame.new(cm(0.8), H + cm(0.3), bracketW / 2 - cm(0.6)), Vector3.new(cm(1), cm(0.1), bracketW), STEEL, M.Metal, { Name = "BracketTab" })
	for k = 0, 2 do
		box(m, cf * CFrame.new(cm(0.42), cm(1.8) + k * cm(2.2), cm(0.6)), Vector3.new(0.006, cm(1.1), cm(1.6)), Color3.fromRGB(20, 20, 22))
	end
	-- backplate
	box(m, cf * CFrame.new(-L / 2, H * 0.5, -cm(0.35)), Vector3.new(L - cm(0.8), H * 0.9, cm(0.25)), if p.workstation or (p.perf or 0) < 15 then pcb else Color3.fromRGB(30, 30, 34), M.Metal, { Name = "Backplate" })
	-- cooler shroud
	local body = box(m, cf * CFrame.new(-L / 2 - cm(0.2), H * 0.52, cm(0.3) + T / 2), Vector3.new(L - cm(0.6), H * 0.9, T - cm(0.3)), shroud, if p.passive then M.Metal else M.SmoothPlastic, { Name = "Shroud" })
	body:SetAttribute("Detail", "gpu")
	-- fin edges and heat pipes visible on the top edge
	local finCol = Color3.fromRGB(70, 72, 78)
	for k = 0, math.floor(L / cm(1.2)) - 2 do
		box(m, cf * CFrame.new(-cm(1.6) - k * cm(1.2), H * 0.97 + 0.002, cm(0.3) + T / 2), Vector3.new(0.005, 0.004, T * 0.8), finCol, M.Metal)
	end
	for k = 0, (if (p.tdp or 100) > 200 then 3 else 1) do
		cyl(m, cf * CFrame.new(-L * 0.5, H * 0.96, cm(0.8) + k * cm(0.7)), "X", L * 0.7, cm(0.6), Color3.fromRGB(196, 116, 70), M.Metal)
	end
	-- accent and logo on the top edge
	local strip = box(m, cf * CFrame.new(-L * 0.42, H * 0.97 + 0.003, cm(0.3) + T / 2), Vector3.new(L * 0.4, 0.004, T * 0.6), shroud:Lerp(Color3.new(0, 0, 0), 0.4), M.SmoothPlastic, { Name = "LogoStrip" })
	local brand = if p.workstation then "NVIDIA RTX" elseif p.brand == "amd" then "RADEON" elseif p.brand == "intel" then "INTEL ARC" else (if string.find(p.name or "", "RTX") then "GEFORCE RTX" else "GEFORCE GTX")
	label(strip, Enum.NormalId.Top, brand, accent, 300, B.Fonts.Heavy)
	if (p.perf or 0) >= 40 and not p.workstation then
		local glow = box(m, cf * CFrame.new(-L * 0.42, H * 0.97 + 0.001, cm(0.3) + T * 0.95), Vector3.new(L * 0.45, 0.004, 0.012), accent, M.Neon, { Name = "GpuRGB", Transparency = 0.4 })
		glow:SetAttribute("RGB", true)
	end
	-- fans on the +Z face
	local n = p.fans or 2
	if p.blower then
		local d = H * 0.62
		local c = cf * CFrame.new(-L + d / 2 + cm(1), H * 0.5, cm(0.3) + T + 0.003) * CFrame.Angles(math.pi / 2, 0, 0)
		cyl(m, c, "Y", 0.006, d * 1.04, Color3.fromRGB(10, 10, 12))
		rotor(m, c * CFrame.new(0, 0.004, 0), d, Color3.fromRGB(30, 30, 34), Color3.fromRGB(30, 30, 34), 13)
	elseif n > 0 then
		local span = L - cm(2.4)
		local d = math.min(H * 0.86, span / n * 0.94)
		for i = 1, n do
			local x = -cm(1.6) - span * (i - 0.5) / n
			local c = cf * CFrame.new(x, H * 0.52, cm(0.3) + T + 0.003) * CFrame.Angles(math.pi / 2, 0, 0)
			cyl(m, c, "Y", 0.006, d * 1.03, Color3.fromRGB(10, 10, 12))
			rotor(m, c * CFrame.new(0, 0.004, 0), d, Color3.fromRGB(24, 24, 28), accent, if (p.perf or 0) >= 40 then 11 else 9)
		end
	end
	dustLayer(m, cf * CFrame.new(-L / 2 - cm(0.2), H * 0.52, cm(0.3) + T + 0.01), Vector3.new(L - cm(0.6), H * 0.9, 0.01))
	-- power sockets on the top edge, 70 % along the card
	local frames = PCParts.gpuSockets(p, connectors)
	for i, kind in connectors do
		local wide = if kind == "12v" then cm(1.9) elseif kind == "6" then cm(1.4) else cm(1.8)
		box(m, cf * frames[i] * CFrame.new(0, -cm(0.3), 0), Vector3.new(wide, cm(0.6), cm(0.85)), Color3.fromRGB(16, 16, 18), M.SmoothPlastic, { Name = "PowerSocket" })
	end
	box(m, cf * CFrame.new(-L / 2, H / 2, T / 2), Vector3.new(L, H, T + cm(0.6)), DARK, M.SmoothPlastic, { Name = "Hitbox", Transparency = 1 })
	return m, frames
end

----------------------------------------------------------------------------------------------------
-- Power supply. Origin: centre. Depth along X, width along Y, height along Z; fan on +Z,
-- label on +Y, modular sockets on -X (towards the case front).
----------------------------------------------------------------------------------------------------
function PCParts.psuDims(psuPart): Vector3
	if psuPart and psuPart.form == "SFX" then
		return Vector3.new(cm(10), cm(12.5), cm(6.35))
	end
	return Vector3.new(cm(14), cm(15), cm(8.6))
end

function PCParts.psu(cf: CFrame, psuPart): Model
	local m = newModel("PSU", cf)
	local d = PCParts.psuDims(psuPart)
	local q = psuPart and psuPart.quality or 0.5
	local shell = if q >= 0.8 then Color3.fromRGB(26, 26, 30) elseif q >= 0.5 then Color3.fromRGB(40, 40, 44) else Color3.fromRGB(150, 152, 156)
	local body = box(m, cf, d, shell, M.Metal, { Name = "Shell" })
	body:SetAttribute("Detail", "psu")
	-- fan grille on +Z
	local fc = cf * CFrame.new(0, 0, d.Z / 2 + 0.002) * CFrame.Angles(math.pi / 2, 0, 0)
	cyl(m, fc, "Y", 0.004, math.min(d.X, d.Y) * 0.86, Color3.fromRGB(14, 14, 16))
	rotor(m, fc * CFrame.new(0, -0.006, 0), math.min(d.X, d.Y) * 0.8, Color3.fromRGB(30, 30, 34), Color3.fromRGB(40, 40, 44))
	for k = -3, 3 do
		box(m, fc * CFrame.new(0, 0.004, k * math.min(d.X, d.Y) * 0.12), Vector3.new(math.min(d.X, d.Y) * 0.86, 0.004, 0.006), STEEL, M.Metal)
	end
	dustLayer(m, fc * CFrame.new(0, 0.008, 0), Vector3.new(d.X * 0.9, 0.01, d.Y * 0.9))
	-- label on top (+Y)
	local lab = box(m, cf * CFrame.new(0, d.Y / 2 + 0.002, 0), Vector3.new(d.X * 0.8, 0.004, d.Z * 0.75), if q >= 0.5 then Color3.fromRGB(20, 20, 22) else Color3.fromRGB(230, 230, 226), M.SmoothPlastic, { Name = "Label" })
	local name = psuPart and psuPart.name or "PSU"
	label(lab, Enum.NormalId.Top, (psuPart and psuPart.watt or 500) .. "W\n" .. name, if q >= 0.5 then Color3.fromRGB(230, 230, 230) else Color3.fromRGB(30, 30, 30), 240, B.Fonts.Heavy)
	-- modular sockets / cable exit on -X
	local modular = psuPart and psuPart.modular or "none"
	if modular ~= "none" then
		for r = 0, 2 do
			for c = 0, 2 do
				box(m, cf * CFrame.new(-d.X / 2 - 0.004, -d.Y * 0.25 + c * d.Y * 0.25, -d.Z * 0.25 + r * d.Z * 0.25), Vector3.new(0.008, cm(1.6), cm(1.2)), Color3.fromRGB(10, 10, 12))
			end
		end
	else
		cyl(m, cf * CFrame.new(-d.X / 2 - cm(0.6), 0, 0), "X", cm(1.2), cm(2.4), Color3.fromRGB(20, 20, 22), M.Rubber)
	end
	-- mains socket and switch on the rear (+X)
	box(m, cf * CFrame.new(d.X / 2 + 0.003, -d.Y * 0.2, 0), Vector3.new(0.006, cm(2.6), cm(2)), Color3.fromRGB(14, 14, 16))
	box(m, cf * CFrame.new(d.X / 2 + 0.004, d.Y * 0.15, 0), Vector3.new(0.008, cm(1.2), cm(1.6)), Color3.fromRGB(20, 20, 22))
	return m
end

----------------------------------------------------------------------------------------------------
-- Case fan (lying flat: axis +Y). size in cm.
----------------------------------------------------------------------------------------------------
function PCParts.fan(cf: CFrame, fanPart): Model
	local m = newModel("Fan", cf)
	local size = cm(fanPart and fanPart.size or 120) / 10
	local colour = fanPart and fanPart.color or "black"
	local frame, blade
	if colour == "white" then
		frame, blade = Color3.fromRGB(236, 236, 238), Color3.fromRGB(244, 244, 246)
	elseif colour == "brown" then
		frame, blade = Color3.fromRGB(110, 76, 50), Color3.fromRGB(214, 194, 164)
	else
		frame, blade = Color3.fromRGB(26, 26, 30), Color3.fromRGB(40, 40, 46)
	end
	fanFrame(m, cf, size, frame, blade, fanPart and fanPart.rgb)
	dustLayer(m, cf * CFrame.new(0, cm(1.3), 0), Vector3.new(size * 0.94, 0.01, size * 0.94))
	return m
end

----------------------------------------------------------------------------------------------------
-- Storage (lying flat, origin at the centre of the bottom face; connector end at +X)
----------------------------------------------------------------------------------------------------
function PCParts.storageDims(part): Vector3
	local kind = part and part.kind or "ssd25"
	if kind == "nvme" then
		return Vector3.new(cm(8), cm(0.35), cm(2.2))
	elseif kind == "hdd35" then
		return Vector3.new(cm(14.7), cm(2.6), cm(10.2))
	elseif kind == "hdd25" then
		return Vector3.new(cm(10), cm(0.95), cm(7))
	end
	return Vector3.new(cm(10), cm(0.7), cm(7))
end

function PCParts.storage(cf: CFrame, part): Model
	local m = newModel("Drive", cf)
	local kind = part and part.kind or "ssd25"
	local d = PCParts.storageDims(part)
	local name = part and part.name or ""
	if kind == "nvme" then
		box(m, cf * CFrame.new(0, cm(0.08), 0), Vector3.new(d.X, cm(0.16), d.Z), Color3.fromRGB(20, 60, 36), M.SmoothPlastic, { Name = "PCB" })
		box(m, cf * CFrame.new(d.X / 2 - cm(0.4), cm(0.08), 0), Vector3.new(cm(0.8), cm(0.18), d.Z * 0.9), GOLD, M.Metal)
		local stick = box(m, cf * CFrame.new(-cm(0.4), cm(0.24), 0), Vector3.new(d.X * 0.82, cm(0.16), d.Z * 0.92), Color3.fromRGB(24, 24, 26), M.SmoothPlastic, { Name = "Sticker" })
		label(stick, Enum.NormalId.Top, name, Color3.fromRGB(230, 230, 230), 420, B.Fonts.Bold)
		-- screw notch
		box(m, cf * CFrame.new(-d.X / 2 + cm(0.15), cm(0.08), 0), Vector3.new(cm(0.3), cm(0.17), cm(0.5)), Color3.fromRGB(196, 170, 90), M.Metal)
	elseif kind == "hdd35" then
		box(m, cf * CFrame.new(0, d.Y / 2, 0), d, Color3.fromRGB(176, 180, 186), M.Metal, { Name = "Body" })
		local lab = box(m, cf * CFrame.new(0, d.Y + 0.002, 0), Vector3.new(d.X * 0.7, 0.004, d.Z * 0.8), Color3.fromRGB(236, 236, 232), M.SmoothPlastic, { Name = "Label" })
		label(lab, Enum.NormalId.Top, name, Color3.fromRGB(30, 30, 30), 200, B.Fonts.Bold)
		box(m, cf * CFrame.new(0, -0.002, 0), Vector3.new(d.X * 0.8, 0.004, d.Z * 0.75), Color3.fromRGB(20, 70, 40))
		-- SATA connectors on the +X end
		box(m, cf * CFrame.new(d.X / 2 + 0.004, d.Y * 0.4, -d.Z * 0.15), Vector3.new(0.008, cm(0.8), cm(2.2)), Color3.fromRGB(20, 20, 22))
		box(m, cf * CFrame.new(d.X / 2 + 0.004, d.Y * 0.4, d.Z * 0.25), Vector3.new(0.008, cm(0.8), cm(1.2)), Color3.fromRGB(20, 20, 22))
	else
		local shell = if kind == "hdd25" then Color3.fromRGB(176, 180, 186) else Color3.fromRGB(34, 34, 38)
		box(m, cf * CFrame.new(0, d.Y / 2, 0), d, shell, M.Metal, { Name = "Body" })
		local lab = box(m, cf * CFrame.new(0, d.Y + 0.002, 0), Vector3.new(d.X * 0.85, 0.004, d.Z * 0.8), if kind == "hdd25" then Color3.fromRGB(236, 236, 232) else Color3.fromRGB(200, 40, 50), M.SmoothPlastic, { Name = "Label" })
		label(lab, Enum.NormalId.Top, name, if kind == "hdd25" then Color3.fromRGB(30, 30, 30) else Color3.fromRGB(255, 255, 255), 240, B.Fonts.Bold)
		box(m, cf * CFrame.new(d.X / 2 + 0.004, d.Y * 0.5, 0), Vector3.new(0.008, cm(0.5), cm(3)), Color3.fromRGB(20, 20, 22))
	end
	box(m, cf * CFrame.new(0, d.Y / 2, 0), Vector3.new(d.X, math.max(d.Y, 0.06), d.Z), DARK, M.SmoothPlastic, { Name = "Hitbox", Transparency = 1 })
	return m
end

----------------------------------------------------------------------------------------------------
-- Small board parts
----------------------------------------------------------------------------------------------------
function PCParts.cmos(cf: CFrame): Model
	local m = newModel("CMOS", cf)
	local cell = cyl(m, cf * CFrame.new(0, cm(0.45), 0), "Y", cm(0.32), cm(2), Color3.fromRGB(200, 202, 208), M.Metal, { Name = "Cell" })
	label(cell, Enum.NormalId.Top, "CR2032", Color3.fromRGB(60, 60, 64), 500, B.Fonts.Bold)
	box(m, cf * CFrame.new(0, cm(0.45), 0), Vector3.new(0.14, 0.06, 0.14), DARK, M.SmoothPlastic, { Name = "Hitbox", Transparency = 1 })
	return m
end

-- Electrolytic capacitor standing on the board; bulged ones have a domed, crusty top.
function PCParts.capacitor(cf: CFrame, bulged: boolean): Model
	local m = newModel("Capacitor", cf)
	local d, h = 0.085, 0.13
	cyl(m, cf * CFrame.new(0, h / 2, 0), "Y", h, d, Color3.fromRGB(40, 40, 46), M.Metal, { Name = "Can" })
	if bulged then
		B.ellipsoid(m, cf * CFrame.new(0, h + 0.008, 0), Vector3.new(d * 0.95, 0.04, d * 0.95), Color3.fromRGB(150, 150, 156), M.Metal, props({ Name = "Bulge" }))
		B.ellipsoid(m, cf * CFrame.new(0.01, h + 0.02, 0.005), Vector3.new(d * 0.5, 0.012, d * 0.4), Color3.fromRGB(120, 76, 40), M.SmoothPlastic, props({ Name = "Crust", CastShadow = false }))
	else
		cyl(m, cf * CFrame.new(0, h + 0.001, 0), "Y", 0.002, d * 0.92, Color3.fromRGB(176, 180, 186), M.Metal)
		box(m, cf * CFrame.new(0, h + 0.003, 0), Vector3.new(d * 0.7, 0.002, 0.006), Color3.fromRGB(110, 110, 116))
	end
	box(m, cf * CFrame.new(0, h / 2, 0), Vector3.new(0.13, h, 0.13), DARK, M.SmoothPlastic, { Name = "Hitbox", Transparency = 1 })
	return m
end

----------------------------------------------------------------------------------------------------
-- Cables: a sleeved run through `points` (world positions) ending in a connector.
-- style: "atx24" | "eps" | "pcie" | "sata_power" | "sata_data" | "fan"
----------------------------------------------------------------------------------------------------
local CABLE_STYLE = {
	atx24 = { w = 0.14, t = 0.05, color = { 22, 22, 24 }, head = { 0.1, 0.09, 0.4 } },
	eps = { w = 0.08, t = 0.045, color = { 22, 22, 24 }, head = { 0.16, 0.08, 0.09 } },
	pcie = { w = 0.08, t = 0.045, color = { 22, 22, 24 }, head = { 0.14, 0.07, 0.07 } },
	sata_power = { w = 0.06, t = 0.02, color = { 20, 20, 22 }, head = { 0.16, 0.05, 0.05 } },
	sata_data = { w = 0.04, t = 0.012, color = { 200, 40, 40 }, head = { 0.09, 0.05, 0.05 } },
	fan = { w = 0.025, t = 0.02, color = { 24, 24, 26 }, head = { 0.075, 0.05, 0.035 } },
	ribbon = { w = 0.12, t = 0.006, color = { 196, 150, 70 }, head = { 0.14, 0.03, 0.06 } },
	thin = { w = 0.02, t = 0.012, color = { 30, 30, 32 }, head = { 0.05, 0.03, 0.04 } },
}
PCParts.CableStyle = CABLE_STYLE

function PCParts.cable(points: { Vector3 }, style: string, headCf: CFrame?): Model
	local st = CABLE_STYLE[style] or CABLE_STYLE.fan
	local m = newModel("Cable", CFrame.new(points[#points]))
	local c = col(st.color)
	for i = 1, #points - 1 do
		local a, b = points[i], points[i + 1]
		local len = (b - a).Magnitude
		if len > 1e-3 then
			-- flat run: width across, thickness up; joints get a small overlap
			local mid = (a + b) / 2
			local look = CFrame.lookAt(mid, b)
			box(m, look, Vector3.new(st.w, st.t, len + st.w * 0.6), c, M.Fabric, { CastShadow = false })
		end
	end
	if headCf then
		local h = st.head
		box(m, headCf * CFrame.new(0, h[2] / 2, 0), Vector3.new(h[1], h[2], h[3]), Color3.fromRGB(30, 30, 32), M.SmoothPlastic, { Name = "Head" })
		box(m, headCf * CFrame.new(0, h[2] / 2, 0), Vector3.new(math.max(h[1], 0.16), math.max(h[2], 0.1), math.max(h[3], 0.16)), DARK, M.SmoothPlastic, { Name = "Hitbox", Transparency = 1 })
	end
	return m
end

return PCParts
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1293">
          <Properties>
            <string name="Name">Props</string>
            <string name="Source"><![CDATA[-- Props: street furniture, vegetation and small objects used by the world and the shops.
-- Every function takes `cf` = position on the ground with LookVector = the prop's front.

local B = require(script.Parent.Parent.Util.Builder)
local Rand = require(script.Parent.Parent.Util.Rand)
local Assets = require(script.Parent.Parent.Util.Assets)

local Props = {}
local P = B.Palette
local M = Enum.Material

local GREENS = {
	Color3.fromRGB(82, 128, 58),
	Color3.fromRGB(96, 142, 62),
	Color3.fromRGB(70, 116, 52),
	Color3.fromRGB(110, 150, 70),
	Color3.fromRGB(64, 104, 56),
	Color3.fromRGB(122, 160, 74),
}
local AUTUMN = { Color3.fromRGB(196, 120, 50), Color3.fromRGB(210, 160, 60), Color3.fromRGB(170, 80, 40) }

local function noCollide(extra: { [string]: any }?)
	local t = { CanCollide = false, CanTouch = false, CastShadow = true }
	if extra then
		for k, v in extra do
			t[k] = v
		end
	end
	return t
end

----------------------------------------------------------------------------------------------------
-- Vegetation
----------------------------------------------------------------------------------------------------
-- Real trees from the Forest Pack: names and the height range they're scaled to.
local TREES = {
	oak = { { "TreeBroadleaf", "TreeMaple", "TreeDogwood", "TreeBeech" }, 20, 30 },
	birch = { { "TreeBeechYoung", "TreeDogwood" }, 18, 24 },
	pine = { { "TreeRedwood" }, 26, 38 },
	bush = { { "BushLaurel", "BushRhodo", "BushRhodo2", "Fern" }, 2.6, 4.2 },
	forest = { { "TreeBeechBig", "TreeBeech", "TreeBroadleaf", "TreeMaple", "TreeRedwood" }, 30, 52 },
}

-- A real (asset) tree standing on cf, turned at random; nil when the asset library is missing.
local function assetTree(parent: Instance, cf: CFrame, kind: string, r: Random): Model?
	local spec = TREES[kind]
	if not spec then
		return nil
	end
	local name = Rand.pick(r, spec[1])
	local height = Rand.range(r, spec[2], spec[3])
	local m = Assets.place(parent, "Nature", name, cf * CFrame.Angles(0, r:NextNumber() * math.pi * 2, 0), Assets.scaleFor("Nature", name, height))
	if m then
		m.Name = if kind == "bush" then "Bush" else "Tree"
	end
	return m
end

function Props.tree(parent: Instance, cf: CFrame, kind: string?, rng: Random?): Model
	local r = rng or Random.new()
	local k = kind or "oak"
	local real = assetTree(parent, cf, k, r)
	if real then
		return real
	end
	local m = B.model("Tree", parent)
	if k == "oak" or k == "birch" then
		local h = Rand.range(r, 6, 10)
		local trunkCol = if k == "birch" then Color3.fromRGB(226, 222, 210) else P.trunk
		B.cylY(m, cf * CFrame.new(0, h / 2, 0), h, Rand.range(r, 1.1, 1.8), trunkCol, M.Wood)
		-- a couple of branches
		for _ = 1, 2 do
			local a = r:NextNumber() * math.pi * 2
			B.cylY(m, cf * CFrame.new(0, h * 0.75, 0) * CFrame.Angles(0, a, math.rad(35)) * CFrame.new(0, 1.8, 0), 3.6, 0.6, trunkCol, M.Wood, noCollide())
		end
		local autumn = r:NextNumber() < 0.08
		local n = r:NextInteger(3, 5)
		local base = Rand.range(r, 9, 13)
		for _ = 1, n do
			local col = if autumn then Rand.pick(r, AUTUMN) else Rand.pick(r, GREENS)
			if k == "birch" then
				col = col:Lerp(Color3.fromRGB(170, 200, 90), 0.4)
			end
			local off = Vector3.new(Rand.range(r, -2.6, 2.6), Rand.range(r, -1, 2.2), Rand.range(r, -2.6, 2.6))
			local s = base * Rand.range(r, 0.6, 0.95)
			B.ellipsoid(m, cf * CFrame.new(0, h + base * 0.25, 0) * CFrame.new(off), Vector3.new(s, s * 0.82, s), col, M.LeafyGrass, noCollide())
		end
	elseif k == "pine" then
		local h = Rand.range(r, 5, 7)
		B.cylY(m, cf * CFrame.new(0, h / 2, 0), h, 1.2, P.trunk, M.Wood)
		local col = Color3.fromRGB(40, 86, 54):Lerp(Color3.fromRGB(60, 110, 60), r:NextNumber())
		local tiers = r:NextInteger(3, 4)
		local width = Rand.range(r, 10, 13)
		for i = 0, tiers - 1 do
			local w = width * (1 - i * 0.22)
			local y = h - 1 + i * width * 0.36
			B.spire(m, cf * CFrame.new(0, y + w * 0.4, 0) * CFrame.Angles(0, i * 0.7, 0), w, w * 0.8, col, M.LeafyGrass, noCollide())
		end
	elseif k == "palm" then
		local segs = 6
		local lean = Rand.range(r, -0.12, 0.12)
		local c = cf
		for i = 1, segs do
			c = c * CFrame.Angles(lean, 0, lean * 0.5) * CFrame.new(0, 2.2, 0)
			B.cylY(m, c, 2.4, 1.3 - i * 0.07, Color3.fromRGB(140, 110, 76), M.Wood, noCollide({ CanCollide = i <= 2 }))
		end
		local top = c * CFrame.new(0, 1.2, 0)
		B.ball(m, top, 1.8, Color3.fromRGB(120, 92, 60), M.Wood, noCollide())
		local leaves = r:NextInteger(7, 9)
		for i = 1, leaves do
			local a = (i / leaves) * math.pi * 2
			local leaf = top * CFrame.Angles(0, a, 0) * CFrame.Angles(math.rad(-20), 0, 0) * CFrame.new(0, 0, -4)
			B.box(m, leaf, Vector3.new(1.6, 0.25, 8), Rand.pick(r, GREENS), M.LeafyGrass, noCollide())
			B.box(m, leaf * CFrame.new(0, -0.6, -4.5) * CFrame.Angles(math.rad(-35), 0, 0), Vector3.new(1.2, 0.2, 3.4), Rand.pick(r, GREENS), M.LeafyGrass, noCollide())
		end
	elseif k == "cypress" then
		local h = Rand.range(r, 14, 20)
		B.cylY(m, cf * CFrame.new(0, 1.5, 0), 3, 1, P.trunk, M.Wood)
		B.ellipsoid(m, cf * CFrame.new(0, h / 2 + 1.5, 0), Vector3.new(4.2, h, 4.2), Color3.fromRGB(46, 84, 50), M.LeafyGrass, noCollide({ CanCollide = true }))
	else -- bush
		local n = r:NextInteger(2, 3)
		for _ = 1, n do
			local s = Rand.range(r, 3, 5)
			B.ellipsoid(m, cf * CFrame.new(Rand.range(r, -1.5, 1.5), s * 0.35, Rand.range(r, -1.5, 1.5)), Vector3.new(s, s * 0.75, s), Rand.pick(r, GREENS), M.LeafyGrass, noCollide())
		end
		if r:NextNumber() < 0.4 then
			local flower = Rand.pick(r, { Color3.fromRGB(240, 90, 120), Color3.fromRGB(250, 220, 80), Color3.fromRGB(240, 240, 250), Color3.fromRGB(180, 110, 220) })
			for _ = 1, 5 do
				B.ball(m, cf * CFrame.new(Rand.range(r, -2, 2), Rand.range(r, 1.6, 2.6), Rand.range(r, -2, 2)), 0.6, flower, M.SmoothPlastic, noCollide())
			end
		end
	end
	return m
end

local FLOWERS = { "FlowersA", "FlowersB", "FlowersC", "Marigold", "Shrub1", "Shrub2", "Shrub3", "Shrub4", "Shrub5", "Shrub6" }

function Props.flowerBed(parent: Instance, cf: CFrame, w: number, d: number, rng: Random?)
	local r = rng or Random.new()
	local m = B.model("FlowerBed", parent)
	B.box(m, cf * CFrame.new(0, 0.5, 0), Vector3.new(w, 1, d), Color3.fromRGB(150, 140, 125), M.Concrete)
	B.box(m, cf * CFrame.new(0, 0.95, 0), Vector3.new(w - 0.8, 0.2, d - 0.8), P.soil, M.Ground, noCollide())
	-- real flowers and shrubs when the asset library is there
	if Assets.get("Garden", "FlowersA") then
		local n = math.clamp(math.floor(w * d / 7), 2, 14)
		for _ = 1, n do
			local name = Rand.pick(r, FLOWERS)
			local p = cf * CFrame.new(Rand.range(r, -w / 2 + 1, w / 2 - 1), 1.05, Rand.range(r, -d / 2 + 1, d / 2 - 1)) * CFrame.Angles(0, r:NextNumber() * 6.28, 0)
			Assets.place(m, "Garden", name, p, Assets.scaleFor("Garden", name, Rand.range(r, 1.4, 2.4)))
		end
		return m
	end
	local cols = { Color3.fromRGB(230, 70, 90), Color3.fromRGB(250, 200, 60), Color3.fromRGB(240, 240, 250), Color3.fromRGB(170, 100, 220), Color3.fromRGB(250, 140, 60) }
	local n = math.floor(w * d / 6)
	for _ = 1, math.min(n, 18) do
		local p = cf * CFrame.new(Rand.range(r, -w / 2 + 1, w / 2 - 1), 1.4, Rand.range(r, -d / 2 + 1, d / 2 - 1))
		B.ellipsoid(m, p, Vector3.new(1.4, 0.9, 1.4), Rand.pick(r, GREENS), M.LeafyGrass, noCollide())
		B.ball(m, p * CFrame.new(0, 0.5, 0), 0.7, Rand.pick(r, cols), M.SmoothPlastic, noCollide())
	end
	return m
end

----------------------------------------------------------------------------------------------------
-- Street furniture
----------------------------------------------------------------------------------------------------
-- The parts of an asset that light up at night (marked "Bulb" by the asset library).
local function tagBulbs(m: Instance)
	for _, d in m:GetDescendants() do
		if d:IsA("BasePart") and d:GetAttribute("Bulb") then
			d.Material = M.Glass
			B.tag(d, "LampBulb")
			for _, l in d:GetDescendants() do
				if l:IsA("Light") then
					l.Enabled = false
				end
			end
		end
	end
end

function Props.streetLamp(parent: Instance, cf: CFrame, style: string?): Model
	local s = style or "modern"
	if s == "modern" then
		local real = Assets.place(parent, "CityProps", "StreetLight", cf, 0.62)
		if real then
			real.Name = "StreetLamp"
			tagBulbs(real)
			B.tag(real, "StreetLamp")
			return real
		end
	end
	local m = B.model("StreetLamp", parent)
	local dark = Color3.fromRGB(46, 50, 56)
	if s == "classic" then
		B.cylY(m, cf * CFrame.new(0, 0.6, 0), 1.2, 1.4, dark, M.Metal)
		B.cylY(m, cf * CFrame.new(0, 7, 0), 12, 0.55, dark, M.Metal)
		for side = -1, 1, 2 do
			local arm = cf * CFrame.new(side * 1.4, 12.6, 0)
			B.box(m, arm, Vector3.new(2.8, 0.25, 0.25), dark, M.Metal, noCollide())
			B.box(m, arm * CFrame.new(side * 1.3, -0.6, 0), Vector3.new(1.2, 0.3, 1.2), dark, M.Metal, noCollide())
			local bulb = B.box(m, arm * CFrame.new(side * 1.3, -1.4, 0), Vector3.new(0.9, 1.3, 0.9), Color3.fromRGB(255, 226, 170), M.Glass, noCollide({ Name = "Bulb", Transparency = 0.25 }))
			B.tag(bulb, "LampBulb")
			local l = B.pointLight(bulb, 34, 1.4, P.warmLight, false)
			l.Enabled = false
		end
		B.ball(m, cf * CFrame.new(0, 13.4, 0), 0.8, dark, M.Metal, noCollide())
	else
		B.cylY(m, cf * CFrame.new(0, 0.4, 0), 0.8, 1.3, Color3.fromRGB(80, 84, 90), M.Concrete)
		B.cylY(m, cf * CFrame.new(0, 8.5, 0), 16, 0.5, Color3.fromRGB(120, 126, 134), M.Metal)
		local arm = cf * CFrame.new(0, 16.3, -2.4)
		B.box(m, arm, Vector3.new(0.35, 0.35, 5), Color3.fromRGB(120, 126, 134), M.Metal, noCollide())
		local head = B.box(m, arm * CFrame.new(0, -0.25, -2.6), Vector3.new(1.6, 0.45, 2.6), Color3.fromRGB(70, 74, 80), M.Metal, noCollide())
		local bulb = B.box(m, head.CFrame * CFrame.new(0, -0.3, 0), Vector3.new(1.2, 0.12, 2.1), Color3.fromRGB(230, 236, 240), M.Glass, noCollide({ Name = "Bulb", Transparency = 0.1 }))
		B.tag(bulb, "LampBulb")
		local l = B.spotLight(bulb, Enum.NormalId.Bottom, 46, 110, 2.2, Color3.fromRGB(255, 236, 205), false)
		l.Enabled = false
	end
	B.tag(m, "StreetLamp")
	return m
end

function Props.bench(parent: Instance, cf: CFrame, color: any?): Model
	local m = B.model("Bench", parent)
	local wood = B.color(color or P.wood)
	local metal = Color3.fromRGB(40, 42, 46)
	for side = -1, 1, 2 do
		B.box(m, cf * CFrame.new(side * 2.4, 1, 0), Vector3.new(0.3, 2, 1.8), metal, M.Metal)
		B.box(m, cf * CFrame.new(side * 2.4, 2.4, 0.8), Vector3.new(0.3, 2.2, 0.3), metal, M.Metal)
	end
	for i = 0, 2 do
		B.box(m, cf * CFrame.new(0, 2.05, -0.6 + i * 0.6), Vector3.new(5.6, 0.18, 0.48), wood, M.Wood)
	end
	for i = 0, 1 do
		B.box(m, cf * CFrame.new(0, 2.9 + i * 0.6, 0.86) * CFrame.Angles(math.rad(-12), 0, 0), Vector3.new(5.6, 0.45, 0.16), wood, M.Wood)
	end
	local seat = Instance.new("Seat")
	seat.Name = "Seat"
	seat.Anchored = true
	seat.Transparency = 1
	seat.CanCollide = false
	seat.Size = Vector3.new(4, 0.4, 1.4)
	seat.CFrame = cf * CFrame.new(0, 2.25, 0)
	seat.Parent = m
	return m
end

function Props.bin(parent: Instance, cf: CFrame): Model
	local m = B.model("Bin", parent)
	B.cylY(m, cf * CFrame.new(0, 1.6, 0), 3.2, 1.8, Color3.fromRGB(60, 100, 70), M.Metal)
	B.cylY(m, cf * CFrame.new(0, 3.3, 0), 0.2, 2, Color3.fromRGB(40, 44, 48), M.Metal, noCollide())
	return m
end

function Props.hydrant(parent: Instance, cf: CFrame): Model
	local real = Assets.place(parent, "CityProps", "HydrantRed", cf, 1)
	if real then
		real.Name = "Hydrant"
		return real
	end
	local m = B.model("Hydrant", parent)
	local red = Color3.fromRGB(196, 40, 36)
	B.cylY(m, cf * CFrame.new(0, 1.1, 0), 2.2, 0.9, red, M.Metal)
	B.ball(m, cf * CFrame.new(0, 2.3, 0), 0.95, red, M.Metal, noCollide())
	B.cyl(m, cf * CFrame.new(0, 1.5, 0), 1.4, 0.4, Color3.fromRGB(220, 220, 220), M.Metal, noCollide())
	return m
end

function Props.planter(parent: Instance, cf: CFrame, rng: Random?): Model
	local r = rng or Random.new()
	local name = Rand.pick(r, { "PlanterSquare", "PlanterRound", "PlanterLong" })
	local real = Assets.place(parent, "CityProps", name, cf, Assets.scaleFor("CityProps", name, 2.6))
	if real then
		real.Name = "Planter"
		return real
	end
	local m = B.model("Planter", parent)
	B.box(m, cf * CFrame.new(0, 1, 0), Vector3.new(3.4, 2, 3.4), Color3.fromRGB(170, 160, 150), M.Concrete)
	B.box(m, cf * CFrame.new(0, 2.05, 0), Vector3.new(2.8, 0.2, 2.8), P.soil, M.Ground, noCollide())
	Props.tree(m, cf * CFrame.new(0, 2, 0), "bush", r)
	return m
end

local LAMP_COLORS = { Red = Color3.fromRGB(255, 50, 40), Amber = Color3.fromRGB(255, 180, 30), Green = Color3.fromRGB(40, 230, 90) }

function Props.trafficLight(parent: Instance, cf: CFrame, axis: string, nodeKey: string): Model
	local real = Assets.place(parent, "CityProps", "TrafficLightPole", cf, 0.62)
	if real then
		real.Name = "TrafficLight"
		-- the lenses sit at the top of the model as Red / Amber / Green for the signal cycle
		for _, d in real:GetDescendants() do
			if d:IsA("BasePart") and (d.Name == "Red" or d.Name == "Yellow" or d.Name == "Green") then
				d.Name = if d.Name == "Yellow" then "Amber" else d.Name
				d.Parent = real
				local on = LAMP_COLORS[d.Name]
				d:SetAttribute("OnColor", on)
				d.Color = on:Lerp(Color3.new(0, 0, 0), 0.75)
				d.Material = M.SmoothPlastic
			end
		end
		real:SetAttribute("Axis", axis)
		real:SetAttribute("Node", nodeKey)
		B.tag(real, "TrafficLight")
		return real
	end
	local m = B.model("TrafficLight", parent)
	local dark = Color3.fromRGB(36, 38, 42)
	B.cylY(m, cf * CFrame.new(0, 6, 0), 12, 0.5, dark, M.Metal)
	local box = B.box(m, cf * CFrame.new(0, 10.4, -0.5), Vector3.new(1.3, 3.6, 1), dark, M.Metal, noCollide())
	B.box(m, box.CFrame * CFrame.new(0, 1.9, -0.3), Vector3.new(1.5, 0.15, 1.2), dark, M.Metal, noCollide())
	local names = { "Red", "Amber", "Green" }
	local cols = { Color3.fromRGB(255, 50, 40), Color3.fromRGB(255, 180, 30), Color3.fromRGB(40, 230, 90) }
	for i = 1, 3 do
		local lamp = B.cyl(m, box.CFrame * CFrame.new(0, 1.1 - (i - 1) * 1.1, -0.52) * CFrame.Angles(0, math.pi / 2, 0), 0.12, 0.8, cols[i]:Lerp(Color3.new(0, 0, 0), 0.75), M.SmoothPlastic, noCollide({ Name = names[i] }))
		lamp:SetAttribute("OnColor", cols[i])
	end
	m:SetAttribute("Axis", axis)
	m:SetAttribute("Node", nodeKey)
	B.tag(m, "TrafficLight")
	return m
end

function Props.busStop(parent: Instance, cf: CFrame, name: string): Model
	local frame = Color3.fromRGB(60, 70, 84)
	local real = Assets.place(parent, "CityProps", "BusStop", cf * CFrame.new(0, 0, 1), 0.62)
	if real then
		real.Name = "BusStop"
		-- the stop's name over the shelter and the bus sign on its pole
		local label = B.box(real, cf * CFrame.new(0, 9.2, -1.2), Vector3.new(8, 1, 0.2), Color3.fromRGB(30, 40, 60), M.SmoothPlastic, noCollide())
		B.sign(label, Enum.NormalId.Front, "DURAK • " .. name, { color = Color3.fromRGB(255, 255, 255) })
		local pole = B.cylY(real, cf * CFrame.new(-8.6, 5, -1.5), 10, 0.35, frame, M.Metal)
		local plate = B.box(real, pole.CFrame * CFrame.new(4.6, 0, 0) * CFrame.Angles(0, 0, -math.pi / 2), Vector3.new(2.6, 0.2, 2.6), Color3.fromRGB(240, 200, 40), M.SmoothPlastic, noCollide())
		B.sign(plate, Enum.NormalId.Top, "🚌", { color = Color3.fromRGB(30, 30, 30) })
		return real
	end
	local m = B.model("BusStop", parent)
	B.box(m, cf * CFrame.new(0, 0.15, 0), Vector3.new(12, 0.3, 5), Color3.fromRGB(150, 150, 150), M.Concrete)
	for _, x in { -5.6, 5.6 } do
		B.box(m, cf * CFrame.new(x, 4.2, 1.8), Vector3.new(0.4, 8.4, 0.4), frame, M.Metal)
	end
	B.box(m, cf * CFrame.new(0, 8.5, 0.6), Vector3.new(12.6, 0.4, 4.6), frame, M.Metal)
	B.box(m, cf * CFrame.new(0, 4.4, 2.1), Vector3.new(11, 7, 0.2), P.glass, M.Glass, { Transparency = 0.6 })
	B.box(m, cf * CFrame.new(-5.8, 4.4, 0.4), Vector3.new(0.2, 7, 3.2), P.glass, M.Glass, { Transparency = 0.6 })
	local ad = B.box(m, cf * CFrame.new(5.8, 4.4, 0.4), Vector3.new(0.3, 6, 3), Color3.fromRGB(240, 240, 240), M.SmoothPlastic)
	B.sign(ad, Enum.NormalId.Left, "RTX 5090\nMega Parça'da!", { background = Color3.fromRGB(20, 24, 30), color = Color3.fromRGB(120, 230, 255), glow = true })
	Props.bench(m, cf * CFrame.new(0, 0.3, 1))
	local pole = B.cylY(m, cf * CFrame.new(-7.5, 5, -1.5), 10, 0.35, frame, M.Metal)
	local plate = B.box(m, pole.CFrame * CFrame.new(4.6, 0, 0) * CFrame.Angles(0, 0, -math.pi / 2), Vector3.new(2.6, 0.2, 2.6), Color3.fromRGB(240, 200, 40), M.SmoothPlastic, noCollide())
	B.sign(plate, Enum.NormalId.Top, "🚌", { color = Color3.fromRGB(30, 30, 30) })
	local label = B.box(m, cf * CFrame.new(0, 9.1, -1.7), Vector3.new(8, 1, 0.2), Color3.fromRGB(30, 40, 60), M.SmoothPlastic, noCollide())
	B.sign(label, Enum.NormalId.Front, "DURAK • " .. name, { color = Color3.fromRGB(255, 255, 255) })
	return m
end

