{
  "name": "PCTamirci",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "$properties": {
        "CameraMaxZoomDistance": 90,
        "CameraMinZoomDistance": 0.5,
        "EnableMouseLockOption": true,
        "LoadCharacterAppearance": true
      },
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "StarterGui": {
      "$className": "StarterGui",
      "$properties": {
        "ResetPlayerGuiOnSpawn": false
      }
    },
    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "StreamingEnabled": true,
        "StreamingMinRadius": 96,
        "StreamingTargetRadius": 1024
      }
    },
    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "Technology": "Future",
        "Brightness": 2.6,
        "ClockTime": 9.5,
        "GeographicLatitude": 41,
        "GlobalShadows": true,
        "ShadowSoftness": 0.18,
        "EnvironmentDiffuseScale": 1,
        "EnvironmentSpecularScale": 1,
        "ExposureCompensation": 0.1,
        "Ambient": [0.16, 0.16, 0.18],
        "OutdoorAmbient": [0.47, 0.49, 0.53]
      },
      "Atmosphere": {
        "$className": "Atmosphere",
        "$properties": {
          "Density": 0.3,
          "Offset": 0.22,
          "Color": [0.78, 0.74, 0.66],
          "Decay": [0.42, 0.44, 0.49],
          "Glare": 0.35,
          "Haze": 1.4
        }
      },
      "Sky": {
        "$className": "Sky",
        "$properties": {
          "StarCount": 3000,
          "CelestialBodiesShown": true,
          "SunAngularSize": 12,
          "MoonAngularSize": 9
        }
      },
      "Bloom": {
        "$className": "BloomEffect",
        "$properties": {
          "Intensity": 0.55,
          "Size": 26,
          "Threshold": 1.4
        }
      },
      "ColorGrade": {
        "$className": "ColorCorrectionEffect",
        "$properties": {
          "Contrast": 0.07,
          "Saturation": 0.1,
          "Brightness": 0.01,
          "TintColor": [1, 0.985, 0.96]
        }
      },
      "SunRays": {
        "$className": "SunRaysEffect",
        "$properties": {
          "Intensity": 0.05,
          "Spread": 0.55
        }
      },
      "BenchFocus": {
        "$className": "DepthOfFieldEffect",
        "$properties": {
          "Enabled": false,
          "FarIntensity": 0.35,
          "FocusDistance": 7,
          "InFocusRadius": 7,
          "NearIntensity": 0
        }
      }
    },
    "SoundService": {
      "$className": "SoundService",
      "$properties": {
        "RespectFilteringEnabled": true
      }
    },
    "Players": {
      "$className": "Players",
      "$properties": {
        "CharacterAutoLoads": true
      }
    }
  }
}
